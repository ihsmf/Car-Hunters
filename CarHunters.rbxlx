<roblox xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Meta name="ExplicitAutoJoints">true</Meta><Item class="Workspace" referent="RBX12"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">false</bool></Properties></Item><Item class="Lighting" referent="RBX55"><Properties><string name="Name">Lighting</string></Properties></Item><Item class="ReplicatedStorage" referent="RBX27"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX1034"><Properties><string name="Name">CarModels</string></Properties><Item class="Folder" referent="RBX1033"><Properties><string name="Name">Traffic</string></Properties><Item class="Model" referent="RBX1022"><Properties><string name="Name">compact</string></Properties></Item><Item class="Model" referent="RBX1023"><Properties><string name="Name">sedan</string></Properties></Item><Item class="Model" referent="RBX1024"><Properties><string name="Name">taxi</string></Properties></Item><Item class="Model" referent="RBX1025"><Properties><string name="Name">van</string></Properties></Item><Item class="Model" referent="RBX1026"><Properties><string name="Name">minibus</string></Properties></Item><Item class="Model" referent="RBX1027"><Properties><string name="Name">sport</string></Properties></Item><Item class="Model" referent="RBX1028"><Properties><string name="Name">supercar</string></Properties></Item><Item class="Model" referent="RBX1029"><Properties><string name="Name">pickup</string></Properties></Item><Item class="Model" referent="RBX1030"><Properties><string name="Name">service</string></Properties></Item><Item class="Model" referent="RBX1031"><Properties><string name="Name">truck</string></Properties></Item><Item class="Model" referent="RBX1032"><Properties><string name="Name">proto</string></Properties></Item></Item></Item><Item class="Folder" referent="RBX25"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">BaseLayout</string><ProtectedString name="Source">local MapConfig = require(script.Parent.MapConfig)

local BaseLayout = {}

BaseLayout.FloorY = 0.5
BaseLayout.SlotCount = 12
BaseLayout.TrapLocal = Vector3.new(30, 0, -26)
BaseLayout.PortalLocal = Vector3.new(52, 0, 20)
BaseLayout.TerminalLocal = Vector3.new(30, 0, 40)
BaseLayout.SpawnLocal = Vector3.new(44, 0, 0)
BaseLayout.BackWallX = -52
BaseLayout.LaneX = 14

function BaseLayout.SlotLocal(slot)
	local row = math.floor((slot - 1) / 6)
	local col = (slot - 1) % 6
	local x = (row == 0) and -35 or -8
	local z = -37.5 + col * 15
	return Vector3.new(x, 0, z)
end

function BaseLayout.GetBaseCFrame(index)
	local c = MapConfig.BaseCenters[index]
	local yaw = (c.x &lt; 0) and 0 or math.pi
	return CFrame.new(c.x, 0, c.z) * CFrame.Angles(0, yaw, 0)
end

function BaseLayout.ToWorld(index, localPos)
	return BaseLayout.GetBaseCFrame(index):PointToWorldSpace(localPos)
end

function BaseLayout.SlotCFrame(index, slot)
	local p = BaseLayout.SlotLocal(slot)
	return BaseLayout.GetBaseCFrame(index) * CFrame.new(p.X, BaseLayout.FloorY, p.Z)
end

return BaseLayout
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">CarConfig</string><ProtectedString name="Source">local C = Color3.fromRGB
local PartConfig = require(script.Parent.PartConfig)
local EconomyConfig = require(script.Parent.EconomyConfig)

local CarConfig = {}

CarConfig.RarityOrder = { "Common", "Uncommon", "Rare", "Epic", "Legendary" }
CarConfig.Rarities = {
	Common = { index = 1, color = C(176, 184, 196), soft = C(232, 235, 240) },
	Uncommon = { index = 2, color = C(76, 201, 128), soft = C(214, 245, 226) },
	Rare = { index = 3, color = C(72, 152, 255), soft = C(214, 232, 255) },
	Epic = { index = 4, color = C(255, 77, 109), soft = C(255, 220, 226) },
	Legendary = { index = 5, color = C(255, 176, 32), soft = C(255, 238, 200) },
}

CarConfig.MaxLevel = 10
CarConfig.IncomeGrowth = 0.25
CarConfig.ValueMultiplier = 40
CarConfig.UpgradeCostBase = 0.5
CarConfig.UpgradeCostGrowth = 1.35

-- Fictional parody cars: inspired by familiar body styles, no real names, logos or badges.
local list = {
	{ id = "furd_fiasta", name = "Furd Fiasta", rarity = "Common", style = "compact", income = 2, body = C(40, 110, 220), accent = C(30, 30, 36), tag = "Small car, big dreams." },
	{ id = "dodje_caravon", name = "Dodje Caravon", rarity = "Common", style = "van", income = 3, body = C(150, 30, 40), accent = C(30, 30, 36), tag = "Seats the whole crew." },
	{ id = "furd_f150", name = "Furd F-One-Fifty", rarity = "Common", style = "pickup", income = 4, body = C(190, 196, 204), accent = C(30, 30, 36), tag = "Hauls anything, anywhere." },
	{ id = "awdi_a4", name = "Awdi A-Four", rarity = "Common", style = "sedan", income = 5, body = C(196, 200, 206), accent = C(30, 30, 36), tag = "Four doors of pure order." },
	{ id = "bmv_m3", name = "BMV M-Tree", rarity = "Uncommon", style = "sedan", income = 8, body = C(30, 90, 190), accent = C(20, 20, 24), tag = "Blinkers sold separately." },
	{ id = "mursides_e", name = "Mursides E-Klass", rarity = "Uncommon", style = "sedan", income = 10, body = C(20, 20, 24), accent = C(200, 200, 210), tag = "The boss has arrived." },
	{ id = "tezla_model3", name = "Tezla Model Tree", rarity = "Uncommon", style = "sedan", income = 12, body = C(236, 238, 242), accent = C(20, 20, 24), tag = "Silent, smooth, electric." },
	{ id = "jagwar_xe", name = "Jagwar XE", rarity = "Uncommon", style = "sedan", income = 15, body = C(16, 70, 50), accent = C(200, 200, 210), tag = "Purrs on every corner." },
	{ id = "furd_mustank", name = "Furd Mustank", rarity = "Rare", style = "muscle", income = 25, body = C(210, 40, 36), accent = C(240, 240, 240), spoiler = true, tag = "Wild horse on wheels." },
	{ id = "dodje_chalenjer", name = "Dodje Chalenjer", rarity = "Rare", style = "muscle", income = 32, body = C(255, 120, 20), accent = C(20, 20, 24), tag = "Burnouts before breakfast." },
	{ id = "ranje_rover", name = "Ranje Rover", rarity = "Rare", style = "suv", income = 40, body = C(232, 232, 228), accent = C(20, 20, 24), tag = "Royalty rides high." },
	{ id = "bmv_m4", name = "BMV M-Fore", rarity = "Rare", style = "sport", income = 50, body = C(120, 190, 60), accent = C(20, 20, 24), spoiler = true, tag = "Lives at the rev limiter." },
	{ id = "mursides_g", name = "Mursides G-Vagon", rarity = "Epic", style = "suv", income = 100, body = C(24, 26, 28), accent = C(200, 200, 210), tag = "A brick that outruns you." },
	{ id = "awdi_r8", name = "Awdi R-Ate", rarity = "Epic", style = "supercar", income = 125, body = C(200, 204, 210), accent = C(20, 20, 24), chrome = true, tag = "Engine behind, world ahead." },
	{ id = "jagwar_ftype", name = "Jagwar F-Tipe", rarity = "Epic", style = "sport", income = 150, body = C(150, 20, 30), accent = C(20, 20, 24), tag = "Long hood, loud roar." },
	{ id = "mazeratti_gt", name = "Mazeratti GranTurizmo", rarity = "Epic", style = "sport", income = 200, body = C(20, 40, 90), accent = C(200, 200, 210), tag = "Opera on four wheels." },
	{ id = "lamborgini_hurakan", name = "Lamborgini Hurakan", rarity = "Legendary", style = "supercar", income = 500, body = C(120, 220, 40), accent = C(20, 20, 24), neon = C(120, 255, 60), tag = "A storm with number plates." },
	{ id = "tezla_cybertrak", name = "Tezla Cybertrak", rarity = "Legendary", style = "pickup", income = 650, body = C(176, 180, 186), accent = C(20, 20, 24), chrome = true, tag = "Low-poly from the future." },
	{ id = "mazeratti_mc20", name = "Mazeratti MC-Twenty", rarity = "Legendary", style = "supercar", income = 800, body = C(240, 240, 236), accent = C(30, 60, 160), neon = C(110, 150, 255), tag = "Carbon, thunder, style." },
	{ id = "lamborgini_aventadoor", name = "Lamborgini Aventadoor", rarity = "Legendary", style = "proto", income = 1000, body = C(255, 150, 10), accent = C(20, 20, 24), neon = C(255, 190, 40), spoiler = true, tag = "The final hunt." },
}

-- old save ids -&gt; new ids (same rarity and income slot)
CarConfig.LegacyIds = {
	rusty_compact = "furd_fiasta", pocket_hatch = "dodje_caravon", dusty_sedan = "furd_f150", mule_pickup = "awdi_a4",
	street_runner = "bmv_m3", city_taxi = "mursides_e", cargo_hopper = "tezla_model3", boulevard_gt = "jagwar_xe",
	night_phantom = "furd_mustank", iron_hauler = "dodje_chalenjer", redline_coupe = "ranje_rover", volt_cruiser = "bmv_m4",
	turbo_vortex = "mursides_g", chrome_viper = "awdi_r8", apex_predator = "jagwar_ftype", solar_flare = "mazeratti_gt",
	neon_specter = "lamborgini_hurakan", hyper_nova = "tezla_cybertrak", quantum_drift = "mazeratti_mc20", eclipse_titan = "lamborgini_aventadoor",
}

CarConfig.List = list
CarConfig.ById = {}
CarConfig.ByRarity = { Common = {}, Uncommon = {}, Rare = {}, Epic = {}, Legendary = {} }
for i, def in ipairs(list) do
	def.order = i
	def.value = def.income * CarConfig.ValueMultiplier
	def.maxLevel = CarConfig.MaxLevel
	CarConfig.ById[def.id] = def
	table.insert(CarConfig.ByRarity[def.rarity], def)
end

CarConfig.DropChances = {
	bolts = { Common = 55, Uncommon = 25, Rare = 13, Epic = 6, Legendary = 1 },
	tire = { Common = 40, Uncommon = 30, Rare = 18, Epic = 9, Legendary = 3 },
	engine = { Common = 22, Uncommon = 30, Rare = 26, Epic = 16, Legendary = 6 },
	turbo = { Common = 10, Uncommon = 22, Rare = 30, Epic = 26, Legendary = 12 },
	core = { Common = 4, Uncommon = 10, Rare = 26, Epic = 36, Legendary = 24 },
}

function CarConfig.IncomeAt(def, level)
	return math.floor(def.income * (1 + CarConfig.IncomeGrowth * (level - 1)) + 0.5)
end

function CarConfig.ValueAt(def, level)
	return math.floor(def.value * (1 + 0.3 * (level - 1)))
end

function CarConfig.SellPrice(def, level)
	return math.floor(CarConfig.ValueAt(def, level) * EconomyConfig.SellFraction)
end

function CarConfig.DiscoverBonus(def)
	return math.floor(def.value * EconomyConfig.DiscoverBonusMult)
end

function CarConfig.UpgradeCost(def, level)
	return math.ceil(def.value * CarConfig.UpgradeCostBase * (CarConfig.UpgradeCostGrowth ^ (level - 1)))
end

function CarConfig.UpgradeParts(def, level)
	return PartConfig.PartForRarity[def.rarity], 1 + math.floor((level - 1) / 3)
end

function CarConfig.IsHighTier(rarity)
	return rarity == "Epic" or rarity == "Legendary"
end

function CarConfig.PityRow(partId)
	local row = CarConfig.DropChances[partId]
	local e, l = row.Epic, row.Legendary
	local t = e + l
	return { Common = 0, Uncommon = 0, Rare = 0, Epic = e / t * 100, Legendary = l / t * 100 }
end

function CarConfig.Roll(partId, pity, r1, r2)
	local row = CarConfig.DropChances[partId]
	if pity and pity &gt;= EconomyConfig.PityThreshold - 1 then
		row = CarConfig.PityRow(partId)
	end
	local total = 0
	for _, r in ipairs(CarConfig.RarityOrder) do
		total = total + row[r]
	end
	local target = r1 * total
	local acc = 0
	local rarity = "Legendary"
	for _, r in ipairs(CarConfig.RarityOrder) do
		acc = acc + row[r]
		if row[r] &gt; 0 and target &lt; acc then
			rarity = r
			break
		end
	end
	local pool = CarConfig.ByRarity[rarity]
	local def = pool[math.floor(r2 * #pool) + 1] or pool[#pool]
	return rarity, def
end

function CarConfig.IndexStats(discovered)
	local tiers, found = 0, 0
	for _, r in ipairs(CarConfig.RarityOrder) do
		local all = true
		for _, def in ipairs(CarConfig.ByRarity[r]) do
			if discovered[def.id] then
				found = found + 1
			else
				all = false
			end
		end
		if all then
			tiers = tiers + 1
		end
	end
	local mult = 1 + tiers * EconomyConfig.IndexTierBonus
	if found &gt;= #list then
		mult = mult + EconomyConfig.IndexFullBonus
	end
	return found, #list, tiers, mult
end

function CarConfig.Validate()
	local errors = {}
	local count = 0
	for _, r in ipairs(CarConfig.RarityOrder) do
		if #CarConfig.ByRarity[r] ~= 4 then
			table.insert(errors, r .. ": expected 4 cars, got " .. #CarConfig.ByRarity[r])
		end
		count = count + #CarConfig.ByRarity[r]
	end
	if count ~= 20 then
		table.insert(errors, "expected 20 cars, got " .. count)
	end
	for partId, row in pairs(CarConfig.DropChances) do
		local sum = 0
		for _, r in ipairs(CarConfig.RarityOrder) do
			sum = sum + (row[r] or 0)
		end
		if math.abs(sum - 100) &gt; 1e-9 then
			table.insert(errors, partId .. ": drop chances sum to " .. sum)
		end
	end
	return errors
end

return CarConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">EconomyConfig</string><ProtectedString name="Source">local EconomyConfig = {}

EconomyConfig.StarterParts = { bolts = 2 }
EconomyConfig.CarryCapacity = 20
EconomyConfig.DeathLossFraction = 1.0 -- one hit = whole run lost
EconomyConfig.MaxCars = 200
EconomyConfig.MaxMoney = 1e15
EconomyConfig.StartSlots = 3
EconomyConfig.MaxSlots = 12
EconomyConfig.MaxPlayers = 8

EconomyConfig.SlotCosts = {
	[4] = 1500, [5] = 4000, [6] = 10000, [7] = 25000, [8] = 60000,
	[9] = 150000, [10] = 350000, [11] = 800000, [12] = 2000000,
}

EconomyConfig.ZoneUnlock = {
	highway = { cost = 16000, minValue = 7000 },
	industrial = { cost = 180000, minValue = 70000 },
	neon = { cost = 1000000, minValue = 400000 },
}

EconomyConfig.SellFraction = 0.35
EconomyConfig.DiscoverBonusMult = 1.0
EconomyConfig.IndexTierBonus = 0.05
EconomyConfig.IndexFullBonus = 0.10
EconomyConfig.PityThreshold = 40

EconomyConfig.ThrowCooldown = 0.8
EconomyConfig.ThrowAnimTime = 5.2
EconomyConfig.ThrowMaxDistance = 45
EconomyConfig.BaseActionDistance = 100
EconomyConfig.PickupRadius = 7
EconomyConfig.PickupCheckInterval = 0.15
EconomyConfig.SpawnProtection = 2.5
EconomyConfig.HitCooldown = 1.0
EconomyConfig.TrafficTickRate = 1 / 30
EconomyConfig.AutosaveInterval = 60
EconomyConfig.TeleportCooldown = 4
EconomyConfig.ActionCooldown = 0.12

return EconomyConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">MapConfig</string><ProtectedString name="Source">local C = Color3.fromRGB

local MapConfig = {}

MapConfig.Seed = 12345
MapConfig.MapHalfWidth = 230
MapConfig.StartZ = -340
MapConfig.EndZ = 1150
MapConfig.PlazaEndZ = 66
MapConfig.DecorationDensity = 0.75
MapConfig.GraphicsQuality = "MobileFriendly"
MapConfig.Cartoon = true

MapConfig.RoadTopY = 0.2
MapConfig.SidewalkTopY = 0.8
MapConfig.SidewalkWidth = 6
MapConfig.TunnelLength = 50
MapConfig.EntryHalfWidth = 60
MapConfig.GateHalfWidth = 30
MapConfig.EntryZ = 74
MapConfig.PromenadeHalfWidth = 100

MapConfig.BasePlot = { x = 110, z = 95 }
MapConfig.BaseCount = 8
MapConfig.BaseCenters = {
	{ x = -160, z = -285 }, { x = 160, z = -285 },
	{ x = -160, z = -185 }, { x = 160, z = -185 },
	{ x = -160, z = -85 },  { x = 160, z = -85 },
	{ x = -160, z = 15 },   { x = 160, z = 15 },
}

-- Speed lanes: player WalkSpeed boost while standing on them (never cross roads)
MapConfig.WalkSpeed = 18
MapConfig.LaneSpeed = 48
MapConfig.LaneHalfWidth = 5

MapConfig.ZoneOrder = { "city", "highway", "industrial", "neon" }

MapConfig.Gates = {
	{ zone = "highway", z = 340 },
	{ zone = "industrial", z = 610 },
	{ zone = "neon", z = 880 },
}

MapConfig.Zones = {
	city = {
		id = "city", name = "CITY DISTRICT", zMin = 84, zMax = 330, roads = { 1, 2 }, hitDamage = 999,
		palette = {
			ground = C(110, 205, 95), road = C(62, 64, 72), sidewalk = C(222, 212, 192), curb = C(180, 172, 156),
			accent = C(255, 160, 50), accent2 = C(60, 170, 230),
			buildings = { C(255, 196, 120), C(255, 120, 100), C(110, 200, 255), C(255, 226, 110), C(255, 160, 180), C(130, 225, 150) },
		},
	},
	highway = {
		id = "highway", name = "HIGHWAY DISTRICT", zMin = 350, zMax = 600, roads = { 3, 4 }, hitDamage = 999,
		palette = {
			ground = C(126, 146, 116), road = C(50, 52, 58), sidewalk = C(176, 178, 184), curb = C(140, 142, 150),
			accent = C(255, 210, 40), accent2 = C(230, 70, 60),
			buildings = { C(200, 205, 215), C(120, 150, 190), C(230, 230, 235), C(90, 100, 120), C(255, 190, 70) },
		},
	},
	industrial = {
		id = "industrial", name = "INDUSTRIAL DISTRICT", zMin = 620, zMax = 870, roads = { 5, 6 }, hitDamage = 999,
		palette = {
			ground = C(150, 136, 116), road = C(52, 50, 50), sidewalk = C(168, 160, 148), curb = C(120, 114, 104),
			accent = C(255, 120, 30), accent2 = C(255, 220, 60),
			buildings = { C(150, 120, 100), C(110, 120, 130), C(170, 90, 70), C(130, 150, 120), C(190, 170, 130) },
		},
	},
	neon = {
		id = "neon", name = "NEON DISTRICT", zMin = 890, zMax = 1140, roads = { 7, 8 }, hitDamage = 999,
		palette = {
			ground = C(16, 30, 44), road = C(16, 18, 26), sidewalk = C(30, 52, 70), curb = C(40, 200, 220),
			accent = C(255, 60, 120), accent2 = C(40, 240, 255),
			buildings = { C(20, 44, 70), C(14, 30, 52), C(30, 60, 64), C(18, 24, 36), C(40, 50, 80) },
		},
	},
}

MapConfig.Plaza = {
	ground = C(110, 205, 95), paving = C(236, 228, 210), floor = C(52, 54, 62),
	accent = C(60, 200, 255),
}

MapConfig.Roads = {
	{ id = 1, zone = "city", z = 160, width = 36, lanesPerSide = 2, laneWidth = 8, median = 4,
		speed = { 30, 40 }, spacing = { 70, 95 }, kinds = { "compact", "sedan", "taxi", "van" } },
	{ id = 2, zone = "city", z = 265, width = 36, lanesPerSide = 2, laneWidth = 8, median = 4,
		speed = { 34, 44 }, spacing = { 65, 90 }, kinds = { "compact", "sedan", "taxi", "van" } },
	{ id = 3, zone = "highway", z = 420, width = 40, lanesPerSide = 2, laneWidth = 9, median = 4,
		speed = { 52, 66 }, spacing = { 70, 95 }, kinds = { "sedan", "sport", "minibus", "supercar" } },
	{ id = 4, zone = "highway", z = 530, width = 40, lanesPerSide = 2, laneWidth = 9, median = 4,
		speed = { 55, 70 }, spacing = { 65, 90 }, kinds = { "sedan", "sport", "minibus", "supercar" } },
	{ id = 5, zone = "industrial", z = 690, width = 38, lanesPerSide = 2, laneWidth = 8.5, median = 4,
		speed = { 42, 58 }, spacing = { 75, 100 }, kinds = { "truck", "pickup", "service" } },
	{ id = 6, zone = "industrial", z = 800, width = 38, lanesPerSide = 2, laneWidth = 8.5, median = 4,
		speed = { 45, 60 }, spacing = { 70, 95 }, kinds = { "truck", "pickup", "service" } },
	{ id = 7, zone = "neon", z = 960, width = 40, lanesPerSide = 2, laneWidth = 9, median = 4,
		speed = { 68, 84 }, spacing = { 70, 95 }, kinds = { "proto", "supercar", "sport" } },
	{ id = 8, zone = "neon", z = 1070, width = 40, lanesPerSide = 2, laneWidth = 9, median = 4,
		speed = { 72, 90 }, spacing = { 65, 90 }, kinds = { "proto", "supercar", "sport" } },
}

-- Lane "surge": whole lane periodically speeds up/slows down (deterministic, client == server)
MapConfig.Surge = { amp = 0.35, period = { 5, 9 } }

MapConfig.TrafficColors = {
	C(220, 60, 60), C(60, 120, 220), C(240, 200, 50), C(70, 70, 78),
	C(235, 235, 240), C(70, 170, 100), C(240, 130, 40), C(40, 200, 220),
}

function MapConfig.ZoneAt(z)
	if z &lt; MapConfig.EntryZ then
		return "plaza"
	end
	for i = #MapConfig.Gates, 1, -1 do
		if z &gt;= MapConfig.Gates[i].z then
			return MapConfig.Gates[i].zone
		end
	end
	return "city"
end

function MapConfig.GateOfZone(zoneId)
	for _, g in ipairs(MapConfig.Gates) do
		if g.zone == zoneId then
			return g
		end
	end
	return nil
end

function MapConfig.ZoneIndex(zoneId)
	for i, id in ipairs(MapConfig.ZoneOrder) do
		if id == zoneId then
			return i
		end
	end
	return 0
end

function MapConfig.ZoneSpawn(zoneId)
	local z = MapConfig.Zones[zoneId]
	if not z then
		return nil
	end
	return Vector3.new(0, 4, z.zMin + 12)
end

function MapConfig.ZoneBlocks(zoneId)
	local zone = MapConfig.Zones[zoneId]
	local blocks = {}
	local prev = (zoneId == "city") and MapConfig.EntryZ + 10 or zone.zMin
	for _, rid in ipairs(zone.roads) do
		local r = MapConfig.Roads[rid]
		table.insert(blocks, { prev, r.z - r.width / 2 - MapConfig.SidewalkWidth })
		prev = r.z + r.width / 2 + MapConfig.SidewalkWidth
	end
	table.insert(blocks, { prev, zone.zMax })
	return blocks
end

-- rectangles {x1, x2, z1, z2}
function MapConfig.SpeedLanes()
	if MapConfig._lanes then
		return MapConfig._lanes
	end
	local w = MapConfig.LaneHalfWidth
	local out = { { -w, w, MapConfig.StartZ + 20, MapConfig.EntryZ + 8 } }
	local inner = MapConfig.BaseCenters[1].x
	for i = 1, #MapConfig.BaseCenters, 2 do
		local z = MapConfig.BaseCenters[i].z
		table.insert(out, { inner + MapConfig.BasePlot.x / 2 + 2, -w, z - w, z + w })
		table.insert(out, { w, -inner - MapConfig.BasePlot.x / 2 - 2, z - w, z + w })
	end
	for _, zid in ipairs(MapConfig.ZoneOrder) do
		for _, b in ipairs(MapConfig.ZoneBlocks(zid)) do
			if b[2] - b[1] &gt; 16 then
				table.insert(out, { -w, w, b[1] + 3, b[2] - 3 })
			end
		end
	end
	MapConfig._lanes = out
	return out
end

function MapConfig.OnSpeedLane(pos)
	for _, r in ipairs(MapConfig.SpeedLanes()) do
		if pos.X &gt;= r[1] and pos.X &lt;= r[2] and pos.Z &gt;= r[3] and pos.Z &lt;= r[4] then
			return true
		end
	end
	return false
end

function MapConfig.Validate()
	local errors = {}
	for _, r in ipairs(MapConfig.Roads) do
		local w = 2 * r.lanesPerSide * r.laneWidth + r.median
		if w ~= r.width then
			table.insert(errors, "Road" .. r.id .. ": width " .. r.width .. " ~= computed " .. w)
		end
	end
	for i = 1, #MapConfig.BaseCenters do
		for j = i + 1, #MapConfig.BaseCenters do
			local a, b = MapConfig.BaseCenters[i], MapConfig.BaseCenters[j]
			local ox = math.abs(a.x - b.x) &lt; MapConfig.BasePlot.x
			local oz = math.abs(a.z - b.z) &lt; MapConfig.BasePlot.z
			if ox and oz then
				table.insert(errors, "Bases " .. i .. " and " .. j .. " overlap")
			end
		end
	end
	return errors
end

return MapConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">Net</string><ProtectedString name="Source">local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = {}

Net.Names = {
	"StateUpdate",
	"MoneySync",
	"Notify",
	"ThrowPart",
	"ThrowResult",
	"PlaceCar",
	"RemoveCar",
	"UpgradeCar",
	"BuySlot",
	"UnlockZone",
	"HitFx",
	"SellCar",
	"AutoPark",
	"TrafficHit",
	"Teleport",
}

function Net.Folder()
	local f = ReplicatedStorage:FindFirstChild("Remotes")
	if f then
		return f
	end
	if RunService:IsServer() then
		f = Instance.new("Folder")
		f.Name = "Remotes"
		f.Parent = ReplicatedStorage
		return f
	end
	return ReplicatedStorage:WaitForChild("Remotes")
end

function Net.Get(name)
	local folder = Net.Folder()
	local r = folder:FindFirstChild(name)
	if r then
		return r
	end
	if RunService:IsServer() then
		r = Instance.new("RemoteEvent")
		r.Name = name
		r.Parent = folder
		return r
	end
	return folder:WaitForChild(name)
end

function Net.EnsureAll()
	for _, n in ipairs(Net.Names) do
		Net.Get(n)
	end
end

return Net
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX18"><Properties><string name="Name">PartConfig</string><ProtectedString name="Source">local C = Color3.fromRGB

local PartConfig = {}

PartConfig.Order = { "bolts", "tire", "engine", "turbo", "core" }

PartConfig.Parts = {
	bolts = { id = "bolts", rarity = "Common", color = C(200, 205, 215) },
	tire = { id = "tire", rarity = "Uncommon", color = C(90, 220, 140) },
	engine = { id = "engine", rarity = "Rare", color = C(80, 170, 255) },
	turbo = { id = "turbo", rarity = "Epic", color = C(255, 77, 109) },
	core = { id = "core", rarity = "Legendary", color = C(255, 195, 50) },
}

PartConfig.PartForRarity = {
	Common = "bolts", Uncommon = "tire", Rare = "engine", Epic = "turbo", Legendary = "core",
}

PartConfig.SpawnTables = {
	city = {
		safe = { { "bolts", 85 }, { "tire", 15 } },
		risky = { { "bolts", 50 }, { "tire", 45 }, { "engine", 5 } },
	},
	highway = {
		safe = { { "tire", 70 }, { "engine", 30 } },
		risky = { { "tire", 30 }, { "engine", 60 }, { "turbo", 10 } },
	},
	industrial = {
		safe = { { "engine", 80 }, { "turbo", 20 } },
		risky = { { "engine", 55 }, { "turbo", 45 } },
	},
	neon = {
