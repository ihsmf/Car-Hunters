		palette = { ground = C(70, 84, 80), road = C(34, 36, 40), sidewalk = C(110, 116, 120), curb = C(84, 90, 96), accent = C(255, 230, 120), accent2 = C(120, 170, 255),
			buildings = { C(80, 90, 100), C(60, 70, 80), C(100, 104, 110), C(50, 56, 64) } },
		roads = { { off = 66, lanes = 2, lw = 9, speed = { 82, 98 }, spacing = { 62, 86 }, kinds = { "suv", "truck", "sport", "pickup" } },
			{ off = 161, lanes = 2, lw = 9, speed = { 84, 102 }, spacing = { 60, 84 }, kinds = { "suv", "sedan", "supercar" } } } },
	{ id = "rush", tier = 3, name = "RUSH HOUR", len = 230, style = "highway", hazard = "rush",
		palette = { ground = C(110, 150, 110), road = C(48, 50, 56), sidewalk = C(186, 186, 190), curb = C(146, 146, 152), accent = C(255, 120, 40), accent2 = C(255, 210, 40),
			buildings = { C(200, 205, 215), C(120, 150, 190), C(255, 190, 70), C(90, 100, 120) } },
		roads = { { off = 66, lanes = 3, lw = 8.5, speed = { 84, 104 }, spacing = { 58, 80 }, kinds = { "sedan", "taxi", "sport", "truck", "supercar" }, surge = 0.6 },
			{ off = 166, lanes = 3, lw = 8.5, speed = { 88, 108 }, spacing = { 56, 78 }, kinds = { "van", "minibus", "proto", "racer" }, surge = 0.6 } } },
	{ id = "colosseum", tier = 3, arena = true, boss = "titan", name = "COLOSSEUM", len = 300, style = "neon",
		palette = { ground = C(214, 196, 160), road = C(60, 56, 52), sidewalk = C(230, 220, 196), curb = C(190, 176, 150), accent = C(255, 200, 60), accent2 = C(214, 52, 44),
			buildings = { C(230, 216, 186), C(200, 186, 156), C(240, 230, 210) } } },
}

for i, g in ipairs(MapConfig.Gates) do
	g.index = i
end
do
	local cur = MapConfig.Zones.neon.zMax + 16
	for _, e in ipairs(EXTRA) do
		local z = { id = e.id, tier = e.tier, name = e.name, arena = e.arena, boss = e.boss, style = e.style, hazard = e.hazard, palette = e.palette,
			zMin = cur, zMax = cur + e.len, roads = {}, hitDamage = 999 }
		for _, r in ipairs(e.roads or {}) do
			local med = r.median or 4
			local width = 2 * r.lanes * r.lw + med
			local road = { id = #MapConfig.Roads + 1, zone = e.id, z = z.zMin + r.off, width = width, lanesPerSide = r.lanes, laneWidth = r.lw, median = med,
				speed = r.speed, spacing = r.spacing or { 80, 100 }, kinds = r.kinds, loop = r.loop, count = r.count, weave = r.weave, surge = r.surge, rail = r.rail }
			table.insert(MapConfig.Roads, road)
			table.insert(z.roads, road.id)
		end
		MapConfig.Zones[e.id] = z
		table.insert(MapConfig.Gates, { zone = e.id, z = cur - 8 })
		cur = z.zMax + 16
	end
	MapConfig.EndZ = cur - 8
end
for _, z in pairs(MapConfig.Zones) do
	z.style = z.style or z.id
end

-- river crossing in the bridge district: z range of water between its two roads
MapConfig.River = { zone = "bridge", z1 = MapConfig.Zones.bridge.zMin + 84, z2 = MapConfig.Zones.bridge.zMin + 146, bridges = { { x = 0, w = 16 }, { x = -96, w = 8 }, { x = 96, w = 8 } } }

-- Lane "surge": whole lane periodically speeds up/slows down (deterministic, client == server)
MapConfig.Surge = { amp = 0.35, period = { 5, 9 } }

MapConfig.TrafficColors = {
	C(220, 60, 60), C(60, 120, 220), C(240, 200, 50), C(70, 70, 78),
	C(235, 235, 240), C(70, 170, 100), C(240, 130, 40), C(40, 200, 220),
}

function MapConfig.ZoneAt(z)
	if z &lt; MapConfig.EntryZ then
		return "plaza"
	end
	for i = #MapConfig.Gates, 1, -1 do
		if z &gt;= MapConfig.Gates[i].z then
			return MapConfig.Gates[i].zone
		end
	end
	return "city"
end

function MapConfig.GateOfZone(zoneId)
	for _, g in ipairs(MapConfig.Gates) do
		if g.zone == zoneId then
			return g
		end
	end
	return nil
end

function MapConfig.ZoneIndex(zoneId)
	for i, id in ipairs(MapConfig.ZoneOrder) do
		if id == zoneId then
			return i
		end
	end
	return 0
end

function MapConfig.ZoneSpawn(zoneId)
	local z = MapConfig.Zones[zoneId]
	if not z then
		return nil
	end
	return Vector3.new(0, 4, z.zMin + 12)
end

function MapConfig.ZoneBlocks(zoneId)
	local zone = MapConfig.Zones[zoneId]
	local blocks = {}
	local prev = (zoneId == "city") and MapConfig.EntryZ + 10 or zone.zMin
	for _, rid in ipairs(zone.roads) do
		local r = MapConfig.Roads[rid]
		table.insert(blocks, { prev, r.z - r.width / 2 - MapConfig.SidewalkWidth })
		prev = r.z + r.width / 2 + MapConfig.SidewalkWidth
	end
	table.insert(blocks, { prev, zone.zMax })
	return blocks
end

-- rectangles {x1, x2, z1, z2}
-- Running lanes: pairs of dark lanes with white arrows. Each lane = { x1, x2, z1, z2, dx, dz } where (dx,dz) is
-- the arrow direction; the boost only works while running that way.
function MapConfig.SpeedLanes()
	if MapConfig._lanes then
		return MapConfig._lanes
	end
	local w, g = MapConfig.LaneWidth, 0.5
	local out = {}
	local function pairZ(z1, z2)
		table.insert(out, { -g - w, -g, z1, z2, 0, 1 }) -- left lane: away from the garages
		table.insert(out, { g, g + w, z1, z2, 0, -1 }) -- right lane: back home
	end
	pairZ(MapConfig.StartZ + 14, MapConfig.EntryZ + 8)
	for i = 1, #MapConfig.BaseCenters, 2 do
		local z = MapConfig.BaseCenters[i].z
		local edge = math.abs(MapConfig.BaseCenters[i].x) - MapConfig.BasePlot.x / 2 - 1
		for _, sx in ipairs({ -1, 1 }) do
			local x1, x2 = math.min(sx * edge, sx * (g + w + 1)), math.max(sx * edge, sx * (g + w + 1))
			table.insert(out, { x1, x2, z + g, z + g + w, -sx, 0 }) -- to the centre
			table.insert(out, { x1, x2, z - g - w, z - g, sx, 0 }) -- to the garage
		end
	end
	for _, zid in ipairs(MapConfig.ZoneOrder) do
		for _, b in ipairs(MapConfig.ZoneBlocks(zid)) do
			if b[2] - b[1] &gt; 16 then
				pairZ(b[1] + 3, b[2] - 3)
			end
		end
	end
	MapConfig._lanes = out
	return out
end

-- returns the lane under pos (or nil)
function MapConfig.LaneAt(pos)
	for _, r in ipairs(MapConfig.SpeedLanes()) do
		if pos.X &gt;= r[1] and pos.X &lt;= r[2] and pos.Z &gt;= r[3] and pos.Z &lt;= r[4] then
			return r
		end
	end
	return nil
end

function MapConfig.OnSpeedLane(pos)
	return MapConfig.LaneAt(pos) ~= nil
end

function MapConfig.Validate()
	local errors = {}
	for _, r in ipairs(MapConfig.Roads) do
		local w = 2 * r.lanesPerSide * r.laneWidth + r.median
		if w ~= r.width then
			table.insert(errors, "Road" .. r.id .. ": width " .. r.width .. " ~= computed " .. w)
		end
	end
	for i = 1, #MapConfig.BaseCenters do
		for j = i + 1, #MapConfig.BaseCenters do
			local a, b = MapConfig.BaseCenters[i], MapConfig.BaseCenters[j]
			local ox = math.abs(a.x - b.x) &lt; MapConfig.BasePlot.x
			local oz = math.abs(a.z - b.z) &lt; MapConfig.BasePlot.z
			if ox and oz then
				table.insert(errors, "Bases " .. i .. " and " .. j .. " overlap")
			end
		end
	end
	return errors
end

return MapConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">Net</string><ProtectedString name="Source">local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = {}

Net.Names = {
	"StateUpdate",
	"MoneySync",
	"Notify",
	"ThrowPart",
	"ThrowResult",
	"PlaceCar",
	"RemoveCar",
	"UpgradeCar",
	"BuySlot",
	"UnlockZone",
	"HitFx",
	"SellCar",
	"AutoPark",
	"TrafficHit",
	"Teleport",
	"BuyPerk",
	"Donate",
	"DonateFx",
	"HotDrop",
	"BankFx",
	"PickupFx",
	"BuyFloor",
	"ClaimContract",
	"CraftTuning",
	"TuneCar",
	"BossThrow",
	"BossFx",
	"Rebirth",
	"SetSkin",
	"TokenPerk",
}

function Net.Folder()
	local f = ReplicatedStorage:FindFirstChild("Remotes")
	if f then
		return f
	end
	if RunService:IsServer() then
		f = Instance.new("Folder")
		f.Name = "Remotes"
		f.Parent = ReplicatedStorage
		return f
	end
	return ReplicatedStorage:WaitForChild("Remotes")
end

function Net.Get(name)
	local folder = Net.Folder()
	local r = folder:FindFirstChild(name)
	if r then
		return r
	end
	if RunService:IsServer() then
		r = Instance.new("RemoteEvent")
		r.Name = name
		r.Parent = folder
		return r
	end
	return folder:WaitForChild(name)
end

function Net.EnsureAll()
	for _, n in ipairs(Net.Names) do
		Net.Get(n)
	end
end

return Net
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX18"><Properties><string name="Name">PartConfig</string><ProtectedString name="Source">local C = Color3.fromRGB

local PartConfig = {}

PartConfig.Order = { "bolts", "tire", "engine", "turbo", "core" }

PartConfig.Parts = {
	bolts = { id = "bolts", rarity = "Common", color = C(200, 205, 215) },
	tire = { id = "tire", rarity = "Uncommon", color = C(90, 220, 140) },
	engine = { id = "engine", rarity = "Rare", color = C(80, 170, 255) },
	turbo = { id = "turbo", rarity = "Epic", color = C(255, 77, 109) },
	core = { id = "core", rarity = "Legendary", color = C(255, 195, 50) },
}

PartConfig.PartForRarity = {
	Common = "bolts", Uncommon = "tire", Rare = "engine", Epic = "turbo", Legendary = "core",
}

PartConfig.SpawnTables = {
	city = {
		road = { { "tire", 50 }, { "engine", 40 }, { "turbo", 10 } },
		safe = { { "bolts", 85 }, { "tire", 15 } },
		risky = { { "bolts", 50 }, { "tire", 45 }, { "engine", 5 } },
	},
	highway = {
		road = { { "engine", 50 }, { "turbo", 40 }, { "core", 10 } },
		safe = { { "tire", 70 }, { "engine", 30 } },
		risky = { { "tire", 30 }, { "engine", 60 }, { "turbo", 10 } },
	},
	industrial = {
		road = { { "engine", 25 }, { "turbo", 55 }, { "core", 20 } },
		safe = { { "engine", 80 }, { "turbo", 20 } },
		risky = { { "engine", 55 }, { "turbo", 45 } },
	},
	neon = {
		road = { { "turbo", 45 }, { "core", 55 } },
		safe = { { "turbo", 75 }, { "core", 25 } },
		risky = { { "turbo", 40 }, { "core", 60 } },
	},
}

PartConfig.PointCounts = {
	city = { safe = 14, risky = 8, road = 4 },
	highway = { safe = 12, risky = 8, road = 4 },
	industrial = { safe = 12, risky = 8, road = 4 },
	neon = { safe = 10, risky = 8, road = 4 },
}

-- Tier 2: engines/turbos/cores everywhere; Tier 3 + arenas also drop tuning parts (see TuningDrops)
do
	local T2 = { road = { { "turbo", 50 }, { "core", 50 } }, safe = { { "engine", 50 }, { "turbo", 40 }, { "core", 10 } }, risky = { { "turbo", 55 }, { "core", 45 } } }
	local T3 = { road = { { "turbo", 30 }, { "core", 70 } }, safe = { { "turbo", 60 }, { "core", 40 } }, risky = { { "turbo", 35 }, { "core", 65 } } }
	for _, id in ipairs({ "docks", "desert", "bridge", "airport", "scrapyard" }) do
		PartConfig.SpawnTables[id] = T2
		PartConfig.PointCounts[id] = { safe = 10, risky = 8, road = 4 }
	end
	for _, id in ipairs({ "circuit", "drift", "storm", "rush", "canyon", "colosseum" }) do
		PartConfig.SpawnTables[id] = T3
		PartConfig.PointCounts[id] = { safe = 10, risky = 8, road = 4 }
	end
	for _, id in ipairs({ "scrapyard", "canyon", "colosseum" }) do
		PartConfig.PointCounts[id] = { safe = 18, risky = 10, road = 0 }
	end
end

-- chance that a pickup in this zone is a tuning part instead, and which stages can drop
PartConfig.TuningDrops = {
	scrapyard = { chance = 0.05, stages = { 1 } },
	canyon = { chance = 0.08, stages = { 1, 2 } },
	circuit = { chance = 0.06, stages = { 2 } }, drift = { chance = 0.06, stages = { 2 } },
	storm = { chance = 0.07, stages = { 2, 3 } }, rush = { chance = 0.08, stages = { 2, 3 } },
	colosseum = { chance = 0.12, stages = { 2, 3 } },
}

PartConfig.Cooldowns = { safe = { 45, 70 }, risky = { 60, 95 }, road = { 50, 80 } }
PartConfig.CrateAmount = { road = 2 } -- road crates hold several parts

return PartConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX19"><Properties><string name="Name">PartVisual</string><ProtectedString name="Source">local PartConfig = require(script.Parent.PartConfig)

local PartVisual = {}

local METAL = Color3.fromRGB(90, 96, 108)
local SILVER = Color3.fromRGB(205, 210, 220)
local DARK = Color3.fromRGB(30, 30, 34)

-- clone a template's parts into model, scaled so its longest side = size, centred on root, welded
function PartVisual.FromTemplate(model, root, tpl, size)
	local c = tpl:Clone()
	local _, ext = c:GetBoundingBox()
	c:ScaleTo(c:GetScale() * size / math.max(ext.X, ext.Y, ext.Z, 0.01))
	local cf2 = c:GetBoundingBox()
	local n = 0
	for _, p in ipairs(c:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CFrame = cf2:Inverse() * p.CFrame -- centre on origin
			p.Anchored = false
			local w = Instance.new("Weld")
			w.Part0, w.Part1, w.C0 = root, p, p.CFrame
			w.Parent = p
			p.Parent = model
			n = n + 1
		end
	end
	c:Destroy()
	return n &gt; 0
end

-- tuning part showcase model (Tony's counter, reveal)
function PartVisual.BuildTuning(family, size)
	local folder = game:GetService("ReplicatedStorage"):FindFirstChild("PartModels")
	local tpl = folder and folder:FindFirstChild("Tune_" .. family)
	if not tpl then
		return nil
	end
	local model = Instance.new("Model")
	model.Name = "Tune_" .. family
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.one
	root.Anchored, root.CanCollide, root.CanQuery, root.CanTouch = true, false, false, false
	root.Transparency = 1
	root.Parent = model
	model.PrimaryPart = root
	PartVisual.FromTemplate(model, root, tpl, size or 3)
	return model
end

function PartVisual.Build(partId)
	local def = PartConfig.Parts[partId] or PartConfig.Parts.bolts
	local col = def.color

	local model = Instance.new("Model")
	model.Name = "Drop_" .. def.id

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(1, 1, 1)
	root.CFrame = CFrame.new(0, 0, 0)
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Transparency = 1
	root.Parent = model
	model.PrimaryPart = root

	local function add(name, size, cf, color, material, transparency, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Material = material or Enum.Material.SmoothPlastic
		p.Transparency = transparency or 0
		if shape then
			p.Shape = shape
		end
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Anchored = false
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.CastShadow = false
		p.Parent = model
		local w = Instance.new("Weld")
		w.Part0 = root
		w.Part1 = p
		w.C0 = cf
		w.Parent = p
		return p
	end

	local CYL = Enum.PartType.Cylinder
	local BALL = Enum.PartType.Ball
	local upright = CFrame.Angles(0, 0, math.pi / 2)

	-- imported Blender model (blender/make_parts.py) when installed, procedural fallback otherwise
	local folder = game:GetService("ReplicatedStorage"):FindFirstChild("PartModels")
	local tpl = folder and folder:FindFirstChild("Part_" .. def.id)
	if tpl and PartVisual.FromTemplate(model, root, tpl, 3.2) then
		-- template parts added; glow/particles below still apply
	elseif def.id == "bolts" then
		add("Nut", Vector3.new(0.9, 2.0, 2.0), upright, SILVER, Enum.Material.Metal, 0, CYL)
		add("NutGlow", Vector3.new(0.95, 1.2, 1.2), upright, col, Enum.Material.Neon, 0, CYL)
		add("Shaft", Vector3.new(2.2, 0.8, 0.8), CFrame.new(0, -1.5, 0) * upright, METAL, Enum.Material.Metal, 0, CYL)
	elseif def.id == "tire" then
		add("Tire", Vector3.new(1.4, 3.4, 3.4), CFrame.new(), DARK, Enum.Material.SmoothPlastic, 0, CYL)
		add("Hub", Vector3.new(1.5, 1.7, 1.7), CFrame.new(), SILVER, Enum.Material.Metal, 0, CYL)
		add("HubGlow", Vector3.new(1.55, 0.8, 0.8), CFrame.new(), col, Enum.Material.Neon, 0, CYL)
	elseif def.id == "engine" then
		add("Block", Vector3.new(3.2, 2.0, 2.2), CFrame.new(), METAL, Enum.Material.Metal)
		for i = -1, 1 do
			add("Piston", Vector3.new(0.9, 0.9, 0.9), CFrame.new(i * 1.0, 1.4, 0) * upright, SILVER, Enum.Material.Metal, 0, CYL)
		end
		add("Strip", Vector3.new(3.25, 0.35, 2.25), CFrame.new(0, -0.2, 0), col, Enum.Material.Neon)
	elseif def.id == "turbo" then
		add("Housing", Vector3.new(2.2, 2.8, 2.8), CFrame.new(), col, Enum.Material.Metal, 0, CYL)
		add("Inlet", Vector3.new(1.2, 1.7, 1.7), CFrame.new(1.6, 0, 0), SILVER, Enum.Material.Metal, 0, CYL)
		add("InletGlow", Vector3.new(0.4, 1.2, 1.2), CFrame.new(2.2, 0, 0), col, Enum.Material.Neon, 0, CYL)
		add("Pipe", Vector3.new(1.4, 0.8, 0.8), CFrame.new(-0.2, 1.8, 0) * upright, METAL, Enum.Material.Metal, 0, CYL)
	else
		add("Core", Vector3.new(2.4, 2.4, 2.4), CFrame.new(), col, Enum.Material.Neon, 0, BALL)
		add("RingA", Vector3.new(0.18, 4.0, 4.0), CFrame.new(), SILVER, Enum.Material.Metal, 0.1, CYL)
		add("RingB", Vector3.new(0.18, 4.0, 4.0), CFrame.Angles(0, math.pi / 2, 0), SILVER, Enum.Material.Metal, 0.1, CYL)
	end

	add("Halo", Vector3.new(0.15, 5.5, 5.5), CFrame.new(0, -2.55, 0) * upright, col, Enum.Material.SmoothPlastic, 0.25, CYL)
	add("HaloCore", Vector3.new(0.17, 4.3, 4.3), CFrame.new(0, -2.55, 0) * upright, Color3.fromRGB(30, 32, 38), Enum.Material.SmoothPlastic, 0.25, CYL)

	if def.rarity == "Epic" or def.rarity == "Legendary" then
		local pe = Instance.new("ParticleEmitter")
		pe.Color = ColorSequence.new(col)
		pe.Rate = (def.rarity == "Legendary") and 10 or 5
		pe.Lifetime = NumberRange.new(1, 1.6)
		pe.Speed = NumberRange.new(2, 4)
		pe.Size = NumberSequence.new(0.5, 0)
		pe.LightEmission = 1
		pe.Parent = root
	end
	if def.rarity == "Legendary" then
		local light = Instance.new("PointLight")
		light.Color = col
		light.Range = 14
		light.Brightness = 1.5
		light.Parent = root
	end

	model:SetAttribute("PartId", def.id)
	return model
end

return PartVisual
