	Part(parent, "CraneMast", Vector3.new(3, 60, 3), cf * CFrame.new(0, 30, 0), accent, M.Metal)
	Part(parent, "CraneJib", Vector3.new(50, 2.4, 2.4), cf * CFrame.new(12, 60, 0), accent, M.Metal)
	Part(parent, "CraneCab", Vector3.new(5, 4, 4), cf * CFrame.new(0, 57, 0), C(240, 240, 240), M.SmoothPlastic)
	Part(parent, "CraneWeight", Vector3.new(6, 4, 4), cf * CFrame.new(-11, 58, 0), C(110, 110, 120), M.Concrete)
	Part(parent, "CraneCable", Vector3.new(0.3, 26, 0.3), cf * CFrame.new(30, 47, 0), DARK, M.Metal, { collide = false })
	Part(parent, "CraneLoad", Vector3.new(10, 4, 4), cf * CFrame.new(30, 32, 0), C(60, 110, 190), M.Metal, { collide = false })
	Part(parent, "CraneBeacon", Vector3.new(1.2, 1.2, 1.2), cf * CFrame.new(0, 62, 0), C(255, 60, 60), M.Neon, { shape = BALL, collide = false })
end

function Prefabs.HoloRing(parent, pos, color, size)
	size = size or 10
	Part(parent, "HoloRing", Vector3.new(0.4, size, size), CFrame.new(pos) * CFrame.Angles(0, math.pi / 2, 0), color, M.Neon, { shape = CYL, t = 0.5, collide = false, cast = false })
	Part(parent, "HoloRingIn", Vector3.new(0.5, size - 1.6, size - 1.6), CFrame.new(pos) * CFrame.Angles(0, math.pi / 2, 0), C(14, 12, 28), M.SmoothPlastic, { shape = CYL, t = 0.75, collide = false, cast = false })
end

function Prefabs.Gantry(parent, x, z0, width, text, accent)
	for _, s in ipairs({ -1, 1 }) do
		Part(parent, "GantryPost", Vector3.new(1.4, 20, 1.4), CFrame.new(x, 10.8, z0 + s * (width / 2 + 3)), C(150, 154, 162), M.Metal)
	end
	Part(parent, "GantryBeam", Vector3.new(1.6, 1.6, width + 8), CFrame.new(x, 20.4, z0), C(150, 154, 162), M.Metal)
	local b = Part(parent, "GantrySign", Vector3.new(0.6, 5, width * 0.6), CFrame.new(x, 17, z0), C(30, 120, 70), M.SmoothPlastic)
	Label(b, Enum.NormalId.Left, text, C(255, 255, 255))
	Label(b, Enum.NormalId.Right, text, C(255, 255, 255))
	Part(parent, "GantryTrim", Vector3.new(0.7, 0.3, width * 0.6), CFrame.new(x, 14.4, z0), accent, M.Neon, { collide = false })
end

local B = {}

local function mkb(parent, cf)
	return function(name, size, off, color, mat, o)
		return Part(parent, name, size, cf * CFrame.new(off), color, mat, o)
	end
end

function B.shop(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	local col = pick(rng, pal.buildings)
	mk("Body", Vector3.new(w, h, d), Vector3.new(0, h / 2, 0), col)
	mk("Trim", Vector3.new(w + 1, 0.8, d + 1), Vector3.new(0, h + 0.4, 0), pal.accent)
	mk("Glass", Vector3.new(w * 0.8, 3.4, 0.3), Vector3.new(0, 2.6, -d / 2 - 0.1), GLASS, M.Glass, { t = 0.3 })
	for i = 1, 3 do
		mk("Mullion", Vector3.new(0.3, 3.4, 0.4), Vector3.new(-w * 0.4 + i * w * 0.2, 2.6, -d / 2 - 0.15), C(250, 250, 250))
	end
	mk("Door", Vector3.new(3, 4.6, 0.4), Vector3.new(w * 0.3, 2.3, -d / 2 - 0.2), DARK)
	mk("Plinth", Vector3.new(w + 0.4, 0.8, d + 0.4), Vector3.new(0, 0.4, 0), C(225, 220, 212), M.Concrete)
	for fl = 1, math.floor((h - 7) / 4) do
		mk("UpperWin", Vector3.new(w * 0.7, 1.8, 0.3), Vector3.new(0, 6.5 + fl * 3.6, -d / 2 - 0.1), GLASS, M.Glass, { t = 0.25 })
	end
	mk("Awning", Vector3.new(w * 0.9, 0.5, 3.4), Vector3.new(0, 5.2, -d / 2 - 1.8), pal.accent2 or pal.accent)
	local sign = mk("Sign", Vector3.new(w * 0.6, 2.2, 0.4), Vector3.new(0, h - 1.8, -d / 2 - 0.3), DARK)
	Label(sign, Enum.NormalId.Front, pick(rng, { "PARTS", "TIRES", "AUTO", "SHOP", "MARKET", "SPEED" }), pal.accent)
	mk("AC", Vector3.new(3.4, 1.6, 3.4), Vector3.new(w / 4, h + 1.6, 0), C(170, 175, 185), M.Metal)
end

function B.house(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	h = math.min(h, 14)
	local col = pick(rng, pal.buildings)
	mk("Body", Vector3.new(w, h, d), Vector3.new(0, h / 2, 0), col)
	local roofH = math.min(9, d * 0.45)
	local roofCol = pick(rng, { C(200, 96, 80), C(110, 120, 150), C(90, 150, 140), C(160, 110, 170) })
	Part(parent, "RoofF", Vector3.new(w + 1.6, roofH, d / 2 + 0.8), cf * CFrame.new(0, h + roofH / 2, -d / 4 - 0.4), roofCol, M.SmoothPlastic, { class = "WedgePart" })
	Part(parent, "RoofB", Vector3.new(w + 1.6, roofH, d / 2 + 0.8), cf * CFrame.new(0, h + roofH / 2, d / 4 + 0.4) * CFrame.Angles(0, math.pi, 0), roofCol, M.SmoothPlastic, { class = "WedgePart" })
	mk("Chimney", Vector3.new(2.2, roofH, 2.2), Vector3.new(w * 0.3, h + roofH / 2 + 1, d * 0.15), C(170, 110, 90), M.Brick)
	local n = math.max(2, math.floor(w / 7))
	for i = 1, n do
		local x = -w / 2 + (i - 0.5) * (w / n)
		for fl = 0, math.floor((h - 3) / 5) - 1 do
			if not (fl == 0 and i == math.ceil(n / 2)) then
				mk("Win", Vector3.new(3, 2.8, 0.3), Vector3.new(x, 3.6 + fl * 5, -d / 2 - 0.1), GLASS, M.Glass, { t = 0.2 })
				mk("WinFrame", Vector3.new(3.6, 0.4, 0.5), Vector3.new(x, 2.1 + fl * 5, -d / 2 - 0.2), C(250, 250, 250))
			end
		end
	end
	mk("Door", Vector3.new(3.4, 5, 0.4), Vector3.new((math.ceil(n / 2) - 0.5) * (w / n) - w / 2, 2.5, -d / 2 - 0.2), pick(rng, { C(120, 80, 60), C(60, 110, 160), C(200, 80, 80) }))
	mk("Step", Vector3.new(5, 0.6, 2), Vector3.new((math.ceil(n / 2) - 0.5) * (w / n) - w / 2, 0.3, -d / 2 - 1), C(220, 214, 204), M.Concrete)
end

function B.cafe(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	h = math.min(h, 9)
	mk("Body", Vector3.new(w, h, d), Vector3.new(0, h / 2, 0), pick(rng, pal.buildings))
	mk("Glass", Vector3.new(w * 0.85, 3.6, 0.3), Vector3.new(0, 2.7, -d / 2 - 0.1), GLASS, M.Glass, { t = 0.3 })
	local n = 6
	for i = 1, n do
		local c = (i % 2 == 0) and C(250, 250, 250) or pal.accent
		mk("Stripe", Vector3.new(w * 0.9 / n, 0.4, 4), Vector3.new(-w * 0.45 + (i - 0.5) * (w * 0.9 / n), 5.4 - 0.1 * i, -d / 2 - 2.2), c)
	end
	local sign = mk("Sign", Vector3.new(w * 0.5, 2, 0.4), Vector3.new(0, h - 1.4, -d / 2 - 0.3), DARK)
	Label(sign, Enum.NormalId.Front, "CAFE", C(255, 200, 120))
	for i = -1, 1, 2 do
		mk("TableTop", Vector3.new(0.3, 3, 3), Vector3.new(i * w * 0.25, 2.4, -d / 2 - 6), C(240, 240, 240), M.SmoothPlastic, { shape = CYL }).CFrame = cf * CFrame.new(i * w * 0.25, 2.4, -d / 2 - 6) * UPRIGHT
		mk("TablePole", Vector3.new(2.2, 0.4, 0.4), Vector3.new(i * w * 0.25, 1.2, -d / 2 - 6), DARK).CFrame = cf * CFrame.new(i * w * 0.25, 1.2, -d / 2 - 6) * UPRIGHT
	end
end

function B.apartment(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	mk("Body", Vector3.new(w, h, d), Vector3.new(0, h / 2, 0), pick(rng, pal.buildings))
	local floors = math.floor((h - 4) / 4)
	for i = 0, floors - 1 do
		mk("Windows", Vector3.new(w - 4, 2.2, 0.3), Vector3.new(0, 5 + i * 4, -d / 2 - 0.1), GLASS, M.Glass, { t = 0.25 })
	end
	mk("Entrance", Vector3.new(5, 4, 0.5), Vector3.new(0, 2, -d / 2 - 0.2), DARK)
	mk("Ledge", Vector3.new(w + 1.2, 1, d + 1.2), Vector3.new(0, h + 0.5, 0), pal.accent)
	mk("Tank", Vector3.new(4, 4, 4), Vector3.new(-w / 4, h + 3, 0), C(140, 140, 150), M.Metal, { shape = CYL }).CFrame = cf * CFrame.new(-w / 4, h + 3, 0) * UPRIGHT
	for i = 0, floors - 1 do
		if i % 2 == 1 then
			for _, sx in ipairs({ -1, 1 }) do
				mk("Balcony", Vector3.new(6, 0.5, 2.2), Vector3.new(sx * w * 0.25, 3.8 + i * 4, -d / 2 - 1.1), C(240, 240, 244))
				mk("Rail", Vector3.new(6, 1.2, 0.2), Vector3.new(sx * w * 0.25, 4.6 + i * 4, -d / 2 - 2.1), pal.accent)
			end
		end
	end
	mk("RoofGarden", Vector3.new(w * 0.35, 0.8, d * 0.4), Vector3.new(w / 5, h + 1.4, 0), C(100, 170, 90), M.Grass)
end

function B.tower(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	local col = pick(rng, pal.buildings)
	local h1 = h * 0.62
	mk("Base", Vector3.new(w, h1, d), Vector3.new(0, h1 / 2, 0), col)
	mk("Top", Vector3.new(w * 0.72, h - h1, d * 0.72), Vector3.new(0, h1 + (h - h1) / 2, 0), col)
	for i = 0, math.floor(h1 / 5) - 1 do
		mk("WinBand", Vector3.new(w - 3, 2.4, 0.3), Vector3.new(0, 4 + i * 5, -d / 2 - 0.1), GLASS, M.Glass, { t = 0.2 })
	end
	mk("Spire", Vector3.new(0.6, 8, 0.6), Vector3.new(0, h + 4, 0), DARK, M.Metal)
	mk("Beacon", Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, h + 8.4, 0), C(255, 60, 60), M.Neon, { shape = BALL })
end

function B.dealership(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	h = math.min(h, 10)
	mk("Back", Vector3.new(w, h, 3), Vector3.new(0, h / 2, d / 2 - 1.5), C(230, 232, 238))
	mk("SideL", Vector3.new(3, h, d), Vector3.new(-w / 2 + 1.5, h / 2, 0), C(230, 232, 238))
	mk("SideR", Vector3.new(3, h, d), Vector3.new(w / 2 - 1.5, h / 2, 0), C(230, 232, 238))
	mk("Roof", Vector3.new(w + 2, 1, d + 4), Vector3.new(0, h + 0.5, -1), pal.accent)
	mk("Glass", Vector3.new(w - 6, h - 2, 0.3), Vector3.new(0, h / 2, -d / 2), GLASS, M.Glass, { t = 0.5 })
	mk("Floor", Vector3.new(w - 6, 0.3, d - 3), Vector3.new(0, 0.3, 0), C(60, 62, 70))
	local sign = mk("Sign", Vector3.new(w * 0.5, 2.6, 0.4), Vector3.new(0, h + 2.2, -d / 2 - 1), DARK)
	Label(sign, Enum.NormalId.Front, "MOTORS", pal.accent)
	local car = VehicleFactory.Build(pick(rng, { "sport", "supercar", "sedan" }), { BodyColor = pick(rng, { C(220, 50, 50), C(240, 200, 40), C(60, 120, 230) }), Spoiler = true })
	car:PivotTo(cf * CFrame.new(0, 0.5, -d / 2 + 9) * CFrame.Angles(0, math.pi / 2 + 0.4, 0))
	car.Parent = parent
end

function B.garage(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	h = math.min(h, 10)
	mk("Body", Vector3.new(w, h, d), Vector3.new(0, h / 2, 0), C(160, 165, 175))
	for i = 0, 3 do
		mk("Roller", Vector3.new(w * 0.55, 1.4, 0.4), Vector3.new(0, 1 + i * 1.5, -d / 2 - 0.2), (i % 2 == 0) and C(235, 235, 240) or C(205, 208, 215))
	end
	mk("Hazard", Vector3.new(w * 0.6, 0.6, 0.5), Vector3.new(0, 7.4, -d / 2 - 0.2), C(255, 200, 30))
	mk("Roof", Vector3.new(w + 1, 0.8, d + 1), Vector3.new(0, h + 0.4, 0), pal.accent)
end

function B.billboard(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	mk("PostL", Vector3.new(1.4, 20, 1.4), Vector3.new(-w / 3, 10, 0), DARK, M.Metal)
	mk("PostR", Vector3.new(1.4, 20, 1.4), Vector3.new(w / 3, 10, 0), DARK, M.Metal)
	local b = mk("Board", Vector3.new(w, 12, 1), Vector3.new(0, 24, 0), C(20, 22, 30))
	local msgs = { "TURBO FUEL", "FAST LANE", "HUNT THE CARS", "NITRO DRINK", "ROAD KING" }
	local t = pick(rng, msgs)
	Label(b, Enum.NormalId.Front, t, pal.accent)
	Label(b, Enum.NormalId.Back, t, pal.accent)
end

function B.gasstation(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	mk("Shop", Vector3.new(w * 0.45, 8, d * 0.5), Vector3.new(w * 0.27, 4, d * 0.2), C(235, 235, 240))
	mk("ShopGlass", Vector3.new(w * 0.35, 3, 0.3), Vector3.new(w * 0.27, 3, d * 0.2 - d * 0.25 - 0.1), GLASS, M.Glass, { t = 0.3 })
	mk("Canopy", Vector3.new(w * 0.7, 1, d * 0.45), Vector3.new(-w * 0.12, 10, -d * 0.18), pal.accent2 or pal.accent)
	for _, sx in ipairs({ -1, 1 }) do
		mk("Pillar", Vector3.new(1.2, 10, 1.2), Vector3.new(-w * 0.12 + sx * w * 0.3, 5, -d * 0.18 - d * 0.18), DARK, M.Metal)
	end
	for i = -1, 1, 2 do
		mk("Pump", Vector3.new(1.6, 4, 2.4), Vector3.new(-w * 0.12 + i * w * 0.12, 2, -d * 0.18), pal.accent)
	end
	local s = mk("Sign", Vector3.new(w * 0.5, 2, 0.4), Vector3.new(-w * 0.12, 11.3, -d * 0.4), DARK)
	Label(s, Enum.NormalId.Front, "FUEL", C(255, 240, 120))
end

function B.motel(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	h = math.min(h, 9)
	mk("Body", Vector3.new(w, h, d), Vector3.new(0, h / 2, 0), pick(rng, pal.buildings))
	local n = math.floor(w / 8)
	for i = 1, n do
		local x = -w / 2 + (i - 0.5) * (w / n)
		mk("Door", Vector3.new(2.6, 4.6, 0.4), Vector3.new(x, 2.3, -d / 2 - 0.2), DARK)
		mk("Window", Vector3.new(3, 2.4, 0.3), Vector3.new(x, 6.4, -d / 2 - 0.1), GLASS, M.Glass, { t = 0.25 })
	end
	mk("Roof", Vector3.new(w + 1.5, 0.8, d + 1.5), Vector3.new(0, h + 0.4, 0), pal.accent)
end

function B.warehouse(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	h = math.max(h, 12)
	mk("Body", Vector3.new(w, h, d), Vector3.new(0, h / 2, 0), pick(rng, pal.buildings), M.Metal)
	local ribs = math.floor(w / 6)
	for i = 1, ribs do
		mk("Rib", Vector3.new(1, 1.2, d + 1), Vector3.new(-w / 2 + (i - 0.5) * (w / ribs), h + 0.6, 0), C(120, 126, 136), M.Metal)
	end
	mk("Door", Vector3.new(w * 0.4, h * 0.6, 0.4), Vector3.new(0, h * 0.3, -d / 2 - 0.2), C(90, 96, 108), M.Metal)
	mk("DoorStripe", Vector3.new(w * 0.4, 0.8, 0.5), Vector3.new(0, h * 0.62, -d / 2 - 0.2), pal.accent)
	mk("Vent", Vector3.new(3, 2, 3), Vector3.new(w * 0.3, h + 2, 0), C(170, 175, 185), M.Metal)
end

function B.containers(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	local cols = { C(200, 70, 50), C(60, 110, 190), C(230, 180, 40), C(70, 150, 90), C(180, 180, 190) }
	local nx = math.max(1, math.floor(w / 13))
	for ix = 1, nx do
		local stack = math.floor(rr(rng, 1, 4))
		for iy = 1, stack do
			mk("Container", Vector3.new(12, 4.2, 5), Vector3.new(-w / 2 + (ix - 0.5) * (w / nx), 2.1 + (iy - 1) * 4.3, -d / 2 + 4), pick(rng, cols), M.Metal)
		end
		local stack2 = math.floor(rr(rng, 1, 3))
		for iy = 1, stack2 do
			mk("Container", Vector3.new(12, 4.2, 5), Vector3.new(-w / 2 + (ix - 0.5) * (w / nx), 2.1 + (iy - 1) * 4.3, -d / 2 + 10), pick(rng, cols), M.Metal)
		end
	end
end

function B.silo(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	local r = math.min(w, d) * 0.4
	for i = -1, 1, 2 do
		local x = i * r * 1.1
		mk("Silo", Vector3.new(h, r * 2, r * 2), Vector3.new(x, h / 2, 0), C(200, 204, 212), M.Metal, { shape = CYL }).CFrame = cf * CFrame.new(x, h / 2, 0) * UPRIGHT
		mk("Dome", Vector3.new(r * 2, r * 1.2, r * 2), Vector3.new(x, h + 0.2, 0), C(170, 90, 70), M.Metal, { shape = BALL })
	end
	mk("Pipe", Vector3.new(r * 2.4, 1, 1), Vector3.new(0, h * 0.7, 0), C(90, 96, 108), M.Metal)
end

function B.factory(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	h = math.max(h, 14)
	mk("Body", Vector3.new(w, h, d), Vector3.new(0, h / 2, 0), pick(rng, pal.buildings), M.Brick)
	for i = 1, 3 do
		mk("Window", Vector3.new(w * 0.18, 3, 0.3), Vector3.new(-w * 0.3 + (i - 1) * w * 0.3, h * 0.6, -d / 2 - 0.1), C(255, 210, 120), M.Neon, { t = 0.2 })
	end
	mk("Chimney", Vector3.new(h * 1.2, 3.2, 3.2), Vector3.new(w * 0.3, h + h * 0.55, d * 0.2), C(120, 90, 80), M.Brick, { shape = CYL }).CFrame = cf * CFrame.new(w * 0.3, h + h * 0.55, d * 0.2) * UPRIGHT
	mk("ChimneyTop", Vector3.new(3.8, 1.2, 3.8), Vector3.new(w * 0.3, h + h * 1.1, d * 0.2), pal.accent, M.SmoothPlastic)
	mk("Roof", Vector3.new(w + 1, 1, d + 1), Vector3.new(0, h + 0.5, 0), C(100, 104, 114), M.Metal)
end

function B.pipes(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	for i = 0, 2 do
		mk("Pipe", Vector3.new(w, 2.2, 2.2), Vector3.new(0, 4 + i * 2.8, 0), (i % 2 == 0) and C(190, 90, 60) or C(120, 130, 145), M.Metal, { shape = CYL })
	end
	for i = 0, 3 do
		mk("Support", Vector3.new(1.2, 10, 3), Vector3.new(-w / 2 + 3 + i * (w - 6) / 3, 5, 0), DARK, M.Metal)
	end
end

function B.neontower(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	local col = pick(rng, pal.buildings)
	mk("Body", Vector3.new(w, h, d), Vector3.new(0, h / 2, 0), col)
	local nc = pick(rng, { pal.accent, pal.accent2 })
	for i = -1, 1 do
		mk("NeonStrip", Vector3.new(0.8, h * 0.9, 0.5), Vector3.new(i * w * 0.3, h / 2, -d / 2 - 0.2), nc, M.Neon)
	end
	for i = 0, math.floor(h / 8) - 1 do
		mk("WinBand", Vector3.new(w - 4, 1.2, 0.3), Vector3.new(0, 5 + i * 8, -d / 2 - 0.15), C(120, 180, 255), M.Neon, { t = 0.5 })
	end
	mk("TopRing", Vector3.new(w + 2, 1, d + 2), Vector3.new(0, h + 0.5, 0), nc, M.Neon)
end

function B.club(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	h = math.min(h, 12)
	mk("Body", Vector3.new(w, h, d), Vector3.new(0, h / 2, 0), C(18, 18, 28))
	local sign = mk("Sign", Vector3.new(w * 0.8, 5, 0.6), Vector3.new(0, h - 2, -d / 2 - 0.4), C(8, 8, 14))
	Label(sign, Enum.NormalId.Front, pick(rng, { "NEON CLUB", "TURBO BAR", "HOLO LOUNGE", "DRIFT" }), pal.accent)
	mk("DoorGlow", Vector3.new(5, 6, 0.4), Vector3.new(0, 3, -d / 2 - 0.3), pal.accent2, M.Neon)
	mk("EdgeL", Vector3.new(0.6, h, 0.6), Vector3.new(-w / 2, h / 2, -d / 2), pal.accent, M.Neon)
	mk("EdgeR", Vector3.new(0.6, h, 0.6), Vector3.new(w / 2, h / 2, -d / 2), pal.accent, M.Neon)
end

function B.holosign(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	mk("Pole", Vector3.new(1.2, 12, 1.2), Vector3.new(0, 6, 0), DARK, M.Metal)
	local s = mk("Holo", Vector3.new(w, 10, 0.5), Vector3.new(0, 17, 0), pal.accent2, M.Neon, { t = 0.55, collide = false })
	Label(s, Enum.NormalId.Front, pick(rng, { "HUNT", "SPEED", "NEON", "WIN" }), C(255, 255, 255))
	Label(s, Enum.NormalId.Back, "HUNT", C(255, 255, 255))
	mk("Frame", Vector3.new(w + 1, 0.6, 0.8), Vector3.new(0, 22.2, 0), pal.accent, M.Neon)
	mk("FrameB", Vector3.new(w + 1, 0.6, 0.8), Vector3.new(0, 11.8, 0), pal.accent, M.Neon)
end

Prefabs.Buildings = B

function Prefabs.TireStack(parent, pos, rng)
	if Prefabs.FromTemplate("TireStack", parent, CFrame.new(pos) * CFrame.Angles(0, rr(rng, 0, 6), 0)) then
		return
	end
	local n = math.floor(rr(rng, 2, 4.99))
	for i = 1, n do
		local cf = CFrame.new(pos + Vector3.new(rr(rng, -0.3, 0.3), 0.75 + (i - 1) * 1.45, rr(rng, -0.3, 0.3))) * UPRIGHT
		Part(parent, "Tire", Vector3.new(1.4, 4, 4), cf, C(30, 30, 34), M.SmoothPlastic, { shape = CYL })
		Part(parent, "TireRim", Vector3.new(1.46, 2, 2), cf, pick(rng, { C(255, 210, 63), C(255, 59, 59), C(46, 168, 255), C(52, 208, 88) }), M.SmoothPlastic, { shape = CYL, collide = false })
	end
end

-- checkered strip (finish-line flag look)
function Prefabs.Checker(parent, cf, len, h, d)
	local n = math.floor(len / 2)
	for i = 0, n - 1 do
		for row = 0, 1 do
			if (i + row) % 2 == 0 then
				Part(parent, "Checker", Vector3.new(len / n, h / 2, d), cf * CFrame.new(-len / 2 + (i + 0.5) * len / n, (row - 0.5) * h / 2, 0), C(250, 250, 250), M.SmoothPlastic, { collide = false, cast = false })
			end
		end
	end
	Part(parent, "CheckerBack", Vector3.new(len, h, d - 0.1), cf, C(20, 20, 24), M.SmoothPlastic, { collide = false })
end

local PARKED = { "compact", "sedan", "taxi", "van", "pickup", "sport" }
function Prefabs.ParkedCar(parent, cf, rng, kinds)
	local kind = pick(rng, kinds or PARKED)
	local m = VehicleFactory.BuildTraffic(kind, pick(rng, MapConfig.TrafficColors), math.floor(rr(rng, 1, 9)))
	m:PivotTo(cf)
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = d.Name == "Root" and false or true
		end
	end
	m.Parent = parent
	Prefabs.Count = Prefabs.Count + 1
	return m
end

Prefabs.Archetypes = {
	city = {
		{ "shop", 24, 36, 10, 14 }, { "cafe", 22, 30, 8, 9 }, { "apartment", 26, 36, 18, 28 }, { "house", 22, 30, 10, 13 },
		{ "tower", 26, 32, 28, 40 }, { "dealership", 38, 46, 9, 10 }, { "garage", 24, 32, 9, 10 },
	},
	highway = {
		{ "gasstation", 40, 48, 8, 8 }, { "motel", 40, 58, 8, 9 }, { "billboard", 34, 40, 20, 20 },
		{ "shop", 26, 34, 10, 12 }, { "tower", 26, 32, 24, 34 },
	},
	industrial = {
		{ "warehouse", 36, 56, 12, 16 }, { "containers", 28, 40, 8, 8 }, { "silo", 24, 30, 22, 28 },
		{ "factory", 34, 44, 14, 20 }, { "pipes", 30, 44, 10, 10 },
	},
	neon = {
		{ "neontower", 26, 34, 30, 52 }, { "club", 30, 40, 10, 12 }, { "holosign", 20, 24, 20, 22 },
		{ "neontower", 24, 30, 26, 44 }, { "club", 28, 36, 9, 11 },
	},
}

function Prefabs.Building(kind, parent, cf, w, d, h, pal, rng)
	local fn = B[kind]
	if fn then
		fn(parent, cf, w, d, h, pal, rng)
	end
end

return Prefabs
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX89144AB7169140C2B00C2147BF36E11F"><Properties><string name="Name">CarStoreTool</string><ProtectedString name="Source">-- Installs real car models from the Roblox Creator Store (free models) into ReplicatedStorage.CarModels.
-- Run in Studio (edit mode), View &gt; Command Bar:
--   require(game.ServerStorage.Tools.CarStoreTool).InstallAll()
--   require(game.ServerStorage.Tools.CarStoreTool).Install("bmv_m3", 2629351758)   -- any other asset id
-- Every model is stripped of scripts, sounds, GUIs, seats logic, welds and constraints before it is used.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local InsertService = game:GetService("InsertService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CarConfig = require(Shared:WaitForChild("CarConfig"))

local Tool = {}

-- candidates are tried in order until one loads and looks like a car
Tool.Candidates = {
	furd_fiasta = { 9715203503, 2868061330, 18256318351 },
	dodje_caravon = { 13197361329, 10942518460, 3260240120 },
	furd_f150 = { 17363327771, 89473521929489, 1091718142 },
	awdi_a4 = { 5608247129, 14577468462, 9411902978 },
	bmv_m3 = { 2629351758, 18559910789, 559395372 },
	mursides_e = { 8983899769, 2234209839, 4246809329 },
	tezla_model3 = { 5533424135, 9636897495, 4273602171 },
	jagwar_xe = { 1342440736, 1168793222, 11489907932 },
	furd_mustank = { 80783119829510, 2434393319, 116437016801875 },
	dodje_chalenjer = { 17452916832, 87504685753483, 546719174 },
	ranje_rover = { 14494942334, 10346868084, 386870784 },
	bmv_m4 = { 456372240, 455509902, 8647497974 },
	mursides_g = { 5141153317, 3517630561, 388473450, 12417184981 },
	awdi_r8 = { 8602130629, 628685251, 13753737483 },
	jagwar_ftype = { 2530172512, 589271703, 1305991484 },
	mazeratti_gt = { 4677306825, 510958100 },
	lamborgini_hurakan = { 13433799896, 92297472161035, 4456143600 },
	tezla_cybertrak = { 136681441105471, 12200222920, 10361152289 },
	mazeratti_mc20 = { 14282739597 },
	lamborgini_aventadoor = { 2787504744, 4495946534, 9753931902 },
}

Tool.MaxParts = 450

local KEEP = { "BasePart", "Model", "Folder", "DataModelMesh", "Decal", "Texture", "SurfaceAppearance" }

local function keep(inst)
	for _, class in ipairs(KEEP) do
		if inst:IsA(class) then
			return true
		end
	end
	return false
end

local function load(id)
	local ok, res = pcall(function()
		return game:GetObjects("rbxassetid://" .. id)
	end)
	if ok and res and #res &gt; 0 then
		return res
	end
	local ok2, res2 = pcall(function()
		return InsertService:LoadAsset(id)
	end)
	if ok2 and res2 then
		return res2:GetChildren()
	end
	return nil, tostring(ok and res2 or res)
end

-- the car = top-level model that contains a VehicleSeat; otherwise everything that was loaded
local function pickCar(objs)
	local holder = Instance.new("Model")
	for _, o in ipairs(objs) do
		o.Parent = holder
	end
	local seat = holder:FindFirstChildWhichIsA("VehicleSeat", true)
	local car = holder
	if seat then
		local top = seat
		while top.Parent ~= holder do
			top = top.Parent
		end
		if top:IsA("Model") then
			car = top
		end
	end
	return car, seat, holder
end

local function sanitize(car)
	local parts = 0
	for _, d in ipairs(car:GetDescendants()) do
		if not keep(d) then
			d:Destroy()
		end
	end
	for _, d in ipairs(car:GetDescendants()) do
		if d:IsA("BasePart") then
			if d.Transparency &gt;= 0.99 and not d:FindFirstChildWhichIsA("Decal") then
				d:Destroy() -- hitboxes, wheel colliders, seat blocks
			else
				d.Anchored = true
				d.CanCollide = false
				d.CanTouch = false
				d.CanQuery = false
				d.Massless = true
				if d:IsA("Seat") or d:IsA("VehicleSeat") then
					d.Disabled = true
				end
				parts = parts + 1
			end
		end
	end
	return parts
end

local function flat(v)
	local f = Vector3.new(v.X, 0, v.Z)
	return f.Magnitude &gt; 0.01 and f.Unit or Vector3.new(0, 0, -1)
end

-- rotate so the nose points to -Z (VehicleFactory then maps the long axis to +X)
local function normalize(car, forward)
	car.PrimaryPart = nil
	local bb = car:GetBoundingBox()
	car.WorldPivot = CFrame.lookAt(bb.Position, bb.Position + forward)
	car:PivotTo(CFrame.new(0, 20, 0))
	local _, size = car:GetBoundingBox()
	return size
end

function Tool.Install(carId, assetId, yaw)
	local def = CarConfig.ById[carId]
	if not def then
		warn("[CarStore] unknown car id: " .. tostring(carId))
		return false
	end
	local objs, err = load(assetId)
	if not objs then
		warn(string.format("[CarStore] %s: asset %s did not load (%s)", carId, tostring(assetId), tostring(err)))
		return false
	end
	local car, seat, holder = pickCar(objs)
	local forward = seat and flat(seat.CFrame.LookVector) or Vector3.new(0, 0, -1)
	local parts = sanitize(car)
	if parts == 0 then
		holder:Destroy()
		warn(string.format("[CarStore] %s: asset %s has no visible parts", carId, tostring(assetId)))
		return false
	end
	local size = normalize(car, forward)
	if not seat and size.X &gt; size.Z then -- no seat to tell the direction: at least align the long axis
		normalize(car, Vector3.new(1, 0, 0))
		_, size = car:GetBoundingBox()
	end
	local len, wid = size.Z, size.X
	if len / math.max(wid, 0.1) &lt; 1.4 or len / math.max(wid, 0.1) &gt; 4.5 or len / math.max(size.Y, 0.1) &lt; 1.5 or parts &gt; Tool.MaxParts then
		holder:Destroy()
		warn(string.format("[CarStore] %s: asset %s rejected (%.0fx%.0fx%.0f studs, %d parts)", carId, tostring(assetId), len, wid, size.Y, parts))
		return false
	end
	local root = ReplicatedStorage:FindFirstChild("CarModels")
	if not root then
		root = Instance.new("Folder")
		root.Name = "CarModels"
		root.Parent = ReplicatedStorage
	end
	local old = root:FindFirstChild(carId)
	if old then
		old:Destroy()
	end
	car.Name = carId
	car:SetAttribute("Yaw", yaw or 0)
	car:SetAttribute("Recolor", false)
	car:SetAttribute("CarName", def.name)
	car:SetAttribute("Rarity", def.rarity)
	car:SetAttribute("StoreAssetId", tostring(assetId))
	car.Parent = root
	if holder ~= car then
		holder:Destroy()
	end
	print(string.format("[CarStore] %-22s &lt;- asset %s  (%d parts)", carId, tostring(assetId), parts))
	return true
end

function Tool.InstallAll()
	local done, failed = 0, {}
	for _, def in ipairs(CarConfig.List) do
		local ok = false
		for _, id in ipairs(Tool.Candidates[def.id] or {}) do
			ok = Tool.Install(def.id, id)
			if ok then
				break
			end
		end
		if ok then
			done = done + 1
		else
			table.insert(failed, def.id)
		end
	end
	print(string.format("[CarStore] installed %d/%d store models", done, #CarConfig.List))
	if #failed &gt; 0 then
		print("[CarStore] kept the previous model for: " .. table.concat(failed, ", "))
	end
	print("[CarStore] check them: require(game.ServerStorage.Tools.CarModelTool).Preview()  - nose must point along +X.")
	print("[CarStore] wrong way round? require(game.ServerStorage.Tools.CarStoreTool).Flip('car_id')")
end

function Tool.Flip(carId)
	local root = ReplicatedStorage:FindFirstChild("CarModels")
	local m = root and root:FindFirstChild(carId)
	if m then
		m:SetAttribute("Yaw", ((m:GetAttribute("Yaw") or 0) + 180) % 360)
		print("[CarStore] " .. carId .. " Yaw = " .. m:GetAttribute("Yaw"))
	end
end

return Tool
</ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX54"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX53"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX45"><Properties><string name="Name">ClientController</string><ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Strings = require(Shared:WaitForChild("Strings"))
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local BaseLayout = require(Shared:WaitForChild("BaseLayout"))
local Util = require(Shared:WaitForChild("Util"))

local Client = script.Parent:WaitForChild("Client")
local Store = require(Client:WaitForChild("StateStore"))
local UI = require(Client:WaitForChild("UI"))
local TrafficRenderer = require(Client:WaitForChild("TrafficRenderer"))
local TrapFx = require(Client:WaitForChild("TrapFx"))
local WorldFx = require(Client:WaitForChild("WorldFx"))
local Guidance = require(Client:WaitForChild("Guidance"))
local CineFx = require(Client:WaitForChild("CineFx"))
local DeathFx = require(Client:WaitForChild("DeathFx"))
local SpeedLanes = require(Client:WaitForChild("SpeedLanes"))

local player = Players.LocalPlayer
Strings.SetLocale(player.LocaleId)

local actions = {
	Throw = function(partId) Net.Get("ThrowPart"):FireServer(partId) end,
	Place = function(uid, slot) Net.Get("PlaceCar"):FireServer(uid, slot) end,
	Remove = function(uid) Net.Get("RemoveCar"):FireServer(uid) end,
	Upgrade = function(uid, level) Net.Get("UpgradeCar"):FireServer(uid, level) end,
	BuySlot = function(count) Net.Get("BuySlot"):FireServer(count) end,
	Unlock = function(zoneId) Net.Get("UnlockZone"):FireServer(zoneId) end,
	Sell = function(uid) Net.Get("SellCar"):FireServer(uid) end,
	AutoPark = function() Net.Get("AutoPark"):FireServer() end,
	Teleport = function(dest)
		UI.Sfx("whoosh")
		CineFx.Flash(Color3.fromRGB(46, 168, 255), 0.2, 0.5)
		CineFx.Zoom(95, 0.12)
		task.delay(0.15, function() CineFx.Zoom(70, 0.4) end)
		Net.Get("Teleport"):FireServer(dest)
	end,
}

UI.Init(Store, actions)
CineFx.Init(UI.Gui())
TrapFx.SetSfx(UI.Sfx)
WorldFx.Start(Store)
TrafficRenderer.Start()
Guidance.Start(Store)
SpeedLanes.Start()

Net.Get("StateUpdate").OnClientEvent:Connect(function(state) Store.Set(state) end)
Net.Get("MoneySync").OnClientEvent:Connect(function(m, inc, val) Store.SetMoney(m, inc, val) end)
Net.Get("Notify").OnClientEvent:Connect(function(payload)
	if payload and payload.key == "lost" then
		return -- shown by the WRECKED screen
	end
	UI.Notify(payload)
end)
Net.Get("HitFx").OnClientEvent:Connect(function(dir, kind)
	local lost = Store.State and Util.CopyTable(Store.State.carried) or {}
	UI.TogglePanel(nil)
	UI.HideReveal()
	DeathFx.Play(dir or Vector3.new(1, 0, 0), lost, UI.Sfx)
end)
Net.Get("ThrowResult").OnClientEvent:Connect(function(res)
	local idx = Store.State and Store.State.baseIndex
	TrapFx.Play(res, idx, function() UI.ShowReveal(res) end)
end)
player.CharacterAdded:Connect(function()
	DeathFx.Recover()
end)

task.spawn(function()
	while true do
		task.wait(0.2)
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local st = Store.State
		if hrp then
			UI.SetZoneName(MapConfig.ZoneAt(hrp.Position.Z))
			local near = false
			if st and st.baseIndex then
				local trap = BaseLayout.ToWorld(st.baseIndex, BaseLayout.TrapLocal)
				near = Vector3.new(hrp.Position.X - trap.X, 0, hrp.Position.Z - trap.Z).Magnitude &lt;= 35
			end
			UI.SetNearTrap(near and not CineFx.IsScripted())
		end
	end
end)
</ProtectedString></Properties></Item><Item class="Folder" referent="RBX52"><Properties><string name="Name">Client</string></Properties><Item class="ModuleScript" referent="RBX46"><Properties><string name="Name">Guidance</string><ProtectedString name="Source">local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BaseLayout = require(Shared:WaitForChild("BaseLayout"))

local Guidance = {}
local beam, att0, att1Holder

local function ensure(hrp)
	if not beam or not beam.Parent then
		att0 = Instance.new("Attachment")
		att0.Name = "GuideA"
		att0.Position = Vector3.new(0, -2, 0)
		att0.Parent = hrp
		beam = Instance.new("Beam")
		beam.Name = "GuideBeam"
		beam.Width0 = 0.8
		beam.Width1 = 0.8
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.Color = ColorSequence.new(Color3.fromRGB(255, 220, 60))
		beam.Transparency = NumberSequence.new(0.25)
		beam.Segments = 1
		beam.Attachment0 = att0
		beam.Parent = hrp
	end
	return beam
end

local function clear()
	if beam then
		beam.Enabled = false
	end
end

function Guidance.Start(store)
	task.spawn(function()
		while true do
			task.wait(0.4)
			local st = store.State
			local char = Players.LocalPlayer.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if not st or not hrp or (st.stats and st.stats.throws &gt; 0) then
				clear()
			else
				local target
				local banked, carried = store.BankedTotal(), store.CarriedTotal()
				if banked == 0 and carried == 0 then
					local drops = Workspace:FindFirstChild("RuntimeDrops")
					local best = math.huge
					if drops then
						for _, m in ipairs(drops:GetChildren()) do
							local root = m:FindFirstChild("Root")
							if root then
								local d = (root.Position - hrp.Position).Magnitude
								if d &lt; best then
									best, target = d, root
								end
							end
						end
					end
				elseif st.baseIndex then
					local map = Workspace:FindFirstChild("GeneratedMap")
					local base = map and map.Bases:FindFirstChild(string.format("Base%02d", st.baseIndex), true)
					target = base and base:FindFirstChild("TrapPad")
				end
				if target then
					local b = ensure(hrp)
					local a1 = target:FindFirstChild("GuideB")
					if not a1 then
						a1 = Instance.new("Attachment")
						a1.Name = "GuideB"
						a1.Parent = target
					end
					b.Attachment1 = a1
					b.Enabled = true
				else
					clear()
				end
			end
		end
	end)
end

return Guidance
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX47"><Properties><string name="Name">StateStore</string><ProtectedString name="Source">local Store = {}

Store.State = nil
Store.Money = 0
Store.Income = 0
Store.CollectionValue = 0
Store.Changed = Instance.new("BindableEvent")
Store.MoneyChanged = Instance.new("BindableEvent")

function Store.Set(state)
	Store.State = state
	Store.Money = state.money
	Store.Income = state.income or 0
	Store.CollectionValue = state.collectionValue or 0
	Store.Changed:Fire()
end

function Store.SetMoney(money, income, value)
	Store.Money = money
	Store.Income = income
	Store.CollectionValue = value or Store.CollectionValue
	if Store.State then
		Store.State.money = money
		Store.State.income = income
	end
	Store.MoneyChanged:Fire()
end

function Store.Banked(partId)
	return Store.State and Store.State.parts[partId] or 0
end

function Store.Carried(partId)
	return Store.State and Store.State.carried[partId] or 0
end

function Store.CarriedTotal()
	local n = 0
	if Store.State then
		for _, v in pairs(Store.State.carried) do
			n = n + v
		end
	end
	return n
end

function Store.BankedTotal()
	local n = 0
	if Store.State then
		for _, v in pairs(Store.State.parts) do
			n = n + v
		end
	end
	return n
end

return Store
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX48"><Properties><string name="Name">TrafficRenderer</string><ProtectedString name="Source">local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local TrafficMath = require(Shared:WaitForChild("TrafficMath"))
local VehicleFactory = require(Shared:WaitForChild("VehicleFactory"))
local VehicleKinds = require(Shared:WaitForChild("VehicleKinds"))
local Net = require(Shared:WaitForChild("Net"))
local Players = game:GetService("Players")

local Renderer = {}
local pools = {}
local ACTIVE_DIST = 380
local lastReport = 0

function Renderer.Start()
	local folder = Workspace:WaitForChild("RuntimeTraffic")
	local flip = CFrame.Angles(0, math.pi, 0)
	RunService.RenderStepped:Connect(function()
		local cam = Workspace.CurrentCamera
		if not cam then
			return
		end
		local camZ = cam.CFrame.Position.Z
		local t = Workspace:GetServerTimeNow()
		for ri, road in ipairs(MapConfig.Roads) do
			local active = math.abs(camZ - road.z) &lt; ACTIVE_DIST
			for _, lane in ipairs(TrafficMath.RoadLanes[ri]) do
				local pool = pools[lane.index]
				if active then
					if not pool then
						pool = { models = {}, shown = false }
						for k = 1, lane.count do
							pool.models[k] = VehicleFactory.BuildTraffic(lane.kinds[k], MapConfig.TrafficColors[lane.colors[k]], lane.colors[k])
						end
						pools[lane.index] = pool
					end
					if not pool.shown then
						pool.shown = true
						for k, m in ipairs(pool.models) do
							m:PivotTo(CFrame.new(0, -500, 0))
							m.Parent = folder
						end
					end
					for k, m in ipairs(pool.models) do
						local x = TrafficMath.CarX(lane, k, t)
						local cf = CFrame.new(x, MapConfig.RoadTopY, lane.z)
						if lane.dir &lt; 0 then
							cf = cf * flip
						end
						m.PrimaryPart.CFrame = cf
					end
				elseif pool and pool.shown then
					pool.shown = false
					for _, m in ipairs(pool.models) do
						m.Parent = nil
					end
				end
			end
		end
		-- local hit check against exactly what this player sees
		local char = Players.LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hrp and hum and hum.Health &gt; 0 and os.clock() - lastReport &gt; 0.5 then
			local pos = hrp.Position
			local ri = TrafficMath.RoadAtZ(pos.Z, 3)
			if ri then
				for _, lane in ipairs(TrafficMath.RoadLanes[ri]) do
					local dz = math.abs(pos.Z - lane.z)
					for k = 1, lane.count do
						local kind = VehicleKinds[lane.kinds[k]]
						if dz &lt;= kind.W / 2 + 1 and math.abs(pos.X - TrafficMath.CarX(lane, k, t)) &lt;= kind.L / 2 + 1 and pos.Y &lt; MapConfig.RoadTopY + kind.H + 2.5 then
							lastReport = os.clock()
							Net.Get("TrafficHit"):FireServer()
							return
						end
					end
				end
			end
		end
	end)
end

return Renderer
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX49"><Properties><string name="Name">TrapFx</string><ProtectedString name="Source">-- Throw + car reveal cinematic. Purely visual: the server already decided the result.
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local BaseLayout = require(Shared:WaitForChild("BaseLayout"))
local VehicleFactory = require(Shared:WaitForChild("VehicleFactory"))
local PartVisual = require(Shared:WaitForChild("PartVisual"))
local Cine = require(script.Parent:WaitForChild("CineFx"))

local TrapFx = {}
local sfx

local function animate(duration, fn)
	local t0 = os.clock()
	while true do
		local a = math.min(1, (os.clock() - t0) / duration)
		fn(a)
		if a &gt;= 1 then
			break
		end
		RunService.RenderStepped:Wait()
	end
end

local function faceCF(pos, dir)
	return CFrame.new(pos) * CFrame.Angles(0, math.atan2(-dir.Z, dir.X), 0)
end

local function findBase(idx)
	local map = Workspace:FindFirstChild("GeneratedMap")
	local bases = map and map:FindFirstChild("Bases")
	return bases and bases:FindFirstChild(string.format("Base%02d", idx), true)
end

local function fxPart(pos, size, color, shape, transparency)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Size = size
	p.Shape = shape or Enum.PartType.Block
	p.Transparency = transparency or 0
	p.CFrame = typeof(pos) == "CFrame" and pos or CFrame.new(pos)
	p.Parent = Workspace
	return p
end

local function burst(pos, color, count, speed, texture)
	local p = fxPart(pos, Vector3.one, color, nil, 1)
	local e = Instance.new("ParticleEmitter")
	e.Texture = texture or "rbxasset://textures/particles/sparkles_main.dds"
	e.Color = ColorSequence.new(color)
	e.Lifetime = NumberRange.new(0.6, 1.4)
	e.Speed = NumberRange.new(speed or 20, (speed or 20) * 1.8)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new(1.6, 0)
	e.LightEmission = 1
	e.Drag = 3
	e.Rate = 0
	e.Parent = p
	e:Emit(count)
	task.delay(2.5, function()
		p:Destroy()
	end)
end

-- expanding neon ring on the ground
local function shockwave(pos, color, size, t)
	local ring = fxPart(CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2), Vector3.new(0.3, 2, 2), color, Enum.PartType.Cylinder, 0.1)
	TweenService:Create(ring, TweenInfo.new(t or 0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.3, size, size), Transparency = 1 }):Play()
	task.delay((t or 0.6) + 0.05, function()
		ring:Destroy()
	end)
end

local function pulse(part, color, t)
	if part then
		local orig = part.Color
		TweenService:Create(part, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true), { Color = color }):Play()
		task.delay(t * 2 + 0.05, function()
			if part.Parent then
				part.Color = orig
			end
		end)
	end
end

function TrapFx.SetSfx(fn)
	sfx = fn
end

local function play(name)
	if sfx then
		sfx(name)
	end
end

function TrapFx.Play(res, baseIndex, onDone)
	task.spawn(function()
		local def = CarConfig.ById[res.typeId]
		if not def or not baseIndex then
			if onDone then
				onDone()
			end
			return
		end
		local tStart = os.clock()
		local lvl = CarConfig.Rarities[res.rarity].index -- 1..5 drives intensity
		local rc = CarConfig.Rarities[res.rarity].color
		local bcf = BaseLayout.GetBaseCFrame(baseIndex)
		local trapPos = bcf:PointToWorldSpace(BaseLayout.TrapLocal) + Vector3.new(0, 1, 0)
		local portalPos = bcf:PointToWorldSpace(BaseLayout.PortalLocal)
		local char = Players.LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local startPos = hrp and (hrp.Position + Vector3.new(0, 2.5, 0)) or (trapPos + Vector3.new(0, 10, 12))
		local base = findBase(baseIndex)
		local pad = base and base:FindFirstChild("TrapPad")
		local portal = base and base:FindFirstChild("PortalField")
		local cam = Cine.Take()
		local cam0 = cam.CFrame

		-- 1) over-the-shoulder shot + letterbox
		Cine.Letterbox(true, 0.35)
		local side = bcf:VectorToWorldSpace(Vector3.new(0, 0, 1))
		local shot1 = CFrame.lookAt((startPos + trapPos) / 2 + side * 26 + Vector3.new(0, 12, 0), trapPos + Vector3.new(0, 2, 0))
		Cine.Move(shot1, 0.45)
		task.wait(0.35)

		-- 2) part flies with a trail
		play("throw")
		local item = PartVisual.Build(res.partId)
		item:PivotTo(CFrame.new(startPos))
		item.Parent = Workspace
		local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
		a0.Position, a1.Position = Vector3.new(0, 0.8, 0), Vector3.new(0, -0.8, 0)
		a0.Parent, a1.Parent = item.PrimaryPart, item.PrimaryPart
		local trail = Instance.new("Trail")
		trail.Attachment0, trail.Attachment1 = a0, a1
		trail.Color = ColorSequence.new(Color3.fromRGB(255, 210, 63), rc)
		trail.LightEmission = 1
		trail.Lifetime = 0.35
		trail.Transparency = NumberSequence.new(0, 1)
		trail.Parent = item.PrimaryPart
		local target = trapPos + Vector3.new(0, 2.5, 0)
		Cine.Zoom(58, 0.7)
		animate(0.7, function(a)
			local p = startPos:Lerp(target, a) + Vector3.new(0, math.sin(a * math.pi) * 12, 0)
			item.PrimaryPart.CFrame = CFrame.new(p) * CFrame.Angles(a * 12, a * 8, 0)
		end)
		item:Destroy()

		-- 3) impact + charging
		Cine.Shake(1.2, 0.3)
		Cine.Flash(Color3.fromRGB(34, 224, 224), 0.4, 0.3)
		shockwave(trapPos, Color3.fromRGB(34, 224, 224), 30, 0.5)
		burst(trapPos, Color3.fromRGB(80, 240, 255), 40)
		pulse(pad, Color3.new(1, 1, 1), 0.2)
		Cine.Darken(0.45, 0.4)
		local closeUp = CFrame.lookAt(trapPos + side * 14 + Vector3.new(0, 7, 0) + bcf.LookVector * -8, trapPos + Vector3.new(0, 2, 0))
		local camTween = Cine.Move(closeUp, 1.2)
		Cine.Zoom(48, 1.2)
		local chargeT = 0.8 + lvl * 0.15
		local t0 = os.clock()
		while os.clock() - t0 &lt; chargeT do
			local k = (os.clock() - t0) / chargeT
			local ring = fxPart(CFrame.new(trapPos) * CFrame.Angles(0, 0, math.pi / 2), Vector3.new(0.25, 12 - k * 6, 12 - k * 6), (k &gt; 0.6) and rc or Color3.fromRGB(34, 224, 224), Enum.PartType.Cylinder, 0.2)
			TweenService:Create(ring, TweenInfo.new(0.5), { CFrame = ring.CFrame + Vector3.new(0, 10, 0), Transparency = 1 }):Play()
			task.delay(0.55, function()
				ring:Destroy()
			end)
			Cine.Shake(0.15 + k * 0.25 * lvl, 0.15)
			if lvl &gt;= 3 and math.random() &lt; 0.15 * k then
				Cine.Glitch(0.08, 0.4)
			end
			task.wait(0.09)
		end

		-- 4) BOOM: flash, glitch, rarity beam at the portal
		play("boom")
		Cine.Flash(Color3.new(1, 1, 1), 0, 0.5 + lvl * 0.08)
		Cine.Shake(1 + lvl * 0.5, 0.6)
		if lvl &gt;= 2 then
			Cine.Glitch(0.15 + lvl * 0.08, 0.4 + lvl * 0.15)
		end
		Cine.Darken(0.2, 0.3)
		Cine.Zoom(80, 0.25, Enum.EasingStyle.Back)
		local beam = fxPart(CFrame.new(portalPos + Vector3.new(0, 40, 0)) * CFrame.Angles(0, 0, math.pi / 2), Vector3.new(80, 10 + lvl * 2, 10 + lvl * 2), rc, Enum.PartType.Cylinder, 0.15)
		TweenService:Create(beam, TweenInfo.new(1.6), { Size = Vector3.new(80, 0.5, 0.5), Transparency = 1 }):Play()
		task.delay(1.7, function()
			beam:Destroy()
		end)
		shockwave(portalPos + Vector3.new(0, 0.6, 0), rc, 50 + lvl * 10, 0.7)
		burst(portalPos + Vector3.new(0, 6, 0), rc, 30 + lvl * 25, 26)
		if lvl &gt;= 5 then
			burst(portalPos + Vector3.new(0, 10, 0), Color3.fromRGB(255, 230, 120), 120, 40, "rbxasset://textures/particles/sparkles_main.dds")
		end
		if portal then
			pulse(portal, rc, 0.4)
		end
		if lvl &gt;= 4 then
			Cine.Title(string.upper(res.rarity) .. "!", rc, 1.2, 150, 0.3)
		end

		-- 5) the car rolls out of the portal; camera tracks it
		camTween:Cancel()
		local ghost = VehicleFactory.BuildCar(def)
		local y = BaseLayout.FloorY
		local p0 = Vector3.new(portalPos.X, y, portalPos.Z)
		local laneX = BaseLayout.LaneX
		local pts = { p0, bcf:PointToWorldSpace(Vector3.new(laneX, y, BaseLayout.PortalLocal.Z)) }
		if res.slot then
			local sl = BaseLayout.SlotLocal(res.slot)
			table.insert(pts, bcf:PointToWorldSpace(Vector3.new(laneX, y, sl.Z)))
			table.insert(pts, bcf:PointToWorldSpace(Vector3.new(sl.X, y, sl.Z)))
		end
		local total = 0
		for i = 2, #pts do
			total = total + (pts[i] - pts[i - 1]).Magnitude
		end
		ghost:PivotTo(faceCF(p0, pts[2] - pts[1]))
		ghost.Parent = Workspace
		Cine.Zoom(60, 0.6)
		Cine.Darken(0, 0.6)
		local orbit0 = math.random() * math.pi * 2
		local drive = 1.7 + (lvl &gt;= 5 and 0.5 or 0)
		animate(drive, function(a)
			local e = 1 - (1 - a) ^ 2
			local d = e * total
			local acc = 0
			local pos
			for i = 2, #pts do
				local seg = (pts[i] - pts[i - 1]).Magnitude
				if d &lt;= acc + seg or i == #pts then
					local f = math.clamp((d - acc) / math.max(seg, 0.001), 0, 1)
					pos = pts[i - 1]:Lerp(pts[i], f)
					ghost.PrimaryPart.CFrame = faceCF(pos, pts[i] - pts[i - 1])
					break
				end
				acc = acc + seg
			end
			local ang = orbit0 + a * 1.6
			local focus = pos + Vector3.new(0, 3, 0)
			cam.CFrame = CFrame.lookAt(focus + Vector3.new(math.cos(ang) * 22, 9, math.sin(ang) * 22), focus)
		end)
		Cine.Shake(0.5, 0.2)
		if not res.slot then
			for _, d in ipairs(ghost:GetDescendants()) do
				if d:IsA("BasePart") and d.Name ~= "Root" then
					TweenService:Create(d, TweenInfo.new(0.4), { Transparency = 1 }):Play()
				end
			end
			task.wait(0.4)
		end
		-- keep the ghost until the server-side car appears in the slot
		task.delay(math.max(0.3, (res.animTime or 5.2) + 0.4 - (os.clock() - tStart)), function()
			ghost:Destroy()
		end)

		-- 6) hand the camera back
		Cine.Letterbox(false, 0.35)
		Cine.Move(cam0, 0.35)
		task.wait(0.3)
		Cine.Release(0.3)
		if onDone then
			onDone()
		end
	end)
end

return TrapFx
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX50"><Properties><string name="Name">UI</string><ProtectedString name="Source">-- CAR HUNTERS UI (design: Figma "CAR HUNTERS — Game UI"). Toy buttons, cartoon fonts, no purple.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Strings = require(Shared:WaitForChild("Strings"))
local Util = require(Shared:WaitForChild("Util"))
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))
local VehicleFactory = require(Shared:WaitForChild("VehicleFactory"))

local T = Strings.T
local C = Color3.fromRGB
local HEAD = Enum.Font.LuckiestGuy
local BODY = Enum.Font.FredokaOne

local P = {
	yellow = C(255, 210, 63), orange = C(255, 138, 31), red = C(255, 59, 59), green = C(52, 208, 88),
	blue = C(46, 168, 255), cyan = C(34, 224, 224), ink = C(27, 31, 42), white = C(255, 255, 255),
	cream = C(255, 246, 224), grey = C(170, 176, 188), muted = C(96, 102, 116),
}
local PART_ICON = { bolts = "🔩", tire = "🛞", engine = "⚙️", turbo = "🌀", core = "⚡" }
local ZONE_ICON = { city = "🏙️", highway = "🛣️", industrial = "🏭", neon = "🌃" }
local ZONE_COLOR = { city = P.green, highway = P.blue, industrial = P.red, neon = P.cyan, plaza = P.orange }

local UI = {}
local store, actions
local gui, root
local hud, panels = {}, {}
local state = { selectedPart = nil, nearTrap = false, open = nil, sellArm = {} }
local sounds = {}

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do
		o[k] = v
	end
	o.Parent = parent
	return o
end
local function corner(o, r)
	return new("UICorner", { CornerRadius = UDim.new(0, r or 16) }, o)
end
local function stroke(o, color, th)
	return new("UIStroke", { Color = color or P.ink, Thickness = th or 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
end
local function lift(c, k)
	return c:Lerp(k &gt; 0 and P.white or C(0, 0, 0), math.abs(k))
end
local function gradient(o, c)
	return new("UIGradient", { Color = ColorSequence.new(lift(c, 0.35), c), Rotation = 90 }, o)
end
local function tween(o, t, props, style, dir)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end
local function text(parent, props)
	local l = new("TextLabel", {
		BackgroundTransparency = 1, Font = HEAD, TextColor3 = P.white, TextScaled = false, TextSize = 22,
		Size = UDim2.new(1, 0, 0, 28), TextXAlignment = Enum.TextXAlignment.Left,
	}, parent)
	for k, v in pairs(props) do
		if k ~= "Outline" then
			l[k] = v
		end
	end
	if props.Outline ~= false and l.Font == HEAD then
		new("UIStroke", { Color = P.ink, Thickness = props.Outline or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual }, l)
	end
	return l
end
local function clear(f)
	for _, c in ipairs(f:GetChildren()) do
		if not c:IsA("UIListLayout") and not c:IsA("UIGridLayout") and not c:IsA("UIPadding") then
			c:Destroy()
		end
	end
end
local function list(o, dir, gap, ha, va)
	return new("UIListLayout", { FillDirection = dir or Enum.FillDirection.Vertical, Padding = UDim.new(0, gap or 8),
		HorizontalAlignment = ha or Enum.HorizontalAlignment.Left, VerticalAlignment = va or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder }, o)
end

-- Toy button: shadow slab + face with gradient, ink outline, outlined label. Returns api.
local function toy(parent, o)
	local holder = new("Frame", { Name = o.Name or "Toy", BackgroundTransparency = 1, Size = o.Size, Position = o.Position or UDim2.new(),
		AnchorPoint = o.AnchorPoint or Vector2.zero, LayoutOrder = o.LayoutOrder or 0, ZIndex = o.ZIndex or 1 }, parent)
	local depth = o.Depth or 6
	local shadow = new("Frame", { BackgroundColor3 = lift(o.Color, -0.55), Size = UDim2.new(1, 0, 1, -depth), Position = UDim2.fromOffset(0, depth), BorderSizePixel = 0, ZIndex = holder.ZIndex }, holder)
	corner(shadow, o.Radius or 18)
	local face = new("TextButton", { Text = "", AutoButtonColor = false, BackgroundColor3 = P.white, Size = UDim2.new(1, 0, 1, -depth), BorderSizePixel = 0, ZIndex = holder.ZIndex + 1 }, holder)
	corner(face, o.Radius or 18)
	stroke(face, P.ink, 3)
	local grad = gradient(face, o.Color)
	local content = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = face.ZIndex }, face)
	list(content, Enum.FillDirection.Vertical, 0, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	local h = holder.Size.Y.Offset
	local icon
	if o.Icon then
		icon = text(content, { Text = o.Icon, Font = BODY, TextSize = o.IconSize or math.floor(h * 0.34), Size = UDim2.new(1, 0, 0, math.floor(h * 0.4)), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = face.ZIndex, LayoutOrder = 1 })
	end
	local label = text(content, { Text = o.Text or "", TextSize = o.TextSize or math.floor(h * (o.Icon and 0.2 or 0.36)), RichText = true,
		Size = UDim2.new(1, -8, 0, math.floor(h * (o.Icon and 0.26 or 0.5))), TextXAlignment = Enum.TextXAlignment.Center, Outline = 2.5, ZIndex = face.ZIndex, LayoutOrder = 2 })
	local sub
	if o.Sub then
		sub = text(content, { Text = o.Sub, Font = BODY, TextSize = o.SubSize or math.floor(h * 0.15), TextColor3 = P.ink, Size = UDim2.new(1, -8, 0, math.floor(h * 0.2)), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = face.ZIndex, LayoutOrder = 3, RichText = true })
	end
	local api = { holder = holder, face = face, label = label, sub = sub, icon = icon, enabled = true }
	function api.SetColor(c)
		grad.Color = ColorSequence.new(lift(c, 0.35), c)
		shadow.BackgroundColor3 = lift(c, -0.55)
	end
	function api.SetText(t, s)
		label.Text = t
		if sub and s then
			sub.Text = s
		end
	end
	face.MouseButton1Down:Connect(function()
		face.Position = UDim2.fromOffset(0, depth - 2)
	end)
	local function up()
		face.Position = UDim2.new()
	end
	face.MouseButton1Up:Connect(up)
	face.MouseLeave:Connect(up)
	face.Activated:Connect(function()
		up()
		if o.OnClick and api.enabled then
			UI.Sfx("click")
			o.OnClick()
		end
	end)
	return api
end

local function pill(parent, txt, color, props)
	local f = new("Frame", { BackgroundColor3 = color, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, props and props.H or 30), BorderSizePixel = 0, LayoutOrder = props and props.LayoutOrder or 0 }, parent)
	corner(f, 30)
	stroke(f, P.ink, 2.5)
	new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, f)
	local l = text(f, { Text = txt, TextSize = props and props.TextSize or 18, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromScale(0, 1), TextXAlignment = Enum.TextXAlignment.Center })
	return f, l
end

local function rarityColor(r)
	return CarConfig.Rarities[r].color
end

local function fitCamera(vp, model, angle)
	local cam = vp.CurrentCamera or new("Camera", { FieldOfView = 38 }, vp)
	vp.CurrentCamera = cam
	local size = model:GetExtentsSize()
	local d = math.max(size.X, size.Z, size.Y * 1.6) * 1.3
	local a = angle or math.rad(35)
	local center = Vector3.new(0, size.Y * 0.45, 0)
	cam.CFrame = CFrame.lookAt(center + Vector3.new(math.cos(a) * d, d * 0.38, math.sin(a) * d), center)
end

local function carViewport(parent, def, props)
	local vp = new("ViewportFrame", { BackgroundTransparency = 1, Ambient = C(200, 200, 210), LightColor = C(255, 250, 240), LightDirection = Vector3.new(-1, -2, -1) }, parent)
	for k, v in pairs(props or {}) do
		vp[k] = v
	end
	local m = VehicleFactory.BuildCar(def, { Low = true })
	m:PivotTo(CFrame.new())
	m.Parent = vp
	fitCamera(vp, m)
	return vp, m
end

---------------------------------------------------------------- sound / toasts
function UI.Sfx(name)
	local s = sounds[name]
	if s then
		s:Play()
	end
end
local function makeSound(name, id, vol, speed)
	sounds[name] = new("Sound", { Name = "UI_" .. name, SoundId = id, Volume = vol or 0.5, PlaybackSpeed = speed or 1 }, SoundService)
end

local KIND_COLOR = { good = P.green, error = P.red, warn = P.orange, info = P.blue }
function UI.Toast(msg, kind)
	local f = new("Frame", { BackgroundColor3 = KIND_COLOR[kind] or P.blue, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 44), BorderSizePixel = 0, ZIndex = 50 }, hud.toasts)
	corner(f, 22)
	stroke(f, P.ink, 3)
	new("UIPadding", { PaddingLeft = UDim.new(0, 18), PaddingRight = UDim.new(0, 18) }, f)
	local l = text(f, { Text = msg, TextSize = 22, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromScale(0, 1), ZIndex = 51 })
	local sc = new("UIScale", { Scale = 0.4 }, f)
	tween(sc, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(2.6, function()
		tween(f, 0.3, { BackgroundTransparency = 1 })
		tween(l, 0.3, { TextTransparency = 1 })
		task.wait(0.32)
		f:Destroy()
	end)
	UI.Sfx(kind == "error" and "err" or "ping")
end

function UI.Notify(payload)
	if type(payload) ~= "table" then
		return
	end
	UI.Toast(T("n_" .. tostring(payload.key), table.unpack(payload.args or {})), payload.kind)
end

---------------------------------------------------------------- HUD
local function buildHud()
	-- money pill
	local money = new("Frame", { Position = UDim2.fromOffset(18, 16), Size = UDim2.fromOffset(250, 66), BackgroundColor3 = P.ink, BorderSizePixel = 0 }, root)
	corner(money, 40)
	stroke(money, P.white, 3)
	local coin = new("Frame", { Position = UDim2.fromOffset(10, 11), Size = UDim2.fromOffset(44, 44), BackgroundColor3 = P.white, BorderSizePixel = 0 }, money)
	corner(coin, 22)
	stroke(coin, P.ink, 3)
	new("UIGradient", { Color = ColorSequence.new(C(255, 230, 128), P.orange), Rotation = 90 }, coin)
	text(coin, { Text = "$", TextSize = 26, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center })
	hud.money = text(money, { Position = UDim2.fromOffset(64, 6), Size = UDim2.fromOffset(180, 34), TextSize = 32, TextColor3 = P.yellow })
	hud.income = text(money, { Position = UDim2.fromOffset(64, 38), Size = UDim2.fromOffset(180, 22), TextSize = 17, Font = BODY, TextColor3 = P.green })
	hud.moneyScale = new("UIScale", {}, money)

	-- banked parts row
	local row = new("Frame", { Position = UDim2.fromOffset(18, 92), Size = UDim2.fromOffset(420, 34), BackgroundTransparency = 1 }, root)
	list(row, Enum.FillDirection.Horizontal, 6)
	hud.parts = {}
	for i, id in ipairs(PartConfig.Order) do
		local chip = new("Frame", { Size = UDim2.fromOffset(70, 34), BackgroundColor3 = P.white, BorderSizePixel = 0, LayoutOrder = i }, row)
		corner(chip, 14)
		stroke(chip, rarityColor(PartConfig.Parts[id].rarity), 3.5)
		text(chip, { Text = PART_ICON[id], Font = BODY, TextSize = 18, Position = UDim2.fromOffset(6, 0), Size = UDim2.fromOffset(26, 34) })
		hud.parts[id] = { chip = chip, n = text(chip, { Text = "0", TextSize = 20, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(34, 2), Size = UDim2.fromOffset(34, 32) }) }
	end

	-- risky loot badge
	local bag = new("Frame", { Position = UDim2.fromOffset(18, 134), Size = UDim2.fromOffset(240, 34), BackgroundColor3 = P.red, BorderSizePixel = 0, Visible = false }, root)
	corner(bag, 12)
	stroke(bag, P.ink, 3)
	hud.bag = bag
	hud.bagText = text(bag, { Text = "", TextSize = 19, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -12, 1, 0) })

	-- zone banner + hint
	local banner = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 14), Size = UDim2.fromOffset(290, 46), BackgroundColor3 = P.white, BorderSizePixel = 0 }, root)
	corner(banner, 14)
	stroke(banner, P.ink, 3.5)
	hud.bannerGrad = gradient(banner, P.orange)
	hud.zone = text(banner, { Text = "", TextSize = 28, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Outline = 3 })
	local hint = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 70), AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 40), BackgroundColor3 = P.white, BorderSizePixel = 0, Visible = false }, root)
	corner(hint, 20)
	stroke(hint, P.ink, 3)
	new("UIPadding", { PaddingLeft = UDim.new(0, 18), PaddingRight = UDim.new(0, 18) }, hint)
	hud.hintFrame = hint
	hud.hint = text(hint, { Text = "", Font = BODY, TextSize = 20, TextColor3 = P.ink, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromScale(0, 1) })

	-- side buttons (minimum: 3)
	local side = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -16, 0.42, 0), Size = UDim2.fromOffset(122, 3 * 104 + 24), BackgroundTransparency = 1 }, root)
	list(side, Enum.FillDirection.Vertical, 12)
	toy(side, { Text = T("btn_teleport"), Icon = "🚀", Color = P.blue, Size = UDim2.fromOffset(122, 104), LayoutOrder = 1, OnClick = function() UI.TogglePanel("teleport") end })
	toy(side, { Text = T("btn_garage"), Icon = "🏁", Color = P.orange, Size = UDim2.fromOffset(122, 104), LayoutOrder = 2, OnClick = function() UI.TogglePanel("garage") end })
	toy(side, { Text = T("btn_index"), Icon = "🚗", Color = P.green, Size = UDim2.fromOffset(122, 104), LayoutOrder = 3, OnClick = function() UI.TogglePanel("index") end })
	hud.newDot = new("Frame", { Size = UDim2.fromOffset(22, 22), Position = UDim2.new(1, -16, 0, -6), BackgroundColor3 = P.red, Visible = false, ZIndex = 5 }, side)
	corner(hud.newDot, 11)
	stroke(hud.newDot, P.white, 3)

	-- THROW (only near own trap)
	hud.throw = toy(root, { Name = "Throw", Text = T("btn_throw"), Sub = "", Color = P.yellow, Size = UDim2.fromOffset(300, 104),
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -24), OnClick = function() UI.TogglePanel("throw") end })
	hud.throw.holder.Visible = false

	hud.toasts = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 120), Size = UDim2.fromOffset(600, 200), BackgroundTransparency = 1, ZIndex = 50 }, root)
	list(hud.toasts, Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center)
	hud.flash = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = P.red, BackgroundTransparency = 1, ZIndex = 40, Active = false }, gui)
end

---------------------------------------------------------------- panels
local function panelShell(name, title, w, h, color)
	local dim = new("TextButton", { Name = name, Text = "", AutoButtonColor = false, Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(0, 0, 0), BackgroundTransparency = 0.5, Visible = false, ZIndex = 20 }, root)
	dim.Activated:Connect(function() UI.TogglePanel(nil) end)
	local card = new("TextButton", { Text = "", AutoButtonColor = false, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(w, h), BackgroundColor3 = P.cream, ZIndex = 21 }, dim)
	corner(card, 28)
	stroke(card, P.ink, 5)
	local head = new("Frame", { Size = UDim2.new(1, 0, 0, 70), BackgroundColor3 = P.white, ZIndex = 22 }, card)
	corner(head, 28)
	stroke(head, P.ink, 5)
	gradient(head, color)
	text(head, { Text = title, TextSize = 38, Position = UDim2.fromOffset(28, 0), Size = UDim2.new(1, -110, 1, 0), ZIndex = 23, Outline = 3 })
	toy(card, { Text = "X", Color = P.red, Size = UDim2.fromOffset(60, 64), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 14, 0, -18), ZIndex = 24, OnClick = function() UI.TogglePanel(nil) end })
	local content = new("Frame", { Position = UDim2.fromOffset(22, 86), Size = UDim2.new(1, -44, 1, -104), BackgroundTransparency = 1, ZIndex = 22 }, card)
	local sc = new("UIScale", {}, card)
	panels[name] = { root = dim, card = card, content = content, scale = sc }
	return panels[name]
end

local function scroller(parent, pos, size)
	local s = new("ScrollingFrame", { Position = pos, Size = size, BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 8, ScrollBarImageColor3 = P.ink,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 22 }, parent)
	list(s, Enum.FillDirection.Vertical, 10)
	new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 12) }, s)
	return s
end

-- THROW / bait picker
local function buildThrow()
	local p = panelShell("throw", T("throw_title"), 900, 470, P.yellow)
	local c = p.content
	local cards = new("Frame", { Size = UDim2.new(1, 0, 0, 190), BackgroundTransparency = 1, ZIndex = 22 }, c)
	list(cards, Enum.FillDirection.Horizontal, 14, Enum.HorizontalAlignment.Center)
	panels.baitCards = {}
	for i, id in ipairs(PartConfig.Order) do
		local def = PartConfig.Parts[id]
		local b = new("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.fromOffset(150, 180), BackgroundColor3 = P.white, LayoutOrder = i, ZIndex = 23 }, cards)
		corner(b, 22)
		local st = stroke(b, rarityColor(def.rarity), 6)
		text(b, { Text = PART_ICON[id], Font = BODY, TextSize = 54, Position = UDim2.fromOffset(0, 12), Size = UDim2.new(1, 0, 0, 70), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
		text(b, { Text = T("part_" .. id), TextSize = 22, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(0, 90), Size = UDim2.new(1, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
		local n = text(b, { Text = "x0", TextSize = 28, TextColor3 = rarityColor(def.rarity), Position = UDim2.fromOffset(0, 124), Size = UDim2.new(1, 0, 0, 34), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
		b.Activated:Connect(function()
			state.selectedPart = id
			UI.Sfx("click")
			UI.Refresh()
		end)
		panels.baitCards[id] = { btn = b, stroke = st, n = n }
	end
	local bar = new("Frame", { Position = UDim2.fromOffset(0, 204), Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = P.white, ZIndex = 22, ClipsDescendants = true }, c)
	corner(bar, 15)
	stroke(bar, P.ink, 3)
	list(bar, Enum.FillDirection.Horizontal, 0)
	panels.oddsBar = bar
	panels.oddsText = text(c, { Text = "", Font = BODY, TextSize = 17, TextColor3 = P.ink, Position = UDim2.fromOffset(0, 240), Size = UDim2.new(1, 0, 0, 24), RichText = true, ZIndex = 22 })
	panels.throwGo = toy(c, { Text = T("btn_throw"), Color = P.green, Size = UDim2.fromOffset(300, 84), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 4), ZIndex = 23,
		OnClick = function()
			if state.selectedPart and store.Banked(state.selectedPart) &gt; 0 then
				actions.Throw(state.selectedPart)
				UI.TogglePanel(nil)
			else
				UI.Toast(T("n_noPart"), "error")
			end
		end })
end

local function refreshThrow()
	local st = store.State
	if not st then
		return
	end
	if not state.selectedPart or store.Banked(state.selectedPart) &lt;= 0 then
		state.selectedPart = nil
		for i = #PartConfig.Order, 1, -1 do
			if store.Banked(PartConfig.Order[i]) &gt; 0 then
				state.selectedPart = PartConfig.Order[i]
				break
			end
		end
	end
	local sel = state.selectedPart
	local n = sel and store.Banked(sel) or 0
	hud.throw.SetText(T("btn_throw"), sel and string.format("%s %s x%d", PART_ICON[sel], T("part_" .. sel), n) or T("throw_none"))
	hud.throw.SetColor(sel and P.yellow or P.grey)
	if not panels.baitCards then
		return
	end
	for id, cd in pairs(panels.baitCards) do
		local cnt = store.Banked(id)
		cd.n.Text = "x" .. cnt
		cd.btn.BackgroundTransparency = cnt &gt; 0 and 0 or 0.45
		cd.stroke.Color = (id == sel) and P.ink or rarityColor(PartConfig.Parts[id].rarity)
		cd.stroke.Thickness = (id == sel) and 8 or 5
	end
	clear(panels.oddsBar)
	local row = CarConfig.DropChances[sel or "bolts"]
	local pity = st.pity or 0
	local pityNow = pity &gt;= EconomyConfig.PityThreshold - 1
	if pityNow then
		row = CarConfig.PityRow(sel or "bolts")
	end
	local parts = {}
	for i, r in ipairs(CarConfig.RarityOrder) do
		local v = row[r]
		if v &gt; 0 then
			new("Frame", { Size = UDim2.new(v / 100, 0, 1, 0), BackgroundColor3 = rarityColor(r), BorderSizePixel = 0, LayoutOrder = i, ZIndex = 23 }, panels.oddsBar)
		end
		local hexc = rarityColor(r):ToHex()
		table.insert(parts, string.format('&lt;font color="#%s"&gt;%s %s%%&lt;/font&gt;', hexc, T("rarity_" .. r), (v % 1 == 0) and tostring(v) or string.format("%.1f", v)))
	end
	local pityTxt = pityNow and T("throw_pity_now") or T("throw_pity", EconomyConfig.PityThreshold - pity)
	panels.oddsText.Text = table.concat(parts, "  ") .. "   |   " .. pityTxt
	panels.throwGo.SetColor((sel and n &gt; 0) and P.green or P.grey)
end

-- TELEPORT (also unlocks districts)
local function buildTeleport()
	local p = panelShell("teleport", T("tp_title"), 820, 560, P.blue)
	panels.tpGrid = new("Frame", { Size = UDim2.new(1, 0, 1, -40), BackgroundTransparency = 1, ZIndex = 22 }, p.content)
	new("UIGridLayout", { CellSize = UDim2.fromOffset(240, 196), CellPadding = UDim2.fromOffset(16, 18), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }, panels.tpGrid)
	text(p.content, { Text = "⚠ " .. T("tp_walk"), Font = BODY, TextSize = 19, TextColor3 = P.red, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), ZIndex = 22 })
end

local function refreshTeleport()
	local st = store.State
	if not st or state.open ~= "teleport" then
		return
	end
	clear(panels.tpGrid)
	local function tile(order, title, icon, color, sub, onClick)
		local f = new("Frame", { BackgroundTransparency = 1, LayoutOrder = order, ZIndex = 22 }, panels.tpGrid)
		local t = toy(f, { Text = title, Icon = icon, Sub = sub, Color = color, Size = UDim2.fromOffset(240, 190), ZIndex = 23, SubSize = 17, OnClick = onClick })
		return t
	end
	tile(0, T("tp_home"), "🏠", P.orange, T("tp_home_desc"), function()
		actions.Teleport("home")
		UI.TogglePanel(nil)
	end)
	for i, zid in ipairs(MapConfig.ZoneOrder) do
		local zone = MapConfig.Zones[zid]
		local open = st.zones[zid] == true
		local prevOpen = i == 1 or st.zones[MapConfig.ZoneOrder[i - 1]] == true
		local req = EconomyConfig.ZoneUnlock[zid]
		local title = string.gsub(zone.name, " DISTRICT", "")
		if open then
			tile(i, title, ZONE_ICON[zid], ZONE_COLOR[zid], T("zone_desc_" .. zid), function()
				actions.Teleport(zid)
				UI.TogglePanel(nil)
			end)
		else
			local can = prevOpen and req and store.Money &gt;= req.cost and store.CollectionValue &gt;= req.minValue
			local sub = not prevOpen and T("zones_need_prev")
				or string.format("🔒 $%s  ·  %s $%s", Util.FormatNumber(req.cost), T("zones_value"), Util.FormatNumber(req.minValue))
			local t = tile(i, can and (T("btn_unlock") .. "!") or title, "🔒", can and P.green or P.grey, sub, function()
				if can then
					actions.Unlock(zid)
				elseif prevOpen and store.CollectionValue &lt; req.minValue then
					UI.Toast(T("n_needValue"), "warn")
				elseif prevOpen then
					UI.Toast(T("n_noMoney"), "error")
				else
					UI.Toast(T("n_needPrev"), "warn")
				end
			end)
			if not can then
				t.holder.Size = UDim2.fromOffset(240, 190)
			end
		end
	end
end

-- GARAGE
local function buildGarage()
	local p = panelShell("garage", T("garage_title"), 900, 580, P.orange)
	local c = p.content
	panels.garageInfo = text(c, { Text = "", Font = BODY, TextSize = 20, TextColor3 = P.ink, Size = UDim2.new(1, -380, 0, 50), ZIndex = 22, RichText = true })
	panels.autoBtn = toy(c, { Text = T("btn_autopark"), Color = P.green, Size = UDim2.fromOffset(170, 54), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -190, 0, -2), ZIndex = 23, OnClick = function() actions.AutoPark() end })
	panels.slotBtn = toy(c, { Text = T("btn_buyslot"), Sub = "", Color = P.blue, Size = UDim2.fromOffset(176, 54), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, -2), ZIndex = 23, SubSize = 14,
		OnClick = function() actions.BuySlot(store.State.slots + 1) end })
	panels.carList = scroller(c, UDim2.fromOffset(0, 62), UDim2.new(1, 0, 1, -62))
end

local function sortedCars(st)
	local out = table.clone(st.cars)
	table.sort(out, function(a, b)
		local ia = CarConfig.IncomeAt(CarConfig.ById[a.typeId], a.level)
		local ib = CarConfig.IncomeAt(CarConfig.ById[b.typeId], b.level)
		if ia ~= ib then
			return ia &gt; ib
		end
		return a.uid &lt; b.uid
	end)
	return out
end

local function freeSlot(st)
	local used, worst, worstInc = {}, nil, nil
	for _, c in ipairs(st.cars) do
		if c.slot then
			used[c.slot] = true
			local inc = CarConfig.IncomeAt(CarConfig.ById[c.typeId], c.level)
			if not worstInc or inc &lt; worstInc then
				worst, worstInc = c.slot, inc
			end
		end
	end
	for i = 1, st.slots do
		if not used[i] then
			return i
		end
	end
	return worst or 1
end

local function refreshGarage()
	local st = store.State
	if not st or state.open ~= "garage" then
		return
	end
	local parked = 0
	for _, c in ipairs(st.cars) do
		if c.slot then
			parked = parked + 1
		end
	end
	panels.garageInfo.Text = string.format('&lt;font color="#1E9E40"&gt;+%s/s&lt;/font&gt;   🅿 %d/%d   🚗 %d', Util.FormatNumber(store.Income), parked, st.slots, #st.cars)
	local cost = EconomyConfig.SlotCosts[st.slots + 1]
	if cost then
		panels.slotBtn.SetText(T("btn_buyslot"), "$" .. Util.FormatNumber(cost))
		panels.slotBtn.SetColor(store.Money &gt;= cost and P.blue or P.grey)
	else
		panels.slotBtn.SetText(T("btn_max"), "")
		panels.slotBtn.SetColor(P.grey)
	end
	clear(panels.carList)
	local cars = sortedCars(st)
	if #cars == 0 then
		text(panels.carList, { Text = T("garage_empty"), Font = BODY, TextSize = 20, TextColor3 = P.muted, TextWrapped = true, Size = UDim2.new(1, 0, 0, 60), ZIndex = 23 })
		return
	end
	local now = os.clock()
	for i, c in ipairs(cars) do
		local def = CarConfig.ById[c.typeId]
		local rc = rarityColor(def.rarity)
		local row = new("Frame", { Size = UDim2.new(1, 0, 0, 84), BackgroundColor3 = P.white, LayoutOrder = i, ZIndex = 23 }, panels.carList)
		corner(row, 18)
		stroke(row, rc, 4)
		local band = new("Frame", { Size = UDim2.new(0, 10, 1, -16), Position = UDim2.fromOffset(8, 8), BackgroundColor3 = rc, BorderSizePixel = 0, ZIndex = 24 }, row)
		corner(band, 5)
		text(row, { Text = def.name, TextSize = 24, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(28, 8), Size = UDim2.fromOffset(300, 30), ZIndex = 24 })
		local where = c.slot and T("car_parked", c.slot) or T("car_stored")
		text(row, { Text = string.format('&lt;font color="#%s"&gt;%s&lt;/font&gt;  ·  %s  ·  &lt;font color="#1E9E40"&gt;%s&lt;/font&gt;  ·  %s', rc:ToHex(), string.upper(T("rarity_" .. def.rarity)),
			T("car_level", c.level), T("car_income", Util.FormatNumber(CarConfig.IncomeAt(def, c.level))), where),
			Font = BODY, TextSize = 16, TextColor3 = P.muted, RichText = true, Position = UDim2.fromOffset(28, 44), Size = UDim2.fromOffset(420, 26), ZIndex = 24 })
		local btns = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(380, 60), BackgroundTransparency = 1, ZIndex = 24 }, row)
		list(btns, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
		if c.slot then
			toy(btns, { Text = T("btn_remove"), Color = P.orange, Size = UDim2.fromOffset(96, 54), TextSize = 16, LayoutOrder = 1, ZIndex = 25, OnClick = function() actions.Remove(c.uid) end })
		else
			toy(btns, { Text = T("btn_place"), Color = P.green, Size = UDim2.fromOffset(96, 54), TextSize = 18, LayoutOrder = 1, ZIndex = 25, OnClick = function() actions.Place(c.uid, freeSlot(st)) end })
		end
		if c.level &gt;= def.maxLevel then
			toy(btns, { Text = T("btn_max"), Color = P.grey, Size = UDim2.fromOffset(170, 54), LayoutOrder = 2, ZIndex = 25 })
		else
			local cost = CarConfig.UpgradeCost(def, c.level)
			local partId, amount = CarConfig.UpgradeParts(def, c.level)
			local ok = store.Money &gt;= cost and (st.parts[partId] or 0) &gt;= amount
			toy(btns, { Text = T("btn_upgrade"), Sub = string.format("$%s + %s%d", Util.FormatNumber(cost), PART_ICON[partId], amount), SubSize = 14, TextSize = 18,
				Color = ok and P.blue or P.grey, Size = UDim2.fromOffset(170, 54), LayoutOrder = 2, ZIndex = 25, OnClick = function() actions.Upgrade(c.uid, c.level) end })
		end
		local armed = state.sellArm[c.uid] and now - state.sellArm[c.uid] &lt; 3
		toy(btns, { Text = armed and T("btn_sure") or T("btn_sell"), Sub = "$" .. Util.FormatNumber(CarConfig.SellPrice(def, c.level)), SubSize = 13, TextSize = 16,
			Color = P.red, Size = UDim2.fromOffset(86, 54), LayoutOrder = 3, ZIndex = 25, OnClick = function()
				if armed then
					state.sellArm[c.uid] = nil
					actions.Sell(c.uid)
				else
					state.sellArm[c.uid] = os.clock()
					refreshGarage()
					task.delay(3.1, refreshGarage)
				end
			end })
	end
end

-- CARS index
local function buildIndex()
	local p = panelShell("index", T("index_title"), 900, 580, P.green)
	panels.indexInfo = text(p.content, { Text = "", Font = BODY, TextSize = 19, TextColor3 = P.ink, Size = UDim2.new(1, 0, 0, 26), ZIndex = 22 })
	local s = new("ScrollingFrame", { Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 1, -34), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 8,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 22 }, p.content)
	new("UIGridLayout", { CellSize = UDim2.fromOffset(196, 150), CellPadding = UDim2.fromOffset(12, 12), SortOrder = Enum.SortOrder.LayoutOrder }, s)
	panels.indexGrid = s
	panels.indexCards = {}
end

local function refreshIndex()
	local st = store.State
	if not st or state.open ~= "index" then
		return
	end
	local found, total, _, mult = CarConfig.IndexStats(st.discovered or {})
	panels.indexInfo.Text = T("index_found", found, total) .. "   ·   " .. T("index_bonus", string.format("%.2f", mult)) .. "   ·   " .. T("index_hint")
	for i, def in ipairs(CarConfig.List) do
		local known = st.discovered and st.discovered[def.id]
		local cd = panels.indexCards[def.id]
		if not cd or cd.known ~= known then
			if cd then
				cd.frame:Destroy()
			end
			local rc = rarityColor(def.rarity)
			local f = new("Frame", { BackgroundColor3 = known and P.white or C(60, 64, 76), LayoutOrder = i, ZIndex = 23 }, panels.indexGrid)
			corner(f, 18)
			stroke(f, rc, 4)
			if known then
				carViewport(f, def, { Size = UDim2.new(1, 0, 1, -44), ZIndex = 24 })
			else
				text(f, { Text = "?", TextSize = 70, Size = UDim2.new(1, 0, 1, -44), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = rc, ZIndex = 24 })
			end
			text(f, { Text = known and def.name or T("index_unknown"), TextSize = 17, TextColor3 = known and P.ink or P.white, Outline = false, AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.new(0, 0, 1, -20), Size = UDim2.new(1, 0, 0, 22), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
			text(f, { Text = string.upper(T("rarity_" .. def.rarity)), Font = BODY, TextSize = 14, TextColor3 = rc, AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.new(0, 0, 1, -2), Size = UDim2.new(1, 0, 0, 18), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
			panels.indexCards[def.id] = { frame = f, known = known }
		end
	end
end

function UI.TogglePanel(name)
	if name ~= nil and state.open == name then
		name = nil
	end
	for n, p in pairs(panels) do
		if type(p) == "table" and p.root and p.scale then
			if n == name then
				p.root.Visible = true
				p.scale.Scale = 0.6
				tween(p.scale, 0.28, { Scale = 1 }, Enum.EasingStyle.Back)
			else
				p.root.Visible = false
			end
		end
	end
	state.open = name
	if name then
		UI.Sfx("open")
	end
	UI.Refresh()
end

---------------------------------------------------------------- reveal
local function buildReveal()
	local r = new("TextButton", { Name = "Reveal", Text = "", AutoButtonColor = false, Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(0, 0, 0), BackgroundTransparency = 0.25, Visible = false, ZIndex = 60 }, gui)
	local rays = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Size = UDim2.fromOffset(10, 10), BackgroundTransparency = 1, ZIndex = 60 }, r)
	for k = 0, 11 do
		new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(1600, 46), Rotation = k * 15, BackgroundColor3 = P.yellow, BackgroundTransparency = 0.82, BorderSizePixel = 0, ZIndex = 60 }, rays)
	end
	local box = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(640, 600), BackgroundTransparency = 1, ZIndex = 61 }, r)
	local sc = new("UIScale", {}, box)
	local top = text(box, { Text = T("reveal_new"), TextSize = 34, Size = UDim2.new(1, 0, 0, 40), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 62 })
	local badge = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 46), Size = UDim2.fromOffset(330, 54), BackgroundColor3 = P.white, ZIndex = 62 }, box)
	corner(badge, 27)
	stroke(badge, P.ink, 4)
	local badgeGrad = gradient(badge, P.yellow)
	local rarity = text(badge, { Text = "", TextSize = 36, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 63, Outline = 3 })
	local vpHolder = new("Frame", { Position = UDim2.fromOffset(60, 110), Size = UDim2.fromOffset(520, 270), BackgroundTransparency = 1, ZIndex = 62 }, box)
	local name = text(box, { Text = "", TextSize = 64, Position = UDim2.fromOffset(0, 380), Size = UDim2.new(1, 0, 0, 70), TextXAlignment = Enum.TextXAlignment.Center, Outline = 4, ZIndex = 62 })
	local info = text(box, { Text = "", Font = BODY, TextSize = 24, Position = UDim2.fromOffset(0, 452), Size = UDim2.new(1, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Center, RichText = true, ZIndex = 62 })
	local ok = toy(box, { Text = T("btn_awesome"), Color = P.green, Size = UDim2.fromOffset(300, 86), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), ZIndex = 63,
		OnClick = function() UI.HideReveal() end })
	panels.reveal = { root = r, rays = rays, box = box, sc = sc, top = top, badgeGrad = badgeGrad, rarity = rarity, vpHolder = vpHolder, name = name, info = info, ok = ok }
	r.Activated:Connect(function() UI.HideReveal() end)
end

function UI.HideReveal()
	local rv = panels.reveal
	if rv.root.Visible then
		rv.root.Visible = false
		if rv.conn then
			rv.conn:Disconnect()
			rv.conn = nil
		end
	end
end

function UI.ShowReveal(res)
	local rv = panels.reveal
	local def = CarConfig.ById[res.typeId]
	if not def then
		return
	end
	local rc = rarityColor(res.rarity)
	rv.top.Text = res.isNew and T("reveal_new") or T("reveal_got")
	rv.badgeGrad.Color = ColorSequence.new(lift(rc, 0.35), rc)
	rv.rarity.Text = "★ " .. string.upper(T("rarity_" .. res.rarity)) .. " ★"
	rv.name.Text = string.upper(def.name)
	rv.name.TextColor3 = rc
	local lines = { string.format('&lt;font color="#34D058"&gt;+%s/s&lt;/font&gt;', Util.FormatNumber(CarConfig.IncomeAt(def, 1))) }
	table.insert(lines, res.slot and T("reveal_placed", res.slot) or T("reveal_stored"))
	if res.isNew and res.bonus and res.bonus &gt; 0 then
		table.insert(lines, T("reveal_first", Util.FormatNumber(res.bonus)))
	end
	if res.pityUsed then
		table.insert(lines, T("reveal_pity"))
	end
	rv.info.Text = table.concat(lines, "  ·  ")
	for _, ray in ipairs(rv.rays:GetChildren()) do
		ray.BackgroundColor3 = rc
	end
	clear(rv.vpHolder)
	local vp, model = carViewport(rv.vpHolder, def, { Size = UDim2.fromScale(1, 1), ZIndex = 62 })
	rv.root.Visible = true
	rv.sc.Scale = 0.2
	tween(rv.sc, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	UI.Sfx("fanfare")
	local t0 = os.clock()
	if rv.conn then
		rv.conn:Disconnect()
	end
	rv.conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		rv.rays.Rotation = t * 25
		if model.Parent then
			fitCamera(vp, model, math.rad(35) + t * 0.8)
		end
	end)
end

---------------------------------------------------------------- refresh
local function refreshHud()
	local st = store.State
	hud.money.Text = "$" .. Util.FormatNumber(store.Money)
	hud.income.Text = "+" .. Util.FormatNumber(store.Income) .. " / sec"
	for id, p in pairs(hud.parts) do
		local n = store.Banked(id)
		p.n.Text = tostring(n)
		p.chip.BackgroundTransparency = n &gt; 0 and 0 or 0.4
	end
	local carried = store.CarriedTotal()
	hud.bag.Visible = carried &gt; 0
	if carried &gt; 0 then
		local icons = {}
		for _, id in ipairs(PartConfig.Order) do
			local n = store.Carried(id)
			if n &gt; 0 then
				table.insert(icons, PART_ICON[id] .. n)
			end
		end
		hud.bagText.Text = "🎒 " .. T("hud_risky", carried, st.carryCap or EconomyConfig.CarryCapacity) .. "  " .. table.concat(icons, " ")
		hud.bag.Size = UDim2.fromOffset(math.max(240, hud.bagText.TextBounds.X + 24), 34)
	end
	hud.throw.holder.Visible = state.nearTrap and state.open == nil
	-- "can unlock" dot on TELEPORT
	local dot = false
	for i, zid in ipairs(MapConfig.ZoneOrder) do
		local req = EconomyConfig.ZoneUnlock[zid]
		if req and not st.zones[zid] and st.zones[MapConfig.ZoneOrder[i - 1]] and store.Money &gt;= req.cost and store.CollectionValue &gt;= req.minValue then
			dot = true
		end
	end
	hud.newDot.Visible = dot
	hud.canUnlock = dot
end

local function refreshHint()
	local st = store.State
	local msg
	local throws = st.stats and st.stats.throws or 0
	if store.CarriedTotal() &gt; 0 then
		msg = T("tut_return")
	elseif throws == 0 then
		msg = store.BankedTotal() == 0 and T("tut_find") or T("tut_throw")
	elseif (st.stats.upgrades or 0) == 0 and #st.cars &gt; 0 then
		msg = T("tut_upgrade")
	elseif hud.canUnlock then
		msg = T("tut_zone")
	end
	hud.hintFrame.Visible = msg ~= nil and state.open == nil
	if msg then
		hud.hint.Text = "👉  " .. msg
	end
end

function UI.Refresh()
	if not store.State then
		return
	end
	refreshHud()
	refreshThrow()
	refreshHint()
	refreshGarage()
	refreshIndex()
	refreshTeleport()
end

function UI.SetZoneName(zoneId)
	if hud.lastZone == zoneId then
		return
	end
	hud.lastZone = zoneId
	hud.zone.Text = string.upper(T("zone_" .. zoneId))
	local c = ZONE_COLOR[zoneId] or P.orange
	hud.bannerGrad.Color = ColorSequence.new(lift(c, 0.35), c)
end

function UI.SetNearTrap(v)
	if state.nearTrap ~= v then
		state.nearTrap = v
		if not v and state.open == "throw" then
			UI.TogglePanel(nil)
		end
		refreshHud()
	end
end

function UI.FlashFrame()
	return hud.flash
end

function UI.Gui()
	return gui
end

function UI.Init(storeModule, actionTable)
	store, actions = storeModule, actionTable
	local player = Players.LocalPlayer
	gui = new("ScreenGui", { Name = "MainUI", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 10 })
	pcall(function()
		gui.ScreenInsets = Enum.ScreenInsets.CoreUISafe
	end)
	root = new("Frame", { Name = "Root", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, gui)
	local uiScale = new("UIScale", {}, root)
	local function rescale()
		local vp = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
		local s = math.clamp(math.min(vp.Y / 760, vp.X / 1240), 0.5, 1.2)
		uiScale.Scale = s
		root.Size = UDim2.fromScale(1 / s, 1 / s)
	end
	rescale()
	if Workspace.CurrentCamera then
		Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	end
	makeSound("ping", "rbxasset://sounds/electronicpingshort.wav", 0.45, 1.2)
	makeSound("click", "rbxasset://sounds/button.wav", 0.35)
	makeSound("open", "rbxasset://sounds/swoosh.wav", 0.25, 1.3)
	makeSound("fanfare", "rbxasset://sounds/victory.wav", 0.5)
	makeSound("err", "rbxasset://sounds/uuhhh.mp3", 0.3, 1.2)
	makeSound("throw", "rbxasset://sounds/snap.mp3", 0.6)
	makeSound("hit", "rbxasset://sounds/collide.wav", 0.9, 0.8)
	makeSound("boom", "rbxasset://sounds/Rocket shot.wav", 0.7, 0.7)
	makeSound("whoosh", "rbxasset://sounds/swoosh.wav", 0.6, 0.8)
	buildHud()
	buildThrow()
	buildTeleport()
	buildGarage()
	buildIndex()
	buildReveal()
	gui.Parent = player:WaitForChild("PlayerGui")
	UI.SetZoneName("plaza")

	local lastMoney = 0
	store.Changed.Event:Connect(UI.Refresh)
	store.MoneyChanged.Event:Connect(function()
		if store.Money &gt; lastMoney then
			hud.moneyScale.Scale = 1.08
			tween(hud.moneyScale, 0.2, { Scale = 1 })
		end
		lastMoney = store.Money
		refreshHud()
	end)
	UI.Refresh()
end

return UI
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX51"><Properties><string name="Name">WorldFx</string><ProtectedString name="Source">local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MapConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MapConfig"))

local MOODS = {
	plaza = { clock = 14.3, bright = 2.3, tint = Color3.fromRGB(255, 250, 244), sat = 0.16, amb = Color3.fromRGB(132, 128, 118) },
	city = { clock = 14.3, bright = 2.3, tint = Color3.fromRGB(255, 250, 240), sat = 0.16, amb = Color3.fromRGB(132, 128, 118) },
	highway = { clock = 15.9, bright = 2.2, tint = Color3.fromRGB(255, 244, 226), sat = 0.14, amb = Color3.fromRGB(134, 124, 116) },
	industrial = { clock = 17.3, bright = 2.0, tint = Color3.fromRGB(255, 234, 212), sat = 0.06, amb = Color3.fromRGB(130, 110, 104) },
	neon = { clock = 20.4, bright = 1.4, tint = Color3.fromRGB(214, 236, 255), sat = 0.35, amb = Color3.fromRGB(60, 110, 150) },
}
local mood = { clock = 14.3, bright = 2.3, tint = Color3.fromRGB(255, 250, 244), sat = 0.16, amb = Color3.fromRGB(132, 128, 118) }
local tintFx
local lastBackfire = 0

local Fx = {}
local spinning = {}
local gates = {}
local store

local function applyGate(part)
	local zone = part:GetAttribute("ZoneId")
	local unlocked = store.State and store.State.zones and store.State.zones[zone] == true
	part.CanCollide = not unlocked
	part.Transparency = unlocked and 1 or 0.5
	for _, g in ipairs(part:GetChildren()) do
		if g:IsA("SurfaceGui") then
			g.Enabled = not unlocked
		end
	end
end

local function addSpin(model)
	local root = model:IsA("Model") and model.PrimaryPart or model:FindFirstChild("Root")
	if not root then
		task.wait(0.2)
		root = model.PrimaryPart or model:FindFirstChild("Root")
	end
	if root then
		spinning[model] = { root = root, base = root.CFrame, phase = math.random() * 6 }
	end
end

function Fx.Start(storeModule)
	store = storeModule
	for _, m in ipairs(CollectionService:GetTagged("SpinBob")) do
		task.spawn(addSpin, m)
	end
	CollectionService:GetInstanceAddedSignal("SpinBob"):Connect(function(m)
		task.spawn(addSpin, m)
	end)
	CollectionService:GetInstanceRemovedSignal("SpinBob"):Connect(function(m)
		spinning[m] = nil
	end)
	local function regGate(p)
		gates[p] = true
		applyGate(p)
	end
	for _, p in ipairs(CollectionService:GetTagged("ZoneGate")) do
		regGate(p)
	end
	CollectionService:GetInstanceAddedSignal("ZoneGate"):Connect(regGate)
	store.Changed.Event:Connect(function()
		for p in pairs(gates) do
			if p.Parent then
				applyGate(p)
			end
		end
	end)
	tintFx = Lighting:FindFirstChild("ZoneTint") or Instance.new("ColorCorrectionEffect")
	tintFx.Name = "ZoneTint"
	tintFx.Parent = Lighting
	RunService.RenderStepped:Connect(function(dt)
		local cam = Workspace.CurrentCamera
		if cam then
			local target = MOODS[MapConfig.ZoneAt(cam.CFrame.Position.Z)] or MOODS.city
			local a = math.min(1, dt * 1.2)
			mood.clock = mood.clock + (target.clock - mood.clock) * a
			mood.bright = mood.bright + (target.bright - mood.bright) * a
			mood.sat = mood.sat + (target.sat - mood.sat) * a
			mood.tint = mood.tint:Lerp(target.tint, a)
			mood.amb = mood.amb:Lerp(target.amb, a)
			Lighting.ClockTime = mood.clock
			Lighting.Brightness = mood.bright
			Lighting.OutdoorAmbient = mood.amb
			tintFx.TintColor = mood.tint
			tintFx.Saturation = mood.sat
		end
		local t = os.clock()
		for _, m in ipairs(CollectionService:GetTagged("Turntable")) do
			if m:IsA("Model") then
				local p = m:GetPivot()
				m:PivotTo(CFrame.new(p.Position) * CFrame.Angles(0, (select(2, p:ToEulerAnglesYXZ())) + dt * 0.4, 0))
			end
		end
		if t - lastBackfire &gt; 2.2 then
			lastBackfire = t
			local camPos = cam and cam.CFrame.Position or Vector3.zero
			for _, att in ipairs(CollectionService:GetTagged("Backfire")) do
				if att.Parent and (att.WorldPosition - camPos).Magnitude &lt; 140 and math.random() &lt; 0.45 then
					local fire = att:FindFirstChildOfClass("ParticleEmitter")
					if fire then
						fire:Emit(14)
					end
				end
			end
		end
		for m, s in pairs(spinning) do
			if s.root.Parent then
				s.root.CFrame = s.base * CFrame.Angles(0, t * 2 + s.phase, 0) + Vector3.new(0, math.sin(t * 2 + s.phase) * 0.5, 0)
			else
				spinning[m] = nil
			end
		end
	end)
end

function Fx.Hit(dir, flashFrame)
	local char = Players.LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.AssemblyLinearVelocity = dir.Unit * 70 + Vector3.new(0, 40, 0)
	end
	if flashFrame then
		flashFrame.BackgroundTransparency = 0.55
		task.spawn(function()
			for i = 1, 10 do
				flashFrame.BackgroundTransparency = 0.55 + i * 0.045
				task.wait(0.03)
			end
			flashFrame.BackgroundTransparency = 1
		end)
	end
end

return Fx
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXE2D3F81A9E184B39991FB56DED069C23"><Properties><string name="Name">CineFx</string><ProtectedString name="Source">-- Cinematic toolkit: camera shake / zoom / takeover, letterbox, darken, flash, glitch, big titles.
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local Cine = {}
local layer, vignette, flash, topBar, botBar, glitchHolder, titleHolder
local cc, blur
local shakes = {}
local scripted = false

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = parent
	return o
end
local function tw(o, t, props, style, dir)
	local x = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	x:Play()
	return x
end

function Cine.Init(gui)
	layer = new("Frame", { Name = "Cine", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 45 }, gui)
	vignette = new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 45, BorderSizePixel = 0 }, layer)
	topBar = new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), Size = UDim2.new(1, 0, 0, 0), ZIndex = 47, BorderSizePixel = 0 }, layer)
	botBar = new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 0), ZIndex = 47, BorderSizePixel = 0 }, layer)
	glitchHolder = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 48, ClipsDescendants = true }, layer)
	titleHolder = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 49 }, layer)
	flash = new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 50, BorderSizePixel = 0 }, layer)
	cc = new("ColorCorrectionEffect", { Name = "CineCC" }, Lighting)
	blur = new("BlurEffect", { Name = "CineBlur", Size = 0 }, Lighting)

	RunService:BindToRenderStep("CineShake", Enum.RenderPriority.Camera.Value + 1, function()
		local cam = Workspace.CurrentCamera
		if not cam then
			return
		end
		local now = os.clock()
		local amp = 0
		for i = #shakes, 1, -1 do
			local s = shakes[i]
			local a = (now - s.t0) / s.dur
			if a &gt;= 1 then
				table.remove(shakes, i)
			else
				amp = amp + s.mag * (1 - a) ^ 2
			end
		end
		-- undo last frame's offset if nothing else moved the camera (scriptable cam without tween)
		if Cine._last and cam.CFrame == Cine._last.result then
			cam.CFrame = Cine._last.base
		end
		Cine._last = nil
		if amp &gt; 0.001 then
			local function r()
				return (math.random() * 2 - 1) * amp
			end
			local base = cam.CFrame
			cam.CFrame = base * CFrame.new(r() * 0.25, r() * 0.25, 0) * CFrame.Angles(math.rad(r()), math.rad(r()), math.rad(r() * 1.4))
			Cine._last = { base = base, result = cam.CFrame }
		end
	end)
end

function Cine.Shake(mag, dur)
	table.insert(shakes, { mag = mag, dur = dur or 0.4, t0 = os.clock() })
end

function Cine.Flash(color, from, t)
	flash.BackgroundColor3 = color or Color3.new(1, 1, 1)
	flash.BackgroundTransparency = from or 0
	tw(flash, t or 0.4, { BackgroundTransparency = 1 })
end

function Cine.Darken(alpha, t)
	tw(vignette, t or 0.3, { BackgroundTransparency = 1 - alpha })
end

function Cine.Letterbox(on, t)
	local h = on and 0.11 or 0
	tw(topBar, t or 0.35, { Size = UDim2.new(1, 0, h, 0) })
	tw(botBar, t or 0.35, { Size = UDim2.new(1, 0, h, 0) })
end

function Cine.Grade(props, t)
	tw(cc, t or 0.3, props)
end

function Cine.Blur(size, t)
	tw(blur, t or 0.3, { Size = size })
end

function Cine.Zoom(fov, t, style)
	local cam = Workspace.CurrentCamera
	if cam then
		tw(cam, t or 0.4, { FieldOfView = fov }, style)
	end
end

-- RGB-split glitch: horizontal slices + red/cyan bars + grade flicker
function Cine.Glitch(dur, power)
	power = power or 1
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 &lt; dur do
			for _, c in ipairs(glitchHolder:GetChildren()) do
				c:Destroy()
			end
			local n = math.floor(3 + 6 * power)
			for _ = 1, n do
				local red = math.random() &lt; 0.5
				new("Frame", {
					BackgroundColor3 = red and Color3.fromRGB(255, 40, 60) or Color3.fromRGB(40, 240, 255),
					BackgroundTransparency = 0.35 + math.random() * 0.4, BorderSizePixel = 0, ZIndex = 48,
					Position = UDim2.new(math.random() * 0.3 - 0.15, 0, math.random(), 0),
					Size = UDim2.new(0.5 + math.random() * 0.8, 0, 0, math.random(3, 6 + math.floor(26 * power))),
				}, glitchHolder)
			end
			cc.TintColor = (math.random() &lt; 0.5) and Color3.fromRGB(255, 200, 210) or Color3.fromRGB(200, 255, 255)
			Cine.Shake(0.6 * power, 0.08)
			task.wait(0.04 + math.random() * 0.05)
		end
		for _, c in ipairs(glitchHolder:GetChildren()) do
			c:Destroy()
		end
		cc.TintColor = Color3.new(1, 1, 1)
	end)
end

-- Big punchy title with RGB ghost copies
function Cine.Title(text, color, dur, sizePx, yScale)
	local holder = new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, yScale or 0.4), Size = UDim2.fromOffset(1000, sizePx or 140), ZIndex = 49 }, titleHolder)
	local function lbl(col, off, tr, z)
		local l = new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.LuckiestGuy, Text = text, TextScaled = true, TextColor3 = col,
			TextTransparency = tr, Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(off, 0), ZIndex = z, Rotation = -3 }, holder)
		return l
	end
	local r = lbl(Color3.fromRGB(255, 40, 60), -8, 0.3, 49)
	local c = lbl(Color3.fromRGB(40, 240, 255), 8, 0.3, 49)
	local main = lbl(color, 0, 0, 50)
	new("UIStroke", { Color = Color3.fromRGB(27, 31, 42), Thickness = 6 }, main)
	local sc = new("UIScale", { Scale = 2.4 }, holder)
	tw(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 &lt; (dur or 1.5) and holder.Parent do
			local j = math.random() &lt; 0.25 and 14 or 4
			r.Position = UDim2.fromOffset(-j, math.random(-2, 2))
			c.Position = UDim2.fromOffset(j, math.random(-2, 2))
			task.wait(0.05)
		end
		tw(sc, 0.2, { Scale = 0.6 })
		for _, l in ipairs({ r, c, main }) do
			tw(l, 0.2, { TextTransparency = 1 })
		end
		task.wait(0.22)
		holder:Destroy()
	end)
	return holder
end

function Cine.Sub(text, color, dur, yScale)
	local l = new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.LuckiestGuy, Text = text, TextSize = 34, TextColor3 = color,
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, yScale or 0.56), Size = UDim2.fromOffset(900, 44), ZIndex = 50, TextTransparency = 1 }, titleHolder)
	new("UIStroke", { Color = Color3.fromRGB(27, 31, 42), Thickness = 3 }, l)
	tw(l, 0.25, { TextTransparency = 0 })
	task.delay(dur or 1.5, function()
		tw(l, 0.25, { TextTransparency = 1 })
		task.wait(0.3)
		l:Destroy()
	end)
	return l
end

-- Camera takeover helpers
function Cine.Take()
	local cam = Workspace.CurrentCamera
	scripted = true
	cam.CameraType = Enum.CameraType.Scriptable
	return cam
end

function Cine.Move(cf, t, style)
	local cam = Workspace.CurrentCamera
	return tw(cam, t, { CFrame = cf }, style or Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
end

function Cine.Release(t)
	local cam = Workspace.CurrentCamera
	scripted = false
	cam.CameraType = Enum.CameraType.Custom
	Cine.Zoom(70, t or 0.4)
end

function Cine.IsScripted()
	return scripted
end

function Cine.Reset(t)
	t = t or 0.4
	Cine.Darken(0, t)
	Cine.Letterbox(false, t)
	Cine.Grade({ Saturation = 0, Contrast = 0, Brightness = 0, TintColor = Color3.new(1, 1, 1) }, t)
	Cine.Blur(0, t)
end

return Cine
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6D75A9B9C64249CAAD10BDA1DA0DF143"><Properties><string name="Name">DeathFx</string><ProtectedString name="Source">-- WRECKED! sequence: impact flash, heavy shake, glitch, grayscale-red grade, crane-up camera, countdown.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Strings = require(Shared:WaitForChild("Strings"))
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local Cine = require(script.Parent:WaitForChild("CineFx"))

local DeathFx = {}
local ICON = { bolts = "🔩", tire = "🛞", engine = "⚙️", turbo = "🌀", core = "⚡" }
local running = false

function DeathFx.Play(dir, lost, sfx)
	if running then
		return
	end
	running = true
	local player = Players.LocalPlayer
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then -- cartoon launch
		hrp.AssemblyLinearVelocity = dir.Unit * 90 + Vector3.new(0, 70, 0)
		hrp.AssemblyAngularVelocity = Vector3.new(math.random(-20, 20), math.random(-20, 20), math.random(-20, 20))
	end
	if sfx then
		sfx("hit")
		sfx("boom")
	end
	Cine.Flash(Color3.fromRGB(255, 59, 59), 0, 0.6)
	Cine.Shake(4, 0.7)
	Cine.Glitch(0.7, 1.2)
	Cine.Grade({ Saturation = -0.85, Contrast = 0.35, TintColor = Color3.fromRGB(255, 170, 170) }, 0.15)
	Cine.Letterbox(true, 0.2)
	Cine.Title(Strings.T("wrecked"), Color3.fromRGB(255, 59, 59), 2.4, 170, 0.36)

	local parts = {}
	for _, id in ipairs(PartConfig.Order) do
		if lost and (lost[id] or 0) &gt; 0 then
			table.insert(parts, (ICON[id] or "") .. " x" .. lost[id])
		end
	end
	task.delay(0.4, function()
		if #parts &gt; 0 then
			Cine.Sub(Strings.T("wrecked_lost", table.concat(parts, "   ")), Color3.fromRGB(255, 210, 63), 2.2, 0.55)
		end
		Cine.Sub(Strings.T("wrecked_safe"), Color3.fromRGB(255, 255, 255), 2.2, 0.62)
	end)

	-- crane shot rising above the crash site
	task.delay(0.25, function()
		local cam = Cine.Take()
		local focus = hrp and hrp.Position or cam.CFrame.Position
		local from = cam.CFrame
		local t0 = os.clock()
		Cine.Blur(6, 1.5)
		local conn
		conn = RunService.RenderStepped:Connect(function()
			local a = math.min(1, (os.clock() - t0) / 2.6)
			local e = 1 - (1 - a) ^ 3
			local target = CFrame.lookAt(focus + Vector3.new(math.cos(e * 1.2) * 18, 8 + e * 38, math.sin(e * 1.2) * 18), focus)
			cam.CFrame = from:Lerp(target, math.min(1, a * 3)) * CFrame.Angles(0, 0, math.rad(8 * (1 - e)))
			if a &gt;= 1 then
				conn:Disconnect()
			end
		end)
		for n = 3, 1, -1 do
			task.wait(0.8)
			Cine.Sub(Strings.T("wrecked_back", n), Color3.fromRGB(255, 255, 255), 0.6, 0.7)
		end
	end)
end

-- called on respawn
function DeathFx.Recover()
	if not running then
		return
	end
	running = false
	Cine.Release(0.2)
	Cine.Reset(0.5)
	Cine.Flash(Color3.new(0, 0, 0), 0, 0.6)
end

return DeathFx
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9B22396901084ECA809FF62BA3A5C75F"><Properties><string name="Name">SpeedLanes</string><ProtectedString name="Source">-- Speed lanes: boost WalkSpeed on orange strips, animate chevrons, little FOV kick.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MapConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MapConfig"))

local SpeedLanes = {}
local ORANGE, YELLOW, WHITE = Color3.fromRGB(255, 138, 31), Color3.fromRGB(255, 210, 63), Color3.fromRGB(255, 255, 255)

function SpeedLanes.Start()
	local player = Players.LocalPlayer
	local onLane = false
	local fov = 70
	local lastAnim = 0
	RunService.Heartbeat:Connect(function(dt)
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local cam = Workspace.CurrentCamera
		if hum and hrp and hum.Health &gt; 0 then
			local p = hrp.Position
			local now = p.Y &lt; 8 and MapConfig.OnSpeedLane(p)
			if now ~= onLane then
				onLane = now
				hum.WalkSpeed = now and MapConfig.LaneSpeed or MapConfig.WalkSpeed
			end
		end
		if cam and cam.CameraType == Enum.CameraType.Custom then
			fov = fov + ((onLane and 82 or 70) - fov) * math.min(1, dt * 4)
			cam.FieldOfView = fov
		end
		if os.clock() - lastAnim &lt; 0.08 then
			return
		end
		lastAnim = os.clock()
		local t = lastAnim * 1.6
		for _, ch in ipairs(CollectionService:GetTagged("SpeedChevron")) do
			local ph = (t - (ch:GetAttribute("Phase") or 0) * 4) % 1
			ch.Color = ph &lt; 0.18 and WHITE or (ph &lt; 0.45 and YELLOW or ORANGE)
		end
	end)
end

return SpeedLanes
</ProtectedString></Properties></Item></Item></Item></Item></roblox>