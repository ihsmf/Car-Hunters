</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXA1EAE12CCED447E081E3FBD57CC474DD"><Properties><string name="Name">RewardConfig</string><ProtectedString name="Source">-- Daily login streak (7 days, missing a day resets) and playtime chests per session.
local R = {}

-- money = max(min, income * seconds); parts added on top (v25: minimums x10)
R.Daily = {
	{ secs = 120, min = 5000, parts = { tire = 3 } },
	{ secs = 180, min = 10000, parts = { engine = 2 } },
	{ secs = 240, min = 15000, parts = { tire = 6 } },
	{ secs = 360, min = 25000, parts = { engine = 3, turbo = 1 } },
	{ secs = 480, min = 40000, parts = { turbo = 2 } },
	{ secs = 600, min = 60000, parts = { engine = 5 } },
	{ secs = 900, min = 100000, parts = { core = 1, turbo = 2 }, pity = true },
}

R.Chests = {
	{ minutes = 5, secs = 60, min = 3000, parts = { bolts = 5 } },
	{ minutes = 15, secs = 120, min = 8000, parts = { tire = 4 } },
	{ minutes = 30, secs = 240, min = 15000, parts = { engine = 3 } },
	{ minutes = 60, secs = 480, min = 30000, parts = { turbo = 2 } },
	{ minutes = 120, secs = 900, min = 60000, parts = { core = 1 }, gear = true },
}

function R.Money(entry, income)
	return math.max(entry.min, math.floor((income or 0) * entry.secs))
end

function R.UtcDay(t)
	return math.floor((t or os.time()) / 86400)
end

-- next streak day the player would get today (1..7)
function R.NextDay(daily, today)
	if daily.last == today - 1 then
		return (daily.day or 0) % 7 + 1
	end
	return 1
end

return R
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX574A9755A624405F8F35409A9957D695"><Properties><string name="Name">ShopConfig</string><ProtectedString name="Source">-- Pit Stop upgrades (in-game money; v25: all prices x10). Effects are read on the server through ShopService.
local ShopConfig = {}

local function curve(base, growth, max)
	local t = {}
	for lvl = 1, max do
		t[lvl] = math.floor(base * growth ^ (lvl - 1) / 50 + 0.5) * 50
	end
	return t
end

ShopConfig.Perks = {
	{ id = "sneakers", icon = "👟", name = "Sneakers", desc = "+6% run speed", max = 5, costs = curve(8000, 2.4, 5), per = 0.06 },
	{ id = "backpack", icon = "🎒", name = "Backpack", desc = "+5 loot capacity", max = 5, costs = curve(15000, 2.5, 5), per = 5 },
	{ id = "magnet", icon = "🧲", name = "Magnet", desc = "+2.5 studs pickup radius", max = 4, costs = curve(20000, 2.6, 4), per = 2.5 },
	{ id = "airbag", icon = "🛡️", name = "Airbag", desc = "Survive one car hit (recharges)", max = 3, costs = { 250000, 1000000, 4000000 }, cooldowns = { 180, 120, 60 } },
	{ id = "scanner", icon = "📡", name = "Scanner", desc = "Lv1: rare parts on the map. Lv2: Hot Drop alert 15s early", max = 2, costs = { 150000, 1200000 } },
	{ id = "multi", icon = "🎰", name = "Multi Catch", desc = "+1 car per throw (up to 4)", max = 3, costs = { 60000, 600000, 6000000 } },
	{ id = "lucky", icon = "🍀", name = "Lucky Trap", desc = "+1.5% better car rarity", max = 5, costs = curve(50000, 3, 5), per = 0.015 },
	{ id = "turbo", icon = "💰", name = "Turbo Garage", desc = "+8% garage income", max = 5, costs = curve(100000, 3, 5), per = 0.08 },
	{ id = "quick", icon = "⏱️", name = "Quick Start", desc = "Faster respawn, longer spawn shield", max = 3, costs = curve(40000, 3, 3), respawn = { 2.4, 1.9, 1.4 } },
}

ShopConfig.ById = {}
for i, p in ipairs(ShopConfig.Perks) do
	p.order = i
	ShopConfig.ById[p.id] = p
end

function ShopConfig.NextCost(id, level)
	local p = ShopConfig.ById[id]
	return p and p.costs[(level or 0) + 1] or nil
end

return ShopConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX35F58E3065D5497B9228F78F0ED2379A"><Properties><string name="Name">SkinConfig</string><ProtectedString name="Source">-- Garage skins: one active at a time, each recolours the whole garage and adds an income bonus.
local C = Color3.fromRGB
local SkinConfig = {}

local function style(o)
	local base = {
		floor = C(212, 214, 218), inlay = C(60, 63, 70), line = C(242, 242, 240), wall = C(38, 40, 46),
		deck = C(238, 238, 236), frame = C(28, 30, 34), accent = C(255, 196, 40), accent2 = C(214, 52, 44),
		door = C(200, 204, 210), bay = C(80, 84, 92),
	}
	for k, v in pairs(o) do
		base[k] = v
	end
	return base
end

-- price: money | tokens (rebirth) | pass (Golden Magnate game pass)
SkinConfig.Skins = {
	{ id = "classic", name = "Classic", icon = "🏁", bonus = 0, style = style({}) },
	{ id = "street", name = "Street Garage", icon = "🧱", bonus = 0.03, money = 2500000,
		style = style({ floor = C(150, 150, 154), wall = C(150, 70, 52), deck = C(196, 196, 200), accent = C(255, 140, 40), inlay = C(48, 48, 52) }) },
	{ id = "racing", name = "Racing Team", icon = "🏎️", bonus = 0.06, money = 150000000,
		style = style({ floor = C(236, 236, 240), wall = C(214, 52, 44), deck = C(250, 250, 250), accent = C(255, 255, 255), accent2 = C(30, 30, 34), inlay = C(30, 30, 34), frame = C(20, 20, 24) }) },
	{ id = "chrome", name = "Chrome Lux", icon = "💎", bonus = 0.10, money = 9000000000,
		style = style({ floor = C(70, 74, 82), wall = C(196, 200, 208), deck = C(220, 224, 230), frame = C(150, 156, 166), accent = C(110, 200, 255), inlay = C(40, 44, 52), bay = C(56, 60, 68) }) },
	{ id = "midnight", name = "Midnight Club", icon = "🌙", bonus = 0.15, tokens = 15,
		style = style({ floor = C(30, 32, 44), wall = C(18, 20, 30), deck = C(40, 44, 60), frame = C(12, 12, 18), accent = C(150, 110, 255), accent2 = C(80, 200, 255), line = C(170, 150, 255), inlay = C(60, 50, 110), bay = C(44, 46, 62) }) },
	{ id = "golden", name = "Golden Magnate", icon = "👑", bonus = 0.20, pass = "golden_garage",
		style = style({ floor = C(250, 240, 214), wall = C(28, 32, 44), deck = C(250, 244, 226), frame = C(232, 178, 50), accent = C(232, 178, 50), accent2 = C(232, 178, 50), inlay = C(180, 130, 40), bay = C(60, 56, 50) }) },
}
SkinConfig.ById = {}
for i, s in ipairs(SkinConfig.Skins) do
	s.order = i
	SkinConfig.ById[s.id] = s
end

-- rebirth token shop (besides the Midnight skin)
SkinConfig.TokenPerks = {
	{ id = "startSlot", name = "+1 starting bay", icon = "🅿️", cost = 3, max = 3 },
	{ id = "luck", name = "+2% trap luck", icon = "🍀", cost = 4, max = 5, per = 0.02 },
	{ id = "magnet", name = "+25% pickup radius", icon = "🧲", cost = 5, max = 2, per = 0.25 },
}
SkinConfig.TokenPerkById = {}
for _, p in ipairs(SkinConfig.TokenPerks) do
	SkinConfig.TokenPerkById[p.id] = p
end

-- Rebirth rules
SkinConfig.Rebirth = {
	needZone = { [0] = "scrapyard", [1] = "airport", [2] = "canyon" }, -- beat the arena of your tier; later: "rush"
	lateZone = "rush",
	costs = { 1e8, 7e9, 3.5e10 }, lateGrowth = 2, -- v25: x10 (all money); v24 (Epic/Legendary earn more); v22 x1.3 / x1.8 after the income boost -- rebirth n+1 costs costs[n+1], later x2 each
	incomePer = 1.0, startMoney = 500000, -- income x(1 + rebirths); start cash x rebirths
}
function SkinConfig.RebirthNeeds(n)
	local R = SkinConfig.Rebirth
	local k = #R.costs
	local money = (n &lt; k) and R.costs[n + 1] or R.costs[k] * R.lateGrowth ^ (n - k + 1)
	return R.needZone[n] or R.lateZone, math.floor(money)
end

return SkinConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9C333BDD86934ED4B25D3413C48BF7EB"><Properties><string name="Name">SoundIds</string><ProtectedString name="Source">-- Sound asset ids (ElevenLabs SFX uploaded by tools/roblox_open_cloud.py). 0 = not uploaded: built-in fallback is used.
