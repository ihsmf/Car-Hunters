<roblox xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Meta name="ExplicitAutoJoints">true</Meta><Item class="Workspace" referent="RBX12"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">false</bool></Properties></Item><Item class="Lighting" referent="RBX55"><Properties><string name="Name">Lighting</string></Properties></Item><Item class="ReplicatedStorage" referent="RBX27"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX1034"><Properties><string name="Name">CarModels</string></Properties><Item class="Folder" referent="RBX1033"><Properties><string name="Name">Traffic</string></Properties><Item class="Model" referent="RBX1022"><Properties><string name="Name">compact</string></Properties></Item><Item class="Model" referent="RBX1023"><Properties><string name="Name">sedan</string></Properties></Item><Item class="Model" referent="RBX1024"><Properties><string name="Name">taxi</string></Properties></Item><Item class="Model" referent="RBX1025"><Properties><string name="Name">van</string></Properties></Item><Item class="Model" referent="RBX1026"><Properties><string name="Name">minibus</string></Properties></Item><Item class="Model" referent="RBX1027"><Properties><string name="Name">sport</string></Properties></Item><Item class="Model" referent="RBX1028"><Properties><string name="Name">supercar</string></Properties></Item><Item class="Model" referent="RBX1029"><Properties><string name="Name">pickup</string></Properties></Item><Item class="Model" referent="RBX1030"><Properties><string name="Name">service</string></Properties></Item><Item class="Model" referent="RBX1031"><Properties><string name="Name">truck</string></Properties></Item><Item class="Model" referent="RBX1032"><Properties><string name="Name">proto</string></Properties></Item></Item></Item><Item class="Folder" referent="RBX25"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">BaseLayout</string><ProtectedString name="Source">local MapConfig = require(script.Parent.MapConfig)

local BaseLayout = {}

BaseLayout.FloorY = 0.5
BaseLayout.SlotCount = 24 -- 4 floors x 6 bays
BaseLayout.SlotsPerFloor = 6
BaseLayout.MaxFloors = 4
BaseLayout.FloorHeight = 14
BaseLayout.DeckEdgeX = -10 -- front edge of the upper decks (local X)
BaseLayout.ElevatorLocal = Vector3.new(-3, 0, 38)
BaseLayout.TrapLocal = Vector3.new(30, 0, -26)
BaseLayout.PortalLocal = Vector3.new(52, 0, 20)
BaseLayout.TerminalLocal = Vector3.new(30, 0, 40)
BaseLayout.SpawnLocal = Vector3.new(44, 0, 0)
BaseLayout.BackWallX = -52
BaseLayout.LaneX = 14

function BaseLayout.FloorOf(slot)
	return math.floor((slot - 1) / BaseLayout.SlotsPerFloor) + 1
end

-- one row of 6 bays per floor, cars face +X (towards the plaza)
function BaseLayout.SlotLocal(slot)
	local floor = BaseLayout.FloorOf(slot)
	local col = (slot - 1) % BaseLayout.SlotsPerFloor
	return Vector3.new(-31, (floor - 1) * BaseLayout.FloorHeight, -37.5 + col * 15)
end

function BaseLayout.FloorTopY(floor)
	return BaseLayout.FloorY + (floor - 1) * BaseLayout.FloorHeight
end

function BaseLayout.GetBaseCFrame(index)
	local c = MapConfig.BaseCenters[index]
	local yaw = (c.x &lt; 0) and 0 or math.pi
	return CFrame.new(c.x, 0, c.z) * CFrame.Angles(0, yaw, 0)
end

function BaseLayout.ToWorld(index, localPos)
	return BaseLayout.GetBaseCFrame(index):PointToWorldSpace(localPos)
end

function BaseLayout.SlotCFrame(index, slot)
	local p = BaseLayout.SlotLocal(slot)
	return BaseLayout.GetBaseCFrame(index) * CFrame.new(p.X, BaseLayout.FloorY + p.Y, p.Z)
end

return BaseLayout
