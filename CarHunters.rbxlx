	{ id = "kia_stingar", name = "Boxy Stinga", rarity = "Uncommon", style = "sedan", income = 14, body = C(200, 30, 30), accent = C(20, 20, 24), tag = "Bites harder than it looks." },
	{ id = "dodje_chardjer", name = "Brawler Charja", rarity = "Rare", style = "muscle", income = 27, body = C(20, 20, 24), accent = C(200, 200, 210), tag = "Four doors, zero manners." },
	{ id = "mazta_rx7", name = "Breezer Rotary-7", rarity = "Rare", style = "sport", income = 35, body = C(220, 20, 30), accent = C(20, 20, 24), spoiler = true, tag = "Brap brap goes the triangle." },
	{ id = "nisan_skylain", name = "Raijin Skyrunner", rarity = "Rare", style = "sport", income = 42, body = C(40, 90, 200), accent = C(20, 20, 24), spoiler = true, tag = "Street legend, midnight runs." },
	{ id = "hunda_nsx", name = "Kazemo N-Ess-X", rarity = "Rare", style = "sport", income = 49, body = C(236, 236, 240), accent = C(20, 20, 24), tag = "Tuned by a racing legend." },
	{ id = "mursides_sls", name = "Stellar Gullwing", rarity = "Epic", style = "sport", income = 110, body = C(200, 204, 210), accent = C(20, 20, 24), chrome = true, tag = "Doors that wave hello." },
	{ id = "lexxus_lfa", name = "Luxor El-Fa", rarity = "Epic", style = "supercar", income = 145, body = C(240, 240, 244), accent = C(20, 20, 24), tag = "Sounds like a choir of angels." },
	{ id = "dodje_vipur", name = "Brawler Venom", rarity = "Epic", style = "sport", income = 170, body = C(30, 60, 160), accent = C(240, 240, 240), tag = "Ten cylinders of bad mood." },
	{ id = "ferarri_f40", name = "Cavallo F-Forty", rarity = "Epic", style = "supercar", income = 195, body = C(220, 16, 20), accent = C(20, 20, 24), spoiler = true, tag = "Turbo lag, then chaos." },
	{ id = "porshe_918", name = "Swabia Nine-Eighteen", rarity = "Legendary", style = "proto", income = 600, body = C(220, 224, 230), accent = C(20, 20, 24), neon = C(120, 255, 120), tag = "Hybrid with a racing soul." },
	{ id = "ferarri_enzo", name = "Cavallo Enzio", rarity = "Legendary", style = "proto", income = 900, body = C(200, 10, 20), accent = C(20, 20, 24), neon = C(255, 60, 40), tag = "Named after the boss himself." },
	{ id = "lamborgini_revuelto", name = "Taurio Revolto", rarity = "Legendary", style = "supercar", income = 1100, body = C(255, 120, 0), accent = C(20, 20, 24), neon = C(255, 170, 40), tag = "A bull with a battery." },
	{ id = "konigseg_regera", name = "Nordik Regal", rarity = "Legendary", style = "proto", income = 1300, body = C(30, 30, 34), accent = C(220, 180, 60), neon = C(255, 210, 90), tag = "One gear. All the speed." },
}
do -- show order: rarity, then income
	local idx = { Common = 1, Uncommon = 2, Rare = 3, Epic = 4, Legendary = 5 }
	table.sort(list, function(a, b)
		if idx[a.rarity] ~= idx[b.rarity] then
			return idx[a.rarity] &lt; idx[b.rarity]
		end
		return a.income &lt; b.income
	end)
end

-- old save ids -&gt; new ids (same rarity and income slot)
CarConfig.LegacyIds = {
	rusty_compact = "furd_fiasta", pocket_hatch = "dodje_caravon", dusty_sedan = "furd_f150", mule_pickup = "awdi_a4",
	street_runner = "bmv_m3", city_taxi = "mursides_e", cargo_hopper = "tezla_model3", boulevard_gt = "jagwar_xe",
	night_phantom = "furd_mustank", iron_hauler = "dodje_chalenjer", redline_coupe = "ranje_rover", volt_cruiser = "bmv_m4",
	turbo_vortex = "mursides_g", chrome_viper = "awdi_r8", apex_predator = "jagwar_ftype", solar_flare = "mazeratti_gt",
	neon_specter = "lamborgini_hurakan", hyper_nova = "tezla_cybertrak", quantum_drift = "mazeratti_mc20", eclipse_titan = "lamborgini_aventadoor",
}

-- exclusive cars: never drop from the trap, granted by a game pass
CarConfig.Exclusive = {
	{ id = "golden_magnat_gt", name = "Golden Magnat GT", rarity = "Legendary", style = "supercar", income = 15000, body = C(232, 178, 50), accent = C(20, 20, 24), chrome = true, neon = C(255, 210, 90), exclusive = true, tag = "Only for true magnates." },
}

CarConfig.List = list
CarConfig.ById = {}
CarConfig.ByRarity = { Common = {}, Uncommon = {}, Rare = {}, Epic = {}, Legendary = {} }
for i, def in ipairs(list) do
	def.order = i
	def.baseIncome = def.income
	def.income = math.floor(def.income * CarConfig.RarityIncomeMult[def.rarity] + 0.5)
	def.value = def.income * CarConfig.ValueMultiplier
	def.maxLevel = CarConfig.MaxLevel
	CarConfig.ById[def.id] = def
	table.insert(CarConfig.ByRarity[def.rarity], def)
end

for _, def in ipairs(CarConfig.Exclusive) do
	def.value = def.income * CarConfig.ValueMultiplier
	def.maxLevel = CarConfig.MaxLevel
	def.order = 1000
	CarConfig.ById[def.id] = def
end

-- v13 catch by RARITY POINTS: a throw adds up the points of every part thrown (PartConfig.Parts[id].points);
-- the car rarity odds come from this curve (log-interpolated between the rows). Top cars stay rare on purpose.
CarConfig.PointRows = {
	{ 1, { Common = 72, Uncommon = 22, Rare = 5.5, Epic = 0.48, Legendary = 0.02 } },
	{ 4, { Common = 58, Uncommon = 30, Rare = 10, Epic = 1.9, Legendary = 0.1 } },
	{ 10, { Common = 42, Uncommon = 34, Rare = 19.75, Epic = 4, Legendary = 0.25 } },
	{ 22, { Common = 28, Uncommon = 36, Rare = 27.4, Epic = 8, Legendary = 0.6 } },
	{ 50, { Common = 15, Uncommon = 32, Rare = 37.5, Epic = 14, Legendary = 1.5 } },
	{ 200, { Common = 4, Uncommon = 18, Rare = 42, Epic = 30, Legendary = 6 } },
	{ 500, { Common = 2, Uncommon = 12, Rare = 38, Epic = 38, Legendary = 10 } }, -- deep districts keep paying off
	{ 1000, { Common = 1, Uncommon = 6, Rare = 33, Epic = 45, Legendary = 15 } },
}
function CarConfig.ChancesForPoints(points)
	local rows = CarConfig.PointRows
	points = math.max(points or 1, rows[1][1])
	if points &gt;= rows[#rows][1] then
		return table.clone(rows[#rows][2])
	end
	for i = 1, #rows - 1 do
		local a, b = rows[i], rows[i + 1]
		if points &lt;= b[1] then
			local t = (math.log(points) - math.log(a[1])) / (math.log(b[1]) - math.log(a[1]))
			local out = {}
			for _, r in ipairs(CarConfig.RarityOrder) do
				out[r] = a[2][r] + (b[2][r] - a[2][r]) * t
			end
			return out
		end
	end
	return table.clone(rows[#rows][2])
end
-- odds of a single part (throw menu, simulator)
CarConfig.DropChances = {}
for id, part in pairs(PartConfig.Parts) do
	CarConfig.DropChances[id] = CarConfig.ChancesForPoints(part.points)
end

function CarConfig.IncomeAt(def, level)
	return math.floor(def.income * CarConfig.IncomeMult * (1 + CarConfig.IncomeGrowth * (level - 1)) + 0.5)
end

-- income of one owned car incl. its active income gear (GearConfig)
-- `now` (optional): the time gears are checked at; the client passes server time, the server leaves it out (os.time)
function CarConfig.CarIncome(car, now)
	local def = CarConfig.ById[car.typeId]
	if not def then
		return 0
	end
	return math.floor(CarConfig.IncomeAt(def, car.level) * require(script.Parent.GearConfig).CarMult(car, now) + 0.5)
end

function CarConfig.ValueAt(def, level)
	return math.floor(def.value * (1 + 0.3 * (level - 1)))
end

function CarConfig.SellPrice(def, level)
	return math.floor(CarConfig.ValueAt(def, level) * EconomyConfig.SellFraction)
end

function CarConfig.DiscoverBonus(def)
	return math.floor(def.value * EconomyConfig.DiscoverBonusMult)
end

function CarConfig.UpgradeCost(def, level)
	return math.ceil(def.value * CarConfig.UpgradeCostBase * (CarConfig.UpgradeCostGrowth ^ (level - 1)))
end

function CarConfig.UpgradeParts(def, level)
	return PartConfig.PartForRarity[def.rarity], 1 + math.floor((level - 1) / 3)
end

function CarConfig.IsHighTier(rarity)
	return rarity == "Epic" or rarity == "Legendary"
end

function CarConfig.PityRow(row)
	-- pity guarantees an Epic; a Legendary keeps its own (small) chance on top
	local l = math.min(row.Legendary * 3, 20)
	return { Common = 0, Uncommon = 0, Rare = 0, Epic = 100 - l, Legendary = l }
end

-- luck as a multiplier: Rare/Epic/Legendary weights x mult, renormalised to 100 (mult &lt;= 1: an unchanged copy)
local LUCKY = { Rare = true, Epic = true, Legendary = true }
function CarConfig.ApplyLuck(chances, mult)
	local out = table.clone(chances)
	mult = tonumber(mult) or 1
	if mult &lt;= 1 or mult ~= mult then
		return out
	end
	local total = 0
	for _, r in ipairs(CarConfig.RarityOrder) do
		local v = (out[r] or 0) * (LUCKY[r] and mult or 1)
		out[r] = v
		total = total + v
	end
	if total &gt; 0 then
		for _, r in ipairs(CarConfig.RarityOrder) do
			out[r] = out[r] * 100 / total
		end
	end
	return out
end

-- one car from a throw worth `points` rarity points (luck = optional multiplier, see ApplyLuck)
function CarConfig.RollPoints(points, pity, r1, r2, luck)
	local row = CarConfig.ChancesForPoints(points)
	if pity and pity &gt;= EconomyConfig.PityThreshold - 1 then
		row = CarConfig.PityRow(row)
	end
	row = CarConfig.ApplyLuck(row, luck)
	local total = 0
	for _, r in ipairs(CarConfig.RarityOrder) do
		total = total + row[r]
	end
	local target = r1 * total
	local acc = 0
	local rarity = "Legendary"
	for _, r in ipairs(CarConfig.RarityOrder) do
		acc = acc + row[r]
		if row[r] &gt; 0 and target &lt; acc then
			rarity = r
			break
		end
	end
	local pool = CarConfig.ByRarity[rarity]
	local def = pool[math.floor(r2 * #pool) + 1] or pool[#pool]
	return rarity, def
end

function CarConfig.IndexStats(discovered)
	local tiers, found = 0, 0
	for _, r in ipairs(CarConfig.RarityOrder) do
		local all = true
		for _, def in ipairs(CarConfig.ByRarity[r]) do
			if discovered[def.id] then
				found = found + 1
			else
				all = false
			end
		end
		if all then
			tiers = tiers + 1
		end
	end
	local mult = 1 + tiers * EconomyConfig.IndexTierBonus
	if found &gt;= #list then
		mult = mult + EconomyConfig.IndexFullBonus
	end
	return found, #list, tiers, mult
end

function CarConfig.Validate()
	local errors = {}
	local count = 0
	for _, r in ipairs(CarConfig.RarityOrder) do
		if #CarConfig.ByRarity[r] ~= #CarConfig.ByRarity.Common or #CarConfig.ByRarity[r] &lt; 4 then
			table.insert(errors, r .. ": uneven car count " .. #CarConfig.ByRarity[r])
		end
		count = count + #CarConfig.ByRarity[r]
	end
	if count ~= #list then
		table.insert(errors, "car count mismatch " .. count)
	end
	for partId, row in pairs(CarConfig.DropChances) do
		local sum = 0
		for _, r in ipairs(CarConfig.RarityOrder) do
			sum = sum + (row[r] or 0)
		end
		if math.abs(sum - 100) &gt; 1e-9 then
			table.insert(errors, partId .. ": drop chances sum to " .. sum)
		end
	end
	return errors
end

return CarConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">EconomyConfig</string><ProtectedString name="Source">local EconomyConfig = {}

EconomyConfig.StarterParts = { bolts = 2 }
EconomyConfig.CarryCapacity = 20
EconomyConfig.DeathLossFraction = 1.0 -- one hit = whole run lost
EconomyConfig.MaxCars = 200
EconomyConfig.MaxMoney = 1e15
EconomyConfig.StartSlots = 3
EconomyConfig.MaxSlots = 24
EconomyConfig.MaxFloors = 4
EconomyConfig.MaxPlayers = 8

-- bay prices: each floor has its own base price, bays inside a floor get pricier (x1.6)
EconomyConfig.FloorCosts = { [2] = 600000, [3] = 25000000, [4] = 700000000 } -- v22: x1.7 late (cars earn more); v25: x10
EconomyConfig.SlotCosts = {}
do
	local floorBase = { 10000, 120000, 2500000, 40000000 } -- v25: all money x10
	for slot = 4, 24 do
		local floor = math.floor((slot - 1) / 6) + 1
		local i = (slot - 1) % 6 - ((floor == 1) and 3 or 0)
		EconomyConfig.SlotCosts[slot] = math.floor(floorBase[floor] * 1.6 ^ i / 50 + 0.5) * 50
	end
end

-- tuned with tools/econ_sim.py (see docs/ECONOMY.md). minValue = collection value gate (keeps players from rushing)
EconomyConfig.ZoneUnlock = { -- v25: all money x10; v24: neon, canyon, Tier 3 re-tuned for Epic/Legendary x2.4/x3.5; v22: tier 2-3 x1.8 after the income boost; v18: each district ~10-60 min of income away; minValue is a soft check
	highway = { cost = 180000, minValue = 30000 },
	industrial = { cost = 2000000, minValue = 300000 },
	neon = { cost = 15000000, minValue = 1000000 },
	scrapyard = { cost = 30000000, minValue = 1500000 },
	-- Tier 2 needs a rebirth, Tier 3 three rebirths (RebirthService); rebirths keep unlocked districts
	docks = { cost = 270000000, minValue = 2500000, rebirths = 1 },
	desert = { cost = 720000000, minValue = 3500000, rebirths = 1 },
	bridge = { cost = 1600000000, minValue = 4500000, rebirths = 1 },
	airport = { cost = 3600000000, minValue = 5500000, rebirths = 1 },
	canyon = { cost = 1e+10, minValue = 6500000, rebirths = 2 },
	circuit = { cost = 2e+10, minValue = 7500000, rebirths = 3 },
	drift = { cost = 3.5e+10, minValue = 9000000, rebirths = 3 },
	storm = { cost = 6e+10, minValue = 10500000, rebirths = 3 },
	rush = { cost = 1e+11, minValue = 12000000, rebirths = 3 },
	colosseum = { cost = 1.6e+11, minValue = 14000000, rebirths = 3 },
}

EconomyConfig.SellFraction = 0.35
EconomyConfig.DiscoverBonusMult = 3 -- v25: a first-time catch pays 3x the car's value (jackpot feel)
EconomyConfig.IndexTierBonus = 0.05
EconomyConfig.IndexFullBonus = 0.10
EconomyConfig.PityThreshold = 25 -- v13: counted per car caught (1 car per throw at the start)
EconomyConfig.MaxLuckShift = 0.15 -- all luck sources together

EconomyConfig.ThrowCooldown = 0.8
EconomyConfig.MaxBatch = 500 -- parts per throw (any amount: they add rarity points)
-- cars caught per throw: 1 at the start, +1 per "Multi Catch" level in the Pit Stop (ShopConfig), max 4
EconomyConfig.MaxCatch = 4
function EconomyConfig.CatchLimit(multiLevel)
	return math.clamp(1 + (tonumber(multiLevel) or 0), 1, EconomyConfig.MaxCatch)
end
EconomyConfig.MergeMaxLevel = 3 -- duplicates level a car up to this; beyond needs upgrades
EconomyConfig.ThrowAnimTime = 5.2
EconomyConfig.ThrowMaxDistance = 45
EconomyConfig.BaseActionDistance = 100
EconomyConfig.PickupRadius = 7
EconomyConfig.PickupCheckInterval = 0.15
EconomyConfig.SpawnProtection = 2.5
EconomyConfig.HitCooldown = 1.0
EconomyConfig.TrafficTickRate = 1 / 30
EconomyConfig.AutosaveInterval = 60
EconomyConfig.TeleportCooldown = 4
EconomyConfig.ActionCooldown = 0.12

return EconomyConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">MapConfig</string><ProtectedString name="Source">local C = Color3.fromRGB

local MapConfig = {}

MapConfig.Seed = 12345
MapConfig.Version = 21 -- bump when the map changes: a saved older GeneratedMap is rebuilt at server start
MapConfig.MapHalfWidth = 190
MapConfig.StartZ = -330
MapConfig.EndZ = 1056 -- recomputed below once every district is placed
MapConfig.PlazaEndZ = 70
MapConfig.DecorationDensity = 0.75
MapConfig.GraphicsQuality = "MobileFriendly"
MapConfig.Cartoon = true

MapConfig.RoadTopY = 0.2
MapConfig.SidewalkTopY = 0.8
MapConfig.SidewalkWidth = 6
MapConfig.TunnelLength = 50
MapConfig.EntryHalfWidth = 66 -- v23: wide enough for the two plaza speed lanes (x +-58..64)
MapConfig.GateHalfWidth = 30
MapConfig.EntryZ = 74
MapConfig.PromenadeHalfWidth = 68

MapConfig.BasePlot = { x = 110, z = 95 }
MapConfig.BaseCount = 8
-- v23: index 1-2 = the row next to the arch, so the first players get the shortest run (BaseService takes the first free)
MapConfig.BaseCenters = {
	{ x = -125, z = 19 },   { x = 125, z = 19 },
	{ x = -125, z = -79 },  { x = 125, z = -79 },
	{ x = -125, z = -177 }, { x = 125, z = -177 },
	{ x = -125, z = -275 }, { x = 125, z = -275 },
}
MapConfig.BaseRowsZ = { 19, -79, -177, -275 } -- garage row centres (the garage doors open here), nearest the arch first

-- v23 HUB: one round square in the middle of the garages. Every stand sits on a ring around the fountain, faces the
-- centre and is placed by angle (degrees, 0 = +X, 90 = +Z towards the arch). The four axis directions stay open:
-- +-X lead to the speed lanes and the garage doors, +Z to the arch, -Z to the car meet.
-- top = stand floor level (the hub paving the stands stand on).
MapConfig.Hub = { x = 0, z = -128, r = 54, top = 0.42, island = 11.5 }
local function onRing(deg, r)
	local a = math.rad(deg)
	local h = MapConfig.Hub
	-- yaw: local -Z (the stand's front) looks at the hub centre
	return { x = h.x + r * math.cos(a), z = h.z + r * math.sin(a), yaw = math.pi / 2 - a, angle = deg, r = r }
end
MapConfig.HubRing = onRing
MapConfig.Shop = onRing(28, 45) -- Pit Stop
MapConfig.MagnatPodium = onRing(62, 42) -- Golden Magnat GT on its stand
MapConfig.DonateStall = onRing(118, 45) -- Golden Magnate
MapConfig.Leaderboard = onRing(152, 49) -- screen; the top-3 podium stands 11 studs towards the centre
MapConfig.Tony = onRing(232, 45) -- Big Tony's Gears garage
-- v25: the Job Board (308) is gone, jobs open from the JOBS HUD button; its slot is a garden now
MapConfig.HubGardens = { onRing(200, 46), onRing(308, 46), onRing(340, 46) } -- tree beds with benches in the free slots

MapConfig.NoNeon = true -- map decor uses lit materials only where something is a real light source

-- Speed lanes: player WalkSpeed boost while standing on them (never cross roads)
MapConfig.WalkSpeed = 18
MapConfig.LaneSpeed = 48
MapConfig.LaneWidth = 6 -- each running lane
-- v23 plaza lanes: one two-way lane on each side between the hub and the garage doors, through the entry opening
MapConfig.PlazaLaneX = 61 -- lane centre (|x|): hub edge 54, garage fronts 70, entry fence opening +-66

-- Route along +Z: plaza -&gt; Tier 1 (4 districts) -&gt; arena -&gt; Tier 2 -&gt; arena -&gt; Tier 3 -&gt; final arena.
MapConfig.ZoneOrder = {
	"city", "highway", "industrial", "neon", "scrapyard",
	"docks", "desert", "bridge", "airport", "canyon",
	"circuit", "drift", "storm", "rush", "colosseum",
}

MapConfig.Gates = {
	{ zone = "highway", z = 318 },
	{ zone = "industrial", z = 564 },
	{ zone = "neon", z = 810 },
}

MapConfig.Zones = {
	city = {
		id = "city", tier = 1, name = "CITY DISTRICT", zMin = 84, zMax = 310, roads = { 1, 2 }, hitDamage = 999,
		palette = {
			ground = C(110, 205, 95), road = C(62, 64, 72), sidewalk = C(222, 212, 192), curb = C(180, 172, 156),
			accent = C(255, 160, 50), accent2 = C(60, 170, 230),
			buildings = { C(255, 196, 120), C(255, 120, 100), C(110, 200, 255), C(255, 226, 110), C(255, 160, 180), C(130, 225, 150) },
		},
	},
	highway = {
		id = "highway", tier = 1, name = "HIGHWAY DISTRICT", zMin = 326, zMax = 556, roads = { 3, 4 }, hitDamage = 999,
		palette = {
			ground = C(126, 146, 116), road = C(50, 52, 58), sidewalk = C(176, 178, 184), curb = C(140, 142, 150),
			accent = C(255, 210, 40), accent2 = C(230, 70, 60),
			buildings = { C(200, 205, 215), C(120, 150, 190), C(230, 230, 235), C(90, 100, 120), C(255, 190, 70) },
		},
	},
	industrial = {
		id = "industrial", tier = 1, name = "INDUSTRIAL DISTRICT", zMin = 572, zMax = 802, roads = { 5, 6 }, hitDamage = 999,
		palette = {
			ground = C(150, 136, 116), road = C(52, 50, 50), sidewalk = C(168, 160, 148), curb = C(120, 114, 104),
			accent = C(255, 120, 30), accent2 = C(255, 220, 60),
			buildings = { C(150, 120, 100), C(110, 120, 130), C(170, 90, 70), C(130, 150, 120), C(190, 170, 130) },
		},
	},
	neon = {
		id = "neon", tier = 1, name = "NIGHT DISTRICT", zMin = 818, zMax = 1048, roads = { 7, 8 }, hitDamage = 999,
		palette = {
			ground = C(46, 52, 62), road = C(30, 32, 38), sidewalk = C(96, 100, 110), curb = C(70, 74, 84),
			accent = C(255, 170, 60), accent2 = C(90, 190, 255),
			buildings = { C(60, 70, 88), C(44, 52, 66), C(84, 74, 70), C(38, 42, 52), C(70, 84, 100) },
		},
	},
}

MapConfig.Plaza = {
	ground = C(110, 205, 95), paving = C(236, 228, 210), floor = C(52, 54, 62),
	accent = C(60, 200, 255),
}

MapConfig.Roads = {
	{ id = 1, zone = "city", z = 150, width = 36, lanesPerSide = 2, laneWidth = 8, median = 4,
		speed = { 30, 40 }, spacing = { 70, 95 }, kinds = { "compact", "sedan", "taxi", "van" } },
	{ id = 2, zone = "city", z = 245, width = 36, lanesPerSide = 2, laneWidth = 8, median = 4,
		speed = { 34, 44 }, spacing = { 65, 90 }, kinds = { "compact", "sedan", "taxi", "van" } },
	{ id = 3, zone = "highway", z = 395, width = 40, lanesPerSide = 2, laneWidth = 9, median = 4,
		speed = { 52, 66 }, spacing = { 70, 95 }, kinds = { "sedan", "sport", "minibus", "supercar" } },
	{ id = 4, zone = "highway", z = 488, width = 40, lanesPerSide = 2, laneWidth = 9, median = 4,
		speed = { 55, 70 }, spacing = { 65, 90 }, kinds = { "sedan", "sport", "minibus", "supercar" } },
	{ id = 5, zone = "industrial", z = 640, width = 38, lanesPerSide = 2, laneWidth = 8.5, median = 4,
		speed = { 42, 58 }, spacing = { 75, 100 }, kinds = { "truck", "pickup", "service" } },
	{ id = 6, zone = "industrial", z = 733, width = 38, lanesPerSide = 2, laneWidth = 8.5, median = 4,
		speed = { 45, 60 }, spacing = { 70, 95 }, kinds = { "truck", "pickup", "service" } },
	{ id = 7, zone = "neon", z = 886, width = 40, lanesPerSide = 2, laneWidth = 9, median = 4,
		speed = { 68, 84 }, spacing = { 70, 95 }, kinds = { "proto", "supercar", "sport" } },
	{ id = 8, zone = "neon", z = 979, width = 40, lanesPerSide = 2, laneWidth = 9, median = 4,
		speed = { 72, 90 }, spacing = { 65, 90 }, kinds = { "proto", "supercar", "sport" } },
}


-- Tier 2-3 districts and the three boss arenas. style = which Tier 1 look the builder reuses.
-- Each road: { off from zMin, lanesPerSide, laneWidth, speed, spacing, kinds, [loop, count, weave, surge] }
local EXTRA = {
	{ id = "scrapyard", tier = 1, arena = true, boss = "crusher", name = "SCRAPYARD ARENA", len = 300, style = "industrial",
		palette = { ground = C(132, 112, 88), road = C(52, 50, 50), sidewalk = C(150, 140, 126), curb = C(110, 100, 90), accent = C(255, 150, 40), accent2 = C(255, 220, 60),
			buildings = { C(140, 110, 90), C(110, 116, 122), C(160, 90, 70) } } },
	{ id = "docks", tier = 2, name = "DOCKS", len = 230, style = "industrial", hazard = "train",
		palette = { ground = C(120, 130, 136), road = C(46, 48, 52), sidewalk = C(160, 164, 168), curb = C(110, 116, 124), accent = C(255, 190, 40), accent2 = C(60, 150, 220),
			buildings = { C(200, 70, 50), C(50, 110, 180), C(230, 180, 40), C(60, 140, 90), C(220, 220, 224) } },
		roads = { { off = 66, rail = true, lanes = 1, lw = 10, speed = { 70, 80 }, loop = 1500, count = 1, kinds = { "train" } },
			{ off = 161, lanes = 2, lw = 9, speed = { 60, 76 }, spacing = { 60, 85 }, kinds = { "truck", "service", "pickup" } } } },
	{ id = "desert", tier = 2, name = "DESERT HIGHWAY", len = 230, style = "highway", hazard = "sandstorm",
		palette = { ground = C(226, 190, 130), road = C(70, 66, 62), sidewalk = C(214, 196, 160), curb = C(186, 160, 120), accent = C(255, 140, 40), accent2 = C(200, 80, 50),
			buildings = { C(226, 170, 110), C(200, 150, 100), C(240, 210, 160), C(180, 120, 80) } },
		roads = { { off = 66, lanes = 3, lw = 8.5, speed = { 62, 80 }, spacing = { 60, 85 }, kinds = { "pickup", "suv", "muscle", "truck" } },
			{ off = 166, lanes = 3, lw = 8.5, speed = { 66, 84 }, spacing = { 58, 80 }, kinds = { "pickup", "suv", "muscle", "sport" } } } },
	{ id = "bridge", tier = 2, name = "RIVER BRIDGES", len = 230, style = "city", hazard = "river",
		palette = { ground = C(104, 190, 96), road = C(58, 60, 68), sidewalk = C(214, 206, 190), curb = C(170, 164, 150), accent = C(60, 170, 230), accent2 = C(255, 160, 50),
			buildings = { C(240, 200, 150), C(200, 120, 100), C(120, 180, 220), C(250, 230, 180) } },
		roads = { { off = 52, lanes = 2, lw = 9, speed = { 66, 82 }, spacing = { 60, 85 }, kinds = { "sedan", "sport", "suv" } },
			{ off = 178, lanes = 2, lw = 9, speed = { 68, 86 }, spacing = { 58, 82 }, kinds = { "sedan", "sport", "minibus" } } } },
	{ id = "airport", tier = 2, name = "AIRPORT", len = 230, style = "highway", hazard = "jets",
		palette = { ground = C(120, 170, 100), road = C(64, 66, 72), sidewalk = C(190, 192, 196), curb = C(150, 152, 158), accent = C(255, 210, 40), accent2 = C(60, 120, 220),
			buildings = { C(220, 224, 230), C(140, 170, 210), C(240, 240, 244), C(90, 110, 140) } },
		roads = { { off = 70, lanes = 1, lw = 30, median = 8, speed = { 24, 30 }, loop = 1100, count = 2, kinds = { "plane" } },
			{ off = 168, lanes = 2, lw = 9, speed = { 60, 74 }, spacing = { 60, 82 }, kinds = { "service", "minibus", "van" } } } },
	{ id = "canyon", tier = 2, arena = true, boss = "juggernaut", name = "CANYON ARENA", len = 300, style = "highway",
		palette = { ground = C(196, 120, 80), road = C(70, 60, 56), sidewalk = C(200, 150, 110), curb = C(160, 100, 70), accent = C(255, 170, 60), accent2 = C(220, 70, 50),
			buildings = { C(190, 110, 70), C(170, 90, 60), C(210, 140, 90) } } },
	{ id = "circuit", tier = 3, name = "RACE CIRCUIT", len = 230, style = "highway", hazard = "racers",
		palette = { ground = C(96, 170, 90), road = C(44, 46, 52), sidewalk = C(230, 230, 230), curb = C(214, 52, 44), accent = C(255, 210, 40), accent2 = C(214, 52, 44),
			buildings = { C(230, 230, 236), C(214, 52, 44), C(40, 44, 52), C(255, 210, 40) } },
		roads = { { off = 66, lanes = 2, lw = 9.5, speed = { 96, 112 }, spacing = { 100, 140 }, kinds = { "racer" } },
			{ off = 161, lanes = 2, lw = 9.5, speed = { 100, 118 }, spacing = { 95, 130 }, kinds = { "racer" } } } },
	{ id = "drift", tier = 3, name = "DRIFT DISTRICT", len = 230, style = "neon", hazard = "weave",
		palette = { ground = C(52, 56, 70), road = C(32, 34, 40), sidewalk = C(100, 104, 116), curb = C(76, 80, 92), accent = C(255, 90, 140), accent2 = C(80, 200, 255),
			buildings = { C(70, 60, 90), C(50, 56, 72), C(90, 70, 80), C(40, 46, 60) } },
		roads = { { off = 66, lanes = 2, lw = 10.5, speed = { 74, 92 }, spacing = { 64, 90 }, kinds = { "sport", "muscle", "supercar" }, weave = 3.4 },
			{ off = 161, lanes = 2, lw = 10.5, speed = { 78, 96 }, spacing = { 62, 86 }, kinds = { "sport", "muscle", "supercar" }, weave = 3.8 } } },
	{ id = "storm", tier = 3, name = "STORM VALLEY", len = 230, style = "neon", hazard = "storm",
		palette = { ground = C(70, 84, 80), road = C(34, 36, 40), sidewalk = C(110, 116, 120), curb = C(84, 90, 96), accent = C(255, 230, 120), accent2 = C(120, 170, 255),
			buildings = { C(80, 90, 100), C(60, 70, 80), C(100, 104, 110), C(50, 56, 64) } },
		roads = { { off = 66, lanes = 2, lw = 9, speed = { 82, 98 }, spacing = { 62, 86 }, kinds = { "suv", "truck", "sport", "pickup" } },
			{ off = 161, lanes = 2, lw = 9, speed = { 84, 102 }, spacing = { 60, 84 }, kinds = { "suv", "sedan", "supercar" } } } },
	{ id = "rush", tier = 3, name = "RUSH HOUR", len = 230, style = "highway", hazard = "rush",
		palette = { ground = C(110, 150, 110), road = C(48, 50, 56), sidewalk = C(186, 186, 190), curb = C(146, 146, 152), accent = C(255, 120, 40), accent2 = C(255, 210, 40),
			buildings = { C(200, 205, 215), C(120, 150, 190), C(255, 190, 70), C(90, 100, 120) } },
		roads = { { off = 66, lanes = 3, lw = 8.5, speed = { 84, 104 }, spacing = { 58, 80 }, kinds = { "sedan", "taxi", "sport", "truck", "supercar" }, surge = 0.6 },
			{ off = 166, lanes = 3, lw = 8.5, speed = { 88, 108 }, spacing = { 56, 78 }, kinds = { "van", "minibus", "proto", "racer" }, surge = 0.6 } } },
	{ id = "colosseum", tier = 3, arena = true, boss = "titan", name = "COLOSSEUM", len = 300, style = "neon",
		palette = { ground = C(214, 196, 160), road = C(60, 56, 52), sidewalk = C(230, 220, 196), curb = C(190, 176, 150), accent = C(255, 200, 60), accent2 = C(214, 52, 44),
			buildings = { C(230, 216, 186), C(200, 186, 156), C(240, 230, 210) } } },
}

for i, g in ipairs(MapConfig.Gates) do
	g.index = i
end
do
	local cur = MapConfig.Zones.neon.zMax + 16
	for _, e in ipairs(EXTRA) do
		local z = { id = e.id, tier = e.tier, name = e.name, arena = e.arena, boss = e.boss, style = e.style, hazard = e.hazard, palette = e.palette,
			zMin = cur, zMax = cur + e.len, roads = {}, hitDamage = 999 }
		for _, r in ipairs(e.roads or {}) do
			local med = r.median or 4
			local width = 2 * r.lanes * r.lw + med
			local road = { id = #MapConfig.Roads + 1, zone = e.id, z = z.zMin + r.off, width = width, lanesPerSide = r.lanes, laneWidth = r.lw, median = med,
				speed = r.speed, spacing = r.spacing or { 80, 100 }, kinds = r.kinds, loop = r.loop, count = r.count, weave = r.weave, surge = r.surge, rail = r.rail }
			table.insert(MapConfig.Roads, road)
			table.insert(z.roads, road.id)
		end
		MapConfig.Zones[e.id] = z
		table.insert(MapConfig.Gates, { zone = e.id, z = cur - 8 })
		cur = z.zMax + 16
	end
	MapConfig.EndZ = cur - 8
end
for _, z in pairs(MapConfig.Zones) do
	z.style = z.style or z.id
end

-- Traffic speed ramp (v13): one smooth curve over the whole route instead of per-road numbers.
-- u = position along the route (0 = first city road, 1 = last road before the final arena);
-- speed = 18 studs/s (= walking) at the start, rising to 92 at the end; +-12% spread between lanes; gaps x1.2.
-- Trains and planes keep their own timing. Server and clients read the same numbers (TrafficMath).
MapConfig.TrafficSpeed = { from = 18, to = 92, curve = 1.3, spread = 0.12, gap = 1.2 }
do
	local cfg = MapConfig.TrafficSpeed
	local zoneIndex = {}
	for i, id in ipairs(MapConfig.ZoneOrder) do
		zoneIndex[id] = i
	end
	local perZone, seen = {}, {}
	for _, r in ipairs(MapConfig.Roads) do
		perZone[r.zone] = (perZone[r.zone] or 0) + 1
	end
	for _, r in ipairs(MapConfig.Roads) do
		seen[r.zone] = (seen[r.zone] or 0) + 1
		local special = r.kinds and (r.kinds[1] == "train" or r.kinds[1] == "plane")
		if not special then
			local u = ((zoneIndex[r.zone] or 1) - 1 + (seen[r.zone] - 0.5) / perZone[r.zone]) / #MapConfig.ZoneOrder
			local mid = cfg.from + (cfg.to - cfg.from) * u ^ cfg.curve
			r.speed = { mid * (1 - cfg.spread), mid * (1 + cfg.spread) }
			if r.spacing then
				r.spacing = { r.spacing[1] * cfg.gap, r.spacing[2] * cfg.gap }
			end
		end
	end
end

-- river crossing in the bridge district: z range of water between its two roads
MapConfig.River = { zone = "bridge", z1 = MapConfig.Zones.bridge.zMin + 84, z2 = MapConfig.Zones.bridge.zMin + 146, bridges = { { x = 0, w = 16 }, { x = -96, w = 8 }, { x = 96, w = 8 } } }

-- Lane "surge": whole lane periodically speeds up/slows down (deterministic, client == server)
MapConfig.Surge = { amp = 0.35, period = { 5, 9 } }

MapConfig.TrafficColors = {
	C(220, 60, 60), C(60, 120, 220), C(240, 200, 50), C(70, 70, 78),
	C(235, 235, 240), C(70, 170, 100), C(240, 130, 40), C(40, 200, 220),
}

function MapConfig.ZoneAt(z)
	if z &lt; MapConfig.EntryZ then
		return "plaza"
	end
	for i = #MapConfig.Gates, 1, -1 do
		if z &gt;= MapConfig.Gates[i].z then
			return MapConfig.Gates[i].zone
		end
	end
	return "city"
end

function MapConfig.GateOfZone(zoneId)
	for _, g in ipairs(MapConfig.Gates) do
		if g.zone == zoneId then
			return g
		end
	end
	return nil
end

function MapConfig.ZoneIndex(zoneId)
	for i, id in ipairs(MapConfig.ZoneOrder) do
		if id == zoneId then
			return i
		end
	end
	return 0
end

function MapConfig.ZoneSpawn(zoneId)
	local z = MapConfig.Zones[zoneId]
	if not z then
		return nil
	end
	return Vector3.new(0, 4, z.zMin + 12)
end

function MapConfig.ZoneBlocks(zoneId)
	local zone = MapConfig.Zones[zoneId]
	local blocks = {}
	local prev = (zoneId == "city") and MapConfig.EntryZ + 10 or zone.zMin
	for _, rid in ipairs(zone.roads) do
		local r = MapConfig.Roads[rid]
		table.insert(blocks, { prev, r.z - r.width / 2 - MapConfig.SidewalkWidth })
		prev = r.z + r.width / 2 + MapConfig.SidewalkWidth
	end
	table.insert(blocks, { prev, zone.zMax })
	return blocks
end

-- rectangles {x1, x2, z1, z2}
-- Running lanes: in the plaza one two-way lane on each side (every garage door opens onto one; they run through the
-- entry opening beside the arch); in every district one central pair (out / back home), stopping before roads.
-- Each lane = { x1, x2, z1, z2, dx, dz, twoWay } where (dx,dz) is the arrow direction; the boost only works while
-- running that way (or its opposite on a two-way lane).
function MapConfig.SpeedLanes()
	if MapConfig._lanes then
		return MapConfig._lanes
	end
	local w, g = MapConfig.LaneWidth, 0.5
	local out = {}
	local function pairZ(z1, z2)
		table.insert(out, { -g - w, -g, z1, z2, 0, 1 }) -- left lane: away from the garages
		table.insert(out, { g, g + w, z1, z2, 0, -1 }) -- right lane: back home
	end
	for _, sx in ipairs({ -1, 1 }) do
		local cx = sx * MapConfig.PlazaLaneX
		table.insert(out, { cx - w / 2, cx + w / 2, MapConfig.StartZ + 8, MapConfig.EntryZ + 8, 0, 1, true })
	end
	for _, zid in ipairs(MapConfig.ZoneOrder) do
		for _, b in ipairs(MapConfig.ZoneBlocks(zid)) do
			if b[2] - b[1] &gt; 16 then
				pairZ(b[1] + 3, b[2] - 3)
			end
		end
	end
	MapConfig._lanes = out
	return out
end

-- returns the lane under pos (or nil)
function MapConfig.LaneAt(pos)
	for _, r in ipairs(MapConfig.SpeedLanes()) do
		if pos.X &gt;= r[1] and pos.X &lt;= r[2] and pos.Z &gt;= r[3] and pos.Z &lt;= r[4] then
			return r
		end
	end
	return nil
end

function MapConfig.OnSpeedLane(pos)
	return MapConfig.LaneAt(pos) ~= nil
end

-- does running along md (Vector3 move direction) on this lane get the boost?
function MapConfig.LaneBoosts(lane, md)
	local dot = md.X * lane[5] + md.Z * lane[6]
	return dot &gt; 0.5 or (lane[7] == true and dot &lt; -0.5)
end

function MapConfig.Validate()
	local errors = {}
	for _, r in ipairs(MapConfig.Roads) do
		local w = 2 * r.lanesPerSide * r.laneWidth + r.median
		if w ~= r.width then
			table.insert(errors, "Road" .. r.id .. ": width " .. r.width .. " ~= computed " .. w)
		end
	end
	for i = 1, #MapConfig.BaseCenters do
		for j = i + 1, #MapConfig.BaseCenters do
			local a, b = MapConfig.BaseCenters[i], MapConfig.BaseCenters[j]
			local ox = math.abs(a.x - b.x) &lt; MapConfig.BasePlot.x
			local oz = math.abs(a.z - b.z) &lt; MapConfig.BasePlot.z
			if ox and oz then
				table.insert(errors, "Bases " .. i .. " and " .. j .. " overlap")
			end
		end
	end
	-- v23 hub + plaza lanes: clear of every garage plot, lanes clear of the hub ring and inside the entry opening
	local hub = MapConfig.Hub
	local PX, PZ = MapConfig.BasePlot.x / 2, MapConfig.BasePlot.z / 2
	local function rectHitsPlot(x1, x2, z1, z2)
		for i, b in ipairs(MapConfig.BaseCenters) do
			if x2 &gt; b.x - PX and x1 &lt; b.x + PX and z2 &gt; b.z - PZ and z1 &lt; b.z + PZ then
				return i
			end
		end
		return nil
	end
	local hp = rectHitsPlot(hub.x - hub.r, hub.x + hub.r, hub.z - hub.r, hub.z + hub.r)
	if hp then
		table.insert(errors, "Hub overlaps base " .. hp)
	end
	if hub.z - hub.r &lt; MapConfig.StartZ or hub.z + hub.r &gt; MapConfig.EntryZ then
		table.insert(errors, "Hub outside the plaza")
	end
	for _, l in ipairs(MapConfig.SpeedLanes()) do
		if l[3] &lt; MapConfig.EntryZ then
			local p = rectHitsPlot(l[1], l[2], l[3], l[4])
			if p then
				table.insert(errors, string.format("Plaza lane x %.1f overlaps base %d", (l[1] + l[2]) / 2, p))
			end
			-- nearest point of the lane rectangle to the hub centre
			local nx = math.clamp(hub.x, l[1], l[2])
			local nz = math.clamp(hub.z, l[3], l[4])
			if (nx - hub.x) ^ 2 + (nz - hub.z) ^ 2 &lt; hub.r * hub.r then
				table.insert(errors, string.format("Plaza lane x %.1f crosses the hub", (l[1] + l[2]) / 2))
			end
			if l[4] &gt; MapConfig.EntryZ and (math.abs(l[1]) &gt; MapConfig.EntryHalfWidth or math.abs(l[2]) &gt; MapConfig.EntryHalfWidth) then
				table.insert(errors, string.format("Plaza lane x %.1f hits the entry fence", (l[1] + l[2]) / 2))
			end
		end
	end
	for _, key in ipairs({ "Shop", "DonateStall", "MagnatPodium", "Leaderboard", "Tony" }) do
		local s = MapConfig[key]
		if not s or math.sqrt((s.x - hub.x) ^ 2 + (s.z - hub.z) ^ 2) &gt; hub.r - 4 then
			table.insert(errors, key .. " is not on the hub ring")
		end
	end
	return errors
end

return MapConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">Net</string><ProtectedString name="Source">local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = {}

Net.Names = {
	"StateUpdate",
	"MoneySync",
	"Notify",
	"ThrowPart",
	"ThrowResult",
	"PlaceCar",
	"RemoveCar",
	"UpgradeCar",
	"BuySlot",
	"UnlockZone",
	"HitFx",
	"SellCar",
	"AutoPark",
	"TrafficHit",
	"Teleport",
	"BuyPerk",
	"Donate",
	"DonateFx",
	"HotDrop",
	"BankFx",
	"PickupFx",
	"BuyFloor",
	"ClaimContract",
	"BuyGear",
	"ApplyGear",
	"BossThrow",
	"BossFx",
	"Rebirth",
	"SetSkin",
	"TokenPerk",
	"ThrowBatch",
	"ThrowBatchResult",
	"OfflineEarnings",
	"SellCars",
	"CheckpointOffer",
	"CheckpointChoice",
	"CheckpointFx",
	"TutorialStep",
	"SaveSettings",
	"ClaimDaily",
	"ClaimChest",
	"TradeRequest",
	"TradeRespond",
	"TradeUpdate",
	"TradeReady",
	"TradeCancel",
	"TradeEvent",
	"UpgradeTrap",
	"TrapUpgraded",
}

function Net.Folder()
	local f = ReplicatedStorage:FindFirstChild("Remotes")
	if f then
		return f
	end
	if RunService:IsServer() then
		f = Instance.new("Folder")
		f.Name = "Remotes"
		f.Parent = ReplicatedStorage
		return f
	end
	return ReplicatedStorage:WaitForChild("Remotes")
end

function Net.Get(name)
	local folder = Net.Folder()
	local r = folder:FindFirstChild(name)
	if r then
		return r
	end
	if RunService:IsServer() then
		r = Instance.new("RemoteEvent")
		r.Name = name
		r.Parent = folder
		return r
	end
	return folder:WaitForChild(name)
end

function Net.EnsureAll()
	for _, n in ipairs(Net.Names) do
		Net.Get(n)
	end
end

return Net
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX18"><Properties><string name="Name">PartConfig</string><ProtectedString name="Source">local C = Color3.fromRGB

local PartConfig = {}

-- 10 parts, 2 per rarity (v13). points = how much a part adds to a throw (CarConfig.ChancesForPoints).
PartConfig.Order = { "bolts", "plugs", "tire", "filter", "engine", "gearbox", "turbo", "intercooler", "core", "chip" }

PartConfig.Parts = {
	bolts = { id = "bolts", rarity = "Common", color = C(200, 205, 215), points = 1, emoji = "🔩", name = "Bolts" },
	plugs = { id = "plugs", rarity = "Common", color = C(230, 230, 236), points = 2, emoji = "🕯️", name = "Spark Plugs" },
	tire = { id = "tire", rarity = "Uncommon", color = C(90, 220, 140), points = 4, emoji = "🛞", name = "Tire" },
	filter = { id = "filter", rarity = "Uncommon", color = C(120, 235, 170), points = 6, emoji = "🌀", name = "Air Filter" },
	engine = { id = "engine", rarity = "Rare", color = C(80, 170, 255), points = 10, emoji = "⚙️", name = "Engine" },
	gearbox = { id = "gearbox", rarity = "Rare", color = C(110, 190, 255), points = 14, emoji = "🔧", name = "Gearbox" },
	turbo = { id = "turbo", rarity = "Epic", color = C(255, 77, 109), points = 22, emoji = "💨", name = "Turbo" },
	intercooler = { id = "intercooler", rarity = "Epic", color = C(255, 120, 150), points = 30, emoji = "❄️", name = "Intercooler" },
	core = { id = "core", rarity = "Legendary", color = C(255, 195, 50), points = 50, emoji = "⚡", name = "Energy Core" },
	chip = { id = "chip", rarity = "Legendary", color = C(255, 225, 90), points = 70, emoji = "💎", name = "Quantum Chip" },
}

-- car upgrades cost the first part of the car's rarity
PartConfig.PartForRarity = {
	Common = "bolts", Uncommon = "tire", Rare = "engine", Epic = "turbo", Legendary = "core",
}

-- Spawns: smooth progression. Every district is centred one notch deeper in the part list
-- (city ~ bolts, colosseum ~ chip); risky spots sit 1 notch deeper, road crates 2 notches deeper.
local ZONES = { "city", "highway", "industrial", "neon", "scrapyard", "docks", "desert", "bridge", "airport", "canyon",
	"circuit", "drift", "storm", "rush", "colosseum" }
local ARENAS = { scrapyard = true, canyon = true, colosseum = true }
PartConfig.SpawnTables, PartConfig.PointCounts = {}, {}
local function table_for(centre)
	local out, sum = {}, 0
	for rank, id in ipairs(PartConfig.Order) do
		local w = math.exp(-((rank - centre) ^ 2) / (2 * 1.1 ^ 2))
		if w &gt; 0.05 then
			table.insert(out, { id, w })
			sum = sum + w
		end
	end
	for _, e in ipairs(out) do
		e[2] = math.max(1, math.floor(e[2] / sum * 100 + 0.5))
	end
	return out
end
for zi, zone in ipairs(ZONES) do
	local c = 1 + (zi - 1) * 0.6
	PartConfig.SpawnTables[zone] = { safe = table_for(c), risky = table_for(c + 1), road = table_for(c + 2) }
	PartConfig.PointCounts[zone] = ARENAS[zone] and { safe = 18, risky = 10, road = 0 } or { safe = zi == 1 and 14 or 12, risky = 8, road = 4 }
end

-- chance that a pickup in this zone also drops a gear (GearConfig) into the player's gear box.
-- Arena bosses in these zones reward every helper with a gear too (BossService).
PartConfig.GearDrops = {
	scrapyard = { chance = 0.015 },
	canyon = { chance = 0.025 },
	circuit = { chance = 0.03 }, drift = { chance = 0.03 },
	storm = { chance = 0.035 }, rush = { chance = 0.04 },
	colosseum = { chance = 0.06 },
}
PartConfig.RoadGearDrops = { "nitro", "clover" } -- the gears a pickup can drop
PartConfig.BossGearDrops = { "cashturbo", "rocket" } -- the gears a scared boss gives

PartConfig.Cooldowns = { safe = { 45, 70 }, risky = { 60, 95 }, road = { 50, 80 } }
PartConfig.CrateAmount = { road = 2 } -- road crates hold several parts
PartConfig.CrateAmountTier = { [2] = 3, [3] = 4 } -- deeper districts: fatter crates

return PartConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX19"><Properties><string name="Name">PartVisual</string><ProtectedString name="Source">local PartConfig = require(script.Parent.PartConfig)

local PartVisual = {}

local METAL = Color3.fromRGB(90, 96, 108)
local SILVER = Color3.fromRGB(205, 210, 220)
local DARK = Color3.fromRGB(30, 30, 34)

-- clone a template's parts into model, scaled so its longest side = size, centred on root, welded
function PartVisual.FromTemplate(model, root, tpl, size)
	local c = tpl:Clone()
	local _, ext = c:GetBoundingBox()
	c:ScaleTo(c:GetScale() * size / math.max(ext.X, ext.Y, ext.Z, 0.01))
	local cf2 = c:GetBoundingBox()
	local n = 0
	for _, p in ipairs(c:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CFrame = cf2:Inverse() * p.CFrame -- centre on origin
			p.Anchored = false
			local w = Instance.new("Weld")
			w.Part0, w.Part1, w.C0 = root, p, p.CFrame
			w.Parent = p
			p.Parent = model
			n = n + 1
		end
	end
	c:Destroy()
	return n &gt; 0
end

-- tuning part showcase model (Tony's counter, reveal)
function PartVisual.BuildTuning(family, size)
	local folder = game:GetService("ReplicatedStorage"):FindFirstChild("PartModels")
	local tpl = folder and folder:FindFirstChild("Tune_" .. family)
	if not tpl then
		return nil
	end
	local model = Instance.new("Model")
	model.Name = "Tune_" .. family
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.one
	root.Anchored, root.CanCollide, root.CanQuery, root.CanTouch = true, false, false, false
	root.Transparency = 1
	root.Parent = model
	model.PrimaryPart = root
	PartVisual.FromTemplate(model, root, tpl, size or 3)
	return model
end

function PartVisual.Build(partId)
	local def = PartConfig.Parts[partId] or PartConfig.Parts.bolts
	local col = def.color

	local model = Instance.new("Model")
	model.Name = "Drop_" .. def.id

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(1, 1, 1)
	root.CFrame = CFrame.new(0, 0, 0)
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Transparency = 1
	root.Parent = model
	model.PrimaryPart = root

	local function add(name, size, cf, color, material, transparency, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Material = material or Enum.Material.SmoothPlastic
		p.Transparency = transparency or 0
		if shape then
			p.Shape = shape
		end
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Anchored = false
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.CastShadow = false
		p.Parent = model
		local w = Instance.new("Weld")
		w.Part0 = root
		w.Part1 = p
		w.C0 = cf
		w.Parent = p
		return p
	end

	local CYL = Enum.PartType.Cylinder
	local BALL = Enum.PartType.Ball
	local upright = CFrame.Angles(0, 0, math.pi / 2)

	-- imported Blender model (blender/make_parts.py) when installed, procedural fallback otherwise
	local folder = game:GetService("ReplicatedStorage"):FindFirstChild("PartModels")
	local tpl = folder and folder:FindFirstChild("Part_" .. def.id)
	if tpl and PartVisual.FromTemplate(model, root, tpl, 3.2) then
		-- template parts added; glow/particles below still apply
	elseif def.id == "bolts" then
		add("Nut", Vector3.new(0.9, 2.0, 2.0), upright, SILVER, Enum.Material.Metal, 0, CYL)
		add("NutGlow", Vector3.new(0.95, 1.2, 1.2), upright, col, Enum.Material.Neon, 0, CYL)
		add("Shaft", Vector3.new(2.2, 0.8, 0.8), CFrame.new(0, -1.5, 0) * upright, METAL, Enum.Material.Metal, 0, CYL)
	elseif def.id == "tire" then
		add("Tire", Vector3.new(1.4, 3.4, 3.4), CFrame.new(), DARK, Enum.Material.SmoothPlastic, 0, CYL)
		add("Hub", Vector3.new(1.5, 1.7, 1.7), CFrame.new(), SILVER, Enum.Material.Metal, 0, CYL)
		add("HubGlow", Vector3.new(1.55, 0.8, 0.8), CFrame.new(), col, Enum.Material.Neon, 0, CYL)
	elseif def.id == "engine" then
		add("Block", Vector3.new(3.2, 2.0, 2.2), CFrame.new(), METAL, Enum.Material.Metal)
		for i = -1, 1 do
			add("Piston", Vector3.new(0.9, 0.9, 0.9), CFrame.new(i * 1.0, 1.4, 0) * upright, SILVER, Enum.Material.Metal, 0, CYL)
		end
		add("Strip", Vector3.new(3.25, 0.35, 2.25), CFrame.new(0, -0.2, 0), col, Enum.Material.Neon)
	elseif def.id == "turbo" then
		add("Housing", Vector3.new(2.2, 2.8, 2.8), CFrame.new(), col, Enum.Material.Metal, 0, CYL)
		add("Inlet", Vector3.new(1.2, 1.7, 1.7), CFrame.new(1.6, 0, 0), SILVER, Enum.Material.Metal, 0, CYL)
		add("InletGlow", Vector3.new(0.4, 1.2, 1.2), CFrame.new(2.2, 0, 0), col, Enum.Material.Neon, 0, CYL)
		add("Pipe", Vector3.new(1.4, 0.8, 0.8), CFrame.new(-0.2, 1.8, 0) * upright, METAL, Enum.Material.Metal, 0, CYL)
	else
		add("Core", Vector3.new(2.4, 2.4, 2.4), CFrame.new(), col, Enum.Material.Neon, 0, BALL)
		add("RingA", Vector3.new(0.18, 4.0, 4.0), CFrame.new(), SILVER, Enum.Material.Metal, 0.1, CYL)
		add("RingB", Vector3.new(0.18, 4.0, 4.0), CFrame.Angles(0, math.pi / 2, 0), SILVER, Enum.Material.Metal, 0.1, CYL)
	end

	add("Halo", Vector3.new(0.15, 5.5, 5.5), CFrame.new(0, -2.55, 0) * upright, col, Enum.Material.SmoothPlastic, 0.25, CYL)
	add("HaloCore", Vector3.new(0.15, 4.3, 4.3), CFrame.new(0, -2.45, 0) * upright, Color3.fromRGB(30, 32, 38), Enum.Material.SmoothPlastic, 0.25, CYL)

	if def.rarity == "Epic" or def.rarity == "Legendary" then
		local pe = Instance.new("ParticleEmitter")
		pe.Color = ColorSequence.new(col)
		pe.Rate = (def.rarity == "Legendary") and 10 or 5
		pe.Lifetime = NumberRange.new(1, 1.6)
		pe.Speed = NumberRange.new(2, 4)
		pe.Size = NumberSequence.new(0.5, 0)
		pe.LightEmission = 1
		pe.Parent = root
	end
	if def.rarity == "Legendary" then
		local light = Instance.new("PointLight")
		light.Color = col
		light.Range = 14
		light.Brightness = 1.5
		light.Parent = root
	end

	model:SetAttribute("PartId", def.id)
	return model
end

return PartVisual
