</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXC74BC333D0FE4214A1493C10A7416BC1"><Properties><string name="Name">Icons</string><ProtectedString name="Source">-- HUD icons rendered from the Blender models (assets/icons), uploaded as Decals; shown through rbxthumb.
local ok, ids = pcall(require, script.Parent:WaitForChild("IconIds"))
ids = ok and ids or {}

local Icons = {}

function Icons.Get(name)
	local id = ids[name]
	if id and id &gt; 0 then
		return string.format("rbxthumb://type=Asset&amp;id=%d&amp;w=420&amp;h=420", id)
	end
	return nil
end

return Icons
