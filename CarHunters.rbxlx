</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6E0DB39C82834CE9A66C01CB63FDCEDE"><Properties><string name="Name">RewardConfig</string><ProtectedString name="Source">-- Daily login streak (7 days, missing a day resets) and playtime chests per session.
local R = {}

-- money = max(min, income * seconds); parts added on top
R.Daily = {
	{ secs = 120, min = 500, parts = { tire = 3 } },
	{ secs = 180, min = 1000, parts = { engine = 2 } },
	{ secs = 240, min = 1500, parts = { tire = 6 } },
	{ secs = 360, min = 2500, parts = { engine = 3, turbo = 1 } },
	{ secs = 480, min = 4000, parts = { turbo = 2 } },
	{ secs = 600, min = 6000, parts = { engine = 5 } },
	{ secs = 900, min = 10000, parts = { core = 1, turbo = 2 }, pity = true },
}

R.Chests = {
	{ minutes = 5, secs = 60, min = 300, parts = { bolts = 5 } },
	{ minutes = 15, secs = 120, min = 800, parts = { tire = 4 } },
	{ minutes = 30, secs = 240, min = 1500, parts = { engine = 3 } },
	{ minutes = 60, secs = 480, min = 3000, parts = { turbo = 2 } },
	{ minutes = 120, secs = 900, min = 6000, parts = { core = 1 }, tuning = true },
}

function R.Money(entry, income)
	return math.max(entry.min, math.floor((income or 0) * entry.secs))
end

function R.UtcDay(t)
	return math.floor((t or os.time()) / 86400)
end

-- next streak day the player would get today (1..7)
function R.NextDay(daily, today)
	if daily.last == today - 1 then
		return (daily.day or 0) % 7 + 1
	end
	return 1
end

return R
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXA5E2A5A2CE51467FAED49F5C956F8E8B"><Properties><string name="Name">ShopConfig</string><ProtectedString name="Source">-- Pit Stop upgrades (in-game money). Effects are read on the server through ShopService.
local ShopConfig = {}

local function curve(base, growth, max)
	local t = {}
	for lvl = 1, max do
		t[lvl] = math.floor(base * growth ^ (lvl - 1) / 50 + 0.5) * 50
	end
	return t
end

ShopConfig.Perks = {
	{ id = "sneakers", icon = "👟", name = "Sneakers", desc = "+6% run speed", max = 5, costs = curve(800, 2.4, 5), per = 0.06 },
	{ id = "backpack", icon = "🎒", name = "Backpack", desc = "+5 loot capacity", max = 5, costs = curve(1500, 2.5, 5), per = 5 },
	{ id = "magnet", icon = "🧲", name = "Magnet", desc = "+2.5 studs pickup radius", max = 4, costs = curve(2000, 2.6, 4), per = 2.5 },
	{ id = "airbag", icon = "🛡️", name = "Airbag", desc = "Survive one car hit (recharges)", max = 3, costs = { 25000, 100000, 400000 }, cooldowns = { 180, 120, 60 } },
	{ id = "scanner", icon = "📡", name = "Scanner", desc = "Lv1: rare parts on the map. Lv2: Hot Drop alert 15s early", max = 2, costs = { 15000, 120000 } },
	{ id = "multi", icon = "🎰", name = "Multi Catch", desc = "+1 car per throw (up to 4)", max = 3, costs = { 6000, 80000, 900000 } },
	{ id = "lucky", icon = "🍀", name = "Lucky Trap", desc = "+1.5% better car rarity", max = 5, costs = curve(5000, 3, 5), per = 0.015 },
	{ id = "turbo", icon = "💰", name = "Turbo Garage", desc = "+8% garage income", max = 5, costs = curve(10000, 3, 5), per = 0.08 },
	{ id = "quick", icon = "⏱️", name = "Quick Start", desc = "Faster respawn, longer spawn shield", max = 3, costs = curve(4000, 3, 3), respawn = { 2.4, 1.9, 1.4 } },
}

ShopConfig.ById = {}
for i, p in ipairs(ShopConfig.Perks) do
	p.order = i
	ShopConfig.ById[p.id] = p
end

function ShopConfig.NextCost(id, level)
	local p = ShopConfig.ById[id]
	return p and p.costs[(level or 0) + 1] or nil
end

return ShopConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXFF73C53B2E2E462CAF6DD22D80076633"><Properties><string name="Name">SkinConfig</string><ProtectedString name="Source">-- Garage skins: one active at a time, each recolours the whole garage and adds an income bonus.
local C = Color3.fromRGB
local SkinConfig = {}

local function style(o)
	local base = {
		floor = C(212, 214, 218), inlay = C(60, 63, 70), line = C(242, 242, 240), wall = C(38, 40, 46),
		deck = C(238, 238, 236), frame = C(28, 30, 34), accent = C(255, 196, 40), accent2 = C(214, 52, 44),
		door = C(200, 204, 210), bay = C(80, 84, 92),
	}
	for k, v in pairs(o) do
		base[k] = v
	end
	return base
end

-- price: money | tokens (rebirth) | pass (Golden Magnate game pass)
SkinConfig.Skins = {
	{ id = "classic", name = "Classic", icon = "🏁", bonus = 0, style = style({}) },
	{ id = "street", name = "Street Garage", icon = "🧱", bonus = 0.03, money = 250000,
		style = style({ floor = C(150, 150, 154), wall = C(150, 70, 52), deck = C(196, 196, 200), accent = C(255, 140, 40), inlay = C(48, 48, 52) }) },
	{ id = "racing", name = "Racing Team", icon = "🏎️", bonus = 0.06, money = 15000000,
		style = style({ floor = C(236, 236, 240), wall = C(214, 52, 44), deck = C(250, 250, 250), accent = C(255, 255, 255), accent2 = C(30, 30, 34), inlay = C(30, 30, 34), frame = C(20, 20, 24) }) },
	{ id = "chrome", name = "Chrome Lux", icon = "💎", bonus = 0.10, money = 900000000,
		style = style({ floor = C(70, 74, 82), wall = C(196, 200, 208), deck = C(220, 224, 230), frame = C(150, 156, 166), accent = C(110, 200, 255), inlay = C(40, 44, 52), bay = C(56, 60, 68) }) },
	{ id = "midnight", name = "Midnight Club", icon = "🌙", bonus = 0.15, tokens = 15,
		style = style({ floor = C(30, 32, 44), wall = C(18, 20, 30), deck = C(40, 44, 60), frame = C(12, 12, 18), accent = C(150, 110, 255), accent2 = C(80, 200, 255), line = C(170, 150, 255), inlay = C(60, 50, 110), bay = C(44, 46, 62) }) },
	{ id = "golden", name = "Golden Magnate", icon = "👑", bonus = 0.20, pass = "golden_garage",
		style = style({ floor = C(250, 240, 214), wall = C(28, 32, 44), deck = C(250, 244, 226), frame = C(232, 178, 50), accent = C(232, 178, 50), accent2 = C(232, 178, 50), inlay = C(180, 130, 40), bay = C(60, 56, 50) }) },
}
SkinConfig.ById = {}
for i, s in ipairs(SkinConfig.Skins) do
	s.order = i
	SkinConfig.ById[s.id] = s
end

-- rebirth token shop (besides the Midnight skin)
SkinConfig.TokenPerks = {
	{ id = "startSlot", name = "+1 starting bay", icon = "🅿️", cost = 3, max = 3 },
	{ id = "luck", name = "+2% trap luck", icon = "🍀", cost = 4, max = 5, per = 0.02 },
	{ id = "magnet", name = "+25% pickup radius", icon = "🧲", cost = 5, max = 2, per = 0.25 },
}
SkinConfig.TokenPerkById = {}
for _, p in ipairs(SkinConfig.TokenPerks) do
	SkinConfig.TokenPerkById[p.id] = p
end

-- Rebirth rules
SkinConfig.Rebirth = {
	needZone = { [0] = "scrapyard", [1] = "airport", [2] = "canyon" }, -- beat the arena of your tier; later: "rush"
	lateZone = "rush",
	baseMoney = 150000000, growth = 2.2,
	incomePer = 0.25, startMoney = 500,
}
function SkinConfig.RebirthNeeds(n)
	local R = SkinConfig.Rebirth
	return R.needZone[n] or R.lateZone, math.floor(R.baseMoney * R.growth ^ n)
end

return SkinConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX64C9AB3C5ED2431E98D701810D9CC329"><Properties><string name="Name">SoundIds</string><ProtectedString name="Source">-- Sound asset ids (ElevenLabs SFX uploaded by tools/roblox_open_cloud.py). 0 = not uploaded: built-in fallback is used.
return {
	click = 129701225439846, open = 137919267005389, err = 93818499880209, ping = 88613645625966, throw = 119327249998497, clank = 81236574431044, charge = 119801036998398, reveal = 104359112527062, revealBig = 89971480285601, land = 105360367997502, drive = 135356508628598,
	pickup = 115648143432870, pickupBig = 88679381563835, bank = 106536817236294, bankCombo = 118911778326066, combo = 117977986909264, cash = 94389113268355, siren = 91817872654141, crash = 95389621886750, wrecked = 139719815735975, airbag = 86864075035630,
	whoosh = 106593268383104, fanfare = 132390340647866, ambience = 0, step = 107581095754096, music = 93319827841893,
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXD7ABB598AE234F6B840F2CD1B1C6071B"><Properties><string name="Name">SpecialVehicles</string><ProtectedString name="Source">-- Hand-built shapes that are not cars: freight train, taxiing airliner, monster trucks (bosses).
-- Same contract as VehicleFactory: Model with an anchored, invisible PrimaryPart "Root" at ground level,
-- everything else welded to it, length along local +X.
local SV = {}
local C = Color3.fromRGB
local M = Enum.Material
local CYL = Enum.PartType.Cylinder

local function kit(name)
	local model = Instance.new("Model")
	model.Name = name
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(1, 0.2, 1)
	root.Anchored, root.CanCollide, root.CanQuery, root.CanTouch = true, false, false, false
	root.Transparency = 1
	root.Parent = model
	model.PrimaryPart = root
	local function add(n, size, off, color, mat, shape)
		local p = Instance.new("Part")
		p.Name = n
		p.Size = size
		p.CFrame = off
		p.Color = color
		p.Material = mat or M.SmoothPlastic
		if shape then
			p.Shape = shape
		end
		p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.Massless = false, false, false, false, true
		local w = Instance.new("WeldConstraint")
		w.Part0, w.Part1 = root, p
		w.Parent = p
		p.Parent = model
		return p
	end
	return model, add
end

local function wheelRow(add, x0, x1, step, z, y, r, color)
	for x = x0, x1, step do
		add("Wheel", Vector3.new(0.8, r * 2, r * 2), CFrame.new(x, y, z) * CFrame.Angles(0, math.pi / 2, 0), color, M.Metal, CYL)
	end
end

function SV.Train(color)
	local m, add = kit("Train")
	color = color or C(214, 52, 44)
	local DARK, STEEL = C(36, 38, 44), C(120, 124, 132)
	-- locomotive (front = +X)
	local LX = 75 - 11
	add("LocoBody", Vector3.new(22, 7, 7.4), CFrame.new(LX, 5.5, 0), color)
	add("LocoCab", Vector3.new(6, 3, 7.6), CFrame.new(LX + 6, 10.5, 0), color)
	add("LocoWindow", Vector3.new(0.2, 1.6, 6), CFrame.new(LX + 9.05, 10.6, 0), C(60, 90, 120), M.Glass)
	add("LocoNose", Vector3.new(1, 5, 7), CFrame.new(LX + 11.4, 4.8, 0), C(255, 210, 40))
	add("HeadLight", Vector3.new(0.3, 1, 1), CFrame.new(LX + 12, 6.4, 0), C(255, 246, 210), M.Neon)
	add("LocoStripe", Vector3.new(22.2, 0.8, 7.6), CFrame.new(LX, 4.2, 0), C(255, 210, 40))
	add("LocoFrame", Vector3.new(23, 1, 6.4), CFrame.new(LX, 1.6, 0), DARK, M.Metal)
	wheelRow(add, LX - 8, LX + 8, 4, 3.4, 1.4, 1.2, DARK)
	wheelRow(add, LX - 8, LX + 8, 4, -3.4, 1.4, 1.2, DARK)
	-- container wagons
	local wagonColors = { C(50, 110, 180), C(230, 180, 40), C(60, 140, 90), C(200, 70, 50), C(220, 220, 224) }
	local x = LX - 11 - 1.5
	local i = 0
	while x - 20 &gt; -75 do
		i = i + 1
		local cx = x - 10
		add("WagonDeck", Vector3.new(20, 0.8, 6.6), CFrame.new(cx, 2.2, 0), DARK, M.Metal)
		add("Container", Vector3.new(19, 6.6, 7.2), CFrame.new(cx, 6, 0), wagonColors[(i - 1) % #wagonColors + 1], M.Metal)
		for k = -2, 2 do
			add("Rib", Vector3.new(0.3, 6.2, 7.4), CFrame.new(cx + k * 3.6, 6, 0), STEEL, M.Metal)
		end
		wheelRow(add, cx - 7, cx + 7, 14, 3.4, 1.2, 1, DARK)
		wheelRow(add, cx - 7, cx + 7, 14, -3.4, 1.2, 1, DARK)
		x = x - 21.5
	end
	m:SetAttribute("Height", 12)
	return m
end

function SV.Plane(color)
	local m, add = kit("Plane")
	color = color or C(240, 242, 246)
	local ACC, GREY, DARK = C(214, 52, 44), C(180, 184, 192), C(40, 42, 48)
	add("Fuselage", Vector3.new(36, 6.4, 6.4), CFrame.new(0, 7.2, 0) * CFrame.Angles(0, 0, 0), color, M.SmoothPlastic, CYL)
	add("Nose", Vector3.new(5, 5.4, 5.4), CFrame.new(19.5, 7, 0), color, M.SmoothPlastic, Enum.PartType.Ball)
	add("Cockpit", Vector3.new(1.6, 1.2, 4.4), CFrame.new(20, 8.4, 0), C(50, 70, 100), M.Glass)
	add("Tail", Vector3.new(5, 4.6, 4.6), CFrame.new(-19, 7.8, 0), color, M.SmoothPlastic, CYL)
	add("Fin", Vector3.new(6, 8, 0.6), CFrame.new(-20, 12.5, 0) * CFrame.Angles(0, 0, math.rad(-18)), ACC)
	add("Stabilizer", Vector3.new(4, 0.4, 14), CFrame.new(-20, 9, 0), color)
	add("Stripe", Vector3.new(30, 0.6, 6.5), CFrame.new(0, 7, 0), ACC)
	for _, s in ipairs({ -1, 1 }) do
		add("Wing", Vector3.new(9, 0.6, 18), CFrame.new(1, 5.6, s * 12) * CFrame.Angles(0, s * math.rad(18), 0), GREY, M.Metal)
		add("Engine", Vector3.new(6, 3, 3), CFrame.new(3, 3.9, s * 10), GREY, M.Metal, CYL)
		add("EngineIntake", Vector3.new(0.3, 2.6, 2.6), CFrame.new(6.1, 3.9, s * 10), DARK, M.Metal, CYL)
		add("Gear", Vector3.new(1, 2.4, 2.4), CFrame.new(-1, 1.2, s * 3), DARK, M.SmoothPlastic, CYL).CFrame = CFrame.new(-1, 1.2, s * 3) * CFrame.Angles(0, math.pi / 2, 0)
	end
	add("NoseGear", Vector3.new(1, 2, 2), CFrame.new(16, 1, 0) * CFrame.Angles(0, math.pi / 2, 0), DARK, M.SmoothPlastic, CYL)
	m:SetAttribute("Height", 14)
	return m
end

-- Boss monster trucks: huge wheels, lifted frame, roll cage. size = overall length.
SV.BossLooks = {
	crusher = { body = C(240, 120, 30), accent = C(30, 30, 34), L = 22 },
	juggernaut = { body = C(60, 130, 210), accent = C(255, 210, 40), L = 26 },
	titan = { body = C(200, 30, 40), accent = C(240, 190, 60), L = 30 },
}

-- Blender model (server only: ServerStorage.BuilderAssets.Props.MonsterTruck, loaded by ModelService), nose on +X.
-- Scaled to the look's length, "Body"/"Accent" pieces recoloured, every piece welded to an anchored ground Root.
local function fromBlender(lk)
	local ss = game:GetService("ServerStorage")
	local assets = ss:FindFirstChild("BuilderAssets")
	local props = assets and assets:FindFirstChild("Props")
	local tpl = props and props:FindFirstChild("MonsterTruck")
	if not tpl then
		return nil
	end
	local src = tpl:Clone()
	local _, size = src:GetBoundingBox()
	if size.X &gt; 0.1 then
		src:ScaleTo(src:GetScale() * lk.L / size.X)
	end
	local bb
	bb, size = src:GetBoundingBox()
	-- move the model so its ground centre sits at the origin, where the Root is
	src:PivotTo(src:GetPivot() - Vector3.new(bb.Position.X, bb.Position.Y - size.Y / 2, bb.Position.Z))
	local m = kit("MonsterTruck")
	local root = m.PrimaryPart
	for _, d in ipairs(src:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Color = (d.Name == "Body" and lk.body) or (d.Name == "Accent" and lk.accent) or d.Color
			d.Anchored, d.CanCollide, d.CanQuery, d.CanTouch, d.Massless = false, false, false, false, true
			local w = Instance.new("WeldConstraint")
			w.Part0, w.Part1 = root, d
			w.Parent = d
			d.Parent = m
		end
	end
	src:Destroy()
	m:SetAttribute("Height", size.Y)
	m:SetAttribute("HalfL", size.X / 2)
	m:SetAttribute("HalfW", size.Z / 2)
	return m
end

function SV.MonsterTruck(look)
	local lk = SV.BossLooks[look] or SV.BossLooks.crusher
	local ok, bm = pcall(fromBlender, lk)
	if ok and bm then
		return bm
	end
	local m, add = kit("MonsterTruck")
	local L = lk.L
	local s = L / 22
	local TIRE, RIM, CAGE = C(24, 24, 28), C(200, 204, 210), C(40, 42, 48)
	local r = 4.2 * s
	for _, x in ipairs({ -L * 0.32, L * 0.32 }) do
		for _, z in ipairs({ -1, 1 }) do
			add("Tire", Vector3.new(3.4 * s, r * 2, r * 2), CFrame.new(x, r, z * 5.4 * s) * CFrame.Angles(0, math.pi / 2, 0), TIRE, M.SmoothPlastic, CYL)
			add("Rim", Vector3.new(3.5 * s, r * 0.9, r * 0.9), CFrame.new(x, r, z * 5.4 * s) * CFrame.Angles(0, math.pi / 2, 0), RIM, M.Metal, CYL)
			for k = 0, 5 do
				add("Tread", Vector3.new(0.5 * s, 0.6 * s, 3.5 * s), CFrame.new(x, r, z * 5.4 * s) * CFrame.Angles(k * math.pi / 6, 0, 0) * CFrame.new(0, r, 0), TIRE)
			end
		end
	end
	add("Frame", Vector3.new(L * 0.8, 1.2 * s, 4 * s), CFrame.new(0, r + 0.6 * s, 0), CAGE, M.Metal)
	for _, x in ipairs({ -L * 0.32, L * 0.32 }) do
		add("Axle", Vector3.new(1, 1, 11 * s), CFrame.new(x, r, 0), CAGE, M.Metal)
		for _, z in ipairs({ -1, 1 }) do
			add("Shock", Vector3.new(0.6 * s, 3.2 * s, 0.6 * s), CFrame.new(x, r + 1.6 * s, z * 2.6 * s) * CFrame.Angles(math.rad(z * 20), 0, 0), C(255, 210, 40), M.Metal)
		end
	end
	local by = r + 3.2 * s
	add("Body", Vector3.new(L * 0.86, 2.8 * s, 9 * s), CFrame.new(0, by, 0), lk.body)
	add("Hood", Vector3.new(L * 0.3, 1 * s, 8.4 * s), CFrame.new(L * 0.26, by + 1.8 * s, 0), lk.body)
	add("Cab", Vector3.new(L * 0.3, 3.2 * s, 7.6 * s), CFrame.new(-L * 0.04, by + 2.9 * s, 0), lk.body)
	add("Windshield", Vector3.new(0.3, 2.4 * s, 6.8 * s), CFrame.new(L * 0.11 + 0.1, by + 3 * s, 0), C(50, 70, 100), M.Glass)
	add("Stripe", Vector3.new(L * 0.87, 0.6 * s, 9.1 * s), CFrame.new(0, by - 0.4 * s, 0), lk.accent)
	add("Bumper", Vector3.new(1.2 * s, 1.6 * s, 9.6 * s), CFrame.new(L * 0.44, by - 1 * s, 0), CAGE, M.Metal)
	for _, z in ipairs({ -1, 1 }) do
		add("Cage", Vector3.new(L * 0.36, 0.4 * s, 0.4 * s), CFrame.new(-L * 0.04, by + 4.7 * s, z * 3.6 * s), CAGE, M.Metal)
		add("Exhaust", Vector3.new(0.8 * s, 4 * s, 0.8 * s), CFrame.new(-L * 0.18, by + 4 * s, z * 4.2 * s), RIM, M.Metal)
		add("HeadLight", Vector3.new(0.3, 0.9 * s, 1.6 * s), CFrame.new(L * 0.43 + 0.2, by + 0.4 * s, z * 3 * s), C(255, 246, 210), M.Neon)
	end
	add("LightBar", Vector3.new(0.8 * s, 0.6 * s, 6 * s), CFrame.new(L * 0.08, by + 4.8 * s, 0), C(255, 196, 40), M.Neon)
	m:SetAttribute("Height", by + 5 * s)
	m:SetAttribute("HalfL", L / 2)
	m:SetAttribute("HalfW", 6.8 * s)
	return m
end

function SV.Build(kindName, color)
	if kindName == "train" then
		return SV.Train(color)
	elseif kindName == "plane" then
		return SV.Plane(color)
	end
	return nil
end

return SV
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9D0414B208D74C13B5C87A203C847D1A"><Properties><string name="Name">TuningConfig</string><ProtectedString name="Source">-- Tuning parts: each car has one slot per category; parts add a % to that car's income.
-- Stage 1-2 are traded at Big Tony (contracts board), Stage 3 only drops in the last districts/arenas.
local TuningConfig = {}

TuningConfig.Categories = {
	{ id = "ecu", name = "ECU", icon = "💾" },
	{ id = "boost", name = "Boost", icon = "🌀" },
	{ id = "exhaust", name = "Exhaust", icon = "💨" },
	{ id = "intake", name = "Intake", icon = "🌬️" },
	{ id = "nitro", name = "Nitro", icon = "🧪" },
	{ id = "tires", name = "Tires", icon = "🛞" },
	{ id = "aero", name = "Aero", icon = "🪽" },
}

-- family -&gt; { category, name, icon, bonus per stage }
local FAMILIES = {
	ecu = { cat = "ecu", name = "Chip Tune", icon = "💾", bonus = { 0.10, 0.20, 0.35 } },
	turbo = { cat = "boost", name = "Turbo Kit", icon = "🌀", bonus = { 0.25, 0.50, 0.90 } },
	super = { cat = "boost", name = "Supercharger", icon = "⚙️", bonus = { 0.30, 0.60, 1.00 } },
	exhaust = { cat = "exhaust", name = "Sport Exhaust", icon = "💨", bonus = { 0.08, 0.16, 0.28 } },
	intake = { cat = "intake", name = "Cold Air Intake", icon = "🌬️", bonus = { 0.06, 0.12, 0.20 } },
	nitro = { cat = "nitro", name = "Nitro Kit", icon = "🧪", bonus = { 0.12, 0.25, 0.45 } },
	tires = { cat = "tires", name = "Racing Tires", icon = "🛞", bonus = { 0.05, 0.10, 0.18 } },
	aero = { cat = "aero", name = "Aero Kit", icon = "🪽", bonus = { 0.06, 0.12, 0.22 } },
}
TuningConfig.Families = FAMILIES

TuningConfig.Items = {}
TuningConfig.Order = {}
for _, fam in ipairs({ "ecu", "turbo", "super", "exhaust", "intake", "nitro", "tires", "aero" }) do
	local F = FAMILIES[fam]
	for stage = 1, 3 do
		local id = fam .. stage
		TuningConfig.Items[id] = { id = id, family = fam, cat = F.cat, stage = stage, bonus = F.bonus[stage],
			name = F.name .. " " .. string.rep("I", stage), icon = F.icon }
		table.insert(TuningConfig.Order, id)
	end
end

-- Big Tony's exchange: parts (+ money) -&gt; tuning part. Stage 2 consumes two Stage 1 of the same family.
TuningConfig.Recipes = {
	{ out = "ecu1", parts = { bolts = 15, tire = 6 }, money = 2000 },
	{ out = "intake1", parts = { bolts = 20, tire = 4 }, money = 1500 },
	{ out = "exhaust1", parts = { bolts = 10, tire = 8 }, money = 3000 },
	{ out = "tires1", parts = { tire = 12 }, money = 2500 },
	{ out = "aero1", parts = { bolts = 25, tire = 5 }, money = 4000 },
	{ out = "nitro1", parts = { engine = 3, turbo = 1 }, money = 10000 },
	{ out = "turbo1", parts = { engine = 4, turbo = 2 }, money = 15000 },
	{ out = "super1", parts = { engine = 5, turbo = 2 }, money = 20000 },
}
do
	local stage2 = {}
	for _, r in ipairs(TuningConfig.Recipes) do
		local fam = TuningConfig.Items[r.out].family
		table.insert(stage2, { out = fam .. "2", tune = { [r.out] = 2 }, parts = { core = 1 }, money = r.money * 8 })
	end
	for _, r in ipairs(stage2) do
		table.insert(TuningConfig.Recipes, r)
	end
	for i, r in ipairs(TuningConfig.Recipes) do
		r.id = "r" .. i
	end
end
TuningConfig.RecipeById = {}
for _, r in ipairs(TuningConfig.Recipes) do
	TuningConfig.RecipeById[r.id] = r
end

-- multiplier for one car's tune table { [category] = itemId }
function TuningConfig.CarMult(tune)
	local m = 1
	if type(tune) == "table" then
		for cat, itemId in pairs(tune) do
			local it = TuningConfig.Items[itemId]
			if it and it.cat == cat then
				m = m + it.bonus
			end
		end
	end
	return m
end

return TuningConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXA993938ABE544B9E89DEE5A749BBD479"><Properties><string name="Name">WheelKit</string><ProtectedString name="Source">-- Wheel detection / repair shared by CarStoreTool (install time) and VehicleFactory (every spawn).
-- Store cars often lose their wheels (transparent collider parts, chassis scripts); this puts real-looking
-- wheels back wherever a wheel should be and nothing visible is there.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local WheelKit = {}

local NAMES = { "^fl$", "^fr$", "^rl$", "^rr$", "^lf$", "^rf$", "^lr$", "wheel", "^tire", "^tyre", "^rim" }

function WheelKit.IsWheelName(n)
	n = string.lower(n)
	for _, pat in ipairs(NAMES) do
		if string.find(n, pat) then
			return true
		end
	end
	return false
end

local function sorted(sz)
	local d = { sz.X, sz.Y, sz.Z }
	table.sort(d)
	return d
end

-- centres of wheel-like named parts (merged when close), radius from the biggest part
function WheelKit.Candidates(root)
	local out = {}
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") then
			local named = WheelKit.IsWheelName(d.Name) or (d.Parent and WheelKit.IsWheelName(d.Parent.Name))
			local dims = sorted(d.Size)
			local roundish = dims[3] &gt; 0.6 and dims[2] / dims[3] &gt; 0.8 and dims[1] &lt; dims[3] * 0.85
			if named and roundish then
				local merged = false
				for _, w in ipairs(out) do
					if (w.pos - d.Position).Magnitude &lt; math.max(w.r, dims[3] / 2) * 1.2 then
						w.r = math.max(w.r, dims[3] / 2)
						merged = true
						break
					end
				end
				if not merged then
					table.insert(out, { pos = d.Position, r = dims[3] / 2 })
				end
			end
		end
	end
	return out
end

-- 4 wheel spots from the bounding box; forward = unit vector of the long axis
function WheelKit.Guess(model, forward)
	local bb, size = model:GetBoundingBox()
	local right = forward:Cross(Vector3.yAxis).Unit
	local len = math.abs(size:Dot(Vector3.new(math.abs(forward.X), 0, math.abs(forward.Z))))
	local wid = math.abs(size:Dot(Vector3.new(math.abs(right.X), 0, math.abs(right.Z))))
	local r = math.clamp(size.Y * 0.21, 0.6, len * 0.12)
	local bottom = bb.Position.Y - size.Y / 2
	local out = {}
	for _, a in ipairs({ 0.32, -0.32 }) do
		for _, s in ipairs({ -1, 1 }) do
			local p = Vector3.new(bb.Position.X, bottom + r, bb.Position.Z) + forward * (len * a) + right * s * (wid / 2 - r * 0.42)
			table.insert(out, { pos = p, r = r })
		end
	end
	return out
end

-- is there a visible wheel-sized part around pos?
function WheelKit.HasVisibleAt(model, pos, r)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Transparency &lt; 0.9 and d.Name ~= "Root" then
			local lp = d.CFrame:PointToObjectSpace(pos)
			local h = d.Size / 2
			local m = r * 0.35
			if math.abs(lp.X) &lt;= h.X + m and math.abs(lp.Y) &lt;= h.Y + m and math.abs(lp.Z) &lt;= h.Z + m then
				local dims = sorted(d.Size)
				if dims[2] &gt;= r * 0.9 and dims[3] &lt;= r * 4 then
					return true
				end
			end
		end
	end
	return false
end

local function part(parent, name, size, cf, color, mat, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat
	if shape then
		p.Shape = shape
	end
	p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.Massless = true, false, false, false, true
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- one wheel: Blender tire (PartModels.Part_tire) if loaded, else tire + rim + 5 spokes + hub
function WheelKit.Add(model, pos, r, right)
	local folder = model:FindFirstChild("AddedWheels") or Instance.new("Model")
	folder.Name = "AddedWheels"
	folder.Parent = model
	local axis = CFrame.lookAt(pos, pos + right) * CFrame.Angles(0, math.rad(90), 0) -- part X axis = right
	local pm = ReplicatedStorage:FindFirstChild("PartModels")
	local tpl = pm and pm:FindFirstChild("Part_tire")
	if tpl then
		local w = tpl:Clone()
		local _, ext = w:GetBoundingBox()
		w:ScaleTo(w:GetScale() * (r * 2) / math.max(ext.Y, 0.01))
		-- imported Blender wheel: axle along its Z axis, pivot at the contact point
		w:PivotTo(CFrame.lookAt(pos, pos + right) * CFrame.new(0, -r, 0))
		for _, d in ipairs(w:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Name = "AddedWheel"
				d.Anchored, d.CanCollide, d.CanTouch, d.CanQuery, d.Massless = true, false, false, false, true
			end
		end
		w.Parent = folder
		return
	end
	local w = math.max(0.6, r * 0.7)
	local CYL = Enum.PartType.Cylinder
	part(folder, "AddedWheel", Vector3.new(w, r * 2, r * 2), axis, Color3.fromRGB(24, 24, 28), Enum.Material.SmoothPlastic, CYL)
	part(folder, "AddedWheel", Vector3.new(w + 0.04, r * 1.32, r * 1.32), axis, Color3.fromRGB(196, 200, 208), Enum.Material.Metal, CYL)
	part(folder, "AddedWheel", Vector3.new(w + 0.08, r * 1.1, r * 1.1), axis, Color3.fromRGB(40, 42, 48), Enum.Material.Metal, CYL)
	for k = 0, 4 do -- spokes poke out of the dark dish on both faces
		local a = k / 5 * math.pi * 2
		part(folder, "AddedWheel", Vector3.new(w + 0.12, r * 0.6, r * 0.14), axis * CFrame.Angles(a, 0, 0) * CFrame.new(0, r * 0.33, 0),
			Color3.fromRGB(210, 214, 222), Enum.Material.Metal)
	end
	part(folder, "AddedWheel", Vector3.new(w + 0.16, r * 0.42, r * 0.42), axis, Color3.fromRGB(70, 72, 80), Enum.Material.Metal, CYL)
end

-- fills every empty wheel spot; spots = { {pos, r} } or nil (guessed). Returns how many were added.
function WheelKit.Ensure(model, forward, spots)
	local right = forward:Cross(Vector3.yAxis).Unit
	spots = (spots and #spots &gt;= 3) and spots or WheelKit.Guess(model, forward)
	local added = 0
	for _, w in ipairs(spots) do
		if not WheelKit.HasVisibleAt(model, w.pos, w.r) then
			WheelKit.Add(model, w.pos, w.r, right)
			added = added + 1
		end
	end
	return added
end

-- wheel spots are saved on the template relative to its bounding-box centre
function WheelKit.Save(model, spots)
	local bb = model:GetBoundingBox()
	local t = {}
	for _, w in ipairs(spots) do
		local o = w.pos - bb.Position
		table.insert(t, { o.X, o.Y, o.Z, w.r })
	end
	model:SetAttribute("Wheels", HttpService:JSONEncode(t))
end

function WheelKit.Load(model, scale)
	local raw = model:GetAttribute("Wheels")
	if type(raw) ~= "string" then
		return nil
	end
	local ok, t = pcall(HttpService.JSONDecode, HttpService, raw)
	if not ok or type(t) ~= "table" then
		return nil
	end
	local bb = model:GetBoundingBox()
	local out = {}
	for _, w in ipairs(t) do
		table.insert(out, { pos = bb.Position + Vector3.new(w[1], w[2], w[3]) * scale, r = w[4] * scale })
	end
	return out
end

return WheelKit
