Tool.MaxParts = 450

local KEEP = { "BasePart", "Model", "Folder", "DataModelMesh", "Decal", "Texture", "SurfaceAppearance" }

local function keep(inst)
	for _, class in ipairs(KEEP) do
		if inst:IsA(class) then
			return true
		end
	end
	return false
end

-- assets embedded into the place by tools/bake_models.luau: ServerStorage.Embedded.Assets.A&lt;id&gt;
local function embedded(id)
	local e = game:GetService("ServerStorage"):FindFirstChild("Embedded")
	local a = e and e:FindFirstChild("Assets")
	return a and a:FindFirstChild("A" .. tostring(id))
end
Tool.Embedded = embedded

local function load(id)
	local emb = embedded(id)
	if emb then
		local out = {}
		for _, c in ipairs(emb:GetChildren()) do
			table.insert(out, c:Clone())
		end
		if #out &gt; 0 then
			return out
		end
	end
	local ok, res = pcall(function()
		return game:GetObjects("rbxassetid://" .. id)
	end)
	if ok and res and #res &gt; 0 then
		return res
	end
	local ok2, res2 = pcall(function()
		return InsertService:LoadAsset(id)
	end)
	if ok2 and res2 then
		return res2:GetChildren()
	end
	return nil, tostring(ok and res2 or res)
end

-- the car = top-level model that contains a VehicleSeat; otherwise everything that was loaded
local function pickCar(objs)
	local holder = Instance.new("Model")
	for _, o in ipairs(objs) do
		o.Parent = holder
	end
	local seat = holder:FindFirstChildWhichIsA("VehicleSeat", true)
	local car = holder
	if seat then
		local top = seat
		while top.Parent ~= holder do
			top = top.Parent
		end
		if top:IsA("Model") then
			car = top
		end
	end
	return car, seat, holder
end

local function hasVisibleDescendant(d)
	for _, x in ipairs(d:GetDescendants()) do
		if x:IsA("BasePart") and x.Transparency &lt; 0.99 then
			return true
		end
	end
	return false
end

-- keeps only what is drawn. An invisible part that carries visible parts (A-Chassis wheel hubs: Wheels/FL holds
-- the real tire + rim meshes) stays as an invisible holder - deleting it used to delete the real wheels.
-- Hidden parts are never made visible again (they are alternative rim sets, airbags, colliders).
local function sanitize(car)
	local parts = 0
	for _, d in ipairs(car:GetDescendants()) do
		if not keep(d) then
			d:Destroy()
		end
	end
	for _, d in ipairs(car:GetDescendants()) do
		if d:IsA("BasePart") and d.Parent then
			local hidden = d.Transparency &gt;= 0.99 and not d:FindFirstChildWhichIsA("Decal")
			if hidden and not hasVisibleDescendant(d) then
				d:Destroy() -- hitboxes, colliders, seat blocks, hidden alternative wheel sets
			else
				if hidden then
					d.Transparency = 1
				else
					parts = parts + 1
				end
				d.Anchored = true
				d.CanCollide = false
				d.CanTouch = false
				d.CanQuery = false
				d.Massless = true
				if d:IsA("Seat") or d:IsA("VehicleSeat") then
					d.Disabled = true
				end
			end
		end
	end
	return parts
end

-- the car's OWN wheels (same rules as tools/wheel_report.luau). Returns source, count:
--   "achassis": Wheels/&lt;FL,FR,RL,RR&gt; hubs with visible wheel meshes inside
--   "named":    visible parts called wheel/tire/tyre/rim (no steering wheels, airbags, spares), grouped by position
--   "baked":    no separate wheel parts - the wheels are part of the body mesh
local EXCLUDE = { "steer", "airbag", "spare", "detector", "hitbox", "collider" }
local function wheelName(n)
	n = string.lower(n)
	for _, x in ipairs(EXCLUDE) do
		if string.find(n, x, 1, true) then
			return false
		end
	end
	return string.find(n, "wheel", 1, true) or string.find(n, "tire", 1, true) or string.find(n, "tyre", 1, true)
		or string.find(n, "rim", 1, true) or string.find(n, "llanta", 1, true) or string.find(n, "_whl", 1, true)
end

function Tool.DetectWheels(car)
	local wheels = car:FindFirstChild("Wheels", true)
	if wheels and (wheels:IsA("Model") or wheels:IsA("Folder")) then
		local n = 0
		for _, c in ipairs(wheels:GetChildren()) do
			if (c:IsA("BasePart") and c.Transparency &lt; 0.99) or hasVisibleDescendant(c) then
				n = n + 1
			end
		end
		return "achassis", n
	end
	local clusters = {}
	for _, d in ipairs(car:GetDescendants()) do
		if d:IsA("BasePart") and d.Transparency &lt; 0.99 and (wheelName(d.Name) or (d.Parent and wheelName(d.Parent.Name))) then
			local found = false
			for _, c in ipairs(clusters) do
				if (c - d.Position).Magnitude &lt; 2.5 then
					found = true
					break
				end
			end
			if not found then
				table.insert(clusters, d.Position)
			end
		end
	end
	if #clusters &gt;= 3 then
		return "named", #clusters
	end
	-- unnamed wheel meshes: disc-shaped visible parts (two equal sides, one thin) in the lower half of the car
	local cf, size = car:GetBoundingBox()
	local bottom = cf.Position.Y - size.Y / 2
	local discs = 0
	for _, d in ipairs(car:GetDescendants()) do
		if d:IsA("BasePart") and d.Transparency &lt; 0.99 then
			local x, y, z = d.Size.X, d.Size.Y, d.Size.Z
			local a, b, c = math.max(x, y, z), math.min(x, y, z), x + y + z - math.max(x, y, z) - math.min(x, y, z)
			if a &gt;= 1.2 and a &lt;= 6 and c / a &gt; 0.9 and b / a &lt; 0.6 and d.Position.Y &lt; bottom + size.Y * 0.5 then
				discs = discs + 1
			end
		end
	end
	if discs &gt;= 4 then
		return "mesh", discs
	end
	return "baked", 0 -- one-piece body mesh (wheels modelled into it)
end

---------------------------------------------------------------- wheels (see Shared/WheelKit.lua)
local function ensureWheels(car, forward, known)
	return WheelKit.Ensure(car, forward, known)
end

local function flat(v)
	local f = Vector3.new(v.X, 0, v.Z)
	return f.Magnitude &gt; 0.01 and f.Unit or Vector3.new(0, 0, -1)
end

-- rotate so the nose points to -Z (VehicleFactory then maps the long axis to +X)
local function normalize(car, forward)
	car.PrimaryPart = nil
	local bb = car:GetBoundingBox()
	car.WorldPivot = CFrame.lookAt(bb.Position, bb.Position + forward)
	car:PivotTo(CFrame.new(0, 20, 0))
	local _, size = car:GetBoundingBox()
	return size
end

function Tool.Install(carId, assetId, yaw)
	local def = CarConfig.ById[carId]
	if not def then
		warn("[CarStore] unknown car id: " .. tostring(carId))
		return false
	end
	local objs, err = load(assetId)
	if not objs then
		warn(string.format("[CarStore] %s: asset %s did not load (%s)", carId, tostring(assetId), tostring(err)))
		return false
	end
	local car, seat, holder = pickCar(objs)
	local forward = seat and flat(seat.CFrame.LookVector) or Vector3.new(0, 0, -1)
	-- wheels kept in a sibling model (outside the seat's model) belong to the car too
	if holder ~= car then
		for _, o in ipairs(holder:GetChildren()) do
			if o ~= car and (o.Name == "Wheels" or wheelName(o.Name)) then
				o.Parent = car
			end
		end
	end
	local parts = sanitize(car)
	if parts == 0 then
		holder:Destroy()
		warn(string.format("[CarStore] %s: asset %s has no visible parts", carId, tostring(assetId)))
		return false
	end
	local size = normalize(car, forward)
	if not seat and size.X &gt; size.Z then -- no seat to tell the direction: at least align the long axis
		normalize(car, Vector3.new(1, 0, 0))
		_, size = car:GetBoundingBox()
	end
	-- only the model's own wheels: nothing is guessed or added (that made duplicates and wrong sizes)
	local wheelSource, wheelCount = Tool.DetectWheels(car)
	if wheelSource == "baked" then
		-- the model is drawn without separate wheel parts: fine for one-piece meshes, but say so in Output
		warn(string.format("[CarStore] %s: asset %s has no separate wheel parts (one-piece mesh) - check it with CarModelTool.Preview()", carId, tostring(assetId)))
	end
	if wheelSource == "achassis" and wheelCount &lt; 4 then
		holder:Destroy()
		warn(string.format("[CarStore] %s: asset %s rejected (only %d of 4 wheels)", carId, tostring(assetId), wheelCount))
		return false
	end
	local len, wid = size.Z, size.X
	if len / math.max(wid, 0.1) &lt; 1.4 or len / math.max(wid, 0.1) &gt; 4.5 or len / math.max(size.Y, 0.1) &lt; 1.5 or parts &gt; Tool.MaxParts then
		holder:Destroy()
		warn(string.format("[CarStore] %s: asset %s rejected (%.0fx%.0fx%.0f studs, %d parts)", carId, tostring(assetId), len, wid, size.Y, parts))
		return false
	end
	local root = ReplicatedStorage:FindFirstChild("CarModels")
	if not root then
		root = Instance.new("Folder")
		root.Name = "CarModels"
		root.Parent = ReplicatedStorage
	end
	local old = root:FindFirstChild(carId)
	if old then
		old:Destroy()
	end
	car.Name = carId
	car:SetAttribute("Yaw", yaw or 0)
	car:SetAttribute("Recolor", false)
	car:SetAttribute("CarName", def.name)
	car:SetAttribute("Rarity", def.rarity)
	car:SetAttribute("StoreAssetId", tostring(assetId))
	car:SetAttribute("NoWheelFix", true) -- VehicleFactory must not add wheels: the model has its own
	car:SetAttribute("WheelSource", wheelSource)
	car:SetAttribute("WheelCount", wheelCount)
	car.Parent = root
	if holder ~= car then
		holder:Destroy()
	end
	print(string.format("[CarStore] %-22s &lt;- asset %s  (%d parts, own wheels: %s %d)", carId, tostring(assetId), parts, wheelSource, wheelCount))
	return true
end

local running = false

-- runs in the background: the Command Bar returns at once, progress is printed to Output
function Tool.InstallAll()
	if running then
		print("[CarStore] already running, watch the Output window")
		return
	end
	running = true
	print("[CarStore] started in background - this takes a few minutes, progress is in Output. Do not stop the play/edit session.")
	task.spawn(function()
		local ok, err = pcall(Tool.InstallAllNow)
		running = false
		if not ok then
			warn("[CarStore] failed: " .. tostring(err))
		end
	end)
end

-- server start: every car that has no model yet is installed from the assets embedded in the place
-- (no downloads, works in an unpublished place and in the live game)
function Tool.InstallMissingEmbedded()
	local root = ReplicatedStorage:FindFirstChild("CarModels")
	local done = 0
	for _, def in ipairs(CarConfig.List) do
		local cur = root and root:FindFirstChild(def.id)
		if not (cur and cur:FindFirstChildWhichIsA("BasePart", true)) then
			for _, id in ipairs(Tool.Candidates[def.id] or {}) do
				if embedded(id) and Tool.Install(def.id, id) then
					done = done + 1
					break
				end
			end
			task.wait() -- big models: yield between cars so the server start never hits the script timeout
		end
	end
	return done
end

function Tool.InstallAllNow()
	local done, failed = 0, {}
	for _, def in ipairs(CarConfig.List) do
		local ok = false
		for _, id in ipairs(Tool.Candidates[def.id] or {}) do
			ok = Tool.Install(def.id, id)
			if ok then
				break
			end
		end
		if ok then
			done = done + 1
		else
			table.insert(failed, def.id)
		end
		task.wait()
	end
	print(string.format("[CarStore] installed %d/%d store models", done, #CarConfig.List))
	if #failed &gt; 0 then
		print("[CarStore] kept the previous model for: " .. table.concat(failed, ", "))
	end
	print("[CarStore] check them: require(game.ServerStorage.Tools.CarModelTool).Preview()  - nose must point along +X.")
	print("[CarStore] wrong way round? require(game.ServerStorage.Tools.CarStoreTool).Flip('car_id')")
end

-- repair wheels on models that are already installed (store or Blender)
function Tool.FixWheels()
	local root = ReplicatedStorage:FindFirstChild("CarModels")
	if not root then
		return
	end
	local fixed = 0
	for _, m in ipairs(root:GetChildren()) do
		if m:IsA("Model") and CarConfig.ById[m.Name] then
			local old = m:FindFirstChild("AddedWheels")
			if old then
				old:Destroy()
			end
			if m:GetAttribute("NoWheelFix") then
				continue -- store model with its own wheels: never add a second set
			end
			local _, size = m:GetBoundingBox()
			local yaw = math.rad(m:GetAttribute("Yaw") or 0)
			local fwd = size.Z &gt;= size.X and Vector3.new(0, 0, -1) or Vector3.new(1, 0, 0)
			fwd = (CFrame.Angles(0, yaw, 0) * CFrame.new(fwd)).Position
			local n = ensureWheels(m, flat(fwd), WheelKit.Load(m, 1))
			if n &gt; 0 then
				fixed = fixed + 1
				print(string.format("[CarStore] %s: rebuilt %d wheels", m.Name, n))
			end
		end
	end
	print(string.format("[CarStore] FixWheels done, %d models repaired", fixed))
end

-- how many wheels each installed car shows (real + rebuilt)
function Tool.WheelReport()
	local root = ReplicatedStorage:FindFirstChild("CarModels")
	for _, m in ipairs(root and root:GetChildren() or {}) do
		if m:IsA("Model") and CarConfig.ById[m.Name] then
			local src, n = Tool.DetectWheels(m)
			local added = m:FindFirstChild("AddedWheels") and #m.AddedWheels:GetChildren() or 0
			print(string.format("[CarStore] %-22s own wheels: %s %d, added wheel parts %d", m.Name, src, n, added))
		end
	end
end

function Tool.Flip(carId)
	local root = ReplicatedStorage:FindFirstChild("CarModels")
	local m = root and root:FindFirstChild(carId)
	if m then
		m:SetAttribute("Yaw", ((m:GetAttribute("Yaw") or 0) + 180) % 360)
		print("[CarStore] " .. carId .. " Yaw = " .. m:GetAttribute("Yaw"))
	end
end

return Tool
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX1F716D5F591048B4B1CE3DE468188EF3"><Properties><string name="Name">ModelPreview</string><ProtectedString name="Source">-- Studio edit-mode preview: load the uploaded Blender models and build the whole map, to look around without Play.
--   require(game.ServerStorage.Tools.ModelPreview).Run()
-- Do NOT save the place afterwards if you want the server to rebuild the map itself (it rebuilds anyway when the
-- saved map is older than MapConfig.Version). Clear(): removes the preview map.
local Workspace = game:GetService("Workspace")
local ServerScriptService = game:GetService("ServerScriptService")

local Preview = {}

function Preview.Run()
	task.spawn(function()
		local n = require(ServerScriptService.Services.ModelService).LoadAll()
		print("[Preview] models loaded:", n)
		require(script.Parent.BuildCityMap).Build()
	end)
end

function Preview.Clear()
	local m = Workspace:FindFirstChild("GeneratedMap")
	if m then
		m:Destroy()
	end
end

return Preview
</ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX54"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX53"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX45"><Properties><string name="Name">ClientController</string><ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Strings = require(Shared:WaitForChild("Strings"))
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local BaseLayout = require(Shared:WaitForChild("BaseLayout"))
local Util = require(Shared:WaitForChild("Util"))

local Client = script.Parent:WaitForChild("Client")
local Store = require(Client:WaitForChild("StateStore"))
local UI = require(Client:WaitForChild("UI"))
local TrafficRenderer = require(Client:WaitForChild("TrafficRenderer"))
local TrapFx = require(Client:WaitForChild("TrapFx"))
local WorldFx = require(Client:WaitForChild("WorldFx"))
local Guidance = require(Client:WaitForChild("Guidance"))
local CineFx = require(Client:WaitForChild("CineFx"))
local DeathFx = require(Client:WaitForChild("DeathFx"))
local SpeedLanes = require(Client:WaitForChild("SpeedLanes"))
local UIExtra = require(Client:WaitForChild("UIExtra"))
local Markers = require(Client:WaitForChild("Markers"))
local ClientFx = require(Client:WaitForChild("ClientFx"))
local GaragePrompts = require(Client:WaitForChild("GaragePrompts"))
local ZoneFx = require(Client:WaitForChild("ZoneFx"))
local BossFx = require(Client:WaitForChild("BossFx"))
local BatchReveal = require(Client:WaitForChild("BatchReveal"))
local Settings = require(Client:WaitForChild("Settings"))
local Backpack = require(Client:WaitForChild("Backpack"))
local IntroFx = require(Client:WaitForChild("IntroFx"))
local Checkpoint = require(Client:WaitForChild("Checkpoint"))
local Tutorial = require(Client:WaitForChild("Tutorial"))
local Rewards = require(Client:WaitForChild("Rewards"))
local Trade = require(Client:WaitForChild("Trade"))

local player = Players.LocalPlayer
-- keep the camera close: no flying out over the map edge
player.CameraMaxZoomDistance = 45
player.CameraMinZoomDistance = 6
Strings.SetLocale(player.LocaleId)

local actions = {
	ThrowBatch = function(counts, merge) Net.Get("ThrowBatch"):FireServer(counts, merge) end,
	Place = function(uid, slot) Net.Get("PlaceCar"):FireServer(uid, slot) end,
	Remove = function(uid) Net.Get("RemoveCar"):FireServer(uid) end,
	Upgrade = function(uid, level) Net.Get("UpgradeCar"):FireServer(uid, level) end,
	BuySlot = function(count) Net.Get("BuySlot"):FireServer(count) end,
	BuyFloor = function(floors) Net.Get("BuyFloor"):FireServer(floors) end,
	Unlock = function(zoneId) Net.Get("UnlockZone"):FireServer(zoneId) end,
	Sell = function(uid) Net.Get("SellCar"):FireServer(uid) end,
	SellMany = function(uids) Net.Get("SellCars"):FireServer(uids) end,
	AutoPark = function() Net.Get("AutoPark"):FireServer() end,
	BuyPerk = function(id) Net.Get("BuyPerk"):FireServer(id) end,
	Donate = function(id) Net.Get("Donate"):FireServer(id) end,
	Claim = function(id) Net.Get("ClaimContract"):FireServer(id) end,
	Craft = function(id) Net.Get("CraftTuning"):FireServer(id) end,
	Tune = function(uid, cat, item) Net.Get("TuneCar"):FireServer(uid, cat, item) end,
	Rebirth = function() Net.Get("Rebirth"):FireServer() end,
	SetSkin = function(id) Net.Get("SetSkin"):FireServer(id) end,
	TokenPerk = function(id) Net.Get("TokenPerk"):FireServer(id) end,
	Teleport = function(dest)
		UI.Sfx("whoosh")
		CineFx.Flash(Color3.fromRGB(46, 168, 255), 0.2, 0.5)
		CineFx.Zoom(95, 0.12)
		task.delay(0.15, function() CineFx.Zoom(70, 0.4) end)
		Net.Get("Teleport"):FireServer(dest)
	end,
}

UI.Init(Store, actions)
CineFx.Init(UI.Gui())
TrapFx.SetSfx(UI.Sfx)
TrapFx.SetReveal(UI.ShowReveal, UI.HideReveal)
TrapFx.SetCinematic(UI.SetCinematic)
WorldFx.Start(Store)
TrafficRenderer.Start()
Guidance.Start()
SpeedLanes.Start(function()
	return Store.State and Store.State.walkSpeed or MapConfig.WalkSpeed
end)
UIExtra.Init(UI)
ZoneFx.Start()
BossFx.Start(UI, CineFx)
BatchReveal.Start(UI, CineFx, TrapFx)
Checkpoint.Start(UI, CineFx)
Tutorial.Start(UI, CineFx, Guidance)
Rewards.Start(UI)
Settings.Start(UI)
Trade.Start(UI)
Backpack.Start(UI)
IntroFx.Start(UI, CineFx)
ClientFx.Init(UI)
Markers.Start(UI.Kit(), UIExtra)
GaragePrompts.Start(UI.Kit(), CineFx)
UI.Refresh()

Net.Get("HotDrop").OnClientEvent:Connect(function(info) UIExtra.OnHotDrop(info) end)
Net.Get("PickupFx").OnClientEvent:Connect(function(info) ClientFx.Pickup(info) end)
Net.Get("BankFx").OnClientEvent:Connect(function(info) ClientFx.Bank(info) end)
Net.Get("DonateFx").OnClientEvent:Connect(function(buyer, key) ClientFx.Donate(buyer, key) end)

Net.Get("StateUpdate").OnClientEvent:Connect(function(state) Store.Set(state) end)
Net.Get("MoneySync").OnClientEvent:Connect(function(m, inc, val) Store.SetMoney(m, inc, val) end)
Net.Get("Notify").OnClientEvent:Connect(function(payload)
	if payload and (payload.key == "lost" or payload.key == "picked" or payload.key == "banked2" or payload.key == "banked") then
		return -- shown by the WRECKED screen
	end
	UI.Notify(payload)
end)
local deathHeld = false
Net.Get("HitFx").OnClientEvent:Connect(function(dir, kind)
	if kind == "airbag" then
		ClientFx.Airbag(dir or Vector3.new(1, 0, 0))
		return
	end
	local lost = Store.State and Util.CopyTable(Store.State.carried) or {}
	TrapFx.Abort()
	BatchReveal.Close()
	UI.TogglePanel(nil)
	UI.CloseOverlays()
	UI.HideReveal()
	if not deathHeld then -- the WRECKED screen hides the HUD like any cinematic; released on respawn
		deathHeld = true
		UI.SetCinematic(true)
	end
	DeathFx.Play(dir or Vector3.new(1, 0, 0), lost, UI.Sfx)
end)
Net.Get("ThrowResult").OnClientEvent:Connect(function(res)
	local idx = Store.State and Store.State.baseIndex
	TrapFx.Play(res, idx)
end)
player.CharacterAdded:Connect(function()
	DeathFx.Recover()
	if deathHeld then
		deathHeld = false
		UI.SetCinematic(false)
	end
end)

task.spawn(function()
	while true do
		task.wait(0.2)
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local st = Store.State
		if hrp then
			UI.SetZoneName(MapConfig.ZoneAt(hrp.Position.Z))
			local near = false
			if st and st.baseIndex then
				local trap = BaseLayout.ToWorld(st.baseIndex, BaseLayout.TrapLocal)
				near = Vector3.new(hrp.Position.X - trap.X, 0, hrp.Position.Z - trap.Z).Magnitude &lt;= 35
			end
			UI.SetNearTrap(near and not CineFx.IsScripted())
		end
	end
end)
</ProtectedString></Properties></Item><Item class="Folder" referent="RBX52"><Properties><string name="Name">Client</string></Properties><Item class="ModuleScript" referent="RBX46"><Properties><string name="Name">Guidance</string><ProtectedString name="Source">-- Guide beam from the player to the current objective (set by Tutorial), plus a bobbing marker over the target.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Guidance = {}
local beam, att0, att1, marker
local target -- BasePart or Vector3

local function ensure(hrp)
	if not beam or not beam.Parent or att0.Parent ~= hrp then
		if beam then
			beam:Destroy()
		end
		att0 = Instance.new("Attachment")
		att0.Name = "GuideA"
		att0.Position = Vector3.new(0, -2, 0)
		att0.Parent = hrp
		beam = Instance.new("Beam")
		beam.Name = "GuideBeam"
		beam.Width0, beam.Width1 = 0.9, 0.9
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.Color = ColorSequence.new(Color3.fromRGB(255, 220, 60))
		beam.Transparency = NumberSequence.new(0.2)
		beam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		beam.TextureMode = Enum.TextureMode.Static
		beam.TextureLength = 4
		beam.TextureSpeed = 2
		beam.Segments = 1
		beam.Attachment0 = att0
		beam.Parent = hrp
	end
	if not marker then
		marker = Instance.new("Part")
		marker.Name = "GuideMarker"
		marker.Anchored, marker.CanCollide, marker.CanQuery, marker.CanTouch = true, false, false, false
		marker.Transparency = 1
		marker.Size = Vector3.one
		att1 = Instance.new("Attachment")
		att1.Parent = marker
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.fromOffset(60, 60)
		bb.AlwaysOnTop = true
		bb.LightInfluence = 0
		bb.Parent = marker
		local arrow = Instance.new("TextLabel")
		arrow.Size = UDim2.fromScale(1, 1)
		arrow.BackgroundTransparency = 1
		arrow.Text = "V"
		arrow.Font = Enum.Font.LuckiestGuy
		arrow.TextScaled = true
		arrow.TextColor3 = Color3.fromRGB(255, 210, 63)
		local st = Instance.new("UIStroke")
		st.Thickness = 3
		st.Parent = arrow
		arrow.Parent = bb
		marker.Parent = workspace
	end
	beam.Attachment1 = att1
end

-- target: BasePart, Vector3 or nil (off)
function Guidance.Point(t)
	target = t
end

function Guidance.Start()
	RunService.Heartbeat:Connect(function()
		local char = Players.LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local pos = target and (typeof(target) == "Vector3" and target or (target.Parent and target.Position))
		if Players.LocalPlayer:GetAttribute("Opt_guide") == false or Players.LocalPlayer:GetAttribute("Cinematic") then
			pos = nil -- Settings: guidance beam off
		end
		if not hrp or not pos then
			if beam then
				beam.Enabled = false
			end
			if marker then
				marker.Parent = nil
			end
			return
		end
		ensure(hrp)
		marker.Parent = workspace
		marker.Position = pos + Vector3.new(0, 7 + math.sin(os.clock() * 4) * 0.8, 0)
		beam.Enabled = (hrp.Position - pos).Magnitude &gt; 12
	end)
end

return Guidance
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX47"><Properties><string name="Name">StateStore</string><ProtectedString name="Source">local Store = {}

Store.State = nil
Store.Money = 0
Store.Income = 0
Store.CollectionValue = 0
Store.Changed = Instance.new("BindableEvent")
Store.MoneyChanged = Instance.new("BindableEvent")

function Store.Set(state)
	Store.State = state
	Store.Money = state.money
	Store.Income = state.income or 0
	Store.CollectionValue = state.collectionValue or 0
	Store.Changed:Fire()
end

function Store.SetMoney(money, income, value)
	Store.Money = money
	Store.Income = income
	Store.CollectionValue = value or Store.CollectionValue
	if Store.State then
		Store.State.money = money
		Store.State.income = income
	end
	Store.MoneyChanged:Fire()
end

function Store.Banked(partId)
	return Store.State and Store.State.parts[partId] or 0
end

function Store.Carried(partId)
	return Store.State and Store.State.carried[partId] or 0
end

function Store.CarriedTotal()
	local n = 0
	if Store.State then
		for _, v in pairs(Store.State.carried) do
			n = n + v
		end
	end
	return n
end

function Store.BankedTotal()
	local n = 0
	if Store.State then
		for _, v in pairs(Store.State.parts) do
			n = n + v
		end
	end
	return n
end

return Store
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX48"><Properties><string name="Name">TrafficRenderer</string><ProtectedString name="Source">local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local TrafficMath = require(Shared:WaitForChild("TrafficMath"))
local VehicleFactory = require(Shared:WaitForChild("VehicleFactory"))
local VehicleKinds = require(Shared:WaitForChild("VehicleKinds"))
local Net = require(Shared:WaitForChild("Net"))
local Players = game:GetService("Players")

local Renderer = {}
local pools = {}
local ACTIVE_DIST = 380
local lastReport = 0

function Renderer.Start()
	local folder = Workspace:WaitForChild("RuntimeTraffic")
	local flip = CFrame.Angles(0, math.pi, 0)
	RunService.RenderStepped:Connect(function()
		local cam = Workspace.CurrentCamera
		if not cam then
			return
		end
		local camZ = cam.CFrame.Position.Z
		local t = Workspace:GetServerTimeNow()
		for ri, road in ipairs(MapConfig.Roads) do
			local active = math.abs(camZ - road.z) &lt; ACTIVE_DIST
			for _, lane in ipairs(TrafficMath.RoadLanes[ri]) do
				local pool = pools[lane.index]
				if active then
					if not pool then
						pool = { models = {}, shown = false }
						for k = 1, lane.count do
							pool.models[k] = VehicleFactory.BuildTraffic(lane.kinds[k], MapConfig.TrafficColors[lane.colors[k]], lane.colors[k])
						end
						pools[lane.index] = pool
					end
					if not pool.shown then
						pool.shown = true
						for k, m in ipairs(pool.models) do
							m:PivotTo(CFrame.new(0, -500, 0))
							m.Parent = folder
						end
					end
					for k, m in ipairs(pool.models) do
						local x = TrafficMath.CarX(lane, k, t)
						local cf = CFrame.new(x, MapConfig.RoadTopY, TrafficMath.CarZ(lane, k, t))
						if lane.dir &lt; 0 then
							cf = cf * flip
						end
						if lane.weaveA then
							local dz = lane.weaveA * lane.weaveW * math.cos(lane.weaveW * t + lane.weavePh[k])
							cf = cf * CFrame.Angles(0, -math.atan2(dz, lane.speed) * lane.dir, 0)
						end
						m.PrimaryPart.CFrame = cf
					end
				elseif pool and pool.shown then
					pool.shown = false
					for _, m in ipairs(pool.models) do
						m.Parent = nil
					end
				end
			end
		end
		-- local hit check against exactly what this player sees
		local char = Players.LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hrp and hum and hum.Health &gt; 0 and os.clock() - lastReport &gt; 0.5 then
			local pos = hrp.Position
			local ri = TrafficMath.RoadAtZ(pos.Z, 3)
			if ri then
				for _, lane in ipairs(TrafficMath.RoadLanes[ri]) do
					for k = 1, lane.count do
						local kind = VehicleKinds[lane.kinds[k]]
						local dz = math.abs(pos.Z - TrafficMath.CarZ(lane, k, t))
						if dz &lt;= kind.W / 2 + 1 and math.abs(pos.X - TrafficMath.CarX(lane, k, t)) &lt;= kind.L / 2 + 1 and pos.Y &lt; MapConfig.RoadTopY + kind.H + 2.5 then
							lastReport = os.clock()
							Net.Get("TrafficHit"):FireServer()
							return
						end
					end
				end
			end
		end
	end)
end

return Renderer
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX49"><Properties><string name="Name">TrapFx</string><ProtectedString name="Source">-- Throw + car reveal cinematic on the garage car lift. Visual only: the server already decided the result.
-- No transparent neon geometry: light comes from PointLights/SpotLights, sparks/dust from particle emitters,
-- the rarity colour from a Highlight outline, punch from ColorCorrection/Bloom/DepthOfField.
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local BaseLayout = require(Shared:WaitForChild("BaseLayout"))
local VehicleFactory = require(Shared:WaitForChild("VehicleFactory"))
local PartVisual = require(Shared:WaitForChild("PartVisual"))
local Cine = require(script.Parent:WaitForChild("CineFx"))

local TrapFx = {}
local sfx
local SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local function play(name)
	if sfx then
		sfx(name)
	end
end

-- showcase hooks set by the controller: Reveal(res, onClosed), HideReveal()
function TrapFx.SetReveal(show, hide)
	TrapFx.Reveal, TrapFx.HideReveal = show, hide
end

function TrapFx.SetSfx(fn)
	sfx = fn
end

-- cinematic mode hook (UI.SetCinematic): hides the HUD, closes panels, blocks prompts + movement
local cinema = function() end
function TrapFx.SetCinematic(fn)
	cinema = fn
end

local function tw(o, t, props, style, dir)
	local x = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	x:Play()
	return x
end

local function anchor(cf)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Transparency = 1
	p.Size = Vector3.one
	p.CFrame = typeof(cf) == "CFrame" and cf or CFrame.new(cf)
	p.Parent = Workspace
	return p
end

local function emitter(parent, o)
	local e = Instance.new("ParticleEmitter")
	e.Texture = o.texture or SPARK
	e.Color = ColorSequence.new(o.c1, o.c2 or o.c1)
	e.LightEmission = o.light or 0.5
	e.Size = NumberSequence.new(o.s1 or 0.6, o.s2 or 0)
	e.Transparency = NumberSequence.new(o.t1 or 0, 1)
	e.Lifetime = NumberRange.new(o.life or 0.6, (o.life or 0.6) * 1.5)
	e.Speed = NumberRange.new(o.speed or 10, (o.speed or 10) * 1.6)
	e.SpreadAngle = o.spread or Vector2.new(180, 180)
	e.Acceleration = o.acc or Vector3.zero
	e.Drag = o.drag or 3
	e.Rate = o.rate or 0
	e.ZOffset = 1
	e.Parent = parent
	return e
end

local function burst(pos, o, count)
	local a = anchor(pos)
	local e = emitter(a, o)
	e:Emit(count)
	task.delay(3, function()
		a:Destroy()
	end)
end

-- dust ring flat on the floor
local function dustRing(pos, color, count)
	local a = anchor(CFrame.new(pos))
	local e = emitter(a, { texture = SMOKE, c1 = color, s1 = 1.8, s2 = 4.5, t1 = 0.35, life = 0.9, speed = 18, spread = Vector2.new(0, 180), drag = 6, light = 0 })
	e.EmissionDirection = Enum.NormalId.Front
	e.Orientation = Enum.ParticleOrientation.FacingCamera
	a.CFrame = CFrame.new(pos) * CFrame.Angles(math.pi / 2, 0, 0)
	e:Emit(count)
	task.delay(2.5, function()
		a:Destroy()
	end)
end

local function findBase(idx)
	local map = Workspace:FindFirstChild("GeneratedMap")
	local bases = map and map:FindFirstChild("Bases")
	return bases and bases:FindFirstChild(string.format("Base%02d", idx), true)
end

local function faceCF(pos, dir)
	return CFrame.new(pos) * CFrame.Angles(0, math.atan2(-dir.Z, dir.X), 0)
end

-- smooth camera: every frame the camera eases toward camTarget
local camTarget, camConn, camCur
local function camStart(cam)
	camTarget = cam.CFrame
	camCur = cam.CFrame
	camConn = RunService.RenderStepped:Connect(function(dt)
		camCur = camCur:Lerp(camTarget, 1 - math.exp(-dt * 5))
		cam.CFrame = camCur
	end)
end
-- jump cut (used while the screen is black)
local function camSnap(cf)
	camTarget, camCur = cf, cf
end
local function camStop()
	if camConn then
		camConn:Disconnect()
		camConn = nil
	end
end

local function effect(class, props)
	local e = Instance.new(class)
	for k, v in pairs(props) do
		e[k] = v
	end
	e.Parent = Lighting
	return e
end

-- one cinematic at a time: later ones wait in a queue (e.g. "SEE BEST CAR" pressed during another reveal)
local busy, queue = false, {}
local current -- ctx of the running cinematic

local function check(ctx)
	if ctx.aborted then
		error("aborted", 0)
	end
end

local function body(res, baseIndex, ctx)
		local def = CarConfig.ById[res.typeId]
		if not def or not baseIndex then
			if def and TrapFx.Reveal then
				local shown = false
				TrapFx.Reveal(res, function()
					shown = true
				end)
				local w0 = os.clock()
				while not shown and os.clock() - w0 &lt; 15 do
					task.wait(0.05)
				end
				if not shown and TrapFx.HideReveal then
					TrapFx.HideReveal()
				end
			end
			return
		end
		local k = 1 / math.max(1, res.speed or 1) -- fast trap pass halves every beat
		local function wait(t)
			task.wait(t * k)
			check(ctx)
		end
		local tStart = os.clock()
		local lvl = CarConfig.Rarities[res.rarity].index
		local rc = CarConfig.Rarities[res.rarity].color
		local bcf = BaseLayout.GetBaseCFrame(baseIndex)
		local padPos = bcf:PointToWorldSpace(BaseLayout.TrapLocal) + Vector3.new(0, 1.6, 0)
		local base = findBase(baseIndex)
		local magnet = base and base:FindFirstChild("TrapMagnet")
		local magnetCF = magnet and magnet.CFrame
		local char = Players.LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local startPos = hrp and (hrp.Position + Vector3.new(0, 2.5, 0)) or (padPos + Vector3.new(14, 8, 0))
		local cam = Cine.Take()
		ctx.camTaken = true
		local cam0 = cam.CFrame
		ctx.cam0 = cam0
		camStart(cam)
		local side = bcf:VectorToWorldSpace(Vector3.new(0, 0, 1))
		local front = bcf:VectorToWorldSpace(Vector3.new(1, 0, 0)) -- out of the garage, towards the plaza
		local dof = effect("DepthOfFieldEffect", { Name = "TrapDof", FarIntensity = 0, NearIntensity = 0, FocusDistance = 30, InFocusRadius = 20 })
		local cc = effect("ColorCorrectionEffect", { Name = "TrapCC" })
		ctx.dof, ctx.cc = dof, cc

		-- 1) over the shoulder, letterbox
		Cine.Letterbox(true, 0.35)
		camTarget = CFrame.lookAt((startPos + padPos) / 2 + side * 22 + Vector3.new(0, 10, 0), padPos + Vector3.new(0, 2, 0))
		wait(0.3)

		-- 2) the part flies onto the lift
		play("throw")
		local item = PartVisual.Build(res.partId)
		ctx.item = item
		item:PivotTo(CFrame.new(startPos))
		item.Parent = Workspace
		local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
		a0.Position, a1.Position = Vector3.new(0, 0.7, 0), Vector3.new(0, -0.7, 0)
		a0.Parent, a1.Parent = item.PrimaryPart, item.PrimaryPart
		local trail = Instance.new("Trail")
		trail.Attachment0, trail.Attachment1 = a0, a1
		trail.Color = ColorSequence.new(Color3.new(1, 1, 1), rc)
		trail.Transparency = NumberSequence.new(0.1, 1)
		trail.Lifetime = 0.3
		trail.LightEmission = 0.4
		trail.Parent = item.PrimaryPart
		local target = padPos + Vector3.new(0, 1.2, 0)
		local flight = 0.6 * k
		local t0 = os.clock()
		while true do
			local a = math.min(1, (os.clock() - t0) / flight)
			item.PrimaryPart.CFrame = CFrame.new(startPos:Lerp(target, a) + Vector3.new(0, math.sin(a * math.pi) * 10, 0)) * CFrame.Angles(a * 10, a * 7, 0)
			if a &gt;= 1 then
				break
			end
			RunService.RenderStepped:Wait()
			check(ctx)
		end
		Cine.Shake(0.8, 0.25)
		burst(target, { c1 = Color3.fromRGB(255, 220, 140), c2 = Color3.fromRGB(255, 140, 40), s1 = 0.5, life = 0.5, speed = 16, acc = Vector3.new(0, -40, 0) }, 30)
		dustRing(padPos, Color3.fromRGB(200, 196, 190), 18)
		play("clank")

		-- 3) the magnet comes down and charges
		camTarget = CFrame.lookAt(padPos + side * 16 + front * 10 + Vector3.new(0, 9, 0), padPos + Vector3.new(0, 3, 0))
		local light = Instance.new("PointLight")
		light.Color = rc
		light.Range = 4
		light.Brightness = 0
		ctx.light, ctx.magnet, ctx.magnetCF = light, magnet, magnetCF
		if magnet then
			light.Parent = magnet
			tw(magnet, 0.5 * k, { CFrame = magnetCF - Vector3.new(0, 5, 0) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		end
		wait(0.45)
		item:Destroy()
		play("charge")
		local spk = anchor(CFrame.new(padPos + Vector3.new(0, 0.4, 0)))
		ctx.spk = spk
		local sparks = emitter(spk, { c1 = Color3.fromRGB(255, 240, 200), c2 = rc, s1 = 0.4, life = 0.5, speed = 14, spread = Vector2.new(35, 35), acc = Vector3.new(0, -30, 0), rate = 25 + lvl * 15 })
		sparks.EmissionDirection = Enum.NormalId.Top
		local smoke = emitter(spk, { texture = SMOKE, c1 = Color3.fromRGB(150, 150, 150), s1 = 2, s2 = 6, t1 = 0.6, life = 1.4, speed = 3, acc = Vector3.new(0, 4, 0), rate = 6, light = 0 })
		tw(light, (0.9 + lvl * 0.2) * k, { Range = 18 + lvl * 4, Brightness = 2 + lvl })
		tw(dof, (0.9 + lvl * 0.2) * k, { FarIntensity = 0.6, FocusDistance = 18, InFocusRadius = 8 })
		local chargeT = (0.9 + lvl * 0.2) * k
		local c0 = os.clock()
		while os.clock() - c0 &lt; chargeT do
			local f = (os.clock() - c0) / chargeT
			Cine.Shake(0.1 + f * 0.25 * lvl, 0.12)
			camTarget = CFrame.lookAt(padPos + side * (16 - f * 5) + front * (10 - f * 3) + Vector3.new(0, 9 - f * 2, 0), padPos + Vector3.new(0, 3, 0))
			task.wait(0.08)
			check(ctx)
		end

		-- 4) climax
		sparks.Enabled = false
		smoke.Enabled = false
		play(lvl &gt;= 4 and "revealBig" or "reveal")
		cc.Brightness = 0.35
		cc.Contrast = 0.25
		cc.TintColor = rc:Lerp(Color3.new(1, 1, 1), 0.6)
		tw(cc, 0.7, { Brightness = 0, Contrast = 0, TintColor = Color3.new(1, 1, 1) })
		Cine.Shake(1 + lvl * 0.45, 0.6)
		burst(padPos + Vector3.new(0, 3, 0), { c1 = rc, c2 = Color3.new(1, 1, 1), s1 = 0.8, life = 0.9, speed = 22 + lvl * 4, drag = 2 }, 30 + lvl * 20)
		if lvl &gt;= 4 then
			Cine.Title(string.upper(res.rarity) .. "!", rc, 1.1, 150, 0.28)
		end

		-- 5) blackout: the screen goes fully dark, then the showcase (UI.ShowReveal) on a solid dark backdrop
		Cine.Shake(1.2 + lvl * 0.3, 0.5)
		task.wait(lvl &gt;= 4 and 0.55 or 0.3)
		check(ctx)
		Cine.Darken(1, 0.22)
		task.wait(0.25)
		check(ctx)
		if magnet then
			magnet.CFrame = magnetCF
			light.Brightness = 0
		end
		dof.FarIntensity = 0
		local shown = false
		if TrapFx.Reveal then
			TrapFx.Reveal(res, function()
				shown = true
			end)
			local w0 = os.clock()
			while not shown and os.clock() - w0 &lt; 15 do
				task.wait(0.05)
			end
			if not shown and TrapFx.HideReveal then
				TrapFx.HideReveal()
			end
		end
		check(ctx)

		-- 6) drive-in: the car comes through the garage gate and parks; the camera rides in front of it
		local ghost = VehicleFactory.BuildCar(def)
		ctx.ghost = ghost
		local y = BaseLayout.FloorY + 0.6
		local real = {}
		ctx.real = real
		local function hideReal()
			local cars = base and base:FindFirstChild("Cars")
			local m = cars and res.slot and cars:FindFirstChild("Car_" .. res.slot)
			if m and not real[m] then
				real[m] = true
				for _, d in ipairs(m:GetDescendants()) do
					if d:IsA("BasePart") then
						d.LocalTransparencyModifier = 1
					elseif d:IsA("BillboardGui") then
						d.Enabled = false
					end
				end
			end
		end
		if res.slot then
			local pl = BaseLayout.PortalLocal
			local sl = BaseLayout.SlotLocal(res.slot)
			local L = function(x, yy, z)
				return bcf:PointToWorldSpace(Vector3.new(x, yy, z))
			end
			local pts = { L(pl.X + 30, y, pl.Z), L(pl.X - 6, y, pl.Z), L(BaseLayout.LaneX, y, pl.Z) }
			if sl.Y &gt; 0 then
				local el = BaseLayout.ElevatorLocal
				local yUp = y + sl.Y
				for _, p in ipairs({ { BaseLayout.LaneX, y, el.Z }, { el.X, y, el.Z }, { el.X, yUp, el.Z }, { -15, yUp, el.Z }, { -15, yUp, sl.Z }, { sl.X, yUp, sl.Z } }) do
					table.insert(pts, L(p[1], p[2], p[3]))
				end
			else
				table.insert(pts, L(BaseLayout.LaneX, y, sl.Z))
				table.insert(pts, L(sl.X + 4, y, sl.Z))
			end
			-- open the roller door locally
			local door = base and base:FindFirstChild("PortalDoor")
			local doorCF = door and door.CFrame
			ctx.door, ctx.doorCF = door, doorCF
			if door then
				ctx.doorTween = tw(door, 0.6, { CFrame = doorCF + Vector3.new(0, 10.5, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			end
			ghost:PivotTo(faceCF(pts[1], pts[2] - pts[1]))
			ghost.Parent = Workspace
			hideReal()
			-- still black: cut the camera to the gate, then fade in
			local d1 = (pts[2] - pts[1]).Unit
			camSnap(CFrame.lookAt(pts[1] - d1 * 12 + Vector3.new(0, 4.5, 0), pts[1] + d1 * 6 + Vector3.new(0, 1.5, 0)))
			task.wait(0.05)
			Cine.Darken(0, 0.45)
			play("drive")
			local total = 0
			for i = 2, #pts do
				total = total + (pts[i] - pts[i - 1]).Magnitude
			end
			local dur = math.clamp(total / 22, 3, 6)
			local d0 = os.clock()
			local lastDir = pts[2] - pts[1]
			local camPos
			while true do
				hideReal()
				local a = math.min(1, (os.clock() - d0) / dur)
				local e = a &lt; 0.5 and 2 * a * a or 1 - (-2 * a + 2) ^ 2 / 2 -- ease in-out
				local dist, acc = e * total, 0
				for i = 2, #pts do
					local seg = (pts[i] - pts[i - 1]).Magnitude
					if dist &lt;= acc + seg or i == #pts then
						local pos = pts[i - 1]:Lerp(pts[i], math.clamp((dist - acc) / math.max(seg, 1e-3), 0, 1))
						local dir = pts[i] - pts[i - 1]
						dir = Vector3.new(dir.X, 0, dir.Z)
						if dir.Magnitude &gt; 0.01 then
							lastDir = lastDir:Lerp(dir.Unit, 0.18)
						end
						local fwd = lastDir.Magnitude &gt; 0.01 and lastDir.Unit or Vector3.new(1, 0, 0)
						ghost.PrimaryPart.CFrame = faceCF(pos, fwd) * CFrame.new(0, math.sin(os.clock() * 18) * 0.04, 0)
						-- chase camera: behind and a bit above the car, looking ahead of it
						local want = pos - fwd * 12 + Vector3.new(0, 4.5, 0)
						camPos = camPos and camPos:Lerp(want, 0.15) or want
						camTarget = CFrame.lookAt(camPos, pos + fwd * 6 + Vector3.new(0, 1.5, 0))
						break
					end
					acc = acc + seg
				end
				if a &gt;= 1 then
					break
				end
				RunService.RenderStepped:Wait()
				check(ctx)
			end
			-- reverse-style final: swing into the bay facing out, hero shot
			local final = pts[#pts] - bcf:VectorToWorldSpace(Vector3.new(4, 0, 0))
			local outDir = bcf:VectorToWorldSpace(Vector3.new(1, 0, 0))
			tw(ghost.PrimaryPart, 0.7, { CFrame = faceCF(final, outDir) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			-- parked: the camera stays where it followed the car (in the aisle) and just looks at it
			camTarget = CFrame.lookAt(camPos or final - outDir * 11 + Vector3.new(0, 4.5, 0), final + Vector3.new(0, 1.5, 0))
			task.wait(0.8)
			Cine.Shake(0.3, 0.2)
			if lvl &gt;= 4 then
				Cine.Title(string.upper(def.name), rc, 1.2, 90, 0.75)
			end
			task.wait(1.1)
			if door then
				ctx.doorTween = tw(door, 0.6, { CFrame = doorCF })
			end
		end
		Cine.Darken(0, 0.3) -- no slot (stored car): just fade back in
		-- 7) hand the camera back (cleanup() restores the real car and the rest)
		Cine.Letterbox(false, 0.35)
		camTarget = cam0
		task.wait(0.35)
end

-- always runs, also when the cinematic errored half-way: nothing may stay hidden, dark or scripted
local function cleanup(ctx)
	if ctx.doorTween then
		pcall(function()
			ctx.doorTween:Cancel()
		end)
	end
	if ctx.magnet and ctx.magnetCF then
		ctx.magnet.CFrame = ctx.magnetCF
	end
	for _, k in ipairs({ "item", "ghost", "spk", "dof", "cc", "light" }) do
		if ctx[k] then
			pcall(function()
				ctx[k]:Destroy()
			end)
		end
	end
	for m in pairs(ctx.real or {}) do
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("BasePart") then
				d.LocalTransparencyModifier = 0
			elseif d:IsA("BillboardGui") then
				d.Enabled = true
			end
		end
	end
	if ctx.door and ctx.doorCF then
		ctx.door.CFrame = ctx.doorCF
	end
	if TrapFx.HideReveal then
		pcall(TrapFx.HideReveal)
	end
	camStop()
	Cine.Letterbox(false, 0.2)
	if not ctx.aborted then -- aborted = the player was wrecked: DeathFx owns the camera and the screen now
		Cine.Darken(0, 0.3)
		if ctx.camTaken then
			Cine.Release(0.3)
		end
	end
end

-- stop the running cinematic right away (the player got wrecked); queued ones are dropped
function TrapFx.Abort()
	queue = {}
	if current then
		current.aborted = true
	end
end

function TrapFx.Play(res, baseIndex, onDone)
	if busy then
		table.insert(queue, { res, baseIndex, onDone })
		return
	end
	busy = true
	pcall(cinema, true)
	task.spawn(function()
		local ctx = {}
		current = ctx
		local ok, err = pcall(body, res, baseIndex, ctx)
		if not ok and err ~= "aborted" then
			warn("TrapFx: " .. tostring(err))
		end
		local ok2, err2 = pcall(cleanup, ctx)
		if not ok2 then
			warn("TrapFx cleanup: " .. tostring(err2))
		end
		current = nil
		if onDone then
			task.spawn(onDone)
		end
		local nextOne = table.remove(queue, 1)
		busy = false
		if nextOne then
			TrapFx.Play(nextOne[1], nextOne[2], nextOne[3]) -- holds its own cinematic count before ours is released
		end
		pcall(cinema, false)
	end)
end

function TrapFx.IsBusy()
	return busy
end

return TrapFx
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX50"><Properties><string name="Name">UI</string><ProtectedString name="Source">-- CAR HUNTERS UI (design: Figma "CAR HUNTERS — Game UI"). Toy buttons, cartoon fonts, no purple.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Strings = require(Shared:WaitForChild("Strings"))
local Util = require(Shared:WaitForChild("Util"))
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local Icons = require(Shared:WaitForChild("Icons"))
local PartVisual = require(Shared:WaitForChild("PartVisual"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))
local VehicleFactory = require(Shared:WaitForChild("VehicleFactory"))

local T = Strings.T
local C = Color3.fromRGB
local HEAD = Enum.Font.LuckiestGuy
local BODY = Enum.Font.FredokaOne

local P = {
	yellow = C(255, 210, 63), orange = C(255, 138, 31), red = C(255, 59, 59), green = C(52, 208, 88),
	blue = C(46, 168, 255), cyan = C(34, 224, 224), ink = C(27, 31, 42), white = C(255, 255, 255),
	cream = C(255, 246, 224), grey = C(170, 176, 188), muted = C(96, 102, 116),
}
local PART_ICON = {}
for id, p in pairs(PartConfig.Parts) do
	PART_ICON[id] = p.emoji
end
local ZONE_ICON = { city = "🏙️", highway = "🛣️", industrial = "🏭", neon = "🌃", scrapyard = "💀", docks = "🚂", desert = "🏜️", bridge = "🌉",
	airport = "✈️", canyon = "💀", circuit = "🏁", drift = "🌀", storm = "⛈️", rush = "🚦", colosseum = "👑" }
local ZONE_COLOR = { city = P.green, highway = P.blue, industrial = P.red, neon = P.cyan, plaza = P.orange, scrapyard = P.red, docks = P.blue, desert = P.orange,
	bridge = P.cyan, airport = P.blue, canyon = P.red, circuit = P.red, drift = P.cyan, storm = P.blue, rush = P.orange, colosseum = P.yellow }

local UI = {}
local store, actions
local gui, root
local overlay -- v10: pop-ups (reveal, dialogs, checkpoint, trade request, notifications) on one layer scaled like the HUD
local hud, panels = {}, {}
local state = { selectedPart = nil, nearTrap = false, open = nil, sellArm = {} }
local sounds = {}

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do
		o[k] = v
	end
	o.Parent = parent
	return o
end
local function corner(o, r)
	return new("UICorner", { CornerRadius = UDim.new(0, r or 16) }, o)
end
local function stroke(o, color, th)
	return new("UIStroke", { Color = color or P.ink, Thickness = th or 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
end
local function lift(c, k)
	return c:Lerp(k &gt; 0 and P.white or C(0, 0, 0), math.abs(k))
end
local function gradient(o, c)
	return new("UIGradient", { Color = ColorSequence.new(lift(c, 0.35), c), Rotation = 90 }, o)
end
local function tween(o, t, props, style, dir)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end
local function text(parent, props)
	local l = new("TextLabel", {
		BackgroundTransparency = 1, Font = HEAD, TextColor3 = P.white, TextScaled = false, TextSize = 22,
		Size = UDim2.new(1, 0, 0, 28), TextXAlignment = Enum.TextXAlignment.Left,
	}, parent)
	for k, v in pairs(props) do
		if k ~= "Outline" and k ~= "NoFit" then
			l[k] = v
		end
	end
	if props.Outline ~= false and l.Font == HEAD then
		new("UIStroke", { Color = P.ink, Thickness = props.Outline or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual }, l)
	end
	-- never overflow the frame: fixed-size labels shrink to fit (up to the requested size)
	if l.AutomaticSize == Enum.AutomaticSize.None and not l.TextScaled and props.NoFit ~= true then
		local want = l.TextSize
		l.TextScaled = true
		new("UITextSizeConstraint", { MaxTextSize = want, MinTextSize = math.min(9, want) }, l)
	end
	return l
end
local function clear(f)
	for _, c in ipairs(f:GetChildren()) do
		if not c:IsA("UIListLayout") and not c:IsA("UIGridLayout") and not c:IsA("UIPadding") then
			c:Destroy()
		end
	end
end
local function list(o, dir, gap, ha, va)
	return new("UIListLayout", { FillDirection = dir or Enum.FillDirection.Vertical, Padding = UDim.new(0, gap or 8),
		HorizontalAlignment = ha or Enum.HorizontalAlignment.Left, VerticalAlignment = va or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder }, o)
end

-- Toy button: shadow slab + face with gradient, ink outline, outlined label. Returns api.
local function toy(parent, o)
	local holder = new("Frame", { Name = o.Name or "Toy", BackgroundTransparency = 1, Size = o.Size, Position = o.Position or UDim2.new(),
		AnchorPoint = o.AnchorPoint or Vector2.zero, LayoutOrder = o.LayoutOrder or 0, ZIndex = o.ZIndex or 1 }, parent)
	local depth = o.Depth or 6
	local shadow = new("Frame", { BackgroundColor3 = lift(o.Color, -0.55), Size = UDim2.new(1, 0, 1, -depth), Position = UDim2.fromOffset(0, depth), BorderSizePixel = 0, ZIndex = holder.ZIndex }, holder)
	corner(shadow, o.Radius or 18)
	local face = new("TextButton", { Text = "", AutoButtonColor = false, BackgroundColor3 = P.white, Size = UDim2.new(1, 0, 1, -depth), BorderSizePixel = 0, ZIndex = holder.ZIndex + 1 }, holder)
	corner(face, o.Radius or 18)
	stroke(face, P.ink, 3)
	local grad = gradient(face, o.Color)
	local content = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = face.ZIndex }, face)
	list(content, Enum.FillDirection.Vertical, 0, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	local h = holder.Size.Y.Offset
	local icon
	local imgId = o.Image and Icons.Get(o.Image)
	if imgId then
		-- 3D sticker (Blender render): big, with a clear gap above the label
		content:FindFirstChildOfClass("UIListLayout").Padding = UDim.new(0, 5)
		local sz = math.floor(h * 0.58)
		icon = new("ImageLabel", { Image = imgId, BackgroundTransparency = 1, Size = UDim2.fromOffset(sz, sz), ScaleType = Enum.ScaleType.Fit, ZIndex = face.ZIndex, LayoutOrder = 1 }, content)
	elseif o.Icon then
		icon = text(content, { Text = o.Icon, Font = BODY, TextSize = o.IconSize or math.floor(h * 0.34), Size = UDim2.new(1, 0, 0, math.floor(h * 0.4)), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = face.ZIndex, LayoutOrder = 1 })
	end
	local withIcon = icon ~= nil
	local label = text(content, { Text = o.Text or "", TextSize = o.TextSize or math.floor(h * (withIcon and 0.19 or 0.36)), RichText = true,
		Size = UDim2.new(1, -8, 0, math.floor(h * (withIcon and 0.24 or 0.5))), TextXAlignment = Enum.TextXAlignment.Center, Outline = 2.5, ZIndex = face.ZIndex, LayoutOrder = 2 })
	local sub
	if o.Sub then
		sub = text(content, { Text = o.Sub, Font = BODY, TextSize = o.SubSize or math.floor(h * 0.15), TextColor3 = P.ink, Size = UDim2.new(1, -8, 0, math.floor(h * 0.2)), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = face.ZIndex, LayoutOrder = 3, RichText = true })
	end
	local api = { holder = holder, face = face, label = label, sub = sub, icon = icon, enabled = true }
	function api.SetColor(c)
		grad.Color = ColorSequence.new(lift(c, 0.35), c)
		shadow.BackgroundColor3 = lift(c, -0.55)
	end
	function api.SetText(t, s)
		label.Text = t
		if sub and s then
			sub.Text = s
		end
	end
	face.MouseButton1Down:Connect(function()
		face.Position = UDim2.fromOffset(0, depth - 2)
	end)
	local function up()
		face.Position = UDim2.new()
	end
	face.MouseButton1Up:Connect(up)
	face.MouseLeave:Connect(up)
	face.InputEnded:Connect(function(input) -- touch: the finger slid off the button
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			up()
		end
	end)
	face.Activated:Connect(function()
		up()
		if o.OnClick and api.enabled then
			UI.Sfx("click")
			o.OnClick()
		end
	end)
	return api
end

local function pill(parent, txt, color, props)
	local f = new("Frame", { BackgroundColor3 = color, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, props and props.H or 30), BorderSizePixel = 0, LayoutOrder = props and props.LayoutOrder or 0 }, parent)
	corner(f, 30)
	stroke(f, P.ink, 2.5)
	new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, f)
	local l = text(f, { Text = txt, TextSize = props and props.TextSize or 18, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromScale(0, 1), TextXAlignment = Enum.TextXAlignment.Center })
	return f, l
end

local function rarityColor(r)
	return CarConfig.Rarities[r].color
end

local function fitCamera(vp, model, angle)
	local cam = vp.CurrentCamera or new("Camera", { FieldOfView = 38 }, vp)
	vp.CurrentCamera = cam
	local size = model:GetExtentsSize()
	local d = math.max(size.X, size.Z, size.Y * 1.6) * 1.3
	local a = angle or math.rad(35)
	local center = Vector3.new(0, size.Y * 0.45, 0)
	cam.CFrame = CFrame.lookAt(center + Vector3.new(math.cos(a) * d, d * 0.38, math.sin(a) * d), center)
end

local function carViewport(parent, def, props)
	local vp = new("ViewportFrame", { BackgroundTransparency = 1, Ambient = C(200, 200, 210), LightColor = C(255, 250, 240), LightDirection = Vector3.new(-1, -2, -1) }, parent)
	for k, v in pairs(props or {}) do
		vp[k] = v
	end
	local m = VehicleFactory.BuildCar(def, { Low = true })
	m:PivotTo(CFrame.new())
	m.Parent = vp
	fitCamera(vp, m)
	return vp, m
end

---------------------------------------------------------------- sound / toasts
function UI.Sfx(name)
	if name == "soft" then
		name = "step" -- the quiet two-note chime (ElevenLabs) is the one calm "done" sound
	end
	local s = sounds[name]
	if s then
		s:Play()
	end
end
-- two volume groups for the Settings sliders: SFX (every UI/game sound) and Music
local function soundGroup(name, vol)
	local g = SoundService:FindFirstChild(name) or new("SoundGroup", { Name = name, Volume = vol }, SoundService)
	return g
end
UI.SfxGroup = soundGroup("SFX", 0.8)
UI.MusicGroup = soundGroup("Music", 0.5)
local function makeSound(name, id, vol, speed)
	sounds[name] = new("Sound", { Name = "UI_" .. name, SoundId = id, Volume = vol or 0.5, PlaybackSpeed = speed or 1, SoundGroup = UI.SfxGroup }, SoundService)
end

local KIND_COLOR = { good = P.green, error = P.red, warn = P.orange, info = P.blue }
-- Notifications (v10): one queue for every top message. Max 3 on screen, the same text within its lifetime merges
-- into "x2" instead of stacking, items move with their own position tweens (no list-layout snapping), and the
-- whole pill (background, text AND outline) fades before it is destroyed.
-- v13: small pills at the very top centre (the zone banner moved to the top-left), max 2 at once
local notes = { items = {}, queue = {}, top = 8 }
local NOTE_H, NOTE_GAP, NOTE_MAX, NOTE_LIFE = 28, 6, 2, 2.8

local function noteY(i)
	-- with a panel open the lane sits above the panel card, so a message never covers the button just pressed
	-- dialogs (confirm, checkpoint) also push the lane to the very top so it never covers their buttons
	local top = (state.open or state.dialog) and (hud.tutInPanel and 108 or 6) or (hud.tutInPanel and 108 or notes.top) -- below the tutorial card on garage steps
	return top + (i - 1) * (NOTE_H + NOTE_GAP)
end

local function noteLayout()
	for i, it in ipairs(notes.items) do
		tween(it.f, 0.22, { Position = UDim2.new(0.5, 0, 0, noteY(i)) })
	end
end

local noteShow
local function noteRemove(it)
	if it.dead then
		return
	end
	it.dead = true
	for i, x in ipairs(notes.items) do
		if x == it then
			table.remove(notes.items, i)
			break
		end
	end
	tween(it.f, 0.25, { BackgroundTransparency = 1 })
	tween(it.l, 0.25, { TextTransparency = 1 })
	tween(it.stroke, 0.25, { Transparency = 1 })
	for _, st in ipairs(it.l:GetChildren()) do
		if st:IsA("UIStroke") then
			tween(st, 0.25, { Transparency = 1 })
		end
	end
	task.delay(0.27, function()
		it.f:Destroy()
	end)
	noteLayout()
	local nextOne = table.remove(notes.queue, 1)
	while nextOne and (os.clock() - (nextOne.at or 0) &gt; 4 or (state.notesOff and nextOne.kind ~= "error" and nextOne.kind ~= "warn")) do
		nextOne = table.remove(notes.queue, 1) -- stale ("Not enough money" 8 s later helps nobody)
	end
	if nextOne then
		noteShow(nextOne.msg, nextOne.kind, nextOne.n, nextOne.silent)
	end
end

local function noteLabel(it)
	return it.n &gt; 1 and (it.msg .. "   x" .. it.n) or it.msg
end

noteShow = function(msg, kind, n, silent)
	local f = new("TextButton", { Name = "Note", Text = "", AutoButtonColor = false, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, noteY(#notes.items + 1) - 10), AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, NOTE_H), BackgroundColor3 = KIND_COLOR[kind] or P.blue, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 50 }, hud.toasts)
	corner(f, 14)
	local st = stroke(f, P.ink, 2)
	st.Transparency = 1
	new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, f)
	local l = text(f, { Text = msg, TextSize = 15, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromScale(0, 1), ZIndex = 51, TextTransparency = 1 })
	local it = { f = f, l = l, stroke = st, msg = msg, kind = kind, n = n or 1, expire = os.clock() + NOTE_LIFE, born = os.clock() }
	l.Text = noteLabel(it)
	table.insert(notes.items, it)
	f.Activated:Connect(function() -- tap a message to hide it right away
		noteRemove(it)
	end)
	tween(f, 0.2, { BackgroundTransparency = 0 })
	tween(l, 0.2, { TextTransparency = 0 })
	tween(st, 0.2, { Transparency = 0 })
	noteLayout()
	if not silent then
		UI.Sfx(kind == "error" and "err" or "ping")
	end
end

-- silent = no ping (e.g. a message that comes with its own sound); notifications can be switched off in Settings
-- (errors still show: the player must know why an action failed)
function UI.Toast(msg, kind, silent)
	msg = tostring(msg)
	if state.notesOff and kind ~= "error" and kind ~= "warn" then
		return
	end
	-- same message already on screen or waiting: count it instead of adding another pill
	for _, it in ipairs(notes.items) do
		if not it.dead and it.msg == msg then
			it.n = it.n + 1
			it.l.Text = noteLabel(it)
			-- refresh, but never longer than 6 s in total and not while others are waiting
			it.expire = #notes.queue &gt; 0 and it.expire or math.min(os.clock() + NOTE_LIFE, it.born + 6)
			return
		end
	end
	for _, q in ipairs(notes.queue) do
		if q.msg == msg then
			q.n = q.n + 1
			return
		end
	end
	if #notes.items &gt;= NOTE_MAX then
		table.insert(notes.queue, { msg = msg, kind = kind, n = 1, at = os.clock(), silent = silent })
		while #notes.queue &gt; 5 do
			table.remove(notes.queue, 1) -- a burst: drop the oldest waiting messages
		end
		-- make room soon: the oldest one leaves early
		local oldest = notes.items[1]
		oldest.expire = math.min(oldest.expire, os.clock() + 0.6)
		return
	end
	noteShow(msg, kind, 1, silent)
end

-- a modal dialog (confirm, checkpoint) is up: the notification lane moves to the very top
-- counted: a confirm over the checkpoint card, or a confirm replacing another one, keeps the flag right
local dialogDepth = 0
function UI.SetDialog(on)
	dialogDepth = math.max(0, dialogDepth + (on and 1 or -1))
	state.dialog = dialogDepth &gt; 0 or nil
	noteLayout()
end

function UI.SetNotificationsEnabled(on)
	if state.notesOff == not on then
		return -- unchanged (called on every settings change)
	end
	state.notesOff = not on
	if not on then
		-- drop waiting messages first (errors/warnings stay), then hide what is on screen
		local keep = {}
		for _, q in ipairs(notes.queue) do
			if q.kind == "error" or q.kind == "warn" then
				table.insert(keep, q)
			end
		end
		notes.queue = keep
		for _, it in ipairs(table.clone(notes.items)) do
			if it.kind ~= "error" and it.kind ~= "warn" then
				noteRemove(it)
			end
		end
	end
end

task.spawn(function()
	while true do
		task.wait(0.1)
		pcall(function()
			local now = os.clock()
			for _, it in ipairs(table.clone(notes.items)) do
				if state.cine then
					it.expire = math.max(it.expire, now + 0.5) -- hidden during cinematics: keep it for afterwards
				elseif now &gt;= it.expire then
					noteRemove(it)
				end
			end
		end)
	end
end)

function UI.Notify(payload)
	if type(payload) ~= "table" then
		return
	end
	local SILENT = { banked = true, banked2 = true, contractDone = true, contractsDone = true, dailyClaimed = true, chestClaimed = true }
	UI.Toast(T("n_" .. tostring(payload.key), table.unpack(payload.args or {})), payload.kind, SILENT[payload.key])
end

---------------------------------------------------------------- HUD
local function buildHud()
	-- left column (Figma "08 — HUD Left Clean"): no cards, outlined type, real 3D icons
	-- bottom-left corner; on phones lifted above the movement thumbstick
	local UIS = game:GetService("UserInputService")
	local lift = (UIS.TouchEnabled and not UIS.KeyboardEnabled) and 210 or 0
	hud.leftLift = lift
	local colF = new("Frame", { Name = "LeftColumn", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 18, 1, -16 - lift), Size = UDim2.fromOffset(280, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1 }, root)
	list(colF, Enum.FillDirection.Vertical, 12)
	hud.leftCol = colF
	local function outline(l, th)
		new("UIStroke", { Color = P.ink, Thickness = th or 2.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual }, l)
		return l
	end
	local function icon(parent, name, size, pos)
		local img = new("ImageLabel", { Size = UDim2.fromOffset(size, size), Position = pos or UDim2.new(), BackgroundTransparency = 1, Image = Icons.Get(name) or "", ScaleType = Enum.ScaleType.Fit }, parent)
		if img.Image == "" then -- not uploaded: a plain short word instead
			text(img, { Text = string.upper(string.sub(name, 1, 4)), TextSize = 14, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center })
		end
		return img
	end
	-- money
	local money = new("Frame", { Name = "Money", Size = UDim2.fromOffset(280, 64), BackgroundTransparency = 1, LayoutOrder = 5 }, colF)
	icon(money, "coin", 56, UDim2.fromOffset(0, 4))
	hud.money = text(money, { Position = UDim2.fromOffset(64, 0), Size = UDim2.new(1, -64, 0, 42), TextSize = 40, TextColor3 = P.white, Outline = 3 })
	hud.income = outline(text(money, { Position = UDim2.fromOffset(65, 42), Size = UDim2.new(1, -65, 0, 20), TextSize = 18, Font = BODY, TextColor3 = C(70, 220, 100) }), 2.5)
	hud.moneyScale = new("UIScale", {}, money)
	-- loot carried on this run (only while carrying)
	local bag = new("Frame", { Name = "Carrying", Size = UDim2.fromOffset(280, 28), BackgroundTransparency = 1, Visible = false, LayoutOrder = 3 }, colF)
	hud.bag = bag
	hud.bagText = text(bag, { Text = "", TextSize = 17, TextColor3 = C(255, 80, 70), Size = UDim2.new(1, 0, 0, 20), Outline = 2.5 })
	local bbar = new("Frame", { Position = UDim2.fromOffset(0, 23), Size = UDim2.fromOffset(200, 4), BackgroundColor3 = P.ink, BackgroundTransparency = 0.45, BorderSizePixel = 0 }, bag)
	corner(bbar, 2)
	hud.bagFill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = C(255, 80, 70), BorderSizePixel = 0 }, bbar)
	corner(hud.bagFill, 2)
	hud.icon = icon

	-- zone banner + hint
	-- zone banner: top-left corner (the top centre belongs to the notifications)
	local banner = new("Frame", { AnchorPoint = Vector2.new(0, 0), Position = UDim2.new(0, 16, 0, 12), Size = UDim2.fromOffset(250, 42), BackgroundColor3 = P.white, BorderSizePixel = 0 }, root)
	corner(banner, 14)
	stroke(banner, P.ink, 3.5)
	hud.bannerGrad = gradient(banner, P.orange)
	hud.zone = text(banner, { Text = "", TextSize = 28, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Outline = 3 })
	local hint = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 70), AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 40), BackgroundColor3 = P.white, BorderSizePixel = 0, Visible = false }, root)
	corner(hint, 20)
	stroke(hint, P.ink, 3)
	new("UIPadding", { PaddingLeft = UDim.new(0, 18), PaddingRight = UDim.new(0, 18) }, hint)
	hud.hintFrame = hint
	hud.hint = text(hint, { Text = "", Font = BODY, TextSize = 20, TextColor3 = P.ink, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromScale(0, 1) })

	-- side buttons (minimum: 3)
	-- phones: start higher and a bit smaller so the column ends above the jump button
	local touch = (UIS.TouchEnabled and not UIS.KeyboardEnabled)
	local side = new("Frame", { Name = "SideButtons", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, touch and 64 or 100), Size = UDim2.fromOffset(122, 5 * 104 + 48), BackgroundTransparency = 1 }, root)
	if touch then
		new("UIScale", { Scale = 0.8 }, side)
	end
	hud.side = side
	list(side, Enum.FillDirection.Vertical, 12)
	local tpBtn = toy(side, { Text = T("btn_teleport"), Image = "teleport", Icon = "🚀", Color = P.blue, Size = UDim2.fromOffset(122, 104), LayoutOrder = 1, OnClick = function() UI.TogglePanel("teleport") end })
	hud.garageBtn = toy(side, { Text = T("btn_garage"), Image = "garage", Icon = "🏁", Color = P.orange, Size = UDim2.fromOffset(122, 104), LayoutOrder = 2, OnClick = function() UI.TogglePanel("garage") end })
	toy(side, { Text = T("btn_index"), Image = "index", Icon = "🚗", Color = P.green, Size = UDim2.fromOffset(122, 104), LayoutOrder = 3, OnClick = function() UI.TogglePanel("index") end })
	-- on the TELEPORT button itself (as a child of the list it used to push every button down)
	hud.teleportBtn = tpBtn
	hud.newDot = new("Frame", { Size = UDim2.fromOffset(22, 22), Position = UDim2.new(1, -16, 0, -6), BackgroundColor3 = P.red, Visible = false, ZIndex = 5 }, tpBtn.holder)
	corner(hud.newDot, 11)
	stroke(hud.newDot, P.white, 3)

	-- THROW (only near own trap)
	hud.throw = toy(root, { Name = "Throw", Text = T("btn_throw"), Sub = "", Color = P.yellow, Size = UDim2.fromOffset(300, 104),
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -24), OnClick = function() UI.TogglePanel("throw") end })
	hud.throw.holder.Visible = false

	hud.toasts = new("Frame", { Name = "Notes", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 90 }, overlay) -- items position themselves (UI.Toast)
	hud.flash = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = P.red, BackgroundTransparency = 1, ZIndex = 40, Active = false }, gui)
end

---------------------------------------------------------------- panels
local function panelShell(name, title, w, h, color)
	local dim = new("TextButton", { Name = name, Text = "", AutoButtonColor = false, Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(0, 0, 0), BackgroundTransparency = 0.5, Visible = false, ZIndex = 20 }, root)
	dim.Activated:Connect(function() UI.TogglePanel(nil) end)
	local card = new("TextButton", { Text = "", AutoButtonColor = false, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(w, h), BackgroundColor3 = P.cream, ZIndex = 21 }, dim)
	corner(card, 28)
	stroke(card, P.ink, 5)
	local head = new("Frame", { Size = UDim2.new(1, 0, 0, 70), BackgroundColor3 = P.white, ZIndex = 22 }, card)
	corner(head, 28)
	stroke(head, P.ink, 5)
	gradient(head, color)
	text(head, { Text = title, TextSize = 38, Position = UDim2.fromOffset(28, 0), Size = UDim2.new(1, -110, 1, 0), ZIndex = 23, Outline = 3 })
	toy(card, { Text = "X", Color = P.red, Size = UDim2.fromOffset(60, 64), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 14, 0, -18), ZIndex = 24, OnClick = function() UI.TogglePanel(nil) end })
	local content = new("Frame", { Position = UDim2.fromOffset(22, 86), Size = UDim2.new(1, -44, 1, -104), BackgroundTransparency = 1, ZIndex = 22 }, card)
	local sc = new("UIScale", {}, card)
	panels[name] = { root = dim, card = card, content = content, scale = sc }
	return panels[name]
end

local function scroller(parent, pos, size)
	local s = new("ScrollingFrame", { Position = pos, Size = size, BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 8, ScrollBarImageColor3 = P.ink,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 22 }, parent)
	list(s, Enum.FillDirection.Vertical, 10)
	new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 12) }, s)
	return s
end

-- THROW menu (Figma "09 — Throw Menu"): pick how many of each part, see the expected cars, throw them all at once
state.mix = {}
state.merge = true
local function mixTotal()
	local n = 0
	for _, id in ipairs(PartConfig.Order) do
		n = n + math.min(state.mix[id] or 0, store.Banked(id))
	end
	return n
end
-- how many cars one throw may catch (1..4, "Multi Catch" perk in the Pit Stop)
local function catchLimit()
	local st = store.State
	return EconomyConfig.CatchLimit(st and st.perks and st.perks.multi or 0)
end
local function setMix(id, n)
	local total = mixTotal() - math.min(state.mix[id] or 0, store.Banked(id))
	state.mix[id] = math.clamp(n, 0, math.max(0, math.min(store.Banked(id), EconomyConfig.MaxBatch - total)))
	UI.Refresh()
end

local function buildThrow()
	local p = panelShell("throw", T("throw_title"), 940, 600, P.yellow)
	local c = p.content
	local rows = scroller(c, UDim2.new(), UDim2.fromOffset(570, 410)) -- 10 parts: scrolling list
	panels.throwRows = {}
	-- rarity points of the pick + cars per throw (1 at the start, up to 4 with "Multi Catch")
	panels.catchInfo = text(c, { Text = "", Font = BODY, TextSize = 17, TextColor3 = P.ink, RichText = true, Position = UDim2.fromOffset(0, 420), Size = UDim2.fromOffset(560, 26), ZIndex = 23 })
	for i, id in ipairs(PartConfig.Order) do
		local rc = rarityColor(PartConfig.Parts[id].rarity)
		local r = new("Frame", { Size = UDim2.fromOffset(548, 74), BackgroundColor3 = P.white, LayoutOrder = i, ZIndex = 23 }, rows)
		corner(r, 18)
		local st = stroke(r, rc, 4)
		-- the real 3D part (same model as on the map), slowly turning
		local img = new("ViewportFrame", { Position = UDim2.fromOffset(8, 5), Size = UDim2.fromOffset(64, 64), BackgroundTransparency = 1, Ambient = C(190, 190, 200),
			LightColor = C(255, 250, 240), LightDirection = Vector3.new(-1, -1.5, -1), ZIndex = 24 }, r)
		local pm = PartVisual.Build(id)
		for _, d in ipairs(pm:GetDescendants()) do
			if d:IsA("ParticleEmitter") or d:IsA("Light") then
				d:Destroy()
			end
		end
		pm:PivotTo(CFrame.new())
		pm.Parent = img
		local cam = new("Camera", { FieldOfView = 30 }, img)
		img.CurrentCamera = cam
		local _, ext = pm:GetBoundingBox()
		panels.partSpin = panels.partSpin or {}
		table.insert(panels.partSpin, { cam = cam, dist = math.max(ext.X, ext.Y, ext.Z) * 2.4, centre = pm:GetBoundingBox().Position })
		text(r, { Text = string.upper(T("part_" .. id)), TextSize = 20, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(80, 10), Size = UDim2.fromOffset(152, 26), ZIndex = 24 })
		local owned = text(r, { Text = "", Font = BODY, TextSize = 14, TextColor3 = P.muted, Position = UDim2.fromOffset(80, 40), Size = UDim2.fromOffset(150, 20), ZIndex = 24 })
		local function stepBtn(label, color, x, w, onClick)
			return toy(r, { Text = label, Color = color, Size = UDim2.fromOffset(w, 48), Position = UDim2.fromOffset(x, 12), TextSize = label == "MAX" and 18 or 26, ZIndex = 25, OnClick = onClick })
		end
		local minus = stepBtn("-", P.red, 240, 46, function() setMix(id, (state.mix[id] or 0) - 1) end)
		local cnt = new("Frame", { Position = UDim2.fromOffset(294, 15), Size = UDim2.fromOffset(72, 44), BackgroundColor3 = C(244, 240, 230), ZIndex = 24 }, r)
		corner(cnt, 12)
		local cntText = text(cnt, { Text = "0", TextSize = 26, TextColor3 = P.ink, Outline = false, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 25 })
		local plus = stepBtn("+", P.green, 374, 46, function() setMix(id, (state.mix[id] or 0) + 1) end)
		local max = stepBtn("MAX", P.blue, 428, 80, function() setMix(id, store.Banked(id)) end)
		-- hold +/- to repeat
		for _, pair in ipairs({ { plus, 1 }, { minus, -1 } }) do
			local held = false
			pair[1].face.MouseButton1Down:Connect(function()
				held = true
				task.delay(0.4, function()
					while held do
						setMix(id, (state.mix[id] or 0) + pair[2])
						task.wait(0.06)
					end
				end)
			end)
			pair[1].face.MouseButton1Up:Connect(function() held = false end)
			pair[1].face.MouseLeave:Connect(function() held = false end)
			pair[1].face.InputEnded:Connect(function() held = false end)
		end
		panels.throwRows[id] = { frame = r, stroke = st, img = img, owned = owned, cnt = cntText, minus = minus, plus = plus, max = max, rc = rc }
	end
	-- right column: quick picks, expected cars, merge toggle, throw
	local right = new("Frame", { Position = UDim2.fromOffset(582, 0), Size = UDim2.fromOffset(312, 480), BackgroundTransparency = 1, ZIndex = 22 }, c)
	toy(right, { Text = "ALL", Color = P.orange, Size = UDim2.fromOffset(98, 46), Position = UDim2.fromOffset(0, 0), TextSize = 20, ZIndex = 23, OnClick = function()
		-- every part you have (more parts = more rarity points)
		state.mix = {}
		local left = EconomyConfig.MaxBatch
		for i = #PartConfig.Order, 1, -1 do
			local id = PartConfig.Order[i]
			local n = math.min(store.Banked(id), left)
			state.mix[id] = n
			left = left - n
		end
		UI.Refresh()
	end })
	toy(right, { Text = "RARE", Color = P.blue, Size = UDim2.fromOffset(98, 46), Position = UDim2.fromOffset(107, 0), TextSize = 20, ZIndex = 23, OnClick = function()
		-- only Rare, Epic and Legendary parts
		state.mix = {}
		local left = EconomyConfig.MaxBatch
		for i = #PartConfig.Order, 1, -1 do
			local id = PartConfig.Order[i]
			local rar = PartConfig.Parts[id].rarity
			if rar == "Rare" or rar == "Epic" or rar == "Legendary" then
				local n = math.min(store.Banked(id), left)
				state.mix[id] = n
				left = left - n
			end
		end
		UI.Refresh()
	end })
	toy(right, { Text = "CLEAR", Color = P.grey, Size = UDim2.fromOffset(98, 46), Position = UDim2.fromOffset(214, 0), TextSize = 18, ZIndex = 23, OnClick = function()
		state.mix = {}
		UI.Refresh()
	end })
	local odds = new("Frame", { Position = UDim2.fromOffset(0, 60), Size = UDim2.fromOffset(312, 212), BackgroundColor3 = P.white, ZIndex = 23 }, right)
	corner(odds, 18)
	stroke(odds, P.ink, 3)
	text(odds, { Text = "CHANCE PER CAR", TextSize = 18, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(14, 10), Size = UDim2.fromOffset(280, 22), ZIndex = 24 })
	local bar = new("Frame", { Position = UDim2.fromOffset(14, 38), Size = UDim2.fromOffset(284, 16), BackgroundColor3 = C(230, 232, 236), ClipsDescendants = true, ZIndex = 24 }, odds)
	corner(bar, 8)
	list(bar, Enum.FillDirection.Horizontal, 0)
	panels.oddsBar = bar
	panels.oddsLines = {}
	for i, r in ipairs(CarConfig.RarityOrder) do
		local dot = new("Frame", { Position = UDim2.fromOffset(14, 64 + (i - 1) * 22), Size = UDim2.fromOffset(12, 12), BackgroundColor3 = rarityColor(r), ZIndex = 24 }, odds)
		corner(dot, 6)
		panels.oddsLines[r] = text(odds, { Text = "", Font = BODY, TextSize = 15, TextColor3 = P.ink, RichText = true, Position = UDim2.fromOffset(34, 58 + (i - 1) * 22), Size = UDim2.fromOffset(260, 22), ZIndex = 24 })
	end
	panels.oddsText = text(odds, { Text = "", Font = BODY, TextSize = 14, TextColor3 = P.orange, Position = UDim2.fromOffset(14, 178), Size = UDim2.fromOffset(284, 22), ZIndex = 24 })
	-- merge toggle
	local tg = new("TextButton", { Text = "", AutoButtonColor = false, Position = UDim2.fromOffset(0, 286), Size = UDim2.fromOffset(312, 44), BackgroundTransparency = 1, ZIndex = 23 }, right)
	local sw = new("Frame", { Position = UDim2.fromOffset(0, 7), Size = UDim2.fromOffset(52, 30), BackgroundColor3 = P.green, ZIndex = 24 }, tg)
	corner(sw, 15)
	stroke(sw, P.ink, 3)
	local knob = new("Frame", { Position = UDim2.fromOffset(25, 4), Size = UDim2.fromOffset(22, 22), BackgroundColor3 = P.white, ZIndex = 25 }, sw)
	corner(knob, 11)
	text(tg, { Text = "MERGE DUPLICATES", TextSize = 16, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(62, 2), Size = UDim2.fromOffset(250, 20), ZIndex = 24 })
	text(tg, { Text = string.format("Same car = +1 level (up to Lv%d)", EconomyConfig.MergeMaxLevel), Font = BODY, TextSize = 13, TextColor3 = P.muted, Position = UDim2.fromOffset(62, 22), Size = UDim2.fromOffset(250, 18), ZIndex = 24 })
	tg.Activated:Connect(function()
		state.merge = not state.merge
		UI.Sfx("click")
		UI.Refresh()
	end)
	panels.mergeSw, panels.mergeKnob = sw, knob
	panels.throwGo = toy(right, { Text = T("btn_throw"), Color = P.green, Size = UDim2.fromOffset(312, 80), Position = UDim2.fromOffset(0, 344), TextSize = 30, ZIndex = 23,
		OnClick = function()
			local total = mixTotal()
			if total &lt;= 0 then
				UI.Toast(T("n_noPart"), "error")
				return
			end
			local counts = {}
			for _, id in ipairs(PartConfig.Order) do
				local n = math.min(state.mix[id] or 0, store.Banked(id))
				if n &gt; 0 then
					counts[id] = n
				end
			end
			actions.ThrowBatch(counts, state.merge)
			state.mix = {}
			UI.TogglePanel(nil)
		end })
end

-- turn the part previews while the throw menu is open
RunService.RenderStepped:Connect(function()
	if state.open ~= "throw" or not panels.partSpin then
		return
	end
	local a = os.clock() * 0.9
	for _, sp in ipairs(panels.partSpin) do
		local off = Vector3.new(math.cos(a), 0.55, math.sin(a)).Unit * sp.dist
		sp.cam.CFrame = CFrame.lookAt(sp.centre + off, sp.centre)
	end
end)

local function refreshThrow()
	local st = store.State
	if not st then
		return
	end
	local ready = store.BankedTotal()
	-- first open: preselect one of the best part so a single tap still works
	if mixTotal() == 0 and ready &gt; 0 and not state.mixTouched then
		for i = #PartConfig.Order, 1, -1 do
			local id = PartConfig.Order[i]
			if store.Banked(id) &gt; 0 then
				state.mix[id] = 1
				break
			end
		end
	end
	hud.throw.SetText(T("btn_throw"), ready &gt; 0 and string.format("%d parts ready", ready) or T("throw_none"))
	hud.throw.SetColor(ready &gt; 0 and P.yellow or P.grey)
	if not panels.throwRows or state.open ~= "throw" then
		return
	end
	state.mixTouched = true
	local lim = catchLimit()
	local total, points = 0, 0
	for id, row in pairs(panels.throwRows) do
		local own = store.Banked(id)
		local n = math.min(state.mix[id] or 0, own)
		total = total + n
		row.owned.Text = own &gt; 0 and string.format("%d owned", own) or "none owned"
		row.cnt.Text = tostring(n)
		row.cnt.TextColor3 = n &gt; 0 and P.ink or P.grey
		row.stroke.Color = n &gt; 0 and row.rc or C(220, 222, 226)
		row.stroke.Thickness = n &gt; 0 and 4 or 2
		row.img.ImageTransparency = own &gt; 0 and 0 or 0.55
		row.minus.SetColor(n &gt; 0 and P.red or P.grey)
		row.plus.SetColor(n &lt; own and P.green or P.grey)
		row.max.SetColor(own &gt; 0 and P.blue or P.grey)
		points = points + n * PartConfig.Parts[id].points
	end
	-- all parts add rarity points; the throw catches `lim` cars, each rolled on those points
	panels.catchInfo.Text = string.format("&lt;b&gt;%d&lt;/b&gt; rarity points  ·  catches &lt;b&gt;%d&lt;/b&gt; car%s%s", points, lim, lim &gt; 1 and "s" or "",
		lim &lt; EconomyConfig.MaxCatch and "  ·  more with &lt;b&gt;Multi Catch&lt;/b&gt; (Pit Stop)" or "")
	local chances = CarConfig.ChancesForPoints(math.max(points, 1))
	local expected = {}
	for _, r in ipairs(CarConfig.RarityOrder) do
		expected[r] = total &gt; 0 and lim * chances[r] / 100 or 0
	end
	clear(panels.oddsBar)
	for i, r in ipairs(CarConfig.RarityOrder) do
		local share = total &gt; 0 and chances[r] / 100 or 0
		if share &gt; 0 then
			new("Frame", { Size = UDim2.new(math.max(share, 0.012), 0, 1, 0), BackgroundColor3 = rarityColor(r), BorderSizePixel = 0, LayoutOrder = i, ZIndex = 25 }, panels.oddsBar)
		end
		panels.oddsLines[r].Text = string.format("&lt;b&gt;%s&lt;/b&gt;  &lt;font color=\"#606674\"&gt;%s%%&lt;/font&gt;", T("rarity_" .. r), total &gt; 0 and (chances[r] &gt;= 10 and string.format("%.0f", chances[r]) or string.format("%.1f", chances[r])) or "0")
	end
	local pity = st.pity or 0
	local left = EconomyConfig.PityThreshold - pity
	panels.oddsText.Text = left &lt;= 1 and T("throw_pity_now") or T("throw_pity", left)
	panels.mergeSw.BackgroundColor3 = state.merge and P.green or P.grey
	panels.mergeKnob.Position = UDim2.fromOffset(state.merge and 25 or 3, 4)
	panels.throwGo.SetText(total &gt; 0 and string.format("THROW %d PARTS", total) or T("btn_throw"), nil)
	panels.throwGo.SetColor(total &gt; 0 and P.green or P.grey)
end

-- TELEPORT (also unlocks districts)
local function buildTeleport()
	local p = panelShell("teleport", T("tp_title"), 820, 560, P.blue)
	panels.tpGrid = new("ScrollingFrame", { Size = UDim2.new(1, 0, 1, -40), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 8, ScrollBarImageColor3 = P.ink,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 22 }, p.content)
	new("UIGridLayout", { CellSize = UDim2.fromOffset(240, 196), CellPadding = UDim2.fromOffset(16, 18), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }, panels.tpGrid)
	text(p.content, { Text = "⚠ " .. T("tp_walk"), Font = BODY, TextSize = 19, TextColor3 = P.red, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), ZIndex = 22 })
end

local function refreshTeleport()
	local st = store.State
	if not st or state.open ~= "teleport" then
		return
	end
	clear(panels.tpGrid)
	local function tile(order, title, icon, color, sub, onClick)
		local f = new("Frame", { BackgroundTransparency = 1, LayoutOrder = order, ZIndex = 22 }, panels.tpGrid)
		local t = toy(f, { Text = title, Icon = icon, Sub = sub, Color = color, Size = UDim2.fromOffset(240, 190), ZIndex = 23, SubSize = 17, OnClick = onClick })
		return t
	end
	tile(0, T("tp_home"), "🏠", P.orange, T("tp_home_desc"), function()
		actions.Teleport("home")
		UI.TogglePanel(nil)
	end)
	for i, zid in ipairs(MapConfig.ZoneOrder) do
		local zone = MapConfig.Zones[zid]
		local open = st.zones[zid] == true
		local prevOpen = i == 1 or st.zones[MapConfig.ZoneOrder[i - 1]] == true
		local req = EconomyConfig.ZoneUnlock[zid]
		local title = string.gsub(zone.name, " DISTRICT", "")
		local needReb = req and (req.rebirths or 0) &gt; (st.rebirths or 0)
		if not open and not prevOpen then
			break -- show only the next district to unlock, the rest stays a surprise
		end
		if open then
			tile(i, title, ZONE_ICON[zid], ZONE_COLOR[zid], T("zone_desc_" .. zid), function()
				actions.Teleport(zid)
				UI.TogglePanel(nil)
			end)
		else
			local can = prevOpen and req and not needReb and store.Money &gt;= req.cost and store.CollectionValue &gt;= req.minValue
			local sub = needReb and string.format(T("n_needRebirth"), req.rebirths)
				or string.format("🔒 $%s  ·  %s $%s", Util.FormatNumber(req.cost), T("zones_value"), Util.FormatNumber(req.minValue))
			local t = tile(i, can and (T("btn_unlock") .. "!") or title, "🔒", can and P.green or P.grey, sub, function()
				if can then
					actions.Unlock(zid)
				elseif needReb then
					UI.Toast(string.format(T("n_needRebirth"), req.rebirths), "warn")
				elseif prevOpen and store.CollectionValue &lt; req.minValue then
					UI.Toast(T("n_needValue"), "warn")
				elseif prevOpen then
					UI.Toast(T("n_noMoney"), "error")
				else
					UI.Toast(T("n_needPrev"), "warn")
				end
			end)
			if not can then
				t.holder.Size = UDim2.fromOffset(240, 190)
			end
		end
	end
end

-- GARAGE
-- confirmation popup (sell etc.)
local confirmDim
local function closeConfirm()
	if confirmDim then
		confirmDim:Destroy()
		confirmDim = nil
	end
end

function UI.Confirm(title, body, okText, okColor, onOk, def)
	closeConfirm() -- never two dialogs on top of each other
	if state.cine then
		return
	end
	local dim = new("TextButton", { Name = "Confirm", Text = "", AutoButtonColor = false, Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(0, 0, 0), BackgroundTransparency = 0.45, ZIndex = 85 }, overlay)
	local card = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(480, def and 400 or 260), BackgroundColor3 = P.cream, ZIndex = 86 }, dim)
	corner(card, 26)
	stroke(card, P.ink, 5)
	local sc = new("UIScale", { Scale = 0.6 }, card)
	tween(sc, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	text(card, { Text = title, TextSize = 32, Position = UDim2.fromOffset(0, 16), Size = UDim2.new(1, 0, 0, 40), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 87, Outline = 3 })
	local y = 62
	if def then
		carViewport(card, def, { Position = UDim2.fromOffset(90, 56), Size = UDim2.fromOffset(300, 140), ZIndex = 87 })
		y = 200
	end
	text(card, { Text = body, Font = BODY, TextSize = 20, TextColor3 = P.ink, RichText = true, TextWrapped = true, Position = UDim2.fromOffset(24, y), Size = UDim2.new(1, -48, 0, 70), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 87 })
	local btns = new("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -18), Size = UDim2.fromOffset(440, 70), BackgroundTransparency = 1, ZIndex = 87 }, card)
	list(btns, Enum.FillDirection.Horizontal, 16, Enum.HorizontalAlignment.Center)
	toy(btns, { Text = "KEEP", Color = P.grey, Size = UDim2.fromOffset(170, 66), TextSize = 24, LayoutOrder = 1, ZIndex = 88, OnClick = function() dim:Destroy() end })
	toy(btns, { Text = okText, Color = okColor or P.red, Size = UDim2.fromOffset(220, 66), TextSize = 24, LayoutOrder = 2, ZIndex = 88, OnClick = function()
		dim:Destroy()
		onOk()
	end })
	dim.Activated:Connect(function() dim:Destroy() end)
	confirmDim = dim
	UI.SetDialog(true)
	dim.Destroying:Connect(function()
		UI.SetDialog(false)
	end)
end

state.garageTab = "parked"
local function buildGarage()
	local p = panelShell("garage", T("garage_title"), 940, 600, P.orange)
	local c = p.content
	panels.garageInfo = text(c, { Text = "", Font = BODY, TextSize = 18, TextColor3 = P.ink, Size = UDim2.new(1, -540, 0, 50), ZIndex = 22, RichText = true, TextWrapped = true })
	panels.autoBtn = toy(c, { Text = T("btn_autopark"), Color = P.green, Size = UDim2.fromOffset(170, 54), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -190, 0, -2), ZIndex = 23, OnClick = function() actions.AutoPark() end })
	panels.slotBtn = toy(c, { Text = T("btn_buyslot"), Sub = "", Color = P.blue, Size = UDim2.fromOffset(176, 54), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, -2), ZIndex = 23, SubSize = 14,
		OnClick = function()
			local st = store.State
			if st.slots + 1 &gt; (st.floors or 1) * 6 then
				actions.BuyFloor(st.floors or 1)
			else
				actions.BuySlot(st.slots)
			end
		end })
	-- tabs + bulk sell
	local tabs = new("Frame", { Position = UDim2.fromOffset(0, 62), Size = UDim2.new(1, 0, 0, 50), BackgroundTransparency = 1, ZIndex = 22 }, c)
	list(tabs, Enum.FillDirection.Horizontal, 10)
	panels.garageTabs = {}
	for i, tab in ipairs({ "parked", "storage" }) do
		panels.garageTabs[tab] = toy(tabs, { Text = string.upper(tab), Color = P.grey, Size = UDim2.fromOffset(170, 48), TextSize = 20, LayoutOrder = i, ZIndex = 23, OnClick = function()
			state.garageTab = tab
			UI.Refresh()
		end })
	end
	panels.bulk = {}
	for i, r in ipairs({ "Common", "Uncommon" }) do
		panels.bulk[r] = toy(tabs, { Text = "SELL ALL " .. string.upper(r), Color = P.red, Size = UDim2.fromOffset(250, 48), TextSize = 16, LayoutOrder = 10 + i, ZIndex = 23, OnClick = function()
			local st = store.State
			local uids, total = {}, 0
			for _, car in ipairs(st.cars) do
				local def = CarConfig.ById[car.typeId]
				if not car.slot and def.rarity == r and #uids &lt; 100 then
					table.insert(uids, car.uid)
					total = total + CarConfig.SellPrice(def, car.level)
				end
			end
			if #uids == 0 then
				UI.Toast("No " .. r .. " cars in storage", "warn")
				return
			end
			UI.Confirm("SELL " .. #uids .. " CARS?", string.format("All %s cars in storage for &lt;b&gt;$%s&lt;/b&gt;.\nParked cars are never sold.", r, Util.FormatNumber(total)), "SELL ALL", P.red, function()
				actions.SellMany(uids)
			end)
		end })
	end
	panels.carList = scroller(c, UDim2.fromOffset(0, 120), UDim2.new(1, 0, 1, -120))
end

local function sortedCars(st)
	local out = table.clone(st.cars)
	table.sort(out, function(a, b)
		local ia = CarConfig.CarIncome(a)
		local ib = CarConfig.CarIncome(b)
		if ia ~= ib then
			return ia &gt; ib
		end
		return a.uid &lt; b.uid
	end)
	return out
end

local function freeSlot(st)
	local used, worst, worstInc = {}, nil, nil
	for _, c in ipairs(st.cars) do
		if c.slot then
			used[c.slot] = true
			local inc = CarConfig.CarIncome(c)
			if not worstInc or inc &lt; worstInc then
				worst, worstInc = c.slot, inc
			end
		end
	end
	for i = 1, st.slots do
		if not used[i] then
			return i
		end
	end
	return worst or 1
end

local function refreshGarage()
	local st = store.State
	if not st or state.open ~= "garage" then
		return
	end
	local parked, stored = 0, 0
	for _, c in ipairs(st.cars) do
		if c.slot then
			parked = parked + 1
		else
			stored = stored + 1
		end
	end
	panels.garageInfo.Text = string.format('&lt;font color="#1E9E40"&gt;+%s/s&lt;/font&gt;   Bays %d/%d   Cars %d', Util.FormatNumber(store.Income), parked, st.slots, #st.cars)
	local cost = EconomyConfig.SlotCosts[st.slots + 1]
	local floors = st.floors or 1
	if cost and st.slots + 1 &gt; floors * 6 then
		local fc = EconomyConfig.FloorCosts[floors + 1]
		panels.slotBtn.SetText("+ LEVEL " .. (floors + 1), "$" .. Util.FormatNumber(fc))
		panels.slotBtn.SetColor(store.Money &gt;= fc and P.orange or P.grey)
	elseif cost then
		panels.slotBtn.SetText(T("btn_buyslot"), "$" .. Util.FormatNumber(cost))
		panels.slotBtn.SetColor(store.Money &gt;= cost and P.blue or P.grey)
	else
		panels.slotBtn.SetText(T("btn_max"), "")
		panels.slotBtn.SetColor(P.grey)
	end
	local tab = state.garageTab
	panels.garageTabs.parked.SetText(string.format("PARKED %d", parked), nil)
	panels.garageTabs.storage.SetText(string.format("STORAGE %d", stored), nil)
	panels.garageTabs.parked.SetColor(tab == "parked" and P.orange or P.grey)
	panels.garageTabs.storage.SetColor(tab == "storage" and P.orange or P.grey)
	for _, b in pairs(panels.bulk) do
		b.holder.Visible = tab == "storage"
	end
	clear(panels.carList)
	local cars = {}
	for _, car in ipairs(sortedCars(st)) do
		if (tab == "parked") == (car.slot ~= nil) then
			table.insert(cars, car)
		end
	end
	if #cars == 0 then
		local msg = #st.cars == 0 and T("garage_empty") or (tab == "parked" and "No cars parked. Open STORAGE and press PARK." or "Storage is empty. Cars you REMOVE from the garage wait here.")
		text(panels.carList, { Text = msg, Font = BODY, TextSize = 20, TextColor3 = P.muted, TextWrapped = true, Size = UDim2.new(1, 0, 0, 60), ZIndex = 23 })
		return
	end
	for i, c in ipairs(cars) do
		local def = CarConfig.ById[c.typeId]
		local rc = rarityColor(def.rarity)
		local row = new("Frame", { Size = UDim2.new(1, 0, 0, 88), BackgroundColor3 = P.white, LayoutOrder = i, ZIndex = 23 }, panels.carList)
		corner(row, 18)
		stroke(row, rc, 4)
		if i &lt;= 24 then
			carViewport(row, def, { Position = UDim2.fromOffset(8, 6), Size = UDim2.fromOffset(120, 76), ZIndex = 24 })
		end
		text(row, { Text = def.name, TextSize = 22, TextColor3 = P.ink, Outline = false, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(136, 10), Size = UDim2.fromOffset(260, 28), ZIndex = 24 })
		local where = c.slot and ("Bay " .. c.slot) or "Storage"
		text(row, { Text = string.format('&lt;font color="#%s"&gt;%s&lt;/font&gt; · Lv %d · &lt;font color="#1E9E40"&gt;+%s/s&lt;/font&gt; · %s', rc:ToHex(), string.upper(T("rarity_" .. def.rarity)),
			c.level, Util.FormatNumber(CarConfig.CarIncome(c)), where),
			Font = BODY, TextSize = 14, TextColor3 = P.muted, RichText = true, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(136, 46), Size = UDim2.fromOffset(260, 24), ZIndex = 24 })
		local btns = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(470, 60), BackgroundTransparency = 1, ZIndex = 24 }, row)
		list(btns, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
		if c.slot then
			toy(btns, { Text = T("btn_remove"), Sub = "to storage", SubSize = 12, Color = P.orange, Size = UDim2.fromOffset(104, 56), TextSize = 17, LayoutOrder = 1, ZIndex = 25, OnClick = function() actions.Remove(c.uid) end })
		else
			toy(btns, { Text = T("btn_place"), Sub = "in a bay", SubSize = 12, Color = P.green, Size = UDim2.fromOffset(104, 56), TextSize = 18, LayoutOrder = 1, ZIndex = 25, OnClick = function() actions.Place(c.uid, freeSlot(st)) end })
		end
		if c.level &gt;= def.maxLevel then
			toy(btns, { Text = T("btn_max"), Color = P.grey, Size = UDim2.fromOffset(140, 56), LayoutOrder = 2, ZIndex = 25 })
		else
			local ucost = CarConfig.UpgradeCost(def, c.level)
			local partId, amount = CarConfig.UpgradeParts(def, c.level)
			local ok = store.Money &gt;= ucost and (st.parts[partId] or 0) &gt;= amount
			toy(btns, { Text = T("btn_upgrade"), Sub = string.format("$%s + %d %s", Util.FormatNumber(ucost), amount, T("part_" .. partId)), SubSize = 12, TextSize = 17,
				Color = ok and P.blue or P.grey, Size = UDim2.fromOffset(140, 56), LayoutOrder = 2, ZIndex = 25, OnClick = function() actions.Upgrade(c.uid, c.level) end })
		end
		local tuned = 0
		for _ in pairs(c.tune or {}) do
			tuned = tuned + 1
		end
		toy(btns, { Text = T("btn_tune"), Sub = tuned &gt; 0 and (tuned .. "/7") or nil, SubSize = 12, TextSize = 17, Color = P.yellow, Size = UDim2.fromOffset(84, 56),
			LayoutOrder = 3, ZIndex = 25, OnClick = function()
				if UI.OnTune then
					UI.OnTune(c.uid)
				end
			end })
		local price = CarConfig.SellPrice(def, c.level)
		toy(btns, { Text = T("btn_sell"), Sub = "$" .. Util.FormatNumber(price), SubSize = 12, TextSize = 17, Color = P.red, Size = UDim2.fromOffset(96, 56), LayoutOrder = 4, ZIndex = 25,
			OnClick = function()
				UI.Confirm("SELL THIS CAR?", string.format("&lt;b&gt;%s&lt;/b&gt;  Lv %d\nfor &lt;b&gt;$%s&lt;/b&gt;", def.name, c.level, Util.FormatNumber(price)), "SELL $" .. Util.FormatNumber(price), P.red, function()
					actions.Sell(c.uid)
				end, def)
			end })
	end
end

-- CARS index
local function buildIndex()
	local p = panelShell("index", T("index_title"), 900, 580, P.green)
	panels.indexInfo = text(p.content, { Text = "", Font = BODY, TextSize = 19, TextColor3 = P.ink, Size = UDim2.new(1, 0, 0, 26), ZIndex = 22 })
	local s = new("ScrollingFrame", { Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 1, -34), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 8,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 22 }, p.content)
	new("UIGridLayout", { CellSize = UDim2.fromOffset(196, 150), CellPadding = UDim2.fromOffset(12, 12), SortOrder = Enum.SortOrder.LayoutOrder }, s)
	panels.indexGrid = s
	panels.indexCards = {}
end

local function refreshIndex()
	local st = store.State
	if not st or state.open ~= "index" then
		return
	end
	local found, total, _, mult = CarConfig.IndexStats(st.discovered or {})
	panels.indexInfo.Text = T("index_found", found, total) .. "   ·   " .. T("index_bonus", string.format("%.2f", mult)) .. "   ·   " .. T("index_hint")
	for i, def in ipairs(CarConfig.List) do
		local known = st.discovered and st.discovered[def.id]
		local cd = panels.indexCards[def.id]
		if not cd or cd.known ~= known then
			if cd then
				cd.frame:Destroy()
			end
			local rc = rarityColor(def.rarity)
			local f = new("Frame", { BackgroundColor3 = known and P.white or C(60, 64, 76), LayoutOrder = i, ZIndex = 23 }, panels.indexGrid)
			corner(f, 18)
			stroke(f, rc, 4)
			if known then
				carViewport(f, def, { Size = UDim2.new(1, 0, 1, -44), ZIndex = 24 })
			else
				text(f, { Text = "?", TextSize = 70, Size = UDim2.new(1, 0, 1, -44), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = rc, ZIndex = 24 })
			end
			text(f, { Text = known and def.name or T("index_unknown"), TextSize = 17, TextColor3 = known and P.ink or P.white, Outline = false, AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.new(0, 0, 1, -20), Size = UDim2.new(1, 0, 0, 22), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
			text(f, { Text = string.upper(T("rarity_" .. def.rarity)), Font = BODY, TextSize = 14, TextColor3 = rc, AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.new(0, 0, 1, -2), Size = UDim2.new(1, 0, 0, 18), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
			panels.indexCards[def.id] = { frame = f, known = known }
		end
	end
end

function UI.TogglePanel(name)
	if name ~= nil and state.cine then
		return -- no menus over a cinematic
	end
	if name ~= nil and state.open == name then
		name = nil
	end
	closeConfirm()
	for n, p in pairs(panels) do
		if type(p) == "table" and p.root and p.scale then
			if n == name then
				p.root.Visible = true
				p.scale.Scale = 0.6
				tween(p.scale, 0.28, { Scale = 1 }, Enum.EasingStyle.Back)
			else
				p.root.Visible = false
			end
		end
	end
	state.open = name
	if name then
		UI.Sfx("open")
	end
	noteLayout()
	pcall(function() -- world prompts (E/F at the garage, NPCs) only when no panel is open
		game:GetService("ProximityPromptService").Enabled = name == nil and not state.cine
	end)
	UI.Refresh()
end

-- Cinematic mode (car drop, batch reveal): the whole HUD hides, open panels close and cannot open,
-- proximity prompts and movement are off. Calls are counted, every SetCinematic(true) has one SetCinematic(false).
local cineDepth = 0
function UI.SetCinematic(on)
	cineDepth = math.max(0, cineDepth + (on and 1 or -1))
	local active = cineDepth &gt; 0
	if (state.cine == true) == active then
		return
	end
	state.cine = active
	root.Visible = not active
	hud.toasts.Visible = not active
	Players.LocalPlayer:SetAttribute("Cinematic", active) -- world helpers (guide beam) hide too
	pcall(function()
		game:GetService("ProximityPromptService").Enabled = not active and state.open == nil
	end)
	if active then
		-- a failing hook must never leave the game half in cinematic mode
		pcall(UI.CloseOverlays)
		pcall(UI.TogglePanel, nil) -- closing is allowed in cinematic mode, opening is not
	end
	pcall(function()
		local pm = require(Players.LocalPlayer:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
		local controls = pm:GetControls()
		if active then
			controls:Disable()
		else
			controls:Enable()
		end
	end)
	if not active then
		pcall(UI.Refresh)
	end
end

function UI.IsCinematic()
	return state.cine == true
end

-- other modules register closers for their own pop-ups (trade request card, confirm dialogs, ...)
UI.Overlays = { closeConfirm }
function UI.CloseOverlays()
	for _, fn in ipairs(UI.Overlays) do
		pcall(fn)
	end
end

---------------------------------------------------------------- reveal
local function buildReveal()
	-- showcase: blurred world, rarity backdrop with turning rays + light streaks, car spinning on a glowing turntable
	local r = new("TextButton", { Name = "Reveal", Text = "", AutoButtonColor = false, Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(6, 7, 12), BackgroundTransparency = 0, Visible = false, ZIndex = 60 }, overlay)
	local glow = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.48), Size = UDim2.fromScale(1.4, 1.4), BackgroundColor3 = P.yellow, BackgroundTransparency = 0, BorderSizePixel = 0, ZIndex = 60 }, r)
	new("UIAspectRatioConstraint", {}, glow)
	corner(glow, 2000)
	local glowGrad = new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(0.5, 0.85), NumberSequenceKeypoint.new(1, 1) }), Rotation = 90 }, glow)
	local rays = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Size = UDim2.fromOffset(10, 10), BackgroundTransparency = 1, ZIndex = 60 }, r)
	for k = 0, 11 do
		local ray = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(2000, 60), Rotation = k * 15, BackgroundColor3 = P.yellow, BackgroundTransparency = 0.8, BorderSizePixel = 0, ZIndex = 60 }, rays)
		new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.2), NumberSequenceKeypoint.new(1, 1) }) }, ray)
	end
	-- light streaks sweeping across + floating sparkles
	local streaks, sparks = {}, {}
	for k = 1, 3 do
		local st = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0.5, 0, 0, 6 + k * 3), Rotation = -18, BackgroundColor3 = C(255, 255, 255), BackgroundTransparency = 0.6, BorderSizePixel = 0, ZIndex = 61 }, r)
		new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) }) }, st)
		streaks[k] = st
	end
	for k = 1, 26 do
		local sp = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(6, 6), BackgroundColor3 = C(255, 255, 255), BorderSizePixel = 0, ZIndex = 61 }, r)
		corner(sp, 3)
		sparks[k] = { f = sp, x = math.random(), y = math.random(), v = 0.03 + math.random() * 0.06, s = 3 + math.random() * 7 }
	end
	local box = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(700, 640), BackgroundTransparency = 1, ZIndex = 61 }, r)
	local sc = new("UIScale", {}, box)
	local top = text(box, { Text = T("reveal_new"), TextSize = 34, Size = UDim2.new(1, 0, 0, 40), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 62 })
	local badge = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 46), Size = UDim2.fromOffset(330, 54), BackgroundColor3 = P.white, ZIndex = 62 }, box)
	corner(badge, 27)
	stroke(badge, P.ink, 4)
	local badgeGrad = gradient(badge, P.yellow)
	local rarity = text(badge, { Text = "", TextSize = 36, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 63, Outline = 3 })
	-- turntable: glowing ellipse under the car
	local disc = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(350, 352), Size = UDim2.fromOffset(470, 90), BackgroundColor3 = P.yellow, BorderSizePixel = 0, ZIndex = 61 }, box)
	corner(disc, 200)
	new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(0.5, 0.25), NumberSequenceKeypoint.new(1, 0.9) }) }, disc)
	local ring = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(350, 352), Size = UDim2.fromOffset(420, 70), BackgroundTransparency = 1, ZIndex = 61 }, box)
	corner(ring, 200)
	local ringStroke = stroke(ring, P.white, 4)
	local vpHolder = new("Frame", { Position = UDim2.fromOffset(40, 106), Size = UDim2.fromOffset(620, 300), BackgroundTransparency = 1, ZIndex = 62 }, box)
	local name = text(box, { Text = "", TextSize = 64, Position = UDim2.fromOffset(0, 410), Size = UDim2.new(1, 0, 0, 70), TextXAlignment = Enum.TextXAlignment.Center, Outline = 4, ZIndex = 62 })
	local info = text(box, { Text = "", Font = BODY, TextSize = 24, Position = UDim2.fromOffset(0, 482), Size = UDim2.new(1, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Center, RichText = true, ZIndex = 62 })
	local stamp = text(box, { Text = "NEW!", TextSize = 46, TextColor3 = P.yellow, Rotation = -14, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(600, 120), Size = UDim2.fromOffset(160, 60), TextXAlignment = Enum.TextXAlignment.Center, Outline = 4, ZIndex = 64, Visible = false })
	local ok = toy(box, { Text = T("btn_awesome"), Color = P.green, Size = UDim2.fromOffset(300, 86), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), ZIndex = 63,
		OnClick = function() UI.HideReveal() end })
	panels.reveal = { root = r, rays = rays, box = box, sc = sc, top = top, badgeGrad = badgeGrad, rarity = rarity, vpHolder = vpHolder, name = name, info = info, ok = ok,
		glow = glow, glowGrad = glowGrad, disc = disc, ringStroke = ringStroke, streaks = streaks, sparks = sparks, stamp = stamp }
	r.Activated:Connect(function()
		if os.clock() - (panels.reveal.shownAt or 0) &gt; 0.8 then -- ignore the tap that was still meant for the throw
			UI.HideReveal()
		end
	end)
end

function UI.HideReveal()
	local rv = panels.reveal
	if rv.root.Visible then
		rv.root.Visible = false
		if rv.conn then
			rv.conn:Disconnect()
			rv.conn = nil
		end
		if rv.blur then
			rv.blur:Destroy()
			rv.blur = nil
		end
		local cb = rv.onClosed
		rv.onClosed = nil
		if cb then
			cb()
		end
	end
end

function UI.ShowReveal(res, onClosed)
	local rv = panels.reveal
	rv.onClosed = onClosed
	local def = CarConfig.ById[res.typeId]
	if not def then
		return
	end
	local rc = rarityColor(res.rarity)
	rv.top.Text = res.isNew and T("reveal_new") or T("reveal_got")
	rv.badgeGrad.Color = ColorSequence.new(lift(rc, 0.35), rc)
	rv.rarity.Text = "★ " .. string.upper(T("rarity_" .. res.rarity)) .. " ★"
	rv.name.Text = string.upper(def.name)
	rv.name.TextColor3 = rc
	local lines = { string.format('&lt;font color="#34D058"&gt;+%s/s&lt;/font&gt;', Util.FormatNumber(CarConfig.IncomeAt(def, 1))) }
	table.insert(lines, res.slot and T("reveal_placed", res.slot) or T("reveal_stored"))
	if res.isNew and res.bonus and res.bonus &gt; 0 then
		table.insert(lines, T("reveal_first", Util.FormatNumber(res.bonus)))
	end
	if res.pityUsed then
		table.insert(lines, T("reveal_pity"))
	end
	rv.info.Text = table.concat(lines, "  ·  ")
	for _, ray in ipairs(rv.rays:GetChildren()) do
		ray.BackgroundColor3 = rc
	end
	rv.glow.BackgroundColor3 = rc
	rv.disc.BackgroundColor3 = rc
	rv.ringStroke.Color = lift(rc, 0.4)
	rv.stamp.Visible = res.isNew == true
	for _, sp in ipairs(rv.sparks) do
		sp.f.BackgroundColor3 = math.random() &lt; 0.5 and rc or C(255, 255, 255)
	end
	clear(rv.vpHolder)
	local vp, model = carViewport(rv.vpHolder, def, { Size = UDim2.fromScale(1, 1), ZIndex = 62 })
	if not rv.blur then
		rv.blur = new("BlurEffect", { Name = "RevealBlur", Size = 0 }, game:GetService("Lighting"))
		tween(rv.blur, 0.35, { Size = 22 })
	end
	rv.root.Visible = true
	rv.shownAt = os.clock()
	rv.sc.Scale = 0.2
	tween(rv.sc, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	UI.Sfx("fanfare")
	local lvl = CarConfig.Rarities[res.rarity].index
	local t0 = os.clock()
	if rv.conn then
		rv.conn:Disconnect()
	end
	rv.conn = RunService.RenderStepped:Connect(function(dt)
		local t = os.clock() - t0
		rv.rays.Rotation = t * (18 + lvl * 4)
		rv.glow.Size = UDim2.fromScale(1.3 + math.sin(t * 2) * 0.05, 1.3 + math.sin(t * 2) * 0.05)
		for k, st in ipairs(rv.streaks) do
			local ph = ((t * (0.35 + k * 0.12)) + k * 0.33) % 1.6 - 0.3
			st.Position = UDim2.fromScale(ph, 0.25 + k * 0.18)
		end
		for _, sp in ipairs(rv.sparks) do
			sp.y = sp.y - sp.v * dt * (1 + lvl * 0.3)
			if sp.y &lt; -0.05 then
				sp.y, sp.x = 1.05, math.random()
			end
			sp.f.Position = UDim2.fromScale(sp.x + math.sin(t + sp.s) * 0.01, sp.y)
			sp.f.Size = UDim2.fromOffset(sp.s, sp.s)
			sp.f.BackgroundTransparency = 0.2 + 0.6 * math.abs(math.sin(t * 3 + sp.s))
		end
		rv.stamp.Rotation = -14 + math.sin(t * 4) * 4
		if model.Parent then
			fitCamera(vp, model, math.rad(35) + t * 0.9)
		end
	end)
end

---------------------------------------------------------------- refresh
local function refreshHud()
	local st = store.State
	hud.money.Text = "$" .. Util.FormatNumber(store.Money)
	hud.income.Text = "+" .. Util.FormatNumber(store.Income) .. " / sec"
	local carried = store.CarriedTotal()
	hud.bag.Visible = carried &gt; 0
	if carried &gt; 0 then
		local cap = st.carryCap or EconomyConfig.CarryCapacity
		local risk = st.run and st.run.risk or 1
		hud.bagText.Text = string.format("CARRYING  %d / %d", carried, cap) .. (risk &gt; 1 and string.format("   RISK x%s", risk) or "")
		hud.bagFill.Size = UDim2.fromScale(math.clamp(carried / cap, 0, 1), 1)
	end
	hud.throw.holder.Visible = state.nearTrap and state.open == nil
	-- "can unlock" dot on TELEPORT
	local dot = false
	for i, zid in ipairs(MapConfig.ZoneOrder) do
		local req = EconomyConfig.ZoneUnlock[zid]
		if req and (req.rebirths or 0) &lt;= (st.rebirths or 0) and not st.zones[zid] and st.zones[MapConfig.ZoneOrder[i - 1]] and store.Money &gt;= req.cost and store.CollectionValue &gt;= req.minValue then
			dot = true
		end
	end
	hud.newDot.Visible = dot
	hud.canUnlock = dot
end

-- the single next goal after the tutorial: { title, body } (shown by Tutorial's objective card)
local function refreshHint()
	local st = store.State
	local goal
	if store.CarriedTotal() &gt; 0 then
		goal = { "BANK YOUR LOOT", "Run home to the plaza, or reach the district CHECKPOINT to save it" }
	elseif store.BankedTotal() &gt; 0 and state.nearTrap then
		goal = { "THROW YOUR PARTS", "Press THROW and pick how many of each part" }
	end
	-- (v13: no "unlock the next district" card after the tutorial - the tutorial asks for the Highway once)
	hud.nextGoal = goal
	hud.hintFrame.Visible = false
end

UI.Hooks = {}

function UI.Refresh()
	if not store.State then
		return
	end
	for _, fn in ipairs(UI.Hooks) do
		fn(store.State, state.open)
	end
	refreshHud()
	refreshThrow()
	refreshHint()
	refreshGarage()
	refreshIndex()
	refreshTeleport()
end

function UI.SetZoneName(zoneId)
	if hud.lastZone == zoneId then
		return
	end
	hud.lastZone = zoneId
	hud.zone.Text = string.upper(T("zone_" .. zoneId))
	local c = ZONE_COLOR[zoneId] or P.orange
	hud.bannerGrad.Color = ColorSequence.new(lift(c, 0.35), c)
end

function UI.SetNearTrap(v)
	if state.nearTrap ~= v then
		state.nearTrap = v
		if not v and state.open == "throw" then
			UI.TogglePanel(nil)
		end
		refreshHud()
	end
end

function UI.FlashFrame()
	return hud.flash
end

function UI.Gui()
	return gui
end

function UI.Init(storeModule, actionTable)
	store, actions = storeModule, actionTable
	local player = Players.LocalPlayer
	gui = new("ScreenGui", { Name = "MainUI", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 10 })
	pcall(function()
		gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	end)
	root = new("Frame", { Name = "Root", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, gui)
	local uiScale = new("UIScale", {}, root)
	-- above the Cine layer (45), same scale as the HUD: nothing of a pop-up can fall off a phone screen
	overlay = new("Frame", { Name = "Overlay", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 60 }, gui)
	local ovScale = new("UIScale", {}, overlay)
	local function rescale()
		local vp = gui.AbsoluteSize.Magnitude &gt; 0 and gui.AbsoluteSize or (Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize) or Vector2.new(1280, 720)
		local s = math.clamp(math.min(vp.Y / 760, vp.X / 1240), 0.5, 1.2)
		uiScale.Scale, ovScale.Scale = s, s
		root.Size = UDim2.fromScale(1 / s, 1 / s)
		overlay.Size = UDim2.fromScale(1 / s, 1 / s)
	end
	rescale()
	if Workspace.CurrentCamera then
		Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	end
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(rescale)
	-- ElevenLabs SFX when uploaded (SoundIds), otherwise Roblox built-in sounds
	local SoundIds = require(Shared:WaitForChild("SoundIds"))
	local FALLBACK = {
		click = { "rbxasset://sounds/button.wav", 0.35 }, open = { "rbxasset://sounds/swoosh.wav", 0.25, 1.3 },
		err = { "rbxasset://sounds/uuhhh.mp3", 0.3, 1.2 }, ping = { "rbxasset://sounds/electronicpingshort.wav", 0.45, 1.2 },
		throw = { "rbxasset://sounds/swoosh.wav", 0.6, 1.4 }, clank = { "rbxasset://sounds/clickfast.wav", 0.6, 0.6 },
		charge = { "rbxasset://sounds/electronicpingshort.wav", 0.3, 0.5 }, reveal = { "rbxasset://sounds/Rocket shot.wav", 0.6, 0.8 },
		revealBig = { "rbxasset://sounds/Rocket shot.wav", 0.8, 0.6 }, land = { "rbxasset://sounds/collide.wav", 0.8, 0.6 },
		drive = { "rbxasset://sounds/swoosh.wav", 0.4, 0.6 }, pickup = { "rbxasset://sounds/electronicpingshort.wav", 0.5, 1.5 },
		pickupBig = { "rbxasset://sounds/electronicpingshort.wav", 0.6, 1.1 }, bank = { "rbxasset://sounds/victory.wav", 0.35, 1.3 },
		bankCombo = { "rbxasset://sounds/victory.wav", 0.5 }, combo = { "rbxasset://sounds/electronicpingshort.wav", 0.5, 1.8 },
		cash = { "rbxasset://sounds/victory.wav", 0.5, 1.2 }, siren = { "rbxasset://sounds/electronicpingshort.wav", 0.2, 0.9 },
		crash = { "rbxasset://sounds/collide.wav", 0.9, 0.8 }, wrecked = { "rbxasset://sounds/uuhhh.mp3", 0.5 },
		airbag = { "rbxasset://sounds/Rocket shot.wav", 0.5, 1.6 }, whoosh = { "rbxasset://sounds/swoosh.wav", 0.6, 0.8 },
		fanfare = { "rbxasset://sounds/victory.wav", 0.5 }, hit = { "rbxasset://sounds/collide.wav", 0.9, 0.8 },
		boom = { "rbxasset://sounds/Rocket shot.wav", 0.7, 0.7 },
		step = { "rbxasset://sounds/electronicpingshort.wav", 0.18, 1.6 }, -- tutorial step: soft and short
	}
	for name, fb in pairs(FALLBACK) do
		local id = SoundIds[name]
		if id and id &gt; 0 then
			makeSound(name, "rbxassetid://" .. id, name == "step" and 0.35 or fb[2] + 0.15, 1)
		else
			makeSound(name, fb[1], fb[2], fb[3])
		end
	end
	if SoundIds.ambience and SoundIds.ambience &gt; 0 then
		local amb = new("Sound", { Name = "Ambience", SoundId = "rbxassetid://" .. SoundIds.ambience, Volume = 0.25, Looped = true, SoundGroup = UI.MusicGroup }, SoundService)
		amb:Play()
	end
	-- relaxing background music (ElevenLabs), looped; its volume is the Music slider (Settings)
	if SoundIds.music and SoundIds.music &gt; 0 then
		local music = new("Sound", { Name = "Music", SoundId = "rbxassetid://" .. SoundIds.music, Volume = 0.6, Looped = true, SoundGroup = UI.MusicGroup }, SoundService)
		music:Play()
	end
	buildHud()
	buildThrow()
	buildTeleport()
	buildGarage()
	buildIndex()
	buildReveal()
	gui.Parent = player:WaitForChild("PlayerGui")
	UI.SetZoneName("plaza")

	local lastMoney = 0
	store.Changed.Event:Connect(UI.Refresh)
	store.MoneyChanged.Event:Connect(function()
		if store.Money &gt; lastMoney then
			hud.moneyScale.Scale = 1.08
			tween(hud.moneyScale, 0.2, { Scale = 1 })
		end
		lastMoney = store.Money
		refreshHud()
	end)
	UI.Refresh()
end

-- toolkit for the other UI modules (UIExtra, Markers, Minimap)
function UI.Kit()
	return {
		new = new, toy = toy, text = text, corner = corner, stroke = stroke, gradient = gradient, list = list, clear = clear,
		tween = tween, pill = pill, lift = lift, panelShell = panelShell, scroller = scroller, carViewport = carViewport,
		P = P, HEAD = HEAD, BODY = BODY, root = root, gui = gui, overlay = overlay, hud = hud, panels = panels, state = state, store = store,
		actions = actions, PART_ICON = PART_ICON, confirm = UI.Confirm,
	}
end

return UI
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX51"><Properties><string name="Name">WorldFx</string><ProtectedString name="Source">local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MapConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MapConfig"))

local MOODS = {
	plaza = { clock = 14.3, bright = 2.3, tint = Color3.fromRGB(255, 250, 244), sat = 0.16, amb = Color3.fromRGB(132, 128, 118) },
	city = { clock = 14.3, bright = 2.3, tint = Color3.fromRGB(255, 250, 240), sat = 0.16, amb = Color3.fromRGB(132, 128, 118) },
	highway = { clock = 15.9, bright = 2.2, tint = Color3.fromRGB(255, 244, 226), sat = 0.14, amb = Color3.fromRGB(134, 124, 116) },
	industrial = { clock = 17.3, bright = 2.0, tint = Color3.fromRGB(255, 234, 212), sat = 0.06, amb = Color3.fromRGB(130, 110, 104) },
	neon = { clock = 20.4, bright = 1.4, tint = Color3.fromRGB(214, 236, 255), sat = 0.35, amb = Color3.fromRGB(60, 110, 150) },
	scrapyard = { clock = 17.8, bright = 1.9, tint = Color3.fromRGB(255, 226, 200), sat = 0.1, amb = Color3.fromRGB(130, 104, 96) },
	docks = { clock = 9.2, bright = 2.0, tint = Color3.fromRGB(236, 246, 255), sat = 0.1, amb = Color3.fromRGB(110, 124, 136) },
	desert = { clock = 13.0, bright = 2.6, tint = Color3.fromRGB(255, 236, 206), sat = 0.12, amb = Color3.fromRGB(150, 128, 104) },
	bridge = { clock = 11.0, bright = 2.3, tint = Color3.fromRGB(246, 252, 255), sat = 0.18, amb = Color3.fromRGB(124, 134, 140) },
	airport = { clock = 15.0, bright = 2.3, tint = Color3.fromRGB(250, 250, 255), sat = 0.12, amb = Color3.fromRGB(128, 130, 136) },
	canyon = { clock = 18.2, bright = 2.0, tint = Color3.fromRGB(255, 214, 180), sat = 0.2, amb = Color3.fromRGB(150, 100, 80) },
	circuit = { clock = 14.0, bright = 2.4, tint = Color3.fromRGB(255, 250, 244), sat = 0.2, amb = Color3.fromRGB(132, 128, 118) },
	drift = { clock = 21.0, bright = 1.3, tint = Color3.fromRGB(240, 220, 255), sat = 0.35, amb = Color3.fromRGB(90, 70, 130) },
	storm = { clock = 19.6, bright = 0.9, tint = Color3.fromRGB(190, 206, 220), sat = -0.1, amb = Color3.fromRGB(70, 80, 96) },
	rush = { clock = 16.8, bright = 2.1, tint = Color3.fromRGB(255, 236, 214), sat = 0.14, amb = Color3.fromRGB(134, 120, 110) },
	colosseum = { clock = 17.0, bright = 2.2, tint = Color3.fromRGB(255, 232, 200), sat = 0.16, amb = Color3.fromRGB(150, 126, 100) },
}
local mood = { clock = 14.3, bright = 2.3, tint = Color3.fromRGB(255, 250, 244), sat = 0.16, amb = Color3.fromRGB(132, 128, 118) }
local tintFx
local lastBackfire = 0
local spinAcc = 0

local Fx = {}
local spinning = {}
local gates = {}
local store

local function applyGate(part)
	local zone = part:GetAttribute("ZoneId")
	local unlocked = store.State and store.State.zones and store.State.zones[zone] == true
	part.CanCollide = not unlocked
	part.Transparency = unlocked and 1 or 0
	for _, g in ipairs(part:GetChildren()) do
		if g:IsA("SurfaceGui") then
			g.Enabled = not unlocked
		end
	end
end

local function addSpin(model)
	local root = model:IsA("Model") and model.PrimaryPart or model:FindFirstChild("Root")
	if not root then
		task.wait(0.2)
		root = model.PrimaryPart or model:FindFirstChild("Root")
	end
	if root then
		spinning[model] = { root = root, base = root.CFrame, phase = math.random() * 6 }
	end
end

function Fx.Start(storeModule)
	store = storeModule
	for _, m in ipairs(CollectionService:GetTagged("SpinBob")) do
		task.spawn(addSpin, m)
	end
	CollectionService:GetInstanceAddedSignal("SpinBob"):Connect(function(m)
		task.spawn(addSpin, m)
	end)
	CollectionService:GetInstanceRemovedSignal("SpinBob"):Connect(function(m)
		spinning[m] = nil
	end)
	local function regGate(p)
		gates[p] = true
		applyGate(p)
	end
	for _, p in ipairs(CollectionService:GetTagged("ZoneGate")) do
		regGate(p)
	end
	CollectionService:GetInstanceAddedSignal("ZoneGate"):Connect(regGate)
	store.Changed.Event:Connect(function()
		for p in pairs(gates) do
			if p.Parent then
				applyGate(p)
			end
		end
	end)
	tintFx = Lighting:FindFirstChild("ZoneTint") or Instance.new("ColorCorrectionEffect")
	tintFx.Name = "ZoneTint"
	tintFx.Parent = Lighting
	RunService.RenderStepped:Connect(function(dt)
		local cam = Workspace.CurrentCamera
		if cam then
			local target = MOODS[MapConfig.ZoneAt(cam.CFrame.Position.Z)] or MOODS.city
			local a = math.min(1, dt * 1.2)
			mood.clock = mood.clock + (target.clock - mood.clock) * a
			mood.bright = mood.bright + (target.bright - mood.bright) * a
			mood.sat = mood.sat + (target.sat - mood.sat) * a
			mood.tint = mood.tint:Lerp(target.tint, a)
			mood.amb = mood.amb:Lerp(target.amb, a)
			Lighting.ClockTime = mood.clock
			Lighting.Brightness = mood.bright
			Lighting.OutdoorAmbient = mood.amb
			tintFx.TintColor = mood.tint
			tintFx.Saturation = mood.sat
		end
		local t = os.clock()
		-- (v10: showcase cars stand still on static stands - no turntable spinning)
		if t - lastBackfire &gt; 2.2 then
			lastBackfire = t
			local camPos = cam and cam.CFrame.Position or Vector3.zero
			for _, att in ipairs(CollectionService:GetTagged("Backfire")) do
				if att.Parent and (att.WorldPosition - camPos).Magnitude &lt; 140 and math.random() &lt; 0.45 then
					local fire = att:FindFirstChildOfClass("ParticleEmitter")
					if fire then
						fire:Emit(14)
					end
				end
			end
		end
		for m, s in pairs(spinning) do
			if s.root.Parent then
				s.root.CFrame = s.base * CFrame.Angles(0, t * 2 + s.phase, 0) + Vector3.new(0, math.sin(t * 2 + s.phase) * 0.5, 0)
			else
				spinning[m] = nil
			end
		end
	end)
end

function Fx.Hit(dir, flashFrame)
	local char = Players.LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.AssemblyLinearVelocity = dir.Unit * 70 + Vector3.new(0, 40, 0)
	end
	if flashFrame then
		flashFrame.BackgroundTransparency = 0.55
		task.spawn(function()
			for i = 1, 10 do
				flashFrame.BackgroundTransparency = 0.55 + i * 0.045
				task.wait(0.03)
			end
			flashFrame.BackgroundTransparency = 1
		end)
	end
end

return Fx
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXB824A7442B2C4EECB5354C618C1FC55A"><Properties><string name="Name">Backpack</string><ProtectedString name="Source">-- BACKPACK: right-column button -&gt; panel with every part type: 3D icon, name, rarity and how many you have.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local Icons = require(Shared:WaitForChild("Icons"))

local Backpack = {}
local K, UI, P
local cells = {}

local function refresh(_, open)
	if open ~= "backpack" then
		return
	end
	for id, c in pairs(cells) do
		local n = K.store.Banked(id)
		c.count.Text = "x" .. n
		c.icon.ImageTransparency = n &gt; 0 and 0 or 0.6
		c.count.TextColor3 = n &gt; 0 and P.ink or P.grey
	end
end

function Backpack.Start(ui)
	UI = ui
	K = UI.Kit()
	P = K.P
	-- 5th button in the right column
	local holder = K.new("Frame", { Size = UDim2.fromOffset(122, 104), BackgroundTransparency = 1, LayoutOrder = 5 }, K.hud.side)
	K.toy(holder, { Text = "BACKPACK", Image = "backpack", Icon = "🎒", Color = P.orange, Size = UDim2.fromOffset(122, 104), OnClick = function() UI.TogglePanel("backpack") end })

	local p = K.panelShell("backpack", "BACKPACK", 760, 520, P.orange)
	local grid = K.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 22 }, p.content)
	K.new("UIGridLayout", { CellSize = UDim2.fromOffset(132, 190), CellPadding = UDim2.fromOffset(12, 14), HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder }, grid)
	for i, id in ipairs(PartConfig.Order) do
		local part = PartConfig.Parts[id]
		local rc = CarConfig.Rarities[part.rarity].color
		local f = K.new("Frame", { BackgroundColor3 = P.white, LayoutOrder = i, ZIndex = 23 }, grid)
		K.corner(f, 16)
		K.stroke(f, rc, 3)
		local icon = K.new("ImageLabel", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8), Size = UDim2.fromOffset(92, 92), BackgroundTransparency = 1,
			Image = Icons.Get(id) or "", ScaleType = Enum.ScaleType.Fit, ZIndex = 24 }, f)
		K.text(f, { Text = part.name, TextSize = 16, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(6, 102), Size = UDim2.new(1, -12, 0, 22),
			TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
		K.text(f, { Text = string.upper(part.rarity), Font = K.BODY, TextSize = 13, TextColor3 = rc, Position = UDim2.fromOffset(6, 124), Size = UDim2.new(1, -12, 0, 18),
			TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
		local count = K.text(f, { Text = "x0", TextSize = 24, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(6, 146), Size = UDim2.new(1, -12, 0, 30),
			TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
		cells[id] = { icon = icon, count = count }
	end
	table.insert(UI.Hooks, refresh)
end

return Backpack
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXBD5AFE4CA7C64469BDAA9C9D665D454F"><Properties><string name="Name">BatchReveal</string><ProtectedString name="Source">-- Batch throw reveal: parts rain onto the lift, a fast reel of every car (slowing down on the best one),
-- then a results grid. "SEE BEST CAR" plays the full showcase + drive-in for the best car.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local Util = require(Shared:WaitForChild("Util"))

local BR = {}
local K, UI, Cine, TrapFx
local P
local C = Color3.fromRGB
local root, blur, conn
local holding = false -- holds UI cinematic mode while the reel / grid is up

local function rc(r)
	return CarConfig.Rarities[r].color
end

local function close()
	if conn then
		conn:Disconnect()
		conn = nil
	end
	if root then
		root:Destroy()
		root = nil
	end
	if blur then
		blur:Destroy()
		blur = nil
	end
	if holding then
		holding = false
		if not TrapFx.IsBusy() then -- the car showcase keeps its own blackout
			Cine.Darken(0, 0.35)
		end
		UI.SetCinematic(false)
	end
end

local function card(parent, r, order, big)
	local def = CarConfig.ById[r.typeId]
	local f = K.new("Frame", { Size = UDim2.fromOffset(big and 170 or 150, big and 190 or 160), BackgroundColor3 = P.white, LayoutOrder = order, ZIndex = 72 }, parent)
	K.corner(f, 16)
	K.stroke(f, rc(r.rarity), 4)
	-- rarity strip inside the straight part of the top edge (it used to poke out of the rounded corners)
	local band = K.new("Frame", { Position = UDim2.fromOffset(16, 4), Size = UDim2.new(1, -32, 0, 6), BackgroundColor3 = rc(r.rarity), BorderSizePixel = 0, ZIndex = 73 }, f)
	K.corner(band, 3)
	return f, def
end

local function grid(res)
	local scr = K.new("Frame", { Name = "Grid", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(940, 600), BackgroundColor3 = P.cream, ZIndex = 70, Active = true }, root)
	-- a tap outside the card closes the results (on small screens the buttons were the only way out)
	local r = root
	task.delay(0.6, function()
		if r and root == r then -- only the results screen it was made for
			r.Activated:Connect(close)
		end
	end)
	K.corner(scr, 28)
	K.stroke(scr, P.ink, 5)
	local sc = K.new("UIScale", { Scale = 0.6 }, scr)
	K.tween(sc, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	local counts, bonus, merged, newN = {}, 0, 0, 0
	for _, r in ipairs(res.cars) do
		counts[r.rarity] = (counts[r.rarity] or 0) + 1
		bonus = bonus + (r.bonus or 0)
		merged = merged + (r.merged and 1 or 0)
		newN = newN + (r.isNew and 1 or 0)
	end
	K.text(scr, { Text = string.format("YOU GOT %d CARS", #res.cars), TextSize = 40, Position = UDim2.fromOffset(28, 14), Size = UDim2.new(1, -56, 0, 44), ZIndex = 71, Outline = 3 })
	local parts = {}
	for _, r in ipairs(CarConfig.RarityOrder) do
		if counts[r] then
			table.insert(parts, string.format('&lt;font color="#%s"&gt;%d %s&lt;/font&gt;', rc(r):ToHex(), counts[r], r))
		end
	end
	local extra = {}
	if newN &gt; 0 then
		table.insert(extra, newN .. " new")
	end
	if merged &gt; 0 then
		table.insert(extra, merged .. " merged")
	end
	if bonus &gt; 0 then
		table.insert(extra, "discovery +$" .. Util.FormatNumber(bonus))
	end
	K.text(scr, { Text = table.concat(parts, "   ") .. (#extra &gt; 0 and ("     ·     " .. table.concat(extra, "  ·  ")) or ""), Font = K.BODY, TextSize = 18, TextColor3 = P.ink, RichText = true,
		Position = UDim2.fromOffset(28, 62), Size = UDim2.new(1, -56, 0, 24), ZIndex = 71 })
	local list = K.new("ScrollingFrame", { Position = UDim2.fromOffset(20, 96), Size = UDim2.new(1, -40, 1, -190), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 8,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 71 }, scr)
	K.new("UIGridLayout", { CellSize = UDim2.fromOffset(160, 170), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder }, list)
	-- best first, then by rarity
	local order = {}
	for i, r in ipairs(res.cars) do
		table.insert(order, { i = i, r = r })
	end
	table.sort(order, function(a, b)
		if a.i == res.best then
			return true
		elseif b.i == res.best then
			return false
		end
		local ra, rb = CarConfig.Rarities[a.r.rarity].index, CarConfig.Rarities[b.r.rarity].index
		if ra ~= rb then
			return ra &gt; rb
		end
		return a.i &lt; b.i
	end)
	for k, o in ipairs(order) do
		local r = o.r
		local f, def = card(list, r, k)
		if k &lt;= 12 then
			K.carViewport(f, def, { Position = UDim2.fromOffset(4, 12), Size = UDim2.new(1, -8, 0, 92), ZIndex = 73 })
		else
			local tile = K.new("Frame", { Position = UDim2.fromOffset(10, 18), Size = UDim2.new(1, -20, 0, 80), BackgroundColor3 = rc(r.rarity), BackgroundTransparency = 0.6, ZIndex = 73 }, f)
			K.corner(tile, 12)
		end
		K.text(f, { Text = def.name, Font = K.BODY, TextSize = 15, TextColor3 = P.ink, TextWrapped = true, Position = UDim2.fromOffset(6, 104), Size = UDim2.new(1, -12, 0, 34), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 73 })
		local tag, col
		if r.merged then
			tag, col = "MERGED  Lv" .. r.merged, P.blue
		elseif r.sold then
			tag, col = "SOLD +$" .. Util.FormatNumber(r.sold), P.grey
		elseif r.isNew then
			tag, col = "NEW!", P.orange
		elseif r.slot then
			tag, col = "PARKED", P.green
		else
			tag, col = "STORED", P.muted
		end
		local t = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -6), Size = UDim2.new(1, -16, 0, 22), BackgroundColor3 = col, ZIndex = 73 }, f)
		K.corner(t, 11)
		K.text(t, { Text = tag, TextSize = 14, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 74 })
		if o.i == res.best then
			K.stroke(f, P.yellow, 6)
		end
	end
	local btns = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -14), Size = UDim2.fromOffset(640, 72), BackgroundTransparency = 1, ZIndex = 71 }, scr)
	K.list(btns, Enum.FillDirection.Horizontal, 20, Enum.HorizontalAlignment.Center)
	K.toy(btns, { Text = "SEE BEST CAR", Color = P.orange, Size = UDim2.fromOffset(300, 70), TextSize = 26, LayoutOrder = 1, ZIndex = 72, OnClick = function()
		local best = res.cars[res.best]
		local st = K.store.State
		-- start the showcase first so the HUD does not flash back between the grid and the cinematic
		task.defer(close)
		TrapFx.Play({ partId = best.partId, typeId = best.typeId, rarity = best.rarity, slot = best.slot, isNew = best.isNew, bonus = best.bonus, speed = 1.6, animTime = 0 }, st and st.baseIndex)
	end })
	K.toy(btns, { Text = "DONE", Color = P.green, Size = UDim2.fromOffset(220, 70), TextSize = 28, LayoutOrder = 2, ZIndex = 72, OnClick = close })
end

-- fast reel: cards slide right-to-left, decelerate and stop on the best car
local function reel(res, onDone)
	local strip = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 0, 0, 230), BackgroundColor3 = C(14, 16, 24),
		BackgroundTransparency = 0.2, ZIndex = 70 }, root)
	local marker = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(6, 250), BackgroundColor3 = P.yellow, ZIndex = 75 }, root)
	K.corner(marker, 3)
	local track = K.new("Frame", { Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromOffset(0, 230), BackgroundTransparency = 1, ZIndex = 71 }, strip)
	-- sequence: shuffled filler cars then the best one, padded so the strip keeps going past it
	local seq = {}
	for i, r in ipairs(res.cars) do
		if i ~= res.best then
			table.insert(seq, r)
		end
	end
	for i = #seq, 2, -1 do
		local j = math.random(1, i)
		seq[i], seq[j] = seq[j], seq[i]
	end
	while #seq &lt; 18 do
		table.insert(seq, res.cars[math.random(1, #res.cars)])
	end
	local stopAt = #seq + 1
	table.insert(seq, res.cars[res.best])
	for _ = 1, 4 do
		table.insert(seq, res.cars[math.random(1, #res.cars)])
	end
	local W = 180
	for k, r in ipairs(seq) do
		local f = card(track, r, k)
		f.Position = UDim2.fromOffset((k - 1) * W, 30)
		K.text(f, { Text = CarConfig.ById[r.typeId].name, Font = K.BODY, TextSize = 16, TextColor3 = P.ink, TextWrapped = true, Position = UDim2.fromOffset(6, 70), Size = UDim2.new(1, -12, 0, 40),
			TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 73 })
		K.text(f, { Text = string.upper(r.rarity), TextSize = 16, TextColor3 = rc(r.rarity), Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 73 })
	end
	local target = (stopAt - 1) * W + 75 -- card centre under the marker
	local dur = 2.6
	local t0 = os.clock()
	local done = false
	local lastTick = 0
	local function finish()
		if done then
			return
		end
		done = true
		track.Position = UDim2.new(0.5, -target, 0, 0)
		UI.Sfx(CarConfig.Rarities[res.cars[res.best].rarity].index &gt;= 4 and "revealBig" or "reveal")
		Cine.Shake(0.6, 0.3)
		task.delay(0.8, function()
			strip:Destroy()
			marker:Destroy()
			onDone()
		end)
	end
	conn = RunService.RenderStepped:Connect(function()
		if done then
			return
		end
		local a = math.min(1, (os.clock() - t0) / dur)
		local e = 1 - (1 - a) ^ 3
		local x = e * target
		track.Position = UDim2.new(0.5, -x, 0, 0)
		local tick = math.floor(x / W)
		if tick ~= lastTick then
			lastTick = tick
			UI.Sfx("click")
		end
		if a &gt;= 1 then
			finish()
		end
	end)
	root.Activated:Connect(finish)
end

function BR.Play(res)
	if not res or not res.cars or #res.cars == 0 then
		return
	end
	close()
	holding = true
	UI.SetCinematic(true)
	-- blackout: the world fades to fully dark, the reel and the grid sit on a solid backdrop
	Cine.Darken(1, 0.25)
	Cine.Shake(0.9, 0.35)
	UI.Sfx("throw")
	root = K.new("TextButton", { Name = "BatchReveal", Text = "", AutoButtonColor = false, Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(6, 7, 12), BackgroundTransparency = 1, ZIndex = 69 }, K.overlay)
	K.tween(root, 0.25, { BackgroundTransparency = 0 })
	blur = K.new("BlurEffect", { Size = 18 }, Lighting)
	reel(res, function()
		if root then
			grid(res)
		end
	end)
end

BR.Close = close

function BR.Start(ui, cine, trap)
	UI = ui
	K = UI.Kit()
	P = K.P
	Cine = cine
	TrapFx = trap
	require(Shared:WaitForChild("Net")).Get("ThrowBatchResult").OnClientEvent:Connect(BR.Play)
end

return BR
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXD469CDD9BD7C4BF79773E9EEBBB6EFB6"><Properties><string name="Name">BossFx</string><ProtectedString name="Source">-- Boss HUD + effects: big "THROW!" button appears when a monster truck is close, the cheapest part flies at it,
-- stars when it is stunned, dust when it flees.
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Strings = require(Shared:WaitForChild("Strings"))
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local MapConfig = require(Shared:WaitForChild("MapConfig"))

local T = Strings.T
local BossFx = {}
local K, UI, Cine
local w = {}
local RANGE = 80

local function cheapest(st)
	for _, id in ipairs(PartConfig.Order) do
		if (st.carried and st.carried[id] or 0) &gt; 0 then
			return id
		end
	end
	for _, id in ipairs(PartConfig.Order) do
		if (st.parts and st.parts[id] or 0) &gt; 0 then
			return id
		end
	end
	return nil
end

local function build()
	local root = K.root
	local holder = K.new("Frame", { Name = "BossThrow", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -170), Size = UDim2.fromOffset(300, 170),
		BackgroundTransparency = 1, Visible = false }, root)
	local hint = K.text(holder, { Text = T("boss_hint"), TextSize = 24, TextColor3 = K.P.white, Size = UDim2.new(1, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Center })
	w.btn = K.toy(holder, { Text = T("boss_throw"), Icon = "🔧", Color = K.P.red, Size = UDim2.fromOffset(240, 110), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 38),
		TextSize = 40, OnClick = function()
			Net.Get("BossThrow"):FireServer()
			UI.Sfx("throw")
		end })
	w.hint = hint
	w.holder = holder
	w.pips = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 152), Size = UDim2.fromOffset(80, 16), BackgroundTransparency = 1 }, holder)
	K.list(w.pips, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center)
	w.pip = {}
	for i = 1, 2 do
		w.pip[i] = K.new("Frame", { Size = UDim2.fromOffset(16, 16), BackgroundColor3 = K.P.grey }, w.pips)
		K.corner(w.pip[i], 8)
		K.stroke(w.pip[i], K.P.ink, 2)
	end
end

local function nearestBoss(pos)
	local folder = Workspace:FindFirstChild("Bosses")
	if not folder then
		return nil
	end
	local best, bd
	for _, m in ipairs(folder:GetChildren()) do
		if m.PrimaryPart then
			local d = (m.PrimaryPart.Position - pos).Magnitude
			if not bd or d &lt; bd then
				best, bd = m, d
			end
		end
	end
	return best, bd
end

local function flyPart(from, to, partId)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(1.6, 1.6, 1.6)
	p.Color = PartConfig.Parts[partId] and PartConfig.Parts[partId].color or Color3.new(1, 1, 1)
	p.Material = Enum.Material.Metal
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
	p.Parent = Workspace
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local a = math.min(1, (os.clock() - t0) / 0.5)
		local pos = from:Lerp(to + Vector3.new(0, 6, 0), a) + Vector3.new(0, math.sin(a * math.pi) * 12, 0)
		p.CFrame = CFrame.new(pos) * CFrame.Angles(a * 9, a * 7, 0)
		if a &gt;= 1 then
			conn:Disconnect()
			p:Destroy()
		end
	end)
end

local function burst(pos, color, n)
	local a = Instance.new("Part")
	a.Anchored, a.CanCollide, a.CanQuery, a.CanTouch = true, false, false, false
	a.Transparency = 1
	a.Size = Vector3.one
	a.CFrame = CFrame.new(pos)
	a.Parent = Workspace
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(color)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 0) })
	e.Speed = NumberRange.new(10, 22)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Lifetime = NumberRange.new(0.6, 1)
	e.Rate = 0
	e.Parent = a
	e:Emit(n or 24)
	task.delay(1.5, function()
		a:Destroy()
	end)
end

function BossFx.Start(ui, cine)
	UI = ui
	K = UI.Kit()
	Cine = cine
	build()
	Net.Get("BossFx").OnClientEvent:Connect(function(ev)
		if ev.event == "throw" then
			flyPart(ev.from + Vector3.new(0, 2, 0), ev.to, ev.part)
			task.delay(0.5, function()
				burst(ev.to + Vector3.new(0, 6, 0), Color3.fromRGB(255, 220, 80), 30)
				UI.Sfx("clank")
			end)
		elseif ev.event == "flee" then
			burst(ev.pos + Vector3.new(0, 3, 0), Color3.fromRGB(200, 180, 150), 50)
			UI.Sfx("fanfare")
			if Cine then
				Cine.Title(T("boss_fleeing"), Color3.fromRGB(255, 210, 63))
			end
		elseif ev.event == "smash" then
			UI.Sfx("crash")
		end
	end)
	RunService.Heartbeat:Connect(function()
		local char = Players.LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local st = K.store.State
		local show = false
		if hrp and st then
			local zone = MapConfig.Zones[MapConfig.ZoneAt(hrp.Position.Z)]
			if zone and zone.arena then
				local boss, d = nearestBoss(hrp.Position)
				if boss and d &lt; RANGE and boss:GetAttribute("Mode") ~= "flee" then
					show = true
					local part = cheapest(st)
					local hits = boss:GetAttribute("Hits") or 0
					for i = 1, 2 do
						w.pip[i].BackgroundColor3 = i &lt;= hits and K.P.yellow or K.P.grey
					end
					w.btn.SetColor(part and K.P.red or K.P.grey)
					w.hint.Text = part and (T("boss_hint") .. "  " .. (K.PART_ICON[part] or "")) or T("boss_empty")
				end
			end
		end
		if w.holder.Visible ~= show then
			w.holder.Visible = show
			if show then
				w.holder.Size = UDim2.fromOffset(200, 110)
				TweenService:Create(w.holder, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(300, 170) }):Play()
				UI.Sfx("siren")
			end
		end
	end)
end

return BossFx
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6D842F21142445E9A4A3B984AB602F76"><Properties><string name="Name">Checkpoint</string><ProtectedString name="Source">-- Checkpoint choice card: SAVE &amp; GO HOME (bank now, teleport to the garage) or RISK IT (next district, bigger multiplier).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local Util = require(Shared:WaitForChild("Util"))
local Strings = require(Shared:WaitForChild("Strings"))

local T = Strings.T
local CP = {}
local K, UI, Cine
local P
local C = Color3.fromRGB
local open

local function zoneName(z)
	return z and T("zone_" .. z) or ""
end

local function close()
	if open then
		open:Destroy()
		open = nil
		UI.SetDialog(false)
	end
end

local function fmtMult(m)
	return (m % 1 == 0) and string.format("x%d", m) or string.format("x%.1f", m)
end

local function show(o)
	close()
	UI.Sfx("ping")
	local dim = K.new("Frame", { Name = "Checkpoint", Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(0, 0, 0), BackgroundTransparency = 0.55, ZIndex = 80 }, K.overlay)
	open = dim
	UI.SetDialog(true)
	local card = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(760, 420), BackgroundColor3 = P.cream, ZIndex = 81 }, dim)
	K.corner(card, 28)
	K.stroke(card, P.ink, 5)
	local sc = K.new("UIScale", { Scale = 0.6 }, card)
	K.tween(sc, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	local head = K.new("Frame", { Size = UDim2.new(1, 0, 0, 70), BackgroundColor3 = P.yellow, ZIndex = 82 }, card)
	K.corner(head, 28)
	K.stroke(head, P.ink, 5)
	K.text(head, { Text = string.upper(zoneName(o.zone)) .. " CLEARED!", TextSize = 36, Position = UDim2.fromOffset(28, 0), Size = UDim2.new(1, -56, 1, 0), ZIndex = 83, Outline = 3 })
	local banked = math.floor(o.carried * o.combo * o.risk + 0.5)
	K.text(card, { Text = string.format("You carry &lt;b&gt;%d parts&lt;/b&gt;  ·  combo %s  ·  risk %s", o.carried, fmtMult(o.combo), fmtMult(o.risk)), Font = K.BODY, TextSize = 19, TextColor3 = P.ink,
		RichText = true, Position = UDim2.fromOffset(28, 84), Size = UDim2.new(1, -56, 0, 26), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 82 })
	-- two big choice cards
	local function choice(x, color, title, lines, btnText, enabled, onPick)
		local f = K.new("Frame", { Position = UDim2.fromOffset(x, 124), Size = UDim2.fromOffset(340, 270), BackgroundColor3 = P.white, ZIndex = 82 }, card)
		K.corner(f, 22)
		K.stroke(f, enabled and color or P.grey, 5)
		K.text(f, { Text = title, TextSize = 28, TextColor3 = enabled and color or P.grey, Position = UDim2.fromOffset(0, 14), Size = UDim2.new(1, 0, 0, 34), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 83, Outline = 2 })
		K.text(f, { Text = lines, Font = K.BODY, TextSize = 17, TextColor3 = P.ink, RichText = true, TextWrapped = true, Position = UDim2.fromOffset(18, 56), Size = UDim2.new(1, -36, 0, 110),
			TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 83 })
		K.toy(f, { Text = btnText, Color = enabled and color or P.grey, Size = UDim2.fromOffset(290, 72), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -16), TextSize = 24, ZIndex = 84,
			OnClick = function()
				if enabled then
					close()
					onPick()
				end
			end })
	end
	choice(28, P.green, "SAVE", string.format("Bank your loot now and teleport home.\n\n&lt;b&gt;+%d parts&lt;/b&gt; safe in your garage.", banked), "SAVE &amp; GO HOME", true, function()
		UI.QuietBankUntil = os.clock() + 4 -- the bank that follows plays one soft sound, not a fanfare stack
		Net.Get("CheckpointChoice"):FireServer("save")
	end)
	local riskText, can
	if not o.nextZone then
		riskText, can = "This is the last district. Bank your loot!", false
	elseif not o.nextOpen then
		riskText, can = string.format("Unlock &lt;b&gt;%s&lt;/b&gt; first\n($%s in TELEPORT).", zoneName(o.nextZone), Util.FormatNumber(o.price or 0)), false
	else
		local after = math.floor(o.carried * o.combo * o.nextRisk + 0.5)
		riskText = string.format("Jump to &lt;b&gt;%s&lt;/b&gt; and cross it.\nLoot becomes &lt;b&gt;%s&lt;/b&gt; (%d parts)\n&lt;font color=\"#D6342C\"&gt;one hit = lose everything&lt;/font&gt;", zoneName(o.nextZone), fmtMult(o.nextRisk), after)
		can = true
	end
	choice(392, P.red, "RISK IT", riskText, "RISK &amp; CONTINUE", can, function()
		Net.Get("CheckpointChoice"):FireServer("risk")
	end)
	K.toy(card, { Text = "X", Color = P.red, Size = UDim2.fromOffset(60, 64), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 14, 0, -18), ZIndex = 85, OnClick = close })
end

function CP.Start(ui, cine)
	UI = ui
	K = UI.Kit()
	P = K.P
	Cine = cine
	table.insert(UI.Overlays, close) -- wrecked while the card is up: the card goes away
	Net.Get("CheckpointOffer").OnClientEvent:Connect(show)
	Net.Get("CheckpointFx").OnClientEvent:Connect(function(fx)
		if fx.choice == "risk" then
			Cine.Flash(Color3.fromRGB(255, 80, 60), 0.3, 0.6)
			Cine.Title("RISK " .. fmtMult(fx.risk), Color3.fromRGB(255, 90, 70), 1.2, 110, 0.35)
			UI.Sfx("whoosh")
		else
			Cine.Flash(Color3.fromRGB(80, 220, 120), 0.2, 0.5) -- (the bank sound already played: no second chime)
		end
	end)
end

return CP
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX152D4874AB1F42B8BB748A46177AAA7D"><Properties><string name="Name">CineFx</string><ProtectedString name="Source">-- Cinematic toolkit: camera shake / zoom / takeover, letterbox, darken, flash, glitch, big titles.
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local Cine = {}
local layer, vignette, flash, topBar, botBar, glitchHolder, titleHolder
local cc, blur
local shakes = {}
local scripted = false

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = parent
	return o
end
local function tw(o, t, props, style, dir)
	local x = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	x:Play()
	return x
end

function Cine.Init(gui)
	layer = new("Frame", { Name = "Cine", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 45 }, gui)
	vignette = new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 45, BorderSizePixel = 0 }, layer)
	topBar = new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), Size = UDim2.new(1, 0, 0, 0), ZIndex = 47, BorderSizePixel = 0 }, layer)
	botBar = new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 0), ZIndex = 47, BorderSizePixel = 0 }, layer)
	glitchHolder = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 48, ClipsDescendants = true }, layer)
	titleHolder = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 49 }, layer)
	flash = new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 50, BorderSizePixel = 0 }, layer)
	cc = new("ColorCorrectionEffect", { Name = "CineCC" }, Lighting)
	blur = new("BlurEffect", { Name = "CineBlur", Size = 0 }, Lighting)

	RunService:BindToRenderStep("CineShake", Enum.RenderPriority.Camera.Value + 1, function()
		local cam = Workspace.CurrentCamera
		if not cam then
			return
		end
		local now = os.clock()
		local amp = 0
		for i = #shakes, 1, -1 do
			local s = shakes[i]
			local a = (now - s.t0) / s.dur
			if a &gt;= 1 then
				table.remove(shakes, i)
			else
				amp = amp + s.mag * (1 - a) ^ 2
			end
		end
		-- undo last frame's offset if nothing else moved the camera (scriptable cam without tween)
		if Cine._last and cam.CFrame == Cine._last.result then
			cam.CFrame = Cine._last.base
		end
		Cine._last = nil
		if amp &gt; 0.001 then
			local function r()
				return (math.random() * 2 - 1) * amp
			end
			local base = cam.CFrame
			cam.CFrame = base * CFrame.new(r() * 0.25, r() * 0.25, 0) * CFrame.Angles(math.rad(r()), math.rad(r()), math.rad(r() * 1.4))
			Cine._last = { base = base, result = cam.CFrame }
		end
	end)
end

function Cine.Shake(mag, dur)
	if game:GetService("Players").LocalPlayer:GetAttribute("Opt_shake") == false then
		return -- Settings: camera shake off
	end
	table.insert(shakes, { mag = mag, dur = dur or 0.4, t0 = os.clock() })
end

local flashTween
function Cine.Flash(color, from, t)
	if flashTween then
		flashTween:Cancel() -- a new flash restarts cleanly instead of fighting the previous tween
	end
	flash.BackgroundColor3 = color or Color3.new(1, 1, 1)
	flash.BackgroundTransparency = from or 0
	flashTween = tw(flash, t or 0.4, { BackgroundTransparency = 1 })
end

function Cine.Darken(alpha, t)
	tw(vignette, t or 0.3, { BackgroundTransparency = 1 - alpha })
end

function Cine.Letterbox(on, t)
	local h = on and 0.11 or 0
	tw(topBar, t or 0.35, { Size = UDim2.new(1, 0, h, 0) })
	tw(botBar, t or 0.35, { Size = UDim2.new(1, 0, h, 0) })
end

function Cine.Grade(props, t)
	tw(cc, t or 0.3, props)
end

function Cine.Blur(size, t)
	tw(blur, t or 0.3, { Size = size })
end

function Cine.Zoom(fov, t, style)
	local cam = Workspace.CurrentCamera
	if cam then
		tw(cam, t or 0.4, { FieldOfView = fov }, style)
	end
end

-- RGB-split glitch: horizontal slices + red/cyan bars + grade flicker
-- "impact" pulse: short colour/contrast flicker + shake (no overlay bars, nothing drawn over the scene)
function Cine.Glitch(dur, power)
	power = power or 1
	task.spawn(function()
		local t0 = os.clock()
		local flip = false
		while os.clock() - t0 &lt; dur do
			flip = not flip
			cc.TintColor = flip and Color3.fromRGB(255, 225, 225) or Color3.fromRGB(225, 245, 255)
			cc.Contrast = 0.15 * power
			Cine.Shake(0.4 * power, 0.08)
			task.wait(0.06)
		end
		cc.TintColor = Color3.new(1, 1, 1)
		cc.Contrast = 0
	end)
end

-- Big punchy title. Only one at a time: a new title replaces the one on screen (they used to draw on top of each other).
local currentTitle
function Cine.Title(text, color, dur, sizePx, yScale)
	if currentTitle and currentTitle.Parent then
		currentTitle:Destroy()
	end
	local holder = new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, yScale or 0.4),
		Size = UDim2.fromOffset(1000, sizePx or 140), ZIndex = 49, Rotation = -3 }, titleHolder)
	local shadow = new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.LuckiestGuy, Text = text, TextScaled = true,
		TextColor3 = Color3.fromRGB(27, 31, 42), TextTransparency = 0.35, Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(6, 8), ZIndex = 49 }, holder)
	local main = new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.LuckiestGuy, Text = text, TextScaled = true,
		TextColor3 = color, Size = UDim2.fromScale(1, 1), ZIndex = 50 }, holder)
	new("UIStroke", { Color = Color3.fromRGB(27, 31, 42), Thickness = 6 }, main)
	new("UIGradient", { Color = ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.45), color), Rotation = 90 }, main)
	currentTitle = holder
	local sc = new("UIScale", { Scale = 2.2 }, holder)
	tw(sc, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(dur or 1.5, function()
		if not holder.Parent then
			return
		end
		tw(sc, 0.2, { Scale = 0.7 })
		tw(main, 0.2, { TextTransparency = 1 })
		tw(shadow, 0.2, { TextTransparency = 1 })
		for _, st in ipairs(main:GetChildren()) do
			if st:IsA("UIStroke") then
				tw(st, 0.2, { Transparency = 1 })
			end
		end
		task.wait(0.22)
		holder:Destroy()
	end)
	return holder
end

local currentSub
function Cine.Sub(text, color, dur, yScale)
	if currentSub and currentSub.Parent then
		currentSub:Destroy()
	end
	local l = new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.LuckiestGuy, Text = text, TextScaled = true, TextColor3 = color,
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, yScale or 0.56), Size = UDim2.fromOffset(1100, 44), ZIndex = 50, TextTransparency = 1 }, titleHolder)
	new("UITextSizeConstraint", { MaxTextSize = 34 }, l) -- long lines shrink instead of running off the screen
	new("UIStroke", { Color = Color3.fromRGB(27, 31, 42), Thickness = 3 }, l)
	currentSub = l
	tw(l, 0.25, { TextTransparency = 0 })
	task.delay(dur or 1.5, function()
		if l.Parent then
			tw(l, 0.25, { TextTransparency = 1 })
			task.wait(0.3)
			l:Destroy()
		end
	end)
	return l
end

-- Camera takeover helpers
function Cine.Take()
	local cam = Workspace.CurrentCamera
	scripted = true
	cam.CameraType = Enum.CameraType.Scriptable
	return cam
end

function Cine.Move(cf, t, style)
	local cam = Workspace.CurrentCamera
	return tw(cam, t, { CFrame = cf }, style or Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
end

function Cine.Release(t)
	local cam = Workspace.CurrentCamera
	scripted = false
	cam.CameraType = Enum.CameraType.Custom
	Cine.Zoom(70, t or 0.4)
end

function Cine.IsScripted()
	return scripted
end

function Cine.Reset(t)
	t = t or 0.4
	Cine.Darken(0, t)
	Cine.Letterbox(false, t)
	Cine.Grade({ Saturation = 0, Contrast = 0, Brightness = 0, TintColor = Color3.new(1, 1, 1) }, t)
	Cine.Blur(0, t)
end

return Cine
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXCD3B51B69ABE4E1FBE739AA32A46F00E"><Properties><string name="Name">ClientFx</string><ProtectedString name="Source">-- Small feedback effects: pickups, banking, donations, airbag, the Golden Magnate's coin toss.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local Cine = require(script.Parent:WaitForChild("CineFx"))

local Fx = {}
local K, UI
local C = Color3.fromRGB
local GOLD = C(232, 178, 50)
local SPARK = "rbxasset://textures/particles/sparkles_main.dds"

local function tw(o, t, props, style, dir)
	local x = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	x:Play()
	return x
end

local function anchor(pos)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Transparency = 1
	p.Size = Vector3.one
	p.Position = pos
	p.Parent = Workspace
	return p
end

function Fx.Burst(pos, color, count, speed)
	local p = anchor(pos)
	local e = Instance.new("ParticleEmitter")
	e.Texture = SPARK
	e.Color = ColorSequence.new(color)
	e.LightEmission = 0.6
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0) })
	e.Lifetime = NumberRange.new(0.5, 0.9)
	e.Speed = NumberRange.new(speed or 14, (speed or 14) * 1.6)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Drag = 4
	e.Rate = 0
	e.ZOffset = 1
	e.Parent = p
	e:Emit(count or 20)
	task.delay(1.6, function()
		p:Destroy()
	end)
end

-- floating world text
function Fx.Float(pos, text, color)
	local p = anchor(pos)
	local bb = K.new("BillboardGui", { Adornee = p, AlwaysOnTop = true, Size = UDim2.fromOffset(200, 50), LightInfluence = 0 }, K.gui.Parent)
	local l = K.text(bb, { Text = text, TextSize = 30, TextColor3 = color, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Outline = 3 })
	local sc = K.new("UIScale", { Scale = 0.3 }, l)
	tw(sc, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	tw(p, 1.1, { Position = pos + Vector3.new(0, 6, 0) })
	task.delay(0.7, function()
		tw(l, 0.4, { TextTransparency = 1 })
	end)
	task.delay(1.2, function()
		bb:Destroy()
		p:Destroy()
	end)
end

function Fx.Pickup(info)
	local def = PartConfig.Parts[info.partId]
	local color = def and CarConfig.Rarities[def.rarity].color or GOLD
	Fx.Burst(info.pos + Vector3.new(0, 3, 0), color, info.risk == "road" and 40 or 22)
	Fx.Float(info.pos + Vector3.new(0, 5, 0), "+" .. info.amount .. " " .. (K.PART_ICON[info.partId] or ""), color)
	if info.risk == "road" then
		Cine.Shake(0.4, 0.2)
	end
	UI.Sfx(info.risk == "road" and "pickupBig" or "pickup")
end

-- icons fly from the middle of the screen into the parts row
function Fx.Bank(info)
	local target = UDim2.fromOffset(120, 108)
	local i = 0
	for id, n in pairs(info.parts or {}) do
		for _ = 1, math.min(n, 4) do
			i = i + 1
			local delayT = i * 0.06
			task.delay(delayT, function()
				local l = K.text(K.root, { Text = K.PART_ICON[id] or "⚙️", Font = K.BODY, TextSize = 40, AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.new(0.5, math.random(-60, 60), 0.55, math.random(-30, 30)), Size = UDim2.fromOffset(50, 50),
					TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 45 })
				tw(l, 0.55, { Position = target, TextSize = 22 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				task.delay(0.56, function()
					l:Destroy()
				end)
			end)
		end
	end
	local msg = "+" .. info.moved
	if info.bonus &gt; 0 then
		msg = msg .. "  +" .. info.bonus .. " COMBO"
	end
	if Fx._bankPop and Fx._bankPop.Parent then
		Fx._bankPop:Destroy() -- one "+N" at a time: a quick second bank replaces the first
	end
	local big = K.text(K.root, { Text = msg, TextSize = 46, TextColor3 = K.P.yellow, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(700, 60), TextXAlignment = Enum.TextXAlignment.Center, Outline = 4, ZIndex = 45 })
	local sc = K.new("UIScale", { Scale = 0.2 }, big)
	tw(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	Fx._bankPop = big
	big.Visible = K.state.open == nil -- never draw over an open panel
	task.delay(1.3, function()
		if not big.Parent then
			return
		end
		tw(big, 0.3, { TextTransparency = 1 })
		for _, st in ipairs(big:GetChildren()) do
			if st:IsA("UIStroke") then
				tw(st, 0.3, { Transparency = 1 })
			end
		end
		task.wait(0.32)
		big:Destroy()
	end)
	local quiet = os.clock() &lt; (UI.QuietBankUntil or 0) -- banked through a checkpoint: one soft sound only
	if info.cash and info.cash &gt; 0 then
		UI.Toast("⏱ SPEED BONUS +$" .. info.cash, "good", true)
	end
	if quiet then
		UI.Sfx("soft")
	else
		UI.Sfx(info.bonus &gt; 0 and "bankCombo" or "bank")
	end
end

-- golden coin rain over the screen (buyer) / gold burst (everyone else)
function Fx.Donate(buyer, key)
	if buyer == Players.LocalPlayer then
		for k = 1, 26 do
			task.delay(k * 0.03, function()
				local l = K.text(K.gui, { Text = "🪙", Font = K.BODY, TextSize = math.random(26, 44), Position = UDim2.new(math.random(), 0, -0.1, 0),
					Size = UDim2.fromOffset(50, 50), ZIndex = 55 })
				tw(l, 1.4 + math.random() * 0.6, { Position = UDim2.new(l.Position.X.Scale, 0, 1.1, 0), Rotation = math.random(-200, 200) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				task.delay(2.1, function()
					l:Destroy()
				end)
			end)
		end
		Cine.Flash(GOLD, 0.6, 0.6)
		UI.Sfx("cash")
	end
	local c = buyer and buyer.Character
	local hrp = c and c:FindFirstChild("HumanoidRootPart")
	if hrp then
		Fx.Burst(hrp.Position + Vector3.new(0, 3, 0), GOLD, 50, 20)
	end
end

function Fx.Airbag(dir)
	local c = Players.LocalPlayer.Character
	local hrp = c and c:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.AssemblyLinearVelocity = dir.Unit * 60 + Vector3.new(0, 35, 0)
		Fx.Burst(hrp.Position, C(255, 255, 255), 40, 18)
	end
	Cine.Shake(1.6, 0.4)
	Cine.Flash(C(255, 255, 255), 0.3, 0.4)
	UI.Toast("🛡️ AIRBAG SAVED YOU!", "warn")
	UI.Sfx("airbag")
end

-- the Golden Magnate flips a coin and his hat sparkles
local function magnate()
	local npc
	repeat
		task.wait(2)
		for _, m in ipairs(Workspace:GetChildren()) do
			if m:IsA("Model") and m:GetAttribute("Magnate") then
				npc = m
			end
		end
	until npc
	local hand = npc:FindFirstChild("RightHand")
	local head = npc:FindFirstChild("Head")
	if head then
		local att = Instance.new("Attachment")
		att.Position = Vector3.new(0, 1.4, 0)
		att.Parent = head
		local e = Instance.new("ParticleEmitter")
		e.Texture = SPARK
		e.Color = ColorSequence.new(GOLD)
		e.LightEmission = 0.8
		e.Size = NumberSequence.new(0.35, 0)
		e.Lifetime = NumberRange.new(0.6, 1)
		e.Speed = NumberRange.new(1, 2)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Rate = 4
		e.Parent = att
	end
	while npc.Parent and hand do
		task.wait(3 + math.random() * 2)
		local coin = Instance.new("Part")
		coin.Shape = Enum.PartType.Cylinder
		coin.Size = Vector3.new(0.12, 0.9, 0.9)
		coin.Color = GOLD
		coin.Material = Enum.Material.Metal
		coin.Reflectance = 0.3
		coin.Anchored, coin.CanCollide, coin.CanQuery, coin.CanTouch = true, false, false, false
		local p0 = hand.Position + Vector3.new(0, 0.6, 0)
		coin.CFrame = CFrame.new(p0)
		coin.Parent = Workspace
		local t0 = os.clock()
		local conn
		conn = RunService.RenderStepped:Connect(function()
			local a = (os.clock() - t0) / 0.9
			if a &gt;= 1 or not coin.Parent then
				conn:Disconnect()
				coin:Destroy()
				return
			end
			local h = math.sin(a * math.pi) * 5
			coin.CFrame = CFrame.new(p0 + Vector3.new(0, h, 0)) * CFrame.Angles(a * 25, 0, 0)
		end)
	end
end

function Fx.Init(ui)
	UI = ui
	K = UI.Kit()
	task.spawn(magnate)
end

return Fx
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX90EECAFCF62D4B478BCB64EBEACD43CF"><Properties><string name="Name">DeathFx</string><ProtectedString name="Source">-- WRECKED! sequence: impact flash, heavy shake, glitch, grayscale-red grade, crane-up camera, countdown.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Strings = require(Shared:WaitForChild("Strings"))
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local Cine = require(script.Parent:WaitForChild("CineFx"))

local DeathFx = {}
local ICON = {}
for id, p in pairs(require(game:GetService("ReplicatedStorage").Shared.PartConfig).Parts) do
	ICON[id] = p.emoji
end
local running = false

function DeathFx.Play(dir, lost, sfx)
	if running then
		return
	end
	running = true
	local player = Players.LocalPlayer
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if char then
		DeathFx.Ragdoll(char)
	end
	if hrp then -- the car launches the ragdoll
		hrp.AssemblyLinearVelocity = dir.Unit * 85 + Vector3.new(0, 60, 0)
		hrp.AssemblyAngularVelocity = Vector3.new(math.random(-15, 15), math.random(-15, 15), math.random(-15, 15))
		DeathFx.Shards(hrp.Position)
	end
	if sfx then
		sfx("crash")
		sfx("wrecked")
	end
	-- freeze-frame punch: hard contrast for a beat, then a cold grey grade
	Cine.Grade({ Saturation = -1, Contrast = 0.6, Brightness = 0.15, TintColor = Color3.fromRGB(255, 200, 200) }, 0)
	Cine.Shake(4, 0.7)
	task.delay(0.12, function()
		Cine.Grade({ Saturation = -0.85, Contrast = 0.25, Brightness = -0.05, TintColor = Color3.fromRGB(255, 190, 190) }, 0.4)
	end)
	Cine.Letterbox(true, 0.2)
	Cine.Title(Strings.T("wrecked"), Color3.fromRGB(255, 59, 59), 2.4, 170, 0.36)

	local parts = {}
	for _, id in ipairs(PartConfig.Order) do
		if lost and (lost[id] or 0) &gt; 0 then
			table.insert(parts, (ICON[id] or "") .. " x" .. lost[id])
		end
	end
	task.delay(0.4, function()
		if #parts &gt; 0 then
			Cine.Sub(Strings.T("wrecked_lost", table.concat(parts, "   ")), Color3.fromRGB(255, 210, 63), 2.2, 0.55)
		end
		Cine.Sub(Strings.T("wrecked_safe"), Color3.fromRGB(255, 255, 255), 2.2, 0.62)
	end)

	-- crane shot rising above the crash site
	task.delay(0.25, function()
		local cam = Cine.Take()
		local focus = hrp and hrp.Position or cam.CFrame.Position
		local from = cam.CFrame
		local t0 = os.clock()
		Cine.Blur(4, 1.5)
		local conn
		conn = RunService.RenderStepped:Connect(function()
			local a = math.min(1, (os.clock() - t0) / 2.6)
			local e = 1 - (1 - a) ^ 3
			local target = CFrame.lookAt(focus + Vector3.new(math.cos(e * 1.2) * 18, 8 + e * 38, math.sin(e * 1.2) * 18), focus)
			cam.CFrame = from:Lerp(target, math.min(1, a * 3)) * CFrame.Angles(0, 0, math.rad(8 * (1 - e)))
			if a &gt;= 1 then
				conn:Disconnect()
			end
		end)
		for n = 3, 1, -1 do
			task.wait(0.8)
			Cine.Sub(Strings.T("wrecked_back", n), Color3.fromRGB(255, 255, 255), 0.6, 0.7)
		end
	end)
end

-- joints become ball sockets so the body flops (BreakJointsOnDeath is off on the server)
function DeathFx.Ragdoll(char)
	for _, m in ipairs(char:GetDescendants()) do
		if m:IsA("Motor6D") and m.Part0 and m.Part1 and m.Name ~= "Root" then
			local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
			a0.CFrame, a1.CFrame = m.C0, m.C1
			a0.Parent, a1.Parent = m.Part0, m.Part1
			local bs = Instance.new("BallSocketConstraint")
			bs.Attachment0, bs.Attachment1 = a0, a1
			bs.LimitsEnabled = true
			bs.UpperAngle = 70
			bs.TwistLimitsEnabled = true
			bs.TwistLowerAngle, bs.TwistUpperAngle = -45, 45
			bs.Parent = m.Part0
			m.Enabled = false
		end
	end
	for _, p in ipairs(char:GetChildren()) do
		if p:IsA("BasePart") then
			p.CanCollide = p.Name ~= "HumanoidRootPart"
		end
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum:ChangeState(Enum.HumanoidStateType.Physics)
	end
end

-- windscreen shards + dust where the car hit
function DeathFx.Shards(pos)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.Transparency = true, false, false, false, 1
	p.Size = Vector3.one
	p.Position = pos
	p.Parent = workspace
	local glass = Instance.new("ParticleEmitter")
	glass.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	glass.Color = ColorSequence.new(Color3.fromRGB(220, 240, 255), Color3.fromRGB(150, 200, 230))
	glass.Size = NumberSequence.new(0.45, 0.1)
	glass.Lifetime = NumberRange.new(0.8, 1.3)
	glass.Speed = NumberRange.new(18, 34)
	glass.SpreadAngle = Vector2.new(180, 180)
	glass.Acceleration = Vector3.new(0, -60, 0)
	glass.RotSpeed = NumberRange.new(-300, 300)
	glass.LightEmission = 0.4
	glass.Rate = 0
	glass.Parent = p
	glass:Emit(60)
	local dust = Instance.new("ParticleEmitter")
	dust.Texture = "rbxasset://textures/particles/smoke_main.dds"
	dust.Color = ColorSequence.new(Color3.fromRGB(180, 176, 170))
	dust.Size = NumberSequence.new(2, 7)
	dust.Transparency = NumberSequence.new(0.4, 1)
	dust.Lifetime = NumberRange.new(1, 1.6)
	dust.Speed = NumberRange.new(6, 12)
	dust.SpreadAngle = Vector2.new(180, 40)
	dust.Rate = 0
	dust.Parent = p
	dust:Emit(16)
	task.delay(3, function()
		p:Destroy()
	end)
end

-- called on respawn
function DeathFx.Recover()
	if not running then
		return
	end
	running = false
	Cine.Release(0.2)
	Cine.Reset(0.5)
	Cine.Flash(Color3.new(0, 0, 0), 0, 0.6)
end

return DeathFx
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8EAB3B0AB1444911B8F3343C12FCEB9D"><Properties><string name="Name">GaragePrompts</string><ProtectedString name="Source">-- Own-garage interactions created on this client only: buy the next bay right at the bay,
-- build the next floor at the lift, ride the lift between floors.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BaseLayout = require(Shared:WaitForChild("BaseLayout"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))
local Util = require(Shared:WaitForChild("Util"))
local Net = require(Shared:WaitForChild("Net"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))

local GP = {}
local K, store, Cine
local folder
local sig = ""

local function anchor(name, cf)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
	p.Transparency = 1
	p.Size = Vector3.new(4, 4, 4)
	p.CFrame = cf
	p.Parent = folder
	return p
end

local function prompt(part, action, object, onTrigger)
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = action
	pp.ObjectText = object
	pp.HoldDuration = 0.35
	pp.MaxActivationDistance = 12
	pp.RequiresLineOfSight = false
	pp.Parent = part
	pp.Triggered:Connect(onTrigger)
	return pp
end

local function priceTag(part, text, color)
	local bb = K.new("BillboardGui", { Adornee = part, Size = UDim2.fromOffset(150, 44), StudsOffset = Vector3.new(0, 3, 0), MaxDistance = 80, LightInfluence = 0 }, part)
	local f = K.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = color }, bb)
	K.corner(f, 14)
	K.stroke(f, K.P.ink, 3)
	K.text(f, { Text = text, TextSize = 22, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center })
end

local function ride(targetY, bcf)
	local char = Players.LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end
	if Cine then
		Cine.Flash(Color3.new(0, 0, 0), 0.2, 0.5)
	end
	local dest = bcf * CFrame.new(-15, targetY + 3, BaseLayout.ElevatorLocal.Z)
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.CFrame = CFrame.lookAt(dest.Position, dest.Position + bcf:VectorToWorldSpace(Vector3.new(-1, 0, 0)))
end

local function rebuild()
	local st = store.State
	if not st or not st.baseIndex then
		return
	end
	local floors = st.floors or 1
	local carKey = {}
	for _, c in ipairs(st.cars) do
		if c.slot then
			table.insert(carKey, c.uid .. "@" .. c.slot .. "L" .. c.level)
		end
	end
	table.sort(carKey)
	-- affordability is part of the key: the price tags turn green the moment the money is there
	local canBay = store.Money &gt;= (EconomyConfig.SlotCosts[st.slots + 1] or math.huge)
	local canFloor = store.Money &gt;= (EconomyConfig.FloorCosts[floors + 1] or math.huge)
	local key = table.concat({ st.baseIndex, st.slots, floors, tostring(canBay), tostring(canFloor), table.concat(carKey, ",") }, ":")
	if key == sig then
		return
	end
	sig = key
	folder:ClearAllChildren()
	local bcf = BaseLayout.GetBaseCFrame(st.baseIndex)

	-- next bay: price tag + buy prompt right on the bay
	local nextSlot = st.slots + 1
	if nextSlot &lt;= floors * BaseLayout.SlotsPerFloor and EconomyConfig.SlotCosts[nextSlot] then
		local cost = EconomyConfig.SlotCosts[nextSlot]
		local p = BaseLayout.SlotLocal(nextSlot)
		local a = anchor("BuyBay", bcf * CFrame.new(p.X, BaseLayout.FloorY + p.Y + 2, p.Z))
		priceTag(a, "🔒 $" .. Util.FormatNumber(cost), store.Money &gt;= cost and K.P.green or K.P.grey)
		prompt(a, "Buy bay $" .. Util.FormatNumber(cost), "Parking bay " .. nextSlot, function()
			K.actions.BuySlot(st.slots)
		end)
	end

	-- every parked car: take it out of the garage, or sell it right there
	for _, c in ipairs(st.cars) do
		if c.slot then
			local def = CarConfig.ById[c.typeId]
			local p = BaseLayout.SlotLocal(c.slot)
			local a = anchor("Car" .. c.slot, bcf * CFrame.new(p.X, BaseLayout.FloorY + p.Y + 3, p.Z))
			local rm = prompt(a, "Remove", def and def.name or "Car", function()
				K.actions.Remove(c.uid)
			end)
			rm.KeyboardKeyCode = Enum.KeyCode.E
			rm.MaxActivationDistance = 9
			local price = def and CarConfig.SellPrice(def, c.level) or 0
			local sp = prompt(a, "Sell $" .. Util.FormatNumber(price), def and def.name or "Car", function()
				K.confirm("SELL THIS CAR?", string.format("&lt;b&gt;%s&lt;/b&gt;  Lv %d\nfor &lt;b&gt;$%s&lt;/b&gt;", def.name, c.level, Util.FormatNumber(price)), "SELL $" .. Util.FormatNumber(price), K.P.red, function()
					K.actions.Sell(c.uid)
				end, def)
			end)
			sp.KeyboardKeyCode = Enum.KeyCode.F
			sp.MaxActivationDistance = 9
			sp.UIOffset = Vector2.new(0, 70)
		end
	end

	-- lift: build the next floor, or ride to any built floor
	local el = BaseLayout.ElevatorLocal
	for f = 1, floors do
		local y = (f - 1) * BaseLayout.FloorHeight
		local stop = anchor("LiftStop" .. f, bcf * CFrame.new(f == 1 and el.X or -15, BaseLayout.FloorY + y + 2, el.Z))
		-- one key per destination (1-4), so every ride shows up instead of fighting over E
		for g = 1, floors do
			if g ~= f then
				local pp = prompt(stop, g == 1 and "Ground floor" or ("Level " .. g), "Lift", function()
					ride((g - 1) * BaseLayout.FloorHeight + BaseLayout.FloorY, bcf)
				end)
				pp.KeyboardKeyCode = ({ Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four })[g]
				pp.GamepadKeyCode = ({ Enum.KeyCode.DPadDown, Enum.KeyCode.DPadLeft, Enum.KeyCode.DPadUp, Enum.KeyCode.DPadRight })[g]
				pp.Exclusivity = Enum.ProximityPromptExclusivity.AlwaysShow
			end
		end
	end
	-- BUY NEXT FLOOR: its own panel beside the lift (it used to share the lift's E key and could not be pressed)
	if floors &lt; BaseLayout.MaxFloors then
		local cost = EconomyConfig.FloorCosts[floors + 1]
		local full = st.slots &gt;= floors * BaseLayout.SlotsPerFloor
		local buy = anchor("FloorBuy", bcf * CFrame.new(el.X, BaseLayout.FloorY + 2, el.Z - 9))
		priceTag(buy, (full and "BUY LEVEL " or "LOCKED ") .. (floors + 1) .. "  $" .. Util.FormatNumber(cost), (full and store.Money &gt;= cost) and K.P.orange or K.P.grey)
		local pp = prompt(buy, full and ("Buy level " .. (floors + 1)) or "Fill this floor first", "$" .. Util.FormatNumber(cost), function()
			K.actions.BuyFloor(floors)
		end)
		pp.GamepadKeyCode = Enum.KeyCode.ButtonY -- the lift rides use the D-pad, so one press never does both
		pp.Exclusivity = Enum.ProximityPromptExclusivity.AlwaysShow
	end
end

-- other players' garages are closed to you (no walking in, no stealing); yours stays open
local lastPrivacy
local function privacy(st)
	if lastPrivacy == st.baseIndex then
		return
	end
	lastPrivacy = st.baseIndex
	local map = Workspace:FindFirstChild("GeneratedMap")
	for _, d in ipairs(map and map:GetDescendants() or {}) do
		if d.Name == "PrivacyWall" and d:IsA("BasePart") then
			d.CanCollide = d:GetAttribute("BaseIndex") ~= st.baseIndex
		end
	end
end

function GP.Start(kit, cine)
	K = kit
	store = K.store
	Cine = cine
	folder = Instance.new("Folder")
	folder.Name = "GaragePrompts"
	folder.Parent = Workspace
	store.Changed.Event:Connect(function()
		rebuild()
		if store.State and store.State.baseIndex then
			privacy(store.State)
		end
	end)
	rebuild()
	Net.Get("BuyFloor") -- make sure the remote exists before the first click
end

return GP
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6DA40B0E383644C9880B138FEC1ECC3A"><Properties><string name="Name">IntroFx</string><ProtectedString name="Source">-- Intro cinematic for new players (before the step-by-step tutorial), with SKIP.
-- A copy of the player's avatar acts it out on the real map: crosses a city road and grabs a part, throws it into the
-- garage trap and a car drives in, walks up to Big Tony, then a fly-over of the districts and a boss monster truck.
-- Plays once: when it ends (or is skipped) the tutorial moves to step 1.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local BaseLayout = require(Shared:WaitForChild("BaseLayout"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local PartVisual = require(Shared:WaitForChild("PartVisual"))
local VehicleFactory = require(Shared:WaitForChild("VehicleFactory"))

local Intro = {}
local UI, Cine, K
local RUN_ANIM = "rbxassetid://913376220" -- Roblox default R15 run
local skipped = false
local trash = {}

local function keep(x)
	table.insert(trash, x)
	return x
end

-- waits, but returns false at once when SKIP was pressed
local function wait(t)
	local t0 = os.clock()
	while os.clock() - t0 &lt; t do
		if skipped then
			return false
		end
		RunService.RenderStepped:Wait()
	end
	return not skipped
end

-- smooth camera: every frame eases toward the target CFrame (target may be a function of time)
local cam, camTarget, camConn
local function camTo(cf, snap)
	camTarget = cf
	if snap then
		cam.CFrame = cf
	end
end

local function makeActor()
	local char = Players.LocalPlayer.Character
	if not char then
		return nil
	end
	char.Archivable = true
	local a = char:Clone()
	if not a or not a:FindFirstChild("HumanoidRootPart") then
		if a then
			a:Destroy()
		end
		return nil
	end
	for _, d in ipairs(a:GetDescendants()) do
		if d:IsA("LuaSourceContainer") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.CanCollide = false
		end
	end
	local hum = a:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	a.HumanoidRootPart.Anchored = true
	a.Parent = Workspace
	keep(a)
	local animator = hum and (hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum))
	local track
	if animator then
		local anim = Instance.new("Animation")
		anim.AnimationId = RUN_ANIM
		track = animator:LoadAnimation(anim)
	end
	return a, track
end

-- actor runs from a to b in t seconds, facing the way it goes
local function run(actor, track, a, b, t)
	local y = actor:GetExtentsSize().Y / 2
	local face = CFrame.lookAt(a, Vector3.new(b.X, a.Y, b.Z)) - a
	if track then
		track:Play(0.1)
	end
	local t0 = os.clock()
	while true do
		local k = math.min(1, (os.clock() - t0) / t)
		actor:PivotTo(CFrame.new(a:Lerp(b, k) + Vector3.new(0, y, 0)) * face)
		if k &gt;= 1 or skipped then
			break
		end
		RunService.RenderStepped:Wait()
	end
	if track then
		track:Stop(0.15)
	end
	return not skipped
end

-- numbered, long captions: a scene keeps its title + subtitle on screen for its whole length
local STEPS = 5
local function caption(step, title, sub, dur, titleDur)
	Cine.Title(string.format("STEP %d/%d  %s", step, STEPS, title), Color3.fromRGB(255, 210, 63), titleDur or dur, 72, 0.2)
	Cine.Sub(sub, Color3.new(1, 1, 1), dur, 0.82)
end
-- the next subtitle of the same scene (replaces the current one)
local function say(sub, dur)
	Cine.Sub(sub, Color3.new(1, 1, 1), dur, 0.82)
end
-- vehicles are posed by their Root (forward = local +X), like TrapFx / traffic; the model pivot is not aligned
local function faceCF(pos, dir)
	return CFrame.new(pos) * CFrame.Angles(0, math.atan2(-dir.Z, dir.X), 0)
end

local function scenes(st, actor, track)
	-- 1) the city road: run across between the cars, grab a glowing part
	local road = MapConfig.Roads[1]
	local x = -24
	local from, to = Vector3.new(x, 0.5, road.z - road.width / 2 - 8), Vector3.new(x, 0.5, road.z + road.width / 2 + 6)
	local part = keep(PartVisual.Build("bolts"))
	part:PivotTo(CFrame.new(to + Vector3.new(0, 1.5, 3)))
	part.Parent = Workspace
	camTo(CFrame.lookAt(Vector3.new(x - 42, 12, road.z), Vector3.new(x, 2, road.z)), true)
	caption(1, "GRAB CAR PARTS", "Glowing parts lie around every district - run into one to pick it up", 2.6, 9)
	if not wait(2.6) then
		return
	end
	say("Watch the traffic: one hit and you lose the parts you carry", 5.5)
	if not run(actor, track, from, to, 4.5) then
		return
	end
	part:Destroy()
	if not wait(1.2) then
		return
	end
	-- 2) your garage: throw the part into the trap, a car drives in
	local idx = st.baseIndex
	if idx then
		local bcf = BaseLayout.GetBaseCFrame(idx)
		local trap = BaseLayout.ToWorld(idx, BaseLayout.TrapLocal)
		local stand = trap + bcf:VectorToWorldSpace(Vector3.new(12, 0, 0))
		actor:PivotTo(CFrame.lookAt(stand + Vector3.new(0, 3, 0), trap + Vector3.new(0, 3, 0)))
		camTo(CFrame.lookAt(stand + bcf:VectorToWorldSpace(Vector3.new(10, 9, 14)), trap + Vector3.new(0, 2, 0)), true)
		caption(2, "THROW PARTS INTO YOUR TRAP", "Stand next to the trap in your garage and press THROW", 2.4, 6)
		if not wait(2.4) then
			return
		end
		local p2 = keep(PartVisual.Build("bolts"))
		p2.Parent = Workspace
		local t0 = os.clock()
		while os.clock() - t0 &lt; 0.7 and not skipped do
			local k = (os.clock() - t0) / 0.7
			p2:PivotTo(CFrame.new(stand:Lerp(trap, k) + Vector3.new(0, 3 + math.sin(k * math.pi) * 7, 0)))
			RunService.RenderStepped:Wait()
		end
		p2:Destroy()
		Cine.Flash(Color3.new(1, 1, 1), 0.4, 0.4)
		Cine.Shake(0.8, 0.3)
		-- a car drives in from the street to bay 1, the camera follows behind it
		local def = CarConfig.ByRarity.Rare[1]
		local car = keep(VehicleFactory.BuildCar(def))
		local root = car.PrimaryPart
		local y = BaseLayout.FloorY + 0.6
		local pl, sl = BaseLayout.PortalLocal, BaseLayout.SlotLocal(1)
		local pts = {}
		for _, p in ipairs({ { pl.X + 30, pl.Z }, { BaseLayout.LaneX, pl.Z }, { BaseLayout.LaneX, sl.Z }, { sl.X + 4, sl.Z } }) do
			table.insert(pts, bcf:PointToWorldSpace(Vector3.new(p[1], y, p[2])))
		end
		root.CFrame = faceCF(pts[1], pts[2] - pts[1])
		car.Parent = Workspace
		say("More parts = more rarity points = a rarer car!", 4)
		for i = 2, #pts do
			local a, b = pts[i - 1], pts[i]
			local dir = (b - a).Unit
			local seg = (b - a).Magnitude / 26
			local s0 = os.clock()
			while not skipped do
				local k = math.min(1, (os.clock() - s0) / seg)
				local pos = a:Lerp(b, k)
				root.CFrame = faceCF(pos, dir)
				camTo(CFrame.lookAt(pos - dir * 12 + Vector3.new(0, 4.5, 0), pos + dir * 6 + Vector3.new(0, 1.5, 0)))
				if k &gt;= 1 then
					break
				end
				RunService.RenderStepped:Wait()
			end
		end
		say("It parks in your garage and earns money every second", 3.5)
		if not wait(3.5) then
			return
		end
	end
	-- 3) Big Tony: parts for tuning
	local stand = Workspace:FindFirstChild("GeneratedMap") and Workspace.GeneratedMap:FindFirstChild("ContractStand", true)
	local spot = stand and stand:FindFirstChild("TonySpot")
	if spot then
		local tony = spot.Position
		local a = tony + Vector3.new(14, 0, -12)
		camTo(CFrame.lookAt(tony + Vector3.new(16, 8, -26), tony + Vector3.new(0, 3, 0)), true)
		caption(3, "MEET BIG TONY", "Bring him parts and he tunes your cars - tuned cars earn more", 6)
		if not run(actor, track, a, tony + Vector3.new(3, 0, -4), 3.2) then
			return
		end
		if not wait(2.6) then
			return
		end
	end
	-- 4) the districts: fly down the route
	local z0, z1 = MapConfig.Zones.highway.zMin, MapConfig.Zones.neon.zMax
	caption(4, "UNLOCK NEW DISTRICTS", "The deeper you go, the faster the traffic - and the better the parts", 5)
	local f0 = os.clock()
	while os.clock() - f0 &lt; 5 and not skipped do
		local z = z0 + (z1 - z0) * (os.clock() - f0) / 5
		camTo(CFrame.lookAt(Vector3.new(0, 46, z), Vector3.new(0, 0, z + 90)), os.clock() - f0 &lt; 0.05)
		RunService.RenderStepped:Wait()
	end
	-- 5) the boss
	local bosses = Workspace:FindFirstChild("Bosses")
	local truck = bosses and bosses:FindFirstChildWhichIsA("Model")
	if truck and not skipped then
		caption(5, "EVERY TIER ENDS WITH A BOSS", "A monster truck guards the arena - throw parts to scare it off", 5)
		local b0 = os.clock()
		while os.clock() - b0 &lt; 5 and not skipped do
			local c = truck:GetPivot().Position
			local ang = (os.clock() - b0) * 0.5
			camTo(CFrame.lookAt(c + Vector3.new(math.cos(ang) * 34, 14, math.sin(ang) * 34), c + Vector3.new(0, 4, 0)), os.clock() - b0 &lt; 0.05)
			RunService.RenderStepped:Wait()
		end
	end
	if not skipped then
		Cine.Title("NOW IT'S YOUR TURN!", Color3.fromRGB(110, 230, 140), 2.4, 84, 0.42)
		wait(2.2)
	end
end

function Intro.Play(st)
	skipped = false
	UI.SetCinematic(true)
	cam = Cine.Take()
	local cam0 = cam.CFrame
	camTarget = cam.CFrame
	camConn = RunService.RenderStepped:Connect(function(dt)
		cam.CFrame = cam.CFrame:Lerp(camTarget, 1 - math.exp(-dt * 6))
	end)
	Cine.Letterbox(true, 0.4)
	-- everything that can fail runs protected, so the cleanup below always gives the player back the controls
	local skip
	pcall(function()
		skip = K.toy(K.overlay, { Text = "SKIP  &gt;", Color = K.P.grey, Size = UDim2.fromOffset(150, 56), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -24),
			TextSize = 22, ZIndex = 95, OnClick = function() skipped = true end })
		local actor, track = makeActor()
		if actor then
			scenes(st, actor, track)
		end
	end)
	Cine.Darken(1, 0.3)
	task.wait(0.35)
	for _, x in ipairs(trash) do
		pcall(function()
			x:Destroy()
		end)
	end
	trash = {}
	if skip then
		skip.holder:Destroy()
	end
	if camConn then
		camConn:Disconnect()
		camConn = nil
	end
	cam.CFrame = cam0
	Cine.Letterbox(false, 0.2)
	Cine.Release(0.2)
	Cine.Darken(0, 0.5)
	UI.SetCinematic(false)
	Net.Get("TutorialStep"):FireServer(1) -- the intro is done: the tutorial starts at step 1
end

function Intro.Start(ui, cine)
	UI, Cine = ui, cine
	K = UI.Kit()
	task.spawn(function()
		-- new players only (tutorial 0), once their avatar is in the world
		local st
		repeat
			task.wait(0.5)
			st = K.store.State
		until st and Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		if (st.tutorial or 0) == 0 then
			task.wait(1)
			Intro.Play(st)
		end
	end)
end

return Intro
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4AF807BB55554959B4E69481B440C993"><Properties><string name="Name">Markers</string><ProtectedString name="Source">-- World markers (always on top) + an edge arrow pointing to the current objective.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Strings = require(Shared:WaitForChild("Strings"))
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local BaseLayout = require(Shared:WaitForChild("BaseLayout"))

local T = Strings.T
local C = Color3.fromRGB
local Markers = {}
local K, store, extra
local folder, arrow, arrowLabel
local marks = {}

local function anchorAt(name, pos)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
	p.Transparency = 1
	p.Size = Vector3.one * 0.2
	p.Position = pos
	p.Parent = folder
	return p
end

-- icon bubble + label + distance
local function makeMark(id, icon, label, color, pos, maxDist)
	local adornee = anchorAt("M_" .. id, pos)
	local bb = K.new("BillboardGui", { Name = "Mark_" .. id, Adornee = adornee, AlwaysOnTop = true, Size = UDim2.fromOffset(150, 74),
		StudsOffsetWorldSpace = Vector3.new(0, 4, 0), MaxDistance = maxDist or 2000, LightInfluence = 0, ResetOnSpawn = false }, K.gui.Parent)
	local bubble = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.fromOffset(42, 42), BackgroundColor3 = color }, bb)
	K.corner(bubble, 21)
	K.stroke(bubble, K.P.ink, 3)
	K.text(bubble, { Text = icon, Font = K.BODY, TextSize = 24, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center })
	local l = K.text(bb, { Text = label, TextSize = 16, Position = UDim2.fromOffset(0, 44), Size = UDim2.new(1, 0, 0, 18), TextXAlignment = Enum.TextXAlignment.Center, Outline = 2 })
	local d = K.text(bb, { Text = "", Font = K.BODY, TextSize = 13, Position = UDim2.fromOffset(0, 60), Size = UDim2.new(1, 0, 0, 14), TextXAlignment = Enum.TextXAlignment.Center })
	local scale = K.new("UIScale", {}, bubble)
	local m = { id = id, bb = bb, adornee = adornee, label = l, dist = d, color = color, icon = icon, scale = scale, text = label }
	marks[id] = m
	return m
end

local function removeMark(id)
	local m = marks[id]
	if m then
		m.bb:Destroy()
		m.adornee:Destroy()
		marks[id] = nil
	end
end

function Markers.SetPos(id, pos)
	local m = marks[id]
	if m then
		m.adornee.Position = pos
	end
end

local function ensureBase()
	local st = store.State
	if not st or not st.baseIndex then
		return
	end
	local pos = BaseLayout.ToWorld(st.baseIndex, BaseLayout.TrapLocal) + Vector3.new(0, 10, 0)
	if not marks.base then
		makeMark("base", "🏠", T("map_base"), K.P.orange, pos)
	else
		Markers.SetPos("base", pos)
	end
end

local scanned = {}
local function refreshScanner()
	local st = store.State
	local level = st and st.perks and st.perks.scanner or 0
	local drops = Workspace:FindFirstChild("RuntimeDrops")
	local seen = {}
	if level &gt;= 1 and drops then
		for _, m in ipairs(drops:GetChildren()) do
			local pid = m:GetAttribute("PartId")
			local root = m:FindFirstChild("Root")
			local part = pid and PartConfig.Parts[pid]
			if root and part and (part.rarity == "Epic" or part.rarity == "Legendary") then
				local key = "rare_" .. tostring(m:GetAttribute("PointId"))
				seen[key] = true
				if not marks[key] then
					makeMark(key, part.emoji, "", part.color, root.Position, 420)
				end
			end
		end
	end
	for key in pairs(scanned) do
		if not seen[key] then
			removeMark(key)
		end
	end
	scanned = seen
end

-- the objective arrow: hot drop &gt; carry loot home &gt; nothing
local function objective()
	local hot = extra.HotDrop()
	if hot and hot.kind == "start" and marks.hot then
		return marks.hot
	end
	if store.CarriedTotal() &gt; 0 and marks.base then
		return marks.base
	end
	return nil
end

function Markers.Start(kit, extraModule)
	K = kit
	store = K.store
	extra = extraModule
	folder = Instance.new("Folder")
	folder.Name = "MarkerAnchors"
	folder.Parent = Workspace
	makeMark("shop", "🔧", T("map_shop"), K.P.red, Vector3.new(MapConfig.Shop.x, 18, MapConfig.Shop.z), 260)
	makeMark("donate", "👑", T("map_donate"), C(232, 178, 50), Vector3.new(MapConfig.DonateStall.x, 16, MapConfig.DonateStall.z), 260)
	makeMark("contracts", "📜", T("map_contracts"), C(170, 120, 70), Vector3.new(MapConfig.ContractBoard.x, 12, MapConfig.ContractBoard.z), 160)

	arrow = K.new("Frame", { Name = "ObjectiveArrow", AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(64, 64), BackgroundTransparency = 1, Visible = false, ZIndex = 30 }, K.gui)
	local tri = K.text(arrow, { Text = "➤", Font = K.BODY, TextSize = 52, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 30, TextColor3 = K.P.orange })
	K.new("UIStroke", { Color = K.P.ink, Thickness = 3 }, tri)
	arrowLabel = tri

	store.Changed.Event:Connect(ensureBase)
	local t = 0
	RunService.RenderStepped:Connect(function(dt)
		t = t + dt
		local cam = Workspace.CurrentCamera
		local char = Players.LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not cam or not hrp then
			return
		end
		-- hot drop marker follows the event
		local hot = extra.HotDrop()
		if hot and hot.kind == "start" then
			if not marks.hot then
				makeMark("hot", "📦", T("hot_drop"), K.P.red, hot.pos + Vector3.new(0, 6, 0))
			end
			marks.hot.scale.Scale = 1 + 0.15 * math.sin(t * 8)
		elseif marks.hot then
			removeMark("hot")
		end
		-- distances
		for _, m in pairs(marks) do
			local d = (m.adornee.Position - hrp.Position).Magnitude
			m.dist.Text = (d &gt; 12) and (math.floor(d) .. " m") or ""
		end
		-- edge arrow
		local obj = objective()
		-- no arrow / world labels over panels or cinematics, or when switched off in Settings
		local busy = K.state.open ~= nil or K.state.cine == true or game:GetService("Players").LocalPlayer:GetAttribute("Opt_markers") == false
		for _, m in pairs(marks) do
			if m.bb then
				m.bb.Enabled = not busy
			end
		end
		if obj and not busy then
			local p, onScreen = cam:WorldToViewportPoint(obj.adornee.Position)
			local vp = cam.ViewportSize
			if onScreen and p.Z &gt; 0 and p.X &gt; 40 and p.X &lt; vp.X - 40 and p.Y &gt; 40 and p.Y &lt; vp.Y - 40 then
				arrow.Visible = false
			else
				local inset = game:GetService("GuiService"):GetGuiInset()
				vp = vp - inset
				p = Vector3.new(p.X - inset.X, p.Y - inset.Y, p.Z)
				local cx, cy = vp.X / 2, vp.Y / 2
				local dx, dy = p.X - cx, p.Y - cy
				if p.Z &lt; 0 then
					dx, dy = -dx, -dy
				end
				local ang = math.atan2(dy, dx)
				local rx, ry = cx - 70, cy - 70
				local s = math.min(rx / math.max(math.abs(math.cos(ang)), 1e-3), ry / math.max(math.abs(math.sin(ang)), 1e-3))
				arrow.Position = UDim2.fromOffset(cx + math.cos(ang) * s, cy + math.sin(ang) * s)
				arrow.Rotation = math.deg(ang)
				arrowLabel.TextColor3 = obj.color
				arrow.Visible = true
			end
		else
			arrow.Visible = false
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			ensureBase()
			refreshScanner()
		end
	end)
end

return Markers
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXACDB8EC68F1A4127AB541107A1EB9B49"><Properties><string name="Name">Rewards</string><ProtectedString name="Source">-- GIFTS: 7-day login streak + playtime chests. Button in the left column, red dot when something can be claimed.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local R = require(Shared:WaitForChild("RewardConfig"))
local Util = require(Shared:WaitForChild("Util"))
local Icons = require(Shared:WaitForChild("Icons"))
local PartConfig = require(Shared:WaitForChild("PartConfig"))

local RW = {}
local K, UI
local P
local C = Color3.fromRGB
local w = {}
local sessionBase, sessionAt = 0, os.clock()

local function sessionNow()
	return sessionBase + (os.clock() - sessionAt)
end

local function fmt(sec)
	sec = math.max(0, math.floor(sec))
	if sec &gt;= 3600 then
		return string.format("%dh %02dm", sec // 3600, sec % 3600 // 60)
	end
	return string.format("%d:%02d", sec // 60, sec % 60)
end

local function partsText(parts)
	local out = {}
	for _, id in ipairs(PartConfig.Order) do
		if parts and parts[id] then
			table.insert(out, parts[id] .. " " .. string.lower(PartConfig.Parts[id].name))
		end
	end
	return table.concat(out, ", ")
end

local function claimable(st)
	if not st or not st.daily then
		return false
	end
	if st.daily.last ~= st.daily.today then
		return true
	end
	for i, c in ipairs(R.Chests) do
		if not (st.chests and st.chests[i]) and sessionNow() &gt;= c.minutes * 60 then
			return true
		end
	end
	return false
end

local function build()
	-- button next to SHOP / JOBS
	local brow = K.hud.leftCol:FindFirstChild("Buttons")
	local holder = K.new("Frame", { Size = UDim2.fromOffset(66, 94), BackgroundTransparency = 1, LayoutOrder = 3 }, brow)
	local b = K.toy(holder, { Text = "", Color = P.green, Size = UDim2.fromOffset(66, 66), OnClick = function() UI.TogglePanel("rewards") end })
	K.hud.icon(b.face, "gift", 54, UDim2.fromOffset(6, 3)).ZIndex = b.face.ZIndex + 1
	K.text(holder, { Text = "GIFTS", TextSize = 15, Position = UDim2.fromOffset(0, 72), Size = UDim2.new(1, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Center, Outline = 2.5 })
	w.dot = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(60, 4), Size = UDim2.fromOffset(18, 18), BackgroundColor3 = P.red, ZIndex = 30, Visible = false }, holder)
	K.corner(w.dot, 9)
	K.stroke(w.dot, P.white, 2)

	local p = K.panelShell("rewards", "GIFTS", 940, 600, P.green)
	local c = p.content
	K.text(c, { Text = "DAILY STREAK  -  come back every day, missing a day starts again", Font = K.BODY, TextSize = 17, TextColor3 = P.ink, Size = UDim2.new(1, 0, 0, 24), ZIndex = 22 })
	w.days = K.new("Frame", { Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 200), BackgroundTransparency = 1, ZIndex = 22 }, c)
	K.list(w.days, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center)
	K.text(c, { Text = "PLAYTIME CHESTS  -  play today to open them, new chests every day", Font = K.BODY, TextSize = 17, TextColor3 = P.ink, Position = UDim2.fromOffset(0, 246), Size = UDim2.new(1, 0, 0, 24), ZIndex = 22 })
	w.chests = K.new("Frame", { Position = UDim2.fromOffset(0, 276), Size = UDim2.new(1, 0, 0, 200), BackgroundTransparency = 1, ZIndex = 22 }, c)
	K.list(w.chests, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center)
end

local function card(parent, order, color, title, body, btnText, btnColor, onClick, highlight)
	local f = K.new("Frame", { Size = UDim2.fromOffset(order and 118 or 160, 196), BackgroundColor3 = P.white, LayoutOrder = order or 0, ZIndex = 23 }, parent)
	K.corner(f, 16)
	K.stroke(f, highlight and P.yellow or color, highlight and 5 or 3)
	local top = K.new("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = color, ZIndex = 24 }, f)
	K.corner(top, 16)
	K.text(top, { Text = title, TextSize = 18, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 25, Outline = 2 })
	K.new("ImageLabel", { Position = UDim2.new(0.5, -26, 0, 40), Size = UDim2.fromOffset(52, 52), BackgroundTransparency = 1, Image = Icons.Get("gift") or "", ZIndex = 24 }, f)
	K.text(f, { Text = body, Font = K.BODY, TextSize = 13, TextColor3 = P.ink, TextWrapped = true, Position = UDim2.fromOffset(6, 96), Size = UDim2.new(1, -12, 0, 44), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
	return K.toy(f, { Text = btnText, Color = btnColor, Size = UDim2.new(1, -16, 0, 44), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -6), TextSize = 16, ZIndex = 25, OnClick = onClick })
end

local function refresh(st, open)
	w.dot.Visible = claimable(st)
	if open ~= "rewards" or not st.daily then
		w.sig = nil
		return
	end
	-- rebuild the cards only when something changed; the chest timers tick on their own buttons
	-- (rebuilding every second destroyed the button under the player's finger)
	local now = sessionNow()
	local sig = { st.daily.today, st.daily.last, st.daily.day, Util.FormatNumber(K.store.Income) }
	for i, e in ipairs(R.Chests) do
		table.insert(sig, (st.chests and st.chests[i]) and "g" or (now &gt;= e.minutes * 60 and "r" or "w"))
	end
	sig = table.concat(sig, "|")
	if sig == w.sig then
		for i, e in ipairs(R.Chests) do
			local btn = w.chestBtns[i]
			if btn and not (st.chests and st.chests[i]) and now &lt; e.minutes * 60 then
				btn.SetText(fmt(e.minutes * 60 - now))
			end
		end
		return
	end
	w.sig = sig
	K.clear(w.days)
	local today = st.daily.today
	local claimedToday = st.daily.last == today
	local nextDay = claimedToday and st.daily.day or R.NextDay(st.daily, today)
	for i, e in ipairs(R.Daily) do
		local done = (claimedToday and i &lt;= st.daily.day) or (not claimedToday and i &lt; nextDay)
		local isNext = i == nextDay and not claimedToday
		local body = "$" .. Util.FormatNumber(R.Money(e, K.store.Income)) .. "\n" .. partsText(e.parts) .. (e.pity and "\n+ Epic guarantee" or "")
		card(w.days, i, i == 7 and P.orange or P.blue, "DAY " .. i, body, done and "DONE" or (isNext and "CLAIM" or "LOCKED"), done and P.grey or (isNext and P.green or P.grey),
			function()
				if isNext then
					Net.Get("ClaimDaily"):FireServer()
				end
			end, isNext)
	end
	K.clear(w.chests)
	w.chestBtns = {}
	for i, e in ipairs(R.Chests) do
		local got = st.chests and st.chests[i]
		local left = e.minutes * 60 - now
		local body = "$" .. Util.FormatNumber(R.Money(e, K.store.Income)) .. "\n" .. partsText(e.parts) .. (e.tuning and "\n+ tuning part" or "")
		w.chestBtns[i] = card(w.chests, nil, P.green, e.minutes .. " MIN", body, got and "OPENED" or (left &lt;= 0 and "OPEN" or fmt(left)), got and P.grey or (left &lt;= 0 and P.green or P.grey),
			function()
				if not got and sessionNow() &gt;= e.minutes * 60 then
					Net.Get("ClaimChest"):FireServer(i)
				end
			end, left &lt;= 0 and not got)
	end
end

function RW.Start(ui)
	UI = ui
	K = UI.Kit()
	P = K.P
	build()
	K.store.Changed.Event:Connect(function()
		local st = K.store.State
		if st and st.sessionTime then
			sessionBase, sessionAt = st.sessionTime, os.clock()
		end
	end)
	table.insert(UI.Hooks, refresh)
	task.spawn(function()
		while true do
			task.wait(1)
			local st = K.store.State
			if st then
				refresh(st, K.state.open)
			end
		end
	end)
end

return RW
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXB799A10B812446F4907EA7F5288503F2"><Properties><string name="Name">Settings</string><ProtectedString name="Source">-- SETTINGS: music + sound-effect volume sliders and on/off switches. Saved in the player's profile
-- (DataService.SanitizeSettings), applied on join. Switches are read by other modules as LocalPlayer attributes
-- "Opt_&lt;name&gt;" (false = off): markers (Markers), guide (Guidance), shake (CineFx), fov (SpeedLanes);
-- notifications go through UI.SetNotificationsEnabled.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))

local Settings = {}
local K, UI, P
local cur = { music = 0.5, sfx = 0.8, markers = true, notes = true, shake = true, fov = true, guide = true }
local loaded = false
local widgets = {}
local saveToken = 0

local SWITCHES = {
	{ "markers", "Map markers + goal arrow" },
	{ "guide", "Guide beam to your goal" },
	{ "notes", "Notifications at the top" },
	{ "shake", "Camera shake" },
	{ "fov", "Zoom-out on running lanes" },
}

local function apply()
	UI.MusicGroup.Volume = cur.music
	UI.SfxGroup.Volume = cur.sfx
	local lp = Players.LocalPlayer
	for _, s in ipairs(SWITCHES) do
		lp:SetAttribute("Opt_" .. s[1], cur[s[1]])
	end
	UI.SetNotificationsEnabled(cur.notes)
end

-- one save 1 s after the last change (dragging a slider does not spam the server)
local function save()
	saveToken = saveToken + 1
	local token = saveToken
	task.delay(1, function()
		if token == saveToken then
			Net.Get("SaveSettings"):FireServer(cur)
		end
	end)
end

local function refresh()
	for key, wd in pairs(widgets) do
		if wd.fill then
			wd.fill.Size = UDim2.fromScale(cur[key], 1)
			wd.knob.Position = UDim2.new(cur[key], 0, 0.5, 0)
			wd.value.Text = math.floor(cur[key] * 100 + 0.5) .. "%"
		else
			wd.btn.SetText(cur[key] and "ON" or "OFF")
			wd.btn.SetColor(cur[key] and P.green or P.grey)
		end
	end
end

local function slider(parent, y, key, title)
	K.text(parent, { Text = title, TextSize = 20, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(0, y), Size = UDim2.fromOffset(220, 30), ZIndex = 23 })
	local track = K.new("TextButton", { Text = "", AutoButtonColor = false, Position = UDim2.fromOffset(230, y + 9), Size = UDim2.fromOffset(250, 12),
		BackgroundColor3 = Color3.fromRGB(220, 222, 228), ZIndex = 23 }, parent)
	K.corner(track, 6)
	local fill = K.new("Frame", { Size = UDim2.fromScale(cur[key], 1), BackgroundColor3 = P.blue, ZIndex = 24 }, track)
	K.corner(fill, 6)
	local knob = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(cur[key], 0, 0.5, 0), Size = UDim2.fromOffset(26, 26), BackgroundColor3 = P.white, ZIndex = 25 }, track)
	K.corner(knob, 13)
	K.stroke(knob, P.ink, 3)
	local value = K.text(parent, { Text = "", Font = K.BODY, TextSize = 18, TextColor3 = P.ink, Position = UDim2.fromOffset(496, y), Size = UDim2.fromOffset(70, 30), ZIndex = 23 })
	widgets[key] = { fill = fill, knob = knob, value = value }
	local dragging = false
	local function setFrom(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		cur[key] = math.floor(a * 100 + 0.5) / 100
		apply()
		refresh()
		save()
	end
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFrom(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFrom(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

local function build()
	-- SETTINGS button: 4th in the left button row (same style as SHOP / JOBS / GIFTS)
	local brow = K.hud.leftCol:FindFirstChild("Buttons")
	local holder = K.new("Frame", { Size = UDim2.fromOffset(66, 94), BackgroundTransparency = 1, LayoutOrder = 4 }, brow)
	local b = K.toy(holder, { Text = "", Color = P.grey, Size = UDim2.fromOffset(66, 66), OnClick = function() UI.TogglePanel("settings") end })
	K.hud.icon(b.face, "settings", 54, UDim2.fromOffset(6, 3)).ZIndex = b.face.ZIndex + 1
	K.text(holder, { Text = "SETTINGS", TextSize = 15, Position = UDim2.fromOffset(-6, 72), Size = UDim2.new(1, 12, 0, 20), TextXAlignment = Enum.TextXAlignment.Center, Outline = 2.5 })

	local p = K.panelShell("settings", "SETTINGS", 640, 500, P.blue)
	local c = p.content
	slider(c, 0, "music", "MUSIC")
	slider(c, 46, "sfx", "SOUND EFFECTS")
	for i, s in ipairs(SWITCHES) do
		local y = 104 + (i - 1) * 56
		K.text(c, { Text = s[2], Font = K.BODY, TextSize = 19, TextColor3 = P.ink, Position = UDim2.fromOffset(0, y + 8), Size = UDim2.fromOffset(400, 30), ZIndex = 23 })
		local key = s[1]
		widgets[key] = {
			btn = K.toy(c, { Text = "ON", Color = P.green, Size = UDim2.fromOffset(110, 48), Position = UDim2.fromOffset(456, y), TextSize = 20, ZIndex = 23, OnClick = function()
				cur[key] = not cur[key]
				apply()
				refresh()
				save()
			end }),
		}
	end
	refresh()
end

function Settings.Start(ui)
	UI = ui
	K = UI.Kit()
	P = K.P
	build()
	apply()
	-- the saved settings arrive with the first state from the server
	local function load()
		local st = K.store.State
		if not loaded and st and type(st.settings) == "table" then
			loaded = true
			for k, v in pairs(st.settings) do
				if cur[k] ~= nil and type(v) == type(cur[k]) then
					cur[k] = v
				end
			end
			apply()
			refresh()
		end
	end
	K.store.Changed.Event:Connect(load)
	load()
end

return Settings
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXD554C686AA1C4C858A4F47A35E9E65EB"><Properties><string name="Name">SpeedLanes</string><ProtectedString name="Source">-- Running lanes: dark strips with white arrows. Boost only while running the way the arrows point.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MapConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MapConfig"))

local SpeedLanes = {}
SpeedLanes.Boosting = false

function SpeedLanes.Start(getBaseSpeed)
	local player = Players.LocalPlayer
	local fov = 70
	RunService.Heartbeat:Connect(function(dt)
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local cam = Workspace.CurrentCamera
		local boost = false
		if hum and hrp and hum.Health &gt; 0 and hrp.Position.Y &lt; 8 then
			local lane = MapConfig.LaneAt(hrp.Position)
			local md = hum.MoveDirection
			if lane and md.Magnitude &gt; 0.1 and (md.X * lane[5] + md.Z * lane[6]) &gt; 0.5 then
				boost = true
			end
			local base = getBaseSpeed and getBaseSpeed() or MapConfig.WalkSpeed
			local want = boost and (MapConfig.LaneSpeed + (base - MapConfig.WalkSpeed)) or base
			if math.abs(hum.WalkSpeed - want) &gt; 0.01 then
				hum.WalkSpeed = want
			end
		end
		SpeedLanes.Boosting = boost
		if cam and cam.CameraType == Enum.CameraType.Custom then
			local kick = boost and game:GetService("Players").LocalPlayer:GetAttribute("Opt_fov") ~= false -- Settings
			fov = fov + ((kick and 80 or 70) - fov) * math.min(1, dt * 5)
			cam.FieldOfView = fov
		end
	end)
end

return SpeedLanes
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXF2E9E59572C84E2E9940B74C7900567E"><Properties><string name="Name">Trade</string><ProtectedString name="Source">-- Trading UI: TRADE button (right side) -&gt; pick a player -&gt; request; incoming request card; two-sided trade window.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local Util = require(Shared:WaitForChild("Util"))
local Icons = require(Shared:WaitForChild("Icons"))

local TR = {}
local K, UI
local P
local C = Color3.fromRGB
local w = {}
local offer = { cars = {}, money = 0, parts = {} } -- my local draft
local last -- last state from the server

local function send()
	local cars = {}
	for uid in pairs(offer.cars) do
		table.insert(cars, uid)
	end
	Net.Get("TradeUpdate"):FireServer({ cars = cars, money = offer.money, parts = offer.parts })
end

local function rc(r)
	return CarConfig.Rarities[r].color
end

---------------------------------------------------------------- player list
local function refreshList()
	K.clear(w.list)
	local any = false
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= Players.LocalPlayer then
			any = true
			local row = K.new("Frame", { Size = UDim2.new(1, 0, 0, 70), BackgroundColor3 = P.white, ZIndex = 23 }, w.list)
			K.corner(row, 16)
			K.stroke(row, P.ink, 3)
			local ok, img = pcall(function()
				return Players:GetUserThumbnailAsync(p.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
			end)
			local face = K.new("ImageLabel", { Position = UDim2.fromOffset(10, 7), Size = UDim2.fromOffset(56, 56), BackgroundColor3 = C(230, 232, 236), Image = ok and img or "", ZIndex = 24 }, row)
			K.corner(face, 28)
			K.text(row, { Text = p.DisplayName, TextSize = 22, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(78, 0), Size = UDim2.new(1, -260, 1, 0), ZIndex = 24 })
			K.toy(row, { Text = "REQUEST", Color = P.green, Size = UDim2.fromOffset(160, 54), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), TextSize = 20, ZIndex = 25,
				OnClick = function()
					Net.Get("TradeRequest"):FireServer(p.UserId)
					UI.TogglePanel(nil)
				end })
		end
	end
	if not any then
		K.text(w.list, { Text = "Nobody else is on this server yet. Invite a friend!", Font = K.BODY, TextSize = 18, TextColor3 = P.muted, Size = UDim2.new(1, 0, 0, 40), ZIndex = 23 })
	end
end

---------------------------------------------------------------- incoming request
local function requestCard(msg)
	if w.request and w.request.Parent then
		w.request:Destroy()
	end
	if UI.IsCinematic() then
		Net.Get("TradeRespond"):FireServer(msg.from, false) -- busy watching a car reveal
		return
	end
	local f = K.new("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -150, 0, 120), Size = UDim2.fromOffset(330, 150), BackgroundColor3 = P.cream, ZIndex = 70 }, K.overlay)
	w.request = f
	K.corner(f, 20)
	K.stroke(f, P.ink, 4)
	K.text(f, { Text = "TRADE REQUEST", TextSize = 22, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(16, 10), Size = UDim2.new(1, -32, 0, 26), ZIndex = 71 })
	K.text(f, { Text = msg.name .. " wants to trade with you", Font = K.BODY, TextSize = 16, TextColor3 = P.muted, Position = UDim2.fromOffset(16, 40), Size = UDim2.new(1, -32, 0, 22), ZIndex = 71 })
	local function answer(ok)
		Net.Get("TradeRespond"):FireServer(msg.from, ok)
		f:Destroy()
	end
	K.toy(f, { Text = "ACCEPT", Color = P.green, Size = UDim2.fromOffset(140, 54), Position = UDim2.fromOffset(16, 80), TextSize = 20, ZIndex = 72, OnClick = function() answer(true) end })
	K.toy(f, { Text = "DECLINE", Color = P.red, Size = UDim2.fromOffset(140, 54), Position = UDim2.fromOffset(170, 80), TextSize = 20, ZIndex = 72, OnClick = function() answer(false) end })
	UI.Sfx("ping")
	task.delay(25, function()
		if f.Parent then
			f:Destroy()
		end
	end)
end

---------------------------------------------------------------- trade window
local function carRow(parent, car, order, selected, onClick)
	local def = CarConfig.ById[car.typeId]
	if not def then
		return
	end
	local b = K.new("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = selected and C(220, 250, 226) or P.white, LayoutOrder = order, ZIndex = 24 }, parent)
	K.corner(b, 12)
	K.stroke(b, selected and P.green or rc(def.rarity), selected and 4 or 2)
	K.text(b, { Text = string.format("%s  Lv%d", def.name, car.level), Font = K.BODY, TextSize = 15, TextColor3 = P.ink, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -60, 1, 0), ZIndex = 25 })
	K.text(b, { Text = string.upper(string.sub(def.rarity, 1, 4)), Font = K.BODY, TextSize = 12, TextColor3 = rc(def.rarity), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 0),
		Size = UDim2.fromOffset(46, 44), TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 25 })
	if onClick then
		b.Activated:Connect(onClick)
	end
end

local function buildWindow()
	local p = K.panelShell("trade", "TRADE", 960, 620, P.blue)
	local c = p.content
	w.window = p
	-- left: my side
	local mine = K.new("Frame", { Size = UDim2.new(0.5, -8, 1, -90), BackgroundTransparency = 1, ZIndex = 22 }, c)
	K.text(mine, { Text = "YOUR OFFER", TextSize = 22, TextColor3 = P.ink, Outline = false, Size = UDim2.new(1, 0, 0, 26), ZIndex = 23 })
	K.text(mine, { Text = "Tap cars to add / remove (max 8)", Font = K.BODY, TextSize = 13, TextColor3 = P.muted, Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 18), ZIndex = 23 })
	w.myCars = K.scroller(mine, UDim2.fromOffset(0, 48), UDim2.new(1, 0, 0, 150))
	-- money
	K.text(mine, { Text = "MONEY", TextSize = 18, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(0, 206), Size = UDim2.fromOffset(90, 24), ZIndex = 23 })
	w.moneyBox = K.new("TextBox", { Text = "0", PlaceholderText = "0", ClearTextOnFocus = false, Font = K.BODY, TextSize = 18, TextColor3 = P.ink, BackgroundColor3 = P.white,
		Position = UDim2.fromOffset(90, 202), Size = UDim2.fromOffset(150, 32), ZIndex = 23 }, mine)
	K.corner(w.moneyBox, 8)
	K.stroke(w.moneyBox, P.ink, 2)
	w.moneyBox.FocusLost:Connect(function()
		local v = tonumber((string.gsub(w.moneyBox.Text, "[^%d]", ""))) or 0
		offer.money = math.clamp(v, 0, K.store.Money)
		send()
	end)
	for i, add in ipairs({ 1000, 10000, 100000 }) do
		K.toy(mine, { Text = "+" .. Util.FormatNumber(add), Color = P.yellow, Size = UDim2.fromOffset(66, 34), Position = UDim2.fromOffset(248 + (i - 1) * 72, 201), TextSize = 14, ZIndex = 24,
			OnClick = function()
				offer.money = math.min(offer.money + add, K.store.Money)
				send()
			end })
	end
	-- parts steppers: 10 parts in two rows of five
	w.partRows = {}
	for i, id in ipairs(PartConfig.Order) do
		local x, y = ((i - 1) % 5) * 88, 242 + math.floor((i - 1) / 5) * 86
		local img = K.new("ImageLabel", { Position = UDim2.fromOffset(x + 22, y), Size = UDim2.fromOffset(36, 36), BackgroundTransparency = 1, Image = Icons.Get(id) or "", ZIndex = 23 }, mine)
		local n = K.text(mine, { Text = "0", TextSize = 17, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(x, y + 36), Size = UDim2.fromOffset(80, 18), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 23 })
		K.toy(mine, { Text = "-", Color = P.red, Size = UDim2.fromOffset(36, 30), Position = UDim2.fromOffset(x + 2, y + 54), TextSize = 20, ZIndex = 24, OnClick = function()
			offer.parts[id] = math.max(0, (offer.parts[id] or 0) - 1)
			send()
		end })
		K.toy(mine, { Text = "+", Color = P.green, Size = UDim2.fromOffset(36, 30), Position = UDim2.fromOffset(x + 42, y + 54), TextSize = 20, ZIndex = 24, OnClick = function()
			offer.parts[id] = math.min(K.store.Banked(id), (offer.parts[id] or 0) + 1)
			send()
		end })
		w.partRows[id] = n
		img.ImageTransparency = 0
	end
	-- right: their side
	local theirs = K.new("Frame", { Position = UDim2.new(0.5, 8, 0, 0), Size = UDim2.new(0.5, -8, 1, -90), BackgroundColor3 = C(236, 242, 250), ZIndex = 22 }, c)
	K.corner(theirs, 16)
	K.new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 8) }, theirs)
	w.theirTitle = K.text(theirs, { Text = "THEIR OFFER", TextSize = 22, TextColor3 = P.ink, Outline = false, Size = UDim2.new(1, 0, 0, 26), ZIndex = 23 })
	w.theirCars = K.scroller(theirs, UDim2.fromOffset(0, 34), UDim2.new(1, 0, 0, 240))
	w.theirExtra = K.text(theirs, { Text = "", Font = K.BODY, TextSize = 17, TextColor3 = P.ink, RichText = true, TextWrapped = true, Position = UDim2.fromOffset(0, 284), Size = UDim2.new(1, 0, 0, 90), ZIndex = 23 })
	-- bottom bar
	w.status = K.text(c, { Text = "", Font = K.BODY, TextSize = 18, TextColor3 = P.ink, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -24), Size = UDim2.new(0.5, 0, 0, 30), ZIndex = 23 })
	w.cancel = K.toy(c, { Text = "CANCEL", Color = P.red, Size = UDim2.fromOffset(170, 64), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -250, 1, 0), TextSize = 22, ZIndex = 24, OnClick = function()
		Net.Get("TradeCancel"):FireServer()
	end })
	w.ready = K.toy(c, { Text = "READY", Color = P.green, Size = UDim2.fromOffset(230, 64), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, 0, 1, 0), TextSize = 26, ZIndex = 24, OnClick = function()
		Net.Get("TradeReady"):FireServer(not (last and last.readyMe))
	end })
end

local function partsLine(parts)
	local out = {}
	for _, id in ipairs(PartConfig.Order) do
		if parts and (parts[id] or 0) &gt; 0 then
			table.insert(out, parts[id] .. " " .. id)
		end
	end
	return #out &gt; 0 and table.concat(out, ", ") or "no parts"
end

local function renderState(msg)
	last = msg
	if K.state.open ~= "trade" then
		if UI.IsCinematic() then
			w.pendingOpen = true
		else
			UI.TogglePanel("trade")
		end
	end
	-- my cars: every car I own, offered ones highlighted
	offer.cars = {}
	for _, c in ipairs(msg.mine.cars) do
		offer.cars[c.uid] = true
	end
	offer.money = msg.mine.money or 0
	offer.parts = msg.mine.parts or {}
	K.clear(w.myCars)
	local st = K.store.State
	for i, car in ipairs(st and st.cars or {}) do
		local sel = offer.cars[car.uid]
		carRow(w.myCars, car, sel and i or i + 1000, sel, function()
			if offer.cars[car.uid] then
				offer.cars[car.uid] = nil
			else
				local n = 0
				for _ in pairs(offer.cars) do
					n = n + 1
				end
				if n &gt;= 8 then
					UI.Toast("Max 8 cars per trade", "warn")
					return
				end
				offer.cars[car.uid] = true
			end
			send()
		end)
	end
	w.moneyBox.Text = tostring(offer.money)
	for id, n in pairs(w.partRows) do
		n.Text = tostring(offer.parts[id] or 0) .. " / " .. K.store.Banked(id)
	end
	w.theirTitle.Text = string.upper(msg.partner) .. " OFFERS"
	K.clear(w.theirCars)
	for i, car in ipairs(msg.theirs.cars) do
		carRow(w.theirCars, car, i, false)
	end
	if #msg.theirs.cars == 0 then
		K.text(w.theirCars, { Text = "No cars", Font = K.BODY, TextSize = 15, TextColor3 = P.muted, Size = UDim2.new(1, 0, 0, 30), ZIndex = 24 })
	end
	w.theirExtra.Text = string.format("&lt;b&gt;$%s&lt;/b&gt;\n%s", Util.FormatNumber(msg.theirs.money or 0), partsLine(msg.theirs.parts))
	if msg.countdown then
		w.status.Text = string.format("Both ready - trading in %d...", math.ceil(msg.countdown))
		task.delay(1, function()
			if last == msg and msg.countdown and msg.countdown &gt; 1 then
				msg.countdown = msg.countdown - 1
				renderState(msg)
			end
		end)
	elseif msg.readyMe and not msg.readyThem then
		w.status.Text = "Waiting for " .. msg.partner .. "..."
	elseif msg.readyThem then
		w.status.Text = msg.partner .. " is READY"
	else
		w.status.Text = "Make your offer, then press READY"
	end
	w.ready.SetText(msg.readyMe and "UNREADY" or "READY", nil)
	w.ready.SetColor(msg.readyMe and P.orange or P.green)
end

function TR.Start(ui)
	UI = ui
	K = UI.Kit()
	P = K.P
	-- right-side button under CARS
	local holder = K.new("Frame", { Size = UDim2.fromOffset(122, 104), BackgroundTransparency = 1, LayoutOrder = 4 }, K.hud.side)
	K.toy(holder, { Text = "TRADE", Image = "trade", Icon = "🤝", Color = P.blue, Size = UDim2.fromOffset(122, 104), OnClick = function() UI.TogglePanel("tradeList") end })
	local lp = K.panelShell("tradeList", "TRADE WITH", 640, 520, P.blue)
	w.list = K.scroller(lp.content, UDim2.new(), UDim2.fromScale(1, 1))
	buildWindow()
	local wasOpen
	table.insert(UI.Hooks, function(_, open)
		-- build the player list once per opening (it fetches avatars; rebuilding on every state change flickered)
		if open == "tradeList" and wasOpen ~= "tradeList" then
			wasOpen = open
			task.spawn(refreshList)
		end
		wasOpen = open
		-- a trade that started during a cinematic opens its window afterwards
		if w.pendingOpen and open == nil and not UI.IsCinematic() then
			w.pendingOpen = false
			task.defer(UI.TogglePanel, "trade")
		end
	end)
	table.insert(UI.Overlays, function()
		if last ~= nil then
			w.pendingOpen = true -- the trade window comes back after the cinematic
		end
		if w.request and w.request.Parent then
			w.request:Destroy()
		end
	end)
	Net.Get("TradeEvent").OnClientEvent:Connect(function(msg)
		if msg.type == "request" then
			requestCard(msg)
		elseif msg.type == "state" then
			renderState(msg)
		elseif msg.type == "closed" then
			last = nil
			w.pendingOpen = false
			if K.state.open == "trade" then
				UI.TogglePanel(nil)
			end
			if msg.reason == "done" then
				UI.Sfx("fanfare")
				UI.Toast("Trade complete!", "good")
			else
				UI.Toast(msg.reason or "Trade cancelled", "warn")
			end
		end
	end)
end

return TR
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX41C71E2E857B42A09370EEE5E1056143"><Properties><string name="Name">Tutorial</string><ProtectedString name="Source">-- First-time tutorial (7 steps) and, afterwards, the "next goal" card. One objective card at the top,
-- a guide beam + marker in the world, and a pulse on the button you need. Progress is saved on the server.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local Util = require(Shared:WaitForChild("Util"))

local Tut = {}
local K, UI, Cine, Guide
local P
local C = Color3.fromRGB
local w = {}
local DONE = 9
local localStep -- optimistic step while the server confirms
local events = { banked = false, checkpoint = false }

local function trapPad(st)
	local map = Workspace:FindFirstChild("GeneratedMap")
	local base = st.baseIndex and map and map:FindFirstChild("Bases") and map.Bases:FindFirstChild(string.format("Base%02d", st.baseIndex), true)
	return base and base:FindFirstChild("TrapPad")
end

local function nearestDrop(hrp)
	local drops = Workspace:FindFirstChild("RuntimeDrops")
	local best, target = math.huge, nil
	for _, m in ipairs(drops and drops:GetChildren() or {}) do
		local root = m:FindFirstChild("Root")
		if root then
			local d = (root.Position - hrp.Position).Magnitude
			if d &lt; best then
				best, target = d, root
			end
		end
	end
	return target
end

local function cheapestUpgrade(st)
	local best
	for _, c in ipairs(st.cars) do
		local def = CarConfig.ById[c.typeId]
		if def and c.level &lt; def.maxLevel then
			local cost = CarConfig.UpgradeCost(def, c.level)
			if not best or cost &lt; best.cost then
				local part, n = CarConfig.UpgradeParts(def, c.level)
				best = { cost = cost, part = part, n = n }
			end
		end
	end
	return best
end

-- step definitions: title, body, colour, target(st, hrp), done(st, hrp) -&gt; bool, progress(st) -&gt; 0..1, text
local STEPS = {
	{ "GO HUNTING", "Walk out through the big arch into the City", P and P.yellow,
		function() return Vector3.new(0, 2, MapConfig.EntryZ + 22) end,
		function(_, hrp) return hrp.Position.Z &gt; MapConfig.EntryZ + 6 end },
	{ "GRAB 3 GLOWING PARTS", "Cars are deadly: one hit and you lose what you carry", nil,
		function(_, hrp) return nearestDrop(hrp) end,
		function() return K.store.CarriedTotal() &gt;= 3 end,
		function() return math.min(K.store.CarriedTotal(), 3) / 3, string.format("%d / 3", math.min(K.store.CarriedTotal(), 3)) end },
	{ "RUN HOME TO BANK THEM", "Back through the arch - the dark lanes in the middle make you faster", nil,
		function() return Vector3.new(0, 2, MapConfig.EntryZ - 30) end,
		function() return events.banked end },
	{ "THROW PARTS INTO YOUR TRAP", "Go to the lift in your garage, press THROW, then ALL", nil,
		function(st) return trapPad(st) end,
		function(st) return (st.stats and st.stats.throws or 0) &gt; 0 end, nil, "throw" },
	{ "OPEN YOUR GARAGE", "Your car is parked and earning money every second", nil,
		function() return nil end,
		function() return K.state.open == "garage" end, nil, "garage" },
	{ "UPGRADE A CAR", "Press UPGRADE on a car: more levels = more money", nil,
		function() return nil end,
		function(st) return (st.stats and st.stats.upgrades or 0) &gt; 0 end, nil, "garage" },
	{ "REACH A CHECKPOINT", "Carry parts to the yellow arch at the far end of the City, then SAVE or RISK", nil,
		function() return Vector3.new(0, 2, MapConfig.Zones.city.zMax - 5) end,
		function() return events.checkpoint end },
	{ "UNLOCK THE HIGHWAY", "Open TELEPORT and unlock the Highway: better parts live there", nil,
		function() return nil end,
		function(st) return st.zones and st.zones.highway == true end, nil, "teleport" },
}

local function build()
	local card = K.new("Frame", { Name = "Objective", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 74), Size = UDim2.fromOffset(560, 96), BackgroundColor3 = P.white,
		ClipsDescendants = true, Visible = false }, K.root)
	K.corner(card, 20)
	K.stroke(card, P.ink, 4)
	w.card = card
	-- the colour badge follows the card's rounded left corners (ClipsDescendants ignores UICorner, so a square badge
	-- used to stick out of the outline): rounded badge + a square filler on its right half
	w.badge = K.new("Frame", { Size = UDim2.fromOffset(96, 96), BackgroundColor3 = P.yellow, BorderSizePixel = 0 }, card)
	K.corner(w.badge, 20)
	w.badgeFill = K.new("Frame", { Position = UDim2.fromOffset(48, 0), Size = UDim2.fromOffset(48, 96), BackgroundColor3 = P.yellow, BorderSizePixel = 0 }, w.badge)
	w.badgeText = K.text(w.badge, { Text = "1/8", TextSize = 30, ZIndex = 2, Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 36), TextXAlignment = Enum.TextXAlignment.Center, Outline = 2.5 })
	w.badgeSub = K.text(w.badge, { Text = "STEP", Font = K.BODY, TextSize = 12, ZIndex = 2, Position = UDim2.fromOffset(0, 62), Size = UDim2.new(1, 0, 0, 16), TextXAlignment = Enum.TextXAlignment.Center })
	w.title = K.text(card, { Text = "", TextSize = 24, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(112, 10), Size = UDim2.fromOffset(400, 28) })
	w.body = K.text(card, { Text = "", Font = K.BODY, TextSize = 15, TextColor3 = P.muted, TextWrapped = true, Position = UDim2.fromOffset(112, 40), Size = UDim2.fromOffset(436, 34) })
	local bar = K.new("Frame", { Position = UDim2.fromOffset(112, 76), Size = UDim2.fromOffset(300, 8), BackgroundColor3 = C(230, 232, 236), Visible = false }, card)
	K.corner(bar, 4)
	w.bar = bar
	w.fill = K.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = P.yellow }, bar)
	K.corner(w.fill, 4)
	w.progText = K.text(card, { Text = "", Font = K.BODY, TextSize = 13, TextColor3 = P.orange, Position = UDim2.fromOffset(420, 70), Size = UDim2.fromOffset(80, 18), Visible = false })
	w.skip = K.new("TextButton", { Text = "SKIP", Font = K.BODY, TextSize = 13, TextColor3 = P.grey, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 6),
		Size = UDim2.fromOffset(50, 20) }, card)
	w.skip.Activated:Connect(function()
		localStep = DONE
		Net.Get("TutorialStep"):FireServer("skip")
	end)
	w.scale = K.new("UIScale", {}, card)
	w.tick = K.text(w.badge, { Text = "OK!", TextSize = 30, TextColor3 = C(120, 255, 150), Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Visible = false, ZIndex = 5 })
end

local pulses = {}
local function pulse(button)
	for b, sc in pairs(pulses) do
		if b ~= button then
			sc.Scale = 1
		end
	end
	if not button then
		return
	end
	local holder = button.holder
	local sc = pulses[button] or holder:FindFirstChild("TutPulse") or K.new("UIScale", { Name = "TutPulse" }, holder)
	pulses[button] = sc
	sc.Scale = 1 + 0.07 * math.abs(math.sin(os.clock() * 4))
end

local shownKey
local function show(key, badge, sub, color, title, body, prog, progText, canSkip)
	w.card.Visible = true
	w.badge.BackgroundColor3 = color
	w.badgeFill.BackgroundColor3 = color
	w.badgeText.Text = badge
	local lim = w.badgeText:FindFirstChildOfClass("UITextSizeConstraint")
	if lim then
		lim.MaxTextSize = #badge &gt; 3 and 22 or 30
	end
	w.badgeSub.Text = sub
	w.title.Text = title
	w.body.Text = body
	w.bar.Visible = prog ~= nil
	w.progText.Visible = prog ~= nil
	if prog then
		w.fill.Size = UDim2.fromScale(prog, 1)
		w.fill.BackgroundColor3 = color
		w.progText.Text = progText or ""
		w.progText.TextColor3 = color
	end
	w.skip.Visible = canSkip
	if shownKey ~= key then
		shownKey = key
		w.scale.Scale = 0.7
		K.tween(w.scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	end
end

local function tick()
	local st = K.store.State
	local char = Players.LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not st or not hrp then
		return
	end
	local step = math.max(st.tutorial or 0, localStep or 0, 1)
	if step &gt;= DONE then
		Guide.Point(nil)
		pulse(nil)
		local goal = K.hud.nextGoal
		w.card.ZIndex = 1
		w.card.Position = UDim2.new(0.5, 0, 0, 74)
		K.hud.tutInPanel = false
		if goal and K.state.open == nil then
			show("goal:" .. goal[1], "GOAL", "", P.blue, goal[1], goal[2], nil, nil, false)
		else
			w.card.Visible = false
		end
		return
	end
	local def = STEPS[step]
	-- lost the loot on the way home: point back at the parts
	if step == 3 and K.store.CarriedTotal() == 0 and not events.banked then
		def = STEPS[2]
	end
	local color = ({ P.yellow, P.orange, P.green, P.yellow, P.blue, P.blue, P.red, P.green })[step]
	local body = def[2]
	if step == 6 then
		local up = cheapestUpgrade(st)
		if up then
			body = string.format("Press UPGRADE on a car  ·  needs $%s + %d %s", Util.FormatNumber(up.cost), up.n, up.part)
		end
	end
	local prog, progText
	if def[6] then
		prog, progText = def[6]()
	end
	show("step" .. step .. def[1], step .. "/" .. (DONE - 1), "STEP", color, def[1], body, prog, progText, true)
	-- steps that happen inside a panel (garage, upgrade): the card goes on top of the panel's dim, at the very top
	local inPanel = K.state.open ~= nil
	w.card.ZIndex = inPanel and 30 or 1
	K.hud.tutInPanel = inPanel
	w.card.Position = UDim2.new(0.5, 0, 0, inPanel and 4 or 74)
	Guide.Point(def[4](st, hrp))
	pulse(def[8] == "throw" and K.hud.throw or (def[8] == "garage" and K.hud.garageBtn) or (def[8] == "teleport" and K.hud.teleportBtn) or nil)
	if def == STEPS[step] and def[5](st, hrp) then
		localStep = step + 1
		events.banked = step &gt;= 3 and events.banked
		Net.Get("TutorialStep"):FireServer(step + 1)
		UI.Sfx("step")
		if step + 1 == DONE then
			Cine.Title("TUTORIAL COMPLETE!", P.yellow, 1.6, 90, 0.35)
			Cine.Sub("Keep unlocking districts to get better parts", Color3.new(1, 1, 1), 3.2, 0.5)
		else
			-- quiet confirmation: green tick on the card
			w.tickToken = (w.tickToken or 0) + 1
			local token = w.tickToken
			w.tick.Visible = true
			w.tick.TextTransparency = 0
			K.tween(w.tick, 0.9, { TextTransparency = 1 })
			task.delay(0.9, function()
				if w.tickToken == token then -- a newer tick keeps showing
					w.tick.Visible = false
				end
			end)
		end
	end
end

function Tut.Start(ui, cine, guide)
	UI = ui
	K = UI.Kit()
	P = K.P
	Cine = cine
	Guide = guide
	build()
	Net.Get("BankFx").OnClientEvent:Connect(function()
		events.banked = true
	end)
	Net.Get("CheckpointOffer").OnClientEvent:Connect(function()
		events.checkpoint = true
	end)
	task.spawn(function()
		while true do
			task.wait(0.15)
			pcall(tick)
		end
	end)
end

return Tut
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7CF75397469A4A53BA17403D63F0446C"><Properties><string name="Name">UIExtra</string><ProtectedString name="Source">-- Extra HUD + panels: Pit Stop perks, Golden Magnate donations, combo meter, contracts, hot drop banner, boosts.
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Strings = require(Shared:WaitForChild("Strings"))
local Util = require(Shared:WaitForChild("Util"))
local ShopConfig = require(Shared:WaitForChild("ShopConfig"))
local DonateConfig = require(Shared:WaitForChild("DonateConfig"))
local ProductIds = require(Shared:WaitForChild("ProductIds"))
local IS_STUDIO = game:GetService("RunService"):IsStudio()
local randomRestricted = false
task.spawn(function()
	local ok, info = pcall(function()
		return game:GetService("PolicyService"):GetPolicyInfoForPlayerAsync(game:GetService("Players").LocalPlayer)
	end)
	randomRestricted = ok and info and info.ArePaidRandomItemsRestricted == true or false
end)
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local TuningConfig = require(Shared:WaitForChild("TuningConfig"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local SkinConfig = require(Shared:WaitForChild("SkinConfig"))
local CollectionService = game:GetService("CollectionService")

local T = Strings.T
local C = Color3.fromRGB
local X = {}
local K, UI
local P
local w = {}
local hot = nil -- current hot drop info
local donateTab = "boost"
local tonyTab = "rewards"
local shopTab = "perks"
local tuneUid = nil
local TONY = C(30, 36, 58)
local GOLD = C(232, 178, 50)
local TEAL = C(40, 150, 140) -- rebirth teal (no purple in this UI)
local contractText -- defined with the HUD widgets

local function fmtTime(sec)
	sec = math.max(0, math.floor(sec))
	return string.format("%d:%02d", math.floor(sec / 60), sec % 60)
end

---------------------------------------------------------------- Pit Stop
local function buildShop()
	local p = K.panelShell("shop", T("shop_title"), 900, 600, P.red)
	local tabs = K.new("Frame", { Size = UDim2.new(1, 0, 0, 56), BackgroundTransparency = 1, ZIndex = 22 }, p.content)
	K.list(tabs, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center)
	w.shopTabs = {}
	for i, tab in ipairs({ "perks", "garage" }) do
		w.shopTabs[tab] = K.toy(tabs, { Text = T("shop_tab_" .. tab), Color = P.grey, Size = UDim2.fromOffset(200, 52), LayoutOrder = i, ZIndex = 23, TextSize = 20,
			OnClick = function()
				shopTab = tab
				UI.Refresh()
			end })
	end
	local grid = K.new("ScrollingFrame", { Position = UDim2.fromOffset(0, 66), Size = UDim2.new(1, 0, 1, -66), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 8,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 22 }, p.content)
	K.new("UIGridLayout", { CellSize = UDim2.fromOffset(204, 214), CellPadding = UDim2.fromOffset(12, 12), SortOrder = Enum.SortOrder.LayoutOrder }, grid)
	w.shopGrid = grid
end

local function refreshSkins(st)
	for _, def in ipairs(SkinConfig.Skins) do
		local owned = (st.skins and st.skins[def.id]) or (def.pass and st.passes and st.passes[def.pass])
		local on = st.skin == def.id
		local card = K.new("Frame", { BackgroundColor3 = def.style.wall:Lerp(Color3.new(1, 1, 1), 0.75), LayoutOrder = def.order, ZIndex = 23 }, w.shopGrid)
		K.corner(card, 20)
		K.stroke(card, on and P.green or P.ink, on and 5 or 3)
		-- mini swatch of the skin colours
		local sw = K.new("Frame", { Position = UDim2.new(0.5, 0, 0, 10), AnchorPoint = Vector2.new(0.5, 0), Size = UDim2.fromOffset(150, 40), BackgroundTransparency = 1, ZIndex = 24 }, card)
		K.list(sw, Enum.FillDirection.Horizontal, 4, Enum.HorizontalAlignment.Center)
		for _, k in ipairs({ "wall", "floor", "frame", "accent" }) do
			local c = K.new("Frame", { Size = UDim2.fromOffset(32, 40), BackgroundColor3 = def.style[k], ZIndex = 25 }, sw)
			K.corner(c, 8)
			K.stroke(c, P.ink, 2)
		end
		K.text(card, { Text = def.icon .. " " .. string.upper(def.name), TextSize = 18, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(0, 56), Size = UDim2.new(1, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
		K.text(card, { Text = def.bonus &gt; 0 and T("skin_bonus", math.floor(def.bonus * 100 + 0.5)) or "-", Font = K.BODY, TextSize = 18, TextColor3 = C(30, 158, 64), Position = UDim2.fromOffset(0, 86), Size = UDim2.new(1, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
		local label, color, can
		if on then
			label, color = T("skin_on"), P.green
		elseif owned then
			label, color, can = T("skin_equip"), P.blue, true
		elseif def.pass then
			local it = DonateConfig.ById[def.pass]
			label, color, can = "R$ " .. (it and it.price or "?"), GOLD, true
		elseif def.tokens then
			label, color, can = "🪙 " .. def.tokens, (st.tokens or 0) &gt;= def.tokens and P.orange or P.grey, true
		else
			label, color, can = "$" .. Util.FormatNumber(def.money), K.store.Money &gt;= def.money and P.green or P.grey, true
		end
		K.toy(card, { Text = label, Color = color, Size = UDim2.fromOffset(176, 62), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -6), ZIndex = 25, TextSize = 22,
			OnClick = function()
				if can then
					K.actions.SetSkin(def.id)
				end
			end })
	end
end

local function refreshShop(st, open)
	if open ~= "shop" then
		return
	end
	for tab, b in pairs(w.shopTabs) do
		b.SetColor(tab == shopTab and P.yellow or P.grey)
	end
	K.clear(w.shopGrid)
	if shopTab == "garage" then
		refreshSkins(st)
		return
	end
	for _, def in ipairs(ShopConfig.Perks) do
		local lvl = st.perks and st.perks[def.id] or 0
		local cost = ShopConfig.NextCost(def.id, lvl)
		local card = K.new("Frame", { BackgroundColor3 = P.white, LayoutOrder = def.order, ZIndex = 23 }, w.shopGrid)
		K.corner(card, 20)
		K.stroke(card, P.ink, 3)
		K.text(card, { Text = def.icon, Font = K.BODY, TextSize = 40, Size = UDim2.new(1, 0, 0, 48), Position = UDim2.fromOffset(0, 6), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
		K.text(card, { Text = string.upper(def.name), TextSize = 20, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(0, 54), Size = UDim2.new(1, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
		K.text(card, { Text = def.desc, Font = K.BODY, TextSize = 14, TextColor3 = P.muted, TextWrapped = true, Position = UDim2.fromOffset(8, 78), Size = UDim2.new(1, -16, 0, 36), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
		local pips = K.new("Frame", { Position = UDim2.new(0.5, 0, 0, 118), AnchorPoint = Vector2.new(0.5, 0), Size = UDim2.fromOffset(def.max * 22, 14), BackgroundTransparency = 1, ZIndex = 24 }, card)
		K.list(pips, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center)
		for i = 1, def.max do
			local pip = K.new("Frame", { Size = UDim2.fromOffset(16, 14), BackgroundColor3 = (i &lt;= lvl) and P.green or C(220, 222, 226), ZIndex = 25 }, pips)
			K.corner(pip, 5)
			K.stroke(pip, P.ink, 1.5)
		end
		local can = cost and K.store.Money &gt;= cost
		K.toy(card, { Text = cost and ("$" .. Util.FormatNumber(cost)) or T("shop_max"), Sub = cost and T("shop_buy") or nil,
			Color = cost and (can and P.green or P.grey) or P.yellow, Size = UDim2.fromOffset(176, 62), AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -6), ZIndex = 25, TextSize = 22, SubSize = 13,
			OnClick = function()
				if cost then
					K.actions.BuyPerk(def.id)
				end
			end })
	end
end

---------------------------------------------------------------- Golden Magnate
local function buildDonate()
	local p = K.panelShell("donate", T("donate_title"), 920, 600, GOLD)
	local tabs = K.new("Frame", { Size = UDim2.new(1, 0, 0, 56), BackgroundTransparency = 1, ZIndex = 22 }, p.content)
	K.list(tabs, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center)
	w.donateTabs = {}
	for i, tab in ipairs({ "boost", "pack", "pass" }) do
		w.donateTabs[tab] = K.toy(tabs, { Text = T("donate_" .. tab), Color = P.grey, Size = UDim2.fromOffset(170, 52), LayoutOrder = i, ZIndex = 23, TextSize = 20,
			OnClick = function()
				donateTab = tab
				UI.Refresh()
			end })
	end
	local grid = K.new("ScrollingFrame", { Position = UDim2.fromOffset(0, 66), Size = UDim2.new(1, 0, 1, -66), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 8, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 22 }, p.content)
	K.new("UIGridLayout", { CellSize = UDim2.fromOffset(204, 200), CellPadding = UDim2.fromOffset(12, 12), SortOrder = Enum.SortOrder.LayoutOrder }, grid)
	w.donateGrid = grid
end

local function refreshDonate(st, open)
	if open ~= "donate" then
		return
	end
	for tab, b in pairs(w.donateTabs) do
		b.SetColor(tab == donateTab and GOLD or P.grey)
	end
	K.clear(w.donateGrid)
	local items = donateTab == "pass" and DonateConfig.Passes or DonateConfig.Products
	for _, it in ipairs(items) do
		-- live game: only products that exist on Roblox, and no paid random items where they are not allowed
		if it.tab == donateTab and DonateConfig.Available(it, ProductIds, IS_STUDIO, randomRestricted) then
			local owned = it.isPass and st.passes and st.passes[it.id]
			local card = K.new("Frame", { BackgroundColor3 = C(255, 250, 236), LayoutOrder = it.order, ZIndex = 23 }, w.donateGrid)
			K.corner(card, 20)
			K.stroke(card, GOLD, 4)
			K.text(card, { Text = it.icon, Font = K.BODY, TextSize = 40, Size = UDim2.new(1, 0, 0, 48), Position = UDim2.fromOffset(0, 6), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
			K.text(card, { Text = string.upper(it.name), TextSize = 19, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(0, 54), Size = UDim2.new(1, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
			local desc = it.desc
			if it.boost and st.boosts and (st.boosts[it.boost] or 0) &gt; 0 then
				desc = desc .. "\nActive: " .. fmtTime(st.boosts[it.boost])
			end
			K.text(card, { Text = desc, Font = K.BODY, TextSize = 14, TextColor3 = P.muted, TextWrapped = true, Position = UDim2.fromOffset(8, 78), Size = UDim2.new(1, -16, 0, 50), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
			K.toy(card, { Text = owned and T("donate_owned") or ("R$ " .. it.price), Color = owned and P.grey or GOLD, Size = UDim2.fromOffset(176, 58),
				AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -6), ZIndex = 25, TextSize = 24,
				OnClick = function()
					if not owned then
						K.actions.Donate(it.id)
					end
				end })
		end
	end
end

---------------------------------------------------------------- Big Tony: rewards + exchange
local function costLine(r, st)
	local bits = {}
	local function add(have, need, label)
		local col = have &gt;= need and "#1E9E40" or "#D6342C"
		table.insert(bits, string.format('&lt;font color="%s"&gt;%s&lt;/font&gt;', col, label))
	end
	for _, part in ipairs(PartConfig.Order or { "bolts", "tire", "engine", "turbo", "core" }) do
		local n = r.parts and r.parts[part]
		if n then
			add(st.parts[part] or 0, n, K.PART_ICON[part] .. n)
		end
	end
	for item, n in pairs(r.tune or {}) do
		local it = TuningConfig.Items[item]
		add((st.tuning or {})[item] or 0, n, it.icon .. it.name .. " x" .. n)
	end
	add(K.store.Money, r.money, "$" .. Util.FormatNumber(r.money))
	return table.concat(bits, "  ")
end

local function buildTony()
	local p = K.panelShell("tony", T("tony_title"), 920, 600, TONY)
	local tabs = K.new("Frame", { Size = UDim2.new(1, 0, 0, 56), BackgroundTransparency = 1, ZIndex = 22 }, p.content)
	K.list(tabs, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center)
	w.tonyTabs = {}
	for i, tab in ipairs({ "rewards", "exchange" }) do
		w.tonyTabs[tab] = K.toy(tabs, { Text = T("tony_" .. tab), Color = P.grey, Size = UDim2.fromOffset(200, 52), LayoutOrder = i, ZIndex = 23, TextSize = 20,
			OnClick = function()
				tonyTab = tab
				UI.Refresh()
			end })
	end
	w.tonyList = K.scroller(p.content, UDim2.fromOffset(0, 66), UDim2.new(1, 0, 1, -66))
end

local function row(parent, order, h, accent)
	local r = K.new("Frame", { Size = UDim2.new(1, 0, 0, h), BackgroundColor3 = P.white, LayoutOrder = order, ZIndex = 23 }, parent)
	K.corner(r, 18)
	K.stroke(r, accent or P.ink, 3)
	return r
end

local function refreshTony(st, open)
	if open ~= "tony" then
		return
	end
	for tab, b in pairs(w.tonyTabs) do
		b.SetColor(tab == tonyTab and P.yellow or P.grey)
	end
	K.clear(w.tonyList)
	if tonyTab == "rewards" then
		K.text(w.tonyList, { Text = T("tony_hint"), Font = K.BODY, TextSize = 16, TextColor3 = P.muted, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 0, ZIndex = 23, TextXAlignment = Enum.TextXAlignment.Center })
		for i, c in ipairs(st.contracts or {}) do
			local r = row(w.tonyList, i, 84, c.ready and P.green or P.ink)
			K.text(r, { Text = contractText(c), TextSize = 20, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(18, 10), Size = UDim2.new(1, -260, 0, 30), ZIndex = 24 })
			local part = c.reward and K.PART_ICON[c.reward.part] or ""
			K.text(r, { Text = string.format("%d/%d   ·   +$%s  %s x%d", c.progress, c.n, Util.FormatNumber(c.reward.money), part, c.reward.n), Font = K.BODY, TextSize = 16,
				TextColor3 = P.muted, Position = UDim2.fromOffset(18, 44), Size = UDim2.new(1, -260, 0, 26), ZIndex = 24 })
			K.toy(r, { Text = c.ready and T("tony_claim") or T("tony_working"), Color = c.ready and P.green or P.grey, Size = UDim2.fromOffset(200, 60), AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -12, 0.5, 0), ZIndex = 25, TextSize = c.ready and 24 or 16,
				OnClick = function()
					if c.ready then
						K.actions.Claim(c.id)
					end
				end })
		end
	else
		for i, r in ipairs(TuningConfig.Recipes) do
			local it = TuningConfig.Items[r.out]
			local fr = row(w.tonyList, i, 78)
			K.text(fr, { Text = it.icon, Font = K.BODY, TextSize = 34, Position = UDim2.fromOffset(12, 0), Size = UDim2.fromOffset(50, 78), ZIndex = 24, TextXAlignment = Enum.TextXAlignment.Center })
			K.text(fr, { Text = string.format("%s  &lt;font color=\"#1E9E40\"&gt;+%d%%&lt;/font&gt;", string.upper(it.name), math.floor(it.bonus * 100 + 0.5)), RichText = true, TextSize = 20,
				TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(70, 8), Size = UDim2.new(1, -300, 0, 28), ZIndex = 24 })
			K.text(fr, { Text = costLine(r, st), RichText = true, Font = K.BODY, TextSize = 15, TextColor3 = P.muted, Position = UDim2.fromOffset(70, 40), Size = UDim2.new(1, -300, 0, 26), ZIndex = 24 })
			K.text(fr, { Text = T("tony_have", (st.tuning or {})[r.out] or 0), Font = K.BODY, TextSize = 14, TextColor3 = P.muted, AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -184, 0.5, 0), Size = UDim2.fromOffset(70, 20), ZIndex = 24, TextXAlignment = Enum.TextXAlignment.Right })
			K.toy(fr, { Text = T("tony_build"), Color = P.orange, Size = UDim2.fromOffset(160, 58), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
				ZIndex = 25, TextSize = 22, OnClick = function() K.actions.Craft(r.id) end })
		end
	end
end

---------------------------------------------------------------- Tuning a car
local function buildTune()
	local p = K.panelShell("tune", T("tune_title"), 900, 600, P.yellow)
	w.tuneHead = K.text(p.content, { Text = "", TextSize = 22, TextColor3 = P.ink, Outline = false, Size = UDim2.new(1, 0, 0, 30), RichText = true, ZIndex = 23 })
	w.tuneList = K.scroller(p.content, UDim2.fromOffset(0, 38), UDim2.new(1, 0, 1, -38))
end

local function refreshTune(st, open)
	if open ~= "tune" then
		return
	end
	local car
	for _, c in ipairs(st.cars) do
		if c.uid == tuneUid then
			car = c
		end
	end
	K.clear(w.tuneList)
	if not car then
		w.tuneHead.Text = ""
		return
	end
	local def = CarConfig.ById[car.typeId]
	local mult = TuningConfig.CarMult(car.tune)
	w.tuneHead.Text = string.format('%s   &lt;font color="#1E9E40"&gt;+%s/s  (x%.2f)&lt;/font&gt;', def.name, Util.FormatNumber(CarConfig.CarIncome(car)), mult)
	for i, cat in ipairs(TuningConfig.Categories) do
		local cur = car.tune and car.tune[cat.id]
		local curIt = cur and TuningConfig.Items[cur]
		local fr = row(w.tuneList, i, 76, curIt and P.green or P.ink)
		K.text(fr, { Text = cat.icon, Font = K.BODY, TextSize = 30, Position = UDim2.fromOffset(10, 0), Size = UDim2.fromOffset(46, 76), ZIndex = 24, TextXAlignment = Enum.TextXAlignment.Center })
		K.text(fr, { Text = string.upper(cat.name), TextSize = 18, TextColor3 = P.muted, Outline = false, Position = UDim2.fromOffset(62, 6), Size = UDim2.fromOffset(160, 22), ZIndex = 24 })
		K.text(fr, { Text = curIt and string.format("%s +%d%%", curIt.name, math.floor(curIt.bonus * 100 + 0.5)) or T("tune_empty"), TextSize = 18,
			TextColor3 = curIt and P.ink or P.muted, Outline = false, Position = UDim2.fromOffset(62, 32), Size = UDim2.fromOffset(220, 30), ZIndex = 24 })
		local opts = K.new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(540, 60), BackgroundTransparency = 1, ZIndex = 24 }, fr)
		K.list(opts, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
		local any = false
		for _, id in ipairs(TuningConfig.Order) do
			local it = TuningConfig.Items[id]
			local have = (st.tuning or {})[id] or 0
			if it.cat == cat.id and have &gt; 0 then
				any = true
				K.toy(opts, { Text = it.icon .. " " .. string.rep("I", it.stage), Sub = "x" .. have, SubSize = 12, TextSize = 16, Color = P.blue, Size = UDim2.fromOffset(96, 54),
					LayoutOrder = it.stage, ZIndex = 25, OnClick = function() K.actions.Tune(car.uid, cat.id, id) end })
			end
		end
		if curIt then
			K.toy(opts, { Text = T("tune_remove"), Color = P.red, Size = UDim2.fromOffset(110, 54), TextSize = 16, LayoutOrder = 9, ZIndex = 25,
				OnClick = function() K.actions.Tune(car.uid, cat.id, nil) end })
		elseif not any then
			K.text(opts, { Text = T("tune_none"), Font = K.BODY, TextSize = 14, TextColor3 = P.muted, Size = UDim2.fromOffset(260, 30), ZIndex = 25, TextXAlignment = Enum.TextXAlignment.Right })
		end
	end
end

---------------------------------------------------------------- Welcome back (offline earnings)
local function showOffline(info)
	local dim = K.new("TextButton", { Name = "WelcomeBack", Text = "", AutoButtonColor = false, Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(0, 0, 0), BackgroundTransparency = 0.45, ZIndex = 80 }, K.overlay)
	local card = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(520, 330), BackgroundColor3 = P.cream, ZIndex = 81 }, dim)
	K.corner(card, 28)
	K.stroke(card, P.ink, 5)
	local sc = K.new("UIScale", { Scale = 0.5 }, card)
	K.tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	K.text(card, { Text = "WELCOME BACK!", TextSize = 42, Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 48), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 82, Outline = 3 })
	local h = math.floor(info.seconds / 3600)
	local m = math.floor(info.seconds % 3600 / 60)
	K.text(card, { Text = string.format("Your garage worked for %dh %02dm while you were away%s", h, m, info.capped and " (max 8h)" or ""), Font = K.BODY, TextSize = 17, TextColor3 = P.muted,
		TextWrapped = true, Position = UDim2.fromOffset(30, 72), Size = UDim2.new(1, -60, 0, 44), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 82 })
	K.new("ImageLabel", { Position = UDim2.fromOffset(110, 128), Size = UDim2.fromOffset(64, 64), BackgroundTransparency = 1, Image = require(game:GetService("ReplicatedStorage").Shared.Icons).Get("coin") or "", ZIndex = 82 }, card)
	K.text(card, { Text = "+$" .. Util.FormatNumber(info.amount), TextSize = 48, TextColor3 = C(70, 220, 100), Position = UDim2.fromOffset(184, 132), Size = UDim2.fromOffset(300, 56), ZIndex = 82, Outline = 3 })
	local function closeCard()
		dim:Destroy()
	end
	local btns = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -22), Size = UDim2.fromOffset(470, 76), BackgroundTransparency = 1, ZIndex = 82 }, card)
	K.list(btns, Enum.FillDirection.Horizontal, 16, Enum.HorizontalAlignment.Center)
	K.toy(btns, { Text = "COLLECT", Color = P.green, Size = UDim2.fromOffset(210, 72), TextSize = 26, LayoutOrder = 1, ZIndex = 83, OnClick = closeCard })
	local x2 = DonateConfig.ById.offline_x2
	if x2 and DonateConfig.Available(x2, ProductIds, IS_STUDIO, randomRestricted) then
		K.toy(btns, { Text = "x2", Sub = "R$ " .. x2.price, Color = GOLD, Size = UDim2.fromOffset(150, 72), TextSize = 28, SubSize = 14, LayoutOrder = 2, ZIndex = 83,
			OnClick = function()
				K.actions.Donate("offline_x2")
				closeCard()
			end })
	end
	UI.Sfx("cash")
end

---------------------------------------------------------------- Rebirth + token shop
local function buildRebirth()
	local p = K.panelShell("rebirth", T("rebirth_title"), 860, 600, TEAL)
	w.rbInfo = K.text(p.content, { Text = "", Font = K.BODY, TextSize = 19, TextColor3 = P.ink, RichText = true, TextWrapped = true, Size = UDim2.new(1, 0, 0, 150),
		TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 23 })
	w.rbGo = K.toy(p.content, { Text = T("rebirth_go"), Color = P.grey, Size = UDim2.fromOffset(300, 70), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 158),
		ZIndex = 24, TextSize = 28, OnClick = function()
			if w.rbArmed and os.clock() - w.rbArmed &lt; 3 then
				w.rbArmed = nil
				K.actions.Rebirth()
				UI.TogglePanel(nil)
			else
				w.rbArmed = os.clock()
				UI.Refresh()
				task.delay(3.05, UI.Refresh) -- back from "SURE?" when the 3 s run out
			end
		end })
	w.rbTokens = K.text(p.content, { Text = "", TextSize = 22, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(0, 240), Size = UDim2.new(1, 0, 0, 28), ZIndex = 23 })
	w.rbShop = K.new("Frame", { Position = UDim2.fromOffset(0, 276), Size = UDim2.new(1, 0, 0, 200), BackgroundTransparency = 1, ZIndex = 23 }, p.content)
	K.new("UIGridLayout", { CellSize = UDim2.fromOffset(256, 190), CellPadding = UDim2.fromOffset(12, 12), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center }, w.rbShop)
	-- button in the garage panel
	local gp = K.panels.garage
	if gp then
		K.toy(gp.content, { Text = T("btn_rebirth"), Icon = "♻️", Color = TEAL, Size = UDim2.fromOffset(150, 54), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -372, 0, -2),
			ZIndex = 23, TextSize = 17, OnClick = function() UI.TogglePanel("rebirth") end })
	end
end

local function refreshRebirth(st, open)
	if open ~= "rebirth" then
		return
	end
	local n = st.rebirths or 0
	local zone, money = SkinConfig.RebirthNeeds(n)
	local zoneOk = st.zones and st.zones[zone]
	local ok = zoneOk and K.store.Money &gt;= money
	local mult = 1 + SkinConfig.Rebirth.incomePer * (n + 1)
	local function mark(b)
		return b and '&lt;font color="#1E9E40"&gt;✔&lt;/font&gt;' or '&lt;font color="#D6342C"&gt;✘&lt;/font&gt;'
	end
	w.rbInfo.Text = string.format("%s %s\n%s\n%s\n%s", mark(ok), T("rebirth_need", T("zone_" .. zone), Util.FormatNumber(money)),
		'&lt;font color="#D6342C"&gt;' .. T("rebirth_lose") .. "&lt;/font&gt;", '&lt;font color="#1E9E40"&gt;' .. T("rebirth_keep") .. "&lt;/font&gt;", T("rebirth_gain", string.format("%.2f", mult)))
	local armed = w.rbArmed and os.clock() - w.rbArmed &lt; 3
	w.rbGo.SetText(armed and T("btn_sure") or T("rebirth_go"), nil)
	w.rbGo.SetColor(ok and (armed and P.red or TEAL) or P.grey)
	w.rbTokens.Text = "🪙 " .. T("rebirth_tokens", st.tokens or 0) .. "   ·   " .. T("rebirth_shop")
	K.clear(w.rbShop)
	for i, def in ipairs(SkinConfig.TokenPerks) do
		local lvl = st.tokenPerks and st.tokenPerks[def.id] or 0
		local card = K.new("Frame", { BackgroundColor3 = P.white, LayoutOrder = i, ZIndex = 24 }, w.rbShop)
		K.corner(card, 18)
		K.stroke(card, P.ink, 3)
		K.text(card, { Text = def.icon, Font = K.BODY, TextSize = 36, Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 6), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 25 })
		K.text(card, { Text = string.upper(def.name), TextSize = 17, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(6, 54), Size = UDim2.new(1, -12, 0, 40), TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 25 })
		K.text(card, { Text = string.format("%d / %d", lvl, def.max), Font = K.BODY, TextSize = 15, TextColor3 = P.muted, Position = UDim2.fromOffset(0, 96), Size = UDim2.new(1, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 25 })
		local maxed = lvl &gt;= def.max
		K.toy(card, { Text = maxed and T("shop_max") or ("🪙 " .. def.cost), Color = maxed and P.yellow or ((st.tokens or 0) &gt;= def.cost and P.orange or P.grey), Size = UDim2.fromOffset(170, 56),
			AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -6), ZIndex = 26, TextSize = 20, OnClick = function()
				if not maxed then
					K.actions.TokenPerk(def.id)
				end
			end })
	end
end

---------------------------------------------------------------- contract cards on the board (local player's jobs)
local function refreshBoard(st)
	for _, card in ipairs(CollectionService:GetTagged("ContractCard")) do
		local idx = card:GetAttribute("Index")
		local c = st.contracts and st.contracts[idx]
		local gui = card:FindFirstChild("CardGui")
		if not gui then
			gui = K.new("SurfaceGui", { Name = "CardGui", Face = Enum.NormalId.Front, SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud, PixelsPerStud = 40, LightInfluence = 0.2 }, card)
			K.new("Frame", { Name = "Bg", Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(255, 248, 228) }, gui)
			K.text(gui, { Name = "Title", Text = "", TextSize = 30, TextColor3 = P.ink, Outline = false, Position = UDim2.new(0, 14, 0, 20), Size = UDim2.new(1, -28, 0.45, 0),
				TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 2 })
			K.text(gui, { Name = "Prog", Text = "", TextSize = 40, TextColor3 = P.ink, Outline = false, Position = UDim2.new(0, 0, 0.55, 0), Size = UDim2.new(1, 0, 0, 48),
				TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 2 })
			K.text(gui, { Name = "Reward", Text = "", Font = K.BODY, TextSize = 26, TextColor3 = C(30, 158, 64), Outline = false, Position = UDim2.new(0, 0, 0.75, 0), Size = UDim2.new(1, 0, 0, 34),
				TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 2 })
		end
		if c then
			gui.Title.Text = contractText(c)
			gui.Prog.Text = c.ready and "✅ CLAIM AT TONY" or string.format("%d / %d", c.progress, c.n)
			gui.Prog.TextColor3 = c.ready and C(30, 158, 64) or P.ink
			gui.Reward.Text = "+$" .. Util.FormatNumber(c.reward.money) .. "  " .. (K.PART_ICON[c.reward.part] or "") .. "x" .. c.reward.n
			gui.Bg.BackgroundColor3 = c.ready and C(220, 250, 226) or C(255, 248, 228)
		else
			gui.Title.Text, gui.Prog.Text, gui.Reward.Text = "NEW JOB SOON", "...", ""
			gui.Bg.BackgroundColor3 = C(235, 230, 218)
		end
	end
end

---------------------------------------------------------------- HUD widgets
local function buildHud()
	local root = K.root
	local colF = K.hud.leftCol
	-- SHOP + JOBS: square toy buttons with the 3D icons, label underneath
	local brow = K.new("Frame", { Name = "Buttons", Size = UDim2.fromOffset(300, 94), BackgroundTransparency = 1, LayoutOrder = 2 }, colF)
	K.list(brow, Enum.FillDirection.Horizontal, 12)
	local function iconButton(name, label, color, order, onClick)
		-- bigger 3D sticker (54 px) and a clear gap to the label below the button
		local holder = K.new("Frame", { Size = UDim2.fromOffset(66, 94), BackgroundTransparency = 1, LayoutOrder = order }, brow)
		local b = K.toy(holder, { Name = label .. "Btn", Text = "", Color = color, Size = UDim2.fromOffset(66, 66), OnClick = onClick })
		K.hud.icon(b.face, name, 54, UDim2.fromOffset(6, 3)).ZIndex = b.face.ZIndex + 1
		local l = K.text(holder, { Text = label, TextSize = 15, Position = UDim2.fromOffset(0, 72), Size = UDim2.new(1, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Center, Outline = 2.5 })
		return b, l
	end
	w.shopBtn = iconButton("shop", T("btn_magnate"), GOLD, 1, function()
		UI.TogglePanel("donate")
	end)
	w.jobsOpen = true
	w.jobsBtn, w.jobsLabel = iconButton("jobs", "JOBS", P.orange, 2, function()
		w.jobsOpen = not w.jobsOpen
		UI.Refresh()
	end)
	-- active boosts strip to the right of the wallet card
	w.boosts = K.new("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 310, 1, -24 - (K.hud.leftLift or 0)), Size = UDim2.fromOffset(240, 40), BackgroundTransparency = 1 }, root)
	K.list(w.boosts, Enum.FillDirection.Horizontal, 6)
	-- combo: one compact text line above THROW ("COMBO x1.5" + small speed-bonus timer), no card
	local combo = K.new("Frame", { Name = "Combo", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -138), Size = UDim2.fromOffset(360, 30), BackgroundTransparency = 1, Visible = false }, root)
	K.list(combo, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	w.combo = combo
	w.comboText = K.text(combo, { Text = "", TextSize = 24, TextColor3 = P.yellow, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 28), LayoutOrder = 1, Outline = 2.5 })
	w.comboSub = K.text(combo, { Text = "", Font = K.BODY, TextSize = 15, TextColor3 = P.white, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 20), LayoutOrder = 2 })
	K.new("UIStroke", { Color = P.ink, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual }, w.comboSub)
	w.comboScale = K.new("UIScale", {}, combo)
	-- contracts: plain outlined lines with a thin progress line (no card)
	local cw = K.new("Frame", { Name = "Contracts", Size = UDim2.fromOffset(280, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 1 }, colF)
	K.list(cw, Enum.FillDirection.Vertical, 7)
	w.contracts = cw
	w.contractRows = {}
	-- hot drop banner
	-- top-right corner, same row as the zone banner: the very top, never under notifications or the objective card
	local hb = K.new("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 12), Size = UDim2.fromOffset(380, 42),
		BackgroundColor3 = P.red, Visible = false }, root)
	K.corner(hb, 14)
	K.stroke(hb, P.ink, 3)
	w.hot = hb
	w.hotText = K.text(hb, { Text = "", TextSize = 20, Size = UDim2.new(1, -12, 1, 0), Position = UDim2.fromOffset(6, 0), TextXAlignment = Enum.TextXAlignment.Center })
end

local CONTRACT_PART = function(c)
	return PartConfig.Parts[c.part] and (K.PART_ICON[c.part] .. " " .. T("part_" .. c.part)) or ""
end

contractText = function(c)
	if c.kind == "bank_part" then
		return T("c_bank_part", c.n, CONTRACT_PART(c), T("zone_" .. tostring(c.zone)))
	elseif c.kind == "combo" then
		return T("c_combo", tostring(c.mult))
	elseif c.kind == "speed" then
		return T("c_speed", c.seconds or 40)
	elseif c.kind == "throw" then
		return T("c_throw", c.n)
	elseif c.kind == "road" then
		return T("c_road", c.n)
	end
	return T("c_hotdrop")
end

local function refreshHud(st)
	-- boosts
	K.clear(w.boosts)
	for _, b in ipairs({ { "income", "2X CASH" }, { "luck", "LUCK" } }) do
		local left = st.boosts and st.boosts[b[1]] or 0
		if left &gt; 0 then
			K.pill(w.boosts, b[2] .. " " .. fmtTime(left), GOLD, { H = 34, TextSize = 18 })
		end
	end
	if st.passes and st.passes.vip then
		K.pill(w.boosts, "VIP", GOLD, { H = 34, TextSize = 18 })
	end
	-- contracts
	for _, r in ipairs(w.contractRows) do
		r:Destroy()
	end
	w.contractRows = {}
	for i, c in ipairs(st.contracts or {}) do
		local row = K.new("Frame", { Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, LayoutOrder = i }, w.contracts)
		local line = c.ready and "READY  -  see Big Tony" or string.format("%d/%d   %s", c.progress, c.n, contractText(c))
		local lbl = K.text(row, { Text = line, Font = K.BODY, TextSize = 14, TextColor3 = c.ready and P.yellow or P.white, TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.new(1, 0, 0, 18) })
		K.new("UIStroke", { Color = P.ink, Thickness = 2.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual }, lbl)
		local bar = K.new("Frame", { Position = UDim2.fromOffset(0, 21), Size = UDim2.fromOffset(250, 2), BackgroundColor3 = P.ink, BackgroundTransparency = 0.5, BorderSizePixel = 0 }, row)
		K.new("Frame", { Size = UDim2.fromScale(c.progress / c.n, 1), BackgroundColor3 = c.ready and P.yellow or C(70, 220, 100), BorderSizePixel = 0 }, bar)
		table.insert(w.contractRows, row)
	end
	w.contracts.Visible = w.jobsOpen and #(st.contracts or {}) &gt; 0 and K.state.open == nil
	K.hud.leftCol.Visible = K.state.open == nil
	local ready = 0
	for _, c in ipairs(st.contracts or {}) do
		if c.ready then
			ready = ready + 1
		end
	end
	w.jobsLabel.Text = ready &gt; 0 and ("JOBS " .. ready .. "!") or "JOBS"
end

local lastMult = 1

local function tick()
	local st = K.store.State
	if not st then
		return
	end
	local run = st.run or {}
	local picked = run.picked or 0
	w.combo.Visible = picked &gt; 0 and K.state.open == nil
	if picked &gt; 0 then
		local mult = run.mult or 1
		w.comboText.Text = T("combo", tostring(mult))
		local elapsed = run.firstAt and (Workspace:GetServerTimeNow() - run.firstAt) or 999
		local left = 40 - elapsed
		w.comboSub.Text = left &gt; 0 and string.format("speed bonus %ds", math.ceil(left)) or "bank it at home"
		w.comboSub.TextColor3 = left &gt; 0 and (left &lt;= 10 and C(255, 120, 100) or P.white) or C(200, 200, 205)
		if mult &gt; lastMult then
			w.comboScale.Scale = 1.2
			K.tween(w.comboScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
			UI.Sfx("combo")
		end
		lastMult = mult
	else
		lastMult = 1
	end
	if hot then
		local now = Workspace:GetServerTimeNow()
		if hot.kind == "warn" then
			local left = hot.at - now
			w.hot.Visible = left &gt; 0
			w.hotText.Text = T("hot_drop_in", T("zone_" .. hot.zone), math.ceil(left))
		else
			local landing = hot.landAt - now
			local left = hot.expiresAt - now
			w.hot.Visible = left &gt; 0
			w.hotText.Text = "📦 " .. T("hot_drop") .. ": " .. string.upper(T("zone_" .. hot.zone)) .. "  " .. (landing &gt; 0 and ("⬇ " .. math.ceil(landing)) or ("⏱ " .. math.ceil(left)))
		end
		if not w.hot.Visible then
			hot = nil
		end
	else
		w.hot.Visible = false
	end
end

function X.OnHotDrop(info)
	if info.kind == "warn" then
		hot = { kind = "warn", zone = info.zone, at = Workspace:GetServerTimeNow() + info.inSeconds }
	elseif info.kind == "start" then
		hot = info
		if info.by then
			UI.Toast(T("hot_drop_called", info.by), "warn")
		end
		UI.Sfx("siren")
	elseif info.kind == "end" then
		if hot and hot.id == info.id then
			hot = nil
		end
		if info.reason == "taken" and info.winner then
			UI.Toast(T("hot_drop_taken", info.winner), "info")
		end
	end
end

function X.HotDrop()
	return hot
end

function X.Init(ui)
	UI = ui
	K = UI.Kit()
	P = K.P
	buildShop()
	buildDonate()
	buildTony()
	buildTune()
	buildRebirth()
	buildHud()
	UI.OnTune = function(uid)
		tuneUid = uid
		UI.TogglePanel("tune")
	end
	table.insert(UI.Hooks, function(st, open)
		refreshShop(st, open)
		refreshDonate(st, open)
		refreshTony(st, open)
		refreshTune(st, open)
		refreshRebirth(st, open)
		refreshHud(st)
		refreshBoard(st)
	end)
	K.store.MoneyChanged.Event:Connect(function()
		local st = K.store.State
		if st and K.state.open == "shop" then
			refreshShop(st, "shop")
		end
	end)
	require(Shared:WaitForChild("Net")).Get("OfflineEarnings").OnClientEvent:Connect(showOffline)
	-- walk up to the NPCs
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local n = prompt.Parent and prompt.Parent.Name
		if n == "ShopPrompt" then
			UI.TogglePanel("shop")
		elseif n == "DonatePrompt" then
			UI.TogglePanel("donate")
		elseif n == "MagnatPrompt" then
			-- Golden Magnat GT podium on the square: buy the game pass right here
			local st = K.store.State
			if st and st.passes and st.passes.golden_car then
				UI.Toast("You already own the Golden Magnat GT!", "good")
			else
				K.actions.Donate("golden_car")
			end
		elseif n == "TonyPrompt" then
			tonyTab = "rewards"
			for _, c in ipairs(K.store.State and K.store.State.contracts or {}) do
				if c.ready then
					K.actions.Claim("all") -- walking up pays out everything that's done
					break
				end
			end
			UI.TogglePanel("tony")
		end
	end)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc = acc + dt
		if acc &gt;= 0.1 then
			acc = 0
			tick()
		end
	end)
	-- boost timers count down locally between state pushes
	task.spawn(function()
		while true do
			task.wait(1)
			local st = K.store.State
			if st and st.boosts then
				for k, v in pairs(st.boosts) do
					st.boosts[k] = math.max(0, v - 1)
				end
				refreshHud(st)
				if K.state.open == "donate" then
					refreshDonate(st, "donate")
				end
			end
		end
	end)
end

return X
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4988016F7A614DF6B0A432C4602FB964"><Properties><string name="Name">ZoneFx</string><ProtectedString name="Source">-- Per-district hazards on the client: level-crossing lights/arms (docks), sandstorm (desert),
-- jet blast behind taxiing planes (airport), rain + lightning (storm).
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local TrafficMath = require(Shared:WaitForChild("TrafficMath"))

local ZoneFx = {}
local C = Color3.fromRGB

-- seconds until the next train passes x = 0 on this road (nil if far away)
local function trainNear(roadId, t)
	for _, lane in ipairs(TrafficMath.RoadLanes[roadId] or {}) do
		for k = 1, lane.count do
			local x = TrafficMath.CarX(lane, k, t)
			local half = 75
			-- approaching from its tail side or currently over the crossing
			local ahead = -x * lane.dir
			if math.abs(x) &lt; half + 20 or (ahead &gt; 0 and ahead &lt; lane.speed * 4 + half) then
				return true
			end
		end
	end
	return false
end

local function crossings(t)
	local blink = math.floor(t * 2.5) % 2
	local state = {}
	for _, l in ipairs(CollectionService:GetTagged("CrossingLight")) do
		local rid = l:GetAttribute("RoadId")
		if state[rid] == nil then
			state[rid] = trainNear(rid, t)
		end
		local on = state[rid] and (l:GetAttribute("Phase") % 2 == blink)
		l.Color = on and C(255, 40, 30) or C(90, 20, 20)
		l.Material = on and Enum.Material.Neon or Enum.Material.SmoothPlastic
	end
	for _, arm in ipairs(CollectionService:GetTagged("CrossingArm")) do
		local rid = arm:GetAttribute("RoadId")
		local down = state[rid]
		if down == nil then
			down = trainNear(rid, t)
			state[rid] = down
		end
		local base = arm:GetAttribute("BaseCF")
		if not base then
			arm:SetAttribute("BaseCF", arm.CFrame)
			base = arm.CFrame
		end
		local s = arm:GetAttribute("Side")
		local pivot = base * CFrame.new(s * 6, 0, 0)
		local goal = down and pivot * CFrame.new(-s * 6, 0, 0) or pivot * CFrame.Angles(0, 0, -s * math.rad(80)) * CFrame.new(-s * 6, 0, 0)
		arm.CFrame = arm.CFrame:Lerp(goal, 0.1)
	end
end

local atmo, rain, rainPart
local function ensureWeather()
	if not atmo then
		atmo = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere", Lighting)
		atmo:SetAttribute("BaseDensity", atmo.Density)
		atmo:SetAttribute("BaseHaze", atmo.Haze)
		atmo:SetAttribute("BaseColor", atmo.Color)
	end
	if not rainPart then
		rainPart = Instance.new("Part")
		rainPart.Name = "RainEmitter"
		rainPart.Anchored, rainPart.CanCollide, rainPart.CanQuery, rainPart.CanTouch = true, false, false, false
		rainPart.Transparency = 1
		rainPart.Size = Vector3.new(120, 1, 120)
		rain = Instance.new("ParticleEmitter")
		rain.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		rain.Color = ColorSequence.new(C(190, 210, 230))
		rain.Size = NumberSequence.new(0.12)
		rain.Lifetime = NumberRange.new(0.9, 1.1)
		rain.Speed = NumberRange.new(80, 90)
		rain.EmissionDirection = Enum.NormalId.Bottom
		rain.Rate = 0
		rain.LightInfluence = 0.5
		rain.Transparency = NumberSequence.new(0.3)
		rain.Parent = rainPart
		rainPart.Parent = Workspace.CurrentCamera
	end
end

local lastBolt = 0
local function weather(zid, t, camPos)
	ensureWeather()
	local d0, h0, c0 = atmo:GetAttribute("BaseDensity"), atmo:GetAttribute("BaseHaze"), atmo:GetAttribute("BaseColor")
	local wantD, wantH, wantC = d0, h0, c0
	local rate = 0
	if zid == "desert" then
		local wave = math.max(0, math.sin(t * 2 * math.pi / 40)) -- a storm front every 40 s
		wantD, wantH, wantC = d0 + 0.45 * wave, h0 + 6 * wave, c0:Lerp(C(214, 170, 110), wave)
	elseif zid == "storm" then
		wantD, wantH, wantC = d0 + 0.4, h0 + 3, c0:Lerp(C(90, 100, 116), 0.8)
		rate = 900
		if t - lastBolt &gt; 6 + (t % 5) then
			lastBolt = t
			local cc = Lighting:FindFirstChild("BoltFlash") or Instance.new("ColorCorrectionEffect", Lighting)
			cc.Name = "BoltFlash"
			cc.Brightness = 0.6
			task.spawn(function()
				for _ = 1, 10 do
					task.wait(0.03)
					cc.Brightness = cc.Brightness * 0.7
				end
				cc.Brightness = 0
			end)
		end
	end
	atmo.Density = atmo.Density + (wantD - atmo.Density) * 0.05
	atmo.Haze = atmo.Haze + (wantH - atmo.Haze) * 0.05
	atmo.Color = atmo.Color:Lerp(wantC, 0.05)
	rain.Rate = rate
	rainPart.CFrame = CFrame.new(camPos + Vector3.new(0, 40, 0))
end

-- planes push players standing in their exhaust
local function jetBlast(t, hrp)
	local pos = hrp.Position
	local ri = TrafficMath.RoadAtZ(pos.Z, 24)
	local road = ri and MapConfig.Roads[ri]
	if not road or road.kinds[1] ~= "plane" then
		return
	end
	for _, lane in ipairs(TrafficMath.RoadLanes[ri]) do
		for k = 1, lane.count do
			local x = TrafficMath.CarX(lane, k, t)
			local behind = (x - pos.X) * lane.dir -- &gt;0 when the player is behind the plane
			if behind &gt; 18 and behind &lt; 60 and math.abs(pos.Z - lane.z) &lt; 14 then
				local push = Vector3.new(-lane.dir * 70, 18, 0) * (1 - (behind - 18) / 42)
				hrp.AssemblyLinearVelocity = hrp.AssemblyLinearVelocity:Lerp(push, 0.25)
			end
		end
	end
end

function ZoneFx.Start()
	RunService.Heartbeat:Connect(function()
		local cam = Workspace.CurrentCamera
		if not cam then
			return
		end
		local t = Workspace:GetServerTimeNow()
		local camPos = cam.CFrame.Position
		local zid = MapConfig.ZoneAt(camPos.Z)
		if zid == "docks" then
			crossings(t)
		end
		weather(zid, t, camPos)
		local char = Players.LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp and zid == "airport" then
			jetBlast(t, hrp)
		end
	end)
end

return ZoneFx
</ProtectedString></Properties></Item></Item></Item></Item></roblox>