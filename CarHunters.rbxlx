Tool.MaxParts = 450

local KEEP = { "BasePart", "Model", "Folder", "DataModelMesh", "Decal", "Texture", "SurfaceAppearance" }

local function keep(inst)
	for _, class in ipairs(KEEP) do
		if inst:IsA(class) then
			return true
		end
	end
	return false
end

-- assets embedded into the place by tools/bake_models.luau: ServerStorage.Embedded.Assets.A&lt;id&gt;
local function embedded(id)
	local e = game:GetService("ServerStorage"):FindFirstChild("Embedded")
	local a = e and e:FindFirstChild("Assets")
	return a and a:FindFirstChild("A" .. tostring(id))
end
Tool.Embedded = embedded

local function load(id)
	local emb = embedded(id)
	if emb then
		local out = {}
		for _, c in ipairs(emb:GetChildren()) do
			table.insert(out, c:Clone())
		end
		if #out &gt; 0 then
			return out
		end
	end
	local ok, res = pcall(function()
		return game:GetObjects("rbxassetid://" .. id)
	end)
	if ok and res and #res &gt; 0 then
		return res
	end
	local ok2, res2 = pcall(function()
		return InsertService:LoadAsset(id)
	end)
	if ok2 and res2 then
		return res2:GetChildren()
	end
	return nil, tostring(ok and res2 or res)
end

-- the car = top-level model that contains a VehicleSeat; otherwise everything that was loaded
local function pickCar(objs)
	local holder = Instance.new("Model")
	for _, o in ipairs(objs) do
		o.Parent = holder
	end
	local seat = holder:FindFirstChildWhichIsA("VehicleSeat", true)
	local car = holder
	if seat then
		local top = seat
		while top.Parent ~= holder do
			top = top.Parent
		end
		if top:IsA("Model") then
			car = top
		end
	end
	return car, seat, holder
end

local function hasVisibleDescendant(d)
	for _, x in ipairs(d:GetDescendants()) do
		if x:IsA("BasePart") and x.Transparency &lt; 0.99 then
			return true
		end
	end
	return false
end

-- keeps only what is drawn. An invisible part that carries visible parts (A-Chassis wheel hubs: Wheels/FL holds
-- the real tire + rim meshes) stays as an invisible holder - deleting it used to delete the real wheels.
-- Hidden parts are never made visible again (they are alternative rim sets, airbags, colliders).
local fidelityOk = nil
local function sanitize(car)
	local parts = 0
	for _, d in ipairs(car:GetDescendants()) do
		if not keep(d) then
			d:Destroy()
		end
	end
	for _, d in ipairs(car:GetDescendants()) do
		if d:IsA("BasePart") and d.Parent then
			local hidden = d.Transparency &gt;= 0.99 and not d:FindFirstChildWhichIsA("Decal")
			if hidden and not hasVisibleDescendant(d) then
				d:Destroy() -- hitboxes, colliders, seat blocks, hidden alternative wheel sets
			else
				if hidden then
					d.Transparency = 1
				else
					parts = parts + 1
				end
				d.Anchored = true
				d.CanCollide = false
				d.CanTouch = false
				d.CanQuery = false
				d.Massless = true
				if math.max(d.Size.X, d.Size.Y, d.Size.Z) &lt; 2 then
					d.CastShadow = false -- tiny detail parts: no shadow pass
				end
				if fidelityOk ~= false and d:IsA("MeshPart") then
					-- writable from the command bar / plugins only; a live server refuses it once and stops trying
					fidelityOk = pcall(function()
						d.CollisionFidelity = Enum.CollisionFidelity.Box
					end)
				end
				if d:IsA("Seat") or d:IsA("VehicleSeat") then
					d.Disabled = true
				end
			end
		end
	end
	return parts
end

-- stray parts (v25): a single visible part that alone stretches the car's box by &gt; 35 % on some axis (a ground
-- plate, a mis-scaled mesh, a forgotten prop far away) is dropped. Only used when the proportion check fails, so a
-- normal body shell that defines the car's length is never touched. Returns how many parts were dropped.
local function worldBox(p)
	local cf, h = p.CFrame, p.Size / 2
	local r, u, l = cf.RightVector, cf.UpVector, cf.LookVector
	local e = Vector3.new(
		math.abs(r.X) * h.X + math.abs(u.X) * h.Y + math.abs(l.X) * h.Z,
		math.abs(r.Y) * h.X + math.abs(u.Y) * h.Y + math.abs(l.Y) * h.Z,
		math.abs(r.Z) * h.X + math.abs(u.Z) * h.Y + math.abs(l.Z) * h.Z
	)
	return cf.Position - e, cf.Position + e
end

function Tool.DropStrays(car)
	local dropped = 0
	for _ = 1, 4 do
		local list = {}
		for _, d in ipairs(car:GetDescendants()) do
			if d:IsA("BasePart") and d.Transparency &lt; 0.99 then
				local mn, mx = worldBox(d)
				table.insert(list, { p = d, mn = { mn.X, mn.Y, mn.Z }, mx = { mx.X, mx.Y, mx.Z } })
			end
		end
		local n = #list
		if n &lt; 6 then
			break
		end
		-- prefix / suffix min-max per axis: the box of all parts but one in O(n)
		local pre, suf = { [0] = nil }, {}
		local function merge(a, b)
			if not a then
				return { mn = { b.mn[1], b.mn[2], b.mn[3] }, mx = { b.mx[1], b.mx[2], b.mx[3] } }
			end
			local m = { mn = {}, mx = {} }
			for k = 1, 3 do
				m.mn[k], m.mx[k] = math.min(a.mn[k], b.mn[k]), math.max(a.mx[k], b.mx[k])
			end
			return m
		end
		for i = 1, n do
			pre[i] = merge(pre[i - 1], list[i])
		end
		for i = n, 1, -1 do
			suf[i] = merge(suf[i + 1], list[i])
		end
		local full = pre[n]
		local worst, worstRatio = nil, 1.35
		for i = 1, n do
			local rest = pre[i - 1]
			if suf[i + 1] then
				rest = rest and merge(rest, suf[i + 1]) or suf[i + 1]
			end
			for k = 1, 3 do
				local ef, er = full.mx[k] - full.mn[k], rest.mx[k] - rest.mn[k]
				local ratio = ef / math.max(er, 0.5)
				if ef - er &gt; 1 and ratio &gt; worstRatio then
					worst, worstRatio = list[i].p, ratio
				end
			end
		end
		if not worst then
			break
		end
		if hasVisibleDescendant(worst) then
			worst.Transparency = 1 -- a holder: keep its visible children
		else
			worst:Destroy()
		end
		dropped = dropped + 1
	end
	return dropped
end

local function proportionsOk(size, parts)
	local len, wid = size.Z, size.X
	local r = len / math.max(wid, 0.1)
	return r &gt;= 1.4 and r &lt;= 4.5 and len / math.max(size.Y, 0.1) &gt;= 1.5 and parts &lt;= Tool.MaxParts
end
Tool.ProportionsOk = proportionsOk

-- the car's OWN wheels (same rules as tools/wheel_report.luau). Returns source, count:
--   "achassis": Wheels/&lt;FL,FR,RL,RR&gt; hubs with visible wheel meshes inside
--   "named":    visible parts called wheel/tire/tyre/rim (no steering wheels, airbags, spares), grouped by position
--   "baked":    no separate wheel parts - the wheels are part of the body mesh
local EXCLUDE = { "steer", "airbag", "spare", "detector", "hitbox", "collider" }
local function wheelName(n)
	n = string.lower(n)
	for _, x in ipairs(EXCLUDE) do
		if string.find(n, x, 1, true) then
			return false
		end
	end
	return string.find(n, "wheel", 1, true) or string.find(n, "tire", 1, true) or string.find(n, "tyre", 1, true)
		or string.find(n, "rim", 1, true) or string.find(n, "llanta", 1, true) or string.find(n, "_whl", 1, true)
end

function Tool.DetectWheels(car)
	local wheels = car:FindFirstChild("Wheels", true)
	if wheels and (wheels:IsA("Model") or wheels:IsA("Folder")) then
		local n = 0
		for _, c in ipairs(wheels:GetChildren()) do
			if (c:IsA("BasePart") and c.Transparency &lt; 0.99) or hasVisibleDescendant(c) then
				n = n + 1
			end
		end
		return "achassis", n
	end
	local clusters = {}
	for _, d in ipairs(car:GetDescendants()) do
		if d:IsA("BasePart") and d.Transparency &lt; 0.99 and (wheelName(d.Name) or (d.Parent and wheelName(d.Parent.Name))) then
			local found = false
			for _, c in ipairs(clusters) do
				if (c - d.Position).Magnitude &lt; 2.5 then
					found = true
					break
				end
			end
			if not found then
				table.insert(clusters, d.Position)
			end
		end
	end
	if #clusters &gt;= 3 then
		return "named", #clusters
	end
	-- unnamed wheel meshes: disc-shaped visible parts (two equal sides, one thin) in the lower half of the car
	local cf, size = car:GetBoundingBox()
	local bottom = cf.Position.Y - size.Y / 2
	local discs = 0
	for _, d in ipairs(car:GetDescendants()) do
		if d:IsA("BasePart") and d.Transparency &lt; 0.99 then
			local x, y, z = d.Size.X, d.Size.Y, d.Size.Z
			local a, b, c = math.max(x, y, z), math.min(x, y, z), x + y + z - math.max(x, y, z) - math.min(x, y, z)
			if a &gt;= 1.2 and a &lt;= 6 and c / a &gt; 0.9 and b / a &lt; 0.6 and d.Position.Y &lt; bottom + size.Y * 0.5 then
				discs = discs + 1
			end
		end
	end
	if discs &gt;= 4 then
		return "mesh", discs
	end
	return "baked", 0 -- one-piece body mesh (wheels modelled into it)
end

---------------------------------------------------------------- wheels (see Shared/WheelKit.lua)
local function ensureWheels(car, forward, known)
	return WheelKit.Ensure(car, forward, known)
end

local function flat(v)
	local f = Vector3.new(v.X, 0, v.Z)
	return f.Magnitude &gt; 0.01 and f.Unit or Vector3.new(0, 0, -1)
end

-- rotate so the nose points to -Z (VehicleFactory then maps the long axis to +X)
local function normalize(car, forward)
	car.PrimaryPart = nil
	local bb = car:GetBoundingBox()
	car.WorldPivot = CFrame.lookAt(bb.Position, bb.Position + forward)
	car:PivotTo(CFrame.new(0, 20, 0))
	local _, size = car:GetBoundingBox()
	return size
end

function Tool.Install(carId, assetId, yaw)
	local def = CarConfig.ById[carId]
	if not def then
		warn("[CarStore] unknown car id: " .. tostring(carId))
		return false
	end
	local objs, err = load(assetId)
	if not objs then
		warn(string.format("[CarStore] %s: asset %s did not load (%s)", carId, tostring(assetId), tostring(err)))
		return false
	end
	local car, seat, holder = pickCar(objs)
	local forward = seat and flat(seat.CFrame.LookVector) or Vector3.new(0, 0, -1)
	-- wheels kept in a sibling model (outside the seat's model) belong to the car too
	if holder ~= car then
		for _, o in ipairs(holder:GetChildren()) do
			if o ~= car and (o.Name == "Wheels" or wheelName(o.Name)) then
				o.Parent = car
			end
		end
	end
	local parts = sanitize(car)
	if parts == 0 then
		holder:Destroy()
		warn(string.format("[CarStore] %s: asset %s has no visible parts", carId, tostring(assetId)))
		return false
	end
	local size = normalize(car, forward)
	if not seat and size.X &gt; size.Z then -- no seat to tell the direction: at least align the long axis
		normalize(car, Vector3.new(1, 0, 0))
		_, size = car:GetBoundingBox()
	end
	-- only the model's own wheels: nothing is guessed or added (that made duplicates and wrong sizes)
	local wheelSource, wheelCount = Tool.DetectWheels(car)
	if wheelSource == "baked" then
		-- the model is drawn without separate wheel parts: fine for one-piece meshes, but say so in Output
		warn(string.format("[CarStore] %s: asset %s has no separate wheel parts (one-piece mesh) - check it with CarModelTool.Preview()", carId, tostring(assetId)))
	end
	if wheelSource == "achassis" and wheelCount &lt; 4 then
		holder:Destroy()
		warn(string.format("[CarStore] %s: asset %s rejected (only %d of 4 wheels)", carId, tostring(assetId), wheelCount))
		return false
	end
	if not proportionsOk(size, parts) then
		-- a stray prop / mis-scaled mesh can break an otherwise fine car: drop it and measure again
		local dropped = Tool.DropStrays(car)
		if dropped &gt; 0 then
			parts = parts - dropped
			_, size = car:GetBoundingBox()
			if not seat and size.X &gt; size.Z then
				normalize(car, Vector3.new(1, 0, 0))
				_, size = car:GetBoundingBox()
			end
			print(string.format("[CarStore] %s: asset %s - dropped %d stray part(s)", carId, tostring(assetId), dropped))
		end
	end
	if not proportionsOk(size, parts) then
		holder:Destroy()
		warn(string.format("[CarStore] %s: asset %s rejected (%.0fx%.0fx%.0f studs, %d parts)", carId, tostring(assetId), size.Z, size.X, size.Y, parts))
		return false
	end
	local root = ReplicatedStorage:FindFirstChild("CarModels")
	if not root then
		root = Instance.new("Folder")
		root.Name = "CarModels"
		root.Parent = ReplicatedStorage
	end
	local old = root:FindFirstChild(carId)
	if old then
		old:Destroy()
	end
	car.Name = carId
	car:SetAttribute("Yaw", yaw or 0)
	car:SetAttribute("Recolor", false)
	car:SetAttribute("CarName", def.name)
	car:SetAttribute("Rarity", def.rarity)
	car:SetAttribute("StoreAssetId", tostring(assetId))
	car:SetAttribute("NoWheelFix", true) -- VehicleFactory must not add wheels: the model has its own
	car:SetAttribute("WheelSource", wheelSource)
	car:SetAttribute("WheelCount", wheelCount)
	car.Parent = root
	if holder ~= car then
		holder:Destroy()
	end
	print(string.format("[CarStore] %-22s &lt;- asset %s  (%d parts, own wheels: %s %d)", carId, tostring(assetId), parts, wheelSource, wheelCount))
	return true
end

local running = false

-- runs in the background: the Command Bar returns at once, progress is printed to Output
function Tool.InstallAll()
	if running then
		print("[CarStore] already running, watch the Output window")
		return
	end
	running = true
	print("[CarStore] started in background - this takes a few minutes, progress is in Output. Do not stop the play/edit session.")
	task.spawn(function()
		local ok, err = pcall(Tool.InstallAllNow)
		running = false
		if not ok then
			warn("[CarStore] failed: " .. tostring(err))
		end
	end)
end

-- server start: every car that has no model yet is installed from the assets embedded in the place
-- (no downloads, works in an unpublished place and in the live game)
-- every car the game can show: the trap list and the game-pass exclusives (Golden Magnat GT)
local function allCars()
	local t = table.clone(CarConfig.List)
	for _, def in ipairs(CarConfig.Exclusive or {}) do
		table.insert(t, def)
	end
	return t
end
Tool.AllCars = allCars

function Tool.InstallMissingEmbedded()
	local done = 0
	for _, def in ipairs(allCars()) do
		local root = ReplicatedStorage:FindFirstChild("CarModels")
		local cur = root and root:FindFirstChild(def.id)
		if not (cur and cur:FindFirstChildWhichIsA("BasePart", true)) then
			for _, id in ipairs(Tool.Candidates[def.id] or {}) do
				if embedded(id) and Tool.Install(def.id, id) then
					done = done + 1
					break
				end
			end
			task.wait() -- big models: yield between cars so the server start never hits the script timeout
		end
	end
	return done
end

function Tool.InstallAllNow()
	local done, failed = 0, {}
	local cars = allCars()
	for _, def in ipairs(cars) do
		local ok = false
		for _, id in ipairs(Tool.Candidates[def.id] or {}) do
			ok = Tool.Install(def.id, id)
			if ok then
				break
			end
		end
		if ok then
			done = done + 1
		else
			table.insert(failed, def.id)
		end
		task.wait()
	end
	print(string.format("[CarStore] installed %d/%d store models", done, #cars))
	if #failed &gt; 0 then
		print("[CarStore] kept the previous model for: " .. table.concat(failed, ", "))
	end
	print("[CarStore] check them: require(game.ServerStorage.Tools.CarModelTool).Preview()  - nose must point along +X.")
	print("[CarStore] wrong way round? require(game.ServerStorage.Tools.CarStoreTool).Flip('car_id')")
end

-- repair wheels on models that are already installed (store or Blender)
function Tool.FixWheels()
	local root = ReplicatedStorage:FindFirstChild("CarModels")
	if not root then
		return
	end
	local fixed = 0
	for _, m in ipairs(root:GetChildren()) do
		if m:IsA("Model") and CarConfig.ById[m.Name] then
			local old = m:FindFirstChild("AddedWheels")
			if old then
				old:Destroy()
			end
			if m:GetAttribute("NoWheelFix") then
				continue -- store model with its own wheels: never add a second set
			end
			local _, size = m:GetBoundingBox()
			local yaw = math.rad(m:GetAttribute("Yaw") or 0)
			local fwd = size.Z &gt;= size.X and Vector3.new(0, 0, -1) or Vector3.new(1, 0, 0)
			fwd = (CFrame.Angles(0, yaw, 0) * CFrame.new(fwd)).Position
			local n = ensureWheels(m, flat(fwd), WheelKit.Load(m, 1))
			if n &gt; 0 then
				fixed = fixed + 1
				print(string.format("[CarStore] %s: rebuilt %d wheels", m.Name, n))
			end
		end
	end
	print(string.format("[CarStore] FixWheels done, %d models repaired", fixed))
end

-- how many wheels each installed car shows (real + rebuilt)
function Tool.WheelReport()
	local root = ReplicatedStorage:FindFirstChild("CarModels")
	for _, m in ipairs(root and root:GetChildren() or {}) do
		if m:IsA("Model") and CarConfig.ById[m.Name] then
			local src, n = Tool.DetectWheels(m)
			local added = m:FindFirstChild("AddedWheels") and #m.AddedWheels:GetChildren() or 0
			print(string.format("[CarStore] %-22s own wheels: %s %d, added wheel parts %d", m.Name, src, n, added))
		end
	end
end

function Tool.Flip(carId)
	local root = ReplicatedStorage:FindFirstChild("CarModels")
	local m = root and root:FindFirstChild(carId)
	if m then
		m:SetAttribute("Yaw", ((m:GetAttribute("Yaw") or 0) + 180) % 360)
		print("[CarStore] " .. carId .. " Yaw = " .. m:GetAttribute("Yaw"))
	end
end

return Tool
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3AF43D814718495F9180D718443D6CD6"><Properties><string name="Name">ModelPreview</string><ProtectedString name="Source">-- Studio edit-mode preview: load the uploaded Blender models and build the whole map, to look around without Play.
--   require(game.ServerStorage.Tools.ModelPreview).Run()
-- Do NOT save the place afterwards if you want the server to rebuild the map itself (it rebuilds anyway when the
-- saved map is older than MapConfig.Version). Clear(): removes the preview map.
local Workspace = game:GetService("Workspace")
local ServerScriptService = game:GetService("ServerScriptService")

local Preview = {}

function Preview.Run()
	task.spawn(function()
		local n = require(ServerScriptService.Services.ModelService).LoadAll()
		print("[Preview] models loaded:", n)
		require(script.Parent.BuildCityMap).Build()
	end)
end

function Preview.Clear()
	local m = Workspace:FindFirstChild("GeneratedMap")
	if m then
		m:Destroy()
	end
end

return Preview
</ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX54"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX53"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX45"><Properties><string name="Name">ClientController</string><ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Strings = require(Shared:WaitForChild("Strings"))
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local BaseLayout = require(Shared:WaitForChild("BaseLayout"))
local Util = require(Shared:WaitForChild("Util"))

local Client = script.Parent:WaitForChild("Client")
local Store = require(Client:WaitForChild("StateStore"))
local UI = require(Client:WaitForChild("UI"))
local TrafficRenderer = require(Client:WaitForChild("TrafficRenderer"))
local TrapFx = require(Client:WaitForChild("TrapFx"))
local WorldFx = require(Client:WaitForChild("WorldFx"))
local Guidance = require(Client:WaitForChild("Guidance"))
local CineFx = require(Client:WaitForChild("CineFx"))
local DeathFx = require(Client:WaitForChild("DeathFx"))
local SpeedLanes = require(Client:WaitForChild("SpeedLanes"))
local UIExtra = require(Client:WaitForChild("UIExtra"))
local Markers = require(Client:WaitForChild("Markers"))
local ClientFx = require(Client:WaitForChild("ClientFx"))
local GaragePrompts = require(Client:WaitForChild("GaragePrompts"))
local GearFx = require(Client:WaitForChild("GearFx"))
local ZoneFx = require(Client:WaitForChild("ZoneFx"))
local BossFx = require(Client:WaitForChild("BossFx"))
local BatchReveal = require(Client:WaitForChild("BatchReveal"))
local Settings = require(Client:WaitForChild("Settings"))
local Backpack = require(Client:WaitForChild("Backpack"))
local IntroFx = require(Client:WaitForChild("IntroFx"))
local Checkpoint = require(Client:WaitForChild("Checkpoint"))
local Tutorial = require(Client:WaitForChild("Tutorial"))
local JoinFlow = require(Client:WaitForChild("JoinFlow"))
local PhotoMode = require(Client:WaitForChild("PhotoMode"))
local Rewards = require(Client:WaitForChild("Rewards"))
local Trade = require(Client:WaitForChild("Trade"))
local CarPreload = require(Client:WaitForChild("CarPreload"))
local TrapVisuals = require(Client:WaitForChild("TrapVisuals"))

local player = Players.LocalPlayer
-- keep the camera close: no flying out over the map edge
player.CameraMaxZoomDistance = 45
player.CameraMinZoomDistance = 6
Strings.SetLocale(player.LocaleId)

local actions = {
	ThrowBatch = function(counts, merge, cars) Net.Get("ThrowBatch"):FireServer(counts, merge, cars) end,
	Place = function(uid, slot) Net.Get("PlaceCar"):FireServer(uid, slot) end,
	Remove = function(uid) Net.Get("RemoveCar"):FireServer(uid) end,
	Upgrade = function(uid, level) Net.Get("UpgradeCar"):FireServer(uid, level) end,
	BuySlot = function(count) Net.Get("BuySlot"):FireServer(count) end,
	BuyFloor = function(floors) Net.Get("BuyFloor"):FireServer(floors) end,
	Unlock = function(zoneId) Net.Get("UnlockZone"):FireServer(zoneId) end,
	Sell = function(uid) Net.Get("SellCar"):FireServer(uid) end,
	SellMany = function(uids) Net.Get("SellCars"):FireServer(uids) end,
	AutoPark = function() Net.Get("AutoPark"):FireServer() end,
	BuyPerk = function(id) Net.Get("BuyPerk"):FireServer(id) end,
	Donate = function(id) Net.Get("Donate"):FireServer(id) end,
	Claim = function(id) Net.Get("ClaimContract"):FireServer(id) end,
	BuyGear = function(id) Net.Get("BuyGear"):FireServer(id) end,
	ApplyGear = function(carUid, id) Net.Get("ApplyGear"):FireServer(carUid, id) end,
	Rebirth = function() Net.Get("Rebirth"):FireServer() end,
	SetSkin = function(id) Net.Get("SetSkin"):FireServer(id) end,
	TokenPerk = function(id) Net.Get("TokenPerk"):FireServer(id) end,
	UpgradeTrap = function() Net.Get("UpgradeTrap"):FireServer() end,
	Teleport = function(dest)
		Net.Get("Teleport"):FireServer(dest)
		if dest == "home" and Store.CarriedTotal() &gt; 0 then
			return -- the server refuses (loot goes home on foot) and says why: no whoosh
		end
		UI.Sfx("whoosh")
		CineFx.Flash(Color3.fromRGB(46, 168, 255), 0.2, 0.5)
		CineFx.Zoom(95, 0.12)
		task.delay(0.15, function() CineFx.Zoom(70, 0.4) end)
	end,
}

UI.Init(Store, actions)
CineFx.Init(UI.Gui())
TrapFx.SetSfx(UI.Sfx)
TrapFx.SetReveal(UI.ShowReveal, UI.HideReveal)
TrapFx.SetCinematic(UI.SetCinematic)
require(Client:WaitForChild("Perf")).Start() -- adaptive quality (HIGH/MED/LOW) + exhaust LOD
WorldFx.Start(Store)
TrafficRenderer.Start()
Guidance.Start()
SpeedLanes.Start(function()
	return Store.State and Store.State.walkSpeed or MapConfig.WalkSpeed
end)
UIExtra.Init(UI)
ZoneFx.Start()
BossFx.Start(UI, CineFx)
BatchReveal.Start(UI, CineFx, TrapFx)
Checkpoint.Start(UI, CineFx)
Tutorial.Start(UI, CineFx, Guidance)
Rewards.Start(UI)
Settings.Start(UI)
Trade.Start(UI)
Backpack.Start(UI)
IntroFx.Start(UI, CineFx)
JoinFlow.Start(UI, CineFx, IntroFx, Tutorial)
PhotoMode.Start(UI, CineFx)
ClientFx.Init(UI)
Markers.Start(UI.Kit(), UIExtra)
GaragePrompts.Start(UI.Kit(), CineFx)
GearFx.Start() -- auras + countdown tags on cars with a running gear
TrapVisuals.Start(UI, Store, CineFx)
UI.Refresh()
CarPreload.Start() -- background: car meshes + templates (owned and likely cars first), so reveals never pop in

Net.Get("HotDrop").OnClientEvent:Connect(function(info) UIExtra.OnHotDrop(info) end)
Net.Get("PickupFx").OnClientEvent:Connect(function(info) ClientFx.Pickup(info) end)
Net.Get("BankFx").OnClientEvent:Connect(function(info) ClientFx.Bank(info) end)
Net.Get("DonateFx").OnClientEvent:Connect(function(buyer, key) ClientFx.Donate(buyer, key) end)

Net.Get("StateUpdate").OnClientEvent:Connect(function(state) Store.Set(state) end)
Net.Get("MoneySync").OnClientEvent:Connect(function(m, inc, val) Store.SetMoney(m, inc, val) end)
Net.Get("Notify").OnClientEvent:Connect(function(payload)
	if payload and (payload.key == "lost" or payload.key == "picked" or payload.key == "banked2" or payload.key == "banked") then
		return -- shown by the WRECKED screen
	end
	UI.Notify(payload)
end)
local deathHeld = false
Net.Get("HitFx").OnClientEvent:Connect(function(dir, kind)
	if kind == "airbag" then
		ClientFx.Airbag(dir or Vector3.new(1, 0, 0))
		return
	end
	local lost = Store.State and Util.CopyTable(Store.State.carried) or {}
	TrapFx.Abort()
	BatchReveal.Close()
	UI.CloseOverlays() -- first: a live trade marks itself to reopen, so closing its panel does not cancel it
	UI.TogglePanel(nil)
	UI.HideReveal()
	if not deathHeld then -- the WRECKED screen hides the HUD like any cinematic; released on respawn
		deathHeld = true
		UI.SetCinematic(true)
	end
	DeathFx.Play(dir or Vector3.new(1, 0, 0), lost, UI.Sfx)
end)
Net.Get("ThrowResult").OnClientEvent:Connect(function(res)
	local idx = Store.State and Store.State.baseIndex
	if res and res.typeId then
		CarPreload.Ensure({ res.typeId }) -- top priority: ready long before the blackout reveal
	end
	TrapFx.Play(res, idx)
end)
-- batch throws: BatchReveal plays them (its own listener); the cars start loading right away for its grid
Net.Get("ThrowBatchResult").OnClientEvent:Connect(function(res)
	if res and type(res.cars) == "table" then
		local ids = {}
		for _, r in ipairs(res.cars) do
			table.insert(ids, r.typeId)
		end
		CarPreload.Ensure(ids)
	end
end)
player.CharacterAdded:Connect(function()
	DeathFx.Recover()
	if deathHeld then
		deathHeld = false
		UI.SetCinematic(false)
	end
end)

task.spawn(function()
	while true do
		task.wait(0.2)
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local st = Store.State
		if hrp then
			UI.SetZoneName(MapConfig.ZoneAt(hrp.Position.Z))
			local near = false
			if st and st.baseIndex then
				local trap = BaseLayout.ToWorld(st.baseIndex, BaseLayout.TrapLocal)
				near = Vector3.new(hrp.Position.X - trap.X, 0, hrp.Position.Z - trap.Z).Magnitude &lt;= 35
			end
			UI.SetNearTrap(near and not CineFx.IsScripted())
		end
	end
end)
</ProtectedString></Properties></Item><Item class="Folder" referent="RBX52"><Properties><string name="Name">Client</string></Properties><Item class="ModuleScript" referent="RBX46"><Properties><string name="Name">Guidance</string><ProtectedString name="Source">-- Guide beam from the player to the current objective (set by Tutorial), plus a bobbing marker over the target.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Guidance = {}
local beam, att0, att1, marker
local target -- BasePart or Vector3

local function ensure(hrp)
	if not beam or not beam.Parent or att0.Parent ~= hrp then
		if beam then
			beam:Destroy()
		end
		att0 = Instance.new("Attachment")
		att0.Name = "GuideA"
		att0.Position = Vector3.new(0, -2, 0)
		att0.Parent = hrp
		beam = Instance.new("Beam")
		beam.Name = "GuideBeam"
		beam.Width0, beam.Width1 = 0.9, 0.9
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.Color = ColorSequence.new(Color3.fromRGB(255, 220, 60))
		beam.Transparency = NumberSequence.new(0.2)
		beam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		beam.TextureMode = Enum.TextureMode.Static
		beam.TextureLength = 4
		beam.TextureSpeed = 2
		beam.Segments = 1
		beam.Attachment0 = att0
		beam.Parent = hrp
	end
	if not marker then
		marker = Instance.new("Part")
		marker.Name = "GuideMarker"
		marker.Anchored, marker.CanCollide, marker.CanQuery, marker.CanTouch = true, false, false, false
		marker.Transparency = 1
		marker.Size = Vector3.one
		att1 = Instance.new("Attachment")
		att1.Parent = marker
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.fromOffset(60, 60)
		bb.AlwaysOnTop = true
		bb.LightInfluence = 0
		bb.Parent = marker
		local arrow = Instance.new("TextLabel")
		arrow.Size = UDim2.fromScale(1, 1)
		arrow.BackgroundTransparency = 1
		arrow.Text = "V"
		arrow.Font = Enum.Font.LuckiestGuy
		arrow.TextScaled = true
		arrow.TextColor3 = Color3.fromRGB(255, 210, 63)
		local st = Instance.new("UIStroke")
		st.Thickness = 3
		st.Parent = arrow
		arrow.Parent = bb
		marker.Parent = workspace
	end
	if beam.Attachment1 ~= att1 then
		beam.Attachment1 = att1
	end
end

-- target: BasePart, Vector3 or nil (off)
function Guidance.Point(t)
	target = t
end

function Guidance.Start()
	RunService.Heartbeat:Connect(function()
		local char = Players.LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local pos = target and (typeof(target) == "Vector3" and target or (target.Parent and target.Position))
		if Players.LocalPlayer:GetAttribute("Opt_guide") == false or Players.LocalPlayer:GetAttribute("Cinematic") then
			pos = nil -- Settings: guidance beam off
		end
		if not hrp or not pos then
			if beam and beam.Enabled then
				beam.Enabled = false
			end
			if marker and marker.Parent then
				marker.Parent = nil
			end
			return
		end
		ensure(hrp)
		if marker.Parent ~= workspace then
			marker.Parent = workspace
		end
		marker.Position = pos + Vector3.new(0, 7 + math.sin(os.clock() * 4) * 0.8, 0)
		local on = (hrp.Position - pos).Magnitude &gt; 12
		if beam.Enabled ~= on then
			beam.Enabled = on
		end
	end)
end

return Guidance
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX47"><Properties><string name="Name">StateStore</string><ProtectedString name="Source">local Store = {}

Store.State = nil
Store.Money = 0
Store.Income = 0
Store.CollectionValue = 0
Store.Changed = Instance.new("BindableEvent")
Store.MoneyChanged = Instance.new("BindableEvent")

local setState, setClock = nil, os.clock()

function Store.Set(state)
	Store.State = state
	setState, setClock = state, os.clock()
	Store.Money = state.money
	Store.Income = state.income or 0
	Store.CollectionValue = state.collectionValue or 0
	Store.Changed:Fire()
end

function Store.SetMoney(money, income, value)
	Store.Money = money
	Store.Income = income
	Store.CollectionValue = value or Store.CollectionValue
	if Store.State then
		Store.State.money = money
		Store.State.income = income
	end
	Store.MoneyChanged:Fire()
end

-- the server's os.time() right now (state.serverTime + time since the push); used for gear timers / CarIncome
function Store.ServerNow()
	local st = Store.State
	if st and tonumber(st.serverTime) then
		if st ~= setState then
			setState, setClock = st, os.clock()
		end
		return st.serverTime + (os.clock() - setClock)
	end
	return workspace:GetServerTimeNow()
end

function Store.Banked(partId)
	return Store.State and Store.State.parts[partId] or 0
end

function Store.Carried(partId)
	return Store.State and Store.State.carried[partId] or 0
end

function Store.CarriedTotal()
	local n = 0
	if Store.State then
		for _, v in pairs(Store.State.carried) do
			n = n + v
		end
	end
	return n
end

function Store.BankedTotal()
	local n = 0
	if Store.State then
		for _, v in pairs(Store.State.parts) do
			n = n + v
		end
	end
	return n
end

return Store
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX48"><Properties><string name="Name">TrafficRenderer</string><ProtectedString name="Source">local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local TrafficMath = require(Shared:WaitForChild("TrafficMath"))
local VehicleFactory = require(Shared:WaitForChild("VehicleFactory"))
local VehicleKinds = require(Shared:WaitForChild("VehicleKinds"))
local Net = require(Shared:WaitForChild("Net"))
local Players = game:GetService("Players")

local Perf = require(script.Parent:WaitForChild("Perf"))

local Renderer = {}
-- pools[lane.index] = { models = {k -&gt; Model}, built = n, shown = bool, road = ri }
local pools = {}
local ACTIVE = { HIGH = 380, MED = 260, LOW = 190 }
local INLINE_BUILDS = 2 -- most models ever built inside RenderStepped (only for a road that is already in view)
local BG_BUDGET = 0.002 -- s of building per frame in the background
local lastReport = 0
local parked = CFrame.new(0, -300, 0) -- hidden pool cars: well above FallenPartsDestroyHeight (-500)

local function activeDist()
	return ACTIVE[Perf.Level()] or ACTIVE.HIGH
end

local function getPool(lane)
	local pool = pools[lane.index]
	if not pool then
		pool = { models = {}, built = 0, shown = false, road = lane.road }
		pools[lane.index] = pool
	end
	return pool
end

-- builds the next missing model of a lane's pool; false when the pool is complete
local function buildNext(lane, folder)
	local pool = getPool(lane)
	if pool.built &gt;= lane.count then
		return false
	end
	local k = pool.built + 1
	pool.built = k -- claimed before building, so the same car is never built twice
	local ok, m = pcall(VehicleFactory.BuildTraffic, lane.kinds[k], MapConfig.TrafficColors[lane.colors[k]], lane.colors[k])
	if ok and m and m.PrimaryPart then
		if pools[lane.index] ~= pool then
			m:Destroy() -- the pool was dropped meanwhile
			return true
		end
		pool.models[k] = m
		if pool.shown then
			m:PivotTo(parked)
			m.Parent = folder
		end
	elseif not ok then
		warn("[Traffic] could not build", lane.kinds[k], m)
	end
	return true
end

local function destroyPool(index)
	local pool = pools[index]
	pools[index] = nil
	if pool then
		for _, m in pairs(pool.models) do
			m:Destroy()
		end
	end
end

-- background: prebuild the pools of the nearest roads a few models per frame, drop the far ones
local function prebuilder(folder)
	local order = {}
	local lastSweep = 0
	while true do
		RunService.Heartbeat:Wait()
		local cam = Workspace.CurrentCamera
		if cam then
			local camZ = cam.CFrame.Position.Z
			local dist = activeDist()
			local now = os.clock()
			if now - lastSweep &gt; 1 then
				lastSweep = now
				for index, pool in pairs(pools) do
					local road = MapConfig.Roads[pool.road]
					if not road or math.abs(camZ - road.z) &gt; dist * 2 then
						destroyPool(index)
					end
				end
			end
			-- nearest roads first, up to 1.5x the active distance (so a road is ready before it comes into view)
			table.clear(order)
			for ri, road in ipairs(MapConfig.Roads) do
				local d = math.abs(camZ - road.z)
				if d &lt; dist * 1.5 then
					table.insert(order, { ri = ri, d = d })
				end
			end
			table.sort(order, function(a, b) return a.d &lt; b.d end)
			local t0 = os.clock()
			local built = 0
			for _, o in ipairs(order) do
				for _, lane in ipairs(TrafficMath.RoadLanes[o.ri]) do
					while (built == 0 or os.clock() - t0 &lt; BG_BUDGET) and buildNext(lane, folder) do
						built = built + 1
					end
					if built &gt; 0 and os.clock() - t0 &gt;= BG_BUDGET then
						break
					end
				end
				if built &gt; 0 and os.clock() - t0 &gt;= BG_BUDGET then
					break
				end
			end
		end
	end
end

function Renderer.Start()
	local folder = Workspace:WaitForChild("RuntimeTraffic")
	local flip = CFrame.Angles(0, math.pi, 0)
	task.spawn(prebuilder, folder)
	local parts, cfs = {}, {}
	RunService.RenderStepped:Connect(function()
		local cam = Workspace.CurrentCamera
		if not cam then
			return
		end
		local camZ = cam.CFrame.Position.Z
		local t = Workspace:GetServerTimeNow()
		local dist = activeDist()
		local inlineLeft = INLINE_BUILDS
		table.clear(parts)
		table.clear(cfs)
		for ri, road in ipairs(MapConfig.Roads) do
			local active = math.abs(camZ - road.z) &lt; dist
			for _, lane in ipairs(TrafficMath.RoadLanes[ri]) do
				local pool = pools[lane.index]
				if active then
					pool = pool or getPool(lane)
					while inlineLeft &gt; 0 and pool.built &lt; lane.count do
						inlineLeft = inlineLeft - 1
						buildNext(lane, folder)
					end
					if not pool.shown then
						pool.shown = true
						for _, m in pairs(pool.models) do
							m:PivotTo(parked)
							m.Parent = folder
						end
					end
					for k = 1, lane.count do
						local m = pool.models[k]
						local root = m and m.PrimaryPart
						if root then
							local x = TrafficMath.CarX(lane, k, t)
							local cf = CFrame.new(x, MapConfig.RoadTopY, TrafficMath.CarZ(lane, k, t))
							if lane.dir &lt; 0 then
								cf = cf * flip
							end
							if lane.weaveA then
								local dz = lane.weaveA * lane.weaveW * math.cos(lane.weaveW * t + lane.weavePh[k])
								cf = cf * CFrame.Angles(0, -math.atan2(dz, lane.speed) * lane.dir, 0)
							end
							table.insert(parts, root)
							table.insert(cfs, cf)
						end
					end
				elseif pool and pool.shown then
					pool.shown = false
					for _, m in pairs(pool.models) do
						m.Parent = nil
					end
				end
			end
		end
		if #parts &gt; 0 then
			-- one engine call for every car (welds carry the bodies along with each anchored root)
			Workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
		end
		-- local hit check against exactly what this player sees
		local char = Players.LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hrp and hum and hum.Health &gt; 0 and os.clock() - lastReport &gt; 0.5 then
			local pos = hrp.Position
			local ri = TrafficMath.RoadAtZ(pos.Z, 3)
			if ri then
				for _, lane in ipairs(TrafficMath.RoadLanes[ri]) do
					for k = 1, lane.count do
						local kind = VehicleKinds[lane.kinds[k]]
						local dz = math.abs(pos.Z - TrafficMath.CarZ(lane, k, t))
						if dz &lt;= kind.W / 2 + 1 and math.abs(pos.X - TrafficMath.CarX(lane, k, t)) &lt;= kind.L / 2 + 1 and pos.Y &lt; MapConfig.RoadTopY + kind.H + 2.5 then
							lastReport = os.clock()
							Net.Get("TrafficHit"):FireServer()
							return
						end
					end
				end
			end
		end
	end)
end

return Renderer
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX49"><Properties><string name="Name">TrapFx</string><ProtectedString name="Source">-- Throw + car reveal cinematic on the garage car lift. Visual only: the server already decided the result.
-- No transparent neon geometry: light comes from PointLights/SpotLights, sparks/dust from particle emitters,
-- the rarity colour from a Highlight outline, punch from ColorCorrection/Bloom/DepthOfField.
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local BaseLayout = require(Shared:WaitForChild("BaseLayout"))
local VehicleFactory = require(Shared:WaitForChild("VehicleFactory"))
local PartVisual = require(Shared:WaitForChild("PartVisual"))
local Cine = require(script.Parent:WaitForChild("CineFx"))
local CarPreload = require(script.Parent:WaitForChild("CarPreload"))

local TrapFx = {}
local sfx
local SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local function play(name)
	if sfx then
		sfx(name)
	end
end

-- showcase hooks set by the controller: Reveal(res, onClosed), HideReveal()
function TrapFx.SetReveal(show, hide)
	TrapFx.Reveal, TrapFx.HideReveal = show, hide
end

function TrapFx.SetSfx(fn)
	sfx = fn
end

-- cinematic mode hook (UI.SetCinematic): hides the HUD, closes panels, blocks prompts + movement
local cinema = function() end
function TrapFx.SetCinematic(fn)
	cinema = fn
end

local function tw(o, t, props, style, dir)
	local x = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	x:Play()
	return x
end

local function anchor(cf)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Transparency = 1
	p.Size = Vector3.one
	p.CFrame = typeof(cf) == "CFrame" and cf or CFrame.new(cf)
	p.Parent = Workspace
	return p
end

local function emitter(parent, o)
	local e = Instance.new("ParticleEmitter")
	e.Texture = o.texture or SPARK
	e.Color = ColorSequence.new(o.c1, o.c2 or o.c1)
	e.LightEmission = o.light or 0.5
	e.Size = NumberSequence.new(o.s1 or 0.6, o.s2 or 0)
	e.Transparency = NumberSequence.new(o.t1 or 0, 1)
	e.Lifetime = NumberRange.new(o.life or 0.6, (o.life or 0.6) * 1.5)
	e.Speed = NumberRange.new(o.speed or 10, (o.speed or 10) * 1.6)
	e.SpreadAngle = o.spread or Vector2.new(180, 180)
	e.Acceleration = o.acc or Vector3.zero
	e.Drag = o.drag or 3
	e.Rate = o.rate or 0
	e.ZOffset = 1
	e.Parent = parent
	return e
end

local function burst(pos, o, count)
	local a = anchor(pos)
	local e = emitter(a, o)
	e:Emit(count)
	task.delay(3, function()
		a:Destroy()
	end)
end

-- dust ring flat on the floor
local function dustRing(pos, color, count)
	local a = anchor(CFrame.new(pos))
	local e = emitter(a, { texture = SMOKE, c1 = color, s1 = 1.8, s2 = 4.5, t1 = 0.35, life = 0.9, speed = 18, spread = Vector2.new(0, 180), drag = 6, light = 0 })
	e.EmissionDirection = Enum.NormalId.Front
	e.Orientation = Enum.ParticleOrientation.FacingCamera
	a.CFrame = CFrame.new(pos) * CFrame.Angles(math.pi / 2, 0, 0)
	e:Emit(count)
	task.delay(2.5, function()
		a:Destroy()
	end)
end

local function findBase(idx)
	local map = Workspace:FindFirstChild("GeneratedMap")
	local bases = map and map:FindFirstChild("Bases")
	return bases and bases:FindFirstChild(string.format("Base%02d", idx), true)
end

local function faceCF(pos, dir)
	return CFrame.new(pos) * CFrame.Angles(0, math.atan2(-dir.Z, dir.X), 0)
end

-- smooth camera: every frame the camera eases toward camTarget
local camTarget, camConn, camCur
local function camStart(cam)
	camTarget = cam.CFrame
	camCur = cam.CFrame
	camConn = RunService.RenderStepped:Connect(function(dt)
		camCur = camCur:Lerp(camTarget, 1 - math.exp(-dt * 5))
		cam.CFrame = camCur
	end)
end
-- jump cut (used while the screen is black)
local function camSnap(cf)
	camTarget, camCur = cf, cf
end
local function camStop()
	if camConn then
		camConn:Disconnect()
		camConn = nil
	end
end

local function effect(class, props)
	local e = Instance.new(class)
	for k, v in pairs(props) do
		e[k] = v
	end
	e.Parent = Lighting
	return e
end

-- one cinematic at a time: later ones wait in a queue (e.g. "SEE BEST CAR" pressed during another reveal)
local busy, queue = false, {}
local current -- ctx of the running cinematic

local function check(ctx)
	if ctx.aborted then
		error("aborted", 0)
	end
end

local function body(res, baseIndex, ctx)
		local def = CarConfig.ById[res.typeId]
		if not def or not baseIndex then
			if def and TrapFx.Reveal then
				CarPreload.Ready(def, 2) -- the showcase car must not pop in late
				check(ctx)
				local shown = false
				TrapFx.Reveal(res, function()
					shown = true
				end)
				local w0 = os.clock()
				while not shown and os.clock() - w0 &lt; 15 do
					task.wait(0.05)
				end
				if not shown and TrapFx.HideReveal then
					TrapFx.HideReveal()
				end
			end
			return
		end
		local k = 1 / math.max(1, res.speed or 1) -- fast trap pass halves every beat
		local function wait(t)
			task.wait(t * k)
			check(ctx)
		end
		local tStart = os.clock()
		local lvl = CarConfig.Rarities[res.rarity].index
		local rc = CarConfig.Rarities[res.rarity].color
		local bcf = BaseLayout.GetBaseCFrame(baseIndex)
		local padPos = bcf:PointToWorldSpace(BaseLayout.TrapLocal) + Vector3.new(0, 1.6, 0)
		local base = findBase(baseIndex)
		local magnet = base and base:FindFirstChild("TrapMagnet")
		local magnetCF = magnet and magnet.CFrame
		local char = Players.LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local startPos = hrp and (hrp.Position + Vector3.new(0, 2.5, 0)) or (padPos + Vector3.new(14, 8, 0))
		local cam = Cine.Take()
		ctx.camTaken = true
		local cam0 = cam.CFrame
		ctx.cam0 = cam0
		camStart(cam)
		local side = bcf:VectorToWorldSpace(Vector3.new(0, 0, 1))
		local front = bcf:VectorToWorldSpace(Vector3.new(1, 0, 0)) -- out of the garage, towards the plaza
		local dof = effect("DepthOfFieldEffect", { Name = "TrapDof", FarIntensity = 0, NearIntensity = 0, FocusDistance = 30, InFocusRadius = 20 })
		local cc = effect("ColorCorrectionEffect", { Name = "TrapCC" })
		ctx.dof, ctx.cc = dof, cc

		-- 1) over the shoulder, letterbox
		Cine.Letterbox(true, 0.35)
		camTarget = CFrame.lookAt((startPos + padPos) / 2 + side * 22 + Vector3.new(0, 10, 0), padPos + Vector3.new(0, 2, 0))
		wait(0.3)

		-- 2) the part flies onto the lift
		play("throw")
		local item = PartVisual.Build(res.partId)
		ctx.item = item
		item:PivotTo(CFrame.new(startPos))
		item.Parent = Workspace
		local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
		a0.Position, a1.Position = Vector3.new(0, 0.7, 0), Vector3.new(0, -0.7, 0)
		a0.Parent, a1.Parent = item.PrimaryPart, item.PrimaryPart
		local trail = Instance.new("Trail")
		trail.Attachment0, trail.Attachment1 = a0, a1
		trail.Color = ColorSequence.new(Color3.new(1, 1, 1), rc)
		trail.Transparency = NumberSequence.new(0.1, 1)
		trail.Lifetime = 0.3
		trail.LightEmission = 0.4
		trail.Parent = item.PrimaryPart
		local target = padPos + Vector3.new(0, 1.2, 0)
		local flight = 0.6 * k
		local t0 = os.clock()
		while true do
			local a = math.min(1, (os.clock() - t0) / flight)
			item.PrimaryPart.CFrame = CFrame.new(startPos:Lerp(target, a) + Vector3.new(0, math.sin(a * math.pi) * 10, 0)) * CFrame.Angles(a * 10, a * 7, 0)
			if a &gt;= 1 then
				break
			end
			RunService.RenderStepped:Wait()
			check(ctx)
		end
		Cine.Shake(0.8, 0.25)
		burst(target, { c1 = Color3.fromRGB(255, 220, 140), c2 = Color3.fromRGB(255, 140, 40), s1 = 0.5, life = 0.5, speed = 16, acc = Vector3.new(0, -40, 0) }, 30)
		dustRing(padPos, Color3.fromRGB(200, 196, 190), 18)
		play("clank")

		-- 3) the magnet comes down and charges
		camTarget = CFrame.lookAt(padPos + side * 16 + front * 10 + Vector3.new(0, 9, 0), padPos + Vector3.new(0, 3, 0))
		local light = Instance.new("PointLight")
		light.Color = rc
		light.Range = 4
		light.Brightness = 0
		ctx.light, ctx.magnet, ctx.magnetCF = light, magnet, magnetCF
		if magnet then
			light.Parent = magnet
			tw(magnet, 0.5 * k, { CFrame = magnetCF - Vector3.new(0, 5, 0) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		end
		wait(0.45)
		item:Destroy()
		play("charge")
		local spk = anchor(CFrame.new(padPos + Vector3.new(0, 0.4, 0)))
		ctx.spk = spk
		local sparks = emitter(spk, { c1 = Color3.fromRGB(255, 240, 200), c2 = rc, s1 = 0.4, life = 0.5, speed = 14, spread = Vector2.new(35, 35), acc = Vector3.new(0, -30, 0), rate = 25 + lvl * 15 })
		sparks.EmissionDirection = Enum.NormalId.Top
		local smoke = emitter(spk, { texture = SMOKE, c1 = Color3.fromRGB(150, 150, 150), s1 = 2, s2 = 6, t1 = 0.6, life = 1.4, speed = 3, acc = Vector3.new(0, 4, 0), rate = 6, light = 0 })
		tw(light, (0.9 + lvl * 0.2) * k, { Range = 18 + lvl * 4, Brightness = 2 + lvl })
		tw(dof, (0.9 + lvl * 0.2) * k, { FarIntensity = 0.6, FocusDistance = 18, InFocusRadius = 8 })
		local chargeT = (0.9 + lvl * 0.2) * k
		local c0 = os.clock()
		while os.clock() - c0 &lt; chargeT do
			local f = (os.clock() - c0) / chargeT
			Cine.Shake(0.1 + f * 0.25 * lvl, 0.12)
			camTarget = CFrame.lookAt(padPos + side * (16 - f * 5) + front * (10 - f * 3) + Vector3.new(0, 9 - f * 2, 0), padPos + Vector3.new(0, 3, 0))
			task.wait(0.08)
			check(ctx)
		end

		-- 4) climax
		sparks.Enabled = false
		smoke.Enabled = false
		play(lvl &gt;= 4 and "revealBig" or "reveal")
		-- v22 punch: a rarity flash, a quick FOV kick (back to 70 under the blackout) and a glitch pulse for Rare+
		Cine.Flash(rc:Lerp(Color3.new(1, 1, 1), 0.5), 0.25 - lvl * 0.03, 0.45)
		Cine.Zoom(62 - lvl * 2, 0.15, Enum.EasingStyle.Back)
		if lvl &gt;= 3 then
			Cine.Glitch(0.14 + lvl * 0.04, 0.5 + lvl * 0.2)
		end
		cc.Brightness = 0.35
		cc.Contrast = 0.25
		cc.TintColor = rc:Lerp(Color3.new(1, 1, 1), 0.6)
		tw(cc, 0.7, { Brightness = 0, Contrast = 0, TintColor = Color3.new(1, 1, 1) })
		Cine.Shake(1 + lvl * 0.45, 0.6)
		burst(padPos + Vector3.new(0, 3, 0), { c1 = rc, c2 = Color3.new(1, 1, 1), s1 = 0.8, life = 0.9, speed = 22 + lvl * 4, drag = 2 }, 30 + lvl * 20)
		if lvl &gt;= 4 then
			-- hype without naming the rarity: the showcase's tier climb reveals it
			Cine.Title(lvl &gt;= 5 and "INSANE!!" or "WHOA!", rc, 1.1, 150, 0.28)
		end

		-- 5) blackout: the screen goes fully dark, then the showcase (UI.ShowReveal) on a solid dark backdrop
		Cine.Shake(1.2 + lvl * 0.3, 0.5)
		-- the car must be downloaded + prepared before the showcase (normally done long ago: CarPreload.Ensure ran
		-- when the result arrived); the wait overlaps the climax beat and is capped at 2 s
		local beat0 = os.clock()
		CarPreload.Ready(def, 2)
		local beat = (lvl &gt;= 4 and 0.55 or 0.3) - (os.clock() - beat0)
		if beat &gt; 0 then
			task.wait(beat)
		end
		check(ctx)
		Cine.Darken(1, 0.22)
		task.wait(0.25)
		check(ctx)
		Cine.Zoom(70, 0.05) -- undo the FOV kick while the screen is black
		if magnet then
			magnet.CFrame = magnetCF
			light.Brightness = 0
		end
		dof.FarIntensity = 0
		local shown = false
		if TrapFx.Reveal then
			TrapFx.Reveal(res, function()
				shown = true
			end)
			local w0 = os.clock()
			while not shown and os.clock() - w0 &lt; 15 do
				task.wait(0.05)
			end
			if not shown and TrapFx.HideReveal then
				TrapFx.HideReveal()
			end
		end
		check(ctx)

		-- 6) drive-in: the car comes through the garage gate and parks; the camera rides in front of it
		local ghost = VehicleFactory.BuildCar(def)
		ctx.ghost = ghost
		local y = BaseLayout.FloorY + 0.6
		local real = {}
		ctx.real = real
		local function hideReal()
			local cars = base and base:FindFirstChild("Cars")
			local m = cars and res.slot and cars:FindFirstChild("Car_" .. res.slot)
			if m and not real[m] then
				real[m] = true
				for _, d in ipairs(m:GetDescendants()) do
					if d:IsA("BasePart") then
						d.LocalTransparencyModifier = 1
					elseif d:IsA("BillboardGui") then
						d.Enabled = false
					end
				end
			end
		end
		if res.slot then
			local pl = BaseLayout.PortalLocal
			local sl = BaseLayout.SlotLocal(res.slot)
			local L = function(x, yy, z)
				return bcf:PointToWorldSpace(Vector3.new(x, yy, z))
			end
			local pts = { L(pl.X + 30, y, pl.Z), L(pl.X - 6, y, pl.Z), L(BaseLayout.LaneX, y, pl.Z) }
			local el = BaseLayout.ElevatorLocal
			local hiddenSeg -- the car is hidden on this segment (it "rides the lift" instead of driving through the cab)
			if sl.Y &gt; 0 then
				local yUp = y + sl.Y
				for _, p in ipairs({ { BaseLayout.LaneX, y, el.Z }, { el.X + 7, y, el.Z }, { -15, yUp, el.Z }, { -15, yUp, sl.Z }, { sl.X, yUp, sl.Z } }) do
					table.insert(pts, L(p[1], p[2], p[3]))
				end
				hiddenSeg = #pts - 2 -- from in front of the lift to the upper deck
			elseif math.abs(sl.Z - el.Z) &lt; 8 then
				-- the bay behind the lift cab: go round it through the next door opening
				for _, p in ipairs({ { BaseLayout.LaneX, y, el.Z - 15.5 }, { -15, y, el.Z - 15.5 }, { -15, y, sl.Z }, { sl.X + 4, y, sl.Z } }) do
					table.insert(pts, L(p[1], p[2], p[3]))
				end
			else
				table.insert(pts, L(BaseLayout.LaneX, y, sl.Z))
				table.insert(pts, L(sl.X + 4, y, sl.Z))
			end
			-- open the roller door locally
			local door = base and base:FindFirstChild("PortalDoor")
			local doorCF = door and door.CFrame
			ctx.door, ctx.doorCF = door, doorCF
			if door then
				ctx.doorTween = tw(door, 0.6, { CFrame = doorCF + Vector3.new(0, 10.5, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			end
			ghost:PivotTo(faceCF(pts[1], pts[2] - pts[1]))
			ghost.Parent = Workspace
			hideReal()
			-- still black: cut the camera to the gate, then fade in
			local d1 = (pts[2] - pts[1]).Unit
			camSnap(CFrame.lookAt(pts[1] - d1 * 12 + Vector3.new(0, 4.5, 0), pts[1] + d1 * 6 + Vector3.new(0, 1.5, 0)))
			task.wait(0.05)
			Cine.Darken(0, 0.45)
			play("drive")
			local total = 0
			for i = 2, #pts do
				total = total + (pts[i] - pts[i - 1]).Magnitude
			end
			local dur = math.clamp(total / 22, 3, 6)
			local d0 = os.clock()
			local lastDir = pts[2] - pts[1]
			local camPos
			while true do
				hideReal()
				local a = math.min(1, (os.clock() - d0) / dur)
				local e = a &lt; 0.5 and 2 * a * a or 1 - (-2 * a + 2) ^ 2 / 2 -- ease in-out
				local dist, acc = e * total, 0
				for i = 2, #pts do
					local seg = (pts[i] - pts[i - 1]).Magnitude
					if dist &lt;= acc + seg or i == #pts then
						local pos = pts[i - 1]:Lerp(pts[i], math.clamp((dist - acc) / math.max(seg, 1e-3), 0, 1))
						local dir = pts[i] - pts[i - 1]
						dir = Vector3.new(dir.X, 0, dir.Z)
						if dir.Magnitude &gt; 0.01 then
							lastDir = lastDir:Lerp(dir.Unit, 0.18)
						end
						local fwd = lastDir.Magnitude &gt; 0.01 and lastDir.Unit or Vector3.new(1, 0, 0)
						local hide = hiddenSeg ~= nil and i == hiddenSeg
						if ghost:GetAttribute("Hidden") ~= hide then
							ghost:SetAttribute("Hidden", hide)
							for _, d in ipairs(ghost:GetDescendants()) do
								if d:IsA("BasePart") then
									d.LocalTransparencyModifier = hide and 1 or 0
								end
							end
						end
						ghost.PrimaryPart.CFrame = faceCF(pos, fwd) * CFrame.new(0, math.sin(os.clock() * 18) * 0.04, 0)
						-- chase camera: behind and a bit above the car, looking ahead of it
						local want = pos - fwd * 12 + Vector3.new(0, 4.5, 0)
						camPos = camPos and camPos:Lerp(want, 0.15) or want
						camTarget = CFrame.lookAt(camPos, pos + fwd * 6 + Vector3.new(0, 1.5, 0))
						break
					end
					acc = acc + seg
				end
				if a &gt;= 1 then
					break
				end
				RunService.RenderStepped:Wait()
				check(ctx)
			end
			-- reverse-style final: swing into the bay facing out, hero shot
			local final = pts[#pts] - bcf:VectorToWorldSpace(Vector3.new(4, 0, 0))
			local outDir = bcf:VectorToWorldSpace(Vector3.new(1, 0, 0))
			tw(ghost.PrimaryPart, 0.7, { CFrame = faceCF(final, outDir) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			-- parked: the camera stays where it followed the car (in the aisle) and just looks at it
			camTarget = CFrame.lookAt(camPos or final - outDir * 11 + Vector3.new(0, 4.5, 0), final + Vector3.new(0, 1.5, 0))
			task.wait(0.8)
			Cine.Shake(0.3, 0.2)
			if lvl &gt;= 4 then
				Cine.Title(string.upper(def.name), rc, 1.2, 90, 0.75)
			end
			task.wait(1.1)
			if door then
				ctx.doorTween = tw(door, 0.6, { CFrame = doorCF })
			end
		end
		Cine.Darken(0, 0.3) -- no slot (stored car): just fade back in
		-- 7) hand the camera back (cleanup() restores the real car and the rest)
		Cine.Letterbox(false, 0.35)
		camTarget = cam0
		task.wait(0.35)
end

-- always runs, also when the cinematic errored half-way: nothing may stay hidden, dark or scripted
local function cleanup(ctx)
	if ctx.doorTween then
		pcall(function()
			ctx.doorTween:Cancel()
		end)
	end
	if ctx.magnet and ctx.magnetCF then
		ctx.magnet.CFrame = ctx.magnetCF
	end
	for _, k in ipairs({ "item", "ghost", "spk", "dof", "cc", "light" }) do
		if ctx[k] then
			pcall(function()
				ctx[k]:Destroy()
			end)
		end
	end
	for m in pairs(ctx.real or {}) do
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("BasePart") then
				d.LocalTransparencyModifier = 0
			elseif d:IsA("BillboardGui") then
				d.Enabled = true
			end
		end
	end
	if ctx.door and ctx.doorCF then
		ctx.door.CFrame = ctx.doorCF
	end
	if TrapFx.HideReveal then
		pcall(TrapFx.HideReveal)
	end
	camStop()
	Cine.Letterbox(false, 0.2)
	if not ctx.aborted then -- aborted = the player was wrecked: DeathFx owns the camera and the screen now
		Cine.Darken(0, 0.3)
		if ctx.camTaken then
			Cine.Release(0.3)
		end
	end
end

-- stop the running cinematic right away (the player got wrecked); queued ones are dropped
function TrapFx.Abort()
	queue = {}
	if current then
		current.aborted = true
	end
end

function TrapFx.Play(res, baseIndex, onDone)
	if busy then
		table.insert(queue, { res, baseIndex, onDone })
		return
	end
	busy = true
	pcall(cinema, true)
	task.spawn(function()
		local ctx = {}
		current = ctx
		local ok, err = pcall(body, res, baseIndex, ctx)
		if not ok and err ~= "aborted" then
			warn("TrapFx: " .. tostring(err))
		end
		local ok2, err2 = pcall(cleanup, ctx)
		if not ok2 then
			warn("TrapFx cleanup: " .. tostring(err2))
		end
		current = nil
		if onDone then
			task.spawn(onDone)
		end
		local nextOne = table.remove(queue, 1)
		busy = false
		if nextOne then
			TrapFx.Play(nextOne[1], nextOne[2], nextOne[3]) -- holds its own cinematic count before ours is released
		end
		pcall(cinema, false)
	end)
end

function TrapFx.IsBusy()
	return busy
end

return TrapFx
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX50"><Properties><string name="Name">UI</string><ProtectedString name="Source">-- CAR HUNTERS UI (design: Figma "CAR HUNTERS — Game UI"). Toy buttons, cartoon fonts, no purple.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContentProvider = game:GetService("ContentProvider")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Strings = require(Shared:WaitForChild("Strings"))
local Util = require(Shared:WaitForChild("Util"))
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local Icons = require(Shared:WaitForChild("Icons"))
local PartVisual = require(Shared:WaitForChild("PartVisual"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))
local TrapConfig = require(Shared:WaitForChild("TrapConfig"))
local VehicleFactory = require(Shared:WaitForChild("VehicleFactory"))
local RevealFx = require(script.Parent:WaitForChild("RevealFx"))

local T = Strings.T
local C = Color3.fromRGB
local HEAD = Enum.Font.LuckiestGuy
local BODY = Enum.Font.FredokaOne

local P = {
	yellow = C(255, 210, 63), orange = C(255, 138, 31), red = C(255, 59, 59), green = C(52, 208, 88),
	blue = C(46, 168, 255), cyan = C(34, 224, 224), ink = C(27, 31, 42), white = C(255, 255, 255),
	cream = C(255, 246, 224), grey = C(170, 176, 188), muted = C(96, 102, 116),
	-- v23 contours: cards sit on the cream panels as white faces with an ink outline and a tan slab under them,
	-- fields / tracks / counters are recessed into a darker cream inset
	card = C(255, 255, 255), inset = C(236, 228, 210), cardShadow = C(196, 182, 150),
}
local PART_ICON = {}
for id, p in pairs(PartConfig.Parts) do
	PART_ICON[id] = p.emoji
end
local ZONE_ICON = { city = "🏙️", highway = "🛣️", industrial = "🏭", neon = "🌃", scrapyard = "💀", docks = "🚂", desert = "🏜️", bridge = "🌉",
	airport = "✈️", canyon = "💀", circuit = "🏁", drift = "🌀", storm = "⛈️", rush = "🚦", colosseum = "👑" }
local ZONE_COLOR = { city = P.green, highway = P.blue, industrial = P.red, neon = P.cyan, plaza = P.orange, scrapyard = P.red, docks = P.blue, desert = P.orange,
	bridge = P.cyan, airport = P.blue, canyon = P.red, circuit = P.red, drift = P.cyan, storm = P.blue, rush = P.orange, colosseum = P.yellow }

local UI = {}
local store, actions
local gui, root
local overlay -- v10: pop-ups (reveal, dialogs, checkpoint, trade request, notifications) on one layer scaled like the HUD
local hud, panels = {}, {}
local state = { selectedPart = nil, nearTrap = false, open = nil, sellArm = {} }
local sounds = {}

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do
		o[k] = v
	end
	o.Parent = parent
	return o
end
local function corner(o, r)
	return new("UICorner", { CornerRadius = UDim.new(0, r or 16) }, o)
end
local function stroke(o, color, th)
	return new("UIStroke", { Color = color or P.ink, Thickness = th or 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
end
local function lift(c, k)
	return c:Lerp(k &gt; 0 and P.white or C(0, 0, 0), math.abs(k))
end
local function gradient(o, c)
	return new("UIGradient", { Color = ColorSequence.new(lift(c, 0.35), c), Rotation = 90 }, o)
end
local function tween(o, t, props, style, dir)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end
local function text(parent, props)
	local l = new("TextLabel", {
		BackgroundTransparency = 1, Font = HEAD, TextColor3 = P.white, TextScaled = false, TextSize = 22,
		Size = UDim2.new(1, 0, 0, 28), TextXAlignment = Enum.TextXAlignment.Left,
	}, parent)
	for k, v in pairs(props) do
		if k ~= "Outline" and k ~= "NoFit" then
			l[k] = v
		end
	end
	if props.Outline ~= false and l.Font == HEAD then
		new("UIStroke", { Color = P.ink, Thickness = props.Outline or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual }, l)
	end
	-- never overflow the frame: fixed-size labels shrink to fit (up to the requested size)
	if l.AutomaticSize == Enum.AutomaticSize.None and not l.TextScaled and props.NoFit ~= true then
		local want = l.TextSize
		l.TextScaled = true
		new("UITextSizeConstraint", { MaxTextSize = want, MinTextSize = math.min(9, want) }, l)
	end
	return l
end
local function clear(f)
	for _, c in ipairs(f:GetChildren()) do
		if not c:IsA("UIListLayout") and not c:IsA("UIGridLayout") and not c:IsA("UIPadding") then
			c:Destroy()
		end
	end
end
local function list(o, dir, gap, ha, va)
	return new("UIListLayout", { FillDirection = dir or Enum.FillDirection.Vertical, Padding = UDim.new(0, gap or 8),
		HorizontalAlignment = ha or Enum.HorizontalAlignment.Left, VerticalAlignment = va or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder }, o)
end

-- Toy button: shadow slab + face with gradient, ink outline, outlined label. Returns api.
local function toy(parent, o)
	local holder = new("Frame", { Name = o.Name or "Toy", BackgroundTransparency = 1, Size = o.Size, Position = o.Position or UDim2.new(),
		AnchorPoint = o.AnchorPoint or Vector2.zero, LayoutOrder = o.LayoutOrder or 0, ZIndex = o.ZIndex or 1 }, parent)
	local depth = o.Depth or 6
	local shadow = new("Frame", { BackgroundColor3 = lift(o.Color, -0.55), Size = UDim2.new(1, 0, 1, -depth), Position = UDim2.fromOffset(0, depth), BorderSizePixel = 0, ZIndex = holder.ZIndex }, holder)
	corner(shadow, o.Radius or 18)
	local face = new("TextButton", { Text = "", AutoButtonColor = false, BackgroundColor3 = P.white, Size = UDim2.new(1, 0, 1, -depth), BorderSizePixel = 0, ZIndex = holder.ZIndex + 1 }, holder)
	corner(face, o.Radius or 18)
	stroke(face, P.ink, 3)
	local grad = gradient(face, o.Color)
	local content = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = face.ZIndex }, face)
	list(content, Enum.FillDirection.Vertical, 0, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	local h = holder.Size.Y.Offset
	local icon
	local imgId = o.Image and Icons.Get(o.Image)
	if imgId then
		-- 3D sticker (Blender render): big, with a clear gap above the label
		content:FindFirstChildOfClass("UIListLayout").Padding = UDim.new(0, 5)
		local sz = math.floor(h * 0.58)
		icon = new("ImageLabel", { Image = imgId, BackgroundTransparency = 1, Size = UDim2.fromOffset(sz, sz), ScaleType = Enum.ScaleType.Fit, ZIndex = face.ZIndex, LayoutOrder = 1 }, content)
	elseif o.Icon then
		icon = text(content, { Text = o.Icon, Font = BODY, TextSize = o.IconSize or math.floor(h * 0.34), Size = UDim2.new(1, 0, 0, math.floor(h * 0.4)), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = face.ZIndex, LayoutOrder = 1 })
	end
	local withIcon = icon ~= nil
	local label = text(content, { Text = o.Text or "", TextSize = o.TextSize or math.floor(h * (withIcon and 0.19 or 0.36)), RichText = true,
		Size = UDim2.new(1, -8, 0, math.floor(h * (withIcon and 0.24 or 0.5))), TextXAlignment = Enum.TextXAlignment.Center, Outline = 2.5, ZIndex = face.ZIndex, LayoutOrder = 2 })
	local sub
	if o.Sub then
		sub = text(content, { Text = o.Sub, Font = BODY, TextSize = o.SubSize or math.floor(h * 0.15), TextColor3 = P.ink, Size = UDim2.new(1, -8, 0, math.floor(h * 0.2)), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = face.ZIndex, LayoutOrder = 3, RichText = true })
	end
	local api = { holder = holder, face = face, label = label, sub = sub, icon = icon, enabled = true }
	function api.SetColor(c)
		grad.Color = ColorSequence.new(lift(c, 0.35), c)
		shadow.BackgroundColor3 = lift(c, -0.55)
	end
	function api.SetText(t, s)
		label.Text = t
		if sub and s then
			sub.Text = s
		end
	end
	face.MouseButton1Down:Connect(function()
		face.Position = UDim2.fromOffset(0, depth - 2)
	end)
	local function up()
		face.Position = UDim2.new()
	end
	face.MouseButton1Up:Connect(up)
	face.MouseLeave:Connect(up)
	face.InputEnded:Connect(function(input) -- touch: the finger slid off the button
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			up()
		end
	end)
	face.Activated:Connect(function()
		up()
		if o.OnClick and api.enabled then
			UI.Sfx("click")
			o.OnClick()
		end
	end)
	return api
end

local function pill(parent, txt, color, props)
	local f = new("Frame", { BackgroundColor3 = color, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, props and props.H or 30), BorderSizePixel = 0, LayoutOrder = props and props.LayoutOrder or 0 }, parent)
	corner(f, 30)
	stroke(f, P.ink, 2.5)
	new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, f)
	local l = text(f, { Text = txt, TextSize = props and props.TextSize or 18, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromScale(0, 1), TextXAlignment = Enum.TextXAlignment.Center })
	return f, l
end

local function rarityColor(r)
	return CarConfig.Rarities[r].color
end

-- v23 contours ------------------------------------------------------------------------------------------------
-- card(parent, props) -&gt; content, holder, face, stroke
-- A white face with an ink outline and a tan shadow slab under it (so it reads on the cream panel). Built as a
-- transparent holder (takes Size/Position/AnchorPoint/LayoutOrder/Visible; works inside list and grid layouts,
-- in a grid the cell size wins) with the slab and the face inside; the holder is `Shadow` px taller than Size.
-- props: Size, Position, AnchorPoint, LayoutOrder, ZIndex, Visible, Name, Class ("Frame" / "TextButton"),
--   Color (fill, default P.card), Accent (Color3: left band, or a top strip with AccentTop), AccentSize (8),
--   Radius (14), Stroke (ink thickness 3, 0 = none), StrokeColor, Shadow (4, 0 = none), ShadowColor.
-- With an Accent the face is filled with the accent colour and the returned content frame is the inner body
-- (inset by AccentSize on the accent side); face.BackgroundColor3 then changes the accent.
local function card(parent, o)
	o = o or {}
	local sh = o.Shadow or 4
	local r = o.Radius or 14
	local z = o.ZIndex or 1
	local holder = new("Frame", { Name = o.Name or "Card", BackgroundTransparency = 1, BorderSizePixel = 0, Position = o.Position or UDim2.new(),
		AnchorPoint = o.AnchorPoint or Vector2.zero, LayoutOrder = o.LayoutOrder or 0, ZIndex = z, Visible = o.Visible ~= false }, parent)
	if o.Size then
		holder.Size = UDim2.new(o.Size.X.Scale, o.Size.X.Offset, o.Size.Y.Scale, o.Size.Y.Offset + sh)
	end
	if sh &gt; 0 then
		local slab = new("Frame", { Name = "Shadow", BackgroundColor3 = o.ShadowColor or P.cardShadow, BorderSizePixel = 0, Position = UDim2.fromOffset(0, sh),
			Size = UDim2.new(1, 0, 1, -sh), ZIndex = z }, holder)
		corner(slab, r)
	end
	local face = new(o.Class or "Frame", { Name = "Face", BackgroundColor3 = o.Accent or o.Color or P.card, BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, -sh), ZIndex = z + 1 }, holder)
	if face:IsA("GuiButton") then
		face.AutoButtonColor = false
		if face:IsA("TextButton") then
			face.Text = ""
		end
	end
	corner(face, r)
	local st
	if (o.Stroke or 3) &gt; 0 then
		st = stroke(face, o.StrokeColor or P.ink, o.Stroke or 3)
	end
	local content = face
	if o.Accent then
		-- the body keeps the face's radius: its far corners sit exactly on the face's, the near ones leave a curved band
		local a = o.AccentSize or 8
		content = new("Frame", { Name = "Body", BackgroundColor3 = o.Color or P.card, BorderSizePixel = 0, ZIndex = z + 1,
			Position = o.AccentTop and UDim2.fromOffset(0, a) or UDim2.fromOffset(a, 0), Size = o.AccentTop and UDim2.new(1, 0, 1, -a) or UDim2.new(1, -a, 1, 0) }, face)
		corner(content, r)
	end
	return content, holder, face, st
end

-- inset(parent, props) -&gt; a recessed field (counter, money box, slider track, bar track): darker cream, soft ink rim.
-- props: any properties of the instance plus Class ("Frame" / "TextBox" / "TextButton"), Color, Radius (10), Stroke (2).
local function inset(parent, o)
	o = o or {}
	local f = new(o.Class or "Frame", { BackgroundColor3 = o.Color or P.inset, BorderSizePixel = 0 }, parent)
	if f:IsA("GuiButton") then
		f.AutoButtonColor = false
		if f:IsA("TextButton") then
			f.Text = ""
		end
	end
	for k, v in pairs(o) do
		if k ~= "Class" and k ~= "Color" and k ~= "Radius" and k ~= "Stroke" then
			f[k] = v
		end
	end
	corner(f, o.Radius or 10)
	if (o.Stroke or 2) &gt; 0 then
		new("UIStroke", { Color = P.ink, Thickness = o.Stroke or 2, Transparency = 0.35, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, f)
	end
	return f
end

-- room inside a scrolling list / grid so outlines and shadow slabs of the first and last cards never get clipped
local function padding(o, px, right)
	return new("UIPadding", { PaddingTop = UDim.new(0, px or 8), PaddingBottom = UDim.new(0, (px or 8) + 4), PaddingLeft = UDim.new(0, px or 8),
		PaddingRight = UDim.new(0, right or ((px or 8) + 6)) }, o)
end

-- dialogShell(parent, props) -&gt; card, holder, head
-- The pop-up look shared by every dialog: cream body, 5 px ink outline, a dark drop shadow 6 px under it and, with
-- props.Color, a gradient header strip like the panels (props.Title / TitleSize / HeadH). Put the pop-in UIScale on
-- the holder (it carries the shadow too). props: Size, Position, AnchorPoint (centre), ZIndex, Radius (26), Class,
-- Active, Name.
local function dialogShell(parent, o)
	local z = o.ZIndex or 1
	local r = o.Radius or 26
	local holder = new("Frame", { Name = o.Name or "Dialog", BackgroundTransparency = 1, BorderSizePixel = 0, AnchorPoint = o.AnchorPoint or Vector2.new(0.5, 0.5),
		Position = o.Position or UDim2.fromScale(0.5, 0.5), Size = o.Size, ZIndex = z }, parent)
	local slab = new("Frame", { Name = "Shadow", BackgroundColor3 = P.ink, BackgroundTransparency = 0.35, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 6),
		Size = UDim2.fromScale(1, 1), ZIndex = z }, holder)
	corner(slab, r)
	local cardF = new(o.Class or "Frame", { Name = "Card", BackgroundColor3 = P.cream, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = z + 1 }, holder)
	if cardF:IsA("GuiButton") then
		cardF.AutoButtonColor = false
		if cardF:IsA("TextButton") then
			cardF.Text = ""
		end
	end
	if o.Active ~= nil then
		cardF.Active = o.Active
	end
	corner(cardF, r)
	stroke(cardF, P.ink, 5)
	local head
	if o.Color then
		head = new("Frame", { Name = "Head", Size = UDim2.new(1, 0, 0, o.HeadH or 64), BackgroundColor3 = P.white, BorderSizePixel = 0, ZIndex = z + 2 }, cardF)
		corner(head, r)
		stroke(head, P.ink, 5)
		gradient(head, o.Color)
		if o.Title then
			text(head, { Text = o.Title, TextSize = o.TitleSize or 32, Position = UDim2.fromOffset(20, 0), Size = UDim2.new(1, -40, 1, 0), TextXAlignment = Enum.TextXAlignment.Center,
				ZIndex = z + 3, Outline = 3 })
		end
	end
	return cardF, holder, head
end

local function fitCamera(vp, model, angle)
	local cam = vp.CurrentCamera or new("Camera", { FieldOfView = 38 }, vp)
	vp.CurrentCamera = cam
	local size = model:GetExtentsSize()
	local d = math.max(size.X, size.Z, size.Y * 1.6) * 1.3
	local a = angle or math.rad(35)
	local center = Vector3.new(0, size.Y * 0.45, 0)
	cam.CFrame = CFrame.lookAt(center + Vector3.new(math.cos(a) * d, d * 0.38, math.sin(a) * d), center)
end

local function carViewport(parent, def, props)
	local vp = new("ViewportFrame", { BackgroundTransparency = 1, Ambient = C(200, 200, 210), LightColor = C(255, 250, 240), LightDirection = Vector3.new(-1, -2, -1) }, parent)
	for k, v in pairs(props or {}) do
		vp[k] = v
	end
	local m = VehicleFactory.BuildCar(def, { Low = true })
	m:PivotTo(CFrame.new())
	m.Parent = vp
	fitCamera(vp, m)
	return vp, m
end

---------------------------------------------------------------- sound / toasts
function UI.Sfx(name)
	if name == "soft" then
		name = "step" -- the quiet two-note chime (ElevenLabs) is the one calm "done" sound
	end
	local s = sounds[name]
	if s then
		s:Play()
	end
end
-- two volume groups for the Settings sliders: SFX (every UI/game sound) and Music
local function soundGroup(name, vol)
	local g = SoundService:FindFirstChild(name) or new("SoundGroup", { Name = name, Volume = vol }, SoundService)
	return g
end
UI.SfxGroup = soundGroup("SFX", 0.8)
UI.MusicGroup = soundGroup("Music", 0.5)
local function makeSound(name, id, vol, speed)
	sounds[name] = new("Sound", { Name = "UI_" .. name, SoundId = id, Volume = vol or 0.5, PlaybackSpeed = speed or 1, SoundGroup = UI.SfxGroup }, SoundService)
end

local KIND_COLOR = { good = P.green, error = P.red, warn = P.orange, info = P.blue }
-- Notifications (v10): one queue for every top message. Max 3 on screen, the same text within its lifetime merges
-- into "x2" instead of stacking, items move with their own position tweens (no list-layout snapping), and the
-- whole pill (background, text AND outline) fades before it is destroyed.
-- v16: small pills at the top centre, under the zone banner, max 2 at once
local notes = { items = {}, queue = {}, top = 50 }
local NOTE_H, NOTE_GAP, NOTE_MAX, NOTE_LIFE = 28, 6, 2, 2.8

local function noteY(i)
	-- with a panel open the lane sits above the panel card, so a message never covers the button just pressed
	-- dialogs (confirm, checkpoint) also push the lane to the very top so it never covers their buttons
	-- below the tutorial card on garage steps; with a panel up the banner is hidden and the lane sits at the very top,
	-- above the panel's title
	local top = hud.tutInPanel and 116 or (state.open and 6 or notes.top)
	return top + (i - 1) * (NOTE_H + NOTE_GAP)
end

local function noteLayout()
	for i, it in ipairs(notes.items) do
		tween(it.f, 0.22, { Position = UDim2.new(0.5, 0, 0, noteY(i)) })
	end
end

local noteShow
local function noteRemove(it)
	if it.dead then
		return
	end
	it.dead = true
	for i, x in ipairs(notes.items) do
		if x == it then
			table.remove(notes.items, i)
			break
		end
	end
	tween(it.f, 0.25, { BackgroundTransparency = 1 })
	tween(it.l, 0.25, { TextTransparency = 1 })
	tween(it.stroke, 0.25, { Transparency = 1 })
	for _, st in ipairs(it.l:GetChildren()) do
		if st:IsA("UIStroke") then
			tween(st, 0.25, { Transparency = 1 })
		end
	end
	task.delay(0.27, function()
		it.f:Destroy()
	end)
	noteLayout()
	local nextOne = table.remove(notes.queue, 1)
	while nextOne and (os.clock() - (nextOne.at or 0) &gt; 4 or (state.notesOff and nextOne.kind ~= "error" and nextOne.kind ~= "warn")) do
		nextOne = table.remove(notes.queue, 1) -- stale ("Not enough money" 8 s later helps nobody)
	end
	if nextOne then
		noteShow(nextOne.msg, nextOne.kind, nextOne.n, nextOne.silent)
	end
end

local function noteLabel(it)
	return it.n &gt; 1 and (it.msg .. "   x" .. it.n) or it.msg
end

noteShow = function(msg, kind, n, silent)
	local f = new("TextButton", { Name = "Note", Text = "", AutoButtonColor = false, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, noteY(#notes.items + 1) - 10), AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, NOTE_H), BackgroundColor3 = KIND_COLOR[kind] or P.blue, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 50 }, hud.toasts)
	corner(f, 14)
	local st = stroke(f, P.ink, 2)
	st.Transparency = 1
	new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, f)
	local l = text(f, { Text = msg, TextSize = 15, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromScale(0, 1), ZIndex = 51, TextTransparency = 1 })
	local it = { f = f, l = l, stroke = st, msg = msg, kind = kind, n = n or 1, expire = os.clock() + NOTE_LIFE, born = os.clock() }
	l.Text = noteLabel(it)
	table.insert(notes.items, it)
	f.Activated:Connect(function() -- tap a message to hide it right away
		noteRemove(it)
	end)
	tween(f, 0.2, { BackgroundTransparency = 0 })
	tween(l, 0.2, { TextTransparency = 0 })
	tween(st, 0.2, { Transparency = 0 })
	noteLayout()
	if not silent then
		UI.Sfx(kind == "error" and "err" or "ping")
	end
end

-- silent = no ping (e.g. a message that comes with its own sound); notifications can be switched off in Settings
-- (errors still show: the player must know why an action failed)
function UI.Toast(msg, kind, silent)
	msg = tostring(msg)
	if state.notesOff and kind ~= "error" and kind ~= "warn" then
		return
	end
	-- same message already on screen or waiting: count it instead of adding another pill
	for _, it in ipairs(notes.items) do
		if not it.dead and it.msg == msg then
			it.n = it.n + 1
			it.l.Text = noteLabel(it)
			-- refresh, but never longer than 6 s in total and not while others are waiting
			it.expire = #notes.queue &gt; 0 and it.expire or math.min(os.clock() + NOTE_LIFE, it.born + 6)
			return
		end
	end
	for _, q in ipairs(notes.queue) do
		if q.msg == msg then
			q.n = q.n + 1
			return
		end
	end
	if #notes.items &gt;= NOTE_MAX then
		table.insert(notes.queue, { msg = msg, kind = kind, n = 1, at = os.clock(), silent = silent })
		while #notes.queue &gt; 5 do
			table.remove(notes.queue, 1) -- a burst: drop the oldest waiting messages
		end
		-- make room soon: the oldest one leaves early
		local oldest = notes.items[1]
		oldest.expire = math.min(oldest.expire, os.clock() + 0.6)
		return
	end
	noteShow(msg, kind, 1, silent)
end

-- a modal dialog (confirm, checkpoint) is up: the notification lane moves to the very top
-- counted: a confirm over the checkpoint card, or a confirm replacing another one, keeps the flag right
local dialogDepth = 0
function UI.SetDialog(on)
	dialogDepth = math.max(0, dialogDepth + (on and 1 or -1))
	state.dialog = dialogDepth &gt; 0 or nil
	noteLayout()
end

function UI.SetNotificationsEnabled(on)
	if state.notesOff == not on then
		return -- unchanged (called on every settings change)
	end
	state.notesOff = not on
	if not on then
		-- drop waiting messages first (errors/warnings stay), then hide what is on screen
		local keep = {}
		for _, q in ipairs(notes.queue) do
			if q.kind == "error" or q.kind == "warn" then
				table.insert(keep, q)
			end
		end
		notes.queue = keep
		for _, it in ipairs(table.clone(notes.items)) do
			if it.kind ~= "error" and it.kind ~= "warn" then
				noteRemove(it)
			end
		end
	end
end

task.spawn(function()
	while true do
		task.wait(0.1)
		pcall(function()
			local now = os.clock()
			-- no table copy every tick: collect the expired ones first (noteRemove edits notes.items), usually none
			local due
			for _, it in ipairs(notes.items) do
				if state.cine then
					it.expire = math.max(it.expire, now + 0.5) -- hidden during cinematics: keep it for afterwards
				elseif now &gt;= it.expire then
					due = due or {}
					table.insert(due, it)
				end
			end
			if due then
				for _, it in ipairs(due) do
					noteRemove(it)
				end
			end
		end)
	end
end)

function UI.Notify(payload)
	if type(payload) ~= "table" then
		return
	end
	local SILENT = { banked = true, banked2 = true, contractDone = true, contractsDone = true, dailyClaimed = true, chestClaimed = true }
	UI.Toast(T("n_" .. tostring(payload.key), table.unpack(payload.args or {})), payload.kind, SILENT[payload.key])
end

---------------------------------------------------------------- HUD
local function buildHud()
	-- left column (Figma "08 — HUD Left Clean"): no cards, outlined type, real 3D icons
	-- bottom-left corner; on phones lifted above the movement thumbstick
	local UIS = game:GetService("UserInputService")
	local lift = (UIS.TouchEnabled and not UIS.KeyboardEnabled) and 210 or 0
	hud.leftLift = lift
	local colF = new("Frame", { Name = "LeftColumn", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 18, 1, -16 - lift), Size = UDim2.fromOffset(280, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1 }, root)
	list(colF, Enum.FillDirection.Vertical, 12)
	hud.leftCol = colF
	local function outline(l, th)
		new("UIStroke", { Color = P.ink, Thickness = th or 2.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual }, l)
		return l
	end
	local function icon(parent, name, size, pos)
		local img = new("ImageLabel", { Size = UDim2.fromOffset(size, size), Position = pos or UDim2.new(), BackgroundTransparency = 1, Image = Icons.Get(name) or "", ScaleType = Enum.ScaleType.Fit }, parent)
		if img.Image == "" then -- not uploaded: a plain short word instead
			text(img, { Text = string.upper(string.sub(name, 1, 4)), TextSize = 14, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center })
		end
		return img
	end
	-- money
	local money = new("Frame", { Name = "Money", Size = UDim2.fromOffset(280, 64), BackgroundTransparency = 1, LayoutOrder = 5 }, colF)
	-- v22 coin: soft gold halo behind it (stacked circles fading outwards), a shine sweep every ~4 s,
	-- a spin-bounce whenever money comes in (UI.CoinBounce)
	local halo = new("Frame", { Name = "CoinGlow", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(28, 32), Size = UDim2.fromOffset(56, 56),
		BackgroundTransparency = 1, ZIndex = 1 }, money)
	for _, k in ipairs({ { 1.9, 0.94 }, { 1.62, 0.91 }, { 1.38, 0.88 }, { 1.16, 0.84 }, { 0.96, 0.8 } }) do
		local g = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(k[1], k[1]), BackgroundColor3 = C(255, 196, 48),
			BackgroundTransparency = k[2], BorderSizePixel = 0, ZIndex = 1 }, halo)
		new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, g)
	end
	local haloScale = new("UIScale", {}, halo)
	TweenService:Create(haloScale, TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Scale = 1.12 }):Play() -- lives as long as the HUD
	local coin = icon(money, "coin", 56, UDim2.fromOffset(0, 4))
	coin.ZIndex = 2
	hud.coin = coin
	hud.coinScale = new("UIScale", {}, coin)
	local shine = new("Frame", { Name = "Shine", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.8, 0.8),
		BackgroundColor3 = P.white, BorderSizePixel = 0, ZIndex = 3 }, coin)
	new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, shine)
	local shineGrad = new("UIGradient", { Transparency = RevealFx.ShineBand(0.35, 0.14), Rotation = 25 }, shine)
	RevealFx.Sweep(shineGrad, 0.7, 3.4)
	hud.money = text(money, { Position = UDim2.fromOffset(64, 0), Size = UDim2.new(1, -64, 0, 42), TextSize = 40, TextColor3 = P.white, Outline = 3, ZIndex = 3 })
	hud.income = outline(text(money, { Position = UDim2.fromOffset(65, 42), Size = UDim2.new(1, -65, 0, 20), TextSize = 18, Font = BODY, TextColor3 = C(70, 220, 100), ZIndex = 3 }), 2.5)
	hud.moneyScale = new("UIScale", {}, money)
	-- loot carried on this run (only while carrying)
	local bag = new("Frame", { Name = "Carrying", Size = UDim2.fromOffset(280, 28), BackgroundTransparency = 1, Visible = false, LayoutOrder = 3 }, colF)
	hud.bag = bag
	hud.bagText = text(bag, { Text = "", TextSize = 17, TextColor3 = C(255, 80, 70), Size = UDim2.new(1, 0, 0, 20), Outline = 2.5 })
	local bbar = new("Frame", { Position = UDim2.fromOffset(0, 23), Size = UDim2.fromOffset(200, 4), BackgroundColor3 = P.ink, BackgroundTransparency = 0.45, BorderSizePixel = 0 }, bag)
	corner(bbar, 2)
	hud.bagFill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = C(255, 80, 70), BorderSizePixel = 0 }, bbar)
	corner(hud.bagFill, 2)
	hud.icon = icon

	-- zone banner + hint
	-- zone banner: top centre (the top-left corner belongs to the Roblox chat); notifications start under it
	local banner = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 6), Size = UDim2.fromOffset(240, 38), BackgroundColor3 = P.white, BorderSizePixel = 0 }, root)
	hud.banner = banner
	corner(banner, 14)
	stroke(banner, P.ink, 3.5)
	hud.bannerGrad = gradient(banner, P.orange)
	-- LuckiestGuy draws high in its line box: the label sits 3 px lower so the word looks centred in the plate
	hud.zone = text(banner, { Text = "", TextSize = 26, Position = UDim2.fromOffset(8, 5), Size = UDim2.new(1, -16, 1, -6), TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center, Outline = 3 })
	local hint = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 70), AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 40), BackgroundColor3 = P.white, BorderSizePixel = 0, Visible = false }, root)
	corner(hint, 20)
	stroke(hint, P.ink, 3)
	new("UIPadding", { PaddingLeft = UDim.new(0, 18), PaddingRight = UDim.new(0, 18) }, hint)
	hud.hintFrame = hint
	hud.hint = text(hint, { Text = "", Font = BODY, TextSize = 20, TextColor3 = P.ink, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromScale(0, 1) })

	-- side buttons (minimum: 3)
	-- phones: start higher and a bit smaller so the column ends above the jump button
	local touch = (UIS.TouchEnabled and not UIS.KeyboardEnabled)
	local side = new("Frame", { Name = "SideButtons", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, touch and 64 or 100), Size = UDim2.fromOffset(122, 5 * 104 + 48), BackgroundTransparency = 1 }, root)
	if touch then
		new("UIScale", { Scale = 0.8 }, side)
	end
	hud.side = side
	list(side, Enum.FillDirection.Vertical, 12)
	local tpBtn = toy(side, { Text = T("btn_teleport"), Image = "teleport", Icon = "🚀", Color = P.blue, Size = UDim2.fromOffset(122, 104), LayoutOrder = 1, OnClick = function() UI.TogglePanel("teleport") end })
	hud.garageBtn = toy(side, { Text = T("btn_garage"), Image = "garage", Icon = "🏁", Color = P.orange, Size = UDim2.fromOffset(122, 104), LayoutOrder = 2, OnClick = function() UI.TogglePanel("garage") end })
	toy(side, { Text = T("btn_index"), Image = "index", Icon = "🚗", Color = P.green, Size = UDim2.fromOffset(122, 104), LayoutOrder = 3, OnClick = function() UI.TogglePanel("index") end })
	-- on the TELEPORT button itself (as a child of the list it used to push every button down)
	hud.teleportBtn = tpBtn
	hud.newDot = new("Frame", { Size = UDim2.fromOffset(22, 22), Position = UDim2.new(1, -16, 0, -6), BackgroundColor3 = P.red, Visible = false, ZIndex = 5 }, tpBtn.holder)
	corner(hud.newDot, 11)
	stroke(hud.newDot, P.white, 3)

	-- THROW (only near own trap)
	hud.throw = toy(root, { Name = "Throw", Text = T("btn_throw"), Sub = "", Color = P.yellow, Size = UDim2.fromOffset(300, 104),
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -24), OnClick = function() UI.TogglePanel("throw") end })
	hud.throw.holder.Visible = false

	hud.toasts = new("Frame", { Name = "Notes", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 90 }, overlay) -- items position themselves (UI.Toast)
	hud.flash = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = P.red, BackgroundTransparency = 1, ZIndex = 40, Active = false }, gui)
end

---------------------------------------------------------------- panels
local function panelShell(name, title, w, h, color)
	local dim = new("TextButton", { Name = name, Text = "", AutoButtonColor = false, Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(0, 0, 0), BackgroundTransparency = 0.5, Visible = false, ZIndex = 20 }, root)
	dim.Activated:Connect(function() UI.TogglePanel(nil) end)
	-- v23: the card sits on a dark drop shadow (shell holder carries both, the open/close UIScale goes on it)
	local card, shell = dialogShell(dim, { Class = "TextButton", Size = UDim2.fromOffset(w, h), Radius = 28, ZIndex = 21 })
	local head = new("Frame", { Size = UDim2.new(1, 0, 0, 70), BackgroundColor3 = P.white, ZIndex = 22 }, card)
	corner(head, 28)
	stroke(head, P.ink, 5)
	gradient(head, color)
	text(head, { Text = title, TextSize = 38, Position = UDim2.fromOffset(28, 0), Size = UDim2.new(1, -110, 1, 0), ZIndex = 23, Outline = 3 })
	toy(card, { Text = "X", Color = P.red, Size = UDim2.fromOffset(60, 64), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 14, 0, -18), ZIndex = 24, OnClick = function() UI.TogglePanel(nil) end })
	local content = new("Frame", { Position = UDim2.fromOffset(22, 86), Size = UDim2.new(1, -44, 1, -104), BackgroundTransparency = 1, ZIndex = 22 }, card)
	local sc = new("UIScale", {}, shell)
	panels[name] = { root = dim, card = card, content = content, scale = sc }
	return panels[name]
end

-- v23: 8 px all round (outer outlines + the shadow slabs of the first / last cards never clip), scrollbar gap on the right
local function scroller(parent, pos, size)
	local s = new("ScrollingFrame", { Position = pos, Size = size, BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 8, ScrollBarImageColor3 = P.ink,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 22 }, parent)
	list(s, Enum.FillDirection.Vertical, 10)
	padding(s, 8, 14)
	return s
end

-- THROW menu (Figma "09 — Throw Menu"): pick how many of each part, see the expected cars, throw them all at once
state.mix = {}
state.merge = true
local function mixTotal()
	local n = 0
	for _, id in ipairs(PartConfig.Order) do
		n = n + math.min(state.mix[id] or 0, store.Banked(id))
	end
	return n
end
-- how many cars one throw may catch (1..4, "Multi Catch" perk in the Pit Stop)
local function catchLimit()
	local st = store.State
	return EconomyConfig.CatchLimit(st and st.perks and st.perks.multi or 0)
end
local function setMix(id, n)
	local total = mixTotal() - math.min(state.mix[id] or 0, store.Banked(id))
	state.mix[id] = math.clamp(n, 0, math.max(0, math.min(store.Banked(id), EconomyConfig.MaxBatch - total)))
	UI.Refresh()
end

local function buildThrow()
	local p = panelShell("throw", T("throw_title"), 940, 600, P.yellow)
	local c = p.content
	local rows = scroller(c, UDim2.new(), UDim2.fromOffset(570, 340)) -- 10 parts: scrolling list
	panels.throwRows = {}
	-- rarity points of the pick + cars per throw (1 at the start, up to 4 with "Multi Catch")
	panels.catchInfo = text(c, { Text = "", Font = BODY, TextSize = 17, TextColor3 = P.ink, RichText = true, Position = UDim2.fromOffset(0, 346), Size = UDim2.fromOffset(560, 26), ZIndex = 23 })
	-- v24: the throw PLATFORM upgrade (luck per level, a cooler look per level; TrapService)
	local tp = card(c, { Position = UDim2.fromOffset(8, 380), Size = UDim2.fromOffset(540, 96), Accent = P.cyan, Radius = 18, ZIndex = 23 })
	local tpTitle = text(tp, { Text = "", TextSize = 22, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(14, 8), Size = UDim2.fromOffset(300, 26), ZIndex = 24 })
	local tpLuck = text(tp, { Text = "", Font = BODY, TextSize = 16, TextColor3 = P.ink, RichText = true, Position = UDim2.fromOffset(14, 38), Size = UDim2.fromOffset(300, 22), ZIndex = 24 })
	local tpNext = text(tp, { Text = "", Font = BODY, TextSize = 14, TextColor3 = P.muted, RichText = true, Position = UDim2.fromOffset(14, 62), Size = UDim2.fromOffset(300, 20), ZIndex = 24 })
	local tpBtn = toy(tp, { Text = "UPGRADE", Sub = "", SubSize = 17, TextSize = 22, Color = P.green, Size = UDim2.fromOffset(200, 74), Position = UDim2.fromOffset(318, 8), ZIndex = 25,
		OnClick = function()
			local st = store.State
			local cost = TrapConfig.NextCost(st and st.trapLevel or 1)
			if not cost then
				UI.Toast(T("n_maxLevel"), "warn")
			elseif store.Money &lt; cost then
				UI.Toast(T("n_noMoney"), "error")
			elseif actions.UpgradeTrap then
				actions.UpgradeTrap()
			end
		end })
	panels.trapUpgradeBtn = tpBtn -- (the tutorial pulses it)
	-- also called on money ticks (TrapVisuals) so the button turns green the moment you can pay
	function panels.trapRefresh()
		local st = store.State
		if not st then
			return
		end
		local lvl = TrapConfig.Clamp(st.trapLevel or 1)
		local cost = TrapConfig.NextCost(lvl)
		local maxed = cost == nil
		tpTitle.Text = string.format("PLATFORM Lv %d", lvl)
		tpLuck.Text = string.format("&lt;b&gt;LUCK x%.2f&lt;/b&gt;  &lt;font color=\"#606674\"&gt;·  Lv %d/%d&lt;/font&gt;", TrapConfig.LuckMult(lvl), lvl, TrapConfig.MaxLevel)
		if maxed then
			tpNext.Text = "Fully upgraded - the golden platform!"
			tpBtn.SetText("MAX", "Lv " .. lvl)
			tpBtn.SetColor(P.yellow)
		else
			tpNext.Text = string.format("Next: &lt;b&gt;%s&lt;/b&gt;  ·  &lt;font color=\"#2EA8FF\"&gt;+%d%% luck&lt;/font&gt;", TrapConfig.Names[lvl + 1], math.floor(TrapConfig.LuckPerLevel * 100 + 0.5))
			tpBtn.SetText("UPGRADE", "$" .. Util.FormatNumber(cost))
			tpBtn.SetColor(store.Money &gt;= cost and P.green or P.grey)
		end
	end
	for i, id in ipairs(PartConfig.Order) do
		local rc = rarityColor(PartConfig.Parts[id].rarity)
		-- v23: white card with ink outline + shadow; the rarity is the left band (faded while none is picked)
		local r, _, band, st = card(rows, { Size = UDim2.fromOffset(540, 74), Accent = rc, Radius = 18, LayoutOrder = i, ZIndex = 23 })
		-- the real 3D part (same model as on the map), slowly turning
		local img = new("ViewportFrame", { Position = UDim2.fromOffset(8, 5), Size = UDim2.fromOffset(64, 64), BackgroundTransparency = 1, Ambient = C(190, 190, 200),
			LightColor = C(255, 250, 240), LightDirection = Vector3.new(-1, -1.5, -1), ZIndex = 24 }, r)
		local pm = PartVisual.Build(id)
		for _, d in ipairs(pm:GetDescendants()) do
			if d:IsA("ParticleEmitter") or d:IsA("Light") then
				d:Destroy()
			end
		end
		pm:PivotTo(CFrame.new())
		pm.Parent = img
		local cam = new("Camera", { FieldOfView = 30 }, img)
		img.CurrentCamera = cam
		local _, ext = pm:GetBoundingBox()
		panels.partSpin = panels.partSpin or {}
		table.insert(panels.partSpin, { cam = cam, dist = math.max(ext.X, ext.Y, ext.Z) * 2.4, centre = pm:GetBoundingBox().Position })
		text(r, { Text = string.upper(T("part_" .. id)), TextSize = 20, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(80, 10), Size = UDim2.fromOffset(152, 26), ZIndex = 24 })
		local owned = text(r, { Text = "", Font = BODY, TextSize = 14, TextColor3 = P.muted, Position = UDim2.fromOffset(80, 40), Size = UDim2.fromOffset(150, 20), ZIndex = 24 })
		local function stepBtn(label, color, x, w, onClick)
			return toy(r, { Text = label, Color = color, Size = UDim2.fromOffset(w, 48), Position = UDim2.fromOffset(x, 12), TextSize = label == "MAX" and 18 or 26, ZIndex = 25, OnClick = onClick })
		end
		local minus = stepBtn("-", P.red, 240, 46, function() setMix(id, (state.mix[id] or 0) - 1) end)
		local cnt = inset(r, { Position = UDim2.fromOffset(294, 15), Size = UDim2.fromOffset(72, 44), Radius = 12, ZIndex = 24 })
		local cntText = text(cnt, { Text = "0", TextSize = 26, TextColor3 = P.ink, Outline = false, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 25 })
		local plus = stepBtn("+", P.green, 374, 46, function() setMix(id, (state.mix[id] or 0) + 1) end)
		local max = stepBtn("MAX", P.blue, 428, 80, function() setMix(id, store.Banked(id)) end)
		-- hold +/- to repeat
		for _, pair in ipairs({ { plus, 1 }, { minus, -1 } }) do
			local held = false
			pair[1].face.MouseButton1Down:Connect(function()
				held = true
				task.delay(0.4, function()
					while held do
						setMix(id, (state.mix[id] or 0) + pair[2])
						task.wait(0.06)
					end
				end)
			end)
			pair[1].face.MouseButton1Up:Connect(function() held = false end)
			pair[1].face.MouseLeave:Connect(function() held = false end)
			pair[1].face.InputEnded:Connect(function() held = false end)
		end
		panels.throwRows[id] = { frame = r, stroke = st, band = band, img = img, owned = owned, cnt = cntText, minus = minus, plus = plus, max = max, rc = rc }
	end
	-- right column: quick picks, expected cars, merge toggle, throw
	local right = new("Frame", { Position = UDim2.fromOffset(582, 0), Size = UDim2.fromOffset(312, 480), BackgroundTransparency = 1, ZIndex = 22 }, c)
	panels.throwAll = toy(right, { Text = "ALL", Color = P.orange, Size = UDim2.fromOffset(98, 46), Position = UDim2.fromOffset(0, 0), TextSize = 20, ZIndex = 23, OnClick = function()
		-- every part you have (more parts = more rarity points)
		state.mix = {}
		local left = EconomyConfig.MaxBatch
		for i = #PartConfig.Order, 1, -1 do
			local id = PartConfig.Order[i]
			local n = math.min(store.Banked(id), left)
			state.mix[id] = n
			left = left - n
		end
		UI.Refresh()
	end })
	toy(right, { Text = "RARE", Color = P.blue, Size = UDim2.fromOffset(98, 46), Position = UDim2.fromOffset(107, 0), TextSize = 20, ZIndex = 23, OnClick = function()
		-- only Rare, Epic and Legendary parts
		state.mix = {}
		local left = EconomyConfig.MaxBatch
		for i = #PartConfig.Order, 1, -1 do
			local id = PartConfig.Order[i]
			local rar = PartConfig.Parts[id].rarity
			if rar == "Rare" or rar == "Epic" or rar == "Legendary" then
				local n = math.min(store.Banked(id), left)
				state.mix[id] = n
				left = left - n
			end
		end
		UI.Refresh()
	end })
	toy(right, { Text = "CLEAR", Color = P.grey, Size = UDim2.fromOffset(98, 46), Position = UDim2.fromOffset(214, 0), TextSize = 18, ZIndex = 23, OnClick = function()
		state.mix = {}
		UI.Refresh()
	end })
	local odds = card(right, { Position = UDim2.fromOffset(0, 58), Size = UDim2.fromOffset(312, 196), Radius = 18, ZIndex = 23 })
	text(odds, { Text = "CHANCE PER CAR", TextSize = 18, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(14, 10), Size = UDim2.fromOffset(180, 22), ZIndex = 24 })
	-- all luck (Pit Stop, tokens, boosts, platform, gears) already applied to the odds below
	panels.oddsLuck = text(odds, { Text = "", TextSize = 16, TextColor3 = P.blue, Outline = false, Position = UDim2.fromOffset(158, 11), Size = UDim2.fromOffset(140, 22), TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 24 })
	-- recessed track; the coloured shares live in an inner strip (refresh clears that one, the track keeps its rim)
	local track = inset(odds, { Position = UDim2.fromOffset(14, 38), Size = UDim2.fromOffset(284, 16), Radius = 4, ZIndex = 24 })
	local bar = new("Frame", { Position = UDim2.fromOffset(2, 2), Size = UDim2.new(1, -4, 1, -4), BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 24 }, track)
	list(bar, Enum.FillDirection.Horizontal, 0)
	panels.oddsBar = bar
	panels.oddsLines = {}
	for i, r in ipairs(CarConfig.RarityOrder) do
		local dot = new("Frame", { Position = UDim2.fromOffset(14, 64 + (i - 1) * 22), Size = UDim2.fromOffset(12, 12), BackgroundColor3 = rarityColor(r), ZIndex = 24 }, odds)
		corner(dot, 6)
		panels.oddsLines[r] = text(odds, { Text = "", Font = BODY, TextSize = 15, TextColor3 = P.ink, RichText = true, Position = UDim2.fromOffset(34, 58 + (i - 1) * 22), Size = UDim2.fromOffset(260, 22), ZIndex = 24 })
	end
	panels.oddsText = text(odds, { Text = "", Font = BODY, TextSize = 14, TextColor3 = P.orange, Position = UDim2.fromOffset(14, 172), Size = UDim2.fromOffset(284, 20), ZIndex = 24 })
	-- how many cars this throw catches (Multi Catch): fewer cars = every car rolled on more points
	local carsRow = new("Frame", { Position = UDim2.fromOffset(0, 262), Size = UDim2.fromOffset(312, 32), BackgroundTransparency = 1, Visible = false, ZIndex = 23 }, right)
	text(carsRow, { Text = "CARS", TextSize = 16, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(0, 6), Size = UDim2.fromOffset(60, 20), ZIndex = 24 })
	panels.carsRow, panels.carsBtns = carsRow, {}
	for n = 1, EconomyConfig.MaxCatch do
		panels.carsBtns[n] = toy(carsRow, { Text = tostring(n), Color = P.grey, Size = UDim2.fromOffset(52, 32), Position = UDim2.fromOffset(64 + (n - 1) * 62, 0), TextSize = 18,
			Depth = 4, Radius = 10, ZIndex = 24, OnClick = function()
				state.cars = n
				UI.Refresh()
			end })
	end
	-- merge toggle
	local tg = new("TextButton", { Text = "", AutoButtonColor = false, Position = UDim2.fromOffset(0, 300), Size = UDim2.fromOffset(312, 44), BackgroundTransparency = 1, ZIndex = 23 }, right)
	local sw = new("Frame", { Position = UDim2.fromOffset(0, 7), Size = UDim2.fromOffset(52, 30), BackgroundColor3 = P.green, ZIndex = 24 }, tg)
	corner(sw, 15)
	stroke(sw, P.ink, 3)
	local knob = new("Frame", { Position = UDim2.fromOffset(25, 4), Size = UDim2.fromOffset(22, 22), BackgroundColor3 = P.white, ZIndex = 25 }, sw)
	corner(knob, 11)
	text(tg, { Text = "MERGE DUPLICATES", TextSize = 16, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(62, 2), Size = UDim2.fromOffset(250, 20), ZIndex = 24 })
	text(tg, { Text = string.format("Same car = +1 level (up to Lv%d)", EconomyConfig.MergeMaxLevel), Font = BODY, TextSize = 13, TextColor3 = P.muted, Position = UDim2.fromOffset(62, 22), Size = UDim2.fromOffset(250, 18), ZIndex = 24 })
	tg.Activated:Connect(function()
		state.merge = not state.merge
		UI.Sfx("click")
		UI.Refresh()
	end)
	panels.mergeSw, panels.mergeKnob = sw, knob
	panels.throwGo = toy(right, { Text = T("btn_throw"), Color = P.green, Size = UDim2.fromOffset(312, 80), Position = UDim2.fromOffset(0, 344), TextSize = 30, ZIndex = 23,
		OnClick = function()
			local total = mixTotal()
			if total &lt;= 0 then
				UI.Toast(T("n_noPart"), "error")
				return
			end
			local counts = {}
			for _, id in ipairs(PartConfig.Order) do
				local n = math.min(state.mix[id] or 0, store.Banked(id))
				if n &gt; 0 then
					counts[id] = n
				end
			end
			actions.ThrowBatch(counts, state.merge, state.cars)
			state.mix = {}
			UI.TogglePanel(nil)
		end })
end

-- turn the part previews while the throw menu is open
RunService.RenderStepped:Connect(function()
	if state.open ~= "throw" or not panels.partSpin then
		return
	end
	local a = os.clock() * 0.9
	for _, sp in ipairs(panels.partSpin) do
		local off = Vector3.new(math.cos(a), 0.55, math.sin(a)).Unit * sp.dist
		sp.cam.CFrame = CFrame.lookAt(sp.centre + off, sp.centre)
	end
end)

local function refreshThrow()
	local st = store.State
	if not st then
		return
	end
	local ready = store.BankedTotal()
	-- first open: preselect one of the best part so a single tap still works
	if mixTotal() == 0 and ready &gt; 0 and not state.mixTouched then
		for i = #PartConfig.Order, 1, -1 do
			local id = PartConfig.Order[i]
			if store.Banked(id) &gt; 0 then
				state.mix[id] = 1
				break
			end
		end
	end
	hud.throw.SetText(T("btn_throw"), ready &gt; 0 and string.format("%d parts ready", ready) or T("throw_none"))
	hud.throw.SetColor(ready &gt; 0 and P.yellow or P.grey)
	if not panels.throwRows or state.open ~= "throw" then
		return
	end
	state.mixTouched = true
	local lim = catchLimit()
	local total, points = 0, 0
	for id, row in pairs(panels.throwRows) do
		local own = store.Banked(id)
		local n = math.min(state.mix[id] or 0, own)
		total = total + n
		row.owned.Text = own &gt; 0 and string.format("%d owned", own) or "none owned"
		row.cnt.Text = tostring(n)
		row.cnt.TextColor3 = n &gt; 0 and P.ink or P.grey
		-- picked: full rarity band + bolder outline; not picked: faded band, normal outline (never lighter than the panel)
		row.band.BackgroundColor3 = n &gt; 0 and row.rc or row.rc:Lerp(P.inset, 0.7)
		row.stroke.Thickness = n &gt; 0 and 4 or 3
		row.img.ImageTransparency = own &gt; 0 and 0 or 0.55
		row.minus.SetColor(n &gt; 0 and P.red or P.grey)
		row.plus.SetColor(n &lt; own and P.green or P.grey)
		row.max.SetColor(own &gt; 0 and P.blue or P.grey)
		points = points + n * PartConfig.Parts[id].points
	end
	-- all parts add rarity points; the throw catches `cars` cars (1..limit), each rolled on points * limit / cars
	state.cars = math.clamp(state.cars or lim, 1, lim)
	local cars = state.cars
	local perCar = math.floor(points * lim / cars)
	panels.carsRow.Visible = lim &gt; 1
	for n, b in ipairs(panels.carsBtns) do
		b.holder.Visible = n &lt;= lim
		b.SetColor(n == cars and P.blue or P.grey)
	end
	panels.catchInfo.Text = string.format("&lt;b&gt;%d&lt;/b&gt; rarity points  ·  &lt;b&gt;%d&lt;/b&gt; car%s%s%s", points, cars, cars &gt; 1 and "s" or "",
		cars &lt; lim and string.format(" with &lt;b&gt;x%s&lt;/b&gt; points each", (lim / cars) % 1 == 0 and tostring(lim // cars) or string.format("%.1f", lim / cars)) or "",
		lim &lt; EconomyConfig.MaxCatch and "  ·  more with &lt;b&gt;Multi Catch&lt;/b&gt;" or "")
	local chances = CarConfig.ChancesForPoints(math.max(perCar, 1))
	local luck = tonumber(st.luckMult) or 1
	if CarConfig.ApplyLuck then
		chances = CarConfig.ApplyLuck(chances, luck)
	end
	panels.oddsLuck.Text = string.format("LUCK x%.2f", luck)
	panels.oddsLuck.TextColor3 = luck &gt; 1.001 and P.blue or P.grey
	local expected = {}
	for _, r in ipairs(CarConfig.RarityOrder) do
		expected[r] = total &gt; 0 and cars * chances[r] / 100 or 0
	end
	clear(panels.oddsBar)
	for i, r in ipairs(CarConfig.RarityOrder) do
		local share = total &gt; 0 and chances[r] / 100 or 0
		if share &gt; 0 then
			new("Frame", { Size = UDim2.new(math.max(share, 0.012), 0, 1, 0), BackgroundColor3 = rarityColor(r), BorderSizePixel = 0, LayoutOrder = i, ZIndex = 25 }, panels.oddsBar)
		end
		panels.oddsLines[r].Text = string.format("&lt;b&gt;%s&lt;/b&gt;  &lt;font color=\"#606674\"&gt;%s%%&lt;/font&gt;", T("rarity_" .. r), total &gt; 0 and (chances[r] &gt;= 10 and string.format("%.0f", chances[r]) or string.format("%.1f", chances[r])) or "0")
	end
	local pity = st.pity or 0
	local left = EconomyConfig.PityThreshold - pity
	panels.oddsText.Text = left &lt;= 1 and T("throw_pity_now") or T("throw_pity", left)
	panels.mergeSw.BackgroundColor3 = state.merge and P.green or P.grey
	panels.mergeKnob.Position = UDim2.fromOffset(state.merge and 25 or 3, 4)
	panels.throwGo.SetText(total &gt; 0 and string.format("THROW %d PARTS", total) or T("btn_throw"), nil)
	panels.throwGo.SetColor(total &gt; 0 and P.green or P.grey)
	panels.trapRefresh()
end

-- TELEPORT (also unlocks districts)
local function buildTeleport()
	local p = panelShell("teleport", T("tp_title"), 820, 560, P.blue)
	panels.tpGrid = new("ScrollingFrame", { Size = UDim2.new(1, 0, 1, -40), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 8, ScrollBarImageColor3 = P.ink,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 22 }, p.content)
	new("UIGridLayout", { CellSize = UDim2.fromOffset(240, 196), CellPadding = UDim2.fromOffset(16, 18), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }, panels.tpGrid)
	padding(panels.tpGrid, 8, 14) -- 3 x 240 + 2 x 16 = 752 of the 754 px inside: the first row's outlines no longer clip
	text(p.content, { Text = "⚠ " .. T("tp_walk"), Font = BODY, TextSize = 19, TextColor3 = P.red, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), ZIndex = 22 })
end

local function refreshTeleport()
	local st = store.State
	if not st or state.open ~= "teleport" then
		return
	end
	clear(panels.tpGrid)
	local function tile(order, title, icon, color, sub, onClick)
		local f = new("Frame", { BackgroundTransparency = 1, LayoutOrder = order, ZIndex = 22 }, panels.tpGrid)
		local t = toy(f, { Text = title, Icon = icon, Sub = sub, Color = color, Size = UDim2.fromOffset(240, 190), ZIndex = 23, SubSize = 17, OnClick = onClick })
		return t
	end
	tile(0, T("tp_home"), "🏠", P.orange, T("tp_home_desc"), function()
		actions.Teleport("home")
		UI.TogglePanel(nil)
	end)
	for i, zid in ipairs(MapConfig.ZoneOrder) do
		local zone = MapConfig.Zones[zid]
		local open = st.zones[zid] == true
		local prevOpen = i == 1 or st.zones[MapConfig.ZoneOrder[i - 1]] == true
		local req = EconomyConfig.ZoneUnlock[zid]
		local title = string.gsub(zone.name, " DISTRICT", "")
		local needReb = req and (req.rebirths or 0) &gt; (st.rebirths or 0)
		if not open and not prevOpen then
			break -- show only the next district to unlock, the rest stays a surprise
		end
		if open then
			tile(i, title, ZONE_ICON[zid], ZONE_COLOR[zid], T("zone_desc_" .. zid), function()
				actions.Teleport(zid)
				UI.TogglePanel(nil)
			end)
		else
			local can = prevOpen and req and not needReb and store.Money &gt;= req.cost and store.CollectionValue &gt;= req.minValue
			local sub = needReb and string.format(T("n_needRebirth"), req.rebirths)
				or string.format("🔒 $%s  ·  %s $%s", Util.FormatNumber(req.cost), T("zones_value"), Util.FormatNumber(req.minValue))
			local t = tile(i, can and (T("btn_unlock") .. "!") or title, "🔒", can and P.green or P.grey, sub, function()
				-- checked again at the click: income may have paid for it since the panel was drawn
				if prevOpen and req and not needReb and store.Money &gt;= req.cost and store.CollectionValue &gt;= req.minValue then
					actions.Unlock(zid)
				elseif needReb then
					UI.Toast(string.format(T("n_needRebirth"), req.rebirths), "warn")
				elseif prevOpen and store.CollectionValue &lt; req.minValue then
					UI.Toast(T("n_needValue"), "warn")
				elseif prevOpen then
					UI.Toast(T("n_noMoney"), "error")
				else
					UI.Toast(T("n_needPrev"), "warn")
				end
			end)
			if not can then
				t.holder.Size = UDim2.fromOffset(240, 190)
			end
		end
	end
end

-- GARAGE
-- confirmation popup (sell etc.)
local confirmDim
local function closeConfirm()
	if confirmDim then
		confirmDim:Destroy()
		confirmDim = nil
	end
end

function UI.Confirm(title, body, okText, okColor, onOk, def)
	closeConfirm() -- never two dialogs on top of each other
	if state.cine then
		return
	end
	local dim = new("TextButton", { Name = "Confirm", Text = "", AutoButtonColor = false, Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(0, 0, 0), BackgroundTransparency = 0.45, ZIndex = 85 }, overlay)
	-- v23: shared dialog shell (shadow + header strip in the action's colour); the card is a plain Frame as before,
	-- so a tap on it still reaches the dim behind (= KEEP)
	local box, shell = dialogShell(dim, { Size = UDim2.fromOffset(480, def and 416 or 276), ZIndex = 86, Color = okColor or P.red, HeadH = 60, Title = title, TitleSize = 30 })
	local sc = new("UIScale", { Scale = 0.6 }, shell)
	tween(sc, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	local y = 76
	if def then
		-- the car stands on a white card so it does not melt into the cream
		local stage = card(box, { Position = UDim2.fromOffset(90, 72), Size = UDim2.fromOffset(300, 136), Radius = 18, ZIndex = 87 })
		carViewport(stage, def, { Size = UDim2.fromScale(1, 1), ZIndex = 89 })
		y = 220
	end
	text(box, { Text = body, Font = BODY, TextSize = 20, TextColor3 = P.ink, RichText = true, TextWrapped = true, Position = UDim2.fromOffset(24, y), Size = UDim2.new(1, -48, 0, 70), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 87 })
	local btns = new("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -18), Size = UDim2.fromOffset(440, 70), BackgroundTransparency = 1, ZIndex = 87 }, box)
	list(btns, Enum.FillDirection.Horizontal, 16, Enum.HorizontalAlignment.Center)
	toy(btns, { Text = "KEEP", Color = P.grey, Size = UDim2.fromOffset(170, 66), TextSize = 24, LayoutOrder = 1, ZIndex = 88, OnClick = function() dim:Destroy() end })
	toy(btns, { Text = okText, Color = okColor or P.red, Size = UDim2.fromOffset(220, 66), TextSize = 24, LayoutOrder = 2, ZIndex = 88, OnClick = function()
		dim:Destroy()
		onOk()
	end })
	dim.Activated:Connect(function() dim:Destroy() end)
	confirmDim = dim
	UI.SetDialog(true)
	dim.Destroying:Connect(function()
		UI.SetDialog(false)
	end)
end

state.garageTab = "parked"
-- v25 simpler garage: one clear header line + PARK BEST / BUY SLOT, big PARKED / STORAGE tabs, SELL COMMONS on the
-- storage tab only. Rows are 100 px with a single main action (PARK or REMOVE) and UPGRADE with its price; tapping a
-- row (or "...") opens the car's detail card with GEAR, SELL and the stats. No small sub-labels anywhere.
local function buildGarage()
	local p = panelShell("garage", T("garage_title"), 940, 640, P.orange)
	local c = p.content
	panels.garageInfo = text(c, { Text = "", TextSize = 30, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(4, 0), Size = UDim2.new(1, -456, 0, 60), ZIndex = 22, RichText = true })
	panels.autoBtn = toy(c, { Text = T("btn_autopark"), Color = P.green, Size = UDim2.fromOffset(200, 64), TextSize = 24, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -236, 0, -2), ZIndex = 23,
		OnClick = function() actions.AutoPark() end })
	panels.slotBtn = toy(c, { Text = "BUY SLOT", Color = P.blue, Size = UDim2.fromOffset(226, 64), TextSize = 22, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, -2), ZIndex = 23,
		OnClick = function()
			local st = store.State
			if st.slots + 1 &gt; (st.floors or 1) * 6 then
				actions.BuyFloor(st.floors or 1)
			else
				actions.BuySlot(st.slots)
			end
		end })
	-- tabs; the one bulk sell (Commons) sits on the right of the same row, storage tab only
	local tabs = new("Frame", { Position = UDim2.fromOffset(0, 74), Size = UDim2.new(1, -260, 0, 62), BackgroundTransparency = 1, ZIndex = 22 }, c)
	list(tabs, Enum.FillDirection.Horizontal, 12)
	panels.garageTabs = {}
	for i, tab in ipairs({ "parked", "storage" }) do
		panels.garageTabs[tab] = toy(tabs, { Text = string.upper(tab), Color = P.grey, Size = UDim2.fromOffset(230, 60), TextSize = 26, LayoutOrder = i, ZIndex = 23, OnClick = function()
			state.garageTab = tab
			UI.Refresh()
		end })
	end
	panels.sellCommons = toy(c, { Text = "SELL COMMONS", Color = P.red, Size = UDim2.fromOffset(240, 60), TextSize = 22, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 74), ZIndex = 23,
		OnClick = function()
			local st = store.State
			local uids, total = {}, 0
			for _, car in ipairs(st.cars) do
				local def = CarConfig.ById[car.typeId]
				if not car.slot and def.rarity == "Common" and #uids &lt; 100 then
					table.insert(uids, car.uid)
					total = total + CarConfig.SellPrice(def, car.level)
				end
			end
			if #uids == 0 then
				UI.Toast("No Common cars in storage", "warn")
				return
			end
			UI.Confirm("SELL " .. #uids .. " CARS?", string.format("All Common cars in storage for &lt;b&gt;$%s&lt;/b&gt;.\nParked cars are never sold.", Util.FormatNumber(total)), "SELL ALL", P.red, function()
				actions.SellMany(uids)
			end)
		end })
	panels.carList = scroller(c, UDim2.fromOffset(0, 146), UDim2.new(1, 0, 1, -146))
end

local function sortedCars(st)
	local out = table.clone(st.cars)
	local now = store.ServerNow()
	table.sort(out, function(a, b)
		local ia = CarConfig.CarIncome(a, now)
		local ib = CarConfig.CarIncome(b, now)
		if ia ~= ib then
			return ia &gt; ib
		end
		return a.uid &lt; b.uid
	end)
	return out
end

local function freeSlot(st)
	local used, worst, worstInc = {}, nil, nil
	local now = store.ServerNow()
	for _, c in ipairs(st.cars) do
		if c.slot then
			used[c.slot] = true
			local inc = CarConfig.CarIncome(c, now)
			if not worstInc or inc &lt; worstInc then
				worst, worstInc = c.slot, inc
			end
		end
	end
	for i = 1, st.slots do
		if not used[i] then
			return i
		end
	end
	return worst or 1
end

-- the car's upgrade: nil at max level, else cost, part id, part amount and whether it can be paid now
local function upgradeInfo(st, def, c)
	if c.level &gt;= def.maxLevel then
		return nil
	end
	local ucost = CarConfig.UpgradeCost(def, c.level)
	local partId, amount = CarConfig.UpgradeParts(def, c.level)
	return ucost, partId, amount, store.Money &gt;= ucost and (st.parts[partId] or 0) &gt;= amount
end

-- car detail card (GEAR / SELL / UPGRADE / PARK or REMOVE + stats); one at a time, updated in place by refreshGarage.
-- It sits under the gear chooser (ZIndex 70) and the confirm dialog (85), which open on top of it.
local detail
local function closeDetail()
	if detail then
		local d = detail
		detail = nil
		d.dim:Destroy()
	end
end

local function updateDetail(st)
	if not detail then
		return
	end
	local c
	for _, car in ipairs(st.cars) do
		if car.uid == detail.uid then
			c = car
			break
		end
	end
	if not c then
		closeDetail() -- sold
		return
	end
	local def = CarConfig.ById[c.typeId]
	detail.car = c
	local rc = lift(rarityColor(def.rarity), -0.3):ToHex()
	local gearTag = UI.GearTag and UI.GearTag(c)
	detail.stats.Text = string.format(
		'RARITY  &lt;font color="#%s"&gt;%s&lt;/font&gt;\nLEVEL  %d / %d\nINCOME  &lt;font color="#1E9E40"&gt;+$%s/s&lt;/font&gt;\nSELL VALUE  $%s\nWHERE  %s\nGEAR  %s',
		rc, string.upper(T("rarity_" .. def.rarity)), c.level, def.maxLevel, Util.FormatNumber(CarConfig.CarIncome(c, store.ServerNow())),
		Util.FormatNumber(CarConfig.SellPrice(def, c.level)), c.slot and ("Bay " .. c.slot) or "Storage", gearTag or "none")
	local ucost, partId, amount, ok = upgradeInfo(st, def, c)
	if ucost then
		detail.upInfo.Text = string.format("Next level: $%s + %d %s", Util.FormatNumber(ucost), amount, T("part_" .. partId))
		detail.upBtn.SetText(T("btn_upgrade"), nil)
		detail.upBtn.SetColor(ok and P.blue or P.grey)
	else
		detail.upInfo.Text = "Max level reached"
		detail.upBtn.SetText(T("btn_max"), nil)
		detail.upBtn.SetColor(P.grey)
	end
	detail.mainBtn.SetText(c.slot and T("btn_remove") or T("btn_place"), nil)
	detail.mainBtn.SetColor(c.slot and P.orange or P.green)
	detail.gearBtn.SetColor(gearTag and P.cyan or P.yellow)
end

local function openDetail(uid)
	closeDetail()
	local st = store.State
	if not st or state.cine then
		return
	end
	local car
	for _, c in ipairs(st.cars) do
		if c.uid == uid then
			car = c
			break
		end
	end
	local def = car and CarConfig.ById[car.typeId]
	if not def then
		return
	end
	local dim = new("TextButton", { Name = "CarDetail", Text = "", AutoButtonColor = false, Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(0, 0, 0), BackgroundTransparency = 0.45, ZIndex = 62 }, overlay)
	local box, shell = dialogShell(dim, { Class = "TextButton", Size = UDim2.fromOffset(580, 540), ZIndex = 63, Color = rarityColor(def.rarity), HeadH = 60, Title = string.upper(def.name), TitleSize = 28 })
	local sc = new("UIScale", { Scale = 0.6 }, shell)
	tween(sc, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	toy(box, { Text = "X", Color = P.red, Size = UDim2.fromOffset(56, 60), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 12, 0, -16), ZIndex = 67, OnClick = closeDetail })
	local stage = card(box, { Position = UDim2.fromOffset(24, 76), Size = UDim2.fromOffset(250, 190), Radius = 18, ZIndex = 65 })
	carViewport(stage, def, { Size = UDim2.fromScale(1, 1), ZIndex = 67 })
	local stats = text(box, { Text = "", Font = BODY, TextSize = 19, TextColor3 = P.ink, RichText = true, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top,
		LineHeight = 1.15, Position = UDim2.fromOffset(292, 78), Size = UDim2.fromOffset(268, 196), ZIndex = 66 })
	local upInfo = text(box, { Text = "", Font = BODY, TextSize = 18, TextColor3 = P.muted, Position = UDim2.fromOffset(24, 300), Size = UDim2.new(1, -48, 0, 26),
		TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 66 })
	local btns = new("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -22), Size = UDim2.fromOffset(532, 160), BackgroundTransparency = 1, ZIndex = 66 }, box)
	new("UIGridLayout", { CellSize = UDim2.fromOffset(260, 70), CellPadding = UDim2.fromOffset(12, 14), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }, btns)
	local function cell(order)
		return new("Frame", { BackgroundTransparency = 1, LayoutOrder = order, ZIndex = 66 }, btns)
	end
	local d = { dim = dim, uid = uid, car = car, stats = stats, upInfo = upInfo }
	d.mainBtn = toy(cell(1), { Text = T("btn_place"), Color = P.green, Size = UDim2.fromOffset(260, 66), TextSize = 26, ZIndex = 67, OnClick = function()
		local s = store.State
		if d.car.slot then
			actions.Remove(d.car.uid)
		elseif s then
			actions.Place(d.car.uid, freeSlot(s))
		end
	end })
	d.upBtn = toy(cell(2), { Text = T("btn_upgrade"), Color = P.blue, Size = UDim2.fromOffset(260, 66), TextSize = 26, ZIndex = 67, OnClick = function()
		local cdef = CarConfig.ById[d.car.typeId]
		if cdef and d.car.level &lt; cdef.maxLevel then
			actions.Upgrade(d.car.uid, d.car.level)
		end
	end })
	d.gearBtn = toy(cell(3), { Text = T("gears_btn"), Color = P.yellow, Size = UDim2.fromOffset(260, 66), TextSize = 26, ZIndex = 67, OnClick = function()
		if UI.OnGear then
			UI.OnGear(d.car.uid) -- the gear chooser opens on top of this card
		end
	end })
	toy(cell(4), { Text = T("btn_sell"), Color = P.red, Size = UDim2.fromOffset(260, 66), TextSize = 26, ZIndex = 67, OnClick = function()
		local c = d.car
		local cdef = CarConfig.ById[c.typeId]
		local price = CarConfig.SellPrice(cdef, c.level)
		UI.Confirm("SELL THIS CAR?", string.format("&lt;b&gt;%s&lt;/b&gt;  Lv %d\nfor &lt;b&gt;$%s&lt;/b&gt;", cdef.name, c.level, Util.FormatNumber(price)), "SELL $" .. Util.FormatNumber(price), P.red, function()
			actions.Sell(c.uid)
		end, cdef)
	end })
	dim.Activated:Connect(closeDetail)
	detail = d
	UI.SetDialog(true)
	dim.Destroying:Connect(function()
		UI.SetDialog(false)
		if detail and detail.dim == dim then
			detail = nil
		end
	end)
	updateDetail(st)
end

local function refreshGarage()
	local st = store.State
	if not st or state.open ~= "garage" then
		closeDetail()
		return
	end
	local parked, stored = 0, 0
	for _, c in ipairs(st.cars) do
		if c.slot then
			parked = parked + 1
		else
			stored = stored + 1
		end
	end
	panels.garageInfo.Text = string.format('&lt;font color="#1E9E40"&gt;+$%s/s&lt;/font&gt;  ·  Bays %d/%d  ·  Cars %d', Util.FormatNumber(store.Income), parked, st.slots, #st.cars)
	local cost = EconomyConfig.SlotCosts[st.slots + 1]
	local floors = st.floors or 1
	if cost and st.slots + 1 &gt; floors * 6 then
		local fc = EconomyConfig.FloorCosts[floors + 1]
		panels.slotBtn.SetText("LEVEL " .. (floors + 1) .. "  $" .. Util.FormatNumber(fc), nil)
		panels.slotBtn.SetColor(store.Money &gt;= fc and P.orange or P.grey)
	elseif cost then
		panels.slotBtn.SetText("BUY SLOT  $" .. Util.FormatNumber(cost), nil)
		panels.slotBtn.SetColor(store.Money &gt;= cost and P.blue or P.grey)
	else
		panels.slotBtn.SetText("SLOTS " .. T("btn_max"), nil)
		panels.slotBtn.SetColor(P.grey)
	end
	local tab = state.garageTab
	panels.garageTabs.parked.SetText(string.format("PARKED %d", parked), nil)
	panels.garageTabs.storage.SetText(string.format("STORAGE %d", stored), nil)
	panels.garageTabs.parked.SetColor(tab == "parked" and P.orange or P.grey)
	panels.garageTabs.storage.SetColor(tab == "storage" and P.orange or P.grey)
	panels.sellCommons.holder.Visible = tab == "storage"
	updateDetail(st)
	clear(panels.carList)
	panels.gearBtns = {}
	local cars = {}
	for _, car in ipairs(sortedCars(st)) do
		if (tab == "parked") == (car.slot ~= nil) then
			table.insert(cars, car)
		end
	end
	if #cars == 0 then
		local msg = #st.cars == 0 and T("garage_empty") or (tab == "parked" and "No cars parked. Open STORAGE and press PARK." or "Storage is empty. Cars you REMOVE from the garage wait here.")
		text(panels.carList, { Text = msg, Font = BODY, TextSize = 20, TextColor3 = P.muted, TextWrapped = true, Size = UDim2.new(1, 0, 0, 60), ZIndex = 23 })
		return
	end
	local now = store.ServerNow()
	for i, c in ipairs(cars) do
		local def = CarConfig.ById[c.typeId]
		local rc = rarityColor(def.rarity)
		-- the whole row is a button: a tap opens the detail card (the toy buttons on it take their own taps)
		local row, _, face = card(panels.carList, { Class = "TextButton", Size = UDim2.new(1, 0, 0, 100), Accent = rc, Radius = 18, LayoutOrder = i, ZIndex = 23 })
		face.Activated:Connect(function()
			UI.Sfx("click")
			openDetail(c.uid)
		end)
		if i &lt;= 24 then
			carViewport(row, def, { Position = UDim2.fromOffset(8, 6), Size = UDim2.fromOffset(136, 88), ZIndex = 24 })
		end
		text(row, { Text = def.name, TextSize = 24, TextColor3 = P.ink, Outline = false, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(154, 6), Size = UDim2.fromOffset(300, 30), ZIndex = 24 })
		local chips = new("Frame", { Position = UDim2.fromOffset(154, 39), Size = UDim2.fromOffset(300, 28), BackgroundTransparency = 1, ZIndex = 24 }, row)
		list(chips, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
		pill(chips, string.upper(T("rarity_" .. def.rarity)), lift(rc, -0.15), { H = 26, TextSize = 17, LayoutOrder = 1 })
		pill(chips, "Lv " .. c.level, P.blue, { H = 26, TextSize = 17, LayoutOrder = 2 })
		-- v24 gears: a small "x2 4:12" chip while a gear runs (ticked every second by UI.TickGarageGears)
		local gearTag = UI.GearTag and UI.GearTag(c)
		local gearChip, gearLabel = pill(chips, gearTag or "", P.cyan, { H = 26, TextSize = 17, LayoutOrder = 3 })
		gearChip.Visible = gearTag ~= nil
		panels.gearBtns[c.uid] = { car = c, chip = gearChip, label = gearLabel }
		text(row, { Text = "+$" .. Util.FormatNumber(CarConfig.CarIncome(c, now)) .. "/s", Font = BODY, TextSize = 20, TextColor3 = C(30, 158, 64), Position = UDim2.fromOffset(154, 70),
			Size = UDim2.fromOffset(300, 26), ZIndex = 24 })
		local btns = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(420, 70), BackgroundTransparency = 1, ZIndex = 24 }, row)
		list(btns, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
		if c.slot then
			toy(btns, { Text = T("btn_remove"), Color = P.orange, Size = UDim2.fromOffset(120, 64), TextSize = 20, LayoutOrder = 1, ZIndex = 25, OnClick = function() actions.Remove(c.uid) end })
		else
			toy(btns, { Text = T("btn_place"), Color = P.green, Size = UDim2.fromOffset(120, 64), TextSize = 22, LayoutOrder = 1, ZIndex = 25, OnClick = function() actions.Place(c.uid, freeSlot(st)) end })
		end
		local ucost, _, _, ok = upgradeInfo(st, def, c)
		if ucost then
			toy(btns, { Text = T("btn_upgrade") .. "  $" .. Util.FormatNumber(ucost), Color = ok and P.blue or P.grey, Size = UDim2.fromOffset(212, 64), TextSize = 18, LayoutOrder = 2, ZIndex = 25,
				OnClick = function() actions.Upgrade(c.uid, c.level) end })
		else
			toy(btns, { Text = T("btn_max"), Color = P.grey, Size = UDim2.fromOffset(212, 64), TextSize = 22, LayoutOrder = 2, ZIndex = 25 })
		end
		toy(btns, { Name = "More", Text = "...", Color = P.yellow, Size = UDim2.fromOffset(64, 64), TextSize = 26, LayoutOrder = 3, ZIndex = 25, OnClick = function() openDetail(c.uid) end })
	end
end

-- v24: the gear chips' countdowns, every second while the garage is open (no list rebuild)
function UI.TickGarageGears()
	if state.open ~= "garage" or not panels.gearBtns then
		return
	end
	for _, e in pairs(panels.gearBtns) do
		local tag = UI.GearTag and UI.GearTag(e.car)
		e.chip.Visible = tag ~= nil
		e.label.Text = tag or ""
	end
	if detail and store.State then
		updateDetail(store.State)
	end
end

-- CARS index
local function buildIndex()
	local p = panelShell("index", T("index_title"), 900, 580, P.green)
	panels.indexInfo = text(p.content, { Text = "", Font = BODY, TextSize = 19, TextColor3 = P.ink, Size = UDim2.new(1, 0, 0, 26), ZIndex = 22 })
	local s = new("ScrollingFrame", { Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 1, -34), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 8,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 22 }, p.content)
	-- 4 x 196 + 3 x 12 = 820 of the 834 px inside the padding; +8 px height for the rarity strip and the shadow slab
	new("UIGridLayout", { CellSize = UDim2.fromOffset(196, 158), CellPadding = UDim2.fromOffset(12, 12), SortOrder = Enum.SortOrder.LayoutOrder }, s)
	padding(s, 8, 14)
	panels.indexGrid = s
	panels.indexCards = {}
end

local function refreshIndex()
	local st = store.State
	if not st or state.open ~= "index" then
		return
	end
	local found, total, _, mult = CarConfig.IndexStats(st.discovered or {})
	panels.indexInfo.Text = T("index_found", found, total) .. "   ·   " .. T("index_bonus", string.format("%.2f", mult)) .. "   ·   " .. T("index_hint")
	for i, def in ipairs(CarConfig.List) do
		local known = st.discovered and st.discovered[def.id]
		local cd = panels.indexCards[def.id]
		if not cd or cd.known ~= known then
			if cd then
				cd.frame:Destroy()
			end
			local rc = rarityColor(def.rarity)
			-- v23: ink outline + shadow; the rarity is a strip along the top
			local f, holder = card(panels.indexGrid, { Color = known and P.card or C(60, 64, 76), Accent = rc, AccentTop = true, Radius = 18, LayoutOrder = i, ZIndex = 23 })
			if known then
				carViewport(f, def, { Size = UDim2.new(1, 0, 1, -44), ZIndex = 24 })
			else
				text(f, { Text = "?", TextSize = 70, Size = UDim2.new(1, 0, 1, -44), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = rc, ZIndex = 24 })
			end
			text(f, { Text = known and def.name or T("index_unknown"), TextSize = 17, TextColor3 = known and P.ink or P.white, Outline = false, AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.new(0, 0, 1, -20), Size = UDim2.new(1, 0, 0, 22), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
			-- darker rarity tone on the white card (the light Common / Legendary hues washed out); bright on the dark one
			text(f, { Text = string.upper(T("rarity_" .. def.rarity)), Font = BODY, TextSize = 14, TextColor3 = known and lift(rc, -0.3) or rc, AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.new(0, 0, 1, -2), Size = UDim2.new(1, 0, 0, 18), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
			panels.indexCards[def.id] = { frame = holder, known = known }
		end
	end
end

function UI.TogglePanel(name)
	if name ~= nil and state.cine then
		return -- no menus over a cinematic
	end
	if name ~= nil and state.open == name then
		name = nil
	end
	closeConfirm()
	for n, p in pairs(panels) do
		if type(p) == "table" and p.root and p.scale then
			if n == name then
				p.root.Visible = true
				p.scale.Scale = 0.6
				tween(p.scale, 0.28, { Scale = 1 }, Enum.EasingStyle.Back)
			else
				p.root.Visible = false
			end
		end
	end
	state.open = name
	if name then
		UI.Sfx("open")
	end
	hud.banner.Visible = name == nil -- a panel shows its own title; the top lane stays free for the tutorial card
	noteLayout()
	pcall(function() -- world prompts (E/F at the garage, NPCs) only when no panel is open
		game:GetService("ProximityPromptService").Enabled = name == nil and not state.cine
	end)
	UI.Refresh()
end

-- Cinematic mode (car drop, batch reveal): the whole HUD hides, open panels close and cannot open,
-- proximity prompts and movement are off. Calls are counted, every SetCinematic(true) has one SetCinematic(false).
local cineDepth = 0
function UI.SetCinematic(on)
	cineDepth = math.max(0, cineDepth + (on and 1 or -1))
	local active = cineDepth &gt; 0
	if (state.cine == true) == active then
		return
	end
	state.cine = active
	root.Visible = not active
	hud.toasts.Visible = not active
	Players.LocalPlayer:SetAttribute("Cinematic", active) -- world helpers (guide beam) hide too
	pcall(function()
		game:GetService("ProximityPromptService").Enabled = not active and state.open == nil
	end)
	if active then
		-- a failing hook must never leave the game half in cinematic mode
		pcall(UI.CloseOverlays)
		pcall(UI.TogglePanel, nil) -- closing is allowed in cinematic mode, opening is not
	end
	pcall(function()
		local pm = require(Players.LocalPlayer:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
		local controls = pm:GetControls()
		if active then
			controls:Disable()
		else
			controls:Enable()
		end
	end)
	if not active then
		pcall(UI.Refresh)
	end
end

function UI.IsCinematic()
	return state.cine == true
end

-- other modules register closers for their own pop-ups (trade request card, confirm dialogs, ...)
UI.Overlays = { closeConfirm, closeDetail }
function UI.CloseOverlays()
	for _, fn in ipairs(UI.Overlays) do
		pcall(fn)
	end
end

---------------------------------------------------------------- reveal
-- v22 "WOW" reveal: build-up (black silhouette hovering over a shaking disc, pulsing "?", energy rings pulled in,
-- the badge climbing the rarity tiers faster and faster) -&gt; impact (flash, the car lights up and drops onto the
-- disc, shockwaves, confetti + stars, box shake, rays spin up) -&gt; name pops letter by letter, income counts up,
-- NEW! stamp slams in last. Longer and bigger the rarer the car (Common ~1.5 s build-up, Legendary ~3.1 s).
local MYSTERY = C(206, 212, 228)
local REVEAL_AMBIENT, REVEAL_LIGHT = C(200, 200, 210), C(255, 250, 240)
local GOLD = C(255, 200, 70)
local CAR_AT = UDim2.fromOffset(350, 236) -- centre of the car in the box
local DISC_AT = UDim2.fromOffset(350, 352)

local function buildReveal()
	-- showcase: blurred world, rarity backdrop with turning rays + light streaks, car spinning on a glowing turntable
	local r = new("TextButton", { Name = "Reveal", Text = "", AutoButtonColor = false, Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(6, 7, 12), BackgroundTransparency = 0, Visible = false, ZIndex = 60 }, overlay)
	local glow = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.48), Size = UDim2.fromScale(1.4, 1.4), BackgroundColor3 = P.yellow, BackgroundTransparency = 0, BorderSizePixel = 0, ZIndex = 60 }, r)
	new("UIAspectRatioConstraint", {}, glow)
	corner(glow, 2000)
	local glowGrad = new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(0.5, 0.85), NumberSequenceKeypoint.new(1, 1) }), Rotation = 90 }, glow)
	local rays = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Size = UDim2.fromOffset(10, 10), BackgroundTransparency = 1, ZIndex = 60 }, r)
	for k = 0, 11 do
		local ray = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(2000, 60), Rotation = k * 15, BackgroundColor3 = P.yellow, BackgroundTransparency = 0.8, BorderSizePixel = 0, ZIndex = 60 }, rays)
		new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.2), NumberSequenceKeypoint.new(1, 1) }) }, ray)
	end
	-- light streaks sweeping across + floating sparkles
	local streaks, sparks = {}, {}
	for k = 1, 3 do
		local st = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0.5, 0, 0, 6 + k * 3), Rotation = -18, BackgroundColor3 = C(255, 255, 255), BackgroundTransparency = 0.6, BorderSizePixel = 0, ZIndex = 61 }, r)
		new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) }) }, st)
		streaks[k] = st
	end
	for k = 1, 26 do
		local sp = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(6, 6), BackgroundColor3 = C(255, 255, 255), BorderSizePixel = 0, ZIndex = 61 }, r)
		corner(sp, 3)
		sparks[k] = { f = sp, x = math.random(), y = math.random(), v = 0.03 + math.random() * 0.06, s = 3 + math.random() * 7 }
	end
	-- Legendary: gold glow along the screen edges (pulses)
	local rim = new("Frame", { Name = "Rim", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, ZIndex = 61 }, r)
	local rimEdges = {}
	for _, e in ipairs({
		{ UDim2.fromScale(0, 0), UDim2.new(1, 0, 0, 110), 90, Vector2.zero },
		{ UDim2.fromScale(0, 1), UDim2.new(1, 0, 0, 110), -90, Vector2.new(0, 1) },
		{ UDim2.fromScale(0, 0), UDim2.new(0, 110, 1, 0), 0, Vector2.zero },
		{ UDim2.fromScale(1, 0), UDim2.new(0, 110, 1, 0), 180, Vector2.new(1, 0) },
	}) do
		local f = new("Frame", { AnchorPoint = e[4], Position = e[1], Size = e[2], BackgroundColor3 = GOLD, BorderSizePixel = 0, ZIndex = 61 }, rim)
		new("UIGradient", { Transparency = NumberSequence.new(0, 1), Rotation = e[3] }, f)
		table.insert(rimEdges, f)
	end
	local box = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(700, 640), BackgroundTransparency = 1, ZIndex = 61 }, r)
	local sc = new("UIScale", {}, box)
	local top = text(box, { Text = T("reveal_new"), TextSize = 34, Size = UDim2.new(1, 0, 0, 40), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 62 })
	local badge = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 46), Size = UDim2.fromOffset(330, 54), BackgroundColor3 = P.white, ZIndex = 62 }, box)
	corner(badge, 27)
	stroke(badge, P.ink, 4)
	local badgeGrad = gradient(badge, P.yellow)
	local badgeScale = new("UIScale", {}, badge)
	-- Epic+: a shine stripe runs over the badge (same rounded shape, transparent but for the moving band)
	local badgeShine = new("Frame", { Name = "Shine", Size = UDim2.fromScale(1, 1), BackgroundColor3 = P.white, BorderSizePixel = 0, Visible = false, ZIndex = 62 }, badge)
	corner(badgeShine, 27)
	local badgeShineGrad = new("UIGradient", { Transparency = RevealFx.ShineBand(0.25, 0.1), Rotation = 20 }, badgeShine)
	local rarity = text(badge, { Text = "", TextSize = 36, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 63, Outline = 3 })
	-- turntable: glowing ellipse under the car
	local disc = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = DISC_AT, Size = UDim2.fromOffset(470, 90), BackgroundColor3 = P.yellow, BorderSizePixel = 0, ZIndex = 61 }, box)
	corner(disc, 200)
	new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(0.5, 0.25), NumberSequenceKeypoint.new(1, 0.9) }) }, disc)
	local ring = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = DISC_AT, Size = UDim2.fromOffset(420, 70), BackgroundTransparency = 1, ZIndex = 61 }, box)
	corner(ring, 200)
	local ringStroke = stroke(ring, P.white, 4)
	local vpHolder = new("Frame", { Position = UDim2.fromOffset(40, 106), Size = UDim2.fromOffset(620, 300), BackgroundTransparency = 1, ZIndex = 62 }, box)
	-- the pulsing "?" over the silhouette (TextSize tops out at 100: a UIScale makes it bigger)
	local q = text(box, { Text = "?", TextSize = 100, NoFit = true, AnchorPoint = Vector2.new(0.5, 0.5), Position = CAR_AT, Size = UDim2.fromOffset(120, 120), TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center, Outline = 5, ZIndex = 63, Visible = false })
	local qScale = new("UIScale", { Scale = 1.6 }, q)
	local name = text(box, { Text = "", TextSize = 64, Position = UDim2.fromOffset(0, 410), Size = UDim2.new(1, 0, 0, 70), TextXAlignment = Enum.TextXAlignment.Center, Outline = 4, ZIndex = 62 })
	local nameScale = new("UIScale", {}, name)
	local nameGrad = new("UIGradient", { Enabled = false, Rotation = 12 }, name) -- Epic+: shine sweep over the letters
	local info = text(box, { Text = "", Font = BODY, TextSize = 24, Position = UDim2.fromOffset(0, 482), Size = UDim2.new(1, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Center, RichText = true, ZIndex = 62 })
	local stamp = text(box, { Text = "NEW!", TextSize = 46, TextColor3 = P.yellow, Rotation = -14, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(600, 120), Size = UDim2.fromOffset(160, 60), TextXAlignment = Enum.TextXAlignment.Center, Outline = 4, ZIndex = 64, Visible = false })
	local stampScale = new("UIScale", {}, stamp)
	local ok = toy(box, { Text = T("btn_awesome"), Color = P.green, Size = UDim2.fromOffset(300, 86), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), ZIndex = 63,
		OnClick = function() UI.HideReveal() end })
	local okScale = new("UIScale", {}, ok.holder)
	-- impact flash over everything
	local flash = new("Frame", { Name = "Flash", Size = UDim2.fromScale(1, 1), BackgroundColor3 = P.white, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 70 }, r)
	panels.reveal = { root = r, rays = rays, box = box, sc = sc, top = top, badge = badge, badgeGrad = badgeGrad, badgeScale = badgeScale, badgeShine = badgeShine,
		badgeShineGrad = badgeShineGrad, rarity = rarity, vpHolder = vpHolder, name = name, nameScale = nameScale, nameGrad = nameGrad, info = info, ok = ok, okScale = okScale,
		glow = glow, glowGrad = glowGrad, disc = disc, ringStroke = ringStroke, streaks = streaks, sparks = sparks, stamp = stamp, stampScale = stampScale,
		q = q, qScale = qScale, flash = flash, rim = rim, rimEdges = rimEdges, closableAt = 0 }
	r.Activated:Connect(function()
		-- tap anywhere closes, but never before the car is revealed (impact + 0.5 s; also eats the tap meant for the throw)
		if os.clock() &gt;= (panels.reveal.closableAt or 0) then
			UI.HideReveal()
		end
	end)
end

-- ends the running reveal session: every connection, tween, particle burst and effect layer goes
local function endReveal(rv)
	local s = rv.sess
	if not s then
		return
	end
	rv.sess = nil
	for _, c in ipairs(s.conns) do
		c:Disconnect()
	end
	for _, x in ipairs(s.tweens) do
		x:Cancel()
	end
	for _, fn in ipairs(s.stops) do
		pcall(fn)
	end
	s.back:Destroy()
	s.front:Destroy()
	rv.flash.BackgroundTransparency = 1
	rv.rim.Visible = false
	rv.box.Position = UDim2.fromScale(0.5, 0.5)
	rv.badge.Rotation = 0
	rv.disc.Position = DISC_AT
end

function UI.HideReveal()
	local rv = panels.reveal
	endReveal(rv)
	if rv.root.Visible then
		rv.root.Visible = false
		clear(rv.vpHolder) -- frees the showcase car
		if rv.blur then
			rv.blur:Destroy()
			rv.blur = nil
		end
		local cb = rv.onClosed
		rv.onClosed = nil
		if cb then
			cb()
		end
	end
end

function UI.ShowReveal(res, onClosed)
	local rv = panels.reveal
	local def = CarConfig.ById[res.typeId]
	if not def then
		return
	end
	-- a reveal still running: end it first; whoever waited for that one is told it closed
	endReveal(rv)
	local prev = rv.onClosed
	rv.onClosed = onClosed
	if prev and prev ~= onClosed then
		task.spawn(prev)
	end
	local rc = rarityColor(res.rarity)
	local lvl = CarConfig.Rarities[res.rarity].index
	local shakeK = Players.LocalPlayer:GetAttribute("Opt_shake") == false and 0 or 1
	-- build-up: Common 1.5 s, Uncommon 1.9, Rare 2.3, Epic 2.7, Legendary 3.1 (a faster trap pass trims it a little)
	local buildT = math.max(1, (1.1 + 0.4 * lvl) / math.sqrt(math.max(1, res.speed or 1)))
	local carName = string.upper(def.name)
	local income = CarConfig.IncomeAt(def, 1)
	local rest = {}
	table.insert(rest, (res.merged and string.format("Merged into your copy - now Lv %d", res.merged))
		or (res.sold and string.format("Garage full - sold for $%s", Util.FormatNumber(res.sold)))
		or (res.slot and T("reveal_placed", res.slot)) or T("reveal_stored"))
	if res.isNew and res.bonus and res.bonus &gt; 0 then
		table.insert(rest, T("reveal_first", Util.FormatNumber(res.bonus)))
	end
	if res.pityUsed then
		table.insert(rest, T("reveal_pity"))
	end
	local function infoText(v)
		local parts = { string.format('&lt;font color="#34D058"&gt;+%s/s&lt;/font&gt;', Util.FormatNumber(v)) }
		for _, l in ipairs(rest) do
			table.insert(parts, l)
		end
		return table.concat(parts, "  ·  ")
	end

	local s = { conns = {}, tweens = {}, stops = {}, t0 = os.clock(), tint = MYSTERY }
	s.back = new("Frame", { Name = "FxBack", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 61 }, rv.box)
	s.front = new("Frame", { Name = "FxFront", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 66 }, rv.box)
	rv.sess = s
	local function live()
		return rv.sess == s
	end
	local function stw(o, t, props, style, dir)
		local x = tween(o, t, props, style, dir)
		table.insert(s.tweens, x)
		return x
	end
	local function later(d, fn)
		task.delay(d, function()
			if live() then
				fn()
			end
		end)
	end
	-- the whole scene takes the colour of the current tier (neutral silver while it is still "?")
	local function tint(c)
		s.tint = c
		for _, ray in ipairs(rv.rays:GetChildren()) do
			ray.BackgroundColor3 = c
		end
		rv.glow.BackgroundColor3 = c
		rv.disc.BackgroundColor3 = c
		rv.ringStroke.Color = lift(c, 0.4)
		rv.badgeGrad.Color = ColorSequence.new(lift(c, 0.35), c)
		rv.q.TextColor3 = lift(c, 0.55)
	end

	-- reset everything a previous reveal may have left
	rv.top.Text = "WHAT DID YOU CATCH?"
	rv.rarity.Text = "?  ?  ?"
	rv.badgeScale.Scale = 1
	rv.badge.Rotation = 0
	rv.badgeShine.Visible = false
	rv.name.Text = carName
	rv.name.MaxVisibleGraphemes = 0
	rv.name.TextColor3 = rc
	rv.nameScale.Scale = 1
	rv.nameGrad.Enabled = false
	rv.info.Text = ""
	rv.info.TextTransparency = 1
	rv.stamp.Visible = false
	rv.stampScale.Scale = 1
	rv.ok.holder.Visible = false
	rv.okScale.Scale = 1
	rv.q.Visible = true
	rv.qScale.Scale = 1.6
	rv.flash.BackgroundColor3 = P.white
	rv.flash.BackgroundTransparency = 1
	rv.rim.Visible = false
	rv.glow.BackgroundTransparency = 0.55
	rv.closableAt = math.huge
	for _, sp in ipairs(rv.sparks) do
		sp.f.BackgroundColor3 = P.white
	end
	tint(MYSTERY)

	-- the car: a black silhouette until the impact (ImageColor3 black hides even neon parts)
	clear(rv.vpHolder)
	rv.vpHolder.Position = UDim2.fromOffset(40, 51)
	local vp, model = carViewport(rv.vpHolder, def, { Size = UDim2.fromScale(1, 1), ZIndex = 62 })
	vp.ImageColor3 = C(0, 0, 0)
	vp.Ambient = C(0, 0, 0)
	vp.LightColor = C(0, 0, 0)
	-- safety: CarPreload has normally downloaded this car already; the impact waits (max 0.8 s) if it has not
	task.spawn(function()
		pcall(function()
			ContentProvider:PreloadAsync({ model })
		end)
		s.modelReady = true
	end)
	if not rv.blur then
		rv.blur = new("BlurEffect", { Name = "RevealBlur", Size = 0 }, game:GetService("Lighting"))
		tween(rv.blur, 0.35, { Size = 22 })
	end
	rv.root.Visible = true
	rv.shownAt = os.clock()
	rv.sc.Scale = 0.2
	stw(rv.sc, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	UI.Sfx("charge")

	-- per frame: rays, glow, streaks, sparks, turntable, hover/drop, shakes
	local rayAngle, camA = 0, math.rad(35)
	table.insert(s.conns, RunService.RenderStepped:Connect(function(dt)
		local now = os.clock()
		local t = now - s.t0
		local imp = s.impact
		local f = imp and 1 or math.clamp(t / buildT, 0, 1)
		local since = imp and (now - imp) or 0
		local base = 18 + lvl * 4
		rayAngle = (rayAngle + (imp and (base + 900 * math.exp(-since * 2.5)) or (10 + f * 110)) * dt) % 360
		rv.rays.Rotation = rayAngle
		local g = imp and (1.3 + math.sin(t * 2) * 0.05) or (1.2 + f * 0.1 + math.sin(t * (6 + f * 8)) * (0.02 + f * 0.04))
		rv.glow.Size = UDim2.fromScale(g, g)
		for k, st in ipairs(rv.streaks) do
			local ph = ((t * (0.35 + k * 0.12)) + k * 0.33) % 1.6 - 0.3
			st.Position = UDim2.fromScale(ph, 0.25 + k * 0.18)
		end
		local rise = imp and (1 + lvl * 0.3) or (0.6 + f * 2.5) -- sparkles get sucked up during the build-up
		for _, sp in ipairs(rv.sparks) do
			sp.y = sp.y - sp.v * dt * rise
			if sp.y &lt; -0.05 then
				sp.y, sp.x = 1.05, math.random()
			end
			sp.f.Position = UDim2.fromScale(sp.x + math.sin(t + sp.s) * 0.01, sp.y)
			sp.f.Size = UDim2.fromOffset(sp.s, sp.s)
			sp.f.BackgroundTransparency = 0.2 + 0.6 * math.abs(math.sin(t * 3 + sp.s))
		end
		if rv.stamp.Visible then
			rv.stamp.Rotation = -14 + math.sin(t * 4) * 4
		end
		-- turntable: slow while hidden, a fast spin on impact that settles
		camA = camA + (imp and (0.9 + 2.6 * math.exp(-since * 1.8)) or 0.35) * dt
		if model.Parent then
			fitCamera(vp, model, camA)
		end
		-- hover (trembling more and more) -&gt; drop onto the disc with a bounce
		local x, y
		if imp then
			local a = math.clamp(since / 0.55, 0, 1)
			x, y = 0, -55 * (1 - TweenService:GetValue(a, Enum.EasingStyle.Bounce, Enum.EasingDirection.Out))
		else
			local j = f * f * 5 * shakeK
			x, y = (math.random() - 0.5) * j, -55 + math.sin(t * 3) * 5 + (math.random() - 0.5) * j
		end
		rv.vpHolder.Position = UDim2.fromOffset(40 + x, 106 + y)
		local dj = imp and 0 or f * (4 + lvl) * shakeK
		rv.disc.Position = UDim2.fromOffset(350 + (math.random() - 0.5) * dj, 352 + (math.random() - 0.5) * dj * 0.5)
		if rv.q.Visible then
			rv.qScale.Scale = 1.6 * (1 + (0.08 + f * 0.1) * math.sin(t * (5 + f * 12)))
		end
		-- box shake after the impact (and a small kick for the NEW! stamp)
		local bm = imp and (10 + lvl * 3) * math.exp(-since * 7) or 0
		if s.kickAt then
			bm = bm + 6 * math.exp(-(now - s.kickAt) * 9)
		end
		bm = bm * shakeK
		rv.box.Position = UDim2.new(0.5, (math.random() - 0.5) * 2 * bm, 0.5, (math.random() - 0.5) * 2 * bm)
		if s.badgeAt then
			local e = now - s.badgeAt
			rv.badge.Rotation = math.sin(e * 50) * 8 * math.exp(-e * 8) * shakeK
		end
		if rv.rim.Visible then
			local p = 0.15 + 0.3 * (0.5 + 0.5 * math.sin(t * 3.2))
			for _, e in ipairs(rv.rimEdges) do
				e.BackgroundTransparency = p
			end
		end
	end))

	-- energy rings pulled into the car, faster towards the impact
	task.spawn(function()
		while live() and not s.impact do
			local f = math.clamp((os.clock() - s.t0) / buildT, 0, 1)
			RevealFx.Implode(s.front, { pos = CAR_AT, color = s.tint, dur = 0.6 - f * 0.2, thick = 4 + f * 6, from = Vector2.new(620, 620), to = Vector2.new(40, 40) })
			task.wait(math.max(0.12, 0.42 - f * 0.3))
		end
	end)

	-- timeline
	task.spawn(function()
		-- 1) tier climb: two "?" ticks, then every rarity below the real one, each tick faster; the real one lands on impact
		local steps = { false, false }
		for i = 1, lvl - 1 do
			table.insert(steps, CarConfig.RarityOrder[i])
		end
		local ratio, m = 0.78, #steps
		local first = (buildT - 0.2) * (1 - ratio) / (1 - ratio ^ m)
		task.wait(0.2)
		for j, step in ipairs(steps) do
			if not live() then
				return
			end
			rv.rarity.Text = step and string.upper(T("rarity_" .. step)) or "?  ?  ?"
			tint(step and rarityColor(step) or MYSTERY)
			rv.badgeScale.Scale = 1.18
			stw(rv.badgeScale, 0.12, { Scale = 1 })
			UI.Sfx("click")
			task.wait(first * ratio ^ (j - 1))
		end
		local w0 = os.clock()
		while live() and not s.modelReady and os.clock() - w0 &lt; 0.8 do
			task.wait(0.05)
		end
		if not live() then
			return
		end

		-- 2) impact
		s.impact = os.clock()
		rv.closableAt = s.impact + 0.5
		tint(rc)
		for _, sp in ipairs(rv.sparks) do
			sp.f.BackgroundColor3 = math.random() &lt; 0.5 and rc or P.white
		end
		rv.top.Text = res.isNew and T("reveal_new") or T("reveal_got")
		UI.Sfx(lvl &gt;= 4 and "revealBig" or "reveal")
		rv.flash.BackgroundTransparency = 0
		stw(rv.flash, 0.5, { BackgroundTransparency = 1 })
		rv.q.Visible = false
		stw(vp, 0.35, { ImageColor3 = P.white, Ambient = REVEAL_AMBIENT, LightColor = REVEAL_LIGHT })
		stw(rv.glow, 0.3, { BackgroundTransparency = 0 })
		rv.rarity.Text = "★ " .. string.upper(T("rarity_" .. res.rarity)) .. " ★"
		rv.badgeScale.Scale = 2
		stw(rv.badgeScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		s.badgeAt = os.clock()
		-- shockwaves: two flat rings across the turntable, a round one from the car for Epic+
		RevealFx.Shockwave(s.back, { pos = DISC_AT, from = Vector2.new(120, 24), to = Vector2.new(1100, 230), dur = 0.75, color = rc, thick = 12 })
		RevealFx.Shockwave(s.back, { pos = DISC_AT, from = Vector2.new(80, 16), to = Vector2.new(820, 170), dur = 0.7, color = P.white, thick = 7, delay = 0.09 })
		if lvl &gt;= 4 then
			RevealFx.Shockwave(s.front, { pos = CAR_AT, from = Vector2.new(60, 60), to = Vector2.new(900, 900), dur = 0.8, color = lift(rc, 0.4), thick = 9, delay = 0.16 })
		end
		table.insert(s.stops, RevealFx.Burst(s.front, { at = CAR_AT, colors = { rc, P.white, lift(rc, 0.5), P.yellow }, count = RevealFx.Count(), power = 0.85 + lvl * 0.08 }))
		if lvl &gt;= 4 then
			-- Epic / Legendary: shine sweeps over the name and the badge
			rv.name.TextColor3 = P.white
			rv.nameGrad.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, rc), ColorSequenceKeypoint.new(0.42, rc), ColorSequenceKeypoint.new(0.5, P.white),
				ColorSequenceKeypoint.new(0.58, rc), ColorSequenceKeypoint.new(1, rc),
			})
			rv.nameGrad.Enabled = true
			table.insert(s.tweens, RevealFx.Sweep(rv.nameGrad, 0.9, 1.1))
			rv.badgeShine.Visible = true
			table.insert(s.tweens, RevealFx.Sweep(rv.badgeShineGrad, 0.9, 1.1))
		end
		if lvl &gt;= 5 then
			-- Legendary: gold rim glow + a second, golden flash with its own burst
			rv.rim.Visible = true
			later(0.35, function()
				rv.flash.BackgroundColor3 = GOLD
				rv.flash.BackgroundTransparency = 0.15
				stw(rv.flash, 0.6, { BackgroundTransparency = 1 })
				RevealFx.Shockwave(s.front, { pos = CAR_AT, from = Vector2.new(80, 80), to = Vector2.new(1000, 1000), dur = 0.9, color = GOLD, thick = 12 })
				table.insert(s.stops, RevealFx.Burst(s.front, { at = CAR_AT, colors = { GOLD, P.white, P.yellow }, count = RevealFx.Count(0.5), power = 1.1 }))
				UI.Sfx("combo")
			end)
		end
		later(0.5, function()
			-- AWESOME bounces in (a tap anywhere closes from now on too)
			rv.ok.holder.Visible = true
			rv.okScale.Scale = 0
			stw(rv.okScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
		end)

		-- 3) the name pops in letter by letter
		task.wait(0.12)
		if not live() then
			return
		end
		UI.Sfx("fanfare")
		rv.nameScale.Scale = 1.3
		stw(rv.nameScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
		local n = utf8.len(carName) or #carName
		local per = math.clamp(0.5 / math.max(n, 1), 0.025, 0.06)
		for i = 1, n do
			rv.name.MaxVisibleGraphemes = i
			task.wait(per)
			if not live() then
				return
			end
		end
		rv.name.MaxVisibleGraphemes = -1

		-- 4) info line fades in, income counts up
		rv.info.Text = infoText(0)
		stw(rv.info, 0.25, { TextTransparency = 0 })
		local c0, dur = os.clock(), 0.7
		while true do
			local a = math.min(1, (os.clock() - c0) / dur)
			rv.info.Text = infoText(math.floor(income * (1 - (1 - a) ^ 3) + 0.5))
			if a &gt;= 1 then
				break
			end
			task.wait(1 / 30)
			if not live() then
				return
			end
		end
		UI.Sfx("ping")

		-- 5) NEW! stamp slams in last
		if res.isNew then
			task.wait(0.1)
			if not live() then
				return
			end
			rv.stamp.Visible = true
			rv.stampScale.Scale = 3
			stw(rv.stampScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
			later(0.12, function()
				UI.Sfx("clank")
				s.kickAt = os.clock()
				RevealFx.Shockwave(s.front, { pos = UDim2.fromOffset(600, 120), from = Vector2.new(60, 40), to = Vector2.new(320, 220), dur = 0.45, color = P.yellow, thick = 6 })
			end)
		end
	end)
end

-- coin spin-bounce: a small hop on every income tick, a big wobble for anything larger (bank, sale, discovery)
local coinTweens = {}
function UI.CoinBounce(gain)
	local img, sc = hud.coin, hud.coinScale
	if not img or not sc then
		return
	end
	for _, x in ipairs(coinTweens) do
		x:Cancel()
	end
	table.clear(coinTweens)
	local big = (gain or 0) &gt; math.max((store.Income or 0) * 2.5, 1)
	sc.Scale = big and 1.32 or 1.1
	img.Rotation = big and -24 or -7
	table.insert(coinTweens, tween(sc, big and 0.45 or 0.3, { Scale = 1 }, Enum.EasingStyle.Back))
	table.insert(coinTweens, tween(img, big and 0.7 or 0.4, { Rotation = 0 }, Enum.EasingStyle.Elastic))
end

---------------------------------------------------------------- refresh
local function refreshHud()
	local st = store.State
	hud.money.Text = "$" .. Util.FormatNumber(store.Money)
	hud.income.Text = "+" .. Util.FormatNumber(store.Income) .. " / sec"
	local carried = store.CarriedTotal()
	hud.bag.Visible = carried &gt; 0
	if carried &gt; 0 then
		local cap = st.carryCap or EconomyConfig.CarryCapacity
		local risk = st.run and st.run.risk or 1
		hud.bagText.Text = string.format("CARRYING  %d / %d", carried, cap) .. (risk &gt; 1 and string.format("   RISK x%s", risk) or "")
		hud.bagFill.Size = UDim2.fromScale(math.clamp(carried / cap, 0, 1), 1)
	end
	hud.throw.holder.Visible = state.nearTrap and state.open == nil
	-- "can unlock" dot on TELEPORT
	local dot = false
	for i, zid in ipairs(MapConfig.ZoneOrder) do
		local req = EconomyConfig.ZoneUnlock[zid]
		if req and (req.rebirths or 0) &lt;= (st.rebirths or 0) and not st.zones[zid] and st.zones[MapConfig.ZoneOrder[i - 1]] and store.Money &gt;= req.cost and store.CollectionValue &gt;= req.minValue then
			dot = true
		end
	end
	hud.newDot.Visible = dot
	hud.canUnlock = dot
end

-- the single next goal after the tutorial: { title, body } (shown by Tutorial's objective card)
local function refreshHint()
	local st = store.State
	local goal
	if store.CarriedTotal() &gt; 0 then
		goal = { "BANK YOUR LOOT", "Run home to the plaza, or reach the district CHECKPOINT to save it" }
	elseif store.BankedTotal() &gt; 0 and state.nearTrap then
		goal = { "THROW YOUR PARTS", "Press THROW and pick how many of each part" }
	end
	-- (v13: no "unlock the next district" card after the tutorial - the tutorial asks for the Highway once)
	hud.nextGoal = goal
	hud.hintFrame.Visible = false
end

UI.Hooks = {}

function UI.Refresh()
	if not store.State then
		return
	end
	for _, fn in ipairs(UI.Hooks) do
		fn(store.State, state.open)
	end
	refreshHud()
	refreshThrow()
	refreshHint()
	refreshGarage()
	refreshIndex()
	refreshTeleport()
end

function UI.SetZoneName(zoneId)
	if hud.lastZone == zoneId then
		return
	end
	hud.lastZone = zoneId
	hud.zone.Text = string.upper(T("zone_" .. zoneId))
	local c = ZONE_COLOR[zoneId] or P.orange
	hud.bannerGrad.Color = ColorSequence.new(lift(c, 0.35), c)
end

function UI.SetNearTrap(v)
	if state.nearTrap ~= v then
		state.nearTrap = v
		if not v and state.open == "throw" then
			UI.TogglePanel(nil)
		end
		refreshHud()
	end
end

function UI.FlashFrame()
	return hud.flash
end

function UI.Gui()
	return gui
end

function UI.Init(storeModule, actionTable)
	store, actions = storeModule, actionTable
	local player = Players.LocalPlayer
	gui = new("ScreenGui", { Name = "MainUI", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 10 })
	pcall(function()
		gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	end)
	root = new("Frame", { Name = "Root", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, gui)
	local uiScale = new("UIScale", {}, root)
	-- above the Cine layer (45), same scale as the HUD: nothing of a pop-up can fall off a phone screen
	overlay = new("Frame", { Name = "Overlay", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 60 }, gui)
	local ovScale = new("UIScale", {}, overlay)
	local function rescale()
		local vp = gui.AbsoluteSize.Magnitude &gt; 0 and gui.AbsoluteSize or (Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize) or Vector2.new(1280, 720)
		local s = math.clamp(math.min(vp.Y / 760, vp.X / 1240), 0.5, 1.2)
		uiScale.Scale, ovScale.Scale = s, s
		root.Size = UDim2.fromScale(1 / s, 1 / s)
		overlay.Size = UDim2.fromScale(1 / s, 1 / s)
	end
	rescale()
	if Workspace.CurrentCamera then
		Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	end
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(rescale)
	-- ElevenLabs SFX when uploaded (SoundIds), otherwise Roblox built-in sounds
	local SoundIds = require(Shared:WaitForChild("SoundIds"))
	local FALLBACK = {
		click = { "rbxasset://sounds/button.wav", 0.35 }, open = { "rbxasset://sounds/swoosh.wav", 0.25, 1.3 },
		err = { "rbxasset://sounds/uuhhh.mp3", 0.3, 1.2 }, ping = { "rbxasset://sounds/electronicpingshort.wav", 0.45, 1.2 },
		throw = { "rbxasset://sounds/swoosh.wav", 0.6, 1.4 }, clank = { "rbxasset://sounds/clickfast.wav", 0.6, 0.6 },
		charge = { "rbxasset://sounds/electronicpingshort.wav", 0.3, 0.5 }, reveal = { "rbxasset://sounds/Rocket shot.wav", 0.6, 0.8 },
		revealBig = { "rbxasset://sounds/Rocket shot.wav", 0.8, 0.6 }, land = { "rbxasset://sounds/collide.wav", 0.8, 0.6 },
		drive = { "rbxasset://sounds/swoosh.wav", 0.4, 0.6 }, pickup = { "rbxasset://sounds/electronicpingshort.wav", 0.5, 1.5 },
		pickupBig = { "rbxasset://sounds/electronicpingshort.wav", 0.6, 1.1 }, bank = { "rbxasset://sounds/victory.wav", 0.35, 1.3 },
		bankCombo = { "rbxasset://sounds/victory.wav", 0.5 }, combo = { "rbxasset://sounds/electronicpingshort.wav", 0.5, 1.8 },
		cash = { "rbxasset://sounds/victory.wav", 0.5, 1.2 }, siren = { "rbxasset://sounds/electronicpingshort.wav", 0.2, 0.9 },
		crash = { "rbxasset://sounds/collide.wav", 0.9, 0.8 }, wrecked = { "rbxasset://sounds/uuhhh.mp3", 0.5 },
		airbag = { "rbxasset://sounds/Rocket shot.wav", 0.5, 1.6 }, whoosh = { "rbxasset://sounds/swoosh.wav", 0.6, 0.8 },
		fanfare = { "rbxasset://sounds/victory.wav", 0.5 }, hit = { "rbxasset://sounds/collide.wav", 0.9, 0.8 },
		boom = { "rbxasset://sounds/Rocket shot.wav", 0.7, 0.7 },
		step = { "rbxasset://sounds/electronicpingshort.wav", 0.18, 1.6 }, -- tutorial step: soft and short
	}
	for name, fb in pairs(FALLBACK) do
		local id = SoundIds[name]
		if id and id &gt; 0 then
			makeSound(name, "rbxassetid://" .. id, name == "step" and 0.35 or fb[2] + 0.15, 1)
		else
			makeSound(name, fb[1], fb[2], fb[3])
		end
	end
	if SoundIds.ambience and SoundIds.ambience &gt; 0 then
		local amb = new("Sound", { Name = "Ambience", SoundId = "rbxassetid://" .. SoundIds.ambience, Volume = 0.25, Looped = true, SoundGroup = UI.MusicGroup }, SoundService)
		amb:Play()
	end
	-- relaxing background music (ElevenLabs), looped; its volume is the Music slider (Settings)
	if SoundIds.music and SoundIds.music &gt; 0 then
		local music = new("Sound", { Name = "Music", SoundId = "rbxassetid://" .. SoundIds.music, Volume = 0.6, Looped = true, SoundGroup = UI.MusicGroup }, SoundService)
		music:Play()
	end
	buildHud()
	buildThrow()
	buildTeleport()
	buildGarage()
	buildIndex()
	buildReveal()
	gui.Parent = player:WaitForChild("PlayerGui")
	UI.SetZoneName("plaza")

	local lastMoney = 0
	store.Changed.Event:Connect(UI.Refresh)
	store.MoneyChanged.Event:Connect(function()
		if store.Money &gt; lastMoney then
			hud.moneyScale.Scale = 1.08
			tween(hud.moneyScale, 0.2, { Scale = 1 })
			if lastMoney &gt; 0 then -- not the first sync after joining
				UI.CoinBounce(store.Money - lastMoney)
			end
		end
		lastMoney = store.Money
		refreshHud()
	end)
	UI.Refresh()
end

-- toolkit for the other UI modules (UIExtra, Markers, Minimap)
function UI.Kit()
	return {
		new = new, toy = toy, text = text, corner = corner, stroke = stroke, gradient = gradient, list = list, clear = clear,
		tween = tween, pill = pill, lift = lift, panelShell = panelShell, scroller = scroller, carViewport = carViewport,
		card = card, inset = inset, padding = padding, dialogShell = dialogShell,
		P = P, HEAD = HEAD, BODY = BODY, root = root, gui = gui, overlay = overlay, hud = hud, panels = panels, state = state, store = store,
		actions = actions, PART_ICON = PART_ICON, confirm = UI.Confirm,
	}
end

return UI
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX51"><Properties><string name="Name">WorldFx</string><ProtectedString name="Source">local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MapConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MapConfig"))
local Perf = require(script.Parent:WaitForChild("Perf"))

local MOODS = {
	plaza = { clock = 14.3, bright = 2.3, tint = Color3.fromRGB(255, 250, 244), sat = 0.16, amb = Color3.fromRGB(132, 128, 118) },
	city = { clock = 14.3, bright = 2.3, tint = Color3.fromRGB(255, 250, 240), sat = 0.16, amb = Color3.fromRGB(132, 128, 118) },
	highway = { clock = 15.9, bright = 2.2, tint = Color3.fromRGB(255, 244, 226), sat = 0.14, amb = Color3.fromRGB(134, 124, 116) },
	industrial = { clock = 17.3, bright = 2.0, tint = Color3.fromRGB(255, 234, 212), sat = 0.06, amb = Color3.fromRGB(130, 110, 104) },
	neon = { clock = 20.4, bright = 1.4, tint = Color3.fromRGB(214, 236, 255), sat = 0.35, amb = Color3.fromRGB(60, 110, 150) },
	scrapyard = { clock = 17.8, bright = 1.9, tint = Color3.fromRGB(255, 226, 200), sat = 0.1, amb = Color3.fromRGB(130, 104, 96) },
	docks = { clock = 9.2, bright = 2.0, tint = Color3.fromRGB(236, 246, 255), sat = 0.1, amb = Color3.fromRGB(110, 124, 136) },
	desert = { clock = 13.0, bright = 2.6, tint = Color3.fromRGB(255, 236, 206), sat = 0.12, amb = Color3.fromRGB(150, 128, 104) },
	bridge = { clock = 11.0, bright = 2.3, tint = Color3.fromRGB(246, 252, 255), sat = 0.18, amb = Color3.fromRGB(124, 134, 140) },
	airport = { clock = 15.0, bright = 2.3, tint = Color3.fromRGB(250, 250, 255), sat = 0.12, amb = Color3.fromRGB(128, 130, 136) },
	canyon = { clock = 18.2, bright = 2.0, tint = Color3.fromRGB(255, 214, 180), sat = 0.2, amb = Color3.fromRGB(150, 100, 80) },
	circuit = { clock = 14.0, bright = 2.4, tint = Color3.fromRGB(255, 250, 244), sat = 0.2, amb = Color3.fromRGB(132, 128, 118) },
	drift = { clock = 21.0, bright = 1.3, tint = Color3.fromRGB(240, 220, 255), sat = 0.35, amb = Color3.fromRGB(90, 70, 130) },
	storm = { clock = 19.6, bright = 0.9, tint = Color3.fromRGB(190, 206, 220), sat = -0.1, amb = Color3.fromRGB(70, 80, 96) },
	rush = { clock = 16.8, bright = 2.1, tint = Color3.fromRGB(255, 236, 214), sat = 0.14, amb = Color3.fromRGB(134, 120, 110) },
	colosseum = { clock = 17.0, bright = 2.2, tint = Color3.fromRGB(255, 232, 200), sat = 0.16, amb = Color3.fromRGB(150, 126, 100) },
}
local mood = { clock = 14.3, bright = 2.3, tint = Color3.fromRGB(255, 250, 244), sat = 0.16, amb = Color3.fromRGB(132, 128, 118) }
local tintFx
local lastBackfire = 0
-- what was last written to Lighting: only real changes are written (every Lighting write is costly on the GPU side)
local written = {}
local lastClockWrite = 0
local CLOCK_EVERY = 0.4 -- s: the sun moves at ~2.5 Hz during a zone blend
local function colorDiff(a, b)
	return math.max(math.abs(a.R - b.R), math.abs(a.G - b.G), math.abs(a.B - b.B))
end
local spinAcc = 0
local SPIN_RADIUS = { HIGH = 300, MED = 200, LOW = 130 }
local lastSpinScan = 0
local spinNear, spinParts, spinCFs = {}, {}, {}

local Fx = {}
local spinning = {}
local gates = {}
local store

local function applyGate(part)
	local zone = part:GetAttribute("ZoneId")
	local unlocked = store.State and store.State.zones and store.State.zones[zone] == true
	part.CanCollide = not unlocked
	part.Transparency = unlocked and 1 or 0
	for _, g in ipairs(part:GetChildren()) do
		if g:IsA("SurfaceGui") then
			g.Enabled = not unlocked
		end
	end
end

local function addSpin(model)
	local root = model:IsA("Model") and model.PrimaryPart or model:FindFirstChild("Root")
	if not root then
		task.wait(0.2)
		root = model.PrimaryPart or model:FindFirstChild("Root")
	end
	if root then
		spinning[model] = { root = root, base = root.CFrame, phase = math.random() * 6 }
	end
end

function Fx.Start(storeModule)
	store = storeModule
	for _, m in ipairs(CollectionService:GetTagged("SpinBob")) do
		task.spawn(addSpin, m)
	end
	CollectionService:GetInstanceAddedSignal("SpinBob"):Connect(function(m)
		task.spawn(addSpin, m)
	end)
	CollectionService:GetInstanceRemovedSignal("SpinBob"):Connect(function(m)
		spinning[m] = nil
	end)
	local function regGate(p)
		gates[p] = true
		applyGate(p)
	end
	for _, p in ipairs(CollectionService:GetTagged("ZoneGate")) do
		regGate(p)
	end
	CollectionService:GetInstanceAddedSignal("ZoneGate"):Connect(regGate)
	store.Changed.Event:Connect(function()
		for p in pairs(gates) do
			if p.Parent then
				applyGate(p)
			end
		end
	end)
	tintFx = Lighting:FindFirstChild("ZoneTint") or Instance.new("ColorCorrectionEffect")
	tintFx.Name = "ZoneTint"
	tintFx.Parent = Lighting
	RunService.RenderStepped:Connect(function(dt)
		local cam = Workspace.CurrentCamera
		if cam then
			local target = MOODS[MapConfig.ZoneAt(cam.CFrame.Position.Z)] or MOODS.city
			local a = math.min(1, dt * 1.2)
			mood.clock = mood.clock + (target.clock - mood.clock) * a
			mood.bright = mood.bright + (target.bright - mood.bright) * a
			mood.sat = mood.sat + (target.sat - mood.sat) * a
			mood.tint = mood.tint:Lerp(target.tint, a)
			mood.amb = mood.amb:Lerp(target.amb, a)
			local now = os.clock()
			if written.clock == nil or (math.abs(mood.clock - written.clock) &gt; 0.01 and now - lastClockWrite &gt;= CLOCK_EVERY) then
				written.clock = mood.clock
				lastClockWrite = now
				Lighting.ClockTime = mood.clock
			end
			if written.bright == nil or math.abs(mood.bright - written.bright) &gt; 0.005 then
				written.bright = mood.bright
				Lighting.Brightness = mood.bright
			end
			if written.amb == nil or colorDiff(mood.amb, written.amb) &gt; 0.002 then
				written.amb = mood.amb
				Lighting.OutdoorAmbient = mood.amb
			end
			if written.tint == nil or colorDiff(mood.tint, written.tint) &gt; 0.002 then
				written.tint = mood.tint
				tintFx.TintColor = mood.tint
			end
			if written.sat == nil or math.abs(mood.sat - written.sat) &gt; 0.002 then
				written.sat = mood.sat
				tintFx.Saturation = mood.sat
			end
		end
		local t = os.clock()
		-- (v10: showcase cars stand still on static stands - no turntable spinning)
		local level = Perf.Level()
		if t - lastBackfire &gt; 2.2 and level ~= "LOW" then
			lastBackfire = t
			local camPos = cam and cam.CFrame.Position or Vector3.zero
			local range = level == "HIGH" and 140 or 90
			for _, att in ipairs(CollectionService:GetTagged("Backfire")) do
				if att.Parent and (att.WorldPosition - camPos).Magnitude &lt; range and math.random() &lt; 0.45 then
					local fire = att:FindFirstChildOfClass("ParticleEmitter")
					if fire then
						fire:Emit(14)
					end
				end
			end
		end
		-- spinning drops: only the ones near the camera animate (list refreshed at 2 Hz), moved in one bulk call
		if t - lastSpinScan &gt; 0.5 then
			lastSpinScan = t
			table.clear(spinNear)
			local camPos = cam and cam.CFrame.Position
			local r = SPIN_RADIUS[level] or 200
			for m, s in pairs(spinning) do
				if not s.root.Parent then
					spinning[m] = nil
				elseif camPos and (s.base.Position - camPos).Magnitude &lt; r then
					table.insert(spinNear, s)
				end
			end
		end
		if #spinNear &gt; 0 then
			table.clear(spinParts)
			table.clear(spinCFs)
			for _, s in ipairs(spinNear) do
				if s.root.Parent then
					table.insert(spinParts, s.root)
					table.insert(spinCFs, s.base * CFrame.Angles(0, t * 2 + s.phase, 0) + Vector3.new(0, math.sin(t * 2 + s.phase) * 0.5, 0))
				end
			end
			if #spinParts &gt; 0 then
				Workspace:BulkMoveTo(spinParts, spinCFs, Enum.BulkMoveMode.FireCFrameChanged)
			end
		end
	end)
end

function Fx.Hit(dir, flashFrame)
	local char = Players.LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.AssemblyLinearVelocity = dir.Unit * 70 + Vector3.new(0, 40, 0)
	end
	if flashFrame then
		flashFrame.BackgroundTransparency = 0.55
		task.spawn(function()
			for i = 1, 10 do
				flashFrame.BackgroundTransparency = 0.55 + i * 0.045
				task.wait(0.03)
			end
			flashFrame.BackgroundTransparency = 1
		end)
	end
end

return Fx
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX314DFC317F1F47FBAEDB0C77EF6ACE78"><Properties><string name="Name">Backpack</string><ProtectedString name="Source">-- BACKPACK: right-column button -&gt; panel with every part type: 3D icon, name, rarity and how many you have.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local Icons = require(Shared:WaitForChild("Icons"))

local Backpack = {}
local K, UI, P
local cells = {}

local function refresh(_, open)
	if open ~= "backpack" then
		return
	end
	for id, c in pairs(cells) do
		local n = K.store.Banked(id)
		c.count.Text = "x" .. n
		c.icon.ImageTransparency = n &gt; 0 and 0 or 0.6
		c.count.TextColor3 = n &gt; 0 and P.ink or P.grey
	end
end

function Backpack.Start(ui)
	UI = ui
	K = UI.Kit()
	P = K.P
	-- 5th button in the right column
	local holder = K.new("Frame", { Size = UDim2.fromOffset(122, 104), BackgroundTransparency = 1, LayoutOrder = 5 }, K.hud.side)
	K.toy(holder, { Text = "BACKPACK", Image = "backpack", Icon = "🎒", Color = P.orange, Size = UDim2.fromOffset(122, 104), OnClick = function() UI.TogglePanel("backpack") end })

	local p = K.panelShell("backpack", "BACKPACK", 760, 520, P.orange)
	local grid = K.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 22 }, p.content)
	K.new("UIGridLayout", { CellSize = UDim2.fromOffset(132, 190), CellPadding = UDim2.fromOffset(12, 14), HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder }, grid)
	for i, id in ipairs(PartConfig.Order) do
		local part = PartConfig.Parts[id]
		local rc = CarConfig.Rarities[part.rarity].color
		-- v23: white card, ink outline + shadow, rarity as a top strip (cell 190 = 4 shadow + 6 strip + 180 body)
		local f = K.card(grid, { Accent = rc, AccentTop = true, AccentSize = 6, Radius = 16, LayoutOrder = i, ZIndex = 23 })
		local icon = K.new("ImageLabel", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 6), Size = UDim2.fromOffset(92, 92), BackgroundTransparency = 1,
			Image = Icons.Get(id) or "", ScaleType = Enum.ScaleType.Fit, ZIndex = 24 }, f)
		K.text(f, { Text = part.name, TextSize = 16, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(6, 102), Size = UDim2.new(1, -12, 0, 22),
			TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
		K.text(f, { Text = string.upper(part.rarity), Font = K.BODY, TextSize = 13, TextColor3 = K.lift(rc, -0.3), Position = UDim2.fromOffset(6, 124), Size = UDim2.new(1, -12, 0, 18),
			TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
		local count = K.text(f, { Text = "x0", TextSize = 24, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(6, 146), Size = UDim2.new(1, -12, 0, 30),
			TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
		cells[id] = { icon = icon, count = count }
	end
	table.insert(UI.Hooks, refresh)
end

return Backpack
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXF19E58D4A9404628B6D0FDCD030FAEC7"><Properties><string name="Name">BatchReveal</string><ProtectedString name="Source">-- Batch throw reveal: parts rain onto the lift, a fast reel of every car (slowing down on the best one),
-- then a results grid. "SEE BEST CAR" plays the full showcase + drive-in for the best car.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local Util = require(Shared:WaitForChild("Util"))
local CarPreload = require(script.Parent:WaitForChild("CarPreload"))
local RevealFx = require(script.Parent:WaitForChild("RevealFx"))

local BR = {}
local K, UI, Cine, TrapFx
local P
local C = Color3.fromRGB
local root, blur, conn
local holding = false -- holds UI cinematic mode while the reel / grid is up

local function rc(r)
	return CarConfig.Rarities[r].color
end

local function close()
	if conn then
		conn:Disconnect()
		conn = nil
	end
	if root then
		root:Destroy()
		root = nil
	end
	if blur then
		blur:Destroy()
		blur = nil
	end
	if holding then
		holding = false
		if not TrapFx.IsBusy() then -- the car showcase keeps its own blackout
			Cine.Darken(0, 0.35)
		end
		UI.SetCinematic(false)
	end
end

-- v23: white card, ink outline, shadow slab, rarity as the card's own top strip (follows the rounded corners)
-- returns the content body, the car def, the holder (position / scale it) and the outline
local function card(parent, r, order, big)
	local def = CarConfig.ById[r.typeId]
	local f, holder, _, st = K.card(parent, { Size = UDim2.fromOffset(big and 170 or 150, big and 190 or 160), Accent = rc(r.rarity), AccentTop = true, AccentSize = 6,
		Radius = 16, LayoutOrder = order, ZIndex = 72 })
	return f, def, holder, st
end

local function grid(res)
	-- v23: shared dialog shell (drop shadow + header strip); the card stays Active so taps on it do not close
	local scr, shell = K.dialogShell(root, { Name = "Grid", Size = UDim2.fromOffset(940, 600), Radius = 28, ZIndex = 70, Active = true, Color = P.orange, HeadH = 64,
		Title = string.format("YOU GOT %d CARS", #res.cars), TitleSize = 38 })
	-- a tap outside the card closes the results (on small screens the buttons were the only way out)
	local r = root
	task.delay(0.6, function()
		if r and root == r then -- only the results screen it was made for
			r.Activated:Connect(close)
		end
	end)
	local sc = K.new("UIScale", { Scale = 0.6 }, shell)
	K.tween(sc, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	local counts, bonus, merged, newN = {}, 0, 0, 0
	for _, r in ipairs(res.cars) do
		counts[r.rarity] = (counts[r.rarity] or 0) + 1
		bonus = bonus + (r.bonus or 0)
		merged = merged + (r.merged and 1 or 0)
		newN = newN + (r.isNew and 1 or 0)
	end
	local parts = {}
	for _, r in ipairs(CarConfig.RarityOrder) do
		if counts[r] then
			table.insert(parts, string.format('&lt;font color="#%s"&gt;%d %s&lt;/font&gt;', K.lift(rc(r), -0.3):ToHex(), counts[r], r))
		end
	end
	local extra = {}
	if newN &gt; 0 then
		table.insert(extra, newN .. " new")
	end
	if merged &gt; 0 then
		table.insert(extra, merged .. " merged")
	end
	if bonus &gt; 0 then
		table.insert(extra, "discovery +$" .. Util.FormatNumber(bonus))
	end
	K.text(scr, { Text = table.concat(parts, "   ") .. (#extra &gt; 0 and ("     ·     " .. table.concat(extra, "  ·  ")) or ""), Font = K.BODY, TextSize = 18, TextColor3 = P.ink, RichText = true,
		Position = UDim2.fromOffset(28, 72), Size = UDim2.new(1, -56, 0, 24), ZIndex = 72 })
	local list = K.new("ScrollingFrame", { Position = UDim2.fromOffset(20, 102), Size = UDim2.new(1, -40, 1, -196), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 8,
		ScrollBarImageColor3 = P.ink, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 72 }, scr)
	K.new("UIGridLayout", { CellSize = UDim2.fromOffset(160, 170), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder }, list)
	K.padding(list, 8, 14) -- 5 x 160 + 4 x 10 = 840 of the 878 px inside: outlines and shadows of the outer cards stay visible
	-- best first, then by rarity
	local order = {}
	for i, r in ipairs(res.cars) do
		table.insert(order, { i = i, r = r })
	end
	table.sort(order, function(a, b)
		if a.i == res.best then
			return true
		elseif b.i == res.best then
			return false
		end
		local ra, rb = CarConfig.Rarities[a.r.rarity].index, CarConfig.Rarities[b.r.rarity].index
		if ra ~= rb then
			return ra &gt; rb
		end
		return a.i &lt; b.i
	end)
	for k, o in ipairs(order) do
		local r = o.r
		local f, def, _, outline = card(list, r, k)
		if k &lt;= 12 then
			K.carViewport(f, def, { Position = UDim2.fromOffset(4, 6), Size = UDim2.new(1, -8, 0, 92), ZIndex = 73 })
		else
			local tile = K.new("Frame", { Position = UDim2.fromOffset(10, 12), Size = UDim2.new(1, -20, 0, 80), BackgroundColor3 = rc(r.rarity), BackgroundTransparency = 0.6, ZIndex = 73 }, f)
			K.corner(tile, 12)
		end
		K.text(f, { Text = def.name, Font = K.BODY, TextSize = 15, TextColor3 = P.ink, TextWrapped = true, Position = UDim2.fromOffset(6, 98), Size = UDim2.new(1, -12, 0, 34), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 73 })
		local tag, col
		if r.merged then
			tag, col = "MERGED  Lv" .. r.merged, P.blue
		elseif r.sold then
			tag, col = "SOLD +$" .. Util.FormatNumber(r.sold), P.grey
		elseif r.isNew then
			tag, col = "NEW!", P.orange
		elseif r.slot then
			tag, col = "PARKED", P.green
		else
			tag, col = "STORED", P.muted
		end
		local t = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -6), Size = UDim2.new(1, -16, 0, 22), BackgroundColor3 = col, ZIndex = 73 }, f)
		K.corner(t, 11)
		K.text(t, { Text = tag, TextSize = 14, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 74 })
		if o.i == res.best then
			-- the best car: thick gold-orange outline (the ink one becomes it; a yellow rim alone vanished on cream)
			outline.Color = P.orange
			outline.Thickness = 5
		end
	end
	local btns = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -14), Size = UDim2.fromOffset(640, 72), BackgroundTransparency = 1, ZIndex = 72 }, scr)
	K.list(btns, Enum.FillDirection.Horizontal, 20, Enum.HorizontalAlignment.Center)
	K.toy(btns, { Text = "SEE BEST CAR", Color = P.orange, Size = UDim2.fromOffset(300, 70), TextSize = 26, LayoutOrder = 1, ZIndex = 72, OnClick = function()
		local best = res.cars[res.best]
		local st = K.store.State
		-- start the showcase first so the HUD does not flash back between the grid and the cinematic
		task.defer(close)
		TrapFx.Play({ partId = best.partId, typeId = best.typeId, rarity = best.rarity, slot = best.slot, merged = best.merged, sold = best.sold, isNew = best.isNew, bonus = best.bonus, speed = 1.6, animTime = 0 }, st and st.baseIndex)
	end })
	K.toy(btns, { Text = "DONE", Color = P.green, Size = UDim2.fromOffset(220, 70), TextSize = 28, LayoutOrder = 2, ZIndex = 72, OnClick = close })
end

-- fast reel: cards slide right-to-left, decelerate and stop on the best car
local function reel(res, onDone)
	local strip = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 0, 0, 230), BackgroundColor3 = C(14, 16, 24),
		BackgroundTransparency = 0.2, ZIndex = 70 }, root)
	local marker = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(6, 250), BackgroundColor3 = P.yellow, ZIndex = 75 }, root)
	K.corner(marker, 3)
	local track = K.new("Frame", { Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromOffset(0, 230), BackgroundTransparency = 1, ZIndex = 71 }, strip)
	-- sequence: shuffled filler cars then the best one, padded so the strip keeps going past it
	local seq = {}
	for i, r in ipairs(res.cars) do
		if i ~= res.best then
			table.insert(seq, r)
		end
	end
	for i = #seq, 2, -1 do
		local j = math.random(1, i)
		seq[i], seq[j] = seq[j], seq[i]
	end
	while #seq &lt; 18 do
		table.insert(seq, res.cars[math.random(1, #res.cars)])
	end
	local stopAt = #seq + 1
	table.insert(seq, res.cars[res.best])
	for _ = 1, 4 do
		table.insert(seq, res.cars[math.random(1, #res.cars)])
	end
	local W = 180
	local bestCard
	for k, r in ipairs(seq) do
		local f, _, holder = card(track, r, k)
		if k == stopAt then
			bestCard = holder
		end
		holder.Position = UDim2.fromOffset((k - 1) * W, 30)
		K.text(f, { Text = CarConfig.ById[r.typeId].name, Font = K.BODY, TextSize = 16, TextColor3 = P.ink, TextWrapped = true, Position = UDim2.fromOffset(6, 64), Size = UDim2.new(1, -12, 0, 40),
			TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 73 })
		K.text(f, { Text = string.upper(r.rarity), TextSize = 16, TextColor3 = rc(r.rarity), Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 73 })
	end
	local target = (stopAt - 1) * W + 75 -- card centre under the marker
	local dur = 2.6
	local t0 = os.clock()
	local done = false
	local lastTick = 0
	local function finish()
		if done then
			return
		end
		done = true
		track.Position = UDim2.new(0.5, -target, 0, 0)
		UI.Sfx(CarConfig.Rarities[res.cars[res.best].rarity].index &gt;= 4 and "revealBig" or "reveal")
		Cine.Shake(0.6, 0.3)
		-- v22: the best card lands with a flash, shockwaves and a confetti burst (layer goes with the root / after 2.2 s)
		local best = res.cars[res.best]
		local brc = rc(best.rarity)
		local fx = K.new("Frame", { Name = "ReelFx", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 76 }, root)
		RevealFx.Flash(fx, { color = brc, from = 0.55, dur = 0.45 })
		if bestCard then
			RevealFx.Flash(bestCard, { color = P.white, from = 0, dur = 0.5, corner = 16, z = 80 })
			local pop = K.new("UIScale", { Scale = 1.25 }, bestCard)
			K.tween(pop, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		end
		RevealFx.Shockwave(fx, { pos = UDim2.fromScale(0.5, 0.5), from = Vector2.new(150, 160), to = Vector2.new(700, 700), dur = 0.6, color = brc, thick = 10 })
		RevealFx.Shockwave(fx, { pos = UDim2.fromScale(0.5, 0.5), from = Vector2.new(120, 130), to = Vector2.new(520, 520), dur = 0.55, color = P.white, thick = 6, delay = 0.1 })
		RevealFx.Burst(fx, { at = UDim2.fromScale(0.5, 0.5), colors = { brc, P.white, P.yellow }, count = RevealFx.Count(), power = 0.9 })
		task.delay(2.2, function()
			fx:Destroy()
		end)
		task.delay(0.8, function()
			strip:Destroy()
			marker:Destroy()
			onDone()
		end)
	end
	conn = RunService.RenderStepped:Connect(function()
		if done then
			return
		end
		local a = math.min(1, (os.clock() - t0) / dur)
		local e = 1 - (1 - a) ^ 3
		local x = e * target
		track.Position = UDim2.new(0.5, -x, 0, 0)
		local tick = math.floor(x / W)
		if tick ~= lastTick then
			lastTick = tick
			UI.Sfx("click")
		end
		if a &gt;= 1 then
			finish()
		end
	end)
	root.Activated:Connect(finish)
end

function BR.Play(res)
	if not res or not res.cars or #res.cars == 0 then
		return
	end
	close()
	holding = true
	UI.SetCinematic(true)
	-- blackout: the world fades to fully dark, the reel and the grid sit on a solid backdrop
	Cine.Darken(1, 0.25)
	Cine.Shake(0.9, 0.35)
	UI.Sfx("throw")
	root = K.new("TextButton", { Name = "BatchReveal", Text = "", AutoButtonColor = false, Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(6, 7, 12), BackgroundTransparency = 1, ZIndex = 69 }, K.overlay)
	K.tween(root, 0.25, { BackgroundTransparency = 0 })
	blur = K.new("BlurEffect", { Size = 18 }, Lighting)
	local myRoot = root
	reel(res, function()
		if root ~= myRoot then
			return -- closed (or a newer batch) meanwhile
		end
		-- the grid's car viewports must not pop in: wait for their models (normally ready already), max 2 s
		local ids = {}
		for _, r in ipairs(res.cars) do
			table.insert(ids, r.typeId)
		end
		CarPreload.ReadyAll(ids, 2)
		if root and root == myRoot then
			grid(res)
		end
	end)
end

BR.Close = close

function BR.Start(ui, cine, trap)
	UI = ui
	K = UI.Kit()
	P = K.P
	Cine = cine
	TrapFx = trap
	require(Shared:WaitForChild("Net")).Get("ThrowBatchResult").OnClientEvent:Connect(BR.Play)
end

return BR
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXBDF7B6612D3E4D0AB2E325A6FFC0A9F9"><Properties><string name="Name">BossFx</string><ProtectedString name="Source">-- Boss HUD + effects: big "THROW!" button appears when a monster truck is close, the cheapest part flies at it,
-- stars when it is stunned, dust when it flees.
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Strings = require(Shared:WaitForChild("Strings"))
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local MapConfig = require(Shared:WaitForChild("MapConfig"))

local T = Strings.T
local BossFx = {}
local K, UI, Cine
local w = {}
local RANGE = 80

local function cheapest(st)
	for _, id in ipairs(PartConfig.Order) do
		if (st.carried and st.carried[id] or 0) &gt; 0 then
			return id
		end
	end
	for _, id in ipairs(PartConfig.Order) do
		if (st.parts and st.parts[id] or 0) &gt; 0 then
			return id
		end
	end
	return nil
end

local function build()
	local root = K.root
	local holder = K.new("Frame", { Name = "BossThrow", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -170), Size = UDim2.fromOffset(300, 170),
		BackgroundTransparency = 1, Visible = false }, root)
	local hint = K.text(holder, { Text = T("boss_hint"), TextSize = 24, TextColor3 = K.P.white, Size = UDim2.new(1, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Center })
	w.btn = K.toy(holder, { Text = T("boss_throw"), Icon = "🔧", Color = K.P.red, Size = UDim2.fromOffset(240, 110), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 38),
		TextSize = 40, OnClick = function()
			Net.Get("BossThrow"):FireServer()
			UI.Sfx("throw")
		end })
	w.hint = hint
	w.holder = holder
	w.pips = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 152), Size = UDim2.fromOffset(80, 16), BackgroundTransparency = 1 }, holder)
	K.list(w.pips, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center)
	w.pip = {}
	for i = 1, 2 do
		w.pip[i] = K.new("Frame", { Size = UDim2.fromOffset(16, 16), BackgroundColor3 = K.P.grey }, w.pips)
		K.corner(w.pip[i], 8)
		K.stroke(w.pip[i], K.P.ink, 2)
	end
end

local function nearestBoss(pos)
	local folder = Workspace:FindFirstChild("Bosses")
	if not folder then
		return nil
	end
	local best, bd
	for _, m in ipairs(folder:GetChildren()) do
		if m.PrimaryPart then
			local d = (m.PrimaryPart.Position - pos).Magnitude
			if not bd or d &lt; bd then
				best, bd = m, d
			end
		end
	end
	return best, bd
end

local function flyPart(from, to, partId)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(1.6, 1.6, 1.6)
	p.Color = PartConfig.Parts[partId] and PartConfig.Parts[partId].color or Color3.new(1, 1, 1)
	p.Material = Enum.Material.Metal
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
	p.Parent = Workspace
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local a = math.min(1, (os.clock() - t0) / 0.5)
		local pos = from:Lerp(to + Vector3.new(0, 6, 0), a) + Vector3.new(0, math.sin(a * math.pi) * 12, 0)
		p.CFrame = CFrame.new(pos) * CFrame.Angles(a * 9, a * 7, 0)
		if a &gt;= 1 then
			conn:Disconnect()
			p:Destroy()
		end
	end)
end

local function burst(pos, color, n)
	local a = Instance.new("Part")
	a.Anchored, a.CanCollide, a.CanQuery, a.CanTouch = true, false, false, false
	a.Transparency = 1
	a.Size = Vector3.one
	a.CFrame = CFrame.new(pos)
	a.Parent = Workspace
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(color)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 0) })
	e.Speed = NumberRange.new(10, 22)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Lifetime = NumberRange.new(0.6, 1)
	e.Rate = 0
	e.Parent = a
	e:Emit(n or 24)
	task.delay(1.5, function()
		a:Destroy()
	end)
end

function BossFx.Start(ui, cine)
	UI = ui
	K = UI.Kit()
	Cine = cine
	build()
	Net.Get("BossFx").OnClientEvent:Connect(function(ev)
		if ev.event == "throw" then
			flyPart(ev.from + Vector3.new(0, 2, 0), ev.to, ev.part)
			task.delay(0.5, function()
				burst(ev.to + Vector3.new(0, 6, 0), Color3.fromRGB(255, 220, 80), 30)
				UI.Sfx("clank")
			end)
		elseif ev.event == "flee" then
			burst(ev.pos + Vector3.new(0, 3, 0), Color3.fromRGB(200, 180, 150), 50)
			UI.Sfx("fanfare")
			if Cine then
				Cine.Title(T("boss_fleeing"), Color3.fromRGB(255, 210, 63))
			end
		elseif ev.event == "smash" then
			UI.Sfx("crash")
		end
	end)
	RunService.Heartbeat:Connect(function()
		local char = Players.LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local st = K.store.State
		local show = false
		if hrp and st then
			local zone = MapConfig.Zones[MapConfig.ZoneAt(hrp.Position.Z)]
			if zone and zone.arena then
				local boss, d = nearestBoss(hrp.Position)
				if boss and d &lt; RANGE and boss:GetAttribute("Mode") ~= "flee" then
					show = true
					local part = cheapest(st)
					local hits = boss:GetAttribute("Hits") or 0
					for i = 1, 2 do
						w.pip[i].BackgroundColor3 = i &lt;= hits and K.P.yellow or K.P.grey
					end
					w.btn.SetColor(part and K.P.red or K.P.grey)
					w.hint.Text = part and (T("boss_hint") .. "  " .. (K.PART_ICON[part] or "")) or T("boss_empty")
				end
			end
		end
		if w.holder.Visible ~= show then
			w.holder.Visible = show
			if show then
				w.holder.Size = UDim2.fromOffset(200, 110)
				TweenService:Create(w.holder, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(300, 170) }):Play()
				UI.Sfx("siren")
			end
		end
	end)
end

return BossFx
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXECA26E35023D494DA514B81CAFDFCA46"><Properties><string name="Name">CarPreload</string><ProtectedString name="Source">-- Car preloading (v22): reveals must show the car on their first frame.
--  * content: ContentProvider:PreloadAsync downloads the meshes/textures of ReplicatedStorage.CarModels/&lt;id&gt;
--    (owned cars first, then the cars of the rarities the player can realistically catch, rarest first)
--  * templates: VehicleFactory.BuildCar prepares each real model once (clone + ScaleTo + welds, cached in its
--    templateCache under "car:&lt;id&gt;"); warming builds one throw-away clone so the reveal only pays a cheap Clone().
-- Background work is small batches with waits in between; caps per quality level keep phone memory modest.
-- Ensure(defs) does a car right away (a throw result just arrived); Ready(def, timeout) waits for it.
-- Warming waits for the server's ReplicatedStorage "CarsReady" attribute (up to 20 s, v25).
local ContentProvider = game:GetService("ContentProvider")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))
local VehicleFactory = require(Shared:WaitForChild("VehicleFactory"))
local Store = require(script.Parent:WaitForChild("StateStore"))

local CarPreload = {}
local loaded = {} -- id -&gt; true: content preloaded (or nothing to download)
local warmed = {} -- id -&gt; true: template prepared (or a procedural car, which has none)
local busy = {} -- id -&gt; true while a priority job handles it
local started = false
local bgWarmed = 0

-- background caps per quality level: { cars whose content is downloaded, templates kept prepared }
local CAPS = { HIGH = { 60, 16 }, MED = { 32, 10 }, LOW = { 16, 5 } }

local perfMod
local function perfLevel()
	if perfMod == nil then
		perfMod = false
		local m = script.Parent:FindFirstChild("Perf")
		if m then
			local ok, P = pcall(require, m)
			if ok and type(P) == "table" and type(P.Level) == "function" then
				perfMod = P
			end
		end
	end
	if perfMod then
		local ok, l = pcall(perfMod.Level)
		if ok and CAPS[l] then
			return l
		end
	end
	return "HIGH"
end

local function realModel(id)
	local folder = ReplicatedStorage:FindFirstChild("CarModels")
	local m = folder and folder:FindFirstChild(id)
	if m and m:IsA("Model") then
		return m
	end
	return nil
end

local function toDef(x)
	if type(x) == "string" then
		return CarConfig.ById[x]
	elseif type(x) == "table" then
		return x.id and CarConfig.ById[x.id] or (x.typeId and CarConfig.ById[x.typeId]) or nil
	end
	return nil
end

-- downloads the content of these car ids (one PreloadAsync call)
local function preload(ids)
	local models, todo = {}, {}
	for _, id in ipairs(ids) do
		if not loaded[id] then
			local m = realModel(id)
			if m then
				table.insert(models, m)
				table.insert(todo, id)
			elseif VehicleFactory.CarsReady() then
				loaded[id] = true -- procedural car: nothing to download
			end -- else: the server is still installing the models, look again later
		end
	end
	if #models &gt; 0 then
		local ok, err = pcall(function()
			ContentProvider:PreloadAsync(models)
		end)
		if not ok then
			warn("[CarPreload] " .. tostring(err))
		end
	end
	for _, id in ipairs(todo) do
		loaded[id] = true -- also after a failure: never block a reveal on it
	end
end

-- prepares the VehicleFactory template (cached there); the returned clone is not needed
local function warm(def)
	if warmed[def.id] then
		return
	end
	if not realModel(def.id) then
		if VehicleFactory.CarsReady() then
			warmed[def.id] = true -- procedural fallback: built fresh every time, nothing to cache
		end
		return -- (models still installing on the server: warm it on a later pass)
	end
	warmed[def.id] = true
	local ok, m = pcall(VehicleFactory.BuildCar, def, { Low = true })
	if ok and typeof(m) == "Instance" then
		m:Destroy() -- a clone of the cached template: destroying it leaves the template untouched
	elseif not ok then
		warn("[CarPreload] " .. tostring(m))
	end
end

local function isReady(id)
	return loaded[id] == true and warmed[id] == true
end

-- priority: these cars now (content and template), on their own thread
function CarPreload.Ensure(list)
	local defs = {}
	for _, x in ipairs(list or {}) do
		local def = toDef(x)
		if def and not busy[def.id] and not isReady(def.id) then
			busy[def.id] = true
			table.insert(defs, def)
		end
	end
	if #defs == 0 then
		return
	end
	local ids = {}
	for _, def in ipairs(defs) do
		table.insert(ids, def.id)
	end
	task.spawn(function()
		preload(ids)
	end)
	task.spawn(function()
		for i, def in ipairs(defs) do
			warm(def)
			if i &lt; #defs then
				task.wait() -- one template per frame: no long hitch for a big batch
			end
		end
		for _, def in ipairs(defs) do
			busy[def.id] = nil
		end
	end)
end

function CarPreload.IsReady(x)
	local def = toDef(x)
	return def == nil or isReady(def.id)
end

-- yields until the car is downloaded and its template is warm, or `timeout` seconds; true = ready
function CarPreload.Ready(x, timeout)
	local def = toDef(x)
	if not def or isReady(def.id) then
		return true
	end
	CarPreload.Ensure({ def })
	local t0 = os.clock()
	local limit = timeout or 2
	while not isReady(def.id) do
		if os.clock() - t0 &gt;= limit then
			return false
		end
		task.wait(0.05)
	end
	return true
end

-- several cars, one shared deadline
function CarPreload.ReadyAll(list, timeout)
	CarPreload.Ensure(list)
	local t0 = os.clock()
	local limit = timeout or 2
	local all = true
	for _, x in ipairs(list or {}) do
		local left = limit - (os.clock() - t0)
		if left &lt;= 0 then
			return CarPreload.AllReady(list)
		end
		all = CarPreload.Ready(x, left) and all
	end
	return all
end

function CarPreload.AllReady(list)
	for _, x in ipairs(list or {}) do
		if not CarPreload.IsReady(x) then
			return false
		end
	end
	return true
end

-- what to prepare in the background: owned cars (rarest first), then every car of the rarities a full throw of the
-- banked parts reaches with a fair chance (rarest first)
local function plan()
	local st = Store.State
	local out, seen = {}, {}
	local function add(def)
		if def and not seen[def.id] then
			seen[def.id] = true
			table.insert(out, def)
		end
	end
	local function rank(def)
		return CarConfig.Rarities[def.rarity] and CarConfig.Rarities[def.rarity].index or 0
	end
	local owned = {}
	for _, c in ipairs(st and st.cars or {}) do
		local def = CarConfig.ById[c.typeId]
		if def then
			table.insert(owned, def)
		end
	end
	table.sort(owned, function(a, b)
		if rank(a) ~= rank(b) then
			return rank(a) &gt; rank(b)
		end
		return a.id &lt; b.id
	end)
	for _, def in ipairs(owned) do
		add(def)
	end
	-- points of the best throw the banked parts allow (rarest parts first, up to the batch limit)
	local stock = {}
	for id, n in pairs(st and st.parts or {}) do
		local p = PartConfig.Parts[id]
		if p and type(n) == "number" and n &gt; 0 then
			table.insert(stock, { pts = p.points, n = n })
		end
	end
	table.sort(stock, function(a, b)
		return a.pts &gt; b.pts
	end)
	local points, left = 0, EconomyConfig.MaxBatch or 50
	for _, s in ipairs(stock) do
		local take = math.min(s.n, left)
		points = points + take * s.pts
		left = left - take
		if left &lt;= 0 then
			break
		end
	end
	local chances = CarConfig.ChancesForPoints(math.max(points, 1))
	for i = #CarConfig.RarityOrder, 1, -1 do
		local r = CarConfig.RarityOrder[i]
		if (chances[r] or 0) &gt;= 4 then
			for _, def in ipairs(CarConfig.ByRarity[r] or {}) do
				add(def)
			end
		end
	end
	return out
end

local function background()
	while not Store.State do
		task.wait(0.5)
	end
	task.wait(3) -- let the join (map, HUD, intro) settle first
	VehicleFactory.WaitForCars(20) -- the server installs the store cars at start: warm real models, not stand-ins
	while true do
		local caps = CAPS[perfLevel()]
		local list = plan()
		-- 1) content, 4 cars per PreloadAsync
		local batch = {}
		for i = 1, math.min(#list, caps[1]) do
			local id = list[i].id
			if not loaded[id] and not busy[id] then
				table.insert(batch, id)
				if #batch == 4 then
					preload(batch)
					batch = {}
					task.wait(0.3)
				end
			end
		end
		if #batch &gt; 0 then
			preload(batch)
		end
		-- 2) templates, one at a time with a pause (each is a big clone + rescale)
		for i = 1, #list do
			if bgWarmed &gt;= caps[2] then
				break
			end
			local def = list[i]
			if not warmed[def.id] and not busy[def.id] then
				if realModel(def.id) then
					bgWarmed = bgWarmed + 1
				end
				warm(def)
				task.wait(0.2)
			end
		end
		task.wait(20) -- new cars / parts: look again later (done ids are skipped)
	end
end

function CarPreload.Start()
	if started then
		return
	end
	started = true
	task.spawn(function()
		local ok, err = pcall(background)
		if not ok then
			warn("[CarPreload] background stopped: " .. tostring(err))
		end
	end)
end

return CarPreload
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX78DA0032DE124786A76A9E26B103DA0C"><Properties><string name="Name">Checkpoint</string><ProtectedString name="Source">-- Checkpoint choice card: SAVE &amp; GO HOME (bank now, teleport to the garage) or RISK IT (next district, bigger multiplier).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local Util = require(Shared:WaitForChild("Util"))
local Strings = require(Shared:WaitForChild("Strings"))

local T = Strings.T
local CP = {}
local K, UI, Cine
local P
local C = Color3.fromRGB
local open

local function zoneName(z)
	return z and T("zone_" .. z) or ""
end

local function close()
	if open then
		open:Destroy()
		open = nil
		UI.SetDialog(false)
	end
end

local function fmtMult(m)
	return (m % 1 == 0) and string.format("x%d", m) or string.format("x%.1f", m)
end

local function show(o)
	close()
	UI.Sfx("ping")
	local dim = K.new("Frame", { Name = "Checkpoint", Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(0, 0, 0), BackgroundTransparency = 0.55, ZIndex = 78 }, K.overlay) -- v23 layers: under WelcomeBack (80) / JoinFlow (82) / Confirm (85)
	open = dim
	UI.SetDialog(true)
	-- the server only accepts the choice near the checkpoint and within 60 s: the card goes away before that
	local char = Players.LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local from, t0 = hrp and hrp.Position, os.clock()
	task.spawn(function()
		while open == dim do
			task.wait(0.5)
			local h = Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			if open == dim and (os.clock() - t0 &gt; 55 or not h or (from and (h.Position - from).Magnitude &gt; 50)) then
				close()
				UI.Toast("Checkpoint closed - come back to choose again", "warn")
			end
		end
	end)
	-- v23: shared dialog shell (drop shadow, gradient header strip like the panels instead of a flat yellow block)
	local card, shell, head = K.dialogShell(dim, { Size = UDim2.fromOffset(760, 420), Radius = 28, ZIndex = 81, Color = P.yellow, HeadH = 70 })
	local sc = K.new("UIScale", { Scale = 0.6 }, shell)
	K.tween(sc, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	K.text(head, { Text = string.upper(zoneName(o.zone)) .. " CLEARED!", TextSize = 36, Position = UDim2.fromOffset(28, 0), Size = UDim2.new(1, -56, 1, 0), ZIndex = 83, Outline = 3 })
	local banked = math.floor(o.carried * o.combo * o.risk + 0.5)
	K.text(card, { Text = string.format("You carry &lt;b&gt;%d parts&lt;/b&gt;  ·  combo %s  ·  risk %s", o.carried, fmtMult(o.combo), fmtMult(o.risk)), Font = K.BODY, TextSize = 19, TextColor3 = P.ink,
		RichText = true, Position = UDim2.fromOffset(28, 84), Size = UDim2.new(1, -56, 0, 26), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 82 })
	-- two big choice cards
	local function choice(x, color, title, lines, btnText, enabled, onPick)
		-- white card with ink outline + shadow, the choice colour as a top strip (grey when not possible)
		local f = K.card(card, { Position = UDim2.fromOffset(x, 124), Size = UDim2.fromOffset(340, 270), Accent = enabled and color or P.grey, AccentTop = true, AccentSize = 10,
			Radius = 22, ZIndex = 82 })
		K.text(f, { Text = title, TextSize = 28, TextColor3 = enabled and color or P.grey, Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, 0, 0, 34), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 84, Outline = 2 })
		K.text(f, { Text = lines, Font = K.BODY, TextSize = 17, TextColor3 = P.ink, RichText = true, TextWrapped = true, Position = UDim2.fromOffset(18, 48), Size = UDim2.new(1, -36, 0, 110),
			TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 83 })
		K.toy(f, { Text = btnText, Color = enabled and color or P.grey, Size = UDim2.fromOffset(290, 72), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -16), TextSize = 24, ZIndex = 84,
			OnClick = function()
				if enabled then
					close()
					onPick()
				end
			end })
	end
	choice(28, P.green, "SAVE", string.format("Bank your loot now and teleport home.\n\n&lt;b&gt;+%d parts&lt;/b&gt; safe in your garage.", banked), "SAVE &amp; GO HOME", true, function()
		UI.QuietBankUntil = os.clock() + 4 -- the bank that follows plays one soft sound, not a fanfare stack
		Net.Get("CheckpointChoice"):FireServer("save")
	end)
	local riskText, can
	if not o.nextZone then
		riskText, can = "This is the last district. Bank your loot!", false
	elseif not o.nextOpen then
		riskText, can = string.format("Unlock &lt;b&gt;%s&lt;/b&gt; first\n($%s in TELEPORT).", zoneName(o.nextZone), Util.FormatNumber(o.price or 0)), false
	else
		local after = math.floor(o.carried * o.combo * o.nextRisk + 0.5)
		riskText = string.format("Jump to &lt;b&gt;%s&lt;/b&gt; and cross it.\nLoot becomes &lt;b&gt;%s&lt;/b&gt; (%d parts)\n&lt;font color=\"#D6342C\"&gt;one hit = lose everything&lt;/font&gt;", zoneName(o.nextZone), fmtMult(o.nextRisk), after)
		can = true
	end
	choice(392, P.red, "RISK IT", riskText, "RISK &amp; CONTINUE", can, function()
		Net.Get("CheckpointChoice"):FireServer("risk")
	end)
	K.toy(card, { Text = "X", Color = P.red, Size = UDim2.fromOffset(60, 64), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 14, 0, -18), ZIndex = 85, OnClick = close })
end

function CP.Start(ui, cine)
	UI = ui
	K = UI.Kit()
	P = K.P
	Cine = cine
	table.insert(UI.Overlays, close) -- wrecked while the card is up: the card goes away
	Net.Get("CheckpointOffer").OnClientEvent:Connect(show)
	Net.Get("CheckpointFx").OnClientEvent:Connect(function(fx)
		if fx.choice == "risk" then
			Cine.Flash(Color3.fromRGB(255, 80, 60), 0.3, 0.6)
			Cine.Title("RISK " .. fmtMult(fx.risk), Color3.fromRGB(255, 90, 70), 1.2, 110, 0.35)
			UI.Sfx("whoosh")
		else
			Cine.Flash(Color3.fromRGB(80, 220, 120), 0.2, 0.5) -- (the bank sound already played: no second chime)
		end
	end)
end

return CP
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7580DFB9328740D1A4606168DA8688C3"><Properties><string name="Name">CineFx</string><ProtectedString name="Source">-- Cinematic toolkit: camera shake / zoom / takeover, letterbox, darken, flash, glitch, big titles.
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local Cine = {}
local layer, vignette, flash, topBar, botBar, glitchHolder, titleHolder
local cc, blur
local shakes = {}
local scripted = false

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = parent
	return o
end
local function tw(o, t, props, style, dir)
	local x = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	x:Play()
	return x
end

function Cine.Init(gui)
	layer = new("Frame", { Name = "Cine", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 45 }, gui)
	vignette = new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 45, BorderSizePixel = 0 }, layer)
	-- letterbox bars on their own full-screen layer: edge to edge on every device (no safe-area / top-bar inset),
	-- under the main UI so titles and the reveal stay on top of them
	local bars = new("ScreenGui", { Name = "CineBars", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 9, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, gui.Parent)
	pcall(function()
		bars.ScreenInsets = Enum.ScreenInsets.None
	end)
	topBar = new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), Size = UDim2.new(1, 0, 0, 0), BorderSizePixel = 0 }, bars)
	botBar = new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 0), BorderSizePixel = 0 }, bars)
	glitchHolder = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 48, ClipsDescendants = true }, layer)
	titleHolder = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 49 }, layer)
	flash = new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 50, BorderSizePixel = 0 }, layer)
	cc = new("ColorCorrectionEffect", { Name = "CineCC" }, Lighting)
	blur = new("BlurEffect", { Name = "CineBlur", Size = 0 }, Lighting)

	RunService:BindToRenderStep("CineShake", Enum.RenderPriority.Camera.Value + 1, function()
		local cam = Workspace.CurrentCamera
		if not cam then
			return
		end
		local now = os.clock()
		local amp = 0
		for i = #shakes, 1, -1 do
			local s = shakes[i]
			local a = (now - s.t0) / s.dur
			if a &gt;= 1 then
				table.remove(shakes, i)
			else
				amp = amp + s.mag * (1 - a) ^ 2
			end
		end
		-- undo last frame's offset if nothing else moved the camera (scriptable cam without tween)
		if Cine._last and cam.CFrame == Cine._last.result then
			cam.CFrame = Cine._last.base
		end
		Cine._last = nil
		if amp &gt; 0.001 then
			local function r()
				return (math.random() * 2 - 1) * amp
			end
			local base = cam.CFrame
			cam.CFrame = base * CFrame.new(r() * 0.25, r() * 0.25, 0) * CFrame.Angles(math.rad(r()), math.rad(r()), math.rad(r() * 1.4))
			Cine._last = { base = base, result = cam.CFrame }
		end
	end)
end

function Cine.Shake(mag, dur)
	if game:GetService("Players").LocalPlayer:GetAttribute("Opt_shake") == false then
		return -- Settings: camera shake off
	end
	table.insert(shakes, { mag = mag, dur = dur or 0.4, t0 = os.clock() })
end

local flashTween
function Cine.Flash(color, from, t)
	if flashTween then
		flashTween:Cancel() -- a new flash restarts cleanly instead of fighting the previous tween
	end
	flash.BackgroundColor3 = color or Color3.new(1, 1, 1)
	flash.BackgroundTransparency = from or 0
	flashTween = tw(flash, t or 0.4, { BackgroundTransparency = 1 })
end

function Cine.Darken(alpha, t)
	tw(vignette, t or 0.3, { BackgroundTransparency = 1 - alpha })
end

local StarterGui = game:GetService("StarterGui")
function Cine.Letterbox(on, t)
	local h = on and 0.12 or 0 -- a share of the real screen height: the same look on phones, tablets and PCs
	-- the Roblox chat and player list would sit over the bars: hidden while the bars are up
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, not on)
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, not on)
	end)
	tw(topBar, t or 0.35, { Size = UDim2.new(1, 0, h, 0) })
	tw(botBar, t or 0.35, { Size = UDim2.new(1, 0, h, 0) })
end

local glitchOwner = nil -- the running Cine.Glitch (a Grade call cancels its colour restore)
function Cine.Grade(props, t)
	glitchOwner = nil
	tw(cc, t or 0.3, props)
end

function Cine.Blur(size, t)
	tw(blur, t or 0.3, { Size = size })
end

function Cine.Zoom(fov, t, style)
	local cam = Workspace.CurrentCamera
	if cam then
		tw(cam, t or 0.4, { FieldOfView = fov }, style)
	end
end

-- RGB-split glitch: horizontal slices + red/cyan bars + grade flicker
-- "impact" pulse: short colour/contrast flicker + shake (no overlay bars, nothing drawn over the scene)
function Cine.Glitch(dur, power)
	power = power or 1
	task.spawn(function()
		local t0 = os.clock()
		local flip = false
		local tint0, con0 = cc.TintColor, cc.Contrast
		local mine = {}
		glitchOwner = mine
		while os.clock() - t0 &lt; dur and glitchOwner == mine do
			flip = not flip
			cc.TintColor = flip and Color3.fromRGB(255, 225, 225) or Color3.fromRGB(225, 245, 255)
			cc.Contrast = 0.15 * power
			Cine.Shake(0.4 * power, 0.08)
			task.wait(0.06)
		end
		if glitchOwner == mine then -- a later Cine.Grade (death screen) took over: leave its colours alone
			glitchOwner = nil
			cc.TintColor, cc.Contrast = tint0, con0
		end
	end)
end

-- Big punchy title. Only one at a time: a new title replaces the one on screen (they used to draw on top of each other).
local currentTitle
function Cine.Title(text, color, dur, sizePx, yScale)
	if currentTitle and currentTitle.Parent then
		currentTitle:Destroy()
	end
	local holder = new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, yScale or 0.4),
		Size = UDim2.fromOffset(1000, sizePx or 140), ZIndex = 49, Rotation = -3 }, titleHolder)
	local shadow = new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.LuckiestGuy, Text = text, TextScaled = true,
		TextColor3 = Color3.fromRGB(27, 31, 42), TextTransparency = 0.35, Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(6, 8), ZIndex = 49 }, holder)
	local main = new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.LuckiestGuy, Text = text, TextScaled = true,
		TextColor3 = color, Size = UDim2.fromScale(1, 1), ZIndex = 50 }, holder)
	new("UIStroke", { Color = Color3.fromRGB(27, 31, 42), Thickness = 6 }, main)
	new("UIGradient", { Color = ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.45), color), Rotation = 90 }, main)
	currentTitle = holder
	local sc = new("UIScale", { Scale = 2.2 }, holder)
	tw(sc, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(dur or 1.5, function()
		if not holder.Parent then
			return
		end
		tw(sc, 0.2, { Scale = 0.7 })
		tw(main, 0.2, { TextTransparency = 1 })
		tw(shadow, 0.2, { TextTransparency = 1 })
		for _, st in ipairs(main:GetChildren()) do
			if st:IsA("UIStroke") then
				tw(st, 0.2, { Transparency = 1 })
			end
		end
		task.wait(0.22)
		holder:Destroy()
	end)
	return holder
end

-- one subtitle per line (yScale): a new line replaces the old one at the same height, other lines stay
local currentSubs = {}
function Cine.Sub(text, color, dur, yScale)
	local slot = yScale or 0.56
	local old = currentSubs[slot]
	if old and old.Parent then
		old:Destroy()
	end
	local l = new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.LuckiestGuy, Text = text, TextScaled = true, TextColor3 = color,
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, yScale or 0.56), Size = UDim2.fromOffset(1100, 44), ZIndex = 50, TextTransparency = 1 }, titleHolder)
	new("UITextSizeConstraint", { MaxTextSize = 34 }, l) -- long lines shrink instead of running off the screen
	new("UIStroke", { Color = Color3.fromRGB(27, 31, 42), Thickness = 3 }, l)
	currentSubs[slot] = l
	tw(l, 0.25, { TextTransparency = 0 })
	task.delay(dur or 1.5, function()
		if l.Parent then
			tw(l, 0.25, { TextTransparency = 1 })
			task.wait(0.3)
			l:Destroy()
		end
	end)
	return l
end

-- Camera takeover helpers
-- removes every title / subtitle at once (a skipped cinematic must not leave long captions on screen)
function Cine.ClearText()
	if currentTitle and currentTitle.Parent then
		currentTitle:Destroy()
	end
	for k, l in pairs(currentSubs) do
		if l.Parent then
			l:Destroy()
		end
		currentSubs[k] = nil
	end
end

function Cine.Take()
	local cam = Workspace.CurrentCamera
	scripted = true
	cam.CameraType = Enum.CameraType.Scriptable
	return cam
end

function Cine.Move(cf, t, style)
	local cam = Workspace.CurrentCamera
	return tw(cam, t, { CFrame = cf }, style or Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
end

function Cine.Release(t)
	local cam = Workspace.CurrentCamera
	scripted = false
	cam.CameraType = Enum.CameraType.Custom
	Cine.Zoom(70, t or 0.4)
end

function Cine.IsScripted()
	return scripted
end

function Cine.Reset(t)
	t = t or 0.4
	Cine.Darken(0, t)
	Cine.Letterbox(false, t)
	Cine.Grade({ Saturation = 0, Contrast = 0, Brightness = 0, TintColor = Color3.new(1, 1, 1) }, t)
	Cine.Blur(0, t)
end

return Cine
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5FB749082F2249DF91F2EC498D26CA17"><Properties><string name="Name">ClientFx</string><ProtectedString name="Source">-- Small feedback effects: pickups, banking, donations, airbag, the Golden Magnate's coin toss.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local Cine = require(script.Parent:WaitForChild("CineFx"))

local Fx = {}
local K, UI
local C = Color3.fromRGB
local GOLD = C(232, 178, 50)
local SPARK = "rbxasset://textures/particles/sparkles_main.dds"

local function tw(o, t, props, style, dir)
	local x = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	x:Play()
	return x
end

local function anchor(pos)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Transparency = 1
	p.Size = Vector3.one
	p.Position = pos
	p.Parent = Workspace
	return p
end

function Fx.Burst(pos, color, count, speed)
	local p = anchor(pos)
	local e = Instance.new("ParticleEmitter")
	e.Texture = SPARK
	e.Color = ColorSequence.new(color)
	e.LightEmission = 0.6
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0) })
	e.Lifetime = NumberRange.new(0.5, 0.9)
	e.Speed = NumberRange.new(speed or 14, (speed or 14) * 1.6)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Drag = 4
	e.Rate = 0
	e.ZOffset = 1
	e.Parent = p
	e:Emit(count or 20)
	task.delay(1.6, function()
		p:Destroy()
	end)
end

-- floating world text
function Fx.Float(pos, text, color)
	local p = anchor(pos)
	local bb = K.new("BillboardGui", { Adornee = p, AlwaysOnTop = true, Size = UDim2.fromOffset(200, 50), LightInfluence = 0 }, K.gui.Parent)
	local l = K.text(bb, { Text = text, TextSize = 30, TextColor3 = color, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Outline = 3 })
	local sc = K.new("UIScale", { Scale = 0.3 }, l)
	tw(sc, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	tw(p, 1.1, { Position = pos + Vector3.new(0, 6, 0) })
	task.delay(0.7, function()
		tw(l, 0.4, { TextTransparency = 1 })
	end)
	task.delay(1.2, function()
		bb:Destroy()
		p:Destroy()
	end)
end

function Fx.Pickup(info)
	local def = PartConfig.Parts[info.partId]
	local color = def and CarConfig.Rarities[def.rarity].color or GOLD
	Fx.Burst(info.pos + Vector3.new(0, 3, 0), color, info.risk == "road" and 40 or 22)
	Fx.Float(info.pos + Vector3.new(0, 5, 0), "+" .. info.amount .. " " .. (K.PART_ICON[info.partId] or ""), color)
	if info.risk == "road" then
		Cine.Shake(0.4, 0.2)
	end
	UI.Sfx(info.risk == "road" and "pickupBig" or "pickup")
end

-- icons fly from the middle of the screen into the parts row
function Fx.Bank(info)
	local target = UDim2.fromOffset(120, 108)
	local i = 0
	for id, n in pairs(info.parts or {}) do
		for _ = 1, math.min(n, 4) do
			i = i + 1
			local delayT = i * 0.06
			task.delay(delayT, function()
				local l = K.text(K.root, { Text = K.PART_ICON[id] or "⚙️", Font = K.BODY, TextSize = 40, AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.new(0.5, math.random(-60, 60), 0.55, math.random(-30, 30)), Size = UDim2.fromOffset(50, 50),
					TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 45 })
				tw(l, 0.55, { Position = target, TextSize = 22 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				task.delay(0.56, function()
					l:Destroy()
				end)
			end)
		end
	end
	local msg = "+" .. info.moved
	if info.bonus &gt; 0 then
		msg = msg .. "  +" .. info.bonus .. " COMBO"
	end
	if Fx._bankPop and Fx._bankPop.Parent then
		Fx._bankPop:Destroy() -- one "+N" at a time: a quick second bank replaces the first
	end
	local big = K.text(K.root, { Text = msg, TextSize = 46, TextColor3 = K.P.yellow, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(700, 60), TextXAlignment = Enum.TextXAlignment.Center, Outline = 4, ZIndex = 45 })
	local sc = K.new("UIScale", { Scale = 0.2 }, big)
	tw(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	Fx._bankPop = big
	big.Visible = K.state.open == nil -- never draw over an open panel
	task.delay(1.3, function()
		if not big.Parent then
			return
		end
		tw(big, 0.3, { TextTransparency = 1 })
		for _, st in ipairs(big:GetChildren()) do
			if st:IsA("UIStroke") then
				tw(st, 0.3, { Transparency = 1 })
			end
		end
		task.wait(0.32)
		big:Destroy()
	end)
	local quiet = os.clock() &lt; (UI.QuietBankUntil or 0) -- banked through a checkpoint: one soft sound only
	if info.cash and info.cash &gt; 0 then
		UI.Toast("⏱ SPEED BONUS +$" .. info.cash, "good", true)
	end
	if quiet then
		UI.Sfx("soft")
	else
		UI.Sfx(info.bonus &gt; 0 and "bankCombo" or "bank")
	end
end

-- golden coin rain over the screen (buyer) / gold burst (everyone else)
function Fx.Donate(buyer, key)
	if buyer == Players.LocalPlayer then
		for k = 1, 26 do
			task.delay(k * 0.03, function()
				local l = K.text(K.gui, { Text = "🪙", Font = K.BODY, TextSize = math.random(26, 44), Position = UDim2.new(math.random(), 0, -0.1, 0),
					Size = UDim2.fromOffset(50, 50), ZIndex = 55 })
				tw(l, 1.4 + math.random() * 0.6, { Position = UDim2.new(l.Position.X.Scale, 0, 1.1, 0), Rotation = math.random(-200, 200) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				task.delay(2.1, function()
					l:Destroy()
				end)
			end)
		end
		Cine.Flash(GOLD, 0.6, 0.6)
		UI.Sfx("cash")
	end
	local c = buyer and buyer.Character
	local hrp = c and c:FindFirstChild("HumanoidRootPart")
	if hrp then
		Fx.Burst(hrp.Position + Vector3.new(0, 3, 0), GOLD, 50, 20)
	end
end

function Fx.Airbag(dir)
	local c = Players.LocalPlayer.Character
	local hrp = c and c:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.AssemblyLinearVelocity = dir.Unit * 60 + Vector3.new(0, 35, 0)
		Fx.Burst(hrp.Position, C(255, 255, 255), 40, 18)
	end
	Cine.Shake(1.6, 0.4)
	Cine.Flash(C(255, 255, 255), 0.3, 0.4)
	UI.Toast("🛡️ AIRBAG SAVED YOU!", "warn")
	UI.Sfx("airbag")
end

-- the Golden Magnate flips a coin and his hat sparkles
local function magnate()
	local npc
	repeat
		task.wait(2)
		for _, m in ipairs(Workspace:GetChildren()) do
			if m:IsA("Model") and m:GetAttribute("Magnate") then
				npc = m
			end
		end
	until npc
	local hand = npc:FindFirstChild("RightHand")
	local head = npc:FindFirstChild("Head")
	if head then
		local att = Instance.new("Attachment")
		att.Position = Vector3.new(0, 1.4, 0)
		att.Parent = head
		local e = Instance.new("ParticleEmitter")
		e.Texture = SPARK
		e.Color = ColorSequence.new(GOLD)
		e.LightEmission = 0.8
		e.Size = NumberSequence.new(0.35, 0)
		e.Lifetime = NumberRange.new(0.6, 1)
		e.Speed = NumberRange.new(1, 2)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Rate = 4
		e.Parent = att
	end
	while npc.Parent and hand do
		task.wait(3 + math.random() * 2)
		local coin = Instance.new("Part")
		coin.Shape = Enum.PartType.Cylinder
		coin.Size = Vector3.new(0.12, 0.9, 0.9)
		coin.Color = GOLD
		coin.Material = Enum.Material.Metal
		coin.Reflectance = 0.3
		coin.Anchored, coin.CanCollide, coin.CanQuery, coin.CanTouch = true, false, false, false
		local p0 = hand.Position + Vector3.new(0, 0.6, 0)
		coin.CFrame = CFrame.new(p0)
		coin.Parent = Workspace
		local t0 = os.clock()
		local conn
		conn = RunService.RenderStepped:Connect(function()
			local a = (os.clock() - t0) / 0.9
			if a &gt;= 1 or not coin.Parent then
				conn:Disconnect()
				coin:Destroy()
				return
			end
			local h = math.sin(a * math.pi) * 5
			coin.CFrame = CFrame.new(p0 + Vector3.new(0, h, 0)) * CFrame.Angles(a * 25, 0, 0)
		end)
	end
end

function Fx.Init(ui)
	UI = ui
	K = UI.Kit()
	task.spawn(magnate)
end

return Fx
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3A1B737BE9134104823207E87994938E"><Properties><string name="Name">DeathFx</string><ProtectedString name="Source">-- WRECKED! sequence: impact flash, heavy shake, glitch, grayscale-red grade, crane-up camera, countdown.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Strings = require(Shared:WaitForChild("Strings"))
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local Cine = require(script.Parent:WaitForChild("CineFx"))

local DeathFx = {}
local ICON = {}
for id, p in pairs(require(game:GetService("ReplicatedStorage").Shared.PartConfig).Parts) do
	ICON[id] = p.emoji
end
local running = false
local gen = 0 -- one number per death: effects of an older death stop when a newer one starts

function DeathFx.Play(dir, lost, sfx)
	if running then
		return
	end
	running = true
	gen = gen + 1
	local my = gen
	local player = Players.LocalPlayer
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if char then
		DeathFx.Ragdoll(char)
	end
	if hrp then -- the car launches the ragdoll
		hrp.AssemblyLinearVelocity = dir.Unit * 85 + Vector3.new(0, 60, 0)
		hrp.AssemblyAngularVelocity = Vector3.new(math.random(-15, 15), math.random(-15, 15), math.random(-15, 15))
		DeathFx.Shards(hrp.Position)
	end
	if sfx then
		sfx("crash")
		sfx("wrecked")
	end
	-- freeze-frame punch: hard contrast for a beat, then a cold grey grade
	Cine.Grade({ Saturation = -1, Contrast = 0.6, Brightness = 0.15, TintColor = Color3.fromRGB(255, 200, 200) }, 0)
	Cine.Shake(4, 0.7)
	task.delay(0.12, function()
		Cine.Grade({ Saturation = -0.85, Contrast = 0.25, Brightness = -0.05, TintColor = Color3.fromRGB(255, 190, 190) }, 0.4)
	end)
	Cine.Letterbox(true, 0.2)
	Cine.Title(Strings.T("wrecked"), Color3.fromRGB(255, 59, 59), 2.4, 170, 0.36)

	local parts = {}
	for _, id in ipairs(PartConfig.Order) do
		if lost and (lost[id] or 0) &gt; 0 then
			table.insert(parts, (ICON[id] or "") .. " x" .. lost[id])
		end
	end
	task.delay(0.4, function()
		if #parts &gt; 0 then
			Cine.Sub(Strings.T("wrecked_lost", table.concat(parts, "   ")), Color3.fromRGB(255, 210, 63), 2.2, 0.55)
		end
		Cine.Sub(Strings.T("wrecked_safe"), Color3.fromRGB(255, 255, 255), 2.2, 0.62)
	end)

	-- crane shot rising above the crash site
	task.delay(0.25, function()
		if not running or gen ~= my then
			return -- already respawned (fast Quick Start respawn)
		end
		local cam = Cine.Take()
		local focus = hrp and hrp.Position or cam.CFrame.Position
		local from = cam.CFrame
		local t0 = os.clock()
		Cine.Blur(4, 1.5)
		local conn
		conn = RunService.RenderStepped:Connect(function()
			local a = math.min(1, (os.clock() - t0) / 2.6)
			local e = 1 - (1 - a) ^ 3
			local target = CFrame.lookAt(focus + Vector3.new(math.cos(e * 1.2) * 18, 8 + e * 38, math.sin(e * 1.2) * 18), focus)
			cam.CFrame = from:Lerp(target, math.min(1, a * 3)) * CFrame.Angles(0, 0, math.rad(8 * (1 - e)))
			if a &gt;= 1 or not running or gen ~= my then
				conn:Disconnect()
			end
		end)
		for n = 3, 1, -1 do
			task.wait(0.8)
			if not running or gen ~= my then
				return -- back in the game: no countdown over the live HUD
			end
			Cine.Sub(Strings.T("wrecked_back", n), Color3.fromRGB(255, 255, 255), 0.6, 0.7)
		end
	end)
end

-- joints become ball sockets so the body flops (BreakJointsOnDeath is off on the server)
function DeathFx.Ragdoll(char)
	for _, m in ipairs(char:GetDescendants()) do
		if m:IsA("Motor6D") and m.Part0 and m.Part1 and m.Name ~= "Root" then
			local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
			a0.CFrame, a1.CFrame = m.C0, m.C1
			a0.Parent, a1.Parent = m.Part0, m.Part1
			local bs = Instance.new("BallSocketConstraint")
			bs.Attachment0, bs.Attachment1 = a0, a1
			bs.LimitsEnabled = true
			bs.UpperAngle = 70
			bs.TwistLimitsEnabled = true
			bs.TwistLowerAngle, bs.TwistUpperAngle = -45, 45
			bs.Parent = m.Part0
			m.Enabled = false
		end
	end
	for _, p in ipairs(char:GetChildren()) do
		if p:IsA("BasePart") then
			p.CanCollide = p.Name ~= "HumanoidRootPart"
		end
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum:ChangeState(Enum.HumanoidStateType.Physics)
	end
end

-- windscreen shards + dust where the car hit
function DeathFx.Shards(pos)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.Transparency = true, false, false, false, 1
	p.Size = Vector3.one
	p.Position = pos
	p.Parent = workspace
	local glass = Instance.new("ParticleEmitter")
	glass.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	glass.Color = ColorSequence.new(Color3.fromRGB(220, 240, 255), Color3.fromRGB(150, 200, 230))
	glass.Size = NumberSequence.new(0.45, 0.1)
	glass.Lifetime = NumberRange.new(0.8, 1.3)
	glass.Speed = NumberRange.new(18, 34)
	glass.SpreadAngle = Vector2.new(180, 180)
	glass.Acceleration = Vector3.new(0, -60, 0)
	glass.RotSpeed = NumberRange.new(-300, 300)
	glass.LightEmission = 0.4
	glass.Rate = 0
	glass.Parent = p
	glass:Emit(60)
	local dust = Instance.new("ParticleEmitter")
	dust.Texture = "rbxasset://textures/particles/smoke_main.dds"
	dust.Color = ColorSequence.new(Color3.fromRGB(180, 176, 170))
	dust.Size = NumberSequence.new(2, 7)
	dust.Transparency = NumberSequence.new(0.4, 1)
	dust.Lifetime = NumberRange.new(1, 1.6)
	dust.Speed = NumberRange.new(6, 12)
	dust.SpreadAngle = Vector2.new(180, 40)
	dust.Rate = 0
	dust.Parent = p
	dust:Emit(16)
	task.delay(3, function()
		p:Destroy()
	end)
end

-- called on respawn
function DeathFx.Recover()
	if not running then
		return
	end
	running = false
	Cine.Release(0.2)
	Cine.Reset(0.5)
	Cine.Flash(Color3.new(0, 0, 0), 0, 0.6)
end

return DeathFx
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXA556F8E7C922439EB7BFA923D689C6A0"><Properties><string name="Name">GaragePrompts</string><ProtectedString name="Source">-- Own-garage interactions created on this client only: buy the next bay right at the bay,
-- build the next floor at the lift, ride the lift between floors.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BaseLayout = require(Shared:WaitForChild("BaseLayout"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))
local Util = require(Shared:WaitForChild("Util"))
local Net = require(Shared:WaitForChild("Net"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))

local GP = {}
local K, store, Cine
local folder
local sig = ""

local function anchor(name, cf)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
	p.Transparency = 1
	p.Size = Vector3.new(4, 4, 4)
	p.CFrame = cf
	p.Parent = folder
	return p
end

local function prompt(part, action, object, onTrigger)
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = action
	pp.ObjectText = object
	pp.HoldDuration = 0.35
	pp.MaxActivationDistance = 12
	pp.RequiresLineOfSight = false
	pp.Parent = part
	pp.Triggered:Connect(onTrigger)
	return pp
end

local function priceTag(part, text, color)
	local bb = K.new("BillboardGui", { Adornee = part, Size = UDim2.fromOffset(150, 44), StudsOffset = Vector3.new(0, 3, 0), MaxDistance = 80, LightInfluence = 0 }, part)
	local f = K.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = color }, bb)
	K.corner(f, 14)
	K.stroke(f, K.P.ink, 3)
	K.text(f, { Text = text, TextSize = 22, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center })
end

local function ride(targetY, bcf)
	local char = Players.LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end
	if Cine then
		Cine.Flash(Color3.new(0, 0, 0), 0.2, 0.5)
	end
	local dest = bcf * CFrame.new(-15, targetY + 3, BaseLayout.ElevatorLocal.Z)
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.CFrame = CFrame.lookAt(dest.Position, dest.Position + bcf:VectorToWorldSpace(Vector3.new(-1, 0, 0)))
end

local function rebuild()
	local st = store.State
	if not st or not st.baseIndex then
		return
	end
	local floors = st.floors or 1
	local carKey = {}
	for _, c in ipairs(st.cars) do
		if c.slot then
			table.insert(carKey, c.uid .. "@" .. c.slot .. "L" .. c.level)
		end
	end
	table.sort(carKey)
	-- affordability is part of the key: the price tags turn green the moment the money is there
	local canBay = store.Money &gt;= (EconomyConfig.SlotCosts[st.slots + 1] or math.huge)
	local canFloor = store.Money &gt;= (EconomyConfig.FloorCosts[floors + 1] or math.huge)
	local key = table.concat({ st.baseIndex, st.slots, floors, tostring(canBay), tostring(canFloor), table.concat(carKey, ",") }, ":")
	if key == sig then
		return
	end
	sig = key
	folder:ClearAllChildren()
	local bcf = BaseLayout.GetBaseCFrame(st.baseIndex)

	-- next bay: price tag + buy prompt right on the bay
	local nextSlot = st.slots + 1
	if nextSlot &lt;= floors * BaseLayout.SlotsPerFloor and EconomyConfig.SlotCosts[nextSlot] then
		local cost = EconomyConfig.SlotCosts[nextSlot]
		local p = BaseLayout.SlotLocal(nextSlot)
		local a = anchor("BuyBay", bcf * CFrame.new(p.X, BaseLayout.FloorY + p.Y + 2, p.Z))
		priceTag(a, "🔒 $" .. Util.FormatNumber(cost), store.Money &gt;= cost and K.P.green or K.P.grey)
		prompt(a, "Buy bay $" .. Util.FormatNumber(cost), "Parking bay " .. nextSlot, function()
			K.actions.BuySlot(st.slots)
		end)
	end

	-- every parked car: take it out of the garage, or sell it right there
	for _, c in ipairs(st.cars) do
		if c.slot then
			local def = CarConfig.ById[c.typeId]
			local p = BaseLayout.SlotLocal(c.slot)
			local a = anchor("Car" .. c.slot, bcf * CFrame.new(p.X, BaseLayout.FloorY + p.Y + 3, p.Z))
			local rm = prompt(a, "Remove", def and def.name or "Car", function()
				K.actions.Remove(c.uid)
			end)
			rm.KeyboardKeyCode = Enum.KeyCode.E
			rm.MaxActivationDistance = 9
			local price = def and CarConfig.SellPrice(def, c.level) or 0
			local sp = prompt(a, "Sell $" .. Util.FormatNumber(price), def and def.name or "Car", function()
				K.confirm("SELL THIS CAR?", string.format("&lt;b&gt;%s&lt;/b&gt;  Lv %d\nfor &lt;b&gt;$%s&lt;/b&gt;", def.name, c.level, Util.FormatNumber(price)), "SELL $" .. Util.FormatNumber(price), K.P.red, function()
					K.actions.Sell(c.uid)
				end, def)
			end)
			sp.KeyboardKeyCode = Enum.KeyCode.F
			sp.GamepadKeyCode = Enum.KeyCode.ButtonB -- Remove keeps X: both show on a gamepad
			rm.Exclusivity = Enum.ProximityPromptExclusivity.AlwaysShow
			sp.Exclusivity = Enum.ProximityPromptExclusivity.AlwaysShow
			sp.MaxActivationDistance = 9
			sp.UIOffset = Vector2.new(0, 70)
		end
	end

	-- lift: build the next floor, or ride to any built floor
	local el = BaseLayout.ElevatorLocal
	for f = 1, floors do
		local y = (f - 1) * BaseLayout.FloorHeight
		local stop = anchor("LiftStop" .. f, bcf * CFrame.new(f == 1 and el.X or -15, BaseLayout.FloorY + y + 2, el.Z))
		-- one key per destination (1-4), so every ride shows up instead of fighting over E
		for g = 1, floors do
			if g ~= f then
				local pp = prompt(stop, g == 1 and "Ground floor" or ("Level " .. g), "Lift", function()
					ride((g - 1) * BaseLayout.FloorHeight + BaseLayout.FloorY, bcf)
				end)
				pp.KeyboardKeyCode = ({ Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four })[g]
				pp.GamepadKeyCode = ({ Enum.KeyCode.DPadDown, Enum.KeyCode.DPadLeft, Enum.KeyCode.DPadUp, Enum.KeyCode.DPadRight })[g]
				pp.Exclusivity = Enum.ProximityPromptExclusivity.AlwaysShow
			end
		end
	end
	-- BUY NEXT FLOOR: its own panel beside the lift (it used to share the lift's E key and could not be pressed)
	if floors &lt; BaseLayout.MaxFloors then
		local cost = EconomyConfig.FloorCosts[floors + 1]
		local full = st.slots &gt;= floors * BaseLayout.SlotsPerFloor
		local buy = anchor("FloorBuy", bcf * CFrame.new(el.X, BaseLayout.FloorY + 2, el.Z - 9))
		priceTag(buy, (full and "BUY LEVEL " or "LOCKED ") .. (floors + 1) .. "  $" .. Util.FormatNumber(cost), (full and store.Money &gt;= cost) and K.P.orange or K.P.grey)
		local pp = prompt(buy, full and ("Buy level " .. (floors + 1)) or "Fill this floor first", "$" .. Util.FormatNumber(cost), function()
			K.actions.BuyFloor(floors)
		end)
		pp.GamepadKeyCode = Enum.KeyCode.ButtonY -- the lift rides use the D-pad, so one press never does both
		pp.Exclusivity = Enum.ProximityPromptExclusivity.AlwaysShow
	end
end

-- other players' garages are closed to you (no walking in, no stealing); yours stays open
local lastPrivacy
local function privacy(st)
	if lastPrivacy == st.baseIndex then
		return
	end
	lastPrivacy = st.baseIndex
	local map = Workspace:FindFirstChild("GeneratedMap")
	for _, d in ipairs(map and map:GetDescendants() or {}) do
		if d.Name == "PrivacyWall" and d:IsA("BasePart") then
			d.CanCollide = d:GetAttribute("BaseIndex") ~= st.baseIndex
		end
	end
end

function GP.Start(kit, cine)
	K = kit
	store = K.store
	Cine = cine
	folder = Instance.new("Folder")
	folder.Name = "GaragePrompts"
	folder.Parent = Workspace
	store.MoneyChanged.Event:Connect(rebuild) -- price tags turn green as soon as income pays for them (cheap: signature check)
	store.Changed.Event:Connect(function()
		rebuild()
		if store.State and store.State.baseIndex then
			privacy(store.State)
		end
	end)
	rebuild()
	Net.Get("BuyFloor") -- make sure the remote exists before the first click
end

return GP
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6A25C9EA897E4FCDA8273884AF1FC2CC"><Properties><string name="Name">GearFx</string><ProtectedString name="Source">-- Gear auras (v24): every parked car with a running gear glows in that gear's own style; stronger gears look cooler.
-- The server marks the parked car model (GeneratedMap.Bases.BaseNN.Cars.Car_&lt;slot&gt;) with the attributes GearId and
-- GearExp (unix seconds, os.time based). Every client builds the aura locally (Workspace.GearFxLocal), never inside
-- the server's model:
--   tier 1  Nitro Can      blue speed streaks + a small blue light
--   tier 2  Lucky Clover   green sparkles + green underglow + halo ring
--           Cash Turbo     falling gold "coins" + gold underglow + halo ring
--   tier 3  Rocket Boots   cyan lightning arcs + streaks + pulsing ring + light
--   tier 4  Money Storm    gold flame jets + money beam into the sky + wide ground halo + coins
--   tier 5  Golden Engine  golden rays + spinning crown + beam + sparkles + gold outline (Highlight, near cars only)
-- A billboard above the car shows the boost and the time left ("x2 INCOME  9:42").
-- The aura follows its car: every piece is re-pivoted with the model when it moves (v25).
-- Culling: everything that moves or emits switches off beyond 220 studs from the camera; the Highlight only within
-- 60 studs and at most 10 at once (the engine renders 31); Perf LOW = a quarter of the particles and no Highlight.
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GearConfig = require(Shared:WaitForChild("GearConfig"))
local Icons = require(Shared:WaitForChild("Icons"))
local Perf = require(script.Parent:WaitForChild("Perf"))

local GearFx = {}

local C = Color3.fromRGB
local WHITE = C(255, 255, 255)
local GOLD = C(255, 205, 60)
local CULL = 220
local HL_DIST, HL_MAX = 60, 10
local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"
local TAU = math.pi * 2

local entries = {} -- [car model] = entry
local folders = {} -- [the "Cars" folder of a garage] = true
local fxRoot
local hlCount = 0

local function fmtTime(sec)
	sec = math.max(0, math.floor(sec))
	return string.format("%d:%02d", math.floor(sec / 60), sec % 60)
end

local function seq(a, b)
	return NumberSequence.new(a, b)
end

---------------------------------------------------------------- building blocks
local function part(e, name, size, cf, color, o)
	o = o or {}
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = o.mat or Enum.Material.Neon
	p.Transparency = o.t or 0
	if o.shape then
		p.Shape = o.shape
	end
	p.Anchored = true
	p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = false, false, false, false
	p.Massless = true
	p.Parent = e.folder
	return p
end

-- invisible carrier for attachments / emitters
local function ghost(e, name, size, cf)
	return part(e, name, size, cf, WHITE, { t = 1, mat = Enum.Material.SmoothPlastic })
end

local function att(parent, pos)
	local a = Instance.new("Attachment")
	a.Position = pos or Vector3.zero
	a.Parent = parent
	return a
end

local function emitter(e, parent, props)
	local pe = Instance.new("ParticleEmitter")
	pe.LightEmission = 1
	pe.LightInfluence = 0
	pe.Texture = SPARKLE
	for k, v in pairs(props) do
		pe[k] = v
	end
	pe:SetAttribute("BaseRate", pe.Rate)
	pe.Parent = parent
	table.insert(e.emitters, pe)
	return pe
end

local function light(e, parent, color, range, brightness)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Parent = parent
	table.insert(e.lights, l)
	return l
end

local function beam(e, a0, a1, props)
	local b = Instance.new("Beam")
	b.Attachment0, b.Attachment1 = a0, a1
	b.LightEmission = 1
	b.LightInfluence = 0
	b.FaceCamera = true
	b.Segments = 12
	for k, v in pairs(props) do
		b[k] = v
	end
	b.Parent = a0.Parent
	table.insert(e.beams, b)
	return b
end

-- a flat neon loop (ellipse rx x rz) lying y studs above the ground, built from n short segments
local function ring(e, name, rx, rz, y, width, thick, color, n, t)
	local segs = {}
	for i = 0, n - 1 do
		local a0, a1 = i / n * TAU, (i + 1) / n * TAU
		local p0 = Vector3.new(rx * math.cos(a0), 0, rz * math.sin(a0))
		local p1 = Vector3.new(rx * math.cos(a1), 0, rz * math.sin(a1))
		local mid = (p0 + p1) / 2
		local seg = part(e, name, Vector3.new(width, thick, (p1 - p0).Magnitude + 0.06), e.ground * CFrame.new(0, y, 0) * CFrame.lookAt(mid, mid + (p1 - p0)), color, { t = t })
		table.insert(segs, seg)
	end
	return segs
end

-- glow under the car: a thin neon slab (mostly hidden by the body) + a light that paints the bay floor
local function underglow(e, color, brightness)
	part(e, "Underglow", Vector3.new(e.L * 0.8, 0.06, e.W * 0.7), e.ground * CFrame.new(0, 0.24, 0), color, { t = 0.15 })
	light(e, att(e.core, Vector3.new(0, 0.6, 0)), color, math.max(e.L, e.W) * 0.9, brightness or 2)
end

-- particles filling the car's volume
local function volume(e)
	if not e.vol then
		e.vol = ghost(e, "Volume", Vector3.new(e.L, e.H, e.W), e.ground * CFrame.new(0, e.H / 2, 0))
	end
	return e.vol
end

local function streaks(e, color, rate, speed)
	emitter(e, volume(e), {
		Color = ColorSequence.new(WHITE, color), Size = seq(0.35, 0.1), Transparency = seq(0.1, 1), Squash = NumberSequence.new(2.5),
		Orientation = Enum.ParticleOrientation.VelocityParallel, EmissionDirection = e.back, Speed = NumberRange.new(speed, speed + 8),
		Lifetime = NumberRange.new(0.25, 0.45), Rate = rate, SpreadAngle = Vector2.new(2, 2),
	})
end

local function sparkles(e, color, rate, rise)
	emitter(e, volume(e), {
		Color = ColorSequence.new(WHITE, color), Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 0.55), NumberSequenceKeypoint.new(1, 0) }),
		Transparency = seq(0, 0.3), EmissionDirection = Enum.NormalId.Top, Speed = NumberRange.new(rise * 0.5, rise), Lifetime = NumberRange.new(0.8, 1.4),
		Rate = rate, SpreadAngle = Vector2.new(30, 30), Rotation = NumberRange.new(0, 360), RotSpeed = NumberRange.new(-120, 120),
	})
end

-- gold "coins": spinning flat sparkles raining down onto the car
local function coins(e, rate)
	local sky = ghost(e, "CoinSky", Vector3.new(e.L * 0.9, 0.2, e.W * 0.9), e.ground * CFrame.new(0, e.H + 3, 0))
	emitter(e, sky, {
		Color = ColorSequence.new(C(255, 236, 120), C(232, 168, 30)), Size = NumberSequence.new(0.45), Squash = NumberSequence.new(-1.2),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.15, 0), NumberSequenceKeypoint.new(0.85, 0), NumberSequenceKeypoint.new(1, 1) }),
		EmissionDirection = Enum.NormalId.Bottom, Speed = NumberRange.new(2, 4), Acceleration = Vector3.new(0, -6, 0), Lifetime = NumberRange.new(0.9, 1.2),
		Rate = rate, Rotation = NumberRange.new(0, 360), RotSpeed = NumberRange.new(-300, 300), LightEmission = 0.6,
	})
end

---------------------------------------------------------------- the auras
local BUILD = {}

BUILD.nitro = function(e, def)
	streaks(e, def.color, 22, 16)
	light(e, att(e.core, Vector3.new(0, e.H * 0.5, 0)), def.color, 10, 1.5)
end

BUILD.clover = function(e, def)
	sparkles(e, def.color, 14, 3)
	emitter(e, volume(e), { -- a few slow, big "leaves"
		Color = ColorSequence.new(C(120, 240, 130), C(40, 180, 70)), Size = seq(0.7, 0.2), Transparency = seq(0.2, 1), EmissionDirection = Enum.NormalId.Top,
		Speed = NumberRange.new(1, 2), Lifetime = NumberRange.new(1.5, 2.2), Rate = 3, Rotation = NumberRange.new(0, 360), RotSpeed = NumberRange.new(-40, 40), LightEmission = 0.4,
	})
	underglow(e, def.color, 2)
	e.halo = ring(e, "Halo", e.L / 2 + 0.9, e.W / 2 + 0.9, 0.2, 0.22, 0.06, def.color, 24, 0.2)
end

BUILD.cashturbo = function(e, def)
	coins(e, 10)
	sparkles(e, GOLD, 6, 2)
	underglow(e, GOLD, 2)
	e.halo = ring(e, "Halo", e.L / 2 + 0.9, e.W / 2 + 0.9, 0.2, 0.22, 0.06, GOLD, 24, 0.2)
end

BUILD.rocket = function(e, def)
	streaks(e, def.color, 30, 22)
	underglow(e, def.color, 2.5)
	e.pulse = ring(e, "PulseRing", e.L / 2 + 1.1, e.W / 2 + 1.1, 0.21, 0.3, 0.07, def.color, 28, 0.1)
	light(e, att(e.core, Vector3.new(0, e.H + 1, 0)), def.color, 16, 2)
	-- lightning: arcs from the roof down to the ring, re-bent several times a second (see animate)
	e.arcs = {}
	for k = 0, 3 do
		local a = k / 4 * TAU + 0.4
		local top = att(e.core, Vector3.new(math.cos(a) * e.L * 0.2, e.H + 0.3, math.sin(a) * e.W * 0.2))
		local bottom = att(e.core, Vector3.new(math.cos(a) * (e.L / 2 + 1.1), 0.15, math.sin(a) * (e.W / 2 + 1.1)))
		table.insert(e.arcs, beam(e, top, bottom, { Color = ColorSequence.new(WHITE, def.color), Width0 = 0.25, Width1 = 0.12, Transparency = seq(0, 0.2), Segments = 16 }))
	end
end

local function moneyBeam(e, color, height, width)
	local a0 = att(e.core, Vector3.new(0, 0.3, 0))
	local a1 = att(e.core, Vector3.new(0, height, 0))
	beam(e, a0, a1, { Color = ColorSequence.new(color), Width0 = width, Width1 = width * 0.45, Transparency = seq(0.55, 1) })
	beam(e, a0, a1, { Color = ColorSequence.new(WHITE, color), Width0 = width * 0.9, Width1 = width * 0.4, Transparency = seq(0.1, 1), Texture = SPARKLE,
		TextureMode = Enum.TextureMode.Wrap, TextureLength = 3, TextureSpeed = 1.2 })
end

BUILD.moneystorm = function(e, def)
	-- flame jets round the car
	local n = 8
	for k = 0, n - 1 do
		local a = k / n * TAU
		local jet = att(e.core, Vector3.new(math.cos(a) * (e.L / 2 + 1.4), 0.2, math.sin(a) * (e.W / 2 + 1.4)))
		emitter(e, jet, {
			Texture = FIRE, Color = ColorSequence.new(C(255, 230, 120), C(255, 140, 20)), Size = seq(1.1, 0.2), Transparency = seq(0.2, 1),
			EmissionDirection = Enum.NormalId.Top, Speed = NumberRange.new(4, 7), Lifetime = NumberRange.new(0.5, 0.8), Rate = 7, SpreadAngle = Vector2.new(10, 10),
			Acceleration = Vector3.new(0, 3, 0), Rotation = NumberRange.new(0, 360), RotSpeed = NumberRange.new(-90, 90),
		})
	end
	coins(e, 14)
	moneyBeam(e, GOLD, 40, 2.6)
	underglow(e, GOLD, 2.5)
	e.pulse = ring(e, "Halo", e.L / 2 + 1.4, e.W / 2 + 1.4, 0.21, 0.35, 0.07, GOLD, 30, 0.1)
	ring(e, "OuterHalo", e.L / 2 + 2.3, e.W / 2 + 2.3, 0.19, 0.18, 0.06, C(255, 160, 40), 30, 0.35)
	light(e, att(e.core, Vector3.new(0, e.H + 1.5, 0)), GOLD, 18, 2)
end

BUILD.goldengine = function(e, def)
	local col = def.color
	-- golden rays fanning out of the car
	local base = att(e.core, Vector3.new(0, e.H * 0.6, 0))
	for k = 0, 5 do
		local a = k / 6 * TAU
		local tip = att(e.core, Vector3.new(math.cos(a) * (e.L / 2 + 5), e.H + 7, math.sin(a) * (e.W / 2 + 5)))
		beam(e, base, tip, { Color = ColorSequence.new(C(255, 250, 200), col), Width0 = 0.6, Width1 = 3.2, Transparency = seq(0.35, 1), Segments = 4 })
	end
	moneyBeam(e, col, 48, 3)
	sparkles(e, col, 22, 4)
	coins(e, 10)
	underglow(e, col, 3)
	e.pulse = ring(e, "Halo", e.L / 2 + 1.4, e.W / 2 + 1.4, 0.21, 0.35, 0.07, col, 30, 0.1)
	ring(e, "OuterHalo", e.L / 2 + 2.4, e.W / 2 + 2.4, 0.19, 0.2, 0.06, C(255, 240, 160), 30, 0.3)
	light(e, att(e.core, Vector3.new(0, e.H + 2, 0)), col, 20, 2.5)
	-- spinning crown above the roof: band + spikes with gem tips (moved every frame, see animate)
	local r = math.min(e.L, e.W) * 0.32 + 0.6
	local centre = e.ground * CFrame.new(0, e.H + 2.4, 0)
	e.crownCF, e.crown, e.crownOff = centre, {}, {}
	local function add(p, off)
		table.insert(e.crown, p)
		table.insert(e.crownOff, off)
	end
	local n = 16
	for i = 0, n - 1 do
		local a0, a1 = i / n * TAU, (i + 1) / n * TAU
		local p0 = Vector3.new(r * math.cos(a0), 0, r * math.sin(a0))
		local p1 = Vector3.new(r * math.cos(a1), 0, r * math.sin(a1))
		local mid = (p0 + p1) / 2
		local off = CFrame.lookAt(mid, mid + (p1 - p0))
		add(part(e, "CrownBand", Vector3.new(0.18, 0.5, (p1 - p0).Magnitude + 0.05), centre * off, col, { mat = Enum.Material.Metal }), off)
	end
	for i = 0, 7 do
		local a = i / 8 * TAU
		local off = CFrame.new(r * math.cos(a), 0.65, r * math.sin(a)) * CFrame.Angles(0, -a, 0)
		add(part(e, "CrownSpike", Vector3.new(0.22, 0.85, 0.22), centre * off, col, { mat = Enum.Material.Metal }), off)
		local gem = CFrame.new(r * math.cos(a), 1.2, r * math.sin(a))
		add(part(e, "CrownGem", Vector3.new(0.34, 0.34, 0.34), centre * gem, (i % 2 == 0) and C(255, 70, 90) or C(80, 200, 255), { shape = Enum.PartType.Ball }), gem)
	end
	e.wantsHighlight = true
end

---------------------------------------------------------------- billboard
local function billboard(e, def)
	local gui = Instance.new("BillboardGui")
	gui.Name = "GearTag"
	gui.Adornee = e.core
	gui.Size = UDim2.fromOffset(196, 52)
	gui.StudsOffsetWorldSpace = Vector3.new(0, e.H + (e.crown and 6.4 or 5), 0) -- clear of the server name tag (height + 2)
	gui.LightInfluence = 0
	gui.MaxDistance = 90
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = C(20, 22, 30)
	bg.BackgroundTransparency = 0.2
	bg.Parent = gui
	Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 16)
	local st = Instance.new("UIStroke")
	st.Color = def.color
	st.Thickness = 2.5
	st.Parent = bg
	local img = Icons.Get("gear_" .. def.id)
	local icon
	if img then
		icon = Instance.new("ImageLabel")
		icon.Image = img
		icon.ScaleType = Enum.ScaleType.Fit
	else
		icon = Instance.new("TextLabel")
		icon.Text = def.icon
		icon.Font = Enum.Font.FredokaOne
		icon.TextScaled = true
	end
	icon.BackgroundTransparency = 1
	icon.Position = UDim2.fromOffset(5, 5)
	icon.Size = UDim2.fromOffset(42, 42)
	icon.Parent = bg
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromOffset(52, 4)
	label.Size = UDim2.new(1, -58, 0, 24)
	label.Font = Enum.Font.LuckiestGuy
	label.TextScaled = true
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextColor3 = def.color
	label.Text = GearConfig.Label(def)
	label.Parent = bg
	local ls = Instance.new("UIStroke")
	ls.Color = C(0, 0, 0)
	ls.Thickness = 1.5
	ls.Parent = label
	local timer = Instance.new("TextLabel")
	timer.BackgroundTransparency = 1
	timer.Position = UDim2.fromOffset(52, 28)
	timer.Size = UDim2.new(1, -58, 0, 20)
	timer.Font = Enum.Font.FredokaOne
	timer.TextScaled = true
	timer.TextXAlignment = Enum.TextXAlignment.Left
	timer.TextColor3 = WHITE
	timer.Text = ""
	timer.Parent = bg
	gui.Parent = e.core
	e.timer = timer
end

---------------------------------------------------------------- lifecycle
local function destroy(e)
	if e.highlight then
		e.highlight:Destroy()
		e.highlight = nil
		hlCount = hlCount - 1
	end
	if e.folder then
		e.folder:Destroy()
	end
end

local function build(model, def)
	local ok, cf, size = pcall(model.GetBoundingBox, model)
	if not ok or not cf or size.Magnitude &lt; 2 then
		return nil -- still streaming in / being built: retried on the next scan
	end
	local e = { model = model, id = def.id, tier = def.tier, emitters = {}, lights = {}, beams = {}, on = nil, low = nil }
	e.folder = Instance.new("Folder")
	e.folder.Name = "Gear_" .. def.id
	-- flat frame on the bay floor under the car (parked cars stand upright; the box keeps the car's heading)
	local pos = cf.Position - Vector3.new(0, size.Y / 2, 0)
	local look = cf.LookVector
	look = Vector3.new(look.X, 0, look.Z)
	if look.Magnitude &lt; 0.01 then
		look = Vector3.new(0, 0, -1)
	end
	e.ground = CFrame.lookAt(pos, pos + look.Unit)
	e.L, e.W, e.H = size.X, size.Z, size.Y
	e.center = cf.Position
	-- car length along local X (the rear at -X, see BaseService); streaks fly out of the back
	e.back = (size.Z &gt; size.X) and Enum.NormalId.Back or Enum.NormalId.Left
	e.core = ghost(e, "Core", Vector3.new(0.4, 0.4, 0.4), e.ground)
	local fn = BUILD[def.id]
	if fn then
		fn(e, def)
	else
		sparkles(e, def.color, 12, 3)
	end
	billboard(e, def)
	-- follow the car (v25): every piece is stored relative to the model's pivot; animate() re-pivots them with one
	-- BulkMoveTo whenever the car moves (re-parked, spawned in, repositioned). Attachments, beams, lights and the
	-- billboard ride on the parts.
	local pivot = model:GetPivot()
	e.pivot, e.parts, e.offsets = pivot, {}, {}
	for _, d in ipairs(e.folder:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(e.parts, d)
			table.insert(e.offsets, pivot:ToObjectSpace(d.CFrame))
		end
	end
	e.centerLocal = pivot:PointToObjectSpace(e.center)
	if e.crownCF then
		e.crownLocal = pivot:ToObjectSpace(e.crownCF)
	end
	e.folder.Parent = fxRoot
	return e
end

-- re-pivots an aura that no longer sits where its car is
local function follow(e)
	local m = e.model
	if not m.Parent then
		return
	end
	local ok, cur = pcall(m.GetPivot, m)
	if not ok then
		return
	end
	local old = e.pivot
	if (cur.Position - old.Position).Magnitude &lt; 0.02 and cur.LookVector:Dot(old.LookVector) &gt; 0.99995 and cur.UpVector:Dot(old.UpVector) &gt; 0.99995 then
		return
	end
	e.pivot = cur
	local cfs = table.create(#e.parts)
	local live, n = {}, 0
	for i, p in ipairs(e.parts) do
		if p.Parent then
			n = n + 1
			live[n], cfs[n] = p, cur * e.offsets[i]
		end
	end
	if n &gt; 0 then
		Workspace:BulkMoveTo(live, cfs, Enum.BulkMoveMode.FireCFrameChanged)
	end
	e.center = cur:PointToWorldSpace(e.centerLocal)
	if e.crownLocal then
		e.crownCF = cur * e.crownLocal
	end
end

-- emitters / beams / lights on or off (distance cull); LOW graphics run a quarter of the particles
local function setActive(e, on, low)
	if e.on == on and e.low == low then
		return
	end
	e.on, e.low = on, low
	for _, pe in ipairs(e.emitters) do
		pe.Enabled = on
		pe.Rate = (pe:GetAttribute("BaseRate") or 10) * (low and 0.25 or 1)
	end
	for _, b in ipairs(e.beams) do
		b.Enabled = on
	end
	for _, l in ipairs(e.lights) do
		l.Enabled = on
	end
end

local function scan()
	local now = Workspace:GetServerTimeNow()
	local low = Perf.Level() == "LOW"
	local seen = {}
	for folder in pairs(folders) do
		if folder.Parent then
			for _, m in ipairs(folder:GetChildren()) do
				if m:IsA("Model") then
					local id = m:GetAttribute("GearId")
					local exp = tonumber(m:GetAttribute("GearExp"))
					local def = type(id) == "string" and GearConfig.ById[id] or nil
					if def and exp and exp &gt; now then
						local e = entries[m]
						if e and e.id ~= id then
							destroy(e)
							entries[m] = nil
							e = nil
						end
						if not e then
							e = build(m, def)
							entries[m] = e
						end
						if e then
							seen[m] = true
							e.exp = exp
						end
					end
				end
			end
		else
			folders[folder] = nil
		end
	end
	for m, e in pairs(entries) do
		if not seen[m] or not m.Parent then
			destroy(e)
			entries[m] = nil
		end
	end
	-- distance cull, timers, and the nearest golden cars get the outline
	local cam = Workspace.CurrentCamera
	local cp = cam and cam.CFrame.Position
	local cands = {}
	for _, e in pairs(entries) do
		local d = cp and (e.center - cp).Magnitude or 0
		setActive(e, d &lt;= CULL, low)
		e.timer.Text = fmtTime(e.exp - now)
		e.timer.TextColor3 = (e.exp - now) &lt;= 30 and C(255, 120, 100) or WHITE
		if e.wantsHighlight and not low and d &lt;= HL_DIST then
			table.insert(cands, { e = e, d = d })
		elseif e.highlight then
			e.highlight:Destroy()
			e.highlight = nil
			hlCount = hlCount - 1
		end
	end
	table.sort(cands, function(a, b)
		return a.d &lt; b.d
	end)
	for i, c in ipairs(cands) do
		local e = c.e
		if i &gt; HL_MAX and e.highlight then
			e.highlight:Destroy()
			e.highlight = nil
			hlCount = hlCount - 1
		end
	end
	for i = 1, math.min(#cands, HL_MAX) do
		local e = cands[i].e
		if not e.highlight and hlCount &lt; HL_MAX then
			local h = Instance.new("Highlight")
			h.Adornee = e.model
			h.FillColor = GOLD
			h.FillTransparency = 0.88
			h.OutlineColor = C(255, 220, 90)
			h.OutlineTransparency = 0
			h.DepthMode = Enum.HighlightDepthMode.Occluded
			h.Parent = e.folder
			e.highlight = h
			hlCount = hlCount + 1
		end
	end
end

local lastArc, lastPulse = 0, 0
local function animate()
	local t = os.clock()
	local doArc = t - lastArc &gt;= 0.12
	local doPulse = t - lastPulse &gt;= 0.05
	if doArc then
		lastArc = t
	end
	if doPulse then
		lastPulse = t
	end
	for _, e in pairs(entries) do
		follow(e)
		if e.on then
			if e.crown then
				local centre = e.crownCF * CFrame.Angles(0, t * 0.9, 0) + Vector3.new(0, math.sin(t * 2) * 0.15, 0)
				local cfs = table.create(#e.crown)
				for i, off in ipairs(e.crownOff) do
					cfs[i] = centre * off
				end
				Workspace:BulkMoveTo(e.crown, cfs, Enum.BulkMoveMode.FireCFrameChanged)
			end
			if doArc and e.arcs then
				for _, b in ipairs(e.arcs) do
					b.CurveSize0 = math.random(-30, 30) / 10
					b.CurveSize1 = math.random(-30, 30) / 10
					b.Transparency = NumberSequence.new(math.random() &lt; 0.25 and 0.7 or 0, 0.3)
				end
			end
			if doPulse and e.pulse then
				local k = 0.5 + 0.5 * math.sin(t * (e.tier &gt;= 4 and 3 or 5))
				for _, p in ipairs(e.pulse) do
					p.Transparency = 0.05 + 0.45 * k
				end
			end
		end
	end
end

function GearFx.Start()
	fxRoot = Instance.new("Folder")
	fxRoot.Name = "GearFxLocal"
	fxRoot.Parent = Workspace
	task.spawn(function()
		local map = Workspace:WaitForChild("GeneratedMap", 120)
		local bases = map and map:WaitForChild("Bases", 60)
		if not bases then
			return
		end
		for _, d in ipairs(bases:GetDescendants()) do
			if d.Name == "Cars" and d:IsA("Folder") then
				folders[d] = true
			end
		end
		bases.DescendantAdded:Connect(function(d)
			if d.Name == "Cars" and d:IsA("Folder") then
				folders[d] = true
			end
		end)
		while true do
			local ok, err = pcall(scan)
			if not ok then
				warn("[GearFx] " .. tostring(err))
			end
			task.wait(0.5)
		end
	end)
	RunService.Heartbeat:Connect(animate)
end

return GearFx
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9126DB3B402A4E50B5C93F25DB7FFF87"><Properties><string name="Name">IntroFx</string><ProtectedString name="Source">-- Intro cinematic for new players (before the step-by-step tutorial), with SKIP. Six scenes on the real map, a copy of
-- the player's avatar acts them out:
--   1 a tour of the hub (Pit Stop, Leaderboard, Big Tony's Gears)
--   2 crossing a city road between the cars and grabbing a glowing part
--   3 throwing it at the platform: flash, a car drives into the garage
--   4 Big Tony's GEARS: timed boosts, a geared car gets a glowing aura
--   5 upgrading the platform for more luck
--   6 a fly-over of the districts and a boss monster truck
-- Every scene checks its own models and is skipped (or played without them) when one is missing; a scene that errors
-- is skipped too, the intro goes on with the next one.
-- Played by JoinFlow when a new player answers YES: when it ends (or is skipped) the tutorial moves to step 1.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local BaseLayout = require(Shared:WaitForChild("BaseLayout"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local TrapConfig = require(Shared:WaitForChild("TrapConfig"))
local PartVisual = require(Shared:WaitForChild("PartVisual"))
local VehicleFactory = require(Shared:WaitForChild("VehicleFactory"))

local Intro = {}
local UI, Cine, K
local RUN_ANIM = "rbxassetid://913376220" -- Roblox default R15 run
local skipped = false
local trash = {}

local function keep(x)
	table.insert(trash, x)
	return x
end

-- waits, but returns false at once when SKIP was pressed
local function wait(t)
	local t0 = os.clock()
	while os.clock() - t0 &lt; t do
		if skipped then
			return false
		end
		RunService.RenderStepped:Wait()
	end
	return not skipped
end

-- smooth camera: every frame eases toward the target CFrame (target may be a function of time)
local cam, camTarget, camConn
local function camTo(cf, snap)
	camTarget = cf
	if snap then
		cam.CFrame = cf
	end
end

local function makeActor()
	local char = Players.LocalPlayer.Character
	if not char then
		return nil
	end
	char.Archivable = true
	local a = char:Clone()
	if not a or not a:FindFirstChild("HumanoidRootPart") then
		if a then
			a:Destroy()
		end
		return nil
	end
	for _, d in ipairs(a:GetDescendants()) do
		if d:IsA("LuaSourceContainer") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.CanCollide = false
		end
	end
	local hum = a:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	a.HumanoidRootPart.Anchored = true
	a.Parent = Workspace
	keep(a)
	local animator = hum and (hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum))
	local track
	if animator then
		local anim = Instance.new("Animation")
		anim.AnimationId = RUN_ANIM
		track = animator:LoadAnimation(anim)
	end
	return a, track
end

-- actor runs from a to b in t seconds, facing the way it goes
local function run(actor, track, a, b, t)
	local y = actor:GetExtentsSize().Y / 2
	local face = CFrame.lookAt(a, Vector3.new(b.X, a.Y, b.Z)) - a
	if track then
		track:Play(0.1)
	end
	local t0 = os.clock()
	while true do
		local k = math.min(1, (os.clock() - t0) / t)
		actor:PivotTo(CFrame.new(a:Lerp(b, k) + Vector3.new(0, y, 0)) * face)
		if k &gt;= 1 or skipped then
			break
		end
		RunService.RenderStepped:Wait()
	end
	if track then
		track:Stop(0.15)
	end
	return not skipped
end

-- numbered, long captions: a scene keeps its title + subtitle on screen for its whole length
local STEPS = 6
local function caption(step, title, sub, dur, titleDur)
	Cine.Title(string.format("STEP %d/%d  %s", step, STEPS, title), Color3.fromRGB(255, 210, 63), titleDur or dur, 72, 0.2)
	Cine.Sub(sub, Color3.new(1, 1, 1), dur, 0.82)
end
-- the next subtitle of the same scene (replaces the current one)
local function say(sub, dur)
	Cine.Sub(sub, Color3.new(1, 1, 1), dur, 0.82)
end
-- vehicles are posed by their Root (forward = local +X), like TrapFx / traffic; the model pivot is not aligned
local function faceCF(pos, dir)
	return CFrame.new(pos) * CFrame.Angles(0, math.atan2(-dir.Z, dir.X), 0)
end
-- runs fn(t) every frame for dur seconds (camera moves); false when SKIP was pressed
local function during(dur, fn)
	local t0 = os.clock()
	while not skipped do
		local t = os.clock() - t0
		fn(t)
		if t &gt;= dur then
			break
		end
		RunService.RenderStepped:Wait()
	end
	return not skipped
end
local function smooth(k)
	k = math.clamp(k, 0, 1)
	return k * k * (3 - 2 * k)
end
-- a showcase car (nil when it can't be built); never throws
local function showCar(rarity)
	local ok, car = pcall(function()
		local pool = CarConfig.ByRarity[rarity] or CarConfig.ByRarity.Rare
		local def = pool and pool[1]
		return def and VehicleFactory.BuildCar(def)
	end)
	if ok and car and car.PrimaryPart then
		return keep(car)
	elseif ok and car then
		car:Destroy()
	end
	return nil
end
local function trapPadOf(idx)
	local map = Workspace:FindFirstChild("GeneratedMap")
	local bases = map and map:FindFirstChild("Bases")
	local base = bases and bases:FindFirstChild(string.format("Base%02d", idx), true)
	return base and base:FindFirstChild("TrapPad")
end

-- 1) the hub: a high orbit, then the camera turns from stand to stand around the fountain
local function sceneHub()
	local hub = MapConfig.Hub
	if not hub then
		return true
	end
	local centre = Vector3.new(hub.x, hub.top or 0, hub.z)
	local tour = {}
	for _, stop in ipairs({
		{ MapConfig.Shop, "PIT STOP  -  perks: run faster, carry more, catch more cars" },
		{ MapConfig.Leaderboard, "LEADERBOARD  -  the top hunters on this server" },
		{ MapConfig.Tony, "BIG TONY'S GEARS  -  huge timed boosts for your cars" },
	}) do
		if stop[1] and stop[1].angle then
			table.insert(tour, stop)
		end
	end
	local HOLD, MOVE = 2.9, 1.1
	caption(1, "WELCOME TO THE HUB", "Your home square: shops, gears and jobs - no traffic here", 3, 3 + #tour * HOLD)
	if not during(3, function(t)
		local a = 0.9 + t * 0.12
		camTo(CFrame.lookAt(centre + Vector3.new(math.cos(a) * 95, 48, math.sin(a) * 95), centre + Vector3.new(0, 4, 0)), t &lt; 0.05)
	end) then
		return false
	end
	-- the stands are listed by rising angle, so the camera always turns the same way round (never through the fountain)
	local prev
	for _, stop in ipairs(tour) do
		local cfg = stop[1]
		local a1 = math.rad(cfg.angle)
		local a0 = prev or (a1 - 0.5)
		local r = cfg.r or 45
		say(stop[2], HOLD)
		if not during(HOLD, function(t)
			local ang = t &lt; MOVE and a0 + (a1 - a0) * smooth(t / MOVE) or a1 + (t - MOVE) * 0.04
			local dir = Vector3.new(math.cos(ang), 0, math.sin(ang))
			camTo(CFrame.lookAt(centre + dir * 20 + Vector3.new(0, 12, 0), centre + dir * r + Vector3.new(0, 6, 0)))
		end) then
			return false
		end
		prev = a1 + (HOLD - MOVE) * 0.04
	end
	return true
end

-- 2) the city road: run across between the cars, grab a glowing part
local function sceneParts(actor, track)
	local road = MapConfig.Roads and MapConfig.Roads[1]
	if not road then
		return true
	end
	local x = -24
	local from, to = Vector3.new(x, 0.5, road.z - road.width / 2 - 8), Vector3.new(x, 0.5, road.z + road.width / 2 + 6)
	local ok, part = pcall(PartVisual.Build, "bolts")
	if ok and part then
		keep(part)
		part:PivotTo(CFrame.new(to + Vector3.new(0, 1.5, 3)))
		part.Parent = Workspace
	else
		part = nil
	end
	camTo(CFrame.lookAt(Vector3.new(x - 42, 12, road.z), Vector3.new(x, 2, road.z)), true)
	caption(2, "GRAB CAR PARTS", "Glowing parts lie around every district - run into one to pick it up", 2.6, 9)
	if not wait(2.6) then
		return false
	end
	say("Watch the traffic: one hit and you lose the parts you carry", 5.5)
	if not run(actor, track, from, to, 4.5) then
		return false
	end
	if part then
		part:Destroy()
	end
	return wait(1.2)
end

-- 3) your garage: throw the part at the platform, a car drives in
local function sceneThrow(st, actor)
	local idx = st.baseIndex
	if not idx then
		return true
	end
	local bcf = BaseLayout.GetBaseCFrame(idx)
	local trap = BaseLayout.ToWorld(idx, BaseLayout.TrapLocal)
	local stand = trap + bcf:VectorToWorldSpace(Vector3.new(12, 0, 0))
	actor:PivotTo(CFrame.lookAt(stand + Vector3.new(0, 3, 0), trap + Vector3.new(0, 3, 0)))
	camTo(CFrame.lookAt(stand + bcf:VectorToWorldSpace(Vector3.new(10, 9, 14)), trap + Vector3.new(0, 2, 0)), true)
	caption(3, "THROW PARTS AT YOUR PLATFORM", "At your platform open THROW, pick ALL and press THROW", 2.4, 6)
	if not wait(2.4) then
		return false
	end
	local ok, p2 = pcall(PartVisual.Build, "bolts")
	if ok and p2 then
		keep(p2)
		p2.Parent = Workspace
		local t0 = os.clock()
		while os.clock() - t0 &lt; 0.7 and not skipped do
			local k = (os.clock() - t0) / 0.7
			p2:PivotTo(CFrame.new(stand:Lerp(trap, k) + Vector3.new(0, 3 + math.sin(k * math.pi) * 7, 0)))
			RunService.RenderStepped:Wait()
		end
		p2:Destroy()
	end
	Cine.Flash(Color3.new(1, 1, 1), 0.4, 0.4)
	Cine.Shake(0.8, 0.3)
	say("More parts = more rarity points = a rarer car!", 4)
	-- a car drives in from the street to bay 1, the camera follows behind it
	local car = showCar("Rare")
	if car then
		local root = car.PrimaryPart
		local y = BaseLayout.FloorY + 0.6
		local pl, sl = BaseLayout.PortalLocal, BaseLayout.SlotLocal(1)
		local pts = {}
		for _, p in ipairs({ { pl.X + 30, pl.Z }, { BaseLayout.LaneX, pl.Z }, { BaseLayout.LaneX, sl.Z }, { sl.X + 4, sl.Z } }) do
			table.insert(pts, bcf:PointToWorldSpace(Vector3.new(p[1], y, p[2])))
		end
		root.CFrame = faceCF(pts[1], pts[2] - pts[1])
		car.Parent = Workspace
		for i = 2, #pts do
			local a, b = pts[i - 1], pts[i]
			local dir = (b - a).Unit
			local seg = (b - a).Magnitude / 26
			local s0 = os.clock()
			while not skipped do
				local k = math.min(1, (os.clock() - s0) / seg)
				local pos = a:Lerp(b, k)
				root.CFrame = faceCF(pos, dir)
				camTo(CFrame.lookAt(pos - dir * 12 + Vector3.new(0, 4.5, 0), pos + dir * 6 + Vector3.new(0, 1.5, 0)))
				if k &gt;= 1 then
					break
				end
				RunService.RenderStepped:Wait()
			end
		end
	elseif not wait(2) then
		return false
	end
	say("It parks in your garage and earns money every second", 3.5)
	return wait(3.5)
end

-- a quick local "gear aura" on the showcase car (the real ones are GearFx's, on parked cars only)
local function addAura(car)
	pcall(function()
		local root = car.PrimaryPart
		local gold = Color3.fromRGB(255, 205, 60)
		local hl = Instance.new("Highlight")
		hl.FillColor, hl.OutlineColor = gold, gold
		hl.FillTransparency, hl.OutlineTransparency = 0.75, 0
		hl.DepthMode = Enum.HighlightDepthMode.Occluded
		hl.Parent = car
		local light = Instance.new("PointLight")
		light.Color, light.Range, light.Brightness = gold, 16, 2
		light.Parent = root
		local pe = Instance.new("ParticleEmitter")
		pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		pe.Color = ColorSequence.new(gold)
		pe.LightEmission = 1
		pe.Rate = 40
		pe.Lifetime = NumberRange.new(0.8, 1.4)
		pe.Speed = NumberRange.new(3, 6)
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.Size = NumberSequence.new(0.5, 0)
		pe.Parent = root
	end)
end

-- 4) Big Tony's GEARS: the shop, then a car with a gear on it lights up
local function sceneTony(actor, track)
	local map = Workspace:FindFirstChild("GeneratedMap")
	local garage = map and map:FindFirstChild("TonyGarage", true)
	local spot = garage and garage:FindFirstChild("TonySpot", true)
	local tcf -- Tony's frame: local -Z looks out of the shop at the visitors
	if spot then
		local look = spot.CFrame.LookVector * Vector3.new(1, 0, 1)
		tcf = CFrame.lookAt(spot.Position, spot.Position + (look.Magnitude &gt; 0.01 and look.Unit or Vector3.new(0, 0, -1)))
	elseif MapConfig.Tony and MapConfig.Hub then
		-- no shop model: film the stand's place on the ring (the stand faces the hub centre)
		local cfg, hub = MapConfig.Tony, MapConfig.Hub
		local pos = Vector3.new(cfg.x, (hub.top or 0) + 0.5, cfg.z)
		tcf = CFrame.lookAt(pos, Vector3.new(hub.x, pos.Y, hub.z))
	else
		return true
	end
	local tony = tcf.Position
	local function at(x, y, z)
		return tcf:PointToWorldSpace(Vector3.new(x, y, z))
	end
	camTo(CFrame.lookAt(at(11, 8, -24), tony + Vector3.new(0, 4, 0)), true)
	caption(4, "BIG TONY'S GEARS", "Buy GEARS: huge timed boosts - x2 income, luck, speed", 5, 12)
	if not run(actor, track, at(14, 0, -16), at(2, 0, -7.5), 3) then
		return false
	end
	if not wait(2) then
		return false
	end
	-- the showcase car in front of the shop, side-on to the camera
	local car = showCar("Epic")
	if not car then
		say("Put a gear on a car and it gets a glowing aura", 4.5)
		return wait(4.5)
	end
	local root = car.PrimaryPart
	local p = at(-3, 0, -13)
	local carPos = Vector3.new(p.X, tony.Y - 0.5 + 0.6, p.Z) -- the spot is 0.5 above the paving; Root rides 0.6 above it
	root.CFrame = faceCF(carPos, tcf.RightVector)
	car.Parent = Workspace
	camTo(CFrame.lookAt(carPos + tcf:VectorToWorldSpace(Vector3.new(6, 6, -14)), carPos + Vector3.new(0, 1.5, 0)))
	say("Put a gear on a car and it gets a glowing aura", 5)
	if not wait(1.2) then
		return false
	end
	Cine.Flash(Color3.fromRGB(255, 220, 120), 0.5, 0.4)
	addAura(car)
	return during(3.8, function(t)
		local a = t * 0.35
		local off = tcf:VectorToWorldSpace(Vector3.new(math.sin(a) * 15, 6, -math.cos(a) * 15))
		camTo(CFrame.lookAt(carPos + off, carPos + Vector3.new(0, 1.5, 0)))
	end)
end

-- 5) the platform: it levels up, more luck
local function scenePlatform(st, actor)
	local idx = st.baseIndex or 1
	local okCf, bcf = pcall(BaseLayout.GetBaseCFrame, idx)
	if not okCf or not bcf then
		return true
	end
	local pad = trapPadOf(idx)
	local trap = pad and pad.Position or BaseLayout.ToWorld(idx, BaseLayout.TrapLocal)
	local floor = pad and (pad.Position.Y + pad.Size.Y / 2) or (trap.Y + 1.6) -- pad top (the rings start here)
	local ground = BaseLayout.ToWorld(idx, BaseLayout.TrapLocal) -- the actor stands beside the pad, as in scene 3
	local stand = ground + bcf:VectorToWorldSpace(Vector3.new(12, 0, 0))
	actor:PivotTo(CFrame.lookAt(stand + Vector3.new(0, 3, 0), ground + Vector3.new(0, 3, 0)))
	local luck = math.floor((TrapConfig.LuckPerLevel or 0) * 100 + 0.5)
	caption(5, "UPGRADE YOUR PLATFORM", "Upgrade your platform for more luck", 3.2, 8)
	local function orbitAt(t)
		local a = 0.6 + t * 0.25
		camTo(CFrame.lookAt(trap + Vector3.new(math.cos(a) * 26, 14, math.sin(a) * 26), trap + Vector3.new(0, 1, 0)), t &lt; 0.05)
	end
	if not during(2.4, orbitAt) then
		return false
	end
	say(string.format("Open THROW at your platform and press UPGRADE: Lv 1 to Lv %d, +%d%% luck per level", TrapConfig.MaxLevel or 10, luck), 5.6)
	Cine.Flash(Color3.fromRGB(120, 240, 255), 0.35, 0.4)
	-- three glowing rings rise off the pad (local fx, cleaned up with the rest)
	local rings = {}
	for i = 1, 3 do
		local ring = keep(Instance.new("Part"))
		ring.Shape = Enum.PartType.Cylinder
		ring.Anchored, ring.CanCollide, ring.CanQuery, ring.CanTouch, ring.CastShadow = true, false, false, false, false
		ring.Material = Enum.Material.Neon
		ring.Color = Color3.fromRGB(80, 230, 255)
		ring.Transparency = 1
		ring.Size = Vector3.new(0.3, 14, 14)
		ring.Parent = Workspace
		rings[i] = ring
	end
	return during(5.6, function(t)
		orbitAt(2.4 + t)
		for i, ring in ipairs(rings) do
			local k = ((t - (i - 1) * 0.45) % 1.4) / 1.4
			local s = 12 + k * 8
			ring.Size = Vector3.new(0.3, s, s)
			ring.CFrame = CFrame.new(trap.X, floor + 0.2 + k * 7, trap.Z) * CFrame.Angles(0, 0, math.pi / 2)
			ring.Transparency = t &lt; (i - 1) * 0.45 and 1 or 0.35 + 0.65 * k
		end
	end)
end

-- 6) the districts: fly down the route, then the boss
local function sceneDistricts()
	local zones = MapConfig.Zones
	local z0 = zones and zones.highway and zones.highway.zMin
	local z1 = zones and zones.neon and zones.neon.zMax
	caption(6, "DISTRICTS &amp; BOSSES", "Unlock new districts: faster traffic - and better parts", 5, 10)
	if z0 and z1 then
		if not during(5, function(t)
			local z = z0 + (z1 - z0) * t / 5
			camTo(CFrame.lookAt(Vector3.new(0, 46, z), Vector3.new(0, 0, z + 90)), t &lt; 0.05)
		end) then
			return false
		end
	elseif not wait(5) then
		return false
	end
	local bosses = Workspace:FindFirstChild("Bosses")
	local truck = bosses and bosses:FindFirstChildWhichIsA("Model")
	if truck then
		say("Every tier ends with a boss: a monster truck guards the arena - throw parts to scare it off", 5)
		return during(5, function(t)
			if not truck.Parent then
				return
			end
			local c = truck:GetPivot().Position
			local ang = t * 0.5
			camTo(CFrame.lookAt(c + Vector3.new(math.cos(ang) * 34, 14, math.sin(ang) * 34), c + Vector3.new(0, 4, 0)), t &lt; 0.05)
		end)
	end
	return true
end

local function scenes(st, actor, track)
	-- each scene runs protected: a broken one is skipped, the intro goes on with the next
	local list = {
		sceneHub,
		function() return sceneParts(actor, track) end,
		function() return sceneThrow(st, actor) end,
		function() return sceneTony(actor, track) end,
		function() return scenePlatform(st, actor) end,
		sceneDistricts,
	}
	for i, fn in ipairs(list) do
		local ok, goOn = pcall(fn)
		if not ok then
			warn("[IntroFx] scene " .. i .. ": " .. tostring(goOn))
		end
		if skipped then
			return
		end
	end
	Cine.Title("NOW IT'S YOUR TURN!", Color3.fromRGB(110, 230, 140), 2.4, 84, 0.42)
	wait(2.2)
end

function Intro.Play(st)
	skipped = false
	UI.SetCinematic(true)
	cam = Cine.Take()
	local cam0 = cam.CFrame
	camTarget = cam.CFrame
	camConn = RunService.RenderStepped:Connect(function(dt)
		cam.CFrame = cam.CFrame:Lerp(camTarget, 1 - math.exp(-dt * 6))
	end)
	Cine.Letterbox(true, 0.4)
	-- everything that can fail runs protected, so the cleanup below always gives the player back the controls
	local skip
	pcall(function()
		skip = K.toy(K.overlay, { Text = "SKIP  &gt;", Color = K.P.grey, Size = UDim2.fromOffset(150, 56), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -24),
			TextSize = 22, ZIndex = 95, OnClick = function() skipped = true end })
		local actor, track = makeActor()
		if actor then
			scenes(st, actor, track)
		end
	end)
	Cine.ClearText()
	Cine.Darken(1, 0.3)
	task.wait(0.35)
	for _, x in ipairs(trash) do
		pcall(function()
			x:Destroy()
		end)
	end
	trash = {}
	if skip then
		skip.holder:Destroy()
	end
	if camConn then
		camConn:Disconnect()
		camConn = nil
	end
	cam.CFrame = cam0
	Cine.Letterbox(false, 0.2)
	Cine.Release(0.2)
	Cine.Darken(0, 0.5)
	UI.SetCinematic(false)
	Net.Get("TutorialStep"):FireServer(1) -- the intro is done: the tutorial starts at step 1
end

-- JoinFlow asks "NEED A TUTORIAL?" and calls Intro.Play on YES
function Intro.Start(ui, cine)
	UI, Cine = ui, cine
	K = UI.Kit()
end

return Intro
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXFD3A017E897742E5B4779E065485FFE6"><Properties><string name="Name">JoinFlow</string><ProtectedString name="Source">-- Join flow: a short camera preview of the plaza as soon as the player is in, then
--  * new players (tutorial 0): a centred "NEED A TUTORIAL?" card over the preview - YES plays the intro cinematic and
--    starts the step tutorial, SKIP marks the tutorial done;
--  * everyone else: the preview just ends.
-- It always finishes with a smooth glide to the normal camera behind the character (never looking at the floor).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MapConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MapConfig"))

local Join = {}
local UI, Cine, K, Intro, Tutorial

-- camera orbit around the plaza centre while waiting; returns a stop function
local function orbit(cam)
	local hub = MapConfig.Hub -- the round square with the shops (v23)
	local centre = hub and Vector3.new(hub.x, 4, hub.z) or Vector3.new(0, 4, (MapConfig.StartZ + MapConfig.EntryZ) / 2)
	local t0 = os.clock()
	local conn = RunService.RenderStepped:Connect(function()
		local a = (os.clock() - t0) * 0.12 + 0.6
		cam.CFrame = CFrame.lookAt(centre + Vector3.new(math.cos(a) * 120, 58, math.sin(a) * 120), centre)
	end)
	return function()
		conn:Disconnect()
	end
end

local function rootPart()
	local char = Players.LocalPlayer.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

-- ease the camera down to "behind the character, looking ahead", then hand it back to the player
local function glideHome(cam, t)
	local hrp = rootPart()
	if hrp then
		local look = hrp.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		flat = flat.Magnitude &gt; 0.1 and flat.Unit or Vector3.new(0, 0, -1)
		local eye = hrp.Position - flat * 14 + Vector3.new(0, 5, 0)
		local goal = CFrame.lookAt(eye, hrp.Position + flat * 10 + Vector3.new(0, 1.5, 0))
		Cine.Move(goal, t, Enum.EasingStyle.Quad)
		task.wait(t)
		Cine.Release(0.2)
		cam.CFrame = goal -- the default camera continues from here
	else
		Cine.Release(0.2)
	end
end

-- the centred question card; resolves to true (YES) or false (SKIP)
local function ask()
	local P = K.P
	local choice
	-- v23 layers: 82 (over the checkpoint card 78 and WelcomeBack 80, under Confirm 85)
	local dim = K.new("Frame", { Name = "TutorialAsk", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 82 }, K.overlay)
	-- v23: shared dialog shell (drop shadow + orange header strip with the welcome line)
	local card, shell = K.dialogShell(dim, { Position = UDim2.fromScale(0.5, 0.55), Size = UDim2.fromOffset(560, 300), ZIndex = 83, Color = P.orange, HeadH = 56,
		Title = "WELCOME TO CAR HUNTERS!", TitleSize = 26 })
	K.text(card, { Text = "NEED A TUTORIAL?", TextSize = 46, Position = UDim2.fromOffset(0, 66), Size = UDim2.new(1, 0, 0, 54), TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 86, Outline = 3 })
	K.text(card, { Text = "A short video shows how to grab parts, catch cars, use gears and earn money.", Font = K.BODY, TextSize = 17, TextColor3 = P.muted, TextWrapped = true,
		Position = UDim2.fromOffset(40, 124), Size = UDim2.new(1, -80, 0, 44), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 86 })
	K.toy(card, { Text = "YES", Color = P.green, Size = UDim2.fromOffset(220, 74), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(0.5, -12, 1, -22), TextSize = 32,
		ZIndex = 86, OnClick = function() choice = true end })
	K.toy(card, { Text = "SKIP", Color = P.grey, Size = UDim2.fromOffset(220, 74), AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0.5, 12, 1, -22), TextSize = 32,
		ZIndex = 86, OnClick = function() choice = false end })
	local sc = K.new("UIScale", { Scale = 0.6 }, shell)
	K.tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	while choice == nil and dim.Parent do
		task.wait()
	end
	dim:Destroy()
	return choice == true
end

local function run(st)
	local cam = Cine.Take()
	local stop = orbit(cam)
	local newPlayer = (st.tutorial or 0) == 0
	local cineOn = false
	local ok, err = pcall(function()
		if newPlayer then
			UI.SetCinematic(true) -- HUD away while the question is on screen
			cineOn = true
			Cine.Title("CAR HUNTERS", Color3.fromRGB(255, 210, 63), 2.2, 110, 0.22)
			task.wait(1.2)
			local yes = ask()
			stop()
			UI.SetCinematic(false)
			cineOn = false
			if yes then
				Intro.Play(st) -- the shown steps; ends by starting the step tutorial
				cam = Cine.Take()
			else
				Tutorial.Skip()
			end
		else
			Cine.Title("CAR HUNTERS", Color3.fromRGB(255, 210, 63), 1.8, 110, 0.22)
			task.wait(2.4)
			stop()
		end
	end)
	stop()
	if not ok then
		warn("[JoinFlow] " .. tostring(err))
		if cineOn then
			UI.SetCinematic(false)
		end
	end
	glideHome(cam, 1.2)
end

function Join.Start(ui, cine, intro, tutorial)
	UI, Cine, Intro, Tutorial = ui, cine, intro, tutorial
	K = UI.Kit()
	task.spawn(function()
		local st
		repeat
			task.wait(0.3)
			st = K.store.State
		until st and rootPart() and Workspace:FindFirstChild("GeneratedMap")
		run(st)
	end)
end

return Join
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX64A451E41BE84C259B6F2F8DEC7E76EC"><Properties><string name="Name">Markers</string><ProtectedString name="Source">-- World markers (always on top) + an edge arrow pointing to the current objective.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Strings = require(Shared:WaitForChild("Strings"))
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local BaseLayout = require(Shared:WaitForChild("BaseLayout"))

local T = Strings.T
local C = Color3.fromRGB
local Markers = {}
local K, store, extra
local folder, arrow, arrowLabel
local marks = {}

local function anchorAt(name, pos)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
	p.Transparency = 1
	p.Size = Vector3.one * 0.2
	p.Position = pos
	p.Parent = folder
	return p
end

-- icon bubble + label + distance
local function makeMark(id, icon, label, color, pos, maxDist)
	local adornee = anchorAt("M_" .. id, pos)
	local bb = K.new("BillboardGui", { Name = "Mark_" .. id, Adornee = adornee, AlwaysOnTop = true, Size = UDim2.fromOffset(150, 74),
		StudsOffsetWorldSpace = Vector3.new(0, 4, 0), MaxDistance = maxDist or 2000, LightInfluence = 0, ResetOnSpawn = false }, K.gui.Parent)
	local bubble = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.fromOffset(42, 42), BackgroundColor3 = color }, bb)
	K.corner(bubble, 21)
	K.stroke(bubble, K.P.ink, 3)
	K.text(bubble, { Text = icon, Font = K.BODY, TextSize = 24, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center })
	local l = K.text(bb, { Text = label, TextSize = 16, Position = UDim2.fromOffset(0, 44), Size = UDim2.new(1, 0, 0, 18), TextXAlignment = Enum.TextXAlignment.Center, Outline = 2 })
	local d = K.text(bb, { Text = "", Font = K.BODY, TextSize = 13, Position = UDim2.fromOffset(0, 60), Size = UDim2.new(1, 0, 0, 14), TextXAlignment = Enum.TextXAlignment.Center })
	local scale = K.new("UIScale", {}, bubble)
	local m = { id = id, bb = bb, adornee = adornee, label = l, dist = d, color = color, icon = icon, scale = scale, text = label }
	marks[id] = m
	return m
end

local function removeMark(id)
	local m = marks[id]
	if m then
		m.bb:Destroy()
		m.adornee:Destroy()
		marks[id] = nil
	end
end

function Markers.SetPos(id, pos)
	local m = marks[id]
	if m then
		m.adornee.Position = pos
	end
end

local function ensureBase()
	local st = store.State
	if not st or not st.baseIndex then
		return
	end
	local pos = BaseLayout.ToWorld(st.baseIndex, BaseLayout.TrapLocal) + Vector3.new(0, 10, 0)
	if not marks.base then
		makeMark("base", "🏠", T("map_base"), K.P.orange, pos)
	else
		Markers.SetPos("base", pos)
	end
end

local scanned = {}
local function refreshScanner()
	local st = store.State
	local level = st and st.perks and st.perks.scanner or 0
	local drops = Workspace:FindFirstChild("RuntimeDrops")
	local seen = {}
	if level &gt;= 1 and drops then
		for _, m in ipairs(drops:GetChildren()) do
			local pid = m:GetAttribute("PartId")
			local root = m:FindFirstChild("Root")
			local part = pid and PartConfig.Parts[pid]
			if root and part and (part.rarity == "Epic" or part.rarity == "Legendary") then
				local key = "rare_" .. tostring(m:GetAttribute("PointId"))
				seen[key] = true
				if not marks[key] then
					makeMark(key, part.emoji, "", part.color, root.Position, 420)
				end
			end
		end
	end
	for key in pairs(scanned) do
		if not seen[key] then
			removeMark(key)
		end
	end
	scanned = seen
end

-- the objective arrow: hot drop &gt; carry loot home &gt; nothing
local function objective()
	local hot = extra.HotDrop()
	if hot and hot.kind == "start" and marks.hot then
		return marks.hot
	end
	if store.CarriedTotal() &gt; 0 and marks.base then
		return marks.base
	end
	return nil
end

function Markers.Start(kit, extraModule)
	K = kit
	store = K.store
	extra = extraModule
	folder = Instance.new("Folder")
	folder.Name = "MarkerAnchors"
	folder.Parent = Workspace
	makeMark("shop", "🔧", T("map_shop"), K.P.red, Vector3.new(MapConfig.Shop.x, 18, MapConfig.Shop.z), 260)
	makeMark("donate", "👑", T("map_donate"), C(232, 178, 50), Vector3.new(MapConfig.DonateStall.x, 16, MapConfig.DonateStall.z), 260)
	if MapConfig.Tony then
		makeMark("tony", "🔧", T("map_tony"), C(30, 36, 58), Vector3.new(MapConfig.Tony.x, 12, MapConfig.Tony.z), 160)
	end

	arrow = K.new("Frame", { Name = "ObjectiveArrow", AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(64, 64), BackgroundTransparency = 1, Visible = false, ZIndex = 30 }, K.gui)
	local tri = K.text(arrow, { Text = "➤", Font = K.BODY, TextSize = 52, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 30, TextColor3 = K.P.orange })
	K.new("UIStroke", { Color = K.P.ink, Thickness = 3 }, tri)
	arrowLabel = tri

	store.Changed.Event:Connect(ensureBase)
	local t = 0
	local textAcc = 1 -- distance labels refresh at 10 Hz (the billboards themselves follow every frame)
	RunService.RenderStepped:Connect(function(dt)
		t = t + dt
		textAcc = textAcc + dt
		local cam = Workspace.CurrentCamera
		local char = Players.LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not cam or not hrp then
			return
		end
		-- hot drop marker follows the event
		local hot = extra.HotDrop()
		if hot and hot.kind == "start" then
			if not marks.hot then
				makeMark("hot", "📦", T("hot_drop"), K.P.red, hot.pos + Vector3.new(0, 6, 0))
			end
			marks.hot.scale.Scale = 1 + 0.15 * math.sin(t * 8)
		elseif marks.hot then
			removeMark("hot")
		end
		-- distances
		if textAcc &gt;= 0.1 then
			textAcc = 0
			for _, m in pairs(marks) do
				local d = (m.adornee.Position - hrp.Position).Magnitude
				local txt = (d &gt; 12) and (math.floor(d) .. " m") or ""
				if m.dist.Text ~= txt then
					m.dist.Text = txt
				end
			end
		end
		-- edge arrow
		local obj = objective()
		-- no arrow / world labels over panels or cinematics, or when switched off in Settings
		local busy = K.state.open ~= nil or K.state.cine == true or game:GetService("Players").LocalPlayer:GetAttribute("Opt_markers") == false
		for _, m in pairs(marks) do
			if m.bb and m.bb.Enabled == busy then
				m.bb.Enabled = not busy
			end
		end
		if obj and not busy then
			local p, onScreen = cam:WorldToViewportPoint(obj.adornee.Position)
			local vp = cam.ViewportSize
			if onScreen and p.Z &gt; 0 and p.X &gt; 40 and p.X &lt; vp.X - 40 and p.Y &gt; 40 and p.Y &lt; vp.Y - 40 then
				arrow.Visible = false
			else
				local inset = game:GetService("GuiService"):GetGuiInset()
				vp = vp - inset
				p = Vector3.new(p.X - inset.X, p.Y - inset.Y, p.Z)
				local cx, cy = vp.X / 2, vp.Y / 2
				local dx, dy = p.X - cx, p.Y - cy
				if p.Z &lt; 0 then
					dx, dy = -dx, -dy
				end
				local ang = math.atan2(dy, dx)
				local rx, ry = cx - 70, cy - 70
				local s = math.min(rx / math.max(math.abs(math.cos(ang)), 1e-3), ry / math.max(math.abs(math.sin(ang)), 1e-3))
				arrow.Position = UDim2.fromOffset(cx + math.cos(ang) * s, cy + math.sin(ang) * s)
				arrow.Rotation = math.deg(ang)
				arrowLabel.TextColor3 = obj.color
				arrow.Visible = true
			end
		else
			arrow.Visible = false
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			ensureBase()
			refreshScanner()
		end
	end)
end

return Markers
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX744A229E666645E4A9B4F01FCD2D7A21"><Properties><string name="Name">Perf</string><ProtectedString name="Source">-- Adaptive quality: measures FPS and steps HIGH -&gt; MED -&gt; LOW (and back) so the game stays smooth on every device.
--   Perf.Level()        -&gt; "HIGH" | "MED" | "LOW"
--   Perf.Changed.Event  -&gt; fires (level) whenever the level changes
--   Perf.Start()        -&gt; begins measuring, applies the lighting budget, the parked-car exhaust LOD and the skyline
--                          LOD (LOW drops the far row of background buildings)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local UserInputService = game:GetService("UserInputService")
local CollectionService = game:GetService("CollectionService")

local Perf = {}
Perf.Changed = Instance.new("BindableEvent")

local LEVELS = { "LOW", "MED", "HIGH" }
local DROP_FPS, DROP_SECS = 40, 4
local RAISE_FPS, RAISE_SECS = 55, 20
local WINDOW = 3 -- rolling average, seconds
local EXHAUST_RADIUS = { HIGH = 70, MED = 45, LOW = 0 }

-- the player's own graphics setting: Automatic -&gt; HIGH, 1-3 LOW, 4-6 MED, 7+ HIGH
local function savedLevel()
	local ok, q = pcall(function()
		return UserSettings():GetService("UserGameSettings").SavedQualityLevel
	end)
	if not ok or typeof(q) ~= "EnumItem" or q.Value == 0 then
		return 3, false -- Automatic (or unreadable)
	end
	if q.Value &lt;= 3 then
		return 1, true
	elseif q.Value &lt;= 6 then
		return 2, true
	end
	return 3, true
end

local function smallTouchScreen()
	local ok, yes = pcall(function()
		if not UserInputService.TouchEnabled or UserInputService.KeyboardEnabled then
			return false
		end
		local cam = Workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
		return math.min(vp.X, vp.Y) &lt; 600
	end)
	return ok and yes == true
end

local idx, maxIdx -- current / highest allowed level index
local function init()
	if idx then
		return
	end
	local lvl, explicit = savedLevel()
	maxIdx = explicit and lvl or 3
	idx = lvl
	if smallTouchScreen() then
		idx = math.min(idx, 2)
	end
end

function Perf.Level()
	init()
	return LEVELS[idx]
end

-- ---------------------------------------------------------------- lighting budget (client-local)
local origShadows
local function applyLighting()
	local level = LEVELS[idx]
	if origShadows == nil then
		origShadows = Lighting.GlobalShadows
	end
	local shadows = origShadows and level ~= "LOW"
	if Lighting.GlobalShadows ~= shadows then
		Lighting.GlobalShadows = shadows
	end
	-- only the permanent look effects; cinematic ones (CineBlur, RevealBlur, Trap*) are left alone
	local bloom = Lighting:FindFirstChild("CHBloom")
	if bloom and bloom:IsA("BloomEffect") then
		bloom.Enabled = level ~= "LOW"
	end
	local rays = Lighting:FindFirstChild("CHSunRays")
	if rays and rays:IsA("SunRaysEffect") then
		rays.Enabled = level == "HIGH"
	end
end

-- ---------------------------------------------------------------- exhaust LOD for parked cars
-- the server creates these disabled; only the ones near the camera run (none on LOW)
local function refreshExhaust()
	local cam = Workspace.CurrentCamera
	if not cam then
		return
	end
	local camPos = cam.CFrame.Position
	local r = EXHAUST_RADIUS[LEVELS[idx]] or 0
	local r2 = r * r
	local function near(inst)
		if r &lt;= 0 then
			return false
		end
		local p = inst.Parent
		local pos
		if p and p:IsA("Attachment") then
			pos = p.WorldPosition
		elseif p and p:IsA("BasePart") then
			pos = p.Position
		else
			return false
		end
		local d = pos - camPos
		return d.X * d.X + d.Y * d.Y + d.Z * d.Z &lt;= r2
	end
	for _, e in ipairs(CollectionService:GetTagged("ExhaustEmitter")) do
		if e:IsA("ParticleEmitter") then
			local want = near(e)
			if e.Enabled ~= want then
				e.Enabled = want
			end
		end
	end
	for _, l in ipairs(CollectionService:GetTagged("ExhaustLight")) do
		if l:IsA("Light") then
			local want = near(l)
			if l.Enabled ~= want then
				l.Enabled = want
			end
		end
	end
end

-- ---------------------------------------------------------------- skyline LOD
-- background buildings (tag "Skyline", attribute Row = 1 near / 2 far): on LOW the far row is taken out of the
-- client's world (a local reparent; the map has no streaming, the server keeps them) and put back on MED/HIGH
local skyHidden = {} -- model -&gt; its original parent
local function skyRow2(inst)
	return inst:IsA("Model") and inst:GetAttribute("Row") == 2
end
local function hideSky(m)
	if skyHidden[m] == nil and m.Parent and skyRow2(m) then
		skyHidden[m] = m.Parent
		m.Parent = nil
	end
end
local function applySkyline()
	if LEVELS[idx] == "LOW" then
		for _, m in ipairs(CollectionService:GetTagged("Skyline")) do
			hideSky(m)
		end
	else
		for m, parent in pairs(skyHidden) do
			skyHidden[m] = nil
			-- a map rebuilt meanwhile destroyed the old folders: only restore into a live parent
			if parent:IsDescendantOf(game) then
				pcall(function()
					m.Parent = parent
				end)
			end
		end
	end
end

local function setLevel(newIdx)
	newIdx = math.clamp(newIdx, 1, maxIdx)
	if newIdx == idx then
		return
	end
	idx = newIdx
	applyLighting()
	refreshExhaust()
	applySkyline()
	Perf.Changed:Fire(LEVELS[idx])
end

-- ---------------------------------------------------------------- measuring
local started = false
function Perf.Start()
	if started then
		return
	end
	started = true
	init()
	applyLighting()
	applySkyline()
	-- the map can arrive after Perf starts (or be rebuilt): new far-row buildings follow the current level
	CollectionService:GetInstanceAddedSignal("Skyline"):Connect(function(m)
		if LEVELS[idx] == "LOW" then
			task.defer(hideSky, m)
		end
	end)
	Lighting.ChildAdded:Connect(function(c)
		if c.Name == "CHBloom" or c.Name == "CHSunRays" then
			task.defer(applyLighting)
		end
	end)
	pcall(function()
		local ugs = UserSettings():GetService("UserGameSettings")
		ugs:GetPropertyChangedSignal("SavedQualityLevel"):Connect(function()
			local lvl, explicit = savedLevel()
			maxIdx = explicit and lvl or 3
			if explicit then
				setLevel(lvl)
			elseif idx &gt; maxIdx then
				setLevel(maxIdx)
			end
		end)
	end)

	local focused = true
	UserInputService.WindowFocusReleased:Connect(function()
		focused = false
	end)
	UserInputService.WindowFocused:Connect(function()
		focused = true
	end)

	-- per-0.5 s buckets of {frames, seconds}; the rolling average covers the last WINDOW seconds
	local buckets = {}
	local frames, elapsed = 0, 0
	local lowFor, highFor = 0, 0
	local raiseNeed = RAISE_SECS
	local lastRaise = -math.huge
	local peak = 0 -- highest recent FPS (slowly decays): the device's real frame cap
	local warmup = 6 -- loading hitches right after joining do not count
	RunService.Heartbeat:Connect(function(dt)
		if warmup &gt; 0 then
			warmup = warmup - dt
			return
		end
		frames = frames + 1
		elapsed = elapsed + dt
		if elapsed &lt; 0.5 then
			return
		end
		local step = elapsed
		if not focused then
			-- background windows are throttled by the engine: not a real measurement
			frames, elapsed = 0, 0
			table.clear(buckets)
			lowFor, highFor = 0, 0
			return
		end
		table.insert(buckets, { frames, elapsed })
		frames, elapsed = 0, 0
		local f, s = 0, 0
		for i = #buckets, 1, -1 do
			local b = buckets[i]
			if s &gt;= WINDOW then
				table.remove(buckets, i)
			else
				f = f + b[1]
				s = s + b[2]
			end
		end
		if s &lt; WINDOW * 0.8 then
			return -- not enough history yet
		end
		local fps = f / s
		-- the device's own frame cap (30 FPS limit / battery saver): judge against it, not only absolute numbers
		peak = math.max(peak * 0.995, fps)
		local dropAt = math.min(DROP_FPS, peak * 0.72)
		local raiseAt = math.min(RAISE_FPS, peak * 0.9)
		if fps &lt; dropAt then
			lowFor = lowFor + step
		else
			lowFor = 0
		end
		if fps &gt; raiseAt then
			highFor = highFor + step
		else
			highFor = 0
		end
		local now = os.clock()
		if lowFor &gt;= DROP_SECS and idx &gt; 1 then
			-- dropping again shortly after a raise: wait longer before the next try (no flip-flopping)
			if now - lastRaise &lt; 60 then
				raiseNeed = math.min(raiseNeed * 2, 160)
			end
			setLevel(idx - 1)
			lowFor, highFor = 0, 0
			table.clear(buckets)
		elseif highFor &gt;= raiseNeed and idx &lt; maxIdx then
			lastRaise = now
			setLevel(idx + 1)
			lowFor, highFor = 0, 0
			table.clear(buckets)
		end
	end)

	task.spawn(function()
		while true do
			local ok, err = pcall(refreshExhaust)
			if not ok then
				warn("[Perf] exhaust LOD:", err)
			end
			task.wait(1)
		end
	end)
	Players.LocalPlayer:SetAttribute("PerfLevel", LEVELS[idx])
	Perf.Changed.Event:Connect(function(level)
		Players.LocalPlayer:SetAttribute("PerfLevel", level)
	end)
end

return Perf
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXF56DC68884024F1995D782A001DB6D8D"><Properties><string name="Name">PhotoMode</string><ProtectedString name="Source">-- Owner-only filming mode: a small CAM button (top-right) or the P key turns on a free-flying camera with the whole HUD
-- hidden. WASD move, E/Q up/down, hold right mouse to look around, mouse wheel = zoom (field of view), Shift = fast,
-- Ctrl = slow. P or the button again = back to normal. The character does not move while flying.
-- Purely visual and client-side: only the experience owner sees the button.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local Workspace = game:GetService("Workspace")

local OWNERS = { [1221663569] = true }

local Photo = {}
local UI, Cine, K
local on = false
local btn, hint
local yaw, pitch, pos, fov = 0, 0, Vector3.zero, 70
local conn

local function sink()
	return Enum.ContextActionResult.Sink -- WASD / jump drive the camera, not the character
end

local function stop()
	on = false
	if conn then
		conn:Disconnect()
		conn = nil
	end
	ContextActionService:UnbindAction("PhotoModeSink")
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	local cam = Workspace.CurrentCamera
	cam.FieldOfView = 70
	Cine.Release(0.2)
	UI.SetCinematic(false)
	hint.Visible = false
	btn.holder.Visible = true
end

local function start()
	on = true
	UI.SetCinematic(true) -- hides the HUD
	local cam = Cine.Take()
	pos = cam.CFrame.Position
	local look = cam.CFrame.LookVector
	yaw = math.atan2(-look.X, -look.Z)
	pitch = math.asin(math.clamp(look.Y, -1, 1))
	fov = cam.FieldOfView
	ContextActionService:BindActionAtPriority("PhotoModeSink", sink, false, Enum.ContextActionPriority.High.Value,
		Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D, Enum.KeyCode.Space, Enum.KeyCode.E, Enum.KeyCode.Q)
	btn.holder.Visible = false
	hint.Visible = true
	task.delay(3, function()
		hint.Visible = false
	end)
	conn = RunService.RenderStepped:Connect(function(dt)
		local rmb = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
		UserInputService.MouseBehavior = rmb and Enum.MouseBehavior.LockCurrentPosition or Enum.MouseBehavior.Default
		if rmb then
			local d = UserInputService:GetMouseDelta()
			yaw = yaw - d.X * 0.004
			pitch = math.clamp(pitch - d.Y * 0.004, -1.5, 1.5)
		end
		local rot = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
		local move = Vector3.zero
		local function key(k)
			return UserInputService:IsKeyDown(k) and 1 or 0
		end
		move = move + rot.LookVector * (key(Enum.KeyCode.W) - key(Enum.KeyCode.S))
		move = move + rot.RightVector * (key(Enum.KeyCode.D) - key(Enum.KeyCode.A))
		move = move + Vector3.yAxis * (key(Enum.KeyCode.E) - key(Enum.KeyCode.Q))
		local speed = (UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and 90 or 28) * (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) and 0.25 or 1)
		if move.Magnitude &gt; 0 then
			pos = pos + move.Unit * speed * dt
		end
		local cam = Workspace.CurrentCamera
		cam.CFrame = CFrame.new(pos) * rot
		cam.FieldOfView = cam.FieldOfView + (fov - cam.FieldOfView) * math.min(1, dt * 10) -- smooth zoom
	end)
end

local function toggle()
	if on then
		stop()
	elseif not UI.IsCinematic() then
		start()
	end
end

function Photo.Start(ui, cine)
	if not (OWNERS[Players.LocalPlayer.UserId] or Players.LocalPlayer.UserId == game.CreatorId) then
		return -- nobody else gets the button
	end
	UI, Cine = ui, cine
	K = UI.Kit()
	-- on the overlay layer so it stays clickable; tiny, top-right under the Roblox menu
	btn = K.toy(K.overlay, { Text = "CAM", Color = K.P.grey, Size = UDim2.fromOffset(70, 36), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -150, 0, 10),
		TextSize = 16, Depth = 4, Radius = 10, ZIndex = 90, OnClick = toggle })
	hint = K.text(K.overlay, { Text = "FILM MODE  ·  WASD move · E/Q up/down · right mouse look · wheel zoom · Shift fast · P exit", TextSize = 16,
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12), Size = UDim2.fromOffset(900, 20), TextXAlignment = Enum.TextXAlignment.Center, Visible = false, ZIndex = 90 })
	UserInputService.InputBegan:Connect(function(input, gp)
		if gp then
			return
		end
		if input.KeyCode == Enum.KeyCode.P then
			toggle()
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if on and input.UserInputType == Enum.UserInputType.MouseWheel then
			fov = math.clamp(fov - input.Position.Z * 5, 8, 110) -- wheel up = zoom in
		end
	end)
end

return Photo
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXC328032B3E2844CAB18181234954126B"><Properties><string name="Name">RevealFx</string><ProtectedString name="Source">-- Reveal effects shared by the car showcase (UI.ShowReveal) and the batch reveal: shockwave rings, contracting
-- energy rings, confetti + star bursts with gravity, flashes and shine sweeps.
-- Every effect lives inside a parent frame the caller owns: destroying that frame ends it (rings destroy themselves
-- when their tween ends, a burst disconnects its RenderStepped as soon as its layer is gone or every piece is dead).
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local RevealFx = {}
local WHITE = Color3.new(1, 1, 1)

-- quality level from Client/Perf (another module); missing or failing = HIGH
local perfMod
function RevealFx.Level()
	if perfMod == nil then
		perfMod = false
		local m = script.Parent:FindFirstChild("Perf")
		if m then
			local ok, P = pcall(require, m)
			if ok and type(P) == "table" and type(P.Level) == "function" then
				perfMod = P
			end
		end
	end
	if perfMod then
		local ok, l = pcall(perfMod.Level)
		if ok and (l == "HIGH" or l == "MED" or l == "LOW") then
			return l
		end
	end
	return "HIGH"
end

-- confetti pieces for one burst at the current quality (scale: share of the full burst)
function RevealFx.Count(scale)
	local l = RevealFx.Level()
	local n = l == "LOW" and 12 or l == "MED" and 25 or 40
	return math.max(3, math.floor(n * (scale or 1) + 0.5))
end

local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = parent
	return o
end

local function ring(parent, o, size)
	local f = make("Frame", { Name = "FxRing", AnchorPoint = Vector2.new(0.5, 0.5), Position = o.pos or UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size.X, size.Y), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = o.z or 1 }, parent)
	make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, f)
	local st = make("UIStroke", { Color = o.color or WHITE, Thickness = o.thick or 8, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, f)
	return f, st
end

local function later(parent, delay, fn)
	if delay and delay &gt; 0 then
		task.delay(delay, function()
			if parent.Parent then -- the layer is still up
				fn()
			end
		end)
	else
		fn()
	end
end

-- expanding ring (UIStroke circle / ellipse) that thins out and fades
-- o = { pos = UDim2, from = Vector2 px, to = Vector2 px, dur, color, thick, z, delay }
function RevealFx.Shockwave(parent, o)
	later(parent, o.delay, function()
		local from = o.from or Vector2.new(40, 40)
		local to = o.to or Vector2.new(600, 600)
		local f, st = ring(parent, o, from)
		st.Transparency = o.alpha or 0
		local info = TweenInfo.new(o.dur or 0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		TweenService:Create(f, info, { Size = UDim2.fromOffset(to.X, to.Y) }):Play()
		local t = TweenService:Create(st, info, { Transparency = 1, Thickness = 0 })
		t.Completed:Connect(function()
			f:Destroy()
		end)
		t:Play()
	end)
end

-- energy ring pulled inward (build-up): starts big and faint, shrinks onto the point and brightens
-- o = { pos, from = Vector2, to = Vector2, dur, color, thick, z }
function RevealFx.Implode(parent, o)
	local from = o.from or Vector2.new(560, 560)
	local f, st = ring(parent, o, from)
	st.Thickness = 1
	st.Transparency = 0.95
	local to = o.to or Vector2.new(30, 30)
	local info = TweenInfo.new(o.dur or 0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	TweenService:Create(f, info, { Size = UDim2.fromOffset(to.X, to.Y) }):Play()
	local t = TweenService:Create(st, info, { Transparency = 0.1, Thickness = o.thick or 6 })
	t.Completed:Connect(function()
		f:Destroy()
	end)
	t:Play()
end

-- full-size flash that fades out; o = { color, from, dur, z, corner }
function RevealFx.Flash(parent, o)
	o = o or {}
	local f = make("Frame", { Name = "FxFlash", Size = UDim2.fromScale(1, 1), BackgroundColor3 = o.color or WHITE, BackgroundTransparency = o.from or 0,
		BorderSizePixel = 0, ZIndex = o.z or 1 }, parent)
	if o.corner then
		make("UICorner", { CornerRadius = UDim.new(0, o.corner) }, f)
	end
	local t = TweenService:Create(f, TweenInfo.new(o.dur or 0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 })
	t.Completed:Connect(function()
		f:Destroy()
	end)
	t:Play()
end

-- shine sweep: a UIGradient's Offset runs from -1 to 1 over `dur`, then waits `pause`; repeats until cancelled
-- or the gradient is destroyed. Returns a handle with :Cancel() (like a tween, so tween lists can hold it).
function RevealFx.Sweep(gradient, dur, pause)
	dur, pause = dur or 0.8, pause or 1
	local handle = { alive = true }
	local current
	function handle.Cancel()
		handle.alive = false
		if current then
			current:Cancel()
			current = nil
		end
	end
	task.spawn(function()
		while handle.alive and gradient.Parent do
			gradient.Offset = Vector2.new(-1, 0)
			current = TweenService:Create(gradient, TweenInfo.new(dur, Enum.EasingStyle.Linear), { Offset = Vector2.new(1, 0) })
			current:Play()
			task.wait(dur + pause)
		end
		current = nil
	end)
	return handle
end

-- transparency curve of a shine band (transparent everywhere but a soft stripe in the middle)
function RevealFx.ShineBand(peak, width)
	local w = width or 0.12
	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(math.max(0.001, 0.5 - w), 1), NumberSequenceKeypoint.new(0.5, peak or 0.3),
		NumberSequenceKeypoint.new(math.min(0.999, 0.5 + w), 1), NumberSequenceKeypoint.new(1, 1),
	})
end

local STARS = { "★", "✦" }

-- confetti + star burst with gravity. o = { at = UDim2 origin, count, colors = { Color3 }, power, z, spread (radians, nil = all round) }
-- Returns stop(): removes every piece at once (also happens by itself when the layer is destroyed).
function RevealFx.Burst(parent, o)
	o = o or {}
	local n = o.count or RevealFx.Count()
	local at = o.at or UDim2.fromScale(0.5, 0.5)
	local colors = o.colors or { WHITE }
	local power = o.power or 1
	local pieces = {}
	for i = 1, n do
		local c = colors[(i - 1) % #colors + 1]
		local star = i % 3 == 0
		local g
		if star then
			local sz = math.random(18, 30)
			g = make("TextLabel", { BackgroundTransparency = 1, Text = STARS[math.random(1, #STARS)], Font = Enum.Font.FredokaOne, TextSize = sz, TextColor3 = c,
				AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(sz, sz), Position = at, ZIndex = o.z or 1 }, parent)
		else
			g = make("Frame", { BackgroundColor3 = c, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(10, 6),
				Position = at, ZIndex = o.z or 1 }, parent)
		end
		local a = o.spread and (-math.pi / 2 + (math.random() - 0.5) * o.spread) or math.random() * math.pi * 2
		local sp = (260 + math.random() * 420) * power
		table.insert(pieces, {
			g = g, star = star, x = 0, y = 0, vx = math.cos(a) * sp, vy = math.sin(a) * sp - 220 * power,
			rot = math.random() * 360, vr = (math.random() - 0.5) * 900, w = math.random(8, 14), h = math.random(4, 7),
			ph = math.random() * 6, life = 1.1 + math.random() * 0.8, t = 0,
		})
	end
	local conn
	local function stop()
		if conn then
			conn:Disconnect()
			conn = nil
		end
		for _, p in ipairs(pieces) do
			p.g:Destroy()
		end
		table.clear(pieces)
	end
	conn = RunService.RenderStepped:Connect(function(dt)
		if not parent.Parent then
			stop()
			return
		end
		dt = math.min(dt, 1 / 20)
		local alive = 0
		local drag = math.exp(-dt * 1.6)
		for _, p in ipairs(pieces) do
			if p.t &lt; p.life then
				p.t = p.t + dt
				alive = alive + 1
				p.vx = p.vx * drag
				p.vy = p.vy * drag + 1100 * dt
				p.x = p.x + p.vx * dt
				p.y = p.y + p.vy * dt
				p.rot = p.rot + p.vr * dt
				local g = p.g
				g.Position = UDim2.new(at.X.Scale, at.X.Offset + p.x, at.Y.Scale, at.Y.Offset + p.y)
				g.Rotation = p.rot
				local fade = math.clamp((p.t / p.life - 0.65) / 0.35, 0, 1)
				if p.star then
					g.TextTransparency = fade
				else
					-- flutter: the strip turns over (its width swings through zero)
					g.Size = UDim2.fromOffset(math.max(1, p.w * math.abs(math.cos(p.ph + p.t * 9))), p.h)
					g.BackgroundTransparency = fade
				end
				if p.t &gt;= p.life then
					g.Visible = false
				end
			end
		end
		if alive == 0 then
			stop()
		end
	end)
	return stop
end

return RevealFx
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXD41AC25CFE39491F9F05C83096F78F9A"><Properties><string name="Name">Rewards</string><ProtectedString name="Source">-- GIFTS: 7-day login streak + playtime chests. Button in the left column, red dot when something can be claimed.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local R = require(Shared:WaitForChild("RewardConfig"))
local Util = require(Shared:WaitForChild("Util"))
local Icons = require(Shared:WaitForChild("Icons"))
local PartConfig = require(Shared:WaitForChild("PartConfig"))

local RW = {}
local K, UI
local P
local C = Color3.fromRGB
local w = {}
local sessionBase, sessionAt = 0, os.clock()

local function sessionNow()
	return sessionBase + (os.clock() - sessionAt)
end

local function fmt(sec)
	sec = math.max(0, math.floor(sec))
	if sec &gt;= 3600 then
		return string.format("%dh %02dm", sec // 3600, sec % 3600 // 60)
	end
	return string.format("%d:%02d", sec // 60, sec % 60)
end

local function partsText(parts)
	local out = {}
	for _, id in ipairs(PartConfig.Order) do
		if parts and parts[id] then
			table.insert(out, parts[id] .. " " .. string.lower(PartConfig.Parts[id].name))
		end
	end
	return table.concat(out, ", ")
end

local function claimable(st)
	if not st or not st.daily then
		return false
	end
	if st.daily.last ~= st.daily.today then
		return true
	end
	for i, c in ipairs(R.Chests) do
		if not (st.chests and st.chests[i]) and sessionNow() &gt;= c.minutes * 60 then
			return true
		end
	end
	return false
end

local function build()
	-- button next to SHOP / JOBS
	local brow = K.hud.leftCol:FindFirstChild("Buttons")
	local holder = K.new("Frame", { Size = UDim2.fromOffset(66, 94), BackgroundTransparency = 1, LayoutOrder = 3 }, brow)
	local b = K.toy(holder, { Text = "", Color = P.green, Size = UDim2.fromOffset(66, 66), OnClick = function() UI.TogglePanel("rewards") end })
	K.hud.icon(b.face, "gift", 54, UDim2.fromOffset(6, 3)).ZIndex = b.face.ZIndex + 1
	K.text(holder, { Text = "GIFTS", TextSize = 15, Position = UDim2.fromOffset(0, 72), Size = UDim2.new(1, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Center, Outline = 2.5 })
	w.dot = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(60, 4), Size = UDim2.fromOffset(18, 18), BackgroundColor3 = P.red, ZIndex = 30, Visible = false }, holder)
	K.corner(w.dot, 9)
	K.stroke(w.dot, P.white, 2)

	local p = K.panelShell("rewards", "GIFTS", 940, 600, P.green)
	local c = p.content
	K.text(c, { Text = "DAILY STREAK  -  come back every day, missing a day starts again", Font = K.BODY, TextSize = 17, TextColor3 = P.ink, Size = UDim2.new(1, 0, 0, 24), ZIndex = 22 })
	w.days = K.new("Frame", { Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 200), BackgroundTransparency = 1, ZIndex = 22 }, c)
	K.list(w.days, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center)
	K.text(c, { Text = "PLAYTIME CHESTS  -  play today to open them, new chests every day", Font = K.BODY, TextSize = 17, TextColor3 = P.ink, Position = UDim2.fromOffset(0, 246), Size = UDim2.new(1, 0, 0, 24), ZIndex = 22 })
	w.chests = K.new("Frame", { Position = UDim2.fromOffset(0, 276), Size = UDim2.new(1, 0, 0, 200), BackgroundTransparency = 1, ZIndex = 22 }, c)
	K.list(w.chests, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center)
end

local function card(parent, order, color, title, body, btnText, btnColor, onClick, highlight)
	-- v23: white card with ink outline + shadow; the coloured band is the card's own top (it follows the rounded top
	-- corners only, the old separate band was rounded at the bottom too); claimable = thick orange outline
	local f, _, face = K.card(parent, { Size = UDim2.fromOffset(order and 118 or 160, 196), Accent = color, AccentTop = true, AccentSize = 34, Radius = 16,
		StrokeColor = highlight and P.orange or P.ink, Stroke = highlight and 5 or 3, LayoutOrder = order or 0, ZIndex = 23 })
	K.text(face, { Text = title, TextSize = 18, Size = UDim2.new(1, 0, 0, 34), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 25, Outline = 2 })
	K.new("ImageLabel", { Position = UDim2.new(0.5, -26, 0, 6), Size = UDim2.fromOffset(52, 52), BackgroundTransparency = 1, Image = Icons.Get("gift") or "", ZIndex = 24 }, f)
	K.text(f, { Text = body, Font = K.BODY, TextSize = 13, TextColor3 = P.ink, TextWrapped = true, Position = UDim2.fromOffset(6, 62), Size = UDim2.new(1, -12, 0, 44), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
	return K.toy(f, { Text = btnText, Color = btnColor, Size = UDim2.new(1, -16, 0, 44), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -6), TextSize = 16, ZIndex = 25, OnClick = onClick })
end

local function refresh(st, open)
	w.dot.Visible = claimable(st)
	if open ~= "rewards" or not st.daily then
		w.sig = nil
		return
	end
	-- rebuild the cards only when something changed; the chest timers tick on their own buttons
	-- (rebuilding every second destroyed the button under the player's finger)
	local now = sessionNow()
	local sig = { st.daily.today, st.daily.last, st.daily.day, Util.FormatNumber(K.store.Income) }
	for i, e in ipairs(R.Chests) do
		table.insert(sig, (st.chests and st.chests[i]) and "g" or (now &gt;= e.minutes * 60 and "r" or "w"))
	end
	sig = table.concat(sig, "|")
	if sig == w.sig then
		for i, e in ipairs(R.Chests) do
			local btn = w.chestBtns[i]
			if btn and not (st.chests and st.chests[i]) and now &lt; e.minutes * 60 then
				btn.SetText(fmt(e.minutes * 60 - now))
			end
		end
		return
	end
	w.sig = sig
	K.clear(w.days)
	local today = st.daily.today
	local claimedToday = st.daily.last == today
	local nextDay = claimedToday and st.daily.day or R.NextDay(st.daily, today)
	for i, e in ipairs(R.Daily) do
		local done = (claimedToday and i &lt;= st.daily.day) or (not claimedToday and i &lt; nextDay)
		local isNext = i == nextDay and not claimedToday
		local body = "$" .. Util.FormatNumber(R.Money(e, K.store.Income)) .. "\n" .. partsText(e.parts) .. (e.pity and "\n+ Epic guarantee" or "")
		card(w.days, i, i == 7 and P.orange or P.blue, "DAY " .. i, body, done and "DONE" or (isNext and "CLAIM" or "LOCKED"), done and P.grey or (isNext and P.green or P.grey),
			function()
				if isNext then
					Net.Get("ClaimDaily"):FireServer()
				end
			end, isNext)
	end
	K.clear(w.chests)
	w.chestBtns = {}
	for i, e in ipairs(R.Chests) do
		local got = st.chests and st.chests[i]
		local left = e.minutes * 60 - now
		local body = "$" .. Util.FormatNumber(R.Money(e, K.store.Income)) .. "\n" .. partsText(e.parts) .. (e.gear and "\n+ gear" or "")
		w.chestBtns[i] = card(w.chests, nil, P.green, e.minutes .. " MIN", body, got and "OPENED" or (left &lt;= 0 and "OPEN" or fmt(left)), got and P.grey or (left &lt;= 0 and P.green or P.grey),
			function()
				if not got and sessionNow() &gt;= e.minutes * 60 then
					Net.Get("ClaimChest"):FireServer(i)
				end
			end, left &lt;= 0 and not got)
	end
end

function RW.Start(ui)
	UI = ui
	K = UI.Kit()
	P = K.P
	build()
	K.store.Changed.Event:Connect(function()
		local st = K.store.State
		if st and st.sessionTime then
			sessionBase, sessionAt = st.sessionTime, os.clock()
		end
	end)
	table.insert(UI.Hooks, refresh)
	task.spawn(function()
		while true do
			task.wait(1)
			local st = K.store.State
			if st then
				refresh(st, K.state.open)
			end
		end
	end)
end

return RW
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXC6126B5F8CB84CD68275A997EE8A1547"><Properties><string name="Name">Settings</string><ProtectedString name="Source">-- SETTINGS: music + sound-effect volume sliders and on/off switches. Saved in the player's profile
-- (DataService.SanitizeSettings), applied on join. Switches are read by other modules as LocalPlayer attributes
-- "Opt_&lt;name&gt;" (false = off): markers (Markers), guide (Guidance), shake (CineFx), fov (SpeedLanes);
-- notifications go through UI.SetNotificationsEnabled.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))

local Settings = {}
local K, UI, P
local cur = { music = 0.5, sfx = 0.8, markers = true, notes = true, shake = true, fov = true, guide = true }
local loaded = false
local widgets = {}
local saveToken = 0

-- only the basics on screen; guide / shake / fov keep their defaults (on) and still work from saved settings
local SWITCHES = {
	{ "markers", "Map markers" },
	{ "notes", "Notifications" },
}

local function apply()
	UI.MusicGroup.Volume = cur.music
	UI.SfxGroup.Volume = cur.sfx
	local lp = Players.LocalPlayer
	for _, key in ipairs({ "markers", "guide", "notes", "shake", "fov" }) do
		lp:SetAttribute("Opt_" .. key, cur[key])
	end
	UI.SetNotificationsEnabled(cur.notes)
end

-- one save 1 s after the last change (dragging a slider does not spam the server)
local function save()
	saveToken = saveToken + 1
	local token = saveToken
	task.delay(1, function()
		if token == saveToken then
			Net.Get("SaveSettings"):FireServer(cur)
		end
	end)
end

local function refresh()
	for key, wd in pairs(widgets) do
		if wd.fill then
			wd.fill.Size = UDim2.fromScale(cur[key], 1)
			wd.knob.Position = UDim2.new(cur[key], 0, 0.5, 0)
			wd.value.Text = math.floor(cur[key] * 100 + 0.5) .. "%"
		else
			wd.btn.SetText(cur[key] and "ON" or "OFF")
			wd.btn.SetColor(cur[key] and P.green or P.grey)
		end
	end
end

-- v23: every setting is its own white card row (ink outline + shadow) so it reads on the cream panel
local ROW_H, ROW_STEP = 54, 64
local function rowCard(parent, i)
	return K.card(parent, { Position = UDim2.fromOffset(0, (i - 1) * ROW_STEP), Size = UDim2.new(1, 0, 0, ROW_H), Radius = 16, ZIndex = 22 })
end

local function slider(parent, i, key, title)
	local r = rowCard(parent, i)
	K.text(r, { Text = title, TextSize = 20, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(16, 12), Size = UDim2.fromOffset(204, 30), ZIndex = 24 })
	-- recessed track (the knob still follows the finger over the whole track)
	local track = K.inset(r, { Class = "TextButton", Position = UDim2.fromOffset(230, 21), Size = UDim2.fromOffset(250, 12), Radius = 6, ZIndex = 24 })
	local fill = K.new("Frame", { Size = UDim2.fromScale(cur[key], 1), BackgroundColor3 = P.blue, ZIndex = 25 }, track)
	K.corner(fill, 6)
	local knob = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(cur[key], 0, 0.5, 0), Size = UDim2.fromOffset(26, 26), BackgroundColor3 = P.white, ZIndex = 26 }, track)
	K.corner(knob, 13)
	K.stroke(knob, P.ink, 3)
	local value = K.text(r, { Text = "", Font = K.BODY, TextSize = 18, TextColor3 = P.ink, Position = UDim2.fromOffset(500, 12), Size = UDim2.fromOffset(70, 30), ZIndex = 24 })
	widgets[key] = { fill = fill, knob = knob, value = value }
	local dragging = false
	local function setFrom(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		cur[key] = math.floor(a * 100 + 0.5) / 100
		apply()
		refresh()
		save()
	end
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFrom(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFrom(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

local function build()
	-- SETTINGS button: 4th in the left button row (same style as SHOP / JOBS / GIFTS)
	local brow = K.hud.leftCol:FindFirstChild("Buttons")
	local holder = K.new("Frame", { Size = UDim2.fromOffset(66, 94), BackgroundTransparency = 1, LayoutOrder = 4 }, brow)
	local b = K.toy(holder, { Text = "", Color = P.grey, Size = UDim2.fromOffset(66, 66), OnClick = function() UI.TogglePanel("settings") end })
	K.hud.icon(b.face, "settings", 54, UDim2.fromOffset(6, 3)).ZIndex = b.face.ZIndex + 1
	K.text(holder, { Text = "SETTINGS", TextSize = 15, Position = UDim2.fromOffset(-6, 72), Size = UDim2.new(1, 12, 0, 20), TextXAlignment = Enum.TextXAlignment.Center, Outline = 2.5 })

	-- 4 rows x 64 px = 252 px of the 276 px content (panel 380 high: 20 px more for the row shadows)
	local p = K.panelShell("settings", "SETTINGS", 640, 380, P.blue)
	local c = p.content
	slider(c, 1, "music", "MUSIC")
	slider(c, 2, "sfx", "SOUND EFFECTS")
	for i, s in ipairs(SWITCHES) do
		local r = rowCard(c, 2 + i)
		K.text(r, { Text = s[2], Font = K.BODY, TextSize = 19, TextColor3 = P.ink, Position = UDim2.fromOffset(16, 12), Size = UDim2.fromOffset(400, 30), ZIndex = 24 })
		local key = s[1]
		widgets[key] = {
			btn = K.toy(r, { Text = "ON", Color = P.green, Size = UDim2.fromOffset(110, 44), Position = UDim2.fromOffset(464, 4), TextSize = 20, ZIndex = 24, OnClick = function()
				cur[key] = not cur[key]
				apply()
				refresh()
				save()
			end }),
		}
	end
	refresh()
end

function Settings.Start(ui)
	UI = ui
	K = UI.Kit()
	P = K.P
	build()
	apply()
	-- the saved settings arrive with the first state from the server
	local function load()
		local st = K.store.State
		if not loaded and st and type(st.settings) == "table" then
			loaded = true
			for k, v in pairs(st.settings) do
				-- guide / shake / fov have no switch any more: always on (an old saved "false" would be stuck)
				if cur[k] ~= nil and type(v) == type(cur[k]) and k ~= "guide" and k ~= "shake" and k ~= "fov" then
					cur[k] = v
				end
			end
			apply()
			refresh()
		end
	end
	K.store.Changed.Event:Connect(load)
	load()
end

return Settings
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXF58777F232DB4C3FB0B197B050B8CB6A"><Properties><string name="Name">SpeedLanes</string><ProtectedString name="Source">-- Running lanes: dark strips with white arrows. Boost only while running the way the arrows point (either way on
-- the two-way plaza lanes).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MapConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MapConfig"))

local SpeedLanes = {}
SpeedLanes.Boosting = false

function SpeedLanes.Start(getBaseSpeed)
	local player = Players.LocalPlayer
	local fov = 70
	RunService.Heartbeat:Connect(function(dt)
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local cam = Workspace.CurrentCamera
		local boost = false
		if hum and hrp and hum.Health &gt; 0 and hrp.Position.Y &lt; 8 then
			local lane = MapConfig.LaneAt(hrp.Position)
			local md = hum.MoveDirection
			if lane and md.Magnitude &gt; 0.1 and MapConfig.LaneBoosts(lane, md) then
				boost = true
			end
			local base = getBaseSpeed and getBaseSpeed() or MapConfig.WalkSpeed
			local want = boost and (MapConfig.LaneSpeed + (base - MapConfig.WalkSpeed)) or base
			if math.abs(hum.WalkSpeed - want) &gt; 0.01 then
				hum.WalkSpeed = want
			end
		end
		SpeedLanes.Boosting = boost
		if cam and cam.CameraType == Enum.CameraType.Custom then
			local kick = boost and game:GetService("Players").LocalPlayer:GetAttribute("Opt_fov") ~= false -- Settings
			fov = fov + ((kick and 80 or 70) - fov) * math.min(1, dt * 5)
			if math.abs(cam.FieldOfView - fov) &gt; 0.01 then -- a camera write re-renders: only when it really moves
				cam.FieldOfView = fov
			end
		end
	end)
end

return SpeedLanes
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXD7D2B98ACB174514A80D1C6EC87784A9"><Properties><string name="Name">Trade</string><ProtectedString name="Source">-- Trading UI: TRADE button (right side) -&gt; pick a player -&gt; request; incoming request card; two-sided trade window.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local GearConfig = require(Shared:WaitForChild("GearConfig"))
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local Util = require(Shared:WaitForChild("Util"))
local Icons = require(Shared:WaitForChild("Icons"))

local TR = {}
local K, UI
local P
local C = Color3.fromRGB
local w = {}
local offer = { cars = {}, money = 0, parts = {} } -- my local draft
local last -- last state from the server

local function send()
	local cars = {}
	for uid in pairs(offer.cars) do
		table.insert(cars, uid)
	end
	Net.Get("TradeUpdate"):FireServer({ cars = cars, money = offer.money, parts = offer.parts })
end

local function rc(r)
	return CarConfig.Rarities[r].color
end

---------------------------------------------------------------- player list
local function refreshList()
	K.clear(w.list)
	local any = false
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= Players.LocalPlayer then
			any = true
			local row = K.card(w.list, { Size = UDim2.new(1, 0, 0, 70), Radius = 16, ZIndex = 23 })
			local ok, img = pcall(function()
				return Players:GetUserThumbnailAsync(p.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
			end)
			-- avatar in a recessed round well (the old light grey disc vanished on the white row)
			local face = K.inset(row, { Class = "ImageLabel", Position = UDim2.fromOffset(10, 7), Size = UDim2.fromOffset(56, 56), Image = ok and img or "", Radius = 28, ZIndex = 24 })
			K.text(row, { Text = p.DisplayName, TextSize = 22, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(78, 0), Size = UDim2.new(1, -260, 1, 0), ZIndex = 24 })
			K.toy(row, { Text = "REQUEST", Color = P.green, Size = UDim2.fromOffset(160, 54), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), TextSize = 20, ZIndex = 25,
				OnClick = function()
					Net.Get("TradeRequest"):FireServer(p.UserId)
					UI.TogglePanel(nil)
				end })
		end
	end
	if not any then
		K.text(w.list, { Text = "Nobody else is on this server yet. Invite a friend!", Font = K.BODY, TextSize = 18, TextColor3 = P.muted, Size = UDim2.new(1, 0, 0, 40), ZIndex = 23 })
	end
end

---------------------------------------------------------------- incoming request
local function requestCard(msg)
	if w.request and w.request.Parent then
		w.request:Destroy()
	end
	if UI.IsCinematic() then
		Net.Get("TradeRespond"):FireServer(msg.from, false) -- busy watching a car reveal
		return
	end
	-- v23: shared dialog shell (shadow + blue header strip); w.request is the holder, so destroying it takes everything
	local card, f = K.dialogShell(K.overlay, { Name = "TradeRequest", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -150, 0, 120), Size = UDim2.fromOffset(330, 164),
		Radius = 20, ZIndex = 70, Color = P.blue, HeadH = 44, Title = "TRADE REQUEST", TitleSize = 22 })
	w.request = f
	K.text(card, { Text = msg.name .. " wants to trade with you", Font = K.BODY, TextSize = 16, TextColor3 = P.muted, Position = UDim2.fromOffset(16, 52), Size = UDim2.new(1, -32, 0, 22), ZIndex = 73 })
	local function answer(ok)
		Net.Get("TradeRespond"):FireServer(msg.from, ok)
		f:Destroy()
	end
	K.toy(card, { Text = "ACCEPT", Color = P.green, Size = UDim2.fromOffset(140, 54), Position = UDim2.fromOffset(16, 92), TextSize = 20, ZIndex = 73, OnClick = function() answer(true) end })
	K.toy(card, { Text = "DECLINE", Color = P.red, Size = UDim2.fromOffset(140, 54), Position = UDim2.fromOffset(174, 92), TextSize = 20, ZIndex = 73, OnClick = function() answer(false) end })
	UI.Sfx("ping")
	task.delay(25, function()
		if f.Parent then
			f:Destroy()
		end
	end)
end

---------------------------------------------------------------- trade window
-- "  ·  x2 INCOME 4:59" for a running gear as TradeService.describe sends it ({ id, left }), else ""
local function gearSuffix(g)
	local gdef = type(g) == "table" and GearConfig.ById[g.id]
	local left = gdef and math.floor(tonumber(g.left) or 0)
	if not gdef or left &lt;= 0 then
		return ""
	end
	return string.format("  ·  %s %d:%02d", GearConfig.Label(gdef), left // 60, left % 60)
end

local function carRow(parent, car, order, selected, onClick, gear)
	local def = CarConfig.ById[car.typeId]
	if not def then
		return
	end
	-- v23: white card (ink outline, rarity band on the left, small shadow); offered = green fill + green outline
	local body, _, b = K.card(parent, { Class = "TextButton", Size = UDim2.new(1, 0, 0, 44), Color = selected and C(220, 250, 226) or P.card, Accent = rc(def.rarity),
		AccentSize = 6, StrokeColor = selected and C(30, 158, 64) or P.ink, Stroke = selected and 4 or 2, Shadow = 3, Radius = 12, LayoutOrder = order, ZIndex = 24 })
	K.text(body, { Text = string.format("%s  Lv%d", def.name, car.level) .. gearSuffix(gear), Font = K.BODY, TextSize = 15, TextColor3 = P.ink, TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -60, 1, 0), ZIndex = 25 })
	K.text(body, { Text = string.upper(string.sub(def.rarity, 1, 4)), Font = K.BODY, TextSize = 12, TextColor3 = K.lift(rc(def.rarity), -0.3), AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 0), Size = UDim2.fromOffset(46, 44), TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 25 })
	if onClick then
		b.Activated:Connect(onClick)
	end
end

local function buildWindow()
	local p = K.panelShell("trade", "TRADE", 960, 620, P.blue)
	local c = p.content
	w.window = p
	-- v23: both sides are the same white card (ink outline + shadow) with recessed wells for the car lists, the money
	-- field, the part steppers and the partner's extras; inner width 426 px
	local function side(pos)
		local f = K.card(c, { Position = pos, Size = UDim2.new(0.5, -8, 1, -94), Radius = 18, ZIndex = 22 })
		K.new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 8) }, f)
		return f
	end
	local function well(parent, y, h)
		return K.inset(parent, { Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, h), Radius = 12, ZIndex = 24 })
	end
	-- left: my side
	local mine = side(UDim2.new())
	K.text(mine, { Text = "YOUR OFFER", TextSize = 22, TextColor3 = P.ink, Outline = false, Size = UDim2.new(1, 0, 0, 26), ZIndex = 24 })
	K.text(mine, { Text = "Tap cars to add / remove (max 8)", Font = K.BODY, TextSize = 13, TextColor3 = P.muted, Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 18), ZIndex = 24 })
	w.myCars = K.scroller(well(mine, 48, 128), UDim2.new(), UDim2.fromScale(1, 1))
	-- money
	K.text(mine, { Text = "MONEY", TextSize = 18, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(0, 189), Size = UDim2.fromOffset(64, 24), ZIndex = 24 })
	w.moneyBox = K.inset(mine, { Class = "TextBox", Text = "0", PlaceholderText = "0", ClearTextOnFocus = false, Font = K.BODY, TextSize = 18, TextColor3 = P.ink,
		Position = UDim2.fromOffset(66, 185), Size = UDim2.fromOffset(140, 32), Radius = 8, ZIndex = 24 })
	w.moneyBox.FocusLost:Connect(function()
		local v = tonumber((string.gsub(w.moneyBox.Text, "[^%d]", ""))) or 0
		offer.money = math.clamp(v, 0, K.store.Money)
		send()
	end)
	for i, add in ipairs({ 1000, 10000, 100000 }) do
		K.toy(mine, { Text = "+" .. Util.FormatNumber(add), Color = P.yellow, Size = UDim2.fromOffset(66, 34), Position = UDim2.fromOffset(212 + (i - 1) * 72, 184), TextSize = 14, ZIndex = 25,
			OnClick = function()
				offer.money = math.min(offer.money + add, K.store.Money)
				send()
			end })
	end
	-- parts steppers: 10 parts in two rows of five, in their own well
	local steps = well(mine, 226, 174)
	w.partRows = {}
	for i, id in ipairs(PartConfig.Order) do
		local x, y = 3 + ((i - 1) % 5) * 84, 4 + math.floor((i - 1) / 5) * 84
		local img = K.new("ImageLabel", { Position = UDim2.fromOffset(x + 22, y), Size = UDim2.fromOffset(36, 36), BackgroundTransparency = 1, Image = Icons.Get(id) or "", ZIndex = 25 }, steps)
		local n = K.text(steps, { Text = "0", TextSize = 17, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(x, y + 36), Size = UDim2.fromOffset(80, 18), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 25 })
		K.toy(steps, { Text = "-", Color = P.red, Size = UDim2.fromOffset(36, 30), Position = UDim2.fromOffset(x + 2, y + 54), TextSize = 20, ZIndex = 26, OnClick = function()
			offer.parts[id] = math.max(0, (offer.parts[id] or 0) - 1)
			send()
		end })
		K.toy(steps, { Text = "+", Color = P.green, Size = UDim2.fromOffset(36, 30), Position = UDim2.fromOffset(x + 42, y + 54), TextSize = 20, ZIndex = 26, OnClick = function()
			offer.parts[id] = math.min(K.store.Banked(id), (offer.parts[id] or 0) + 1)
			send()
		end })
		w.partRows[id] = n
		img.ImageTransparency = 0
	end
	-- right: their side (same card, same wells)
	local theirs = side(UDim2.new(0.5, 8, 0, 0))
	w.theirTitle = K.text(theirs, { Text = "THEIR OFFER", TextSize = 22, TextColor3 = P.ink, Outline = false, Size = UDim2.new(1, 0, 0, 26), ZIndex = 24 })
	w.theirCars = K.scroller(well(theirs, 48, 236), UDim2.new(), UDim2.fromScale(1, 1))
	local extra = well(theirs, 292, 108)
	w.theirExtra = K.text(extra, { Text = "", Font = K.BODY, TextSize = 17, TextColor3 = P.ink, RichText = true, TextWrapped = true, Position = UDim2.fromOffset(12, 8),
		Size = UDim2.new(1, -24, 1, -16), TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 25 })
	-- bottom bar
	w.status = K.text(c, { Text = "", Font = K.BODY, TextSize = 18, TextColor3 = P.ink, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -24), Size = UDim2.new(0.5, 0, 0, 30), ZIndex = 23 })
	w.cancel = K.toy(c, { Text = "CANCEL", Color = P.red, Size = UDim2.fromOffset(170, 64), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -250, 1, 0), TextSize = 22, ZIndex = 24, OnClick = function()
		Net.Get("TradeCancel"):FireServer()
	end })
	w.ready = K.toy(c, { Text = "READY", Color = P.green, Size = UDim2.fromOffset(230, 64), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, 0, 1, 0), TextSize = 26, ZIndex = 24, OnClick = function()
		Net.Get("TradeReady"):FireServer(not (last and last.readyMe))
	end })
end

local function partsLine(parts)
	local out = {}
	for _, id in ipairs(PartConfig.Order) do
		if parts and (parts[id] or 0) &gt; 0 then
			table.insert(out, parts[id] .. " " .. id)
		end
	end
	return #out &gt; 0 and table.concat(out, ", ") or "no parts"
end

local function renderState(msg)
	last = msg
	if K.state.open ~= "trade" then
		if UI.IsCinematic() then
			w.pendingOpen = true
		else
			UI.TogglePanel("trade")
		end
	end
	-- my cars: every car I own, offered ones highlighted
	offer.cars = {}
	local myGear = {} -- running gears of my offered cars (they move with the car)
	for _, c in ipairs(msg.mine.cars) do
		offer.cars[c.uid] = true
		myGear[c.uid] = c.gear
	end
	offer.money = msg.mine.money or 0
	offer.parts = msg.mine.parts or {}
	K.clear(w.myCars)
	local st = K.store.State
	for i, car in ipairs(st and st.cars or {}) do
		local sel = offer.cars[car.uid]
		carRow(w.myCars, car, sel and i or i + 1000, sel, function()
			if offer.cars[car.uid] then
				offer.cars[car.uid] = nil
			else
				local n = 0
				for _ in pairs(offer.cars) do
					n = n + 1
				end
				if n &gt;= 8 then
					UI.Toast("Max 8 cars per trade", "warn")
					return
				end
				offer.cars[car.uid] = true
			end
			send()
		end, myGear[car.uid])
	end
	w.moneyBox.Text = tostring(offer.money)
	for id, n in pairs(w.partRows) do
		n.Text = tostring(offer.parts[id] or 0) .. " / " .. K.store.Banked(id)
	end
	w.theirTitle.Text = string.upper(msg.partner) .. " OFFERS"
	K.clear(w.theirCars)
	for i, car in ipairs(msg.theirs.cars) do
		carRow(w.theirCars, car, i, false, nil, car.gear)
	end
	if #msg.theirs.cars == 0 then
		K.text(w.theirCars, { Text = "No cars", Font = K.BODY, TextSize = 15, TextColor3 = P.muted, Size = UDim2.new(1, 0, 0, 30), ZIndex = 24 })
	end
	w.theirExtra.Text = string.format("&lt;b&gt;$%s&lt;/b&gt;\n%s", Util.FormatNumber(msg.theirs.money or 0), partsLine(msg.theirs.parts))
	if msg.countdown then
		w.status.Text = string.format("Both ready - trading in %d...", math.ceil(msg.countdown))
		task.delay(1, function()
			if last == msg and msg.countdown and msg.countdown &gt; 1 then
				msg.countdown = msg.countdown - 1
				renderState(msg)
			end
		end)
	elseif msg.readyMe and not msg.readyThem then
		w.status.Text = "Waiting for " .. msg.partner .. "..."
	elseif msg.readyThem then
		w.status.Text = msg.partner .. " is READY"
	else
		w.status.Text = "Make your offer, then press READY"
	end
	w.ready.SetText(msg.readyMe and "UNREADY" or "READY", nil)
	w.ready.SetColor(msg.readyMe and P.orange or P.green)
end

function TR.Start(ui)
	UI = ui
	K = UI.Kit()
	P = K.P
	-- right-side button under CARS
	local holder = K.new("Frame", { Size = UDim2.fromOffset(122, 104), BackgroundTransparency = 1, LayoutOrder = 4 }, K.hud.side)
	K.toy(holder, { Text = "TRADE", Image = "trade", Icon = "🤝", Color = P.blue, Size = UDim2.fromOffset(122, 104), OnClick = function() UI.TogglePanel(last and "trade" or "tradeList") end }) -- a live trade reopens its window
	local lp = K.panelShell("tradeList", "TRADE WITH", 640, 520, P.blue)
	w.list = K.scroller(lp.content, UDim2.new(), UDim2.fromScale(1, 1))
	buildWindow()
	local wasOpen
	table.insert(UI.Hooks, function(_, open)
		-- build the player list once per opening (it fetches avatars; rebuilding on every state change flickered)
		if open == "tradeList" and wasOpen ~= "tradeList" then
			wasOpen = open
			task.spawn(refreshList)
		end
		-- closing the live trade window (X / background / another panel) cancels the trade for both players;
		-- a cinematic closing it sets pendingOpen first and keeps the trade
		if wasOpen == "trade" and open ~= "trade" and last ~= nil and not w.pendingOpen and not UI.IsCinematic() then
			Net.Get("TradeCancel"):FireServer()
		end
		wasOpen = open
		-- a trade that started during a cinematic opens its window afterwards
		if w.pendingOpen and open == nil and not UI.IsCinematic() then
			w.pendingOpen = false
			task.defer(UI.TogglePanel, "trade")
		end
	end)
	table.insert(UI.Overlays, function()
		if last ~= nil then
			w.pendingOpen = true -- the trade window comes back after the cinematic
		end
		if w.request and w.request.Parent then
			w.request:Destroy()
		end
	end)
	Net.Get("TradeEvent").OnClientEvent:Connect(function(msg)
		if msg.type == "request" then
			requestCard(msg)
		elseif msg.type == "state" then
			renderState(msg)
		elseif msg.type == "closed" then
			last = nil
			w.pendingOpen = false
			if K.state.open == "trade" then
				UI.TogglePanel(nil)
			end
			if msg.reason == "done" then
				UI.Sfx("fanfare")
				UI.Toast("Trade complete!", "good")
			else
				UI.Toast(msg.reason or "Trade cancelled", "warn")
			end
		end
	end)
end

return TR
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5C021864A60C445CB16E2BCD1938C064"><Properties><string name="Name">TrapVisuals</string><ProtectedString name="Source">-- Throw platform levels on the client (v24):
--   * spins the "TrapSpin" models (the geared turntable ring) that BaseService builds on every owned base nearby
--   * scales the "TrapSpark" emitters (metal grinding sparks) with Perf (LOW = fewer sparks)
--   * an "Upgrade Platform" prompt at your own trap (client-only, so only the owner sees it) that opens the throw menu
--   * the upgrade burst (dust puff, metal sparks, clank + cash sound, small shake) when the server says "TrapUpgraded"
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local BaseLayout = require(Shared:WaitForChild("BaseLayout"))
local TrapConfig = require(Shared:WaitForChild("TrapConfig"))
local Perf = require(script.Parent:WaitForChild("Perf"))

local TrapVisuals = {}
local UI, store, Cine

local SPIN_RADIUS = 180
local SPARK_SCALE = { HIGH = 1, MED = 0.6, LOW = 0.25 }
local CYAN = Color3.fromRGB(70, 225, 255)
local GOLD = Color3.fromRGB(255, 196, 54)

---------------------------------------------------------------- spin + sparks
-- [model] = { parts = {BasePart}, offsets = {CFrame}, conns }: each part's CFrame relative to the ring centre
-- (SpinCF) taken once as the server built it (unrotated); every frame they move together with one BulkMoveTo
local spinners = {}

local function dropSpin(m)
	local e = spinners[m]
	if e then
		for _, c in ipairs(e.conns) do
			c:Disconnect()
		end
		spinners[m] = nil
	end
end

local function addSpin(m)
	if not m:IsA("Model") or spinners[m] then
		return
	end
	local e = { parts = {}, offsets = {}, conns = {} }
	local function track(p)
		local cf = m:GetAttribute("SpinCF")
		if p:IsA("BasePart") and typeof(cf) == "CFrame" and not table.find(e.parts, p) then
			table.insert(e.parts, p)
			table.insert(e.offsets, cf:ToObjectSpace(p.CFrame))
		end
	end
	for _, p in ipairs(m:GetDescendants()) do
		track(p)
	end
	table.insert(e.conns, m.DescendantAdded:Connect(track)) -- streamed-in parts arrive unrotated
	table.insert(e.conns, m.DescendantRemoving:Connect(function(p)
		local i = table.find(e.parts, p)
		if i then
			table.remove(e.parts, i)
			table.remove(e.offsets, i)
		end
	end))
	spinners[m] = e
end

local function scaleSpark(e)
	if e:IsA("ParticleEmitter") then
		local base = e:GetAttribute("BaseRate") or e.Rate
		e.Rate = base * (SPARK_SCALE[Perf.Level()] or 1)
	end
end

local frame = 0
local function step()
	frame = frame + 1
	if Perf.Level() == "LOW" and frame % 2 == 1 then
		return -- half rate on weak devices
	end
	local cam = Workspace.CurrentCamera
	local camPos = cam and cam.CFrame.Position
	local now = os.clock()
	local parts, cfs, n = {}, {}, 0
	for m, e in pairs(spinners) do
		if not m.Parent then
			dropSpin(m)
		else
			local cf, speed = m:GetAttribute("SpinCF"), m:GetAttribute("SpinSpeed")
			if typeof(cf) == "CFrame" and type(speed) == "number" and (not camPos or (cf.Position - camPos).Magnitude &lt; SPIN_RADIUS) then
				local rot = cf * CFrame.Angles(0, (now * speed) % (math.pi * 2), 0)
				for i, p in ipairs(e.parts) do
					n = n + 1
					parts[n], cfs[n] = p, rot * e.offsets[i]
				end
			end
		end
	end
	if n &gt; 0 then
		Workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

---------------------------------------------------------------- prompt at your own trap
local promptPart, prompt, promptBase

local function trapLevel()
	local st = store.State
	return TrapConfig.Clamp(st and st.trapLevel or 1)
end

local function refreshPrompt()
	local st = store.State
	local idx = st and st.baseIndex
	if idx ~= promptBase then
		if promptPart then
			promptPart:Destroy()
			promptPart, prompt = nil, nil
		end
		promptBase = idx
		if idx then
			local t = BaseLayout.TrapLocal
			-- the deck's front edge (towards the plaza, where you walk up from), chest height
			local p = Instance.new("Part")
			p.Name = "TrapUpgradePrompt"
			p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
			p.Transparency = 1
			p.Size = Vector3.new(1, 1, 1)
			p.CFrame = BaseLayout.GetBaseCFrame(idx) * CFrame.new(t.X + 9.6, 3.2, t.Z)
			p.Parent = Workspace
			local pp = Instance.new("ProximityPrompt")
			pp.ActionText = "Upgrade Platform"
			pp.HoldDuration = 0
			pp.MaxActivationDistance = 14
			pp.RequiresLineOfSight = false
			pp.Parent = p
			pp.Triggered:Connect(function()
				if UI.IsCinematic and UI.IsCinematic() then
					return
				end
				local K = UI.Kit()
				if K.state.open ~= "throw" then
					UI.TogglePanel("throw") -- the PLATFORM row with the UPGRADE button is in the throw menu
				end
			end)
			promptPart, prompt = p, pp
		end
	end
	if prompt then
		local lvl = trapLevel()
		prompt.ObjectText = lvl &gt;= TrapConfig.MaxLevel and string.format("PLATFORM Lv %d (MAX)", lvl) or string.format("PLATFORM Lv %d", lvl)
	end
end

---------------------------------------------------------------- upgrade burst
-- solid-world feel (v25): no glowing parts, just a dust puff off the deck, a shower of short metal sparks, the clank
-- of new hardware bolting on and a small camera shake
local function tw(o, t, props, style)
	local tween = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

function TrapVisuals.Burst(level, baseIndex)
	baseIndex = baseIndex or (store.State and store.State.baseIndex)
	if not baseIndex then
		return
	end
	level = TrapConfig.Clamp(level)
	local low = Perf.Level() == "LOW"
	local color = level &gt;= TrapConfig.MaxLevel and GOLD or CYAN
	local bcf = BaseLayout.GetBaseCFrame(baseIndex)
	local pad = bcf:PointToWorldSpace(BaseLayout.TrapLocal) + Vector3.new(0, 1.9, 0)
	-- an invisible emitter box over the whole deck
	local anchor = Instance.new("Part")
	anchor.Name = "TrapUpgradeBurst"
	anchor.Anchored, anchor.CanCollide, anchor.CanQuery, anchor.CanTouch, anchor.CastShadow = true, false, false, false, false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(17, 0.2, 17)
	anchor.CFrame = CFrame.new(pad)
	anchor.Parent = Workspace
	-- dust: grey-beige puffs rolling out low over the deck
	local dust = Instance.new("ParticleEmitter")
	dust.Texture = "rbxasset://textures/particles/smoke_main.dds"
	dust.Color = ColorSequence.new(Color3.fromRGB(196, 186, 168), Color3.fromRGB(150, 144, 134))
	dust.LightEmission, dust.LightInfluence = 0, 1
	dust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.6), NumberSequenceKeypoint.new(1, 5) })
	dust.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
	dust.Lifetime = NumberRange.new(0.9, 1.6)
	dust.Speed = NumberRange.new(4, 9)
	dust.SpreadAngle = Vector2.new(80, 80)
	dust.EmissionDirection = Enum.NormalId.Top
	dust.Acceleration = Vector3.new(0, 1.5, 0)
	dust.Drag = 3
	dust.RotSpeed = NumberRange.new(-40, 40)
	dust.Rate = 0
	dust.Shape = Enum.ParticleEmitterShape.Box
	dust.Parent = anchor
	dust:Emit(low and 8 or 22)
	-- metal sparks: short, orange, falling fast
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 236, 170)),
		ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 150, 40)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(190, 60, 20)),
	})
	e.LightEmission, e.LightInfluence = 0.8, 0.2
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.18), NumberSequenceKeypoint.new(1, 0.03) })
	e.Lifetime = NumberRange.new(0.3, 0.6)
	e.Speed = NumberRange.new(12, 24)
	e.SpreadAngle = Vector2.new(60, 60)
	e.EmissionDirection = Enum.NormalId.Top
	e.Acceleration = Vector3.new(0, -50, 0)
	e.Drag = 1.5
	e.Rate = 0
	e.Shape = Enum.ParticleEmitterShape.Box
	e.Parent = anchor
	e:Emit(low and 20 or 70)
	-- floating "Lv N" over the deck
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(260, 90)
	bb.StudsOffsetWorldSpace = Vector3.new(0, 6, 0)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.MaxDistance = 160
	bb.Adornee = anchor
	bb.Parent = anchor
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = UDim2.fromScale(1, 1)
	l.Font = Enum.Font.LuckiestGuy
	l.TextScaled = true
	l.TextColor3 = color
	l.TextStrokeTransparency = 0
	l.TextStrokeColor3 = Color3.fromRGB(27, 31, 42)
	l.Text = string.format("PLATFORM Lv %d!", level)
	l.Parent = bb
	tw(bb, 2.2, { StudsOffsetWorldSpace = Vector3.new(0, 16, 0) })
	task.delay(1.4, function()
		tw(l, 0.8, { TextTransparency = 1, TextStrokeTransparency = 1 })
	end)
	if UI then
		UI.Sfx("clank")
		task.delay(0.18, function()
			UI.Sfx("clank")
		end)
		task.delay(0.35, function()
			UI.Sfx("cash")
		end)
	end
	if Cine then
		Cine.Shake(0.3, 0.35)
	end
	Debris:AddItem(anchor, 2.6)
end

---------------------------------------------------------------- start
function TrapVisuals.Start(ui, storeModule, cine)
	UI, store, Cine = ui, storeModule, cine
	for _, m in ipairs(CollectionService:GetTagged("TrapSpin")) do
		addSpin(m)
	end
	CollectionService:GetInstanceAddedSignal("TrapSpin"):Connect(addSpin)
	CollectionService:GetInstanceRemovedSignal("TrapSpin"):Connect(dropSpin)
	for _, e in ipairs(CollectionService:GetTagged("TrapSpark")) do
		scaleSpark(e)
	end
	CollectionService:GetInstanceAddedSignal("TrapSpark"):Connect(scaleSpark)
	Perf.Changed.Event:Connect(function()
		for _, e in ipairs(CollectionService:GetTagged("TrapSpark")) do
			scaleSpark(e)
		end
	end)
	RunService.RenderStepped:Connect(step)
	store.Changed.Event:Connect(refreshPrompt)
	refreshPrompt()
	-- money ticks only refresh the HUD: keep the throw menu's UPGRADE button colour live too
	store.MoneyChanged.Event:Connect(function()
		local K = UI.Kit()
		if K.state.open == "throw" and K.panels.trapRefresh then
			K.panels.trapRefresh()
		end
	end)
	Net.Get("TrapUpgraded").OnClientEvent:Connect(function(level, baseIndex)
		TrapVisuals.Burst(level, baseIndex)
	end)
	Players.LocalPlayer:GetAttributeChangedSignal("BaseIndex"):Connect(refreshPrompt)
end

return TrapVisuals
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXA13932D69B9C4ACE971D2378A00413A5"><Properties><string name="Name">Tutorial</string><ProtectedString name="Source">-- First-time tutorial (10 steps) and, afterwards, the "next goal" line. One objective card at the top,
-- a guide beam + marker in the world, and a pulse on the button you need. Progress is saved on the server
-- (DataService.TutorialSteps must match DONE - 1).
--   1 run to the City (speed lane, arch)      6 upgrade your platform (skipped if it can't be paid)
--   2 grab 3 glowing parts                    7 Big Tony: apply your free gear to a car
--   3 run home: the safe zone banks the loot  8 open JOBS (HUD button)
--   4 throw parts at your platform            9 reach a checkpoint
--   5 open your garage                       10 unlock the Highway
-- Every step is a check on the client state, so a player who already did something passes that step at once.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local TrapConfig = require(Shared:WaitForChild("TrapConfig"))
local Util = require(Shared:WaitForChild("Util"))

local Tut = {}
local K, UI, Cine, Guide
local P
local C = Color3.fromRGB
local w = {}
local DONE = 11 -- 10 steps; DataService.TutorialSteps = 10
local localStep -- optimistic step while the server confirms
local skippedLocal = false
local lastSent = 0
local events = { banked = false, checkpoint = false, gearUsed = false }
local stepSince = {} -- step -&gt; os.clock() when it was first shown
local lastGearTotal

local function trapPad(st)
	local map = Workspace:FindFirstChild("GeneratedMap")
	local base = st.baseIndex and map and map:FindFirstChild("Bases") and map.Bases:FindFirstChild(string.format("Base%02d", st.baseIndex), true)
	return base and base:FindFirstChild("TrapPad")
end

-- a named part inside a map model (TonyGarage.TonySpot); cached, falls back to the MapConfig spot
local found = {}
local function mapSpot(model, spot, cfg)
	local hit = found[spot]
	if hit and hit.Parent then
		return hit
	end
	local map = Workspace:FindFirstChild("GeneratedMap")
	local m = map and map:FindFirstChild(model, true)
	hit = m and m:FindFirstChild(spot, true)
	if hit then
		found[spot] = hit
		return hit
	end
	return cfg and Vector3.new(cfg.x, 3, cfg.z) or nil
end

local function nearestDrop(hrp)
	local drops = Workspace:FindFirstChild("RuntimeDrops")
	local best, target = math.huge, nil
	for _, m in ipairs(drops and drops:GetChildren() or {}) do
		local root = m:FindFirstChild("Root")
		if root then
			local d = (root.Position - hrp.Position).Magnitude
			if d &lt; best then
				best, target = d, root
			end
		end
	end
	return target
end

-- the speed lane on the player's side of the plaza, `dz` studs from the arch
local function lanePoint(hrp, dz)
	local lx = MapConfig.PlazaLaneX or 0
	return Vector3.new((hrp and hrp.Position.X &lt; 0) and -lx or lx, 2, MapConfig.EntryZ + dz)
end

local function gearTotal(st)
	local n = 0
	for _, v in pairs(st.gears or {}) do
		n = n + (tonumber(v) or 0)
	end
	return n
end

local function anyCarGeared(st)
	for _, c in ipairs(st.cars or {}) do
		if c.gear then
			return true
		end
	end
	return false
end

local function mixPicked()
	for _, v in pairs(K.state.mix or {}) do
		if (tonumber(v) or 0) &gt; 0 then
			return true
		end
	end
	return false
end

-- platform upgrade: next cost (nil at max) and whether the player can pay it now
local function platformCost(st)
	local cost = TrapConfig.NextCost(st.trapLevel or 1)
	return cost, cost ~= nil and (K.store.Money or 0) &gt;= cost
end

local function since(step)
	return os.clock() - (stepSince[step] or os.clock())
end

-- step definitions: title, body, colour, target(st, hrp), done(st, hrp) -&gt; bool, progress(st) -&gt; 0..1, text,
-- pulse(st) -&gt; toy button (or nil)
local STEPS = {
	{ "RUN TO THE CITY", "Use the speed lane beside your garage, then run through the big arch", nil,
		function(_, hrp) return lanePoint(hrp, 12) end,
		function(_, hrp) return hrp.Position.Z &gt; MapConfig.EntryZ + 6 end },
	{ "GRAB 3 GLOWING PARTS", "One hit by a car and you lose what you carry", nil,
		function(_, hrp) return nearestDrop(hrp) end,
		function() return K.store.CarriedTotal() &gt;= 3 end,
		function() return math.min(K.store.CarriedTotal(), 3) / 3, string.format("%d / 3", math.min(K.store.CarriedTotal(), 3)) end },
	{ "RUN HOME TO BANK THEM", "Back through the arch: the safe zone banks your loot automatically", nil,
		-- a point on the speed lane on the player's side, just inside the arch
		function(_, hrp) return lanePoint(hrp, -30) end,
		function() return events.banked end },
	{ "THROW PARTS AT YOUR PLATFORM", "At your platform open THROW, press ALL, then THROW", nil,
		function(st) return trapPad(st) end,
		function(st) return (st.stats and st.stats.throws or 0) &gt; 0 end, nil,
		function()
			if K.state.open == "throw" then
				return mixPicked() and K.panels.throwGo or K.panels.throwAll
			end
			return K.hud.throw
		end },
	{ "YOUR GARAGE", "Open GARAGE: every parked car earns money every second", nil,
		function() return nil end,
		function() return K.state.open == "garage" end, nil,
		function() return K.hud.garageBtn end },
	{ "UPGRADE YOUR PLATFORM", "Open THROW at your platform and press UPGRADE: more luck for rarer cars", nil,
		function(st) return K.state.open == nil and trapPad(st) or nil end,
		-- also passes when the upgrade can't be paid (after a short look), so a broke player never gets stuck here
		function(st)
			local cost, ok = platformCost(st)
			return (st.trapLevel or 1) &gt;= 2 or cost == nil or (not ok and since(6) &gt; 8)
		end, nil,
		function()
			if K.state.open == "throw" then
				return K.panels.trapUpgradeBtn
			end
			return K.state.open == nil and K.hud.throw or nil
		end },
	{ "VISIT BIG TONY", "Walk up to Big Tony and APPLY your free gear to a car", nil,
		function() return K.state.open == nil and mapSpot("TonyGarage", "TonySpot", MapConfig.Tony) or nil end,
		-- done when a car runs a gear or a gear was used up; no gear and no car to put one on = nothing to do here
		function(st)
			return anyCarGeared(st) or events.gearUsed or #(st.cars or {}) == 0 or (gearTotal(st) == 0 and since(7) &gt; 12)
		end },
	{ "OPEN JOBS", "Tap JOBS to see jobs that pay cash. Claim them in the safe zone.", nil,
		function() return nil end,
		function() return K.state.open == "jobs" end, nil,
		function() return K.state.open == nil and K.hud.jobsBtn or nil end },
	{ "REACH A CHECKPOINT", "Carry parts to the yellow arch at the far end of the City, then SAVE or RISK", nil,
		function() return Vector3.new(0, 2, MapConfig.Zones.city.zMax - 5) end,
		function() return events.checkpoint end },
	{ "UNLOCK THE HIGHWAY", "Open TELEPORT and unlock the Highway: better parts live there", nil,
		function() return nil end,
		function(st) return st.zones and st.zones.highway == true end, nil,
		function() return K.hud.teleportBtn end },
}
assert(#STEPS == DONE - 1, "Tutorial: STEPS / DONE mismatch")

local function build()
	w.goal = K.text(K.root, { Text = "", TextSize = 15, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -4), Size = UDim2.fromOffset(760, 18),
		TextXAlignment = Enum.TextXAlignment.Center, Visible = false, Outline = 2 })
	-- v23: K.card (white face, ink outline, dark tan shadow slab under it); w.card is the holder (position / z / visible /
	-- pop scale), the content goes on the face
	local card, holder = K.card(K.root, { Name = "Objective", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 118), Size = UDim2.fromOffset(600, 108),
		Radius = 20, Stroke = 4, ShadowColor = Color3.fromRGB(150, 138, 112), Visible = false })
	card.ClipsDescendants = true
	w.card = holder
	-- the colour badge follows the card's rounded left corners (ClipsDescendants ignores UICorner, so a square badge
	-- used to stick out of the outline): rounded badge + a square filler on its right half
	w.badge = K.new("Frame", { Size = UDim2.fromOffset(108, 108), BackgroundColor3 = P.yellow, BorderSizePixel = 0 }, card)
	K.corner(w.badge, 20)
	w.badgeFill = K.new("Frame", { Position = UDim2.fromOffset(54, 0), Size = UDim2.fromOffset(54, 108), BackgroundColor3 = P.yellow, BorderSizePixel = 0 }, w.badge)
	w.badgeText = K.text(w.badge, { Text = "1/10", TextSize = 32, ZIndex = 2, Position = UDim2.fromOffset(0, 16), Size = UDim2.new(1, 0, 0, 38), TextXAlignment = Enum.TextXAlignment.Center, Outline = 2.5 })
	w.badgeSub = K.text(w.badge, { Text = "STEP", Font = K.BODY, TextSize = 13, ZIndex = 2, Position = UDim2.fromOffset(0, 56), Size = UDim2.new(1, 0, 0, 16), TextXAlignment = Enum.TextXAlignment.Center })
	-- one dot per step: done = white, current = big, to do = faded (10 dots fit the 88 px row: 6 px + 2 px gaps)
	local dots = K.new("Frame", { Position = UDim2.fromOffset(10, 82), Size = UDim2.new(1, -20, 0, 12), BackgroundTransparency = 1, ZIndex = 2 }, w.badge)
	K.list(dots, Enum.FillDirection.Horizontal, 2, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	w.dots = {}
	for i = 1, DONE - 1 do
		local d = K.new("Frame", { Size = UDim2.fromOffset(6, 6), BackgroundColor3 = P.white, LayoutOrder = i, ZIndex = 3 }, dots)
		K.corner(d, 4)
		w.dots[i] = d
	end
	w.title = K.text(card, { Text = "", TextSize = 26, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(124, 10), Size = UDim2.fromOffset(380, 30) })
	w.body = K.text(card, { Text = "", Font = K.BODY, TextSize = 16, TextColor3 = P.muted, TextWrapped = true, Position = UDim2.fromOffset(124, 42), Size = UDim2.fromOffset(460, 40) })
	local bar = K.inset(card, { Position = UDim2.fromOffset(124, 88), Size = UDim2.fromOffset(300, 8), Radius = 4, Stroke = 1.5, Visible = false })
	w.bar = bar
	w.fill = K.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = P.yellow }, bar)
	K.corner(w.fill, 4)
	w.progText = K.text(card, { Text = "", Font = K.BODY, TextSize = 14, TextColor3 = P.orange, Position = UDim2.fromOffset(434, 82), Size = UDim2.fromOffset(80, 20), Visible = false })
	w.skip = K.toy(card, { Text = "SKIP", Color = P.grey, Size = UDim2.fromOffset(74, 34), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 8), TextSize = 16, Depth = 3,
		Radius = 10, OnClick = function()
			K.confirm("SKIP THE TUTORIAL?", "You can still find every feature on your own.", "SKIP", P.red, Tut.Skip)
		end })
	w.scale = K.new("UIScale", {}, holder)
	w.tick = K.text(w.badge, { Text = "OK!", TextSize = 30, TextColor3 = C(120, 255, 150), Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Visible = false, ZIndex = 5 })
end

local pulses = {}
local function pulse(button)
	for b, sc in pairs(pulses) do
		if b ~= button then
			sc.Scale = 1
		end
	end
	if not button or not button.holder then
		return
	end
	local holder = button.holder
	local sc = pulses[button] or holder:FindFirstChild("TutPulse") or K.new("UIScale", { Name = "TutPulse" }, holder)
	pulses[button] = sc
	sc.Scale = 1 + 0.07 * math.abs(math.sin(os.clock() * 4))
end

local shownKey
local function show(key, badge, sub, color, title, body, prog, progText, canSkip)
	w.card.Visible = true
	w.badge.BackgroundColor3 = color
	w.badgeFill.BackgroundColor3 = color
	w.badgeText.Text = badge
	local lim = w.badgeText:FindFirstChildOfClass("UITextSizeConstraint")
	if lim then
		lim.MaxTextSize = #badge &gt; 3 and 22 or 30
	end
	w.badgeSub.Text = sub
	w.title.Text = title
	w.body.Text = body
	w.bar.Visible = prog ~= nil
	w.progText.Visible = prog ~= nil
	if prog then
		w.fill.Size = UDim2.fromScale(prog, 1)
		w.fill.BackgroundColor3 = color
		w.progText.Text = progText or ""
		w.progText.TextColor3 = color
	end
	w.skip.holder.Visible = canSkip
	if shownKey ~= key then
		shownKey = key
		w.scale.Scale = 0.7
		K.tween(w.scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	end
end

-- the server rate-limits TutorialStep: re-send the optimistic step until the saved state catches up
local function sendStep()
	lastSent = os.clock()
	Net.Get("TutorialStep"):FireServer(skippedLocal and "skip" or localStep)
end

local function tick()
	local st = K.store.State
	local char = Players.LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not st or not hrp then
		return
	end
	if localStep and (st.tutorial or 0) &lt; localStep and os.clock() - lastSent &gt; 1.5 then
		sendStep()
	end
	local step = math.max(st.tutorial or 0, localStep or 0, 1)
	-- a gear left the inventory (applied to a car) while Big Tony's step is up
	local gears = gearTotal(st)
	if step == 7 and lastGearTotal and gears &lt; lastGearTotal then
		events.gearUsed = true
	end
	lastGearTotal = gears
	w.goal.Visible = false
	if step &gt;= DONE then
		Guide.Point(nil)
		pulse(nil)
		local goal = K.hud.nextGoal
		K.hud.tutInPanel = false
		w.card.Visible = false
		-- after the tutorial the goal is one small line at the very bottom, under the THROW button
		w.goal.Visible = goal ~= nil and K.state.open == nil
		if goal then
			w.goal.Text = goal[1] .. "  ·  " .. goal[2]
		end
		return
	end
	local def = STEPS[step]
	-- lost the loot on the way home: point back at the parts
	local lostLoot = step == 3 and K.store.CarriedTotal() == 0 and not events.banked
	if lostLoot then
		def = STEPS[2]
	end
	local color = ({ P.yellow, P.orange, P.green, P.yellow, P.blue, P.cyan or P.blue, P.orange, P.orange, P.red, P.green })[step]
	local body = lostLoot and "You lost your parts - grab 3 more, then run home" or def[2]
	local target = def[4](st, hrp)
	if step == 4 and K.store.BankedTotal() == 0 and K.store.CarriedTotal() == 0 and (st.stats and st.stats.throws or 0) == 0 then
		-- nothing to throw: fetch parts first
		body = "No parts to throw - grab some in the City and run home"
		target = nearestDrop(hrp)
	elseif step == 6 then
		local cost, ok = platformCost(st)
		if cost and ok then
			body = string.format("Open THROW at your platform and press UPGRADE ($%s): more luck for rarer cars", Util.FormatNumber(cost))
		elseif cost then
			body = string.format("The upgrade costs $%s - you'll do it later, moving on...", Util.FormatNumber(cost))
			target = nil
		end
	elseif step == 7 and gears == 0 and not anyCarGeared(st) then
		body = "Big Tony sells GEARS: buy one, then APPLY it to a car"
	end
	local prog, progText
	if def[6] then
		prog, progText = def[6]()
	end
	stepSince[step] = stepSince[step] or os.clock()
	for i, d in ipairs(w.dots) do
		d.BackgroundTransparency = i &lt;= step and 0 or 0.6
		d.Size = UDim2.fromOffset(i == step and 9 or 6, i == step and 9 or 6)
	end
	show("step" .. step .. def[1], step .. "/" .. (DONE - 1), "STEP", color, def[1], body, prog, progText, true)
	-- steps that happen inside a panel (garage, throw, Tony, jobs): the card goes on top of the panel's dim, at the very top
	local inPanel = K.state.open ~= nil
	w.card.ZIndex = inPanel and 30 or 1
	K.hud.tutInPanel = inPanel
	w.card.Position = UDim2.new(0.5, 0, 0, inPanel and 4 or 118)
	Guide.Point(target)
	pulse(def[7] and def[7](st) or nil)
	if def == STEPS[step] and def[5](st, hrp) then
		localStep = step + 1
		events.banked = step &gt;= 3 and events.banked -- step 3 needs a bank after the parts were grabbed
		sendStep()
		UI.Sfx("step")
		if step + 1 == DONE then
			Cine.Title("TUTORIAL COMPLETE!", P.yellow, 1.6, 90, 0.35)
			Cine.Sub("Keep unlocking districts to get better parts", Color3.new(1, 1, 1), 3.2, 0.5)
		else
			-- quiet confirmation: green tick on the card
			w.tickToken = (w.tickToken or 0) + 1
			local token = w.tickToken
			w.tick.Visible = true
			w.tick.TextTransparency = 0
			K.tween(w.tick, 0.9, { TextTransparency = 1 })
			task.delay(0.9, function()
				if w.tickToken == token then -- a newer tick keeps showing
					w.tick.Visible = false
				end
			end)
		end
	end
end

-- skip the whole tutorial (SKIP button, or SKIP on the join question)
function Tut.Skip()
	localStep = DONE
	skippedLocal = true
	sendStep()
end

function Tut.Start(ui, cine, guide)
	UI = ui
	K = UI.Kit()
	P = K.P
	Cine = cine
	Guide = guide
	build()
	Net.Get("BankFx").OnClientEvent:Connect(function()
		events.banked = true
	end)
	Net.Get("CheckpointOffer").OnClientEvent:Connect(function()
		events.checkpoint = true
	end)
	task.spawn(function()
		while true do
			task.wait(0.15)
			pcall(tick)
		end
	end)
end

return Tut
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX55FA511AB587461DB17B2B0F324AE4D7"><Properties><string name="Name">UIExtra</string><ProtectedString name="Source">-- Extra HUD + panels: Pit Stop perks, Golden Magnate donations, combo meter, contracts, hot drop banner, boosts.
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Strings = require(Shared:WaitForChild("Strings"))
local Util = require(Shared:WaitForChild("Util"))
local ShopConfig = require(Shared:WaitForChild("ShopConfig"))
local DonateConfig = require(Shared:WaitForChild("DonateConfig"))
local ProductIds = require(Shared:WaitForChild("ProductIds"))
local IS_STUDIO = game:GetService("RunService"):IsStudio()
local randomRestricted = false
task.spawn(function()
	local ok, info = pcall(function()
		return game:GetService("PolicyService"):GetPolicyInfoForPlayerAsync(game:GetService("Players").LocalPlayer)
	end)
	randomRestricted = ok and info and info.ArePaidRandomItemsRestricted == true or false
end)
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local GearConfig = require(Shared:WaitForChild("GearConfig"))
local Icons = require(Shared:WaitForChild("Icons"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local SkinConfig = require(Shared:WaitForChild("SkinConfig"))
local CollectionService = game:GetService("CollectionService")

local T = Strings.T
local C = Color3.fromRGB
local X = {}
local K, UI
local P
local w = {}
local hot = nil -- current hot drop info
local donateTab = "boost"
local shopTab = "perks"
local TONY = C(72, 96, 156) -- v23: steel blue (the old near-black navy swallowed the panel's ink outline)
local GOLD = C(232, 178, 50)
local TEAL = C(40, 150, 140) -- rebirth teal (no purple in this UI)
local contractText -- defined with the HUD widgets

local function fmtTime(sec)
	sec = math.max(0, math.floor(sec))
	return string.format("%d:%02d", math.floor(sec / 60), sec % 60)
end

---------------------------------------------------------------- Pit Stop
local function buildShop()
	local p = K.panelShell("shop", T("shop_title"), 900, 600, P.red)
	local tabs = K.new("Frame", { Size = UDim2.new(1, 0, 0, 56), BackgroundTransparency = 1, ZIndex = 22 }, p.content)
	K.list(tabs, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center)
	w.shopTabs = {}
	for i, tab in ipairs({ "perks", "garage" }) do
		w.shopTabs[tab] = K.toy(tabs, { Text = T("shop_tab_" .. tab), Color = P.grey, Size = UDim2.fromOffset(200, 52), LayoutOrder = i, ZIndex = 23, TextSize = 20,
			OnClick = function()
				shopTab = tab
				UI.Refresh()
			end })
	end
	local grid = K.new("ScrollingFrame", { Position = UDim2.fromOffset(0, 66), Size = UDim2.new(1, 0, 1, -66), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 8,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 22 }, p.content)
	-- v23: padding so the outlines / shadows of the outer cards never clip; 4 x 198 + 3 x 12 = 828 of the 834 px inside
	K.new("UIGridLayout", { CellSize = UDim2.fromOffset(198, 214), CellPadding = UDim2.fromOffset(12, 12), SortOrder = Enum.SortOrder.LayoutOrder }, grid)
	K.padding(grid, 8, 14)
	w.shopGrid = grid
end

local function refreshSkins(st)
	for _, def in ipairs(SkinConfig.Skins) do
		local owned = (st.skins and st.skins[def.id]) or (def.pass and st.passes and st.passes[def.pass])
		local on = st.skin == def.id
		local card = K.card(w.shopGrid, { Color = def.style.wall:Lerp(Color3.new(1, 1, 1), 0.75), StrokeColor = on and P.green or P.ink, Stroke = on and 5 or 3,
			Radius = 20, LayoutOrder = def.order, ZIndex = 23 })
		-- mini swatch of the skin colours
		local sw = K.new("Frame", { Position = UDim2.new(0.5, 0, 0, 10), AnchorPoint = Vector2.new(0.5, 0), Size = UDim2.fromOffset(150, 40), BackgroundTransparency = 1, ZIndex = 24 }, card)
		K.list(sw, Enum.FillDirection.Horizontal, 4, Enum.HorizontalAlignment.Center)
		for _, k in ipairs({ "wall", "floor", "frame", "accent" }) do
			local c = K.new("Frame", { Size = UDim2.fromOffset(32, 40), BackgroundColor3 = def.style[k], ZIndex = 25 }, sw)
			K.corner(c, 8)
			K.stroke(c, P.ink, 2)
		end
		K.text(card, { Text = def.icon .. " " .. string.upper(def.name), TextSize = 18, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(0, 56), Size = UDim2.new(1, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
		K.text(card, { Text = def.bonus &gt; 0 and T("skin_bonus", math.floor(def.bonus * 100 + 0.5)) or "-", Font = K.BODY, TextSize = 18, TextColor3 = C(30, 158, 64), Position = UDim2.fromOffset(0, 86), Size = UDim2.new(1, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
		local label, color, can
		if on then
			label, color = T("skin_on"), P.green
		elseif owned then
			label, color, can = T("skin_equip"), P.blue, true
		elseif def.pass then
			local it = DonateConfig.ById[def.pass]
			label, color, can = "R$ " .. (it and it.price or "?"), GOLD, true
		elseif def.tokens then
			label, color, can = "🪙 " .. def.tokens, (st.tokens or 0) &gt;= def.tokens and P.orange or P.grey, true
		else
			label, color, can = "$" .. Util.FormatNumber(def.money), K.store.Money &gt;= def.money and P.green or P.grey, true
		end
		K.toy(card, { Text = label, Color = color, Size = UDim2.fromOffset(176, 62), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -6), ZIndex = 25, TextSize = 22,
			OnClick = function()
				if can then
					K.actions.SetSkin(def.id)
				end
			end })
	end
end

local function refreshShop(st, open)
	if open ~= "shop" then
		return
	end
	for tab, b in pairs(w.shopTabs) do
		b.SetColor(tab == shopTab and P.yellow or P.grey)
	end
	K.clear(w.shopGrid)
	if shopTab == "garage" then
		refreshSkins(st)
		return
	end
	for _, def in ipairs(ShopConfig.Perks) do
		local lvl = st.perks and st.perks[def.id] or 0
		local cost = ShopConfig.NextCost(def.id, lvl)
		local card = K.card(w.shopGrid, { Radius = 20, LayoutOrder = def.order, ZIndex = 23 })
		K.text(card, { Text = def.icon, Font = K.BODY, TextSize = 40, Size = UDim2.new(1, 0, 0, 48), Position = UDim2.fromOffset(0, 6), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
		K.text(card, { Text = string.upper(def.name), TextSize = 20, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(0, 54), Size = UDim2.new(1, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
		K.text(card, { Text = def.desc, Font = K.BODY, TextSize = 14, TextColor3 = P.muted, TextWrapped = true, Position = UDim2.fromOffset(8, 78), Size = UDim2.new(1, -16, 0, 36), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
		local pips = K.new("Frame", { Position = UDim2.new(0.5, 0, 0, 118), AnchorPoint = Vector2.new(0.5, 0), Size = UDim2.fromOffset(def.max * 22, 14), BackgroundTransparency = 1, ZIndex = 24 }, card)
		K.list(pips, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center)
		for i = 1, def.max do
			local pip = K.new("Frame", { Size = UDim2.fromOffset(16, 14), BackgroundColor3 = (i &lt;= lvl) and P.green or C(220, 222, 226), ZIndex = 25 }, pips)
			K.corner(pip, 5)
			K.stroke(pip, P.ink, 1.5)
		end
		local can = cost and K.store.Money &gt;= cost
		K.toy(card, { Text = cost and ("$" .. Util.FormatNumber(cost)) or T("shop_max"), Sub = cost and T("shop_buy") or nil,
			Color = cost and (can and P.green or P.grey) or P.yellow, Size = UDim2.fromOffset(176, 62), AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -6), ZIndex = 25, TextSize = 22, SubSize = 13,
			OnClick = function()
				if cost then
					K.actions.BuyPerk(def.id)
				end
			end })
	end
end

---------------------------------------------------------------- Golden Magnate
local function buildDonate()
	local p = K.panelShell("donate", T("donate_title"), 920, 600, GOLD)
	local tabs = K.new("Frame", { Size = UDim2.new(1, 0, 0, 56), BackgroundTransparency = 1, ZIndex = 22 }, p.content)
	K.list(tabs, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center)
	w.donateTabs = {}
	for i, tab in ipairs({ "boost", "pack", "pass" }) do
		w.donateTabs[tab] = K.toy(tabs, { Text = T("donate_" .. tab), Color = P.grey, Size = UDim2.fromOffset(170, 52), LayoutOrder = i, ZIndex = 23, TextSize = 20,
			OnClick = function()
				donateTab = tab
				UI.Refresh()
			end })
	end
	local grid = K.new("ScrollingFrame", { Position = UDim2.fromOffset(0, 66), Size = UDim2.new(1, 0, 1, -66), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 8, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 22 }, p.content)
	-- 4 x 204 + 3 x 12 = 852 of the 854 px inside the padding; +6 px height for the gold strip and the shadow slab
	K.new("UIGridLayout", { CellSize = UDim2.fromOffset(204, 206), CellPadding = UDim2.fromOffset(12, 12), SortOrder = Enum.SortOrder.LayoutOrder }, grid)
	K.padding(grid, 8, 14)
	w.donateGrid = grid
end

local function refreshDonate(st, open)
	if open ~= "donate" then
		return
	end
	for tab, b in pairs(w.donateTabs) do
		b.SetColor(tab == donateTab and GOLD or P.grey)
	end
	K.clear(w.donateGrid)
	local items = donateTab == "pass" and DonateConfig.Passes or DonateConfig.Products
	for _, it in ipairs(items) do
		-- live game: only products that exist on Roblox, and no paid random items where they are not allowed
		if it.tab == donateTab and DonateConfig.Available(it, ProductIds, IS_STUDIO, randomRestricted) then
			local owned = it.isPass and st.passes and st.passes[it.id]
			-- v23: white card + ink outline + shadow (the near-cream fill with a gold rim melted into the panel); gold top strip
			local card = K.card(w.donateGrid, { Accent = GOLD, AccentTop = true, AccentSize = 6, Radius = 20, LayoutOrder = it.order, ZIndex = 23 })
			K.text(card, { Text = it.icon, Font = K.BODY, TextSize = 40, Size = UDim2.new(1, 0, 0, 48), Position = UDim2.fromOffset(0, 6), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
			K.text(card, { Text = string.upper(it.name), TextSize = 19, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(0, 54), Size = UDim2.new(1, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
			local desc = it.desc
			if it.boost and st.boosts and (st.boosts[it.boost] or 0) &gt; 0 then
				desc = desc .. "\nActive: " .. fmtTime(st.boosts[it.boost])
			end
			K.text(card, { Text = desc, Font = K.BODY, TextSize = 14, TextColor3 = P.muted, TextWrapped = true, Position = UDim2.fromOffset(8, 78), Size = UDim2.new(1, -16, 0, 50), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
			K.toy(card, { Text = owned and T("donate_owned") or ("R$ " .. it.price), Color = owned and P.grey or GOLD, Size = UDim2.fromOffset(176, 58),
				AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -6), ZIndex = 25, TextSize = 24,
				OnClick = function()
					if not owned then
						K.actions.Donate(it.id)
					end
				end })
		end
	end
end

---------------------------------------------------------------- Big Tony's Gears: timed boosts, new stock every 5 minutes
local GREEN_TXT, RED_TXT = C(30, 158, 64), C(214, 52, 44)

-- v23: a list row is a white card (ink outline + shadow slab); the state colour is its left band (tan = nothing yet)
local ROW_IDLE = C(214, 204, 180)
local function row(parent, order, h, accent)
	return (K.card(parent, { Size = UDim2.new(1, 0, 0, h), Accent = accent or ROW_IDLE, Radius = 18, LayoutOrder = order, ZIndex = 23 }))
end

-- the state carries seconds-left values as of the push; count down locally from when it arrived
local pushedState, pushClock = nil, os.clock()
local function sincePush()
	local st = K.store.State
	if st ~= pushedState then
		pushedState, pushClock = st, os.clock()
	end
	return os.clock() - pushClock
end

-- server time in the server's own clock (os.time) when the state has it, else the replicated server time
local function serverNow()
	local st = K.store.State
	local el = sincePush()
	if st and tonumber(st.serverTime) then
		return st.serverTime + el
	end
	return Workspace:GetServerTimeNow()
end

-- seconds left on a car's gear right now (0 = none / run out)
local function gearLeft(car)
	local g = car and car.gear
	if type(g) ~= "table" or not GearConfig.ById[g.id] then
		return 0
	end
	if tonumber(g.left) then
		return math.max(0, g.left - sincePush())
	elseif tonumber(g.exp) then
		return math.max(0, g.exp - serverNow())
	end
	return 0
end

local function fmtMult(m)
	if m % 1 == 0 then
		return string.format("x%d", m)
	end
	return (string.format("x%.2f", m):gsub("0+$", ""))
end

-- "x2 4:12" for the garage GEAR button (nil without a running gear)
local function gearTag(car)
	local left = gearLeft(car)
	local def = left &gt; 0 and GearConfig.ById[car.gear.id]
	if not def then
		return nil
	end
	local best = 1
	for _, m in pairs(def.effects) do
		best = math.max(best, m)
	end
	return fmtMult(best) .. " " .. fmtTime(left)
end

local function gearMinutes(def)
	return T("gears_minutes", math.floor(def.seconds / 60 + 0.5))
end

local stockCache = {}
-- this window's stock for the local player minus what they already bought in it
local function shopInfo(st)
	local now = serverNow()
	local window = GearConfig.WindowAt(now)
	if stockCache.window ~= window then
		stockCache.window = window
		stockCache.stock = GearConfig.Stock(game:GetService("Players").LocalPlayer.UserId, window)
	end
	local bought = (st.gearShop and st.gearShop.window == window and st.gearShop.bought) or {}
	local left = {}
	for id, n in pairs(stockCache.stock) do
		left[id] = math.max(0, n - (tonumber(bought[id]) or 0))
	end
	return left, (window + 1) * GearConfig.Window - now
end

local function gearPrice(def, st)
	return GearConfig.Price(def, tonumber(st.peakCarIncome) or 0) -- same formula as the server (GearService.Buy)
end

local function gearIcon(parent, def, size, pos, z)
	local img = Icons.Get("gear_" .. def.id)
	if img then
		return K.new("ImageLabel", { Image = img, BackgroundTransparency = 1, Size = UDim2.fromOffset(size, size), Position = pos, ScaleType = Enum.ScaleType.Fit, ZIndex = z }, parent)
	end
	return K.text(parent, { Text = def.icon, Font = K.BODY, TextSize = math.floor(size * 0.66), Size = UDim2.fromOffset(size, size), Position = pos,
		TextXAlignment = Enum.TextXAlignment.Center, ZIndex = z })
end

local function stars(tier)
	return string.rep("★", tier) .. string.rep("☆", 5 - tier)
end

-- same test as the server (MechanicService.nearTony): 3D distance to TonyGarage.TonySpot &lt;= 24 (MapConfig.Tony fallback)
local tonySpot
local function nearTony()
	local char = game:GetService("Players").LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return false
	end
	if not (tonySpot and tonySpot.Parent) then
		local map = Workspace:FindFirstChild("GeneratedMap")
		local garage = map and map:FindFirstChild("TonyGarage", true)
		local spot = garage and garage:FindFirstChild("TonySpot", true)
		tonySpot = spot and spot:IsA("BasePart") and spot or nil
	end
	local pos
	if tonySpot then
		pos = tonySpot.Position
	elseif MapConfig.Tony then
		pos = Vector3.new(MapConfig.Tony.x, hrp.Position.Y, MapConfig.Tony.z)
	else
		return false
	end
	return (hrp.Position - pos).Magnitude &lt;= 24
end

local openPicker -- (opts) car picker / gear chooser, defined below

local TONY_ROW_H = 122
local function buildTony()
	local p = K.panelShell("tony", T("gears_title"), 920, 600, TONY)
	local head = K.inset(p.content, { Size = UDim2.new(1, 0, 0, 46), ZIndex = 22 })
	w.tonyTimer = K.text(head, { Text = "", TextSize = 22, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(14, 0), Size = UDim2.fromOffset(300, 46), ZIndex = 23 })
	w.tonyHint = K.text(head, { Text = T("gears_hint"), Font = K.BODY, TextSize = 15, TextColor3 = P.muted, TextWrapped = true, AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 0), Size = UDim2.new(1, -334, 1, 0), TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 23 })
	local list = K.scroller(p.content, UDim2.fromOffset(0, 54), UDim2.new(1, 0, 1, -54))
	w.tonyRows = {}
	for i, def in ipairs(GearConfig.List) do
		local fr = row(list, i, TONY_ROW_H, def.color)
		local disc = K.new("Frame", { Position = UDim2.fromOffset(10, 13), Size = UDim2.fromOffset(96, 96), BackgroundColor3 = def.color:Lerp(P.white, 0.7), ZIndex = 24 }, fr)
		K.corner(disc, 48)
		K.stroke(disc, P.ink, 2)
		gearIcon(disc, def, 84, UDim2.fromOffset(6, 6), 25)
		K.text(fr, { Text = string.upper(def.name), TextSize = 24, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(120, 8), Size = UDim2.new(1, -470, 0, 30), ZIndex = 24 })
		K.text(fr, { Text = GearConfig.Label(def) .. "  ·  " .. gearMinutes(def), TextSize = 18, TextColor3 = K.lift(def.color, -0.4), Outline = false, Position = UDim2.fromOffset(120, 40),
			Size = UDim2.new(1, -470, 0, 24), ZIndex = 24 })
		K.text(fr, { Text = T("gears_aura") .. " " .. stars(def.tier), Font = K.BODY, TextSize = 16, TextColor3 = C(196, 140, 20), Position = UDim2.fromOffset(120, 66),
			Size = UDim2.new(1, -470, 0, 20), ZIndex = 24 })
		K.text(fr, { Text = def.desc, Font = K.BODY, TextSize = 14, TextColor3 = P.muted, Position = UDim2.fromOffset(120, 88), Size = UDim2.new(1, -470, 0, 20), ZIndex = 24 })
		local r = { def = def }
		-- right: stock + price above BUY, owned above APPLY
		r.stock = K.text(fr, { Text = "", Font = K.BODY, TextSize = 16, TextColor3 = P.ink, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -176, 0, 6), Size = UDim2.fromOffset(150, 22),
			TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
		r.price = K.text(fr, { Text = "", TextSize = 22, TextColor3 = GREEN_TXT, Outline = false, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -176, 0, 28), Size = UDim2.fromOffset(150, 28),
			TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
		r.buy = K.toy(fr, { Text = T("gears_buy"), Color = P.grey, Size = UDim2.fromOffset(150, 58), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -176, 0, 58), ZIndex = 25, TextSize = 22,
			OnClick = function()
				local st = K.store.State
				if not st then
					return
				end
				local stock = shopInfo(st)
				if ((st.gears or {})[def.id] or 0) &gt;= GearConfig.MaxOwned then
					UI.Toast(T("n_gearMax"), "warn")
				elseif (stock[def.id] or 0) &lt;= 0 then
					UI.Toast(T("gears_soldoutToast"), "warn")
				elseif (K.store.Money or 0) &lt; gearPrice(def, st) then
					UI.Toast(T("gears_noMoney"), "warn")
				else
					K.actions.BuyGear(def.id)
				end
			end })
		r.own = K.text(fr, { Text = "", Font = K.BODY, TextSize = 16, TextColor3 = P.ink, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 6), Size = UDim2.fromOffset(150, 22),
			TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
		r.ownSub = K.text(fr, { Text = def.effects.income and T("gears_oneCar") or T("gears_whileParked"), Font = K.BODY, TextSize = 13, TextColor3 = P.muted, AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12, 0, 30), Size = UDim2.fromOffset(150, 22), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 24 })
		r.apply = K.toy(fr, { Text = T("gears_apply"), Color = P.grey, Size = UDim2.fromOffset(150, 58), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 58), ZIndex = 25, TextSize = 22,
			OnClick = function()
				local st = K.store.State
				if st and ((st.gears or {})[def.id] or 0) &gt; 0 then
					openPicker({ gear = def.id })
				else
					UI.Toast(T("gears_buyFirst"), "warn")
				end
			end })
		w.tonyRows[def.id] = r
	end
end

-- text-only refresh (no rebuild): runs on state pushes, money ticks and every second while the panel is open
local function refreshTony(st, open)
	if open ~= "tony" or not w.tonyRows then
		return
	end
	local stock, restock = shopInfo(st)
	w.tonyTimer.Text = T("gears_restock", fmtTime(restock))
	w.tonyHint.Text = nearTony() and T("gears_hint") or T("gears_far")
	local money = K.store.Money or 0
	for id, r in pairs(w.tonyRows) do
		local n = stock[id] or 0
		local price = gearPrice(r.def, st)
		local own = (st.gears or {})[id] or 0
		r.stock.Text = n &gt; 0 and T("gears_stock", n) or T("gears_soldout")
		r.stock.TextColor3 = n &gt; 0 and P.ink or RED_TXT
		r.price.Text = "$" .. Util.FormatNumber(price)
		r.price.TextColor3 = money &gt;= price and GREEN_TXT or RED_TXT
		r.buy.SetText(n &gt; 0 and T("gears_buy") or T("gears_soldoutBtn"), nil)
		r.buy.SetColor((n &gt; 0 and money &gt;= price and own &lt; GearConfig.MaxOwned) and P.green or P.grey)
		r.own.Text = T("gears_ownMax", own, GearConfig.MaxOwned)
		r.own.TextColor3 = own &gt; 0 and GREEN_TXT or P.muted
		r.apply.SetColor(own &gt; 0 and P.blue or P.grey)
	end
end

---------------------------------------------------------------- gear picker: which car gets a gear / which gear goes on a car
local picker -- { dim, mode, gear, uid, st, labels = { { label, car } }, head }

local function closePicker()
	if picker then
		local dim = picker.dim
		picker = nil
		dim:Destroy()
	end
end

local function findCar(st, uid)
	for _, c in ipairs(st.cars or {}) do
		if c.uid == uid then
			return c
		end
	end
	return nil
end

-- "💨 x1.5 SPEED · 3:12" or "No gear"
local function gearStatus(car)
	local left = gearLeft(car)
	local def = left &gt; 0 and GearConfig.ById[car.gear.id]
	if not def then
		return T("gears_noGear"), P.muted
	end
	return string.format("%s %s  ·  %s", def.icon, GearConfig.Label(def), fmtTime(left)), K.lift(def.color, -0.4)
end

local function applyGear(car, gearId)
	local def = GearConfig.ById[gearId]
	local left = gearLeft(car)
	local cur = left &gt; 0 and GearConfig.ById[car.gear.id]
	local function go()
		K.actions.ApplyGear(car.uid, gearId)
		UI.Sfx("cash")
		closePicker()
	end
	if cur then
		-- the confirm sits above the picker; KEEP leaves the picker open
		K.confirm(T("gears_replaceTitle"), T("gears_replaceBody", cur.name, fmtTime(left), def.name), T("gears_replaceOk"), P.orange, go)
	else
		go()
	end
end

local PICK_ROW_H = 84
local MAX_PICK_CARS = 60
local function fillPicker()
	local st = K.store.State
	if not picker or not st then
		return
	end
	picker.st = st
	picker.labels = {}
	K.clear(picker.list)
	if picker.mode == "gear" then
		-- every car you own, parked first (speed / luck gears only work while the car is parked)
		local cars = table.clone(st.cars or {})
		local now = serverNow()
		table.sort(cars, function(a, b)
			if (a.slot ~= nil) ~= (b.slot ~= nil) then
				return a.slot ~= nil
			end
			local ia, ib = CarConfig.CarIncome(a, now), CarConfig.CarIncome(b, now)
			if ia ~= ib then
				return ia &gt; ib
			end
			return a.uid &lt; b.uid
		end)
		if #cars == 0 then
			K.text(picker.list, { Text = T("garage_empty"), Font = K.BODY, TextSize = 18, TextColor3 = P.muted, Size = UDim2.new(1, 0, 0, 40), ZIndex = 74, TextXAlignment = Enum.TextXAlignment.Center })
		end
		for i, car in ipairs(cars) do
			if i &gt; MAX_PICK_CARS then
				break
			end
			local def = CarConfig.ById[car.typeId]
			if def then
				local rc = CarConfig.Rarities[def.rarity].color
				local fr = K.card(picker.list, { Size = UDim2.new(1, 0, 0, PICK_ROW_H), Accent = rc, Radius = 16, LayoutOrder = i, ZIndex = 73 })
				K.text(fr, { Text = def.name, TextSize = 20, TextColor3 = P.ink, Outline = false, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(14, 6), Size = UDim2.new(1, -200, 0, 26), ZIndex = 75 })
				K.text(fr, { Text = string.format("%s · Lv %d · +%s/s", car.slot and ("Bay " .. car.slot) or "Storage", car.level or 1, Util.FormatNumber(CarConfig.CarIncome(car, now))), Font = K.BODY,
					TextSize = 14, TextColor3 = P.muted, Position = UDim2.fromOffset(14, 32), Size = UDim2.new(1, -200, 0, 20), ZIndex = 75 })
				local status = K.text(fr, { Text = "", Font = K.BODY, TextSize = 15, TextColor3 = P.muted, Position = UDim2.fromOffset(14, 54), Size = UDim2.new(1, -200, 0, 20), ZIndex = 75 })
				table.insert(picker.labels, { label = status, car = car })
				local active = gearLeft(car) &gt; 0
				K.toy(fr, { Text = active and T("gears_replace") or T("gears_apply"), Sub = (not car.slot) and T("gears_storage") or nil, SubSize = 11, Color = active and P.orange or P.green,
					Size = UDim2.fromOffset(150, 62), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), ZIndex = 76, TextSize = 20,
					OnClick = function()
						if picker and picker.gear then
							applyGear(car, picker.gear)
						end
					end })
			end
		end
	else
		-- one car: the gears you own
		local car = findCar(st, picker.uid)
		if not car then
			closePicker()
			return
		end
		local any = false
		for i, def in ipairs(GearConfig.List) do
			local own = (st.gears or {})[def.id] or 0
			if own &gt; 0 then
				any = true
				local fr = K.card(picker.list, { Size = UDim2.new(1, 0, 0, PICK_ROW_H), Accent = def.color, Radius = 16, LayoutOrder = i, ZIndex = 73 })
				gearIcon(fr, def, 64, UDim2.fromOffset(10, 10), 75)
				K.text(fr, { Text = string.upper(def.name) .. "  x" .. own, TextSize = 20, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(84, 10), Size = UDim2.new(1, -250, 0, 26), ZIndex = 75 })
				K.text(fr, { Text = GearConfig.Label(def) .. "  ·  " .. gearMinutes(def), Font = K.BODY, TextSize = 15, TextColor3 = K.lift(def.color, -0.4), Position = UDim2.fromOffset(84, 40),
					Size = UDim2.new(1, -250, 0, 22), ZIndex = 75 })
				K.toy(fr, { Text = T("gears_apply"), Color = P.green, Size = UDim2.fromOffset(150, 62), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), ZIndex = 76, TextSize = 20,
					OnClick = function()
						applyGear(car, def.id)
					end })
			end
		end
		if not any then
			K.text(picker.list, { Text = T("gears_noneOwned"), Font = K.BODY, TextSize = 19, TextColor3 = P.muted, TextWrapped = true, Size = UDim2.new(1, 0, 0, 56), LayoutOrder = 1, ZIndex = 74,
				TextXAlignment = Enum.TextXAlignment.Center })
			local holder = K.new("Frame", { Size = UDim2.new(1, 0, 0, 70), BackgroundTransparency = 1, LayoutOrder = 2, ZIndex = 74 }, picker.list)
			K.toy(holder, { Text = T("gears_goTony"), Color = TONY, Size = UDim2.fromOffset(280, 64), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), ZIndex = 75, TextSize = 22,
				OnClick = function()
					closePicker()
					if K.state.open ~= "tony" then
						UI.TogglePanel("tony")
					end
				end })
		end
	end
end

-- countdowns in the picker (no rebuild)
local function tickPicker()
	if not picker then
		return
	end
	local st = K.store.State
	if picker.mode == "car" then
		local car = st and findCar(st, picker.uid)
		if car then
			local txt, col = gearStatus(car)
			picker.head.Text = T("gears_now") .. " " .. txt
			picker.head.TextColor3 = col
		end
	end
	for _, e in ipairs(picker.labels) do
		local txt, col = gearStatus(e.car)
		e.label.Text = txt
		e.label.TextColor3 = col
	end
end

-- opts: { gear = id } -&gt; pick a car for that gear; { uid = carUid } -&gt; pick a gear for that car
openPicker = function(opts)
	closePicker()
	local st = K.store.State
	if not st or K.state.cine then
		return
	end
	local title, color, sub
	if opts.gear then
		local def = GearConfig.ById[opts.gear]
		if not def then
			return
		end
		title, color = T("gears_pickCar", string.upper(def.name)), def.color
		sub = GearConfig.Label(def) .. "  ·  " .. gearMinutes(def) .. "  ·  " .. (def.effects.income and T("gears_oneCar") or T("gears_whileParked"))
	else
		local car = findCar(st, opts.uid)
		local cdef = car and CarConfig.ById[car.typeId]
		if not cdef then
			return
		end
		title, color, sub = T("gears_pickGear", string.upper(cdef.name)), TONY, ""
	end
	local dim = K.new("TextButton", { Name = "GearPicker", Text = "", AutoButtonColor = false, Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(0, 0, 0), BackgroundTransparency = 0.45, ZIndex = 70 },
		K.overlay)
	local box, shell = K.dialogShell(dim, { Class = "TextButton", Size = UDim2.fromOffset(660, 520), ZIndex = 71, Color = color, HeadH = 60, Title = title, TitleSize = 28 })
	local sc = K.new("UIScale", { Scale = 0.6 }, shell)
	K.tween(sc, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	K.toy(box, { Text = "X", Color = P.red, Size = UDim2.fromOffset(56, 60), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 12, 0, -16), ZIndex = 76, OnClick = closePicker })
	local head = K.text(box, { Text = sub, Font = K.BODY, TextSize = 17, TextColor3 = P.ink, Position = UDim2.fromOffset(24, 68), Size = UDim2.new(1, -48, 0, 26), ZIndex = 73,
		TextXAlignment = Enum.TextXAlignment.Center })
	local list = K.scroller(box, UDim2.fromOffset(16, 100), UDim2.new(1, -32, 1, -112))
	list.ZIndex = 72
	dim.Activated:Connect(closePicker)
	picker = { dim = dim, mode = opts.gear and "gear" or "car", gear = opts.gear, uid = opts.uid, head = head, list = list, labels = {}, panel = K.state.open }
	UI.SetDialog(true)
	dim.Destroying:Connect(function()
		UI.SetDialog(false)
		if picker and picker.dim == dim then
			picker = nil
		end
	end)
	fillPicker()
	tickPicker()
end

local function refreshPicker(st, open)
	if not picker then
		return
	end
	if open ~= picker.panel or K.state.cine then
		closePicker() -- the panel it came from closed (or another one opened)
	elseif st ~= picker.st then
		fillPicker() -- new state: owned gears / cars changed
		tickPicker()
	end
end

---------------------------------------------------------------- Jobs: active contracts, claimed anywhere in the safe zone
local JOBS = C(170, 120, 70)

-- "+$1,200   ⚙️ Engine x2" (sep: optional separator before the part)
local function rewardText(c, st, sep)
	local rw = c.reward
	if type(rw) ~= "table" then
		return ""
	end
	local mult = (st.passes and st.passes.double_contracts == true) and 2 or 1
	local def = PartConfig.Parts[rw.part]
	local part = def and string.format("%s%s %s x%d", sep or "   ", def.emoji, def.name, (rw.n or 1) * mult) or ""
	return "+$" .. Util.FormatNumber((rw.money or 0) * mult) .. part
end

local function anyReady(st)
	for _, c in ipairs(st.contracts or {}) do
		if c.ready then
			return true
		end
	end
	return false
end

local function buildJobs()
	local p = K.panelShell("jobs", T("jobs_title"), 880, 580, JOBS)
	w.jobsHint = K.text(p.content, { Text = T("jobs_hint"), Font = K.BODY, TextSize = 16, TextColor3 = P.muted, Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, -230, 0, 58),
		TextWrapped = true, ZIndex = 23 })
	w.jobsAll = K.toy(p.content, { Text = T("jobs_claimAll"), Color = P.green, Size = UDim2.fromOffset(210, 58), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0),
		ZIndex = 24, TextSize = 22, OnClick = function()
			if K.store.State and anyReady(K.store.State) then
				K.actions.Claim("all")
			end
		end })
	w.jobsList = K.scroller(p.content, UDim2.fromOffset(0, 70), UDim2.new(1, 0, 1, -70))
end

local JOB_ROW_H = 104
local function inSafeZone()
	local char = game:GetService("Players").LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	return hrp ~= nil and MapConfig.ZoneAt(hrp.Position.Z) == "plaza"
end

local function refreshJobs(st, open)
	if open ~= "jobs" then
		return
	end
	local here = inSafeZone() -- claiming only works in the safe zone: outside, the buttons say where to go
	w.jobsAll.holder.Visible = anyReady(st) and here
	K.clear(w.jobsList)
	local list = st.contracts or {}
	if #list == 0 then
		K.text(w.jobsList, { Text = T("jobs_none"), Font = K.BODY, TextSize = 18, TextColor3 = P.muted, Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 0, ZIndex = 23,
			TextXAlignment = Enum.TextXAlignment.Center })
	end
	for i, c in ipairs(list) do
		local n = math.max(math.floor(tonumber(c.n) or 1), 1)
		local prog = math.clamp(math.floor(tonumber(c.progress) or 0), 0, n)
		local r = row(w.jobsList, i, JOB_ROW_H, c.ready and P.green or nil)
		K.text(r, { Text = contractText(c), TextSize = 20, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(18, 10), Size = UDim2.new(1, -250, 0, 28), ZIndex = 24 })
		local bar = K.inset(r, { Position = UDim2.fromOffset(18, 48), Size = UDim2.new(1, -330, 0, 14), Radius = 7, ZIndex = 24 })
		local fill = K.new("Frame", { Size = UDim2.fromScale(c.ready and 1 or prog / n, 1), BackgroundColor3 = c.ready and P.yellow or C(70, 200, 100), BorderSizePixel = 0, ZIndex = 25 }, bar)
		K.corner(fill, 7)
		K.text(r, { Text = c.ready and "✅" or string.format("%d / %d", prog, n), Font = K.BODY, TextSize = 16, TextColor3 = P.ink, Position = UDim2.new(1, -306, 0, 42),
			Size = UDim2.fromOffset(60, 26), ZIndex = 24, TextXAlignment = Enum.TextXAlignment.Center })
		K.text(r, { Text = T("jobs_reward") .. "  " .. rewardText(c, st), Font = K.BODY, TextSize = 17, TextColor3 = GREEN_TXT, Position = UDim2.fromOffset(18, 72),
			Size = UDim2.new(1, -250, 0, 24), ZIndex = 24 })
		local canClaim = c.ready and here
		K.toy(r, { Text = canClaim and T("jobs_claim") or (c.ready and T("jobs_goSafe") or T("jobs_working")), Color = canClaim and P.green or P.grey,
			Size = UDim2.fromOffset(200, 60), AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0), ZIndex = 25, TextSize = canClaim and 24 or 16, OnClick = function()
				if c.ready and inSafeZone() then
					K.actions.Claim(c.id)
				end
			end })
	end
end

---------------------------------------------------------------- Welcome back (offline earnings)
local function showOffline(info)
	local dim = K.new("TextButton", { Name = "WelcomeBack", Text = "", AutoButtonColor = false, Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(0, 0, 0), BackgroundTransparency = 0.45, ZIndex = 80 }, K.overlay)
	-- v23: shared dialog shell (shadow + green header strip); the amount sits on a white card
	local card, shell = K.dialogShell(dim, { Size = UDim2.fromOffset(520, 340), Radius = 28, ZIndex = 81, Color = P.green, HeadH = 64, Title = "WELCOME BACK!", TitleSize = 38 })
	local sc = K.new("UIScale", { Scale = 0.5 }, shell)
	K.tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	local h = math.floor(info.seconds / 3600)
	local m = math.floor(info.seconds % 3600 / 60)
	K.text(card, { Text = string.format("Your garage worked for %dh %02dm while you were away%s", h, m, info.capped and " (max 8h)" or ""), Font = K.BODY, TextSize = 17, TextColor3 = P.muted,
		TextWrapped = true, Position = UDim2.fromOffset(30, 72), Size = UDim2.new(1, -60, 0, 44), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 83 })
	local amount = K.card(card, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 122), Size = UDim2.fromOffset(400, 76), Radius = 18, ZIndex = 83 })
	K.new("ImageLabel", { Position = UDim2.fromOffset(40, 6), Size = UDim2.fromOffset(64, 64), BackgroundTransparency = 1, Image = require(game:GetService("ReplicatedStorage").Shared.Icons).Get("coin") or "", ZIndex = 85 }, amount)
	K.text(amount, { Text = "+$" .. Util.FormatNumber(info.amount), TextSize = 48, TextColor3 = C(70, 220, 100), Position = UDim2.fromOffset(114, 10), Size = UDim2.fromOffset(270, 56), ZIndex = 85, Outline = 3 })
	local function closeCard()
		dim:Destroy()
	end
	local btns = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -20), Size = UDim2.fromOffset(470, 76), BackgroundTransparency = 1, ZIndex = 83 }, card)
	K.list(btns, Enum.FillDirection.Horizontal, 16, Enum.HorizontalAlignment.Center)
	K.toy(btns, { Text = "COLLECT", Color = P.green, Size = UDim2.fromOffset(210, 72), TextSize = 26, LayoutOrder = 1, ZIndex = 83, OnClick = closeCard })
	local x2 = DonateConfig.ById.offline_x2
	if x2 and DonateConfig.Available(x2, ProductIds, IS_STUDIO, randomRestricted) then
		K.toy(btns, { Text = "x2", Sub = "R$ " .. x2.price, Color = GOLD, Size = UDim2.fromOffset(150, 72), TextSize = 28, SubSize = 14, LayoutOrder = 2, ZIndex = 83,
			OnClick = function()
				K.actions.Donate("offline_x2")
				closeCard()
			end })
	end
	UI.Sfx("cash")
end

---------------------------------------------------------------- Rebirth + token shop
local function buildRebirth()
	local p = K.panelShell("rebirth", T("rebirth_title"), 860, 600, TEAL)
	-- v23: the conditions sit on their own white card instead of straight on the cream
	local info = K.card(p.content, { Size = UDim2.new(1, 0, 0, 146), Accent = TEAL, Radius = 18, ZIndex = 22 })
	w.rbInfo = K.text(info, { Text = "", Font = K.BODY, TextSize = 19, TextColor3 = P.ink, RichText = true, TextWrapped = true, Position = UDim2.fromOffset(16, 10),
		Size = UDim2.new(1, -32, 1, -20), TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 24 })
	w.rbGo = K.toy(p.content, { Text = T("rebirth_go"), Color = P.grey, Size = UDim2.fromOffset(300, 70), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 158),
		ZIndex = 24, TextSize = 28, OnClick = function()
			if w.rbArmed and os.clock() - w.rbArmed &lt; 3 then
				w.rbArmed = nil
				K.actions.Rebirth()
				UI.TogglePanel(nil)
			else
				w.rbArmed = os.clock()
				UI.Refresh()
				task.delay(3.05, UI.Refresh) -- back from "SURE?" when the 3 s run out
			end
		end })
	w.rbTokens = K.text(p.content, { Text = "", TextSize = 22, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(0, 240), Size = UDim2.new(1, 0, 0, 28), ZIndex = 23 })
	w.rbShop = K.new("Frame", { Position = UDim2.fromOffset(0, 276), Size = UDim2.new(1, 0, 0, 200), BackgroundTransparency = 1, ZIndex = 23 }, p.content)
	K.new("UIGridLayout", { CellSize = UDim2.fromOffset(256, 190), CellPadding = UDim2.fromOffset(12, 12), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center }, w.rbShop)
	-- v25: opened from the REBIRTH button in the HUD row (buildHud), no longer from the garage
end

local function refreshRebirth(st, open)
	if open ~= "rebirth" then
		return
	end
	local n = st.rebirths or 0
	local zone, money = SkinConfig.RebirthNeeds(n)
	local zoneOk = st.zones and st.zones[zone]
	local ok = zoneOk and K.store.Money &gt;= money
	local mult = 1 + SkinConfig.Rebirth.incomePer * (n + 1)
	local function mark(b)
		return b and '&lt;font color="#1E9E40"&gt;✔&lt;/font&gt;' or '&lt;font color="#D6342C"&gt;✘&lt;/font&gt;'
	end
	w.rbInfo.Text = string.format("%s %s\n%s\n%s\n%s", mark(ok), T("rebirth_need", T("zone_" .. zone), Util.FormatNumber(money)),
		'&lt;font color="#D6342C"&gt;' .. T("rebirth_lose") .. "&lt;/font&gt;", '&lt;font color="#1E9E40"&gt;' .. T("rebirth_keep") .. "&lt;/font&gt;", T("rebirth_gain", string.format("%.2f", mult)))
	local armed = w.rbArmed and os.clock() - w.rbArmed &lt; 3
	w.rbGo.SetText(armed and T("btn_sure") or T("rebirth_go"), nil)
	w.rbGo.SetColor(ok and (armed and P.red or TEAL) or P.grey)
	w.rbTokens.Text = "🪙 " .. T("rebirth_tokens", st.tokens or 0) .. "   ·   " .. T("rebirth_shop")
	K.clear(w.rbShop)
	for i, def in ipairs(SkinConfig.TokenPerks) do
		local lvl = st.tokenPerks and st.tokenPerks[def.id] or 0
		local card = K.card(w.rbShop, { Radius = 18, LayoutOrder = i, ZIndex = 24 })
		K.text(card, { Text = def.icon, Font = K.BODY, TextSize = 36, Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 6), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 25 })
		K.text(card, { Text = string.upper(def.name), TextSize = 17, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(6, 54), Size = UDim2.new(1, -12, 0, 40), TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 25 })
		K.text(card, { Text = string.format("%d / %d", lvl, def.max), Font = K.BODY, TextSize = 15, TextColor3 = P.muted, Position = UDim2.fromOffset(0, 96), Size = UDim2.new(1, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 25 })
		local maxed = lvl &gt;= def.max
		K.toy(card, { Text = maxed and T("shop_max") or ("🪙 " .. def.cost), Color = maxed and P.yellow or ((st.tokens or 0) &gt;= def.cost and P.orange or P.grey), Size = UDim2.fromOffset(170, 56),
			AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -6), ZIndex = 26, TextSize = 20, OnClick = function()
				if not maxed then
					K.actions.TokenPerk(def.id)
				end
			end })
	end
end

---------------------------------------------------------------- Tony's GEARS board: this player's stock, prices and the restock timer
local function refreshGearBoard(st)
	local stock, restock = shopInfo(st)
	for _, board in ipairs(CollectionService:GetTagged("GearBoard")) do
		local gui = board:FindFirstChild("BoardGui")
		if not gui then
			gui = K.new("SurfaceGui", { Name = "BoardGui", Face = Enum.NormalId.Front, SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud, PixelsPerStud = 40, LightInfluence = 0.1 }, board)
			K.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(36, 44, 70), BorderSizePixel = 0 }, gui)
			local head = K.new("Frame", { Size = UDim2.new(1, 0, 0, 68), BackgroundColor3 = C(22, 26, 42), BorderSizePixel = 0, ZIndex = 2 }, gui)
			K.text(head, { Text = T("gears_board"), TextSize = 56, TextColor3 = C(255, 205, 60), Outline = 3, Position = UDim2.fromOffset(18, 4), Size = UDim2.new(0.4, 0, 1, -8), ZIndex = 3 })
			K.text(head, { Name = "Timer", Text = "", TextSize = 30, TextColor3 = P.white, Outline = 2.5, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -18, 0, 10),
				Size = UDim2.new(0.58, 0, 1, -20), TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 3 })
		end
		local timer = gui:FindFirstChild("Timer", true)
		if timer then
			timer.Text = T("gears_restock", fmtTime(restock))
		end
	end
	for _, slot in ipairs(CollectionService:GetTagged("GearSlot")) do
		local def = GearConfig.List[slot:GetAttribute("Index") or 0]
		if def then
			local gui = slot:FindFirstChild("SlotGui")
			if not gui then
				gui = K.new("SurfaceGui", { Name = "SlotGui", Face = Enum.NormalId.Front, SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud, PixelsPerStud = 50, LightInfluence = 0.1 }, slot)
				local bg = K.new("Frame", { Name = "Bg", Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(255, 248, 228), BorderSizePixel = 0 }, gui)
				K.new("Frame", { Size = UDim2.new(1, 0, 0, 10), BackgroundColor3 = def.color, BorderSizePixel = 0, ZIndex = 2 }, bg)
				gearIcon(bg, def, 84, UDim2.fromOffset(8, 16), 2)
				K.text(bg, { Text = string.upper(def.name), TextSize = 22, TextColor3 = P.ink, Outline = false, Position = UDim2.fromOffset(98, 16), Size = UDim2.new(1, -104, 0, 26), ZIndex = 2 })
				K.text(bg, { Text = GearConfig.Label(def), TextSize = 17, TextColor3 = K.lift(def.color, -0.45), Outline = false, Position = UDim2.fromOffset(98, 44), Size = UDim2.new(1, -104, 0, 22), ZIndex = 2 })
				K.text(bg, { Name = "Stock", Text = "", Font = K.BODY, TextSize = 18, TextColor3 = P.ink, Position = UDim2.fromOffset(98, 70), Size = UDim2.new(1, -104, 0, 24), ZIndex = 2 })
				K.text(bg, { Name = "Price", Text = "", TextSize = 32, TextColor3 = GREEN_TXT, Outline = false, Position = UDim2.fromOffset(8, 104), Size = UDim2.new(1, -16, 0, 38),
					TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 2 })
			end
			local n = stock[def.id] or 0
			local price = gearPrice(def, st)
			local bg = gui.Bg
			bg.Stock.Text = n &gt; 0 and T("gears_stock", n) or T("gears_soldout")
			bg.Stock.TextColor3 = n &gt; 0 and P.ink or RED_TXT
			bg.Price.Text = "$" .. Util.FormatNumber(price)
			bg.Price.TextColor3 = (K.store.Money or 0) &gt;= price and GREEN_TXT or RED_TXT
			bg.BackgroundColor3 = n &gt; 0 and C(255, 248, 228) or C(214, 210, 202)
		end
	end
end

---------------------------------------------------------------- HUD widgets
local function buildHud()
	local root = K.root
	local colF = K.hud.leftCol
	-- SHOP, JOBS, REBIRTH (+ GIFTS 3, SETTINGS 4 added by their modules): square toy buttons with the 3D icons,
	-- label underneath; 5 x 66 + 4 x 12 = 378 px
	local brow = K.new("Frame", { Name = "Buttons", Size = UDim2.fromOffset(378, 94), BackgroundTransparency = 1, LayoutOrder = 2 }, colF)
	K.list(brow, Enum.FillDirection.Horizontal, 12)
	local function iconButton(name, label, color, order, onClick)
		-- bigger 3D sticker (54 px) and a clear gap to the label below the button
		local holder = K.new("Frame", { Size = UDim2.fromOffset(66, 94), BackgroundTransparency = 1, LayoutOrder = order }, brow)
		local b = K.toy(holder, { Name = label .. "Btn", Text = "", Color = color, Size = UDim2.fromOffset(66, 66), OnClick = onClick })
		K.hud.icon(b.face, name, 54, UDim2.fromOffset(6, 3)).ZIndex = b.face.ZIndex + 1
		local l = K.text(holder, { Text = label, TextSize = 15, Position = UDim2.fromOffset(0, 72), Size = UDim2.new(1, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Center, Outline = 2.5 })
		return b, l
	end
	w.shopBtn = iconButton("shop", T("btn_magnate"), GOLD, 1, function()
		UI.TogglePanel("donate")
	end)
	local jobsBtn = iconButton("jobs", T("btn_jobs"), C(170, 120, 70), 2, function()
		UI.TogglePanel("jobs")
	end)
	K.hud.jobsBtn = jobsBtn -- (the tutorial pulses it)
	-- red dot while a finished job waits to be claimed
	w.jobsDot = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(60, 4), Size = UDim2.fromOffset(18, 18), BackgroundColor3 = P.red, ZIndex = 30,
		Visible = false }, jobsBtn.holder.Parent)
	K.corner(w.jobsDot, 9)
	K.stroke(w.jobsDot, P.white, 2)
	-- v25: REBIRTH has its own button next to SETTINGS (it used to hide in the garage panel)
	local _, rbLabel = iconButton("rebirth", T("btn_rebirth"), TEAL, 5, function()
		UI.TogglePanel("rebirth")
	end)
	rbLabel.Position = UDim2.fromOffset(-6, 72) -- the 7-letter word gets the same overhang as SETTINGS
	rbLabel.Size = UDim2.new(1, 12, 0, 20)
	-- active boosts strip to the right of the wallet card (clear of the 378 px button row)
	w.boosts = K.new("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 400, 1, -24 - (K.hud.leftLift or 0)), Size = UDim2.fromOffset(560, 40), BackgroundTransparency = 1 }, root)
	K.list(w.boosts, Enum.FillDirection.Horizontal, 6)
	-- combo: one compact text line above THROW ("COMBO x1.5" + small speed-bonus timer), no card
	local combo = K.new("Frame", { Name = "Combo", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -138), Size = UDim2.fromOffset(360, 30), BackgroundTransparency = 1, Visible = false }, root)
	K.list(combo, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	w.combo = combo
	w.comboText = K.text(combo, { Text = "", TextSize = 24, TextColor3 = P.yellow, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 28), LayoutOrder = 1, Outline = 2.5 })
	w.comboSub = K.text(combo, { Text = "", Font = K.BODY, TextSize = 15, TextColor3 = P.white, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 20), LayoutOrder = 2 })
	K.new("UIStroke", { Color = P.ink, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual }, w.comboSub)
	w.comboScale = K.new("UIScale", {}, combo)
	-- contracts: plain outlined lines with a thin progress line (no card)
	local cw = K.new("Frame", { Name = "Contracts", Size = UDim2.fromOffset(280, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 1 }, colF)
	K.list(cw, Enum.FillDirection.Vertical, 7)
	w.contracts = cw
	w.contractRows = {}
	-- the active jobs are always on screen; rewards are claimed anywhere in the safe zone (JOBS button)
	K.text(cw, { Text = T("jobs_hud"), TextSize = 16, TextColor3 = P.orange, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 0, Outline = 2.5 })
	-- hot drop banner
	-- top-right corner, same row as the zone banner: the very top, never under notifications or the objective card
	local hb = K.new("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 12), Size = UDim2.fromOffset(380, 42),
		BackgroundColor3 = P.red, Visible = false }, root)
	K.corner(hb, 14)
	K.stroke(hb, P.ink, 3)
	w.hot = hb
	w.hotText = K.text(hb, { Text = "", TextSize = 20, Size = UDim2.new(1, -12, 1, 0), Position = UDim2.fromOffset(6, 0), TextXAlignment = Enum.TextXAlignment.Center })
end

local CONTRACT_PART = function(c)
	return PartConfig.Parts[c.part] and (K.PART_ICON[c.part] .. " " .. T("part_" .. c.part)) or ""
end

contractText = function(c)
	if c.kind == "bank_rarity" then
		return T("c_bank_rarity", c.n, T("rarity_" .. tostring(c.rarity)))
	elseif c.kind == "catch_rarity" then
		return T("c_catch_rarity", T("rarity_" .. tostring(c.rarity)))
	elseif c.kind == "bank_part" then
		return T("c_bank_part", c.n, CONTRACT_PART(c), T("zone_" .. tostring(c.zone)))
	elseif c.kind == "combo" then
		return T("c_combo", tostring(c.mult))
	elseif c.kind == "speed" then
		return T("c_speed", c.seconds or 40)
	elseif c.kind == "throw" then
		return T("c_throw", c.n)
	elseif c.kind == "road" then
		return T("c_road", c.n)
	end
	return T("c_hotdrop")
end

-- player-wide gear effect: time left = the longest running parked car giving it, colour of the strongest gear
local function gearKind(st, kind)
	local left, col, best = 0, nil, 0
	for _, c in ipairs(st.cars or {}) do
		local g = c.slot and c.gear
		local def = g and GearConfig.ById[g.id]
		local m = def and def.effects[kind]
		if m then
			local l = gearLeft(c)
			if l &gt; 0 then
				left = math.max(left, l)
				if m &gt; best then
					best, col = m, def.color
				end
			end
		end
	end
	return left, col
end

-- the HUD pills are made once per kind (in display order) and only change text / colour / visibility
local PILL_ORDER = { "boost_income", "boost_luck", "gear_speed", "gear_luck", "vip" }
local function pillFor(key)
	w.pills = w.pills or {}
	local p = w.pills[key]
	if not p or not p.frame.Parent then
		local order = table.find(PILL_ORDER, key) or 0
		local frame, label = K.pill(w.boosts, "", GOLD, { H = 34, TextSize = 18, LayoutOrder = order })
		p = { frame = frame, label = label }
		w.pills[key] = p
	end
	return p
end
local function setPill(key, txt, color)
	local p = pillFor(key)
	if txt then
		p.label.Text = txt
		p.frame.BackgroundColor3 = color
	end
	p.frame.Visible = txt ~= nil
end

local function refreshPills(st)
	for _, b in ipairs({ { "income", "2X CASH" }, { "luck", "LUCK" } }) do
		local left = st.boosts and st.boosts[b[1]] or 0
		setPill("boost_" .. b[1], left &gt; 0 and (b[2] .. " " .. fmtTime(left)) or nil, GOLD)
	end
	-- gears: SPEED x2 4:12, LUCK x1.5 9:40
	for _, kind in ipairs({ "speed", "luck" }) do
		local m = st.gearMults and tonumber(st.gearMults[kind]) or 1
		local txt, col
		if m &gt; 1 then
			local left, c = gearKind(st, kind)
			if left &gt; 0 then
				txt, col = string.upper(kind) .. " " .. fmtMult(m) .. " " .. fmtTime(left), c and K.lift(c, -0.15) or P.blue
			end
		end
		setPill("gear_" .. kind, txt, col)
	end
	setPill("vip", (st.passes and st.passes.vip) and "VIP" or nil, GOLD)
end

local function refreshHud(st)
	-- boosts + gear effects
	refreshPills(st)
	-- contracts
	for _, r in ipairs(w.contractRows) do
		r:Destroy()
	end
	w.contractRows = {}
	for i, c in ipairs(st.contracts or {}) do
		local row = K.new("Frame", { Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, LayoutOrder = i }, w.contracts)
		local line = c.ready and T("jobs_ready") or string.format("%d/%d   %s", c.progress, c.n, contractText(c))
		local lbl = K.text(row, { Text = line, Font = K.BODY, TextSize = 14, TextColor3 = c.ready and P.yellow or P.white, TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.new(1, 0, 0, 18) })
		K.new("UIStroke", { Color = P.ink, Thickness = 2.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual }, lbl)
		local bar = K.new("Frame", { Position = UDim2.fromOffset(0, 21), Size = UDim2.fromOffset(250, 2), BackgroundColor3 = P.ink, BackgroundTransparency = 0.5, BorderSizePixel = 0 }, row)
		K.new("Frame", { Size = UDim2.fromScale(c.progress / c.n, 1), BackgroundColor3 = c.ready and P.yellow or C(70, 220, 100), BorderSizePixel = 0 }, bar)
		table.insert(w.contractRows, row)
	end
	w.contracts.Visible = #(st.contracts or {}) &gt; 0 and K.state.open == nil
	w.jobsDot.Visible = anyReady(st)
	K.hud.leftCol.Visible = K.state.open == nil
end

local lastMult = 1

local function tick()
	local st = K.store.State
	if not st then
		return
	end
	local run = st.run or {}
	local picked = run.picked or 0
	w.combo.Visible = picked &gt; 0 and K.state.open == nil
	if picked &gt; 0 then
		local mult = run.mult or 1
		w.comboText.Text = T("combo", tostring(mult))
		local elapsed = run.firstAt and (Workspace:GetServerTimeNow() - run.firstAt) or 999
		local left = 40 - elapsed
		w.comboSub.Text = left &gt; 0 and string.format("speed bonus %ds", math.ceil(left)) or "bank it at home"
		w.comboSub.TextColor3 = left &gt; 0 and (left &lt;= 10 and C(255, 120, 100) or P.white) or C(200, 200, 205)
		if mult &gt; lastMult then
			w.comboScale.Scale = 1.2
			K.tween(w.comboScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
			UI.Sfx("combo")
		end
		lastMult = mult
	else
		lastMult = 1
	end
	if hot then
		local now = Workspace:GetServerTimeNow()
		if hot.kind == "warn" then
			local left = hot.at - now
			w.hot.Visible = left &gt; 0
			w.hotText.Text = T("hot_drop_in", T("zone_" .. hot.zone), math.ceil(left))
		else
			local landing = hot.landAt - now
			local left = hot.expiresAt - now
			w.hot.Visible = left &gt; 0
			w.hotText.Text = "📦 " .. T("hot_drop") .. ": " .. string.upper(T("zone_" .. hot.zone)) .. "  " .. (landing &gt; 0 and ("⬇ " .. math.ceil(landing)) or ("⏱ " .. math.ceil(left)))
		end
		if not w.hot.Visible then
			hot = nil
		end
	else
		w.hot.Visible = false
	end
end

function X.OnHotDrop(info)
	if info.kind == "warn" then
		hot = { kind = "warn", zone = info.zone, at = Workspace:GetServerTimeNow() + info.inSeconds }
	elseif info.kind == "start" then
		hot = info
		if info.by then
			UI.Toast(T("hot_drop_called", info.by), "warn")
		end
		UI.Sfx("siren")
	elseif info.kind == "end" then
		if hot and hot.id == info.id then
			hot = nil
		end
		if info.reason == "taken" and info.winner then
			UI.Toast(T("hot_drop_taken", info.winner), "info")
		end
	end
end

function X.HotDrop()
	return hot
end

function X.Init(ui)
	UI = ui
	K = UI.Kit()
	P = K.P
	buildShop()
	buildDonate()
	buildTony()
	buildJobs()
	buildRebirth()
	buildHud()
	-- garage GEAR button (UI.lua): its "x2 4:12" text and the gear chooser for that car
	UI.GearTag = gearTag
	UI.OnGear = function(uid)
		openPicker({ uid = uid })
	end
	table.insert(UI.Hooks, function(st, open)
		refreshShop(st, open)
		refreshDonate(st, open)
		refreshTony(st, open)
		refreshJobs(st, open)
		refreshRebirth(st, open)
		refreshHud(st)
		refreshGearBoard(st)
		refreshPicker(st, open)
	end)
	K.store.MoneyChanged.Event:Connect(function()
		local st = K.store.State
		if st and K.state.open == "shop" then
			refreshShop(st, "shop")
		elseif st and K.state.open == "tony" then
			refreshTony(st, "tony") -- prices + BUY buttons follow the wallet (text-only update)
		end
	end)
	require(Shared:WaitForChild("Net")).Get("OfflineEarnings").OnClientEvent:Connect(showOffline)
	-- walk up to the NPCs
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local n = prompt.Parent and prompt.Parent.Name
		if n == "ShopPrompt" then
			UI.TogglePanel("shop")
		elseif n == "DonatePrompt" then
			UI.TogglePanel("donate")
		elseif n == "MagnatPrompt" then
			-- Golden Magnat GT podium on the square: buy the game pass right here
			local st = K.store.State
			if st and st.passes and st.passes.golden_car then
				UI.Toast("You already own the Golden Magnat GT!", "good")
			else
				K.actions.Donate("golden_car")
			end
		elseif n == "TonyPrompt" then
			if K.state.open ~= "tony" then
				UI.TogglePanel("tony")
			end
		end
	end)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc = acc + dt
		if acc &gt;= 0.1 then
			acc = 0
			tick()
		end
	end)
	-- boost + gear timers count down locally between state pushes (text updates only)
	task.spawn(function()
		while true do
			task.wait(1)
			local st = K.store.State
			if st then
				if st.boosts then
					for k, v in pairs(st.boosts) do
						st.boosts[k] = math.max(0, v - 1)
					end
					if K.state.open == "donate" then
						refreshDonate(st, "donate")
					end
				end
				refreshPills(st)
				refreshTony(st, K.state.open)
				refreshGearBoard(st)
				tickPicker()
				if K.state.open == "garage" and UI.TickGarageGears then
					UI.TickGarageGears()
				end
			end
		end
	end)
end

return X
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX16CD8162205341CEB1E4257911EEC771"><Properties><string name="Name">ZoneFx</string><ProtectedString name="Source">-- Per-district hazards on the client: level-crossing lights/arms (docks), sandstorm (desert),
-- jet blast behind taxiing planes (airport), rain + lightning (storm).
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local TrafficMath = require(Shared:WaitForChild("TrafficMath"))
local Perf = require(script.Parent:WaitForChild("Perf"))

local ZoneFx = {}
local C = Color3.fromRGB

-- seconds until the next train passes x = 0 on this road (nil if far away)
local function trainNear(roadId, t)
	for _, lane in ipairs(TrafficMath.RoadLanes[roadId] or {}) do
		for k = 1, lane.count do
			local x = TrafficMath.CarX(lane, k, t)
			local half = 75
			-- approaching from its tail side or currently over the crossing
			local ahead = -x * lane.dir
			if math.abs(x) &lt; half + 20 or (ahead &gt; 0 and ahead &lt; lane.speed * 4 + half) then
				return true
			end
		end
	end
	return false
end

local LIGHT_ON, LIGHT_OFF = C(255, 40, 30), C(90, 20, 20)
local function crossings(t)
	local blink = math.floor(t * 2.5) % 2
	local state = {}
	for _, l in ipairs(CollectionService:GetTagged("CrossingLight")) do
		local rid = l:GetAttribute("RoadId")
		if state[rid] == nil then
			state[rid] = trainNear(rid, t)
		end
		local on = state[rid] and (l:GetAttribute("Phase") % 2 == blink)
		local mat = on and Enum.Material.Neon or Enum.Material.SmoothPlastic
		local col = on and LIGHT_ON or LIGHT_OFF
		if l.Material ~= mat or l.Color ~= col then
			l.Color = col
			l.Material = mat
		end
	end
	for _, arm in ipairs(CollectionService:GetTagged("CrossingArm")) do
		local rid = arm:GetAttribute("RoadId")
		local down = state[rid]
		if down == nil then
			down = trainNear(rid, t)
			state[rid] = down
		end
		local base = arm:GetAttribute("BaseCF")
		if not base then
			arm:SetAttribute("BaseCF", arm.CFrame)
			base = arm.CFrame
		end
		local s = arm:GetAttribute("Side")
		local pivot = base * CFrame.new(s * 6, 0, 0)
		local goal = down and pivot * CFrame.new(-s * 6, 0, 0) or pivot * CFrame.Angles(0, 0, -s * math.rad(80)) * CFrame.new(-s * 6, 0, 0)
		local armCF = arm.CFrame
		if (armCF.Position - goal.Position).Magnitude &gt; 0.01 or armCF.LookVector:Dot(goal.LookVector) &lt; 0.99999 or armCF.UpVector:Dot(goal.UpVector) &lt; 0.99999 then
			arm.CFrame = armCF:Lerp(goal, 0.1)
		end
	end
end

local atmo, rain, rainPart
local function ensureWeather()
	if not atmo then
		atmo = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere", Lighting)
		atmo:SetAttribute("BaseDensity", atmo.Density)
		atmo:SetAttribute("BaseHaze", atmo.Haze)
		atmo:SetAttribute("BaseColor", atmo.Color)
	end
	if not rainPart then
		rainPart = Instance.new("Part")
		rainPart.Name = "RainEmitter"
		rainPart.Anchored, rainPart.CanCollide, rainPart.CanQuery, rainPart.CanTouch = true, false, false, false
		rainPart.Transparency = 1
		rainPart.Size = Vector3.new(120, 1, 120)
		rain = Instance.new("ParticleEmitter")
		rain.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		rain.Color = ColorSequence.new(C(190, 210, 230))
		rain.Size = NumberSequence.new(0.12)
		rain.Lifetime = NumberRange.new(0.9, 1.1)
		rain.Speed = NumberRange.new(80, 90)
		rain.EmissionDirection = Enum.NormalId.Bottom
		rain.Rate = 0
		rain.LightInfluence = 0.5
		rain.Transparency = NumberSequence.new(0.3)
		rain.Parent = rainPart
		rainPart.Parent = Workspace.CurrentCamera
	end
end

local lastBolt = 0
local RAIN_RATE = { HIGH = 900, MED = 450, LOW = 180 }
local cur -- the atmosphere values this script last wrote (lerped here, written only when they really change)
local function weather(zid, t, camPos)
	ensureWeather()
	local d0, h0, c0 = atmo:GetAttribute("BaseDensity"), atmo:GetAttribute("BaseHaze"), atmo:GetAttribute("BaseColor")
	local wantD, wantH, wantC = d0, h0, c0
	local rate = 0
	if not cur then
		cur = { d = atmo.Density, h = atmo.Haze, c = atmo.Color }
	end
	if zid == "desert" then
		local wave = math.max(0, math.sin(t * 2 * math.pi / 40)) -- a storm front every 40 s
		wantD, wantH, wantC = d0 + 0.45 * wave, h0 + 6 * wave, c0:Lerp(C(214, 170, 110), wave)
	elseif zid == "storm" then
		wantD, wantH, wantC = d0 + 0.4, h0 + 3, c0:Lerp(C(90, 100, 116), 0.8)
		rate = RAIN_RATE[Perf.Level()] or 900
		if t - lastBolt &gt; 6 + (t % 5) then
			lastBolt = t
			local cc = Lighting:FindFirstChild("BoltFlash") or Instance.new("ColorCorrectionEffect", Lighting)
			cc.Name = "BoltFlash"
			cc.Brightness = 0.6
			task.spawn(function()
				for _ = 1, 10 do
					task.wait(0.03)
					cc.Brightness = cc.Brightness * 0.7
				end
				cc.Brightness = 0
			end)
		end
	end
	if math.abs(wantD - cur.d) &gt; 0.001 then
		cur.d = cur.d + (wantD - cur.d) * 0.05
		atmo.Density = cur.d
	end
	if math.abs(wantH - cur.h) &gt; 0.005 then
		cur.h = cur.h + (wantH - cur.h) * 0.05
		atmo.Haze = cur.h
	end
	local dc = math.max(math.abs(wantC.R - cur.c.R), math.abs(wantC.G - cur.c.G), math.abs(wantC.B - cur.c.B))
	if dc &gt; 0.002 then
		cur.c = cur.c:Lerp(wantC, 0.05)
		atmo.Color = cur.c
	end
	if rain.Rate ~= rate then
		rain.Rate = rate
	end
	if rate &gt; 0 then
		rainPart.CFrame = CFrame.new(camPos + Vector3.new(0, 40, 0))
	end
end

-- planes push players standing in their exhaust
local function jetBlast(t, hrp)
	local pos = hrp.Position
	local ri = TrafficMath.RoadAtZ(pos.Z, 24)
	local road = ri and MapConfig.Roads[ri]
	if not road or road.kinds[1] ~= "plane" then
		return
	end
	for _, lane in ipairs(TrafficMath.RoadLanes[ri]) do
		for k = 1, lane.count do
			local x = TrafficMath.CarX(lane, k, t)
			local behind = (x - pos.X) * lane.dir -- &gt;0 when the player is behind the plane
			if behind &gt; 18 and behind &lt; 60 and math.abs(pos.Z - lane.z) &lt; 14 then
				local push = Vector3.new(-lane.dir * 70, 18, 0) * (1 - (behind - 18) / 42)
				hrp.AssemblyLinearVelocity = hrp.AssemblyLinearVelocity:Lerp(push, 0.25)
			end
		end
	end
end

function ZoneFx.Start()
	RunService.Heartbeat:Connect(function()
		local cam = Workspace.CurrentCamera
		if not cam then
			return
		end
		local t = Workspace:GetServerTimeNow()
		local camPos = cam.CFrame.Position
		local zid = MapConfig.ZoneAt(camPos.Z)
		if zid == "docks" then
			crossings(t)
		end
		weather(zid, t, camPos)
		local char = Players.LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp and zid == "airport" then
			jetBlast(t, hrp)
		end
	end)
end

return ZoneFx
</ProtectedString></Properties></Item></Item></Item></Item></roblox>