local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))

Net.EnsureAll()

for _, e in ipairs(MapConfig.Validate()) do warn("[MapConfig]", e) end
for _, e in ipairs(CarConfig.Validate()) do warn("[CarConfig]", e) end

Players.CharacterAutoLoads = false
Players.RespawnTime = 3

pcall(function()
	Lighting.ClockTime = 14.3
	Lighting.Brightness = 2.3
	Lighting.Ambient = Color3.fromRGB(128, 124, 116)
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 136, 124)
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.6
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.5
	Lighting.GeographicLatitude = 30
	if not Lighting:FindFirstChild("CHAtmosphere") then
		local sky = Instance.new("Sky")
		sky.Name = "CHSky"
		sky.SunAngularSize = 14
		sky.MoonAngularSize = 9
		sky.StarCount = 4000
		sky.Parent = Lighting
		local a = Instance.new("Atmosphere")
		a.Name = "CHAtmosphere"
		a.Density = 0.26
		a.Offset = 0.15
		a.Color = Color3.fromRGB(200, 226, 255)
		a.Decay = Color3.fromRGB(150, 190, 230)
		a.Glare = 0.25
		a.Haze = 1.3
		a.Parent = Lighting
		local b = Instance.new("BloomEffect")
		b.Name = "CHBloom"
		b.Intensity = 0.45
		b.Size = 24
		b.Threshold = 1.15
		b.Parent = Lighting
		local r = Instance.new("SunRaysEffect")
		r.Name = "CHSunRays"
		r.Intensity = 0.05
		r.Spread = 0.6
		r.Parent = Lighting
		local c = Instance.new("ColorCorrectionEffect")
		c.Name = "CHColor"
		c.Saturation = 0.18
		c.Contrast = 0.06
		c.Brightness = 0.02
		c.Parent = Lighting
	end
end)

for _, name in ipairs({ "RuntimeTraffic", "RuntimeDrops" }) do
	if not Workspace:FindFirstChild(name) then
		local f = Instance.new("Folder")
		f.Name = name
		f.Parent = Workspace
	end
end

-- Blender models must be in place before the map is built (embedded in the place; LoadAsset only as a fallback)
local okModels, errModels = pcall(function()
	require(ServerScriptService:WaitForChild("Services"):WaitForChild("ModelService")).LoadAll()
end)
if not okModels then
	warn("[CarHunters] ModelService failed:", errModels)
end
-- real car models from the assets embedded in the place (Creator Store cars)
local okCars, carsOrErr = pcall(function()
	return require(ServerStorage:WaitForChild("Tools"):WaitForChild("CarStoreTool")).InstallMissingEmbedded()
end)
if okCars then
	local carModels = game:GetService("ReplicatedStorage"):FindFirstChild("CarModels")
	local real = 0
	for _, m in ipairs(carModels and carModels:GetChildren() or {}) do
		if m:IsA("Model") and m:FindFirstChildWhichIsA("BasePart", true) then
			real = real + 1
		end
	end
	Workspace:SetAttribute("RealCars", real)
	print(string.format("[CarHunters] %d store car models installed from the place file (%d real car models in total)", carsOrErr, real))
else
	warn("[CarHunters] car models failed:", carsOrErr)
end

local savedMap = Workspace:FindFirstChild("GeneratedMap")
local propsNow = ServerStorage:FindFirstChild("BuilderAssets") and ServerStorage.BuilderAssets:FindFirstChild("Props")
local templatesNow = propsNow and #propsNow:GetChildren() or 0
if savedMap and savedMap:GetAttribute("MapVersion") ~= MapConfig.Version then
	warn("[CarHunters] saved map is outdated - rebuilding")
	savedMap:Destroy()
elseif savedMap and templatesNow &gt; (savedMap:GetAttribute("Templates") or 0) then
	warn("[CarHunters] saved map was built without some 3D models - rebuilding")
	savedMap:Destroy()
end
if not Workspace:FindFirstChild("GeneratedMap") then
	local ok, err = pcall(function()
		local Build = require(ServerStorage:WaitForChild("Tools"):WaitForChild("BuildCityMap"))
		Build.Build({ runtime = true })
	end)
	if not ok then
		warn("[CarHunters] MAP BUILD FAILED:", err)
	end
end

local Services = ServerScriptService:WaitForChild("Services")
local S = {}
local names = { Data = "DataService", Inventory = "InventoryService", Base = "BaseService", PartSpawn = "PartSpawnService",
	Traffic = "TrafficService", Capture = "CaptureService", Cars = "CarCollectionService", Income = "IncomeService",
	Upgrade = "UpgradeService", Zone = "ZoneService", Warp = "WarpService", Shop = "ShopService", Donate = "DonateService",
	HotDrop = "HotDropService", Contracts = "ContractService", Tuning = "TuningService", Mechanic = "MechanicService", Boss = "BossService", Rebirth = "RebirthService", Leaderboard = "LeaderboardService", Checkpoint = "CheckpointService", Rewards = "RewardsService", Trade = "TradeService" }
for key, moduleName in pairs(names) do
	S[key] = require(Services:WaitForChild(moduleName))
end
for _, svc in pairs(S) do
	if svc.Init then svc.Init(S) end
end
for _, svc in pairs(S) do
	if svc.Start then svc.Start() end
end

Net.Get("ThrowPart").OnServerEvent:Connect(function(p, partId) S.Capture.Throw(p, partId) end)
Net.Get("ThrowBatch").OnServerEvent:Connect(function(p, counts, merge) S.Capture.ThrowBatch(p, counts, merge == true) end)
Net.Get("PlaceCar").OnServerEvent:Connect(function(p, uid, slot) S.Cars.Place(p, uid, slot) end)
Net.Get("RemoveCar").OnServerEvent:Connect(function(p, uid) S.Cars.Remove(p, uid) end)
Net.Get("UpgradeCar").OnServerEvent:Connect(function(p, uid, lvl) S.Upgrade.UpgradeCar(p, uid, lvl) end)
Net.Get("BuySlot").OnServerEvent:Connect(function(p, n) S.Upgrade.BuySlot(p, n) end)
Net.Get("BuyFloor").OnServerEvent:Connect(function(p, n) S.Upgrade.BuyFloor(p, n) end)
Net.Get("UnlockZone").OnServerEvent:Connect(function(p, z) S.Zone.Unlock(p, z) end)
Net.Get("SellCar").OnServerEvent:Connect(function(p, uid) S.Cars.Sell(p, uid) end)
Net.Get("TradeRequest").OnServerEvent:Connect(function(p, id) S.Trade.Request(p, id) end)
Net.Get("TradeRespond").OnServerEvent:Connect(function(p, id, ok) S.Trade.Respond(p, id, ok == true) end)
Net.Get("TradeUpdate").OnServerEvent:Connect(function(p, offer) S.Trade.Update(p, offer) end)
Net.Get("TradeReady").OnServerEvent:Connect(function(p, on) S.Trade.Ready(p, on) end)
Net.Get("TradeCancel").OnServerEvent:Connect(function(p) S.Trade.Cancel(p) end)
Net.Get("ClaimDaily").OnServerEvent:Connect(function(p) S.Rewards.ClaimDaily(p) end)
Net.Get("ClaimChest").OnServerEvent:Connect(function(p, i) S.Rewards.ClaimChest(p, i) end)
Net.Get("TutorialStep").OnServerEvent:Connect(function(p, step) S.Data.Tutorial(p, step) end)
Net.Get("SaveSettings").OnServerEvent:Connect(function(p, t) S.Data.SaveSettings(p, t) end)
Net.Get("CheckpointChoice").OnServerEvent:Connect(function(p, c) S.Checkpoint.Choose(p, c) end)
Net.Get("SellCars").OnServerEvent:Connect(function(p, uids) S.Cars.SellMany(p, uids) end)
Net.Get("AutoPark").OnServerEvent:Connect(function(p) S.Cars.AutoPark(p) end)
Net.Get("Teleport").OnServerEvent:Connect(function(p, dest) S.Warp.Go(p, dest) end)
Net.Get("BuyPerk").OnServerEvent:Connect(function(p, id) S.Shop.Buy(p, id) end)
Net.Get("Donate").OnServerEvent:Connect(function(p, id) S.Donate.Request(p, id) end)
Net.Get("ClaimContract").OnServerEvent:Connect(function(p, id) S.Mechanic.Claim(p, id) end)
Net.Get("CraftTuning").OnServerEvent:Connect(function(p, id) S.Mechanic.Craft(p, id) end)
Net.Get("Rebirth").OnServerEvent:Connect(function(p) S.Rebirth.Do(p) end)
Net.Get("SetSkin").OnServerEvent:Connect(function(p, id) S.Rebirth.Skin(p, id) end)
Net.Get("TokenPerk").OnServerEvent:Connect(function(p, id) S.Rebirth.TokenPerk(p, id) end)
Net.Get("BossThrow").OnServerEvent:Connect(function(p) S.Boss.Throw(p) end)
Net.Get("TuneCar").OnServerEvent:Connect(function(p, uid, cat, item) S.Tuning.Set(p, uid, cat, item) end)

local function hookCharacter(player, char)
	local hum = char:WaitForChild("Humanoid", 10)
	if not hum then return end
	local sess = S.Data.Get(player)
	hum.WalkSpeed = sess and S.Shop.WalkSpeed(sess) or MapConfig.WalkSpeed
	hum.BreakJointsOnDeath = false -- the client ragdolls the body (DeathFx)
	S.Traffic.Protect(player, sess and S.Shop.SpawnShield(sess) or EconomyConfig.SpawnProtection)
	task.defer(function() S.Inventory.EnsureNotStuck(player) end)
	hum.Died:Connect(function()
		S.Inventory.OnDeath(player)
		local sess2 = S.Data.Get(player)
		task.delay(sess2 and S.Shop.RespawnTime(sess2) or Players.RespawnTime, function()
			if player.Parent and player.Character == char then
				player:LoadCharacter()
			end
		end)
	end)
end

local function cleanup(player)
	local s = S.Data.Get(player)
	if not s then return end
	S.Base.Release(player)
	S.Data.Save(player, true)
	S.Data.Unload(player)
end

local function onPlayerAdded(player)
	player.CharacterAdded:Connect(function(char) hookCharacter(player, char) end)
	local s = S.Data.Load(player)
	if not s then return end
	if not player.Parent then
		cleanup(player)
		return
	end
	S.Income.CreateLeaderstats(player)
	local idx = S.Base.Assign(player)
	if not idx then
		player:Kick("Server is full (max " .. EconomyConfig.MaxPlayers .. " players).")
		S.Data.Unload(player)
		return
	end
	S.Income.Recalc(player)
	S.Base.RefreshAll(player)
	s.ready = true
	S.Income.PayOffline(player)
	S.Data.Push(player)
	player:LoadCharacter()
	-- Studio only: say right in the game how many real 3D models are in use (no digging through Output)
	if game:GetService("RunService"):IsStudio() then
		local rep = require(ServerScriptService.Services.ModelService).Report or { installed = 0, missing = {} }
		task.delay(4, function()
			S.Data.Notify(player, "modelReport", { rep.installed, Workspace:GetAttribute("RealCars") or 0, #rep.missing }, #rep.missing &gt; 0 and "warn" or "good")
		end)
	end
	if s.leftEarly then cleanup(player) end
end

Players.PlayerAdded:Connect(function(p) task.spawn(onPlayerAdded, p) end)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, p)
end

Players.PlayerRemoving:Connect(function(player)
	local s = S.Data.Get(player)
	if not s then return end
	if s.ready then
		cleanup(player)
	else
		s.leftEarly = true
	end
end)

game:BindToClose(function()
	S.Data.SaveAll()
end)

print("[CarHunters] server ready. Spawn points:", S.PartSpawn.PointCount())
</ProtectedString></Properties></Item><Item class="Folder" referent="RBX39"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX29"><Properties><string name="Name">BaseService</string><ProtectedString name="Source">local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local Strings = require(Shared:WaitForChild("Strings"))
local BaseLayout = require(Shared:WaitForChild("BaseLayout"))
local VehicleFactory = require(Shared:WaitForChild("VehicleFactory"))
local ExhaustFx = require(Shared:WaitForChild("ExhaustFx"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))
local Util = require(Shared:WaitForChild("Util"))
local GarageKit = require(Shared:WaitForChild("GarageKit"))
local TuningConfig = require(Shared:WaitForChild("TuningConfig"))
local SkinConfig = require(Shared:WaitForChild("SkinConfig"))
local PartVisual = require(Shared:WaitForChild("PartVisual"))

local Base = {}
local S
local bases = {}

local PAD_LOCKED = Color3.fromRGB(46, 48, 54)
local PAD_FREE = Color3.fromRGB(86, 90, 98)

function Base.Init(hub)
	S = hub
end

function Base.Start()
	local map = Workspace:WaitForChild("GeneratedMap", 30)
	assert(map, "GeneratedMap not found - run BuildCityMap")
	local basesFolder = map:WaitForChild("Bases")
	for i = 1, MapConfig.BaseCount do
		local m = basesFolder:FindFirstChild(string.format("Base%02d", i), true)
		assert(m, "Base model missing: Base" .. i)
		local b = { index = i, model = m, owner = nil, sig = {}, carModels = {}, pads = {} }
		local slots = m:WaitForChild("Slots")
		for n = 1, BaseLayout.SlotsPerFloor do
			b.pads[n] = slots:WaitForChild("Slot" .. n)
		end
		b.floorModels = {}
		b.floorsFolder = m:FindFirstChild("Floors") or Instance.new("Folder", m)
		b.floorsFolder.Name = "Floors"
		b.spawn = m:WaitForChild("Spawn")
		b.sign = m:WaitForChild("OwnerSign"):FindFirstChildWhichIsA("SurfaceGui", true)
		b.screen = m:WaitForChild("IncomeScreen"):FindFirstChildWhichIsA("SurfaceGui", true)
		b.cars = m:FindFirstChild("Cars")
		if not b.cars then
			b.cars = Instance.new("Folder")
			b.cars.Name = "Cars"
			b.cars.Parent = m
		end
		bases[i] = b
		Base.SetFree(b)
	end
end

local function setPad(pad, state, rarityColor)
	if not pad then
		return
	end
	pad.Material = Enum.Material.SmoothPlastic
	pad.Transparency = 0
	if state == "locked" then
		pad.Color = PAD_LOCKED
	elseif state == "free" then
		pad.Color = PAD_FREE
	else
		pad.Color = rarityColor:Lerp(Color3.fromRGB(70, 74, 82), 0.55) -- tinted bay, the car itself carries the colour
	end
end

local function setLabel(gui, text)
	if gui then
		local label = gui:FindFirstChild("Label")
		if label then
			label.Text = text
		end
	end
end

-- builds/removes floors 2..n for the owner
local function ensureFloors(b, floors, style)
	for f = 2, BaseLayout.MaxFloors do
		if f &lt;= floors and not b.floorModels[f] then
			local m, pads = GarageKit.BuildFloor(b.floorsFolder, BaseLayout.GetBaseCFrame(b.index), f, style)
			b.floorModels[f] = m
			for slot, pad in pairs(pads) do
				b.pads[slot] = pad
			end
		elseif f &gt; floors and b.floorModels[f] then
			b.floorModels[f]:Destroy()
			b.floorModels[f] = nil
			for slot = (f - 1) * BaseLayout.SlotsPerFloor + 1, f * BaseLayout.SlotsPerFloor do
				b.pads[slot] = nil
			end
		end
	end
end
Base.EnsureFloors = ensureFloors

function Base.SetFree(b)
	b.owner = nil
	for slot, model in pairs(b.carModels) do
		model:Destroy()
	end
	b.carModels = {}
	b.sig = {}
	ensureFloors(b, 1)
	if b.skin and b.skin ~= "classic" then
		GarageKit.ApplyStyle(b.model, GarageKit.Style)
	end
	b.skin = "classic"
	for _, pad in pairs(b.pads) do
		setPad(pad, "locked")
	end
	setLabel(b.sign, Strings.Tables.en.free_garage)
	setLabel(b.screen, "")
end

function Base.Assign(player)
	local s = S.Data.Get(player)
	if not s then
		return nil
	end
	for i = 1, MapConfig.BaseCount do
		local b = bases[i]
		if not b.owner then
			b.owner = player
			s.baseIndex = i
			player:SetAttribute("BaseIndex", i)
			player.RespawnLocation = b.spawn
			setLabel(b.sign, string.format(Strings.Tables.en.garage_of, player.DisplayName))
			return i
		end
	end
	return nil
end

function Base.Release(player)
	local s = S.Data.Get(player)
	if s and s.baseIndex then
		local b = bases[s.baseIndex]
		if b and b.owner == player then
			Base.SetFree(b)
		end
		s.baseIndex = nil
	end
end

function Base.GetBase(index)
	return bases[index]
end

function Base.IsNearOwnBase(player)
	local s = S.Data.Get(player)
	if not s or not s.baseIndex then
		return false
	end
	local hrp = S.Data.GetRoot(player)
	if not hrp then
		return false
	end
	local center = BaseLayout.GetBaseCFrame(s.baseIndex).Position
	return (hrp.Position - center).Magnitude &lt;= EconomyConfig.BaseActionDistance
end

-- visible tuning: aero adds a wing, boost/nitro make the exhaust spit flames
local function applyTuneVisuals(model, def, tune)
	local root = model.PrimaryPart
	if not root or type(tune) ~= "table" then
		return
	end
	if tune.boost or tune.nitro then
		for _, att in ipairs(root:GetChildren()) do
			if att:IsA("Attachment") and att.Name == "Exhaust" then
				CollectionService:AddTag(att, "Backfire")
				att:SetAttribute("Color", tune.nitro and Color3.fromRGB(90, 170, 255) or Color3.fromRGB(255, 140, 40))
			end
		end
	end
	if tune.aero then
		local ext = model:GetExtentsSize()
		local stage = TuningConfig.Items[tune.aero].stage
		local back = root.CFrame * CFrame.new(-ext.X / 2 + 0.9, ext.Y / 2 + 0.3 + stage * 0.15, 0)
		local function wingPart(size, cf)
			local p = Instance.new("Part")
			p.Name = "Wing"
			p.Size = size
			p.CFrame = cf
			p.Color = stage == 3 and Color3.fromRGB(30, 30, 34) or def.body or Color3.fromRGB(30, 30, 34)
			p.Material = stage == 3 and Enum.Material.Metal or Enum.Material.SmoothPlastic -- (Material.Carbon does not exist)
			p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.Massless = true, false, false, false, true
			p.Parent = model
		end
		local wing = PartVisual.BuildTuning("aero", ext.Z * 0.85)
		if wing then
			-- Blender wing: its span lies along Y in Blender = along Z here, uprights point down
			wing:PivotTo(back * CFrame.new(0, -0.6, 0))
			wing.Parent = model
		else
			wingPart(Vector3.new(1.1, 0.14, ext.Z * 0.9), back)
			for _, z in ipairs({ -1, 1 }) do
				wingPart(Vector3.new(0.5, 0.8, 0.14), back * CFrame.new(0.1, -0.45, z * ext.Z * 0.3))
			end
		end
	end
end

local function buildCarModel(def, level, slotCF, car)
	local model = VehicleFactory.BuildCar(def)
	model:PivotTo(slotCF)
	ExhaustFx.Attach(model, def, CarConfig.Rarities[def.rarity].index)
	applyTuneVisuals(model, def, car and car.tune)
	local rarity = CarConfig.Rarities[def.rarity]
	local gui = Instance.new("BillboardGui")
	gui.Name = "Tag"
	gui.Size = UDim2.fromOffset(150, 40)
	gui.StudsOffset = Vector3.new(0, VehicleFactory.HeightOfModel(model, def.style) + 2, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 70
	gui.Adornee = model.PrimaryPart
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.LuckiestGuy
	label.TextSize = 14
	label.TextColor3 = rarity.color
	label.TextStrokeTransparency = 0.3
	label.Text = string.format("%s  Lv%d\n+%s/s", def.name, level, Util.FormatNumber(car and CarConfig.CarIncome(car) or CarConfig.IncomeAt(def, level)))
	label.Parent = gui
	gui.Parent = model.PrimaryPart
	return model
end

function Base.RefreshAll(player)
	local s = S.Data.Get(player)
	if not s or not s.baseIndex then
		return
	end
	local b = bases[s.baseIndex]
	if not b or b.owner ~= player then
		return
	end
	local d = s.data
	local skin = SkinConfig.ById[d.skin] or SkinConfig.ById.classic
	ensureFloors(b, d.floors or 1, skin.style)
	if b.skin ~= skin.id or b.skinFloors ~= d.floors then
		b.skin, b.skinFloors = skin.id, d.floors
		GarageKit.ApplyStyle(b.model, skin.style)
	end
	local now = os.clock()
	local bySlot = {}
	for _, c in ipairs(d.cars) do
		if c.parkedSlot then
			bySlot[c.parkedSlot] = c
		end
	end
	for slot = 1, BaseLayout.SlotCount do
		local pad = b.pads[slot]
		local car = bySlot[slot]
		if not pad then
			car = nil
		end
		local hidden = car and s.hidden[car.uid] and s.hidden[car.uid] &gt; now
		if slot &gt; d.garageSlotCount then
			setPad(pad, "locked")
			car = nil
		elseif car and not hidden then
			local def = CarConfig.ById[car.typeId]
			setPad(pad, "occupied", CarConfig.Rarities[def.rarity].color)
		else
			setPad(pad, "free")
		end
		local want = (car and not hidden) and (car.uid .. ":" .. car.level .. ":" .. TuningConfig.CarMult(car.tune)) or nil
		if b.sig[slot] ~= want then
			if b.carModels[slot] then
				b.carModels[slot]:Destroy()
				b.carModels[slot] = nil
			end
			b.sig[slot] = want
			if want then
				local def = CarConfig.ById[car.typeId]
				local model = buildCarModel(def, car.level, BaseLayout.SlotCFrame(b.index, slot), car)
				model.Name = "Car_" .. slot
				model.Parent = b.cars
				b.carModels[slot] = model
			end
		end
	end
end

function Base.SetIncomeText(player, text)
	local s = S.Data.Get(player)
	if s and s.baseIndex and bases[s.baseIndex] then
		setLabel(bases[s.baseIndex].screen, text)
	end
end

return Base
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX30"><Properties><string name="Name">CaptureService</string><ProtectedString name="Source">local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local BaseLayout = require(Shared:WaitForChild("BaseLayout"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))

local Capture = {}
local S
local rng = Random.new()

function Capture.Init(hub)
	S = hub
end

function Capture.Roll(points, r1, r2, pity)
	return CarConfig.RollPoints(points, pity or 0, r1, r2)
end

-- one car from a throw worth `points`, with pity + luck; records discovery. Returns rarity, def, isNew, bonus, pityUsed
local function rollOne(s, points)
	local d = s.data
	local pityUsed = d.pity &gt;= EconomyConfig.PityThreshold - 1
	local shift = S.Shop.LuckShift(s)
	local r1 = 1 - (1 - rng:NextNumber()) * (1 - shift) -- luck pushes the roll towards rarer cars
	local rarity, def = Capture.Roll(points, r1, rng:NextNumber(), d.pity)
	if CarConfig.IsHighTier(rarity) then
		d.pity = 0
	else
		d.pity = d.pity + 1
	end
	local isNew = not d.discovered[def.id]
	local bonus = 0
	if isNew then
		d.discovered[def.id] = true
		bonus = CarConfig.DiscoverBonus(def)
		d.money = math.min(d.money + bonus, EconomyConfig.MaxMoney)
	end
	return rarity, def, isNew, bonus, pityUsed
end
Capture.RollOne = rollOne

-- checks shared by single and batch throws; returns the session or nil
local function canThrow(player)
	local s = S.Data.Get(player)
	if not s or not s.ready then
		return nil
	end
	if s.busy then
		S.Data.Notify(player, "trapBusy", nil, "warn")
		return nil
	end
	if not s.baseIndex then
		S.Data.Notify(player, "noBase", nil, "error")
		return nil
	end
	local hrp = S.Data.GetRoot(player)
	if not hrp then
		return nil
	end
	local trap = BaseLayout.ToWorld(s.baseIndex, BaseLayout.TrapLocal)
	local flat = Vector3.new(hrp.Position.X - trap.X, 0, hrp.Position.Z - trap.Z)
	if flat.Magnitude &gt; EconomyConfig.ThrowMaxDistance then
		S.Data.Notify(player, "tooFar", nil, "warn")
		return nil
	end
	return s
end

-- the best copy of a model the player owns (highest level)
local function bestCopy(d, typeId, except)
	local best
	for _, c in ipairs(d.cars) do
		if c.typeId == typeId and c.uid ~= except and (not best or c.level &gt; best.level) then
			best = c
		end
	end
	return best
end

-- counts = { partId = n }, merge = fold duplicates into the owned copy (+1 level up to MergeMaxLevel)
function Capture.ThrowBatch(player, counts, merge)
	if type(counts) ~= "table" or not S.Data.RateLimit(player, "throw", EconomyConfig.ThrowCooldown) then
		return
	end
	local s = canThrow(player)
	if not s then
		return
	end
	local d = s.data
	local plan, total = {}, 0
	for _, id in ipairs(PartConfig.Order) do
		local n = counts[id]
		if n ~= nil then
			if type(n) ~= "number" or n ~= n or n &lt; 0 or n % 1 ~= 0 then
				return
			end
			if n &gt; 0 then
				if not S.Inventory.HasBanked(s, id, n) then
					S.Data.Notify(player, "noPart", nil, "error")
					return
				end
				plan[id] = n
				total = total + n
			end
		end
	end
	if total == 0 then
		return
	end
	if total &gt; EconomyConfig.MaxBatch then
		S.Data.Notify(player, "noPart", nil, "error")
		return
	end
	-- every part adds its rarity points; the throw catches `cars` cars (Multi Catch), each rolled on those points
	local points, bestPart = 0, nil
	for _, id in ipairs(PartConfig.Order) do
		if plan[id] then
			points = points + plan[id] * PartConfig.Parts[id].points
			bestPart = id
		end
	end
	local cars = EconomyConfig.CatchLimit(S.Shop.Level(s, "multi"))
	s.busy = true
	local results, anyPity = {}, false
	for id, n in pairs(plan) do
		S.Inventory.SpendBanked(player, id, n)
	end
	for _ = 1, cars do
		local rarity, def, isNew, bonus, pityUsed = rollOne(s, points)
		anyPity = anyPity or pityUsed
		local r = { partId = bestPart, typeId = def.id, rarity = rarity, isNew = isNew, bonus = bonus }
		local copy = not isNew and merge and bestCopy(d, def.id)
		if copy and copy.level &lt; EconomyConfig.MergeMaxLevel then
			copy.level = copy.level + 1
			r.merged = copy.level
		elseif #d.cars &lt; EconomyConfig.MaxCars then
			local uid = HttpService:GenerateGUID(false)
			table.insert(d.cars, { uid = uid, typeId = def.id, level = 1 })
			r.uid = uid
		else
			-- storage full: pay out the car's sell value instead
			local v = CarConfig.SellPrice(def, 1)
			d.money = math.min(d.money + v, EconomyConfig.MaxMoney)
			r.sold = v
		end
		table.insert(results, r)
	end
	d.stats.throws = d.stats.throws + total
	S.Cars.ParkBest(s)
	-- best = rarest, then new, then highest income
	local best, bestKey
	for i, r in ipairs(results) do
		local key = CarConfig.Rarities[r.rarity].index * 1e7 + (r.isNew and 1e6 or 0) + CarConfig.ById[r.typeId].income
		if not bestKey or key &gt; bestKey then
			best, bestKey = i, key
		end
	end
	for _, r in ipairs(results) do
		if r.uid then
			for _, c in ipairs(d.cars) do
				if c.uid == r.uid then
					r.slot = c.parkedSlot
				end
			end
		end
	end
	S.Income.Recalc(player)
	local animTime = S.Shop.ThrowCooldown(s)
	local single = #results == 1 and results[1].uid ~= nil
	local busyFor = single and animTime + 0.15 or (2.5 + 0.3 * #results) * (animTime / EconomyConfig.ThrowAnimTime)
	if single then
		-- one new car: the full cinematic (merged / sold results go to the batch reveal, which shows them) (part flies in, blackout reveal, drive-in); the real car stays hidden meanwhile
		local r = results[1]
		if r.uid then
			s.hidden[r.uid] = os.clock() + animTime + 0.1
			task.delay(animTime + 0.15, function()
				s.hidden[r.uid] = nil
				if player.Parent then
					S.Base.RefreshAll(player)
				end
			end)
		end
		Net.Get("ThrowResult"):FireClient(player, {
			partId = r.partId, typeId = r.typeId, uid = r.uid, rarity = r.rarity, slot = r.slot, isNew = r.isNew, bonus = r.bonus,
			merged = r.merged, sold = r.sold, pityUsed = anyPity, points = points, parts = total,
			animTime = animTime, speed = EconomyConfig.ThrowAnimTime / animTime,
		})
	else
		Net.Get("ThrowBatchResult"):FireClient(player, { cars = results, best = best, pityUsed = anyPity, total = total, points = points })
	end
	S.Base.RefreshAll(player)
	S.Data.Push(player)
	S.Contracts.Progress(player, "throw", total)
	task.delay(busyFor, function()
		s.busy = false
	end)
end

-- legacy single-part remote: the same as a one-part batch
function Capture.Throw(player, partId)
	if type(partId) == "string" and PartConfig.Parts[partId] then
		Capture.ThrowBatch(player, { [partId] = 1 }, true)
	end
end

return Capture
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX31"><Properties><string name="Name">CarCollectionService</string><ProtectedString name="Source">local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared:WaitForChild("Util"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))

local Cars = {}
local S

function Cars.Init(hub)
	S = hub
end

function Cars.Find(d, uid)
	for _, c in ipairs(d.cars) do
		if c.uid == uid then
			return c
		end
	end
	return nil
end

local function ctx(player, uid)
	if type(uid) ~= "string" or #uid &gt; 64 then
		return nil
	end
	local s = S.Data.Get(player)
	if not s or not s.ready then
		return nil
	end
	if not S.Data.RateLimit(player, "cars", EconomyConfig.ActionCooldown) then
		return nil
	end
	return s -- garage actions work from anywhere (menu or the prompt at the car)
end

local function finish(player)
	S.Base.RefreshAll(player)
	S.Income.Recalc(player)
	S.Data.Push(player)
end

function Cars.Place(player, uid, slot)
	local s = ctx(player, uid)
	if not s or not Util.IsInt(slot) then
		return
	end
	local d = s.data
	if slot &lt; 1 or slot &gt; d.garageSlotCount then
		return
	end
	local car = Cars.Find(d, uid)
	if not car then
		return
	end
	local occupant
	for _, c in ipairs(d.cars) do
		if c ~= car and c.parkedSlot == slot then
			occupant = c
			break
		end
	end
	local oldSlot = car.parkedSlot
	car.parkedSlot = slot
	car.benched = nil
	if occupant then
		occupant.parkedSlot = oldSlot
		occupant.benched = oldSlot == nil or nil -- swapped out to storage: keep it there
	end
	finish(player)
end

function Cars.Remove(player, uid)
	local s = ctx(player, uid)
	if not s then
		return
	end
	local car = Cars.Find(s.data, uid)
	if not car or not car.parkedSlot then
		return
	end
	car.parkedSlot = nil
	car.benched = true -- stays in storage until you park it again (auto-park after throws skips it)
	finish(player)
end

function Cars.Sell(player, uid)
	local s = ctx(player, uid)
	if not s then
		return
	end
	local d = s.data
	if s.hidden[uid] then
		S.Data.Notify(player, "busy", nil, "warn")
		return
	end
	local idx
	for i, c in ipairs(d.cars) do
		if c.uid == uid then
			idx = i
			break
		end
	end
	if not idx then
		return
	end
	local car = d.cars[idx]
	local def = CarConfig.ById[car.typeId]
	local price = CarConfig.SellPrice(def, car.level)
	table.remove(d.cars, idx)
	d.money = math.min(d.money + price, EconomyConfig.MaxMoney)
	d.stats.sold = (d.stats.sold or 0) + 1
	S.Data.Notify(player, "sold", { def.name, price }, "good")
	finish(player)
end

-- sell several cars at once (garage menu "sell all ..."); max 100 per call
function Cars.SellMany(player, uids)
	if type(uids) ~= "table" or #uids == 0 or #uids &gt; 100 then
		return
	end
	local s = S.Data.Get(player)
	if not s or not s.ready or not S.Data.RateLimit(player, "sellmany", 1) then
		return
	end
	local d = s.data
	local want = {}
	for _, uid in ipairs(uids) do
		if type(uid) == "string" and #uid &lt;= 64 then
			want[uid] = true
		end
	end
	local total, n = 0, 0
	for i = #d.cars, 1, -1 do
		local car = d.cars[i]
		if want[car.uid] and not s.hidden[car.uid] then
			local def = CarConfig.ById[car.typeId]
			total = total + CarConfig.SellPrice(def, car.level)
			n = n + 1
			table.remove(d.cars, i)
		end
	end
	if n == 0 then
		return
	end
	d.money = math.min(d.money + total, EconomyConfig.MaxMoney)
	d.stats.sold = (d.stats.sold or 0) + n
	S.Data.Notify(player, "soldMany", { n, total }, "good")
	finish(player)
end

-- best-earning cars take the bays (cars mid-animation keep theirs); no checks, used after throws too
function Cars.ParkBest(s, includeBenched)
	local d = s.data
	local list = {}
	for _, c in ipairs(d.cars) do
		if includeBenched then
			c.benched = nil
		end
		if not s.hidden[c.uid] and not c.benched then
			table.insert(list, c)
		end
	end
	table.sort(list, function(a, b)
		local ia = CarConfig.CarIncome(a)
		local ib = CarConfig.CarIncome(b)
		if ia ~= ib then
			return ia &gt; ib
		end
		return a.uid &lt; b.uid
	end)
	local reserved = {}
	for _, c in ipairs(d.cars) do
		if s.hidden[c.uid] and c.parkedSlot then
			reserved[c.parkedSlot] = true
		end
	end
	local free = {}
	for i = 1, d.garageSlotCount do
		if not reserved[i] then
			table.insert(free, i)
		end
	end
	for i, c in ipairs(list) do
		c.parkedSlot = free[i]
	end
end

function Cars.AutoPark(player)
	local s = S.Data.Get(player)
	if not s or not s.ready then
		return
	end
	if not S.Data.RateLimit(player, "autopark", 1) then
		return
	end
	if not S.Base.IsNearOwnBase(player) then
		S.Data.Notify(player, "tooFar", nil, "warn")
		return
	end
	Cars.ParkBest(s, true)
	S.Data.Notify(player, "autoParked", nil, "good")
	finish(player)
end

return Cars
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX32"><Properties><string name="Name">DataService</string><ProtectedString name="Source">local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared:WaitForChild("Util"))
local Net = require(Shared:WaitForChild("Net"))
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))
local ShopConfig = require(Shared:WaitForChild("ShopConfig"))
local TuningConfig = require(Shared:WaitForChild("TuningConfig"))
local SkinConfig = require(Shared:WaitForChild("SkinConfig"))

local DataService = {}
local S

local STORE_NAME = "CarHunters_Profiles_v1"
local SCHEMA_VERSION = 5 -- v5: tutorial has 8 steps (unlock the Highway)
local LOCK_TIMEOUT = 120
local SERVER_ID = (game.JobId ~= "" and game.JobId) or ("studio-" .. HttpService:GenerateGUID(false))

local store = nil
local sessions = {}

local function newProfile(isNew)
	local p = {
		schemaVersion = SCHEMA_VERSION,
		money = 0,
		parts = (function()
			local t = {}
			for id in pairs(PartConfig.Parts) do
				t[id] = 0
			end
			return t
		end)(),
		unlockedZones = { city = true },
		garageSlotCount = EconomyConfig.StartSlots,
		floors = 1,
		cars = {},
		stats = { throws = 0, upgrades = 0, deaths = 0, sold = 0 },
		discovered = {},
		pity = 0,
		saveCount = 0,
		lastSeen = 0,
		tutorial = 0,
		daily = { day = 0, last = 0 },
		play = { day = 0, sec = 0, chests = { false, false, false, false, false } }, -- today's playtime + opened playtime chests (saved: rejoining does not reset them)
		settings = DataService.SanitizeSettings(nil), -- volumes + on/off switches (Settings panel)
		perks = {},
		boosts = {},
		receipts = {},
		contracts = {},
		tuning = {},
		rebirths = 0,
		tokens = 0,
		tokenPerks = {},
		skins = { classic = true },
		skin = "classic",
	}
	if isNew then
		for id, n in pairs(EconomyConfig.StarterParts) do
			p.parts[id] = n
		end
	end
	return p
end

local function toCount(v, maxV)
	if type(v) == "number" and v == v and v &gt;= 0 and v ~= math.huge then
		return math.min(math.floor(v), maxV)
	end
	return 0
end

local function sanitize(raw)
	if type(raw) ~= "table" then
		return newProfile(true)
	end
	local p = newProfile(false)

	p.money = math.min(toCount(raw.money, EconomyConfig.MaxMoney), EconomyConfig.MaxMoney)
	if type(raw.parts) == "table" then
		for id in pairs(PartConfig.Parts) do
			p.parts[id] = toCount(raw.parts[id], 1e6)
		end
	end
	if type(raw.unlockedZones) == "table" then
		for _, id in ipairs(require(Shared.MapConfig).ZoneOrder) do
			if raw.unlockedZones[id] == true then
				p.unlockedZones[id] = true
			end
		end
	end
	p.unlockedZones.city = true
	local slots = toCount(raw.garageSlotCount, EconomyConfig.MaxSlots)
	p.garageSlotCount = Util.Clamp(slots, EconomyConfig.StartSlots, EconomyConfig.MaxSlots)
	-- v4: multi-storey garage, 6 bays per floor (old profiles get the floors their bays need)
	local floors = toCount(raw.floors, EconomyConfig.MaxFloors)
	p.floors = Util.Clamp(math.max(floors, math.ceil(p.garageSlotCount / 6)), 1, EconomyConfig.MaxFloors)

	local seenUid, seenSlot = {}, {}
	if type(raw.cars) == "table" then
		for _, c in ipairs(raw.cars) do
			if #p.cars &gt;= EconomyConfig.MaxCars then
				break
			end
			if type(c) == "table" and CarConfig.LegacyIds[c.typeId] then
				c.typeId = CarConfig.LegacyIds[c.typeId]
			end
			if type(c) == "table" and type(c.uid) == "string" and #c.uid &gt;= 8 and #c.uid &lt;= 64
				and not seenUid[c.uid] and CarConfig.ById[c.typeId] then
				seenUid[c.uid] = true
				local level = Util.Clamp(toCount(c.level, CarConfig.MaxLevel), 1, CarConfig.MaxLevel)
				local slot = nil
				if Util.IsInt(c.parkedSlot) and c.parkedSlot &gt;= 1 and c.parkedSlot &lt;= p.garageSlotCount and not seenSlot[c.parkedSlot] then
					slot = c.parkedSlot
					seenSlot[slot] = true
				end
				local tune = {}
				if type(c.tune) == "table" then
					for cat, itemId in pairs(c.tune) do
						local it = TuningConfig.Items[itemId]
						if it and it.cat == cat then
							tune[cat] = itemId
						end
					end
				end
				table.insert(p.cars, { uid = c.uid, typeId = c.typeId, level = level, parkedSlot = slot, tune = tune, benched = c.benched == true or nil })
			end
		end
	end
	if type(raw.stats) == "table" then
		p.stats.throws = toCount(raw.stats.throws, 1e9)
		p.stats.upgrades = toCount(raw.stats.upgrades, 1e9)
		p.stats.deaths = toCount(raw.stats.deaths, 1e9)
		p.stats.sold = toCount(raw.stats.sold, 1e9)
	end
	if type(raw.discovered) == "table" then
		for rawId, v in pairs(raw.discovered) do
			local id = CarConfig.LegacyIds[rawId] or rawId
			if v == true and CarConfig.ById[id] then
				p.discovered[id] = true
			end
		end
	end
	for _, c in ipairs(p.cars) do
		p.discovered[c.typeId] = true
	end
	p.pity = math.min(toCount(raw.pity, 1e6), EconomyConfig.PityThreshold)
	p.stats.contracts = type(raw.stats) == "table" and toCount(raw.stats.contracts, 1e9) or 0
	if type(raw.perks) == "table" then
		for _, def in ipairs(ShopConfig.Perks) do
			local v = toCount(raw.perks[def.id], def.max)
			if v &gt; 0 then
				p.perks[def.id] = v
			end
		end
	end
	if type(raw.boosts) == "table" then
		for _, id in ipairs({ "income", "luck" }) do
			local t = toCount(raw.boosts[id], 4e9)
			if t &gt; os.time() then
				p.boosts[id] = t
			end
		end
	end
	if type(raw.receipts) == "table" then
		for _, r in ipairs(raw.receipts) do
			if type(r) == "string" and #r &lt;= 80 and #p.receipts &lt; 100 then
				table.insert(p.receipts, r)
			end
		end
	end
	local KINDS = { bank_part = true, combo = true, speed = true, throw = true, road = true, hotdrop = true }
	if type(raw.contracts) == "table" then
		for _, c in ipairs(raw.contracts) do
			if #p.contracts &lt; 3 and type(c) == "table" and KINDS[c.kind] and type(c.reward) == "table"
				and PartConfig.Parts[c.reward.part] and Util.IsInt(c.n) and c.n &gt;= 1 and c.n &lt;= 20 then
				table.insert(p.contracts, {
					id = tostring(c.id), kind = c.kind, progress = math.min(toCount(c.progress, 20), c.n), n = c.n,
					part = PartConfig.Parts[c.part] and c.part or nil, zone = type(c.zone) == "string" and c.zone or nil,
					mult = tonumber(c.mult), seconds = tonumber(c.seconds), ready = c.ready == true or nil,
					reward = { money = toCount(c.reward.money, 1e12), part = c.reward.part, n = math.clamp(toCount(c.reward.n, 4), 1, 4) },
				})
			end
		end
	end
	if type(raw.tuning) == "table" then
		for id, n in pairs(raw.tuning) do
			if TuningConfig.Items[id] then
				local v = toCount(n, 999)
				if v &gt; 0 then
					p.tuning[id] = v
				end
			end
		end
	end
	p.rebirths = toCount(raw.rebirths, 1000)
	p.tokens = toCount(raw.tokens, 1e6)
	if type(raw.tokenPerks) == "table" then
		for _, def in ipairs(SkinConfig.TokenPerks) do
			local v = toCount(raw.tokenPerks[def.id], def.max)
			if v &gt; 0 then
				p.tokenPerks[def.id] = v
			end
		end
	end
	if type(raw.skins) == "table" then
		for id, v in pairs(raw.skins) do
			if v == true and SkinConfig.ById[id] then
				p.skins[id] = true
			end
		end
	end
	if type(raw.skin) == "string" and SkinConfig.ById[raw.skin] then
		p.skin = raw.skin
	end
	p.saveCount = toCount(raw.saveCount, 1e12)
	p.lastSeen = toCount(raw.lastSeen, 4e9)
	p.tutorial = toCount(raw.tutorial, 9)
	if (tonumber(raw.schemaVersion) or 0) &lt; 5 and p.tutorial &gt;= 8 then
		p.tutorial = 9 -- finished the old 7-step tutorial: no new step, no second reward
	end
	p.settings = DataService.SanitizeSettings(raw.settings)
	if type(raw.play) == "table" then
		-- dense array of booleans (a sparse table would not save in a DataStore)
		local chests = { false, false, false, false, false }
		if type(raw.play.chests) == "table" then
			for i = 1, 5 do
				chests[i] = raw.play.chests[i] == true or raw.play.chests[tostring(i)] == true
			end
		end
		p.play = { day = toCount(raw.play.day, 1e7), sec = toCount(raw.play.sec, 86400), chests = chests }
	end
	if type(raw.daily) == "table" then
		p.daily = { day = math.clamp(toCount(raw.daily.day, 7), 0, 7), last = toCount(raw.daily.last, 1e6) }
	end
	if raw.tutorial == nil and p.stats.throws &gt; 0 then
		p.tutorial = 9 -- players from before the tutorial existed
	end
	return p
end
DataService.Sanitize = sanitize

local function keyFor(userId)
	return "P_" .. tostring(userId)
end

local function acquire(userId)
	local key = keyFor(userId)
	local lastErr = "unknown"
	for attempt = 1, 5 do
		local lockedByOther = false
		local loaded = nil
		local ok, err = pcall(function()
			store:UpdateAsync(key, function(old)
				lockedByOther = false
				loaded = nil
				if type(old) == "table" then
					local lock = old.lock
					if type(lock) == "table" and lock.id ~= SERVER_ID and os.time() - (tonumber(lock.time) or 0) &lt; LOCK_TIMEOUT then
						lockedByOther = true
						return nil
					end
					loaded = old.data
					old.lock = { id = SERVER_ID, time = os.time() }
					return old
				end
				return { lock = { id = SERVER_ID, time = os.time() } }
			end)
		end)
		if ok then
			if lockedByOther then
				lastErr = "locked"
				task.wait(6)
			else
				return true, loaded
			end
		else
			lastErr = tostring(err)
			if RunService:IsStudio() then
				return false, "studio"
			end
			task.wait(math.min(2 ^ attempt, 8))
		end
	end
	return false, lastErr
end

function DataService.Init(hub)
	S = hub
end

function DataService.Start()
	local ok, res = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = res
	else
		warn("[CarHunters] DataStore unavailable:", res)
	end
	task.spawn(function()
		while true do
			task.wait(EconomyConfig.AutosaveInterval)
			for player, s in pairs(sessions) do
				if s.ready and not s.ephemeral and not s.saving then
					task.spawn(DataService.Save, player, false)
				end
			end
		end
	end)
end

function DataService.Get(player)
	return sessions[player]
end

function DataService.GetRoot(player)
	local char = player.Character
	if not char then
		return nil
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if hum and hum.Health &gt; 0 and hrp then
		return hrp, hum
	end
	return nil
end

function DataService.Notify(player, key, args, kind)
	if player.Parent then
		Net.Get("Notify"):FireClient(player, { key = key, args = args or {}, kind = kind or "info" })
	end
end

function DataService.RateLimit(player, key, interval)
	local s = sessions[player]
	if not s then
		return false
	end
	local now = os.clock()
	if now - (s.rl[key] or 0) &lt; interval then
		return false
	end
	s.rl[key] = now
	return true
end

function DataService.Load(player)
	local s = {
		player = player, ready = false, carried = {}, hidden = {}, rl = {}, income = 0, collectionValue = 0,
		moneyFrac = 0, busy = false, protectedUntil = 0, lastHit = 0, baseIndex = nil, joinedAt = os.clock(), chests = {},
		ephemeral = false, loadFailed = false, playMark = os.clock(),
	}
	sessions[player] = s

	if not store then
		s.ephemeral = true
		s.data = newProfile(true)
		DataService.Notify(player, "studioNoSave", nil, "warn")
		return s
	end

	local ok, raw = acquire(player.UserId)
	if ok then
		s.data = sanitize(raw)
		s.locked = true
	elseif raw == "locked" then
		sessions[player] = nil
		player:Kick("Your data is open on another server. Please rejoin in a minute.")
		return nil
	elseif raw == "studio" then
		s.ephemeral = true
		s.data = newProfile(true)
		DataService.Notify(player, "studioNoSave", nil, "warn")
	else
		-- live game: never let anyone play on a profile that cannot be saved (all progress would be lost)
		warn("[CarHunters] Profile load failed for", player.Name, raw)
		sessions[player] = nil
		player:Kick("Roblox could not load your save right now. Please rejoin in a minute - your progress is safe.")
		return nil
	end
	return s
end

-- today's playtime in seconds (rolls over at 00:00 UTC: new day = new chests)
function DataService.PlayTime(s)
	local d = s.data
	local today = math.floor(os.time() / 86400)
	local now = os.clock()
	if type(d.play) ~= "table" or d.play.day ~= today then
		d.play = { day = today, sec = 0, chests = { false, false, false, false, false } } -- time since the last mark still counts for the new day
	end
	d.play.sec = d.play.sec + (now - (s.playMark or now))
	s.playMark = now
	return d.play.sec
end

local function snapshot(s, mergeCarried)
	DataService.PlayTime(s) -- fold the running playtime into the saved number
	local d = Util.CopyTable(s.data)
	if mergeCarried then
		for id, n in pairs(s.carried) do
			d.parts[id] = (d.parts[id] or 0) + n
		end
	end
	d.schemaVersion = SCHEMA_VERSION
	d.saveCount = (d.saveCount or 0) + 1
	d.lastSeen = os.time()
	return d
end

function DataService.Save(player, release)
	local s = sessions[player]
	if not s or not s.data or s.ephemeral or not store or not s.locked then
		return false
	end
	local waited = 0
	while s.saving and waited &lt; 10 do
		task.wait(0.1)
		waited = waited + 0.1
	end
	s.saving = true
	-- carried loot is saved as banked on every save, so a server crash never loses it
	local snap = snapshot(s, true)
	local key = keyFor(player.UserId)
	local success, stolen = false, false
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			store:UpdateAsync(key, function(old)
				stolen = false
				if type(old) == "table" and type(old.lock) == "table" and old.lock.id ~= SERVER_ID
					and os.time() - (tonumber(old.lock.time) or 0) &lt; LOCK_TIMEOUT then
					stolen = true -- another server owns this profile now: writing would overwrite its progress
					return nil
				end
				local out = { data = snap }
				if not release then
					out.lock = { id = SERVER_ID, time = os.time() }
				end
				return out
			end)
		end)
		if ok and not stolen then
			success = true
			break
		elseif ok and stolen then
			break
		end
		warn("[CarHunters] Save failed (" .. attempt .. "):", err)
		task.wait(2 ^ attempt)
	end
	s.saving = false
	if success then
		s.data.saveCount = snap.saveCount
		s.lastSaved = os.time()
	elseif stolen then
		warn("[CarHunters] Profile of", player.Name, "is locked by another server - this session stops saving")
		s.locked = false
		if player.Parent and not release then
			player:Kick("Your save was opened on another server. Please rejoin.")
		end
	end
	return success
end

function DataService.SaveAll()
	local pending = 0
	for player, s in pairs(sessions) do
		if s.ready and not s.ephemeral then
			pending = pending + 1
			task.spawn(function()
				DataService.Save(player, true)
				pending = pending - 1
			end)
		end
	end
	local t = 0
	while pending &gt; 0 and t &lt; 25 do
		task.wait(0.2)
		t = t + 0.2
	end
end

function DataService.Unload(player)
	sessions[player] = nil
end

function DataService.BuildState(s)
	local d = s.data
	local cars = {}
	for _, c in ipairs(d.cars) do
		table.insert(cars, { uid = c.uid, typeId = c.typeId, level = c.level, slot = c.parkedSlot, tune = Util.CopyTable(c.tune or {}) })
	end
	return {
		money = d.money,
		parts = Util.CopyTable(d.parts),
		carried = Util.CopyTable(s.carried),
		carryCap = S.Shop.CarryCap(s),
		zones = Util.CopyTable(d.unlockedZones),
		slots = d.garageSlotCount,
		floors = d.floors,
		cars = cars,
		stats = Util.CopyTable(d.stats),
		baseIndex = s.baseIndex,
		income = s.income,
		collectionValue = s.collectionValue,
		ephemeral = s.ephemeral,
		discovered = Util.CopyTable(d.discovered),
		pity = d.pity,
		indexMult = s.indexMult or 1,
		perks = Util.CopyTable(d.perks),
		boosts = { income = math.max(0, (d.boosts.income or 0) - os.time()), luck = math.max(0, (d.boosts.luck or 0) - os.time()) },
		passes = Util.CopyTable(s.passes or {}),
		contracts = Util.CopyTable(d.contracts),
		tuning = Util.CopyTable(d.tuning),
		tutorial = d.tutorial,
		settings = Util.CopyTable(d.settings or DataService.SanitizeSettings(nil)),
		daily = { day = d.daily.day, last = d.daily.last, today = math.floor(os.time() / 86400) },
		chests = Util.CopyTable(d.play and d.play.chests or {}),
		sessionTime = DataService.PlayTime(s), -- today's playtime
		rebirths = d.rebirths,
		tokens = d.tokens,
		tokenPerks = Util.CopyTable(d.tokenPerks),
		skins = Util.CopyTable(d.skins),
		skin = d.skin,
		walkSpeed = S.Shop.WalkSpeed(s),
		pickupRadius = S.Shop.PickupRadius(s),
		airbagIn = S.Shop.AirbagReadyIn(s),
		run = { picked = s.run and s.run.picked or 0, mult = s.run and s.run.mult or 1, firstAt = s.run and s.run.firstAt, risk = s.run and s.run.risk or 1 },
	}
end

-- player settings (Settings panel): volumes 0..1 and on/off switches; anything unknown is dropped
local SETTING_FLAGS = { "markers", "notes", "shake", "fov", "guide" }
function DataService.SanitizeSettings(raw)
	raw = type(raw) == "table" and raw or {}
	local function vol(v, def)
		v = tonumber(v)
		if not v or v ~= v then
			return def
		end
		return math.clamp(math.floor(v * 100 + 0.5) / 100, 0, 1)
	end
	local out = { music = vol(raw.music, 0.5), sfx = vol(raw.sfx, 0.8) }
	for _, k in ipairs(SETTING_FLAGS) do
		out[k] = raw[k] ~= false
	end
	return out
end

function DataService.SaveSettings(player, t)
	local s = sessions[player]
	if not s or not s.ready or type(t) ~= "table" or not DataService.RateLimit(player, "settings", 0.5) then
		return
	end
	s.data.settings = DataService.SanitizeSettings(t) -- saved with the next autosave; no state push needed
end

-- tutorial progress: only moves forward; finishing (not skipping) pays a small reward once
DataService.TutorialSteps = 8
function DataService.Tutorial(player, step)
	local s = sessions[player]
	if not s or not s.ready or not DataService.RateLimit(player, "tut", 0.3) then
		return
	end
	local d = s.data
	if step == "skip" then
		d.tutorial = DataService.TutorialSteps + 1
	elseif type(step) == "number" and step % 1 == 0 and step &gt; d.tutorial and step &lt;= DataService.TutorialSteps + 1 then
		local finished = step == DataService.TutorialSteps + 1 and d.tutorial &lt; step
		d.tutorial = step
		if finished then
			d.money = math.min(d.money + 500, EconomyConfig.MaxMoney)
			DataService.Notify(player, "tutDone", { 500 }, "good")
		end
	else
		return
	end
	DataService.Push(player)
end

function DataService.Push(player)
	local s = sessions[player]
	if not s or s.pushQueued then
		return
	end
	s.pushQueued = true
	task.defer(function()
		s.pushQueued = false
		if player.Parent and s.data then
			Net.Get("StateUpdate"):FireClient(player, DataService.BuildState(s))
		end
	end)
end

return DataService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX33"><Properties><string name="Name">IncomeService</string><ProtectedString name="Source">local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local Util = require(Shared:WaitForChild("Util"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))

local Income = {}
local S

function Income.Init(hub)
	S = hub
end

function Income.CreateLeaderstats(player)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local inc = Instance.new("IntValue")
	inc.Name = "Income"
	inc.Parent = ls
	local col = Instance.new("IntValue")
	col.Name = "Collection"
	col.Parent = ls
	ls.Parent = player
end

function Income.Recalc(player)
	local s = S.Data.Get(player)
	if not s or not s.data then
		return
	end
	local inc, value = 0, 0
	for _, c in ipairs(s.data.cars) do
		local def = CarConfig.ById[c.typeId]
		if def then
			value = value + CarConfig.ValueAt(def, c.level)
			if c.parkedSlot then
				inc = inc + CarConfig.CarIncome(c)
			end
		end
	end
	local _, _, _, mult = CarConfig.IndexStats(s.data.discovered or {})
	s.indexMult = mult
	s.income = math.floor(inc * mult * S.Shop.IncomeMult(s) * S.Rebirth.IncomeMult(s) + 0.5)
	s.collectionValue = value
	local ls = player:FindFirstChild("leaderstats")
	if ls then
		ls.Income.Value = math.min(inc, 2e9)
		ls.Collection.Value = math.min(value, 2e9)
	end
	S.Base.SetIncomeText(player, "+" .. Util.FormatNumber(s.income) .. "/s")
end

-- offline earnings: a share of income for the time away (capped), paid once on join
Income.OfflineShare = 0.15
Income.OfflineCap = 8 * 3600
function Income.PayOffline(player)
	local s = S.Data.Get(player)
	local d = s and s.data
	if not d or (d.lastSeen or 0) &lt;= 0 then
		return
	end
	local away = os.time() - d.lastSeen
	if away &lt; 120 then
		return
	end
	local secs = math.min(away, Income.OfflineCap)
	local amount = math.floor(secs * (s.income or 0) * Income.OfflineShare)
	if amount &lt;= 0 then
		return
	end
	d.money = math.min(d.money + amount, EconomyConfig.MaxMoney)
	s.offline = { amount = amount, seconds = secs, doubled = false }
	Net.Get("OfflineEarnings"):FireClient(player, { amount = amount, seconds = away, capped = away &gt; Income.OfflineCap })
end

function Income.Start()
	local last = os.clock()
	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.clock()
			local dt = now - last
			last = now
			for _, player in ipairs(Players:GetPlayers()) do
				local s = S.Data.Get(player)
				if s and s.ready then
					s.moneyFrac = s.moneyFrac + s.income * dt
					local whole = math.floor(s.moneyFrac)
					if whole &gt; 0 then
						s.moneyFrac = s.moneyFrac - whole
						s.data.money = math.min(s.data.money + whole, EconomyConfig.MaxMoney)
					end
					Net.Get("MoneySync"):FireClient(player, s.data.money, s.income, s.collectionValue)
				end
			end
		end
	end)
end

return Income
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX34"><Properties><string name="Name">InventoryService</string><ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))
local Net = require(Shared:WaitForChild("Net"))

local Inv = {}
local S

function Inv.Init(hub)
	S = hub
end

function Inv.CarriedTotal(s)
	local n = 0
	for _, v in pairs(s.carried) do
		n = n + v
	end
	return n
end

function Inv.BankedTotal(s)
	local n = 0
	for _, v in pairs(s.data.parts) do
		n = n + v
	end
	return n
end

-- combo tiers: parts picked up in one run without going home
Inv.ComboTiers = { { 7, 3 }, { 4, 2 }, { 2, 1.5 } }
Inv.SpeedBonusSeconds = 40

local function comboMult(picked)
	for _, t in ipairs(Inv.ComboTiers) do
		if picked &gt;= t[1] then
			return t[2]
		end
	end
	return 1
end
Inv.ComboMult = comboMult

-- zone = district the part came from (contracts), force = ignore the backpack limit (hot drops)
function Inv.AddCarried(player, partId, n, zone, force)
	local s = S.Data.Get(player)
	if not s or not s.ready or not PartConfig.Parts[partId] then
		return false
	end
	if not force and Inv.CarriedTotal(s) + n &gt; S.Shop.CarryCap(s) then
		return false
	end
	s.carried[partId] = (s.carried[partId] or 0) + n
	s.carriedZones = s.carriedZones or {}
	s.carriedZones[partId] = s.carriedZones[partId] or {}
	if zone then
		s.carriedZones[partId][zone] = (s.carriedZones[partId][zone] or 0) + n
	end
	s.run = s.run or { picked = 0, mult = 1 }
	if s.run.picked == 0 then
		s.run.firstAt = workspace:GetServerTimeNow()
		s.run.firstClock = os.clock()
	end
	s.run.picked = s.run.picked + n
	s.run.mult = comboMult(s.run.picked)
	S.Data.Push(player)
	return true
end

function Inv.Bank(player)
	local s = S.Data.Get(player)
	if not s or not s.ready then
		return false
	end
	local run = s.run or { picked = 0, mult = 1 }
	local mult = (run.mult or 1) * (run.risk or 1) -- combo x checkpoint risk multiplier
	local moved, bonus = 0, 0
	local rng = Random.new()
	local banked = {}
	for id, n in pairs(s.carried) do
		if n &gt; 0 then
			local extra = math.floor(n * (mult - 1))
			if rng:NextNumber() &lt; n * (mult - 1) - extra then
				extra = extra + 1
			end
			s.data.parts[id] = (s.data.parts[id] or 0) + n + extra
			banked[id] = n
			moved = moved + n
			bonus = bonus + extra
		end
	end
	local zones = s.carriedZones or {}
	s.carried = {}
	s.carriedZones = {}
	s.run = { picked = 0, mult = 1 }
	if moved &gt; 0 then
		local secs = run.firstClock and (os.clock() - run.firstClock) or 999
		local cash = 0
		if secs &lt;= Inv.SpeedBonusSeconds then
			cash = math.max(200, math.floor((s.income or 0) * 15))
			s.data.money = math.min(s.data.money + cash, EconomyConfig.MaxMoney)
		end
		S.Data.Notify(player, "banked2", { moved, bonus, mult, cash }, "good")
		Net.Get("BankFx"):FireClient(player, { moved = moved, bonus = bonus, mult = mult, cash = cash, parts = banked })
		S.Contracts.Progress(player, "bank_part", moved, zones)
		if mult &gt; 1 then
			S.Contracts.Progress(player, "combo", mult)
		end
		S.Contracts.Progress(player, "speed", secs)
		S.Data.Push(player)
	end
	return moved &gt; 0
end

function Inv.HasBanked(s, partId, n)
	return (s.data.parts[partId] or 0) &gt;= n
end

function Inv.SpendBanked(player, partId, n)
	local s = S.Data.Get(player)
	if not s or n &lt;= 0 or (s.data.parts[partId] or 0) &lt; n then
		return false
	end
	s.data.parts[partId] = s.data.parts[partId] - n
	return true
end

function Inv.OnDeath(player)
	local s = S.Data.Get(player)
	if not s or not s.ready then
		return
	end
	s.data.stats.deaths = s.data.stats.deaths + 1
	local lost, lostTable = 0, {}
	for id, n in pairs(s.carried) do
		local l = math.floor(n * EconomyConfig.DeathLossFraction + 0.5)
		if l &gt; 0 then
			s.carried[id] = n - l
			lost = lost + l
			lostTable[id] = l
		end
	end
	s.carriedZones = {}
	s.run = { picked = 0, mult = 1 }
	if lost &gt; 0 then
		s.lastLost = lostTable -- the "Insurance" product can give it back
		S.Data.Notify(player, "lost", { lost }, "error")
	end
	S.Data.Push(player)
end

function Inv.EnsureNotStuck(player)
	local s = S.Data.Get(player)
	if not s or not s.ready then
		return
	end
	local anyCar = #s.data.cars &gt; 0
	if Inv.BankedTotal(s) + Inv.CarriedTotal(s) == 0 and not anyCar and s.data.money &lt; 50 then
		s.data.parts.bolts = (s.data.parts.bolts or 0) + 1
		S.Data.Notify(player, "starter", nil, "good")
		S.Data.Push(player)
	end
end

function Inv.Start()
	task.spawn(function()
		while true do
			task.wait(0.5)
			for _, player in ipairs(Players:GetPlayers()) do
				local s = S.Data.Get(player)
				if s and s.ready and Inv.CarriedTotal(s) &gt; 0 then
					local hrp = S.Data.GetRoot(player)
					if hrp and hrp.Position.Z &lt; MapConfig.PlazaEndZ then
						Inv.Bank(player)
					end
				end
			end
		end
	end)
end

return Inv
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX35"><Properties><string name="Name">PartSpawnService</string><ProtectedString name="Source">local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared:WaitForChild("Util"))
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local TuningConfig = require(Shared:WaitForChild("TuningConfig"))
local PartVisual = require(Shared:WaitForChild("PartVisual"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))
local Net = require(Shared:WaitForChild("Net"))

local PartSpawn = {}
local S
local points = {}
local rng = Random.new()
local drops

function PartSpawn.Init(hub)
	S = hub
end

function PartSpawn.Amount(pt)
	local n = PartConfig.CrateAmount[pt.risk]
	if not n then
		return 1
	end
	local z = MapConfig.Zones[pt.zone]
	return PartConfig.CrateAmountTier[z and z.tier or 1] or n
end

local function cooldownFor(risk)
	local c = PartConfig.Cooldowns[risk] or PartConfig.Cooldowns.safe
	return c[1] + rng:NextNumber() * (c[2] - c[1])
end

local function spawnAt(pt)
	local zoneTables = PartConfig.SpawnTables[pt.zone]
	local entries = zoneTables and zoneTables[pt.risk]
	if not entries then
		return
	end
	local partId = Util.WeightedPick(entries, rng:NextNumber())
	local model = PartVisual.Build(partId)
	model:PivotTo(CFrame.new(pt.pos + Vector3.new(0, 3.6, 0))) -- glow ring stays &gt;= 0.3 above the ground at the bob minimum
	model:SetAttribute("PointId", pt.id)
	model:SetAttribute("Risk", pt.risk)
	model:SetAttribute("Amount", PartSpawn.Amount(pt))
	CollectionService:AddTag(model, "SpinBob")
	model.Parent = drops
	pt.model = model
	pt.partId = partId
	pt.active = true
end

function PartSpawn.Start()
	drops = Workspace:FindFirstChild("RuntimeDrops")
	if not drops then
		drops = Instance.new("Folder")
		drops.Name = "RuntimeDrops"
		drops.Parent = Workspace
	end
	local map = Workspace:WaitForChild("GeneratedMap")
	local folder = map:WaitForChild("PartSpawnPoints")
	for _, inst in ipairs(folder:GetDescendants()) do
		if inst:IsA("BasePart") and inst:GetAttribute("ZoneId") then
			table.insert(points, {
				id = inst:GetFullName(), pos = inst.Position, zone = inst:GetAttribute("ZoneId"),
				risk = inst:GetAttribute("Risk") or "safe", active = false, readyAt = 0,
			})
		end
	end
	local now = os.clock()
	for _, pt in ipairs(points) do
		pt.readyAt = now + rng:NextNumber() * 5
	end

	local acc = 0
	local warnedAt = {}
	RunService.Heartbeat:Connect(function(dt)
		acc = acc + dt
		if acc &lt; EconomyConfig.PickupCheckInterval then
			return
		end
		acc = 0
		local t = os.clock()
		for _, pt in ipairs(points) do
			if not pt.active and t &gt;= pt.readyAt then
				spawnAt(pt)
			end
		end
		for _, player in ipairs(Players:GetPlayers()) do
			local s = S.Data.Get(player)
			local r = s and S.Shop.PickupRadius(s) or EconomyConfig.PickupRadius
			local r2 = r * r
			if s and s.ready then
				local hrp = S.Data.GetRoot(player)
				if hrp then
					local pos = hrp.Position
					for _, pt in ipairs(points) do
						if pt.active then
							local d = pt.pos - pos
							if d.X * d.X + d.Z * d.Z &lt;= r2 and math.abs(d.Y) &lt; 12 then
								local amount = PartSpawn.Amount(pt)
								if S.Inventory.CarriedTotal(s) + amount &gt; S.Shop.CarryCap(s) then
									if t - (warnedAt[player] or 0) &gt; 3 then
										warnedAt[player] = t
										S.Data.Notify(player, "carryFull", nil, "warn")
									end
								else
									pt.active = false
									local partId = pt.partId
									if pt.model then
										pt.model:Destroy()
										pt.model = nil
									end
									pt.readyAt = t + cooldownFor(pt.risk)
									local td = PartConfig.TuningDrops[pt.zone]
									if td and math.random() &lt; td.chance then
										-- bonus: a tuning part goes straight to the player's tuning box
										local fams = { "ecu", "turbo", "super", "exhaust", "intake", "nitro", "tires", "aero" }
										local item = fams[math.random(1, #fams)] .. td.stages[math.random(1, #td.stages)]
										S.Tuning.Give(player, item, 1)
										S.Data.Notify(player, "tuneDrop", { TuningConfig.Items[item].name }, "good")
									end
									if S.Inventory.AddCarried(player, partId, amount, pt.zone) then
										S.Data.Notify(player, "picked", { partId }, "pickup")
										Net.Get("PickupFx"):FireClient(player, { partId = partId, amount = amount, pos = pt.pos, risk = pt.risk })
										if pt.risk == "road" then
											S.Contracts.Progress(player, "road", 1)
										end
									end
								end
							end
						end
					end
				end
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(p)
		warnedAt[p] = nil
	end)
end

function PartSpawn.PointCount()
	return #points
end

return PartSpawn
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX36"><Properties><string name="Name">TrafficService</string><ProtectedString name="Source">local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local Net = require(Shared:WaitForChild("Net"))
local TrafficMath = require(Shared:WaitForChild("TrafficMath"))
local VehicleKinds = require(Shared:WaitForChild("VehicleKinds"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))

local Traffic = {}
local S

function Traffic.Init(hub)
	S = hub
end

-- Returns the lane whose car overlaps pos at time t (margin widens the hitbox).
function Traffic.HitTest(pos, t, roadIdx, margin)
	margin = margin or 0
	local groundY = MapConfig.RoadTopY
	for _, lane in ipairs(TrafficMath.RoadLanes[roadIdx]) do
		if math.abs(pos.Z - lane.z) &lt; 7 + (lane.weaveA or 0) + 24 + margin then
			for k = 1, lane.count do
				local kind = VehicleKinds[lane.kinds[k]]
				local dz = math.abs(pos.Z - TrafficMath.CarZ(lane, k, t))
				local x = TrafficMath.CarX(lane, k, t)
				if math.abs(pos.X - x) &lt;= kind.L / 2 + 1.0 + margin and dz &lt;= kind.W / 2 + 1.0 + margin and pos.Y &lt; groundY + kind.H + 2.5 then
					return lane
				end
			end
		end
	end
	return nil
end

-- Instant death: one touch = WRECKED, carried loot of this run is lost (InventoryService.OnDeath).
local function wreck(player, s, hum, lane)
	s.lastHit = os.clock()
	if S.Shop.TryAirbag(s) then
		-- airbag pops: knocked back, shielded for a moment, loot kept
		s.protectedUntil = os.clock() + 1.5
		Net.Get("HitFx"):FireClient(player, Vector3.new(lane and lane.dir or 1, 0, 0), "airbag")
		S.Data.Push(player)
		return
	end
	Net.Get("HitFx"):FireClient(player, Vector3.new(lane and lane.dir or 1, 0, 0), "wrecked")
	hum.Health = 0
end

local function eligible(player)
	local s = S.Data.Get(player)
	local now = os.clock()
	if s and s.ready and now &gt; s.protectedUntil and now - s.lastHit &gt;= EconomyConfig.HitCooldown then
		local hrp, hum = S.Data.GetRoot(player)
		if hrp then
			local pos = hrp.Position
			local ri = TrafficMath.RoadAtZ(pos.Z, 3)
			if ri and math.abs(pos.X) &lt;= MapConfig.MapHalfWidth + 6 then
				return s, hum, pos, ri
			end
		end
	end
	return nil
end

function Traffic.Start()
	-- client reports what it saw; server re-checks the recent past with a small tolerance
	Net.Get("TrafficHit").OnServerEvent:Connect(function(player)
		local s, hum, pos, ri = eligible(player)
		if not s then
			return
		end
		local t = Workspace:GetServerTimeNow()
		for back = 0, 0.5, 0.1 do
			local lane = Traffic.HitTest(pos, t - back, ri, 2.5)
			if lane then
				wreck(player, s, hum, lane)
				return
			end
		end
	end)
	-- authoritative fallback
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc = acc + dt
		if acc &lt; EconomyConfig.TrafficTickRate then
			return
		end
		acc = 0
		local t = Workspace:GetServerTimeNow()
		for _, player in ipairs(Players:GetPlayers()) do
			local s, hum, pos, ri = eligible(player)
			if s then
				local lane = Traffic.HitTest(pos, t, ri, 0)
				if lane then
					wreck(player, s, hum, lane)
				end
			end
		end
	end)
end

-- shared instant death for bosses, rivers, etc. (airbag still applies)
function Traffic.Wreck(player, dirX)
	local s = S.Data.Get(player)
	local _, hum = S.Data.GetRoot(player)
	local now = os.clock()
	if s and s.ready and hum and hum.Health &gt; 0 and now &gt; s.protectedUntil and now - s.lastHit &gt;= EconomyConfig.HitCooldown then
		wreck(player, s, hum, { dir = dirX or 1 })
		return true
	end
	return false
end

function Traffic.Protect(player, seconds)
	local s = S.Data.Get(player)
	if s then
		s.protectedUntil = math.max(s.protectedUntil, os.clock() + seconds)
	end
end

return Traffic
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX37"><Properties><string name="Name">UpgradeService</string><ProtectedString name="Source">local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared:WaitForChild("Util"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))

local Upgrade = {}
local S

function Upgrade.Init(hub)
	S = hub
end

function Upgrade.UpgradeCar(player, uid, expectedLevel)
	if type(uid) ~= "string" or #uid &gt; 64 or not Util.IsInt(expectedLevel) then
		return
	end
	local s = S.Data.Get(player)
	if not s or not s.ready then
		return
	end
	if not S.Data.RateLimit(player, "upgrade", 0.25) then
		return
	end
	if not S.Base.IsNearOwnBase(player) then
		S.Data.Notify(player, "tooFar", nil, "warn")
		return
	end
	local d = s.data
	local car = S.Cars.Find(d, uid)
	if not car then
		return
	end
	if car.level ~= expectedLevel then
		S.Data.Notify(player, "stale", nil, "warn")
		S.Data.Push(player)
		return
	end
	local def = CarConfig.ById[car.typeId]
	if car.level &gt;= def.maxLevel then
		S.Data.Notify(player, "maxLevel", nil, "warn")
		return
	end
	local cost = CarConfig.UpgradeCost(def, car.level)
	local partId, amount = CarConfig.UpgradeParts(def, car.level)
	if d.money &lt; cost then
		S.Data.Notify(player, "noMoney", nil, "error")
		return
	end
	if (d.parts[partId] or 0) &lt; amount then
		S.Data.Notify(player, "noParts", nil, "error")
		return
	end
	d.money = d.money - cost
	d.parts[partId] = d.parts[partId] - amount
	car.level = car.level + 1
	d.stats.upgrades = d.stats.upgrades + 1
	S.Data.Notify(player, "upgraded", { car.level }, "good")
	S.Base.RefreshAll(player)
	S.Income.Recalc(player)
	S.Data.Push(player)
end

function Upgrade.BuySlot(player, expectedCount)
	if not Util.IsInt(expectedCount) then
		return
	end
	local s = S.Data.Get(player)
	if not s or not s.ready then
		return
	end
	if not S.Data.RateLimit(player, "slot", 0.4) then
		return
	end
	if not S.Base.IsNearOwnBase(player) then
		S.Data.Notify(player, "tooFar", nil, "warn")
		return
	end
	local d = s.data
	if d.garageSlotCount ~= expectedCount then
		S.Data.Notify(player, "stale", nil, "warn")
		S.Data.Push(player)
		return
	end
	local nextSlot = d.garageSlotCount + 1
	local cost = EconomyConfig.SlotCosts[nextSlot]
	if not cost or nextSlot &gt; EconomyConfig.MaxSlots then
		return
	end
	if nextSlot &gt; d.floors * 6 then
		S.Data.Notify(player, "needFloor", nil, "warn")
		return
	end
	if d.money &lt; cost then
		S.Data.Notify(player, "noMoney", nil, "error")
		return
	end
	d.money = d.money - cost
	d.garageSlotCount = nextSlot
	S.Data.Notify(player, "slotBought", { nextSlot }, "good")
	S.Base.RefreshAll(player)
	S.Data.Push(player)
end

function Upgrade.BuyFloor(player, expectedFloors)
	if not Util.IsInt(expectedFloors) then
		return
	end
	local s = S.Data.Get(player)
	if not s or not s.ready or not S.Data.RateLimit(player, "floor", 0.5) then
		return
	end
	if not S.Base.IsNearOwnBase(player) then
		S.Data.Notify(player, "tooFar", nil, "warn")
		return
	end
	local d = s.data
	if d.floors ~= expectedFloors then
		S.Data.Push(player)
		return
	end
	local nextFloor = d.floors + 1
	local cost = EconomyConfig.FloorCosts[nextFloor]
	if not cost then
		return
	end
	if d.garageSlotCount &lt; d.floors * 6 then
		S.Data.Notify(player, "fillFloor", nil, "warn")
		return
	end
	if d.money &lt; cost then
		S.Data.Notify(player, "noMoney", nil, "error")
		return
	end
	d.money = d.money - cost
	d.floors = nextFloor
	S.Data.Notify(player, "floorBuilt", { nextFloor }, "good")
	S.Base.RefreshAll(player)
	S.Data.Push(player)
end

return Upgrade
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX38"><Properties><string name="Name">ZoneService</string><ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))

local Zone = {}
local S

function Zone.Init(hub)
	S = hub
end

function Zone.IsUnlocked(s, zoneId)
	return zoneId == "plaza" or s.data.unlockedZones[zoneId] == true
end

function Zone.Unlock(player, zoneId)
	if type(zoneId) ~= "string" or not MapConfig.Zones[zoneId] then
		return
	end
	local s = S.Data.Get(player)
	if not s or not s.ready then
		return
	end
	if not S.Data.RateLimit(player, "zone", 0.5) then
		return
	end
	local d = s.data
	if d.unlockedZones[zoneId] then
		return
	end
	local idx = MapConfig.ZoneIndex(zoneId)
	local prev = MapConfig.ZoneOrder[idx - 1]
	if not prev or not d.unlockedZones[prev] then
		S.Data.Notify(player, "needPrev", nil, "warn")
		return
	end
	local req = EconomyConfig.ZoneUnlock[zoneId]
	if not req then
		return
	end
	if (d.rebirths or 0) &lt; (req.rebirths or 0) then
		S.Data.Notify(player, "needRebirth", { req.rebirths }, "warn")
		return
	end
	if s.collectionValue &lt; req.minValue then
		S.Data.Notify(player, "needValue", nil, "warn")
		return
	end
	if d.money &lt; req.cost then
		S.Data.Notify(player, "noMoney", nil, "error")
		return
	end
	d.money = d.money - req.cost
	d.unlockedZones[zoneId] = true
	S.Data.Notify(player, "zoneUnlocked", { MapConfig.Zones[zoneId].name }, "good")
	S.Data.Push(player)
end

function Zone.Start()
	-- rivers etc.: touching a kill zone = wrecked (airbag can save you, then you respawn at the bank)
	local CollectionService = game:GetService("CollectionService")
	local function hookKill(part)
		part.Touched:Connect(function(hit)
			local player = Players:GetPlayerFromCharacter(hit.Parent)
			if player and S.Traffic.Wreck(player, 0) then
				return
			end
			local hum = hit.Parent and hit.Parent:FindFirstChildOfClass("Humanoid")
			if player and hum and hum.Health &gt; 0 then
				-- airbag fired: pop the player back onto the nearest bank
				local hrp = hit.Parent:FindFirstChild("HumanoidRootPart")
				if hrp then
					local z = hrp.Position.Z
					local r = MapConfig.River
					local bank = (math.abs(z - r.z1) &lt; math.abs(z - r.z2)) and r.z1 - 6 or r.z2 + 6
					hrp.CFrame = CFrame.new(hrp.Position.X, 4, bank)
				end
			end
		end)
	end
	for _, p in ipairs(CollectionService:GetTagged("KillZone")) do
		hookKill(p)
	end
	CollectionService:GetInstanceAddedSignal("KillZone"):Connect(hookKill)
	task.spawn(function()
		while true do
			task.wait(0.25)
			for _, player in ipairs(Players:GetPlayers()) do
				local s = S.Data.Get(player)
				if s and s.ready then
					local hrp = S.Data.GetRoot(player)
					if hrp then
						local zone = MapConfig.ZoneAt(hrp.Position.Z)
						if not Zone.IsUnlocked(s, zone) then
							local gate = MapConfig.GateOfZone(zone)
							local p = hrp.Position
							hrp.CFrame = CFrame.new(p.X, p.Y + 1, gate.z - 14)
							hrp.AssemblyLinearVelocity = Vector3.zero
							S.Data.Notify(player, "zoneLocked", nil, "warn")
						end
					end
				end
			end
		end
	end)
end

return Zone
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX247DE5E26D184DF69E905CB5E947820C"><Properties><string name="Name">BossService</string><ProtectedString name="Source">-- Arena bosses: a monster truck per arena hunts the nearest player. Touch = WRECKED.
-- Players scare it by throwing their cheapest part: 1st hit stuns it, 2nd hit makes it flee for a while.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local SV = require(Shared:WaitForChild("SpecialVehicles"))

local Boss = {}
local S
local bosses = {}

Boss.Stats = {
	crusher = { speed = 34, turn = 1.5, accel = 22 },
	juggernaut = { speed = 44, turn = 1.7, accel = 28 },
	titan = { speed = 52, turn = 1.9, accel = 34, jump = true },
}
Boss.ThrowRange = 80
Boss.HitsToScare = 2
Boss.StunTime = 2.2
Boss.FleeTime = 25

function Boss.Init(hub)
	S = hub
end

local function inArena(b, pos)
	return math.abs(pos.X - b.center.X) &lt; b.halfX and math.abs(pos.Z - b.center.Z) &lt; b.halfZ
end

-- cheapest part the player owns: carried loot first, then the garage stash
local function cheapestPart(s)
	for _, id in ipairs(PartConfig.Order) do
		if (s.carried[id] or 0) &gt; 0 then
			return id, "carried"
		end
	end
	for _, id in ipairs(PartConfig.Order) do
		if (s.data.parts[id] or 0) &gt; 0 then
			return id, "banked"
		end
	end
	return nil
end
Boss.CheapestPart = cheapestPart

local function setMode(b, mode, dur)
	b.mode = mode
	b.modeUntil = os.clock() + (dur or 0)
	b.model:SetAttribute("Mode", mode)
	b.model:SetAttribute("Hits", b.hits)
end

local function pickTarget(b)
	local best, bestD
	for _, p in ipairs(Players:GetPlayers()) do
		local hrp, hum = S.Data.GetRoot(p)
		if hrp and hum and hum.Health &gt; 0 and inArena(b, hrp.Position) then
			local d = (hrp.Position - b.pos).Magnitude
			if not bestD or d &lt; bestD then
				best, bestD = p, d
			end
		end
	end
	return best
end

local function steer(b, dt, goal, speedMul)
	local st = b.stats
	local to = goal - b.pos
	to = Vector3.new(to.X, 0, to.Z)
	local want = to.Magnitude &gt; 0.1 and math.atan2(-to.X, -to.Z) or b.yaw
	-- push away from cover so the truck drives around containers/rocks/columns
	for _, c in ipairs(b.covers) do
		local d = Vector3.new(b.pos.X - c.p.X, 0, b.pos.Z - c.p.Z)
		local m = d.Magnitude
		if m &lt; c.r + b.halfW + 6 and m &gt; 0.01 then
			local away = math.atan2(-d.X, -d.Z)
			want = want + math.clamp(((away - want + math.pi) % (2 * math.pi)) - math.pi, -0.8, 0.8)
		end
	end
	local diff = ((want - b.yaw + math.pi) % (2 * math.pi)) - math.pi
	b.yaw = b.yaw + math.clamp(diff, -st.turn * dt, st.turn * dt)
	local target = st.speed * speedMul * (1 - math.min(0.6, math.abs(diff) / math.pi)) -- slows in tight turns
	b.speed = b.speed + math.clamp(target - b.speed, -st.accel * 2 * dt, st.accel * dt)
	local fwd = Vector3.new(-math.sin(b.yaw), 0, -math.cos(b.yaw))
	local np = b.pos + fwd * b.speed * dt
	np = Vector3.new(math.clamp(np.X, b.center.X - b.halfX + b.halfW, b.center.X + b.halfX - b.halfW), 0,
		math.clamp(np.Z, b.center.Z - b.halfZ + b.halfL, b.center.Z + b.halfZ - b.halfL))
	b.pos = np
end

local function hitPlayers(b)
	if b.mode == "stun" or b.mode == "flee" or b.speed &lt; 6 then
		return
	end
	local cf = CFrame.new(b.pos) * CFrame.Angles(0, b.yaw + math.pi / 2, 0) -- local +X = forward
	for _, p in ipairs(Players:GetPlayers()) do
		local hrp = S.Data.GetRoot(p)
		if hrp and hrp.Position.Y &lt; b.height + 3 then
			local lp = cf:PointToObjectSpace(hrp.Position)
			if math.abs(lp.X) &lt; b.halfL + 1.5 and math.abs(lp.Z) &lt; b.halfW + 1.5 then
				local dirX = math.sign(cf.LookVector.X)
				if S.Traffic.Wreck(p, dirX ~= 0 and dirX or 1) then
					Net.Get("BossFx"):FireAllClients({ event = "smash", boss = b.id, pos = hrp.Position })
				end
			end
		end
	end
end

local function update(b, dt)
	local now = os.clock()
	if (b.mode == "stun" or b.mode == "flee") and now &gt; b.modeUntil then
		b.hits = 0
		setMode(b, "roam")
	end
	if b.mode == "stun" then
		b.speed = math.max(0, b.speed - 60 * dt)
	elseif b.mode == "flee" then
		-- run to the far end of the arena and sulk there
		steer(b, dt, b.center + Vector3.new(0, 0, b.halfZ - b.halfL - 4), 0.8)
	else
		local target = pickTarget(b)
		if target then
			local hrp = S.Data.GetRoot(target)
			b.target = target
			if b.mode ~= "chase" then
				setMode(b, "chase")
			end
			-- aim a little ahead of the player
			local lead = hrp.AssemblyLinearVelocity * 0.35
			steer(b, dt, hrp.Position + Vector3.new(lead.X, 0, lead.Z), 1)
		else
			b.target = nil
			if b.mode ~= "roam" then
				setMode(b, "roam")
			end
			if not b.wander or (b.wander - b.pos).Magnitude &lt; 12 then
				b.wander = b.center + Vector3.new(b.rng:NextNumber(-1, 1) * b.halfX * 0.7, 0, b.rng:NextNumber(-1, 1) * b.halfZ * 0.7)
			end
			steer(b, dt, b.wander, 0.45)
		end
	end
	local hop = 0
	if b.stats.jump and b.mode == "chase" then
		local ph = (now % 7) / 7
		if ph &gt; 0.85 then
			hop = math.sin((ph - 0.85) / 0.15 * math.pi) * 9
		end
	end
	b.model:PivotTo(CFrame.new(b.pos + Vector3.new(0, hop, 0)) * CFrame.Angles(0, b.yaw + math.pi / 2, 0))
	if hop &lt; 2 then
		hitPlayers(b)
	end
end

function Boss.Throw(player)
	local s = S.Data.Get(player)
	if not s or not s.ready or not S.Data.RateLimit(player, "bossThrow", 0.9) then
		return
	end
	local hrp = S.Data.GetRoot(player)
	if not hrp then
		return
	end
	local b
	for _, bb in pairs(bosses) do
		if inArena(bb, hrp.Position) and (bb.pos - hrp.Position).Magnitude &lt; Boss.ThrowRange then
			b = bb
		end
	end
	if not b or b.mode == "flee" then
		return
	end
	local partId, from = cheapestPart(s)
	if not partId then
		S.Data.Notify(player, "nothingToThrow", nil, "warn")
		return
	end
	if from == "carried" then
		s.carried[partId] = s.carried[partId] - 1
		if s.carried[partId] &lt;= 0 then
			s.carried[partId] = nil
		end
	else
		s.data.parts[partId] = s.data.parts[partId] - 1
	end
	b.hits = b.hits + 1
	b.helpers[player] = true
	Net.Get("BossFx"):FireAllClients({ event = "throw", boss = b.id, from = hrp.Position, to = b.pos, part = partId, hits = b.hits })
	if b.hits &gt;= Boss.HitsToScare then
		setMode(b, "flee", Boss.FleeTime)
		Net.Get("BossFx"):FireAllClients({ event = "flee", boss = b.id, pos = b.pos })
		-- everyone who helped gets a tuning part from this arena's drop table
		local td = PartConfig.TuningDrops[b.zone]
		for p in pairs(b.helpers) do
			if p.Parent and td then
				local fams = { "ecu", "turbo", "super", "exhaust", "intake", "nitro", "tires", "aero" }
				local item = fams[math.random(1, #fams)] .. td.stages[math.random(1, #td.stages)]
				S.Tuning.Give(p, item, 1)
				S.Data.Notify(p, "bossScared", { require(Shared:WaitForChild("TuningConfig")).Items[item].name }, "good")
			end
		end
		b.helpers = {}
	else
		setMode(b, "stun", Boss.StunTime)
		S.Data.Notify(player, "bossStunned", nil, "good")
	end
	S.Data.Push(player)
end

function Boss.Start()
	task.spawn(function()
		local map = Workspace:WaitForChild("GeneratedMap", 60)
		if not map then
			return
		end
		task.wait(1)
		local folder = Instance.new("Folder")
		folder.Name = "Bosses"
		folder.Parent = Workspace
		for _, c in ipairs(CollectionService:GetTagged("Arena")) do
			local look = c:GetAttribute("Boss") or "crusher"
			local model = SV.MonsterTruck(look)
			model.Name = "Boss_" .. look
			local b = {
				id = look, zone = c:GetAttribute("ZoneId"), model = model, stats = Boss.Stats[look] or Boss.Stats.crusher,
				center = Vector3.new(c.Position.X, 0, c.Position.Z), halfX = c:GetAttribute("HalfX"), halfZ = c:GetAttribute("HalfZ"),
				halfL = model:GetAttribute("HalfL"), halfW = model:GetAttribute("HalfW"), height = model:GetAttribute("Height"),
				yaw = 0, speed = 0, hits = 0, mode = "roam", modeUntil = 0, helpers = {}, covers = {}, rng = Random.new(),
			}
			b.pos = b.center + Vector3.new(0, 0, b.halfZ * 0.5)
			for _, part in ipairs(map:GetDescendants()) do
				if part:IsA("BasePart") and (part.Name == "ScrapContainer" or part.Name == "CanyonRock" or part.Name == "Column") and inArena(b, part.Position) then
					table.insert(b.covers, { p = part.Position, r = math.max(part.Size.X, part.Size.Z) / 2 })
				end
			end
			model:SetAttribute("ZoneId", b.zone)
			model:SetAttribute("BossId", look)
			setMode(b, "roam")
			model:PivotTo(CFrame.new(b.pos))
			model.Parent = folder
			bosses[look] = b
		end
		RunService.Heartbeat:Connect(function(dt)
			dt = math.min(dt, 0.1)
			for _, b in pairs(bosses) do
				update(b, dt)
			end
		end)
	end)
end

return Boss
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX91BE90466D514E358E4B9949AA2952DF"><Properties><string name="Name">CheckpointService</string><ProtectedString name="Source">-- District checkpoints: at the far end of every district a player carrying loot chooses
--   SAVE &amp; GO HOME  -&gt; loot is banked right here and the player is teleported to the garage
--   RISK IT         -&gt; teleported to the start of the next district (must be unlocked); loot stays at risk,
--                      the run's risk multiplier grows by +0.5 (applied when the loot is finally banked).
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local BaseLayout = require(Shared:WaitForChild("BaseLayout"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))

local CP = {}
local S
local pads = {}
CP.RiskStep = 0.5
CP.MaxRisk = 4

function CP.Init(hub)
	S = hub
end

local function nextZone(zid)
	local i = MapConfig.ZoneIndex(zid)
	return MapConfig.ZoneOrder[i + 1]
end

local function offer(player, pad)
	local s = S.Data.Get(player)
	if not s or not s.ready or S.Inventory.CarriedTotal(s) &lt;= 0 then
		return
	end
	local zid = pad:GetAttribute("ZoneId")
	local now = os.clock()
	if s.checkpoint and s.checkpoint.zone == zid and now - s.checkpoint.at &lt; 6 then
		return
	end
	local nz = nextZone(zid)
	local open = nz ~= nil and S.Zone.IsUnlocked(s, nz)
	local req = nz and EconomyConfig.ZoneUnlock[nz]
	s.checkpoint = { zone = zid, at = now, pad = pad }
	local risk = (s.run and s.run.risk) or 1
	Net.Get("CheckpointOffer"):FireClient(player, {
		zone = zid, nextZone = nz, nextOpen = open, price = req and req.cost or nil,
		carried = S.Inventory.CarriedTotal(s), combo = (s.run and s.run.mult) or 1,
		risk = risk, nextRisk = math.min(CP.MaxRisk, risk + CP.RiskStep),
	})
end

function CP.Choose(player, choice)
	local s = S.Data.Get(player)
	local cp = s and s.checkpoint
	if not cp or not s.ready or (choice ~= "save" and choice ~= "risk") then
		return
	end
	s.checkpoint = nil
	local hrp = S.Data.GetRoot(player)
	if not hrp or (hrp.Position - cp.pad.Position).Magnitude &gt; 60 or os.clock() - cp.at &gt; 60 then
		return
	end
	if S.Inventory.CarriedTotal(s) &lt;= 0 then
		return
	end
	if choice == "save" then
		S.Inventory.Bank(player)
		local target = BaseLayout.ToWorld(s.baseIndex, BaseLayout.SpawnLocal) + Vector3.new(0, 4, 0)
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.CFrame = CFrame.new(target, target + Vector3.new(0, 0, 1))
		S.Traffic.Protect(player, 1.5)
		Net.Get("CheckpointFx"):FireClient(player, { choice = "save" })
	else
		local nz = nextZone(cp.zone)
		if not nz or not S.Zone.IsUnlocked(s, nz) then
			S.Data.Notify(player, "zoneLocked", nil, "warn")
			return
		end
		s.run = s.run or { picked = 0, mult = 1 }
		s.run.risk = math.min(CP.MaxRisk, (s.run.risk or 1) + CP.RiskStep)
		local target = MapConfig.ZoneSpawn(nz) + Vector3.new(math.random(-6, 6), 0, 0)
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.CFrame = CFrame.new(target, target + Vector3.new(0, 0, 1))
		S.Traffic.Protect(player, 2.5)
		S.Data.Notify(player, "riskOn", { s.run.risk, MapConfig.Zones[nz].name }, "warn")
		Net.Get("CheckpointFx"):FireClient(player, { choice = "risk", risk = s.run.risk, zone = nz })
		S.Data.Push(player)
	end
end

function CP.Start()
	task.spawn(function()
		local map = workspace:WaitForChild("GeneratedMap", 60)
		if not map then
			return
		end
		local function hook(pad)
			if pads[pad] then
				return
			end
			pads[pad] = true
			pad.Touched:Connect(function(hit)
				local player = Players:GetPlayerFromCharacter(hit.Parent)
				if player then
					offer(player, pad)
				end
			end)
		end
		for _, pad in ipairs(CollectionService:GetTagged("Checkpoint")) do
			hook(pad)
		end
		CollectionService:GetInstanceAddedSignal("Checkpoint"):Connect(hook)
	end)
end

return CP
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX79658CABACC448BF80EF537F8329A956"><Properties><string name="Name">ContractService</string><ProtectedString name="Source">-- Contracts board: three active jobs per player. Finished jobs wait as "ready" until claimed at Big Tony.
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared:WaitForChild("Util"))
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))

local Contracts = {}
local S
local rng = Random.new()

Contracts.Active = 3

-- part types each district is known for (bank_part contracts ask for these)
local ZONE_PARTS = {
	city = { "bolts", "tire" }, highway = { "tire", "engine" }, industrial = { "engine", "turbo" }, neon = { "turbo", "core" },
}
for _, z in ipairs(MapConfig.ZoneOrder) do
	ZONE_PARTS[z] = ZONE_PARTS[z] or { "turbo", "core" }
end

function Contracts.Init(hub)
	S = hub
end

local function bestZoneIndex(d)
	local idx = 1
	for i, z in ipairs(MapConfig.ZoneOrder) do
		if d.unlockedZones[z] then
			idx = i
		end
	end
	return idx
end

local function rewardFor(s, weight)
	local base = math.max(150, (s.income or 0) * 25) * weight
	local d = s.data
	local partPool = { "tire", "engine", "turbo", "core" }
	local tier = math.clamp(bestZoneIndex(d), 1, 4) -- core is the top reward from the Night district on
	return { money = math.floor(base / 10 + 0.5) * 10, part = partPool[tier], n = (weight &gt;= 2) and 2 or 1 }
end

function Contracts.New(s)
	local d = s.data
	local zi = bestZoneIndex(d)
	local zone = MapConfig.ZoneOrder[rng:NextInteger(1, zi)]
	local kinds = { "bank_part", "bank_part", "combo", "speed", "throw", "road", "hotdrop" }
	local kind = kinds[rng:NextInteger(1, #kinds)]
	-- avoid duplicate kinds on the board
	for _ = 1, 6 do
		local dup = false
		for _, c in ipairs(d.contracts) do
			if c.kind == kind then
				dup = true
			end
		end
		if not dup then
			break
		end
		kind = kinds[rng:NextInteger(1, #kinds)]
	end
	local c = { id = HttpService:GenerateGUID(false), kind = kind, progress = 0 }
	if kind == "bank_part" then
		local pool = ZONE_PARTS[zone]
		c.part = pool[rng:NextInteger(1, #pool)]
		c.zone = zone
		c.n = (c.part == "core") and 1 or rng:NextInteger(2, 4)
		c.reward = rewardFor(s, 1 + c.n * 0.3)
	elseif kind == "combo" then
		c.n = 1
		c.mult = (zi &gt;= 2) and 2 or 1.5
		c.reward = rewardFor(s, 1.6)
	elseif kind == "speed" then
		c.n = 1
		c.seconds = 40
		c.reward = rewardFor(s, 1.4)
	elseif kind == "throw" then
		c.n = rng:NextInteger(3, 6)
		c.reward = rewardFor(s, 1 + c.n * 0.15)
	elseif kind == "road" then
		c.n = rng:NextInteger(1, 3)
		c.reward = rewardFor(s, 1.3 + c.n * 0.4)
	else
		c.n = 1
		c.reward = rewardFor(s, 2.5)
	end
	return c
end

function Contracts.Fill(s)
	local d = s.data
	while #d.contracts &lt; Contracts.Active do
		table.insert(d.contracts, Contracts.New(s))
	end
end

-- paid out by MechanicService when the player talks to Big Tony
-- quiet = the caller sends one combined notification (claiming several contracts at once)
function Contracts.Reward(player, s, c, index, quiet)
	local d = s.data
	local mult = S.Shop.HasPass(s, "double_contracts") and 2 or 1
	d.money = math.min(d.money + c.reward.money * mult, EconomyConfig.MaxMoney)
	d.parts[c.reward.part] = (d.parts[c.reward.part] or 0) + c.reward.n * mult
	d.stats.contracts = (d.stats.contracts or 0) + 1
	table.remove(d.contracts, index)
	if not quiet then
		S.Data.Notify(player, "contractDone", { Util.FormatNumber(c.reward.money * mult) }, "good")
		S.Data.Push(player)
	end
	task.delay(3, function()
		if player.Parent and S.Data.Get(player) == s then
			Contracts.Fill(s)
			S.Data.Push(player)
		end
	end)
	return c.reward.money * mult
end

-- event: "bank_part"(partId, n, zoneCounts) | "combo"(mult) | "speed"(seconds) | "throw" | "road" | "hotdrop"
function Contracts.Progress(player, event, amount, extra)
	local s = S.Data.Get(player)
	if not s or not s.ready then
		return
	end
	local d = s.data
	local changed = false
	local nowReady = 0
	for i = #d.contracts, 1, -1 do
		local c = d.contracts[i]
		local add = 0
		if c.kind == event then
			if event == "bank_part" then
				-- extra = { [partId] = { [zone] = n } }
				local byZone = extra and extra[c.part]
				add = byZone and (byZone[c.zone] or 0) or 0
			elseif event == "combo" then
				add = (amount &gt;= c.mult) and 1 or 0
			elseif event == "speed" then
				add = (amount &lt;= c.seconds) and 1 or 0
			else
				add = amount or 1
			end
		end
		if add &gt; 0 and not c.ready then
			c.progress = math.min(c.n, c.progress + add)
			changed = true
			if c.progress &gt;= c.n then
				c.ready = true
				nowReady = nowReady + 1
			end
		end
	end
	if nowReady &gt; 0 then -- one message, not one per contract
		S.Data.Notify(player, "contractReady", nil, "good")
	end
	if changed then
		S.Data.Push(player)
	end
end

function Contracts.Start()
	Players.PlayerAdded:Connect(function(p)
		task.delay(2, function()
			local s = S.Data.Get(p)
			if s and s.data then
				Contracts.Fill(s)
				S.Data.Push(p)
			end
		end)
	end)
	for _, p in ipairs(Players:GetPlayers()) do
		local s = S.Data.Get(p)
		if s and s.data then
			Contracts.Fill(s)
		end
	end
end

return Contracts
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXFC9903D350014915B0FFC46C02949341"><Properties><string name="Name">DonateService</string><ProtectedString name="Source">-- Golden Magnate stall: developer products + game passes, with idempotent receipt processing.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local MarketplaceService = game:GetService("MarketplaceService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DonateConfig = require(Shared:WaitForChild("DonateConfig"))
local ProductIds = require(Shared:WaitForChild("ProductIds"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))
local Net = require(Shared:WaitForChild("Net"))

local Donate = {}
local S
local byProductId, byPassId = {}, {}

function Donate.Init(hub)
	S = hub
	for key, id in pairs(ProductIds.products) do
		if id and id &gt; 0 then
			byProductId[id] = key
		end
	end
	for key, id in pairs(ProductIds.passes) do
		if id and id &gt; 0 then
			byPassId[id] = key
		end
	end
end

local function hasReceipt(d, rid)
	for _, r in ipairs(d.receipts) do
		if r == rid then
			return true
		end
	end
	return false
end

local function remember(d, rid)
	table.insert(d.receipts, rid)
	while #d.receipts &gt; 100 do
		table.remove(d.receipts, 1)
	end
end

local function grantGoldenCar(player, s)
	local d = s.data
	for _, c in ipairs(d.cars) do
		if c.typeId == "golden_magnat_gt" then
			return
		end
	end
	table.insert(d.cars, { uid = HttpService:GenerateGUID(false), typeId = "golden_magnat_gt", level = 1, parkedSlot = nil })
	d.discovered.golden_magnat_gt = true
	S.Cars.AutoPark(player)
end

-- applies one product; returns true when granted
function Donate.Grant(player, key)
	local s = S.Data.Get(player)
	local item = DonateConfig.ById[key]
	if not s or not s.ready or not item then
		return false
	end
	local d = s.data
	if item.boost then
		local now = os.time()
		d.boosts[item.boost] = math.max(d.boosts[item.boost] or 0, now) + item.seconds
	elseif item.cash then
		local amount = math.max(item.cash[2], math.floor((s.income or 0) * item.cash[1]))
		d.money = math.min(d.money + amount, EconomyConfig.MaxMoney)
	elseif item.parts then
		for id, n in pairs(item.parts) do
			d.parts[id] = (d.parts[id] or 0) + n
		end
	elseif item.slots then
		local before = d.garageSlotCount
		d.garageSlotCount = math.min(d.floors * 6, before + item.slots)
		local missing = item.slots - (d.garageSlotCount - before)
		if missing &gt; 0 then -- already maxed: pay it out instead
			d.money = math.min(d.money + missing * math.max(50000, (s.income or 0) * 600), EconomyConfig.MaxMoney)
		end
	elseif key == "offline_x2" then
		local off = s.offline
		if off and not off.doubled then
			off.doubled = true
			d.money = math.min(d.money + off.amount, EconomyConfig.MaxMoney)
		else
			d.money = math.min(d.money + math.max(5000, (s.income or 0) * 600), EconomyConfig.MaxMoney)
		end
	elseif key == "pity" then
		d.pity = math.max(d.pity, EconomyConfig.PityThreshold - 1)
	elseif key == "hotdrop" then
		S.HotDrop.SpawnFor(player)
	elseif key == "revive" then
		local lost = s.lastLost
		if lost then
			for id, n in pairs(lost) do
				d.parts[id] = (d.parts[id] or 0) + n
			end
			s.lastLost = nil
		else
			d.parts.engine = (d.parts.engine or 0) + 2 -- nothing to restore: small consolation crate
		end
	end
	S.Income.Recalc(player)
	S.Base.RefreshAll(player)
	S.Data.Notify(player, "donateThanks", { item.name }, "good")
	Net.Get("DonateFx"):FireAllClients(player, key)
	S.Data.Push(player)
	return true
end

local function processReceipt(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	local key = byProductId[info.ProductId]
	if not player or not key then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local s = S.Data.Get(player)
	if not s or not s.ready then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local d = s.data
	if hasReceipt(d, info.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	if not Donate.Grant(player, key) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	remember(d, info.PurchaseId)
	if s.ephemeral then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	-- the receipt id is in the profile: a retry after a failed save will not grant twice
	if S.Data.Save(player, false) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

local function refreshPasses(player)
	local s = S.Data.Get(player)
	if not s then
		return
	end
	s.passes = s.passes or {}
	for key, id in pairs(ProductIds.passes) do
		if id &gt; 0 and not s.passes[key] then
			local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, id)
			if ok and owns then
				s.passes[key] = true
			end
		end
	end
	if s.passes.golden_car then
		grantGoldenCar(player, s)
	end
	player:SetAttribute("VIP", s.passes.vip == true)
	S.Income.Recalc(player)
	S.Shop.ApplyCharacter(player)
	S.Data.Push(player)
end
Donate.RefreshPasses = refreshPasses

function Donate.Request(player, key)
	local item = type(key) == "string" and DonateConfig.ById[key]
	if not item or not S.Data.RateLimit(player, "donate", 1) then
		return
	end
	if item.random then
		local ok, info = pcall(function()
			return game:GetService("PolicyService"):GetPolicyInfoForPlayerAsync(player)
		end)
		if not ok or not info or info.ArePaidRandomItemsRestricted then
			S.Data.Notify(player, "donateOff", nil, "warn")
			return
		end
	end
	local id = item.isPass and ProductIds.passes[key] or ProductIds.products[key]
	if id and id &gt; 0 then
		if item.isPass then
			MarketplaceService:PromptGamePassPurchase(player, id)
		else
			MarketplaceService:PromptProductPurchase(player, id)
		end
	elseif RunService:IsStudio() then
		-- products are not created yet: simulate the purchase so everything can be tested in Studio
		local s = S.Data.Get(player)
		if item.isPass then
			if s then
				s.passes = s.passes or {}
				s.passes[key] = true
				refreshPasses(player)
				S.Data.Notify(player, "donateThanks", { item.name }, "good")
				Net.Get("DonateFx"):FireAllClients(player, key)
			end
		else
			Donate.Grant(player, key)
		end
	else
		S.Data.Notify(player, "donateOff", nil, "warn")
	end
end

function Donate.Start()
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, bought)
		local key = byPassId[passId]
		local s = S.Data.Get(player)
		if bought and key and s then
			s.passes = s.passes or {}
			s.passes[key] = true
			refreshPasses(player)
			S.Data.Notify(player, "donateThanks", { DonateConfig.ById[key].name }, "good")
			Net.Get("DonateFx"):FireAllClients(player, key)
		end
	end)
	-- boosts expire: keep income in sync
	task.spawn(function()
		while true do
			task.wait(5)
			local now = os.time()
			for _, player in ipairs(Players:GetPlayers()) do
				local s = S.Data.Get(player)
				if s and s.ready then
					local active = {}
					for id, t in pairs(s.data.boosts) do
						if t &gt; now then
							active[id] = true
						end
					end
					local sig = (active.income and "i" or "") .. (active.luck and "l" or "")
					if sig ~= (s.boostSig or "") then
						s.boostSig = sig
						S.Income.Recalc(player)
						S.Data.Push(player)
					end
				end
			end
		end
	end)
	task.spawn(function()
		local map = Workspace:WaitForChild("GeneratedMap", 60)
		local stall = map and map:FindFirstChild("MagnateStall", true)
		if not stall then
			return
		end
		local prompt = stall:FindFirstChild("DonatePrompt")
		if prompt then
			local pp = Instance.new("ProximityPrompt")
			pp.ActionText = "Shop"
			pp.ObjectText = "Golden Magnate"
			pp.HoldDuration = 0
			pp.MaxActivationDistance = 14
			pp.RequiresLineOfSight = false
			pp.Parent = prompt
		end
		local spot = stall:FindFirstChild("NpcSpot")
		if not spot then
			return
		end
		local GOLD = Color3.fromRGB(232, 178, 50)
		local npc, anims = S.Shop.MakeNpc("GoldenMagnate", {
			skin = Color3.fromRGB(240, 196, 160), arms = GOLD, torso = GOLD, legs = Color3.fromRGB(30, 30, 36),
		}, spot, function(n)
			local CYL = Enum.PartType.Cylinder
			local UP = CFrame.Angles(0, 0, math.pi / 2)
			S.Shop.Attach(n, "Head", Vector3.new(0.12, 1.8, 1.8), CFrame.new(0, 0.62, 0) * UP, Color3.fromRGB(20, 20, 24), Enum.Material.SmoothPlastic, CYL)
			S.Shop.Attach(n, "Head", Vector3.new(1.3, 1.15, 1.15), CFrame.new(0, 1.2, 0) * UP, Color3.fromRGB(20, 20, 24), Enum.Material.SmoothPlastic, CYL)
			S.Shop.Attach(n, "Head", Vector3.new(0.3, 1.18, 1.18), CFrame.new(0, 0.85, 0) * UP, GOLD, Enum.Material.Metal, CYL)
			S.Shop.Attach(n, "Head", Vector3.new(0.9, 0.2, 0.1), CFrame.new(0, -0.15, -0.6), Color3.fromRGB(240, 240, 240))
			S.Shop.Attach(n, "UpperTorso", Vector3.new(0.35, 0.35, 0.1), CFrame.new(0, 0.3, -0.55), Color3.fromRGB(200, 30, 40))
			local cane = S.Shop.Attach(n, "RightHand", Vector3.new(0.2, 3.4, 0.2), CFrame.new(0, -1.5, 0), Color3.fromRGB(30, 30, 34), Enum.Material.Metal)
			if cane then
				cane.Name = "Cane"
			end
			S.Shop.Attach(n, "RightHand", Vector3.new(0.5, 0.5, 0.5), CFrame.new(0, 0.2, 0), GOLD, Enum.Material.Metal, Enum.PartType.Ball)
		end)
		if npc then
			npc:SetAttribute("Magnate", true)
			-- the coin toss and sparkle are animated on the clients (MagnateFx); server just cheers now and then
			task.spawn(function()
				while npc.Parent do
					task.wait(9 + math.random() * 5)
					if anims and anims.wave then
						anims.wave:Play()
					end
				end
			end)
		end
	end)
	Players.PlayerAdded:Connect(function(p)
		task.delay(3, refreshPasses, p)
	end)
end

return Donate
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXF4D7DCF1D2184A0AB7799BD5AF947409"><Properties><string name="Name">HotDropService</string><ProtectedString name="Source">-- Hot Drop: every ~80 s a rare crate parachutes onto a dangerous spot. First player to grab it wins.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local MapConfig = require(Shared:WaitForChild("MapConfig"))

local HotDrop = {}
local S
local points = {}
local current = nil
local rng = Random.new()

HotDrop.Interval = { 70, 100 }
HotDrop.Lifetime = 45
HotDrop.FallTime = 4
HotDrop.EarlyWarning = 15

function HotDrop.Init(hub)
	S = hub
end

local function bestZone(player)
	local s = player and S.Data.Get(player)
	local best = "city"
	if s and s.data then
		for _, z in ipairs(MapConfig.ZoneOrder) do
			if s.data.unlockedZones[z] then
				best = z
			end
		end
	end
	return best
end

local function pickZone()
	local zones = {}
	for _, p in ipairs(Players:GetPlayers()) do
		table.insert(zones, bestZone(p))
	end
	if #zones == 0 then
		return nil
	end
	return zones[rng:NextInteger(1, #zones)]
end

local function pickPoint(zone)
	local list = {}
	for _, pt in ipairs(points) do
		if pt.zone == zone and pt.risk ~= "safe" then
			table.insert(list, pt)
		end
	end
	if #list == 0 then
		return nil
	end
	return list[rng:NextInteger(1, #list)]
end

local function crateModel(pos)
	local m = Instance.new("Model")
	m.Name = "HotDropCrate"
	local box = Instance.new("Part")
	box.Name = "Crate"
	box.Size = Vector3.new(4, 4, 4)
	box.Color = Color3.fromRGB(232, 178, 50)
	box.Material = Enum.Material.DiamondPlate
	box.Anchored, box.CanCollide, box.CanQuery, box.CanTouch = true, false, false, false
	box.CFrame = CFrame.new(pos + Vector3.new(0, 2.2, 0))
	box.Parent = m
	for _, a in ipairs({ 0, 90 }) do
		local band = Instance.new("Part")
		band.Name = "Band"
		band.Size = Vector3.new(4.1, 4.1, 0.6)
		band.Color = Color3.fromRGB(30, 30, 34)
		band.Material = Enum.Material.Metal
		band.Anchored, band.CanCollide, band.CanQuery, band.CanTouch = true, false, false, false
		band.CFrame = box.CFrame * CFrame.Angles(0, math.rad(a), 0)
		band.Parent = m
	end
	local smoke = Instance.new("Attachment")
	smoke.Name = "Smoke"
	smoke.Position = Vector3.new(0, 2.2, 0)
	smoke.Parent = box
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/smoke_main.dds"
	e.Color = ColorSequence.new(Color3.fromRGB(255, 120, 60), Color3.fromRGB(255, 60, 40))
	e.Size = NumberSequence.new(1.2, 5)
	e.Transparency = NumberSequence.new(0.2, 1)
	e.Lifetime = NumberRange.new(2.5, 3.5)
	e.Speed = NumberRange.new(5, 8)
	e.SpreadAngle = Vector2.new(10, 10)
	e.Rate = 14
	e.Acceleration = Vector3.new(0, 3, 0)
	e.Parent = smoke
	m.PrimaryPart = box
	return m
end

local function clear(reason, winner)
	if not current then
		return
	end
	if current.model then
		current.model:Destroy()
	end
	Net.Get("HotDrop"):FireAllClients({ kind = "end", id = current.id, reason = reason, winner = winner and winner.DisplayName })
	current = nil
end

local function launch(zone, byPlayer)
	if current then
		clear("replaced")
	end
	local pt = pickPoint(zone)
	if not pt then
		return
	end
	local now = Workspace:GetServerTimeNow()
	current = {
		id = tostring(math.floor(now * 1000)), pos = pt.pos, zone = zone,
		landAt = now + HotDrop.FallTime, expiresAt = now + HotDrop.FallTime + HotDrop.Lifetime,
	}
	local info = { kind = "start", id = current.id, pos = current.pos, zone = zone, landAt = current.landAt,
		expiresAt = current.expiresAt, by = byPlayer and byPlayer.DisplayName }
	Net.Get("HotDrop"):FireAllClients(info)
	task.delay(HotDrop.FallTime, function()
		if current and current.id == info.id then
			current.model = crateModel(current.pos)
			current.model.Parent = Workspace:FindFirstChild("RuntimeDrops") or Workspace
			current.landed = true
		end
	end)
end

function HotDrop.SpawnFor(player)
	launch(bestZone(player), player)
end

function HotDrop.Current()
	return current
end

function HotDrop.Start()
	local map = Workspace:WaitForChild("GeneratedMap")
	for _, inst in ipairs(map:WaitForChild("PartSpawnPoints"):GetDescendants()) do
		if inst:IsA("BasePart") and inst:GetAttribute("ZoneId") then
			table.insert(points, { pos = inst.Position, zone = inst:GetAttribute("ZoneId"), risk = inst:GetAttribute("Risk") or "safe" })
		end
	end
	-- scheduler with an early warning for scanner level 2 owners
	task.spawn(function()
		while true do
			local wait = rng:NextNumber(HotDrop.Interval[1], HotDrop.Interval[2])
			task.wait(wait - HotDrop.EarlyWarning)
			local zone = pickZone()
			if zone and not current then
				for _, p in ipairs(Players:GetPlayers()) do
					local s = S.Data.Get(p)
					if s and S.Shop.Level(s, "scanner") &gt;= 2 then
						Net.Get("HotDrop"):FireClient(p, { kind = "warn", zone = zone, inSeconds = HotDrop.EarlyWarning })
					end
				end
				task.wait(HotDrop.EarlyWarning)
				if not current then
					launch(zone)
				end
			else
				task.wait(HotDrop.EarlyWarning)
			end
		end
	end)
	RunService.Heartbeat:Connect(function()
		if not current then
			return
		end
		local now = Workspace:GetServerTimeNow()
		if now &gt; current.expiresAt then
			clear("expired")
			return
		end
		if not current.landed then
			return
		end
		for _, player in ipairs(Players:GetPlayers()) do
			local s = S.Data.Get(player)
			local hrp = s and s.ready and S.Data.GetRoot(player)
			if hrp then
				local d = hrp.Position - current.pos
				local r = S.Shop.PickupRadius(s) + 1
				if d.X * d.X + d.Z * d.Z &lt;= r * r and math.abs(d.Y) &lt; 12 then
					local partId = (rng:NextNumber() &lt; 0.45) and "core" or "turbo"
					local n = partId == "core" and 1 or 2
					local given = S.Inventory.AddCarried(player, partId, n, current.zone, true)
					if given then
						S.Data.Notify(player, "hotDropMine", { n, partId }, "good")
						S.Contracts.Progress(player, "hotdrop", 1)
						clear("taken", player)
						return
					end
				end
			end
		end
	end)
end

return HotDrop
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0752C18276B9457DB23EE12990452BA2"><Properties><string name="Name">LeaderboardService</string><ProtectedString name="Source">-- Plaza leaderboard: big screen with tabs (Income / Collection / Rebirths) that cycle every 8 s,
-- rank badges, avatar headshots, and the top 3 players standing as statues on the podium.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared:WaitForChild("Util"))

local LB = {}
local S
local C = Color3.fromRGB
local GOLD, SILVER, BRONZE = C(255, 200, 60), C(214, 220, 230), C(214, 140, 80)
local RANK_COLOR = { GOLD, SILVER, BRONZE }

LB.Tabs = {
	{ id = "income", title = "TOP INCOME", fmt = function(v) return "+$" .. Util.FormatNumber(v) .. "/s" end, value = function(s) return s.income or 0 end },
	{ id = "collection", title = "BIGGEST COLLECTION", fmt = function(v) return "$" .. Util.FormatNumber(v) end, value = function(s) return s.collectionValue or 0 end },
	{ id = "rebirths", title = "MOST REBIRTHS", fmt = function(v) return v .. " REBIRTHS" end, value = function(s) return s.data and s.data.rebirths or 0 end },
	-- all servers: OrderedDataStore, refreshed every 2 min
	{ id = "world", title = "WORLD TOP COLLECTION", fmt = function(v) return "$" .. Util.FormatNumber(v) end, global = true },
}

-- global ranking (OrderedDataStore): every player's collection value is written every 2 min, top 10 read every 2 min
local ORDERED_NAME = "CarHunters_TopCollection_v1"
local worldTop = {} -- { { userId, name, v } }
local names = {}
local function nameOf(userId)
	if names[userId] == nil then
		names[userId] = "Player"
		local ok, n = pcall(function()
			return Players:GetNameFromUserIdAsync(userId)
		end)
		if ok and n then
			names[userId] = n
		end
	end
	return names[userId]
end

local function worldLoop()
	local ok, ordered = pcall(function()
		return game:GetService("DataStoreService"):GetOrderedDataStore(ORDERED_NAME)
	end)
	if not ok then
		return -- Studio without API access: the WORLD tab just shows this server
	end
	while true do
		for _, p in ipairs(Players:GetPlayers()) do
			local sess = S.Data.Get(p)
			if sess and sess.ready and not sess.ephemeral then
				pcall(function()
					ordered:SetAsync(tostring(p.UserId), math.floor(math.min(sess.collectionValue or 0, 9e15)))
				end)
				task.wait(0.5)
			end
		end
		local okTop, pages = pcall(function()
			return ordered:GetSortedAsync(false, 10)
		end)
		if okTop and pages then
			local list = {}
			for _, e in ipairs(pages:GetCurrentPage()) do
				local uid = tonumber(e.key)
				if uid then
					table.insert(list, { userId = uid, name = nameOf(uid), v = e.value })
				end
			end
			worldTop = list
		end
		task.wait(120)
	end
end

function LB.Init(hub)
	S = hub
end

local thumbs = {}
local function headshot(userId)
	if thumbs[userId] == nil then
		thumbs[userId] = ""
		task.spawn(function()
			local ok, url = pcall(function()
				return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
			end)
			thumbs[userId] = ok and url or ""
		end)
	end
	return thumbs[userId]
end

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = parent
	return o
end

local ui = {}
local function build(screen)
	local gui = new("SurfaceGui", { Name = "Board", Face = Enum.NormalId[screen:GetAttribute("Facing") or "Front"], SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 40, LightInfluence = 0, Brightness = 1.4 }, screen)
	local bg = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(14, 16, 24), BorderSizePixel = 0 }, gui)
	new("UIGradient", { Color = ColorSequence.new(C(30, 36, 56), C(10, 12, 18)), Rotation = 90 }, bg)
	ui.title = new("TextLabel", { Size = UDim2.new(1, 0, 0.16, 0), Position = UDim2.fromScale(0, 0.02), BackgroundTransparency = 1, Font = Enum.Font.LuckiestGuy,
		TextScaled = true, TextColor3 = GOLD, Text = "" }, bg)
	new("UIStroke", { Color = C(0, 0, 0), Thickness = 3 }, ui.title)
	-- tab pills
	local tabs = new("Frame", { Size = UDim2.new(0.8, 0, 0.07, 0), Position = UDim2.fromScale(0.1, 0.19), BackgroundTransparency = 1 }, bg)
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0.02, 0), HorizontalAlignment = Enum.HorizontalAlignment.Center }, tabs)
	ui.tabs = {}
	for i, t in ipairs(LB.Tabs) do
		local pill = new("TextLabel", { Size = UDim2.new(0.23, 0, 1, 0), BackgroundColor3 = C(40, 46, 66), Font = Enum.Font.FredokaOne, TextScaled = true,
			TextColor3 = C(200, 206, 220), Text = string.upper(t.id), LayoutOrder = i }, tabs)
		new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, pill)
		ui.tabs[i] = pill
	end
	-- 8 rows
	local list = new("Frame", { Size = UDim2.new(0.92, 0, 0.68, 0), Position = UDim2.fromScale(0.04, 0.3), BackgroundTransparency = 1 }, bg)
	new("UIListLayout", { Padding = UDim.new(0.012, 0) }, list)
	ui.rows = {}
	for i = 1, 8 do
		local row = new("Frame", { Size = UDim2.new(1, 0, 0.113, 0), BackgroundColor3 = i &lt;= 3 and RANK_COLOR[i] or C(255, 255, 255), BackgroundTransparency = i &lt;= 3 and 0.8 or 0.93, LayoutOrder = i }, list)
		new("UICorner", { CornerRadius = UDim.new(0.3, 0) }, row)
		local badge = new("TextLabel", { Size = UDim2.new(0.07, 0, 0.84, 0), Position = UDim2.fromScale(0.01, 0.08), BackgroundColor3 = i &lt;= 3 and RANK_COLOR[i] or C(60, 66, 84),
			Font = Enum.Font.LuckiestGuy, TextScaled = true, TextColor3 = i &lt;= 3 and C(20, 20, 24) or C(230, 230, 236), Text = tostring(i) }, row)
		new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, badge)
		local face = new("ImageLabel", { Size = UDim2.new(0.07, 0, 0.84, 0), Position = UDim2.fromScale(0.095, 0.08), BackgroundColor3 = C(40, 44, 60), Image = "" }, row)
		new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, face)
		local name = new("TextLabel", { Size = UDim2.new(0.48, 0, 0.8, 0), Position = UDim2.fromScale(0.18, 0.1), BackgroundTransparency = 1, Font = Enum.Font.FredokaOne,
			TextScaled = true, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C(255, 255, 255), Text = "" }, row)
		local value = new("TextLabel", { Size = UDim2.new(0.32, 0, 0.8, 0), Position = UDim2.fromScale(0.66, 0.1), BackgroundTransparency = 1, Font = Enum.Font.FredokaOne,
			TextScaled = true, TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = C(52, 208, 88), Text = "" }, row)
		ui.rows[i] = { row = row, face = face, name = name, value = value }
	end
end

-- top-3 avatar statues. The old statue stays until the new avatar has loaded (no blinking); a load that finishes
-- after the ranking changed again is thrown away (no wrong player on the podium); feet stand on the step.
local statues, pending = {}, {}
local function placeStatue(rank, player)
	local spot
	for _, d in ipairs(ui.spots or {}) do
		if d:GetAttribute("Rank") == rank then
			spot = d
		end
	end
	if not spot then
		return
	end
	local key = player and player.UserId or 0
	if (statues[rank] and statues[rank].key == key) or pending[rank] == key then
		return
	end
	if not player then
		pending[rank] = nil
		if statues[rank] then
			statues[rank].model:Destroy()
			statues[rank] = nil
		end
		return
	end
	pending[rank] = key
	task.spawn(function()
		local ok, model = pcall(function()
			return Players:CreateHumanoidModelFromUserId(player.UserId)
		end)
		if pending[rank] ~= key then
			if ok and model then
				model:Destroy()
			end
			return
		end
		pending[rank] = nil
		if not ok or not model or not spot.Parent then
			return
		end
		model.Name = "Statue_" .. rank
		local hum = model:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		end
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
			end
		end
		-- real step height: ray down onto the podium model (the spot heights are only a guess for the Blender frame)
		local top = spot.Position.Y + spot.Size.Y / 2
		local rp = RaycastParams.new()
		rp.FilterType = Enum.RaycastFilterType.Include
		rp.FilterDescendantsInstances = { spot.Parent }
		local hit = Workspace:Raycast(spot.Position + Vector3.new(0, 12, 0), Vector3.new(0, -20, 0), rp)
		if hit and hit.Instance ~= spot then
			top = hit.Position.Y
		end
		model:PivotTo(CFrame.new(spot.Position + Vector3.new(0, 4, 0)) * CFrame.Angles(0, spot:GetAttribute("Yaw") or 0, 0))
		local bcf, size = model:GetBoundingBox()
		model:PivotTo(model:GetPivot() - Vector3.new(0, (bcf.Position.Y - size.Y / 2) - top, 0))
		local hl = Instance.new("Highlight")
		hl.FillColor = RANK_COLOR[rank]
		hl.FillTransparency = 0.75
		hl.OutlineColor = RANK_COLOR[rank]
		hl.Parent = model
		model.Parent = Workspace
		if statues[rank] then
			statues[rank].model:Destroy()
		end
		statues[rank] = { key = key, model = model }
	end)
end

local tabIndex = 0
local function refresh()
	tabIndex = tabIndex % #LB.Tabs + 1
	local tab = LB.Tabs[tabIndex]
	local entries = {}
	if tab.global then
		for _, e in ipairs(worldTop) do
			table.insert(entries, { userId = e.userId, name = e.name, v = e.v })
		end
	end
	if #entries == 0 then -- local ranking (also the fallback for the world tab before the first read)
		for _, p in ipairs(Players:GetPlayers()) do
			local s = S.Data.Get(p)
			if s and s.ready then
				table.insert(entries, { userId = p.UserId, name = p.DisplayName, v = tab.value and tab.value(s) or (s.collectionValue or 0) })
			end
		end
	end
	table.sort(entries, function(a, b)
		return a.v &gt; b.v
	end)
	ui.title.Text = tab.title
	for i, pill in ipairs(ui.tabs) do
		pill.BackgroundColor3 = i == tabIndex and GOLD or C(40, 46, 66)
		pill.TextColor3 = i == tabIndex and C(20, 20, 24) or C(200, 206, 220)
	end
	for i, r in ipairs(ui.rows) do
		local e = entries[i]
		r.row.Visible = e ~= nil
		if e then
			r.name.Text = e.name
			r.value.Text = tab.fmt(e.v)
			r.face.Image = headshot(e.userId)
		end
	end
	-- statues always show the income podium
	local byIncome = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local s = S.Data.Get(p)
		if s and s.ready then
			table.insert(byIncome, { player = p, v = s.income or 0 })
		end
	end
	table.sort(byIncome, function(a, b)
		return a.v &gt; b.v
	end)
	for rank = 1, 3 do
		placeStatue(rank, byIncome[rank] and byIncome[rank].player)
	end
end

function LB.Start()
	task.spawn(function()
		local map = Workspace:WaitForChild("GeneratedMap", 60)
		local screen = CollectionService:GetTagged("LeaderboardScreen")[1]
		if not map or not screen then
			warn("[Leaderboard] screen not found")
			return
		end
		build(screen)
		ui.spots = {}
		for _, d in ipairs(screen.Parent:GetChildren()) do
			if string.match(d.Name, "^StatueSpot") then
				d.CanQuery = false -- the ray must hit the real step below it
				table.insert(ui.spots, d)
			end
		end
		task.spawn(worldLoop)
		while true do
			pcall(refresh)
			task.wait(8)
		end
	end)
end

return LB
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXA4D6D58D71DC4D8B9F904D8B7002C6C9"><Properties><string name="Name">MechanicService</string><ProtectedString name="Source">-- Big Tony, the rich mechanic next to the contracts board: hands out finished contract rewards
-- and trades banked parts for tuning parts.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared:WaitForChild("Util"))
local TuningConfig = require(Shared:WaitForChild("TuningConfig"))

local Mechanic = {}
local S
local spotPos
local anims

function Mechanic.Init(hub)
	S = hub
end

local function nearTony(player)
	local hrp = S.Data.GetRoot(player)
	return hrp and spotPos and (hrp.Position - spotPos).Magnitude &lt;= 24
end

local function gesture()
	if anims and anims.point then
		anims.point:Play()
	elseif anims and anims.wave then
		anims.wave:Play()
	end
end

function Mechanic.Claim(player, id)
	local s = S.Data.Get(player)
	if not s or not s.ready or not S.Data.RateLimit(player, "claim", 0.3) then
		return
	end
	if not nearTony(player) then
		S.Data.Notify(player, "seeTony", nil, "warn")
		return
	end
	local d = s.data
	local total, n = 0, 0
	for i = #d.contracts, 1, -1 do
		local c = d.contracts[i]
		if (id == "all" or c.id == id) and c.ready then
			total = total + S.Contracts.Reward(player, s, c, i, true)
			n = n + 1
			gesture()
		end
	end
	if n &gt; 0 then -- one combined message + one state push
		S.Data.Notify(player, n &gt; 1 and "contractsDone" or "contractDone", n &gt; 1 and { n, Util.FormatNumber(total) } or { Util.FormatNumber(total) }, "good")
		S.Data.Push(player)
	end
end

function Mechanic.Craft(player, recipeId)
	local s = S.Data.Get(player)
	local r = type(recipeId) == "string" and TuningConfig.RecipeById[recipeId]
	if not s or not s.ready or not r or not S.Data.RateLimit(player, "craft", 0.3) then
		return
	end
	if not nearTony(player) then
		S.Data.Notify(player, "seeTony", nil, "warn")
		return
	end
	local d = s.data
	if d.money &lt; r.money then
		S.Data.Notify(player, "noMoney", nil, "error")
		return
	end
	for part, n in pairs(r.parts or {}) do
		if (d.parts[part] or 0) &lt; n then
			S.Data.Notify(player, "noParts", nil, "error")
			return
		end
	end
	for item, n in pairs(r.tune or {}) do
		if (d.tuning[item] or 0) &lt; n then
			S.Data.Notify(player, "noTuneParts", nil, "error")
			return
		end
	end
	d.money = d.money - r.money
	for part, n in pairs(r.parts or {}) do
		d.parts[part] = d.parts[part] - n
	end
	for item, n in pairs(r.tune or {}) do
		d.tuning[item] = d.tuning[item] - n
		if d.tuning[item] &lt;= 0 then
			d.tuning[item] = nil
		end
	end
	d.tuning[r.out] = math.min((d.tuning[r.out] or 0) + 1, 999)
	S.Data.Notify(player, "crafted", { TuningConfig.Items[r.out].name }, "good")
	gesture()
	S.Data.Push(player)
end

local function dressTony(n)
	local A = S.Shop.Attach
	local GOLD, BLACK, WHITE = Color3.fromRGB(240, 190, 60), Color3.fromRGB(24, 24, 28), Color3.fromRGB(250, 250, 250)
	local M = Enum.Material
	-- fedora
	A(n, "Head", Vector3.new(1.9, 0.12, 1.9), CFrame.new(0, 0.55, 0), BLACK)
	A(n, "Head", Vector3.new(1.25, 0.6, 1.25), CFrame.new(0, 0.86, 0), BLACK)
	A(n, "Head", Vector3.new(1.28, 0.14, 1.28), CFrame.new(0, 0.66, 0), GOLD)
	-- shades + cigar
	A(n, "Head", Vector3.new(1.0, 0.22, 0.1), CFrame.new(0, 0.12, -0.6), BLACK, M.Glass)
	A(n, "Head", Vector3.new(0.12, 0.12, 0.6), CFrame.new(0.25, -0.28, -0.75), Color3.fromRGB(120, 70, 40))
	A(n, "Head", Vector3.new(0.13, 0.13, 0.08), CFrame.new(0.25, -0.28, -1.06), Color3.fromRGB(255, 120, 40), M.Neon)
	-- white shirt, gold tie, gold chain, pocket square
	A(n, "UpperTorso", Vector3.new(0.7, 1.4, 0.1), CFrame.new(0, 0.15, -0.52), WHITE)
	A(n, "UpperTorso", Vector3.new(0.22, 1.1, 0.12), CFrame.new(0, 0.05, -0.58), GOLD, M.Metal)
	A(n, "UpperTorso", Vector3.new(1.2, 0.12, 0.12), CFrame.new(0, 0.62, -0.56), GOLD, M.Metal)
	A(n, "UpperTorso", Vector3.new(0.3, 0.22, 0.1), CFrame.new(-0.6, 0.45, -0.53), Color3.fromRGB(214, 52, 44))
	-- gold watch + rings, chrome wrench
	A(n, "LeftLowerArm", Vector3.new(0.62, 0.22, 0.62), CFrame.new(0, -0.3, 0), GOLD, M.Metal)
	A(n, "RightHand", Vector3.new(0.18, 0.18, 0.18), CFrame.new(0.2, -0.1, -0.2), GOLD, M.Metal)
	local wrench = A(n, "RightHand", Vector3.new(0.22, 1.7, 0.22), CFrame.new(0, -0.6, 0), Color3.fromRGB(230, 232, 236), M.Metal)
	if wrench then
		wrench.Reflectance = 0.4
	end
	-- polished shoes
	A(n, "LeftFoot", Vector3.new(0.8, 0.3, 1.2), CFrame.new(0, -0.1, -0.1), BLACK, M.SmoothPlastic)
	A(n, "RightFoot", Vector3.new(0.8, 0.3, 1.2), CFrame.new(0, -0.1, -0.1), BLACK, M.SmoothPlastic)
end

function Mechanic.Start()
	task.spawn(function()
		local map = Workspace:WaitForChild("GeneratedMap", 60)
		local stand = map and map:FindFirstChild("ContractStand", true)
		local spot = stand and stand:FindFirstChild("TonySpot")
		if not spot then
			warn("[Mechanic] ContractStand/TonySpot not found")
			return
		end
		spotPos = spot.Position
		local prompt = stand:FindFirstChild("TonyPrompt")
		if prompt then
			local pp = Instance.new("ProximityPrompt")
			pp.ActionText = "Talk"
			pp.ObjectText = "Big Tony"
			pp.HoldDuration = 0
			pp.MaxActivationDistance = 14
			pp.RequiresLineOfSight = false
			pp.Parent = prompt
		end
		local npc
		npc, anims = S.Shop.MakeNpc("BigTony", {
			skin = Color3.fromRGB(214, 164, 126), arms = Color3.fromRGB(30, 36, 58),
			torso = Color3.fromRGB(30, 36, 58), legs = Color3.fromRGB(34, 38, 48),
		}, spot, dressTony)
		if not npc then
			return
		end
		npc:ScaleTo(1.12)
		npc:PivotTo(npc:GetPivot() + Vector3.new(0, 0.37, 0))
		-- nod at players who have rewards waiting
		local cool = 0
		while npc.Parent do
			task.wait(0.5)
			cool = cool - 0.5
			if cool &lt;= 0 then
				for _, p in ipairs(Players:GetPlayers()) do
					local hrp = S.Data.GetRoot(p)
					if hrp and (hrp.Position - spotPos).Magnitude &lt; 22 then
						if anims.wave then
							anims.wave:Play()
						end
						cool = 9
						break
					end
				end
			end
		end
	end)
end

return Mechanic
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXE95973831C974993B59570991C58E99D"><Properties><string name="Name">ModelService</string><ProtectedString name="Source">-- Loads the Blender models that tools/roblox_open_cloud.py uploaded (ids in Shared/ModelIds.lua), styles their meshes
-- by look name and installs them where the game looks for them:
--   spawn models + street props -&gt; ServerStorage.BuilderAssets.Props   (map builder, Prefabs.FromTemplate)
--   pickup / tuning parts       -&gt; ReplicatedStorage.PartModels        (PartVisual, WheelKit)
-- Must run before the map is built. Anything that fails to load keeps the procedural fallback.
local InsertService = game:GetService("InsertService")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Looks = require(Shared:WaitForChild("ModelLooks"))

local ModelService = {}

local function ensure(parent, name)
	local f = parent:FindFirstChild(name)
	if not f then
		f = Instance.new("Folder")
		f.Name = name
		f.Parent = parent
	end
	return f
end

local function style(model, anchored)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local key = string.match(d.Name, "^(%a+)") or ""
			local look = Looks[key]
			if look then
				d.Name = key
				d.Material, d.Color, d.Reflectance, d.Transparency = look[1], look[2], look[3], look[4]
				d.CanCollide = look[5] ~= false
			end
			d.Anchored = anchored
			d.CastShadow = key ~= "Glow" and key ~= "Glass" and key ~= "Water"
			d.TopSurface, d.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		end
	end
end

-- pivot at the bottom centre, or (spawn models) back on the Blender origin; info = { size, c = bbox centre offset }
local function normalize(model, info)
	local bb, ext = model:GetBoundingBox()
	-- safety: a kit model without a known size that arrives in centimetres (100x too big) is brought back to studs
	if not (info and info.size) and math.max(ext.X, ext.Y, ext.Z) &gt; 60 then
		model.WorldPivot = bb
		model:ScaleTo(model:GetScale() * 0.01)
		bb, ext = model:GetBoundingBox()
	end
	if info and info.size then
		local cur = math.max(ext.X, ext.Y, ext.Z)
		if cur &gt; 0.01 and math.abs(cur / info.size - 1) &gt; 0.02 then
			model.WorldPivot = bb
			model:ScaleTo(model:GetScale() * info.size / cur)
			bb, ext = model:GetBoundingBox()
		end
	end
	if info and info.c then
		model.WorldPivot = CFrame.new(bb.Position - Vector3.new(info.c[1], info.c[2], info.c[3]))
	else
		model.WorldPivot = CFrame.new(bb.Position - Vector3.new(0, ext.Y / 2, 0))
	end
end

-- the imported FBX root: the first Model under the inserted container (or a Model wrapping its parts)
local function rootOf(container, name)
	local m = container:FindFirstChildWhichIsA("Model")
	if not m then
		m = Instance.new("Model")
		for _, c in ipairs(container:GetChildren()) do
			c.Parent = m
		end
	end
	m.Name = name
	return m
end

local function install(dest, m)
	local old = dest:FindFirstChild(m.Name)
	if old then
		old:Destroy()
	end
	m.Parent = dest
end

function ModelService.LoadAll()
	local okIds, ids = pcall(require, Shared:WaitForChild("ModelIds"))
	if not okIds or type(ids) ~= "table" then
		return 0
	end
	local okSizes, sizes = pcall(require, Shared:WaitForChild("ModelSizes"))
	sizes = okSizes and sizes or {}
	local props = ensure(ensure(ServerStorage, "BuilderAssets"), "Props")
	local partModels = ensure(ReplicatedStorage, "PartModels")
	local n = 0
	local stats = { embedded = 0, downloaded = 0, missing = {} }
	for name, id in pairs(ids) do
		-- each model on its own: one broken model must never stop the others
		local okOne, errOne = pcall(function()
		if id and id &gt; 0 then
			-- 1) embedded in the place file (tools/bake_models.luau)  2) LoadAsset (needs the game owner to own the asset)
			local emb = ServerStorage:FindFirstChild("Embedded")
			emb = emb and emb:FindFirstChild("Assets") and emb.Assets:FindFirstChild("A" .. tostring(id))
			local ok, res
			if emb then
				ok, res = true, emb:Clone()
				stats.embedded = stats.embedded + 1
			else
				ok, res = pcall(function()
					return InsertService:LoadAsset(id)
				end)
				if ok and res then
					stats.downloaded = stats.downloaded + 1
				end
			end
			if ok and res then
				if name == "PartsKit" or name == "PropsKit" then
					for _, m in ipairs(res:GetDescendants()) do
						if m:IsA("Model") and (string.match(m.Name, "^Part_") or string.match(m.Name, "^Tune_") or m.Name == "TireStack" or m.Name == "Cone" or m.Name == "Hydrant") then
							local part = name == "PartsKit"
							style(m, not part)
							if part then
								for _, d in ipairs(m:GetDescendants()) do
									if d:IsA("BasePart") then
										d.CanCollide, d.CanQuery, d.CanTouch, d.CastShadow = false, false, false, false
									end
								end
							end
							normalize(m)
							install(part and partModels or props, m)
							n = n + 1
						end
					end
				else
					local m = rootOf(res, name)
					style(m, true)
					normalize(m, sizes[name])
					install(props, m)
					n = n + 1
				end
				res:Destroy()
			else
				table.insert(stats.missing, name)
				warn(string.format("[Models] %s (%s) did not load: %s", name, tostring(id), tostring(res)))
			end
		end
		end)
		if not okOne then
			table.insert(stats.missing, name)
			warn(string.format("[Models] %s failed while preparing: %s", name, tostring(errOne)))
		end
	end
	ModelService.Report = { installed = n, missing = stats.missing }
	print(string.format("[Models] %d Blender models installed (embedded %d, downloaded %d)%s", n, stats.embedded, stats.downloaded,
		#stats.missing &gt; 0 and ("  MISSING: " .. table.concat(stats.missing, ", ")) or ""))
	return n
end

return ModelService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6894681D744D4F878E915646EB19ADF9"><Properties><string name="Name">RebirthService</string><ProtectedString name="Source">-- Rebirth (classic reset for a permanent income bonus + tokens) and garage skins.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local SkinConfig = require(Shared:WaitForChild("SkinConfig"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))

local Rebirth = {}
local S

function Rebirth.Init(hub)
	S = hub
end

function Rebirth.IncomeMult(s)
	local d = s and s.data
	if not d then
		return 1
	end
	local skin = SkinConfig.ById[d.skin]
	return (1 + SkinConfig.Rebirth.incomePer * (d.rebirths or 0)) * (1 + (skin and skin.bonus or 0))
end

function Rebirth.PerkLevel(s, id)
	return s and s.data and s.data.tokenPerks and s.data.tokenPerks[id] or 0
end

function Rebirth.Can(s)
	local d = s.data
	local zone, money = SkinConfig.RebirthNeeds(d.rebirths or 0)
	return d.unlockedZones[zone] == true and d.money &gt;= money, zone, money
end

function Rebirth.Do(player)
	local s = S.Data.Get(player)
	if not s or not s.ready or not S.Data.RateLimit(player, "rebirth", 2) then
		return
	end
	local ok, _, money = Rebirth.Can(s)
	if not ok then
		S.Data.Notify(player, "rebirthNotYet", nil, "warn")
		return
	end
	local d = s.data
	local tokens = math.min(5, math.floor(d.money / money)) -- 1 token, more for overshooting the target
	d.rebirths = (d.rebirths or 0) + 1
	d.tokens = (d.tokens or 0) + tokens
	-- what burns: money, cars, parts, districts, floors/bays, tuning box
	d.money = SkinConfig.Rebirth.startMoney * d.rebirths
	d.cars = {}
	for id in pairs(d.parts) do
		d.parts[id] = 0
	end
	d.parts.bolts = 3
	d.unlockedZones = { city = true }
	d.floors = 1
	d.garageSlotCount = EconomyConfig.StartSlots + Rebirth.PerkLevel(s, "startSlot")
	d.tuning = {}
	d.contracts = {}
	d.pity = 0
	s.carried = {}
	s.carriedZones = {}
	S.Data.Notify(player, "reborn", { d.rebirths, tokens }, "good")
	S.Contracts.Fill(s)
	S.Income.Recalc(player)
	S.Base.RefreshAll(player)
	S.Data.Push(player)
	local hum = select(2, S.Data.GetRoot(player))
	if hum then
		hum.Health = 0 -- respawn at the (now empty) garage
	end
end

local function ownsSkin(s, def)
	return s.data.skins[def.id] or (def.pass and S.Shop.HasPass(s, def.pass))
end

-- buy if needed, then equip
function Rebirth.Skin(player, id)
	local s = S.Data.Get(player)
	local def = type(id) == "string" and SkinConfig.ById[id]
	if not s or not s.ready or not def or not S.Data.RateLimit(player, "skin", 0.5) then
		return
	end
	local d = s.data
	if not ownsSkin(s, def) then
		if def.pass then
			S.Donate.Request(player, def.pass)
			return
		elseif def.tokens then
			if d.tokens &lt; def.tokens then
				S.Data.Notify(player, "noTokens", nil, "error")
				return
			end
			d.tokens = d.tokens - def.tokens
		elseif def.money then
			if d.money &lt; def.money then
				S.Data.Notify(player, "noMoney", nil, "error")
				return
			end
			d.money = d.money - def.money
		end
		d.skins[def.id] = true
	end
	d.skin = def.id
	S.Data.Notify(player, "skinOn", { def.name }, "good")
	S.Income.Recalc(player)
	S.Base.RefreshAll(player)
	S.Data.Push(player)
end

function Rebirth.TokenPerk(player, id)
	local s = S.Data.Get(player)
	local def = type(id) == "string" and SkinConfig.TokenPerkById[id]
	if not s or not s.ready or not def or not S.Data.RateLimit(player, "tperk", 0.4) then
		return
	end
	local d = s.data
	local lvl = d.tokenPerks[id] or 0
	if lvl &gt;= def.max then
		S.Data.Notify(player, "maxLevel", nil, "warn")
		return
	end
	if d.tokens &lt; def.cost then
		S.Data.Notify(player, "noTokens", nil, "error")
		return
	end
	d.tokens = d.tokens - def.cost
	d.tokenPerks[id] = lvl + 1
	if id == "startSlot" then
		d.garageSlotCount = math.min(d.garageSlotCount + 1, d.floors * 6)
		S.Base.RefreshAll(player)
	end
	S.Data.Notify(player, "perkBought", { def.name, lvl + 1 }, "good")
	S.Data.Push(player)
end

return Rebirth
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX07E369ACFBCB40EBBBF44F374FCC20DA"><Properties><string name="Name">RewardsService</string><ProtectedString name="Source">-- Daily streak + playtime chests. Everything is decided on the server.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local R = require(Shared:WaitForChild("RewardConfig"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))
local TuningConfig = require(Shared:WaitForChild("TuningConfig"))

local Rewards = {}
local S

function Rewards.Init(hub)
	S = hub
end

local function give(player, s, entry)
	local d = s.data
	local cash = R.Money(entry, s.income)
	d.money = math.min(d.money + cash, EconomyConfig.MaxMoney)
	for id, n in pairs(entry.parts or {}) do
		d.parts[id] = (d.parts[id] or 0) + n
	end
	if entry.pity then
		d.pity = math.max(d.pity, EconomyConfig.PityThreshold - 1)
	end
	if entry.tuning then
		local fams = { "ecu", "exhaust", "intake", "tires", "aero" }
		local item = fams[math.random(1, #fams)] .. "1"
		d.tuning[item] = (d.tuning[item] or 0) + 1
		S.Data.Notify(player, "tuneDrop", { TuningConfig.Items[item].name }, "good")
	end
	return cash
end

function Rewards.ClaimDaily(player)
	local s = S.Data.Get(player)
	if not s or not s.ready or not S.Data.RateLimit(player, "daily", 1) then
		return
	end
	local d = s.data
	local today = R.UtcDay()
	if d.daily.last == today then
		return
	end
	local day = R.NextDay(d.daily, today)
	d.daily = { day = day, last = today }
	local cash = give(player, s, R.Daily[day])
	S.Data.Notify(player, "dailyClaimed", { day, cash }, "good")
	S.Data.Push(player)
end

function Rewards.ClaimChest(player, i)
	local s = S.Data.Get(player)
	local entry = type(i) == "number" and R.Chests[i]
	if not s or not s.ready or not entry or not S.Data.RateLimit(player, "chest", 0.5) then
		return
	end
	local played = S.Data.PlayTime(s) -- today's playtime, saved across rejoins
	local chests = s.data.play.chests
	if chests[i] or played &lt; entry.minutes * 60 then
		return
	end
	chests[i] = true
	local cash = give(player, s, entry)
	S.Data.Notify(player, "chestClaimed", { entry.minutes, cash }, "good")
	S.Data.Push(player)
end

return Rewards
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXFA79B69A349A427F9FEDB3C8F2CA112B"><Properties><string name="Name">ShopService</string><ProtectedString name="Source">-- Pit Stop: perks bought with in-game money + the mechanic NPC. All perk effects are read through this module.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ShopConfig = require(Shared:WaitForChild("ShopConfig"))
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))

local Shop = {}
local S

function Shop.Init(hub)
	S = hub
end

local function lvl(s, id)
	return (s and s.data and s.data.perks and s.data.perks[id]) or 0
end
Shop.Level = lvl

local function pass(s, id)
	return s and s.passes and s.passes[id] == true
end
Shop.HasPass = pass

local function boostActive(s, id)
	local b = s and s.data and s.data.boosts
	return b and (b[id] or 0) &gt; os.time()
end
Shop.BoostActive = boostActive

---------------------------------------------------------------- effects
function Shop.WalkSpeed(s)
	return MapConfig.WalkSpeed * (1 + ShopConfig.ById.sneakers.per * lvl(s, "sneakers"))
end

function Shop.CarryCap(s)
	local cap = EconomyConfig.CarryCapacity + ShopConfig.ById.backpack.per * lvl(s, "backpack")
	return pass(s, "big_backpack") and cap * 2 or cap
end

function Shop.PickupRadius(s)
	local r = (EconomyConfig.PickupRadius + ShopConfig.ById.magnet.per * lvl(s, "magnet")) * (1 + 0.25 * S.Rebirth.PerkLevel(s, "magnet"))
	return pass(s, "auto_collect") and r * 2 or r
end

function Shop.IncomeMult(s)
	local m = 1 + ShopConfig.ById.turbo.per * lvl(s, "turbo")
	if pass(s, "vip") then
		m = m * 1.5
	end
	if boostActive(s, "income") then
		m = m * 2
	end
	return m
end

-- 0..1 shift towards rarer cars (applied to the roll's random number)
function Shop.LuckShift(s)
	local shift = ShopConfig.ById.lucky.per * lvl(s, "lucky") + 0.02 * S.Rebirth.PerkLevel(s, "luck")
	if boostActive(s, "luck") then
		shift = shift + 0.08
	end
	return math.min(shift, EconomyConfig.MaxLuckShift)
end

function Shop.RespawnTime(s)
	local q = lvl(s, "quick")
	return q &gt; 0 and ShopConfig.ById.quick.respawn[q] or 3
end

function Shop.SpawnShield(s)
	return EconomyConfig.SpawnProtection + 0.5 * lvl(s, "quick")
end

function Shop.ThrowCooldown(s)
	return pass(s, "fast_trap") and EconomyConfig.ThrowAnimTime * 0.5 or EconomyConfig.ThrowAnimTime
end

-- airbag: returns true if a car hit is absorbed
function Shop.TryAirbag(s)
	local l = lvl(s, "airbag")
	if l &lt;= 0 then
		return false
	end
	local now = os.clock()
	if now &lt; (s.airbagReadyAt or 0) then
		return false
	end
	s.airbagReadyAt = now + ShopConfig.ById.airbag.cooldowns[l]
	return true
end

function Shop.AirbagReadyIn(s)
	if lvl(s, "airbag") &lt;= 0 then
		return nil
	end
	return math.max(0, (s.airbagReadyAt or 0) - os.clock())
end

---------------------------------------------------------------- buying
function Shop.Buy(player, perkId)
	local def = type(perkId) == "string" and ShopConfig.ById[perkId]
	local s = S.Data.Get(player)
	if not def or not s or not s.ready then
		return
	end
	if not S.Data.RateLimit(player, "perk", 0.3) then
		return
	end
	local d = s.data
	local cur = d.perks[perkId] or 0
	if cur &gt;= def.max then
		S.Data.Notify(player, "maxLevel", nil, "warn")
		return
	end
	local cost = def.costs[cur + 1]
	if d.money &lt; cost then
		S.Data.Notify(player, "noMoney", nil, "error")
		return
	end
	d.money = d.money - cost
	d.perks[perkId] = cur + 1
	S.Data.Notify(player, "perkBought", { def.name, cur + 1 }, "good")
	S.Income.Recalc(player)
	Shop.ApplyCharacter(player)
	S.Data.Push(player)
end

function Shop.ApplyCharacter(player)
	local s = S.Data.Get(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if s and hum then
		hum.WalkSpeed = Shop.WalkSpeed(s)
	end
end

---------------------------------------------------------------- NPC
local IDLE = "rbxassetid://507766388"
local WAVE = "rbxassetid://507770239"
local POINT = "rbxassetid://507770453"

-- builds an R15 NPC from body colours + simple part accessories (no catalogue assets needed)
function Shop.MakeNpc(name, colors, spot, dressUp)
	local desc = Instance.new("HumanoidDescription")
	desc.HeadColor = colors.skin
	desc.LeftArmColor, desc.RightArmColor = colors.arms, colors.arms
	desc.TorsoColor = colors.torso
	desc.LeftLegColor, desc.RightLegColor = colors.legs, colors.legs
	local ok, npc = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not npc then
		warn("[NPC] could not build " .. name .. ": " .. tostring(npc))
		return nil
	end
	npc.Name = name
	local hum = npc:FindFirstChildOfClass("Humanoid")
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	local root = npc:FindFirstChild("HumanoidRootPart")
	local yaw = spot:GetAttribute("Yaw") or 0
	npc:PivotTo(CFrame.new(spot.Position + Vector3.new(0, 3.1, 0)) * CFrame.Angles(0, yaw, 0))
	for _, p in ipairs(npc:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored = p == root
		end
	end
	if dressUp then
		dressUp(npc)
	end
	npc.Parent = Workspace
	local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
	local function load(id)
		local a = Instance.new("Animation")
		a.AnimationId = id
		local ok2, track = pcall(function()
			return animator:LoadAnimation(a)
		end)
		return ok2 and track or nil
	end
	local idle = load(IDLE)
	if idle then
		idle.Looped = true
		idle:Play()
	end
	return npc, { wave = load(WAVE), point = load(POINT), animator = animator, load = load }
end

-- weld a simple part accessory to a body part
function Shop.Attach(npc, partName, size, offset, color, mat, shape)
	local host = npc:FindFirstChild(partName)
	if not host then
		return nil
	end
	local p = Instance.new("Part")
	p.Size = size
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	if shape then
		p.Shape = shape
	end
	p.CanCollide, p.CanQuery, p.CanTouch, p.Massless = false, false, false, true
	p.CFrame = host.CFrame * offset
	local w = Instance.new("WeldConstraint")
	w.Part0, w.Part1 = host, p
	w.Parent = p
	p.Parent = npc
	return p
end

local function makePrompt(part, text, object)
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = text
	pp.ObjectText = object
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 14
	pp.RequiresLineOfSight = false
	pp.Parent = part
	return pp
end

function Shop.Start()
	task.spawn(function()
		local map = Workspace:WaitForChild("GeneratedMap", 60)
		local shop = map and map:FindFirstChild("PitStopShop", true)
		if not shop then
			warn("[Shop] PitStopShop not found in GeneratedMap")
			return
		end
		local prompt = shop:FindFirstChild("ShopPrompt")
		if prompt then
			makePrompt(prompt, "Open shop", "Pit Stop")
		end
		local spot = shop:FindFirstChild("NpcSpot")
		if spot then
			local npc, anims = Shop.MakeNpc("Mechanic", {
				skin = Color3.fromRGB(234, 184, 146), arms = Color3.fromRGB(40, 90, 170),
				torso = Color3.fromRGB(40, 90, 170), legs = Color3.fromRGB(30, 60, 120),
			}, spot, function(n)
				local CYL = Enum.PartType.Cylinder
				Shop.Attach(n, "Head", Vector3.new(1.3, 0.35, 1.35), CFrame.new(0, 0.62, 0), Color3.fromRGB(214, 52, 44))
				Shop.Attach(n, "Head", Vector3.new(0.9, 0.12, 0.7), CFrame.new(0, 0.5, -0.8), Color3.fromRGB(214, 52, 44))
				Shop.Attach(n, "UpperTorso", Vector3.new(0.9, 0.5, 0.15), CFrame.new(0.4, 0.2, -0.55), Color3.fromRGB(255, 255, 255))
				local wrench = Shop.Attach(n, "RightHand", Vector3.new(0.25, 1.6, 0.25), CFrame.new(0, -0.6, 0), Color3.fromRGB(190, 194, 200), Enum.Material.Metal)
				if wrench then
					wrench.Name = "Wrench"
				end
				Shop.Attach(n, "LeftHand", Vector3.new(0.4, 0.4, 0.4), CFrame.new(0, -0.2, 0), Color3.fromRGB(240, 240, 240), Enum.Material.Fabric, CYL)
			end)
			if npc and anims then
				-- wave at players who walk up
				task.spawn(function()
					local cool = 0
					while npc.Parent do
						task.wait(0.5)
						cool = cool - 0.5
						if cool &lt;= 0 then
							for _, p in ipairs(Players:GetPlayers()) do
								local c = p.Character
								local hrp = c and c:FindFirstChild("HumanoidRootPart")
								if hrp and (hrp.Position - spot.Position).Magnitude &lt; 20 then
									if anims.wave then
										anims.wave:Play()
									end
									cool = 8
									break
								end
							end
						end
					end
				end)
			end
		end
	end)
	Players.PlayerAdded:Connect(function(p)
		p.CharacterAdded:Connect(function()
			task.defer(Shop.ApplyCharacter, p)
		end)
	end)
end

return Shop
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX907DED52E54342A4B95F0572A371A0CC"><Properties><string name="Name">TradeService</string><ProtectedString name="Source">-- Player trading: request -&gt; accept -&gt; both sides offer cars / money / parts -&gt; both READY -&gt; 3 s countdown -&gt;
-- the server re-checks everything and swaps atomically. Any change resets READY.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))

local Trade = {}
local S
local pending = {} -- [target] = { [requester] = time }
local active = {} -- [player] = trade
Trade.MaxCars = 8
Trade.Countdown = 3

function Trade.Init(hub)
	S = hub
end

local function fire(player, msg)
	if player and player.Parent then
		Net.Get("TradeEvent"):FireClient(player, msg)
	end
end

local function other(t, p)
	return t.a == p and t.b or t.a
end

local function emptyOffer()
	return { cars = {}, money = 0, parts = {} }
end

-- what a side offers, as the partner should see it
local function describe(player, offer)
	local s = S.Data.Get(player)
	local cars = {}
	for uid in pairs(offer.cars) do
		for _, c in ipairs(s and s.data.cars or {}) do
			if c.uid == uid then
				table.insert(cars, { uid = uid, typeId = c.typeId, level = c.level })
			end
		end
	end
	return { cars = cars, money = offer.money, parts = offer.parts }
end

local function broadcast(t)
	for _, p in ipairs({ t.a, t.b }) do
		local o = other(t, p)
		fire(p, { type = "state", partner = o.DisplayName, partnerId = o.UserId, mine = describe(p, t.offers[p]), theirs = describe(o, t.offers[o]),
			readyMe = t.ready[p] == true, readyThem = t.ready[o] == true, countdown = t.confirmAt and math.max(0, t.confirmAt - os.clock()) or nil })
	end
end

local function close(t, reason)
	for _, p in ipairs({ t.a, t.b }) do
		if active[p] == t then
			active[p] = nil
		end
		fire(p, { type = "closed", reason = reason })
	end
end

-- offer still valid against the player's current inventory?
local function valid(player, offer)
	local s = S.Data.Get(player)
	if not s or not s.ready then
		return false
	end
	local d = s.data
	if offer.money &lt; 0 or offer.money &gt; d.money then
		return false
	end
	for id, n in pairs(offer.parts) do
		if (d.parts[id] or 0) &lt; n then
			return false
		end
	end
	local n = 0
	for uid in pairs(offer.cars) do
		n = n + 1
		local found = false
		for _, c in ipairs(d.cars) do
			if c.uid == uid and not s.hidden[uid] then
				found = true
			end
		end
		if not found then
			return false
		end
	end
	return n &lt;= Trade.MaxCars
end

local function count(t)
	local n = 0
	for _ in pairs(t) do
		n = n + 1
	end
	return n
end

local function execute(t)
	local a, b = t.a, t.b
	local oa, ob = t.offers[a], t.offers[b]
	if not valid(a, oa) or not valid(b, ob) then
		close(t, "Trade cancelled: an offer changed")
		return
	end
	local sa, sb = S.Data.Get(a), S.Data.Get(b)
	local da, db = sa.data, sb.data
	if #da.cars - count(oa.cars) + count(ob.cars) &gt; EconomyConfig.MaxCars or #db.cars - count(ob.cars) + count(oa.cars) &gt; EconomyConfig.MaxCars then
		close(t, "Trade cancelled: car storage is full")
		return
	end
	local function moveCars(fromD, toD, set)
		for i = #fromD.cars, 1, -1 do
			local c = fromD.cars[i]
			if set[c.uid] then
				table.remove(fromD.cars, i)
				c.parkedSlot, c.benched = nil, true
				table.insert(toD.cars, c)
				toD.discovered[c.typeId] = true
			end
		end
	end
	moveCars(da, db, oa.cars)
	moveCars(db, da, ob.cars)
	da.money = da.money - oa.money + ob.money
	db.money = db.money - ob.money + oa.money
	da.money = math.min(da.money, EconomyConfig.MaxMoney)
	db.money = math.min(db.money, EconomyConfig.MaxMoney)
	for id, n in pairs(oa.parts) do
		da.parts[id] = da.parts[id] - n
		db.parts[id] = (db.parts[id] or 0) + n
	end
	for id, n in pairs(ob.parts) do
		db.parts[id] = db.parts[id] - n
		da.parts[id] = (da.parts[id] or 0) + n
	end
	for _, p in ipairs({ a, b }) do
		local s = S.Data.Get(p)
		s.data.stats.trades = (s.data.stats.trades or 0) + 1
		S.Income.Recalc(p)
		S.Base.RefreshAll(p)
		S.Data.Push(p)
		task.spawn(S.Data.Save, p) -- persist right away (no dupes if a server dies)
	end
	close(t, "done")
end

function Trade.Request(player, targetId)
	if type(targetId) ~= "number" or not S.Data.RateLimit(player, "tradeReq", 3) then
		return
	end
	local target = Players:GetPlayerByUserId(targetId)
	if not target or target == player or active[player] or active[target] then
		S.Data.Notify(player, "tradeBusy", nil, "warn")
		return
	end
	pending[target] = pending[target] or {}
	pending[target][player] = os.clock()
	fire(target, { type = "request", from = player.UserId, name = player.DisplayName })
	S.Data.Notify(player, "tradeSent", { target.DisplayName }, "info")
end

function Trade.Respond(player, fromId, accept)
	local from = type(fromId) == "number" and Players:GetPlayerByUserId(fromId)
	local list = pending[player]
	if not from or not list or not list[from] then
		return
	end
	local at = list[from]
	list[from] = nil
	if not accept then
		S.Data.Notify(from, "tradeDeclined", { player.DisplayName }, "warn")
		return
	end
	if os.clock() - at &gt; 30 or active[player] or active[from] then
		S.Data.Notify(player, "tradeBusy", nil, "warn")
		return
	end
	local t = { a = from, b = player, offers = { [from] = emptyOffer(), [player] = emptyOffer() }, ready = {}, version = 0 }
	active[from], active[player] = t, t
	broadcast(t)
end

function Trade.Update(player, offer)
	local t = active[player]
	if not t or type(offer) ~= "table" or not S.Data.RateLimit(player, "tradeUpd", 0.15) then
		return
	end
	local clean = emptyOffer()
	if type(offer.cars) == "table" then
		for _, uid in ipairs(offer.cars) do
			if type(uid) == "string" and #uid &lt;= 64 and count(clean.cars) &lt; Trade.MaxCars then
				clean.cars[uid] = true
			end
		end
	end
	local m = tonumber(offer.money) or 0
	clean.money = (m == m and m &gt;= 0) and math.floor(m) or 0
	if type(offer.parts) == "table" then
		for _, id in ipairs(PartConfig.Order) do
			local n = tonumber(offer.parts[id])
			if n and n == n and n &gt; 0 then
				clean.parts[id] = math.floor(n)
			end
		end
	end
	if not valid(player, clean) then
		S.Data.Notify(player, "tradeInvalid", nil, "error")
		return
	end
	t.offers[player] = clean
	t.ready = {}
	t.confirmAt = nil
	t.version = t.version + 1
	broadcast(t)
end

function Trade.Ready(player, on)
	local t = active[player]
	if not t then
		return
	end
	t.ready[player] = on == true
	t.confirmAt = nil
	t.version = t.version + 1
	if t.ready[t.a] and t.ready[t.b] then
		local v = t.version
		t.confirmAt = os.clock() + Trade.Countdown
		task.delay(Trade.Countdown, function()
			if active[t.a] == t and t.version == v and t.ready[t.a] and t.ready[t.b] then
				execute(t)
			end
		end)
	end
	broadcast(t)
end

function Trade.Cancel(player)
	local t = active[player]
	if t then
		close(t, player.DisplayName .. " cancelled the trade")
	end
end

function Trade.Start()
	Players.PlayerRemoving:Connect(function(p)
		pending[p] = nil
		Trade.Cancel(p)
	end)
end

Trade._active = active
Trade._execute = execute
return Trade
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXFF4468C752DA4F3EBE6FC2036F654779"><Properties><string name="Name">TuningService</string><ProtectedString name="Source">-- Install / remove tuning parts on owned cars. Removing returns the part to the inventory.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local TuningConfig = require(Shared:WaitForChild("TuningConfig"))

local Tuning = {}
local S

function Tuning.Init(hub)
	S = hub
end

local CATS = {}
for _, c in ipairs(TuningConfig.Categories) do
	CATS[c.id] = true
end

-- itemId = nil removes the part in that category
function Tuning.Set(player, uid, cat, itemId)
	local s = S.Data.Get(player)
	if not s or not s.ready or type(uid) ~= "string" or not CATS[cat] then
		return
	end
	if not S.Data.RateLimit(player, "tune", 0.3) then
		return
	end
	if not S.Base.IsNearOwnBase(player) then
		S.Data.Notify(player, "tuneAtBase", nil, "warn")
		return
	end
	local d = s.data
	local car
	for _, c in ipairs(d.cars) do
		if c.uid == uid then
			car = c
		end
	end
	if not car then
		return
	end
	car.tune = car.tune or {}
	local it = itemId ~= nil and TuningConfig.Items[itemId]
	if itemId ~= nil and (not it or it.cat ~= cat or (d.tuning[itemId] or 0) &lt; 1) then
		return
	end
	local old = car.tune[cat]
	if old == itemId then
		return
	end
	if old then
		d.tuning[old] = (d.tuning[old] or 0) + 1
	end
	if it then
		d.tuning[itemId] = d.tuning[itemId] - 1
		if d.tuning[itemId] &lt;= 0 then
			d.tuning[itemId] = nil
		end
	end
	car.tune[cat] = itemId
	S.Data.Notify(player, it and "tuned" or "untuned", { it and it.name or "" }, "good")
	S.Income.Recalc(player)
	S.Base.RefreshAll(player)
	S.Data.Push(player)
end

-- grant a tuning drop (Tier 3 districts, arenas)
function Tuning.Give(player, itemId, n)
	local s = S.Data.Get(player)
	if s and s.data and TuningConfig.Items[itemId] then
		s.data.tuning[itemId] = math.min((s.data.tuning[itemId] or 0) + (n or 1), 999)
		S.Data.Push(player)
	end
end

return Tuning
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXA393A3FF979144B2AAEA657D65D1A06E"><Properties><string name="Name">WarpService</string><ProtectedString name="Source">-- Teleport buttons: home garage or any unlocked district. Server-validated.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local BaseLayout = require(Shared:WaitForChild("BaseLayout"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))

local Warp = {}
local S

function Warp.Init(hub)
	S = hub
end

function Warp.Go(player, dest)
	if type(dest) ~= "string" then
		return
	end
	local s = S.Data.Get(player)
	if not s or not s.ready or s.busy then
		return
	end
	local hrp = S.Data.GetRoot(player)
	if not hrp then
		return
	end
	if not S.Data.RateLimit(player, "warp", EconomyConfig.TeleportCooldown) then
		S.Data.Notify(player, "tpWait", nil, "warn")
		return
	end
	local target
	if dest == "home" then
		if not s.baseIndex then
			return
		end
		-- loot must be carried home on foot: no risk-free escape
		if S.Inventory.CarriedTotal(s) &gt; 0 then
			S.Data.Notify(player, "carryWalk", nil, "warn")
			return
		end
		target = BaseLayout.ToWorld(s.baseIndex, BaseLayout.SpawnLocal) + Vector3.new(0, 4, 0)
	elseif MapConfig.Zones[dest] then
		if not S.Zone.IsUnlocked(s, dest) then
			S.Data.Notify(player, "zoneLocked", nil, "warn")
			return
		end
		target = MapConfig.ZoneSpawn(dest) + Vector3.new(math.random(-8, 8), 0, 0)
	else
		return
	end
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.CFrame = CFrame.new(target, target + Vector3.new(0, 0, 1))
	S.Traffic.Protect(player, 1.5)
	S.Data.Notify(player, "teleported", nil, "good")
end

return Warp
</ProtectedString></Properties></Item></Item></Item><Item class="ServerStorage" referent="RBX44"><Properties><string name="Name">ServerStorage</string></Properties><Item class="Folder" referent="RBX43"><Properties><string name="Name">Tools</string></Properties><Item class="ModuleScript" referent="RBX1001"><Properties><string name="Name">CarModelTool</string><ProtectedString name="Source">local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local VehicleKinds = require(Shared:WaitForChild("VehicleKinds"))

local Tool = {}

local function ensure(parent, class, name)
	local o = parent:FindFirstChild(name)
	if not o then
		o = Instance.new(class)
		o.Name = name
		o.Parent = parent
	end
	return o
end

local function filled(m)
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			return true
		end
	end
	return false
end

function Tool.Setup()
	local root = ensure(ReplicatedStorage, "Folder", "CarModels")
	for _, def in ipairs(CarConfig.List) do
		local m = ensure(root, "Model", def.id)
		m:SetAttribute("CarName", def.name)
		m:SetAttribute("Rarity", def.rarity)
		if m:GetAttribute("Yaw") == nil then
			m:SetAttribute("Yaw", 0)
		end
	end
	local traffic = ensure(root, "Folder", "Traffic")
	for kind in pairs(VehicleKinds) do
		local m = ensure(traffic, "Model", kind)
		if m:GetAttribute("Yaw") == nil then
			m:SetAttribute("Yaw", 0)
		end
	end
	Tool.Status()
end

function Tool.Status()
	local root = ReplicatedStorage:FindFirstChild("CarModels")
	if not root then
		print("[CarModels] folder missing - run Setup()")
		return
	end
	local done, missing = 0, {}
	for _, def in ipairs(CarConfig.List) do
		local m = root:FindFirstChild(def.id)
		if m and filled(m) then
			done = done + 1
		else
			table.insert(missing, def.id)
		end
	end
	print(string.format("[CarModels] collection: %d/%d real models", done, #CarConfig.List))
	if #missing &gt; 0 then
		print("[CarModels] procedural fallback for: " .. table.concat(missing, ", "))
	end
end

-- Blender pipeline: import assets/cars/cars_collection.fbx and cars_traffic.fbx with File &gt; Import 3D
-- (they land in Workspace), then run in the Command Bar:
--   require(game.ServerStorage.Tools.CarModelTool).ApplyImported()
local C = Color3.fromRGB
local LOOK = {
	Body = { Enum.Material.SmoothPlastic, nil, 0, 0.05 },
	Glass = { Enum.Material.Glass, C(18, 26, 34), 0.05, 0.25 },
	Stripe = { Enum.Material.SmoothPlastic, nil, 0, 0.05 },
	Caliper = { Enum.Material.SmoothPlastic, C(220, 40, 40), 0, 0 },
	Plate = { Enum.Material.SmoothPlastic, C(236, 236, 230), 0, 0 },
	Trim = { Enum.Material.SmoothPlastic, C(22, 22, 26), 0, 0 },
	Chrome = { Enum.Material.Metal, C(222, 224, 232), 0, 0.35 },
	Tire = { Enum.Material.SmoothPlastic, C(22, 22, 26), 0, 0 },
	Rim = { Enum.Material.Metal, C(192, 196, 204), 0, 0.2 },
	HeadLight = { Enum.Material.Neon, C(255, 246, 210), 0, 0 },
	TailLight = { Enum.Material.Neon, C(255, 40, 50), 0, 0 },
	Neon = { Enum.Material.Neon, nil, 0, 0 },
	Cargo = { Enum.Material.SmoothPlastic, C(240, 240, 244), 0, 0 },
}
local PROP_LOOK = {
	Rubber = { Enum.Material.SmoothPlastic, C(28, 28, 32) }, Orange = { Enum.Material.SmoothPlastic, C(255, 130, 30) },
	White = { Enum.Material.SmoothPlastic, C(245, 245, 245) }, Red = { Enum.Material.SmoothPlastic, C(225, 50, 50) },
	Metal = { Enum.Material.Metal, C(180, 184, 190) }, Yellow = { Enum.Material.SmoothPlastic, C(255, 210, 63) },
}
local PROPS = { TireStack = true, Cone = true, Hydrant = true }

local function installProp(m)
	local assets = ensure(game:GetService("ServerStorage"), "Folder", "BuilderAssets")
	local props = ensure(assets, "Folder", "Props")
	local old = props:FindFirstChild(m.Name)
	if old then
		old:Destroy()
	end
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			local look = PROP_LOOK[string.match(d.Name, "^(%a+)") or ""]
			if look then
				d.Material, d.Color = look[1], look[2]
			end
			d.Anchored = true
		end
	end
	local bb, size = m:GetBoundingBox()
	m.WorldPivot = CFrame.new(bb.Position - Vector3.new(0, size.Y / 2, 0))
	m.Parent = props
end

-- realistic pickup / tuning parts from blender/make_parts.py -&gt; ReplicatedStorage.PartModels
local PART_LOOK = {
	Rubber = { Enum.Material.SmoothPlastic, C(26, 26, 30), 0 }, Metal = { Enum.Material.Metal, C(160, 164, 172), 0.05 },
	Chrome = { Enum.Material.Metal, C(226, 230, 236), 0.35 }, Dark = { Enum.Material.Metal, C(34, 36, 42), 0 },
	Copper = { Enum.Material.Metal, C(190, 104, 56), 0.1 }, Accent = { Enum.Material.SmoothPlastic, C(214, 40, 36), 0.05 },
	Glow = { Enum.Material.Neon, C(60, 230, 255), 0 }, Carbon = { Enum.Material.SmoothPlastic, C(20, 20, 24), 0.08 },
	Blue = { Enum.Material.SmoothPlastic, C(30, 90, 220), 0.1 }, Gold = { Enum.Material.Metal, C(255, 190, 60), 0.3 },
	Green = { Enum.Material.SmoothPlastic, C(20, 110, 50), 0 },
}
local function installPart(m)
	local dest = ensure(ReplicatedStorage, "Folder", "PartModels")
	local old = dest:FindFirstChild(m.Name)
	if old then
		old:Destroy()
	end
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			local key = string.match(d.Name, "^(%a+)") or ""
			local look = PART_LOOK[key]
			if look then
				d.Name, d.Material, d.Color, d.Reflectance = key, look[1], look[2], look[3]
			end
			d.Anchored, d.CanCollide, d.CanQuery, d.CanTouch, d.CastShadow = false, false, false, false, false
		end
	end
	local bb, size = m:GetBoundingBox()
	m.WorldPivot = CFrame.new(bb.Position - Vector3.new(0, size.Y / 2, 0))
	m.Parent = dest
end

local function styleCar(model, def)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local key = string.match(d.Name, "^(%a+)") or d.Name
			local look = LOOK[key]
			if look then
				d.Name = key
				d.Material = look[1]
				d.Transparency = look[3]
				d.Reflectance = look[4]
				if look[2] then
					d.Color = look[2]
				elseif key == "Body" then
					d.Color = def and def.body or Color3.fromRGB(220, 60, 60)
					if def and def.chrome then
						d.Material = Enum.Material.Metal
						d.Reflectance = 0.4
					end
				elseif key == "Stripe" then
					local b = def and def.body or Color3.new(1, 0, 0)
					d.Color = (b.R + b.G + b.B &lt; 1.9) and C(242, 242, 242) or C(14, 14, 16)
				elseif key == "Neon" then
					d.Color = def and def.neon or Color3.fromRGB(40, 230, 255)
				end
			end
			d.Anchored = false
			d.CanCollide = false
			d.CastShadow = key ~= "Glass" and key ~= "Neon"
			if d:IsA("MeshPart") then
				d.RenderFidelity = Enum.RenderFidelity.Automatic
			end
		end
	end
end

function Tool.ApplyImported(container)
	local root = ensure(ReplicatedStorage, "Folder", "CarModels")
	local traffic = ensure(root, "Folder", "Traffic")
	local sources = container and { container } or Workspace:GetChildren()
	local moved = 0
	for _, src in ipairs(sources) do
		for _, m in ipairs(src:GetDescendants()) do
			if m:IsA("Model") then
				if PROPS[m.Name] then
					installProp(m)
					moved = moved + 1
					continue
				end
				if string.match(m.Name, "^Part_") or string.match(m.Name, "^Tune_") then
					installPart(m)
					moved = moved + 1
					continue
				end
				local def = CarConfig.ById[m.Name]
				local dest = def and root or (VehicleKinds[m.Name] and traffic) or nil
				if dest then
					local old = dest:FindFirstChild(m.Name)
					if old then
						old:Destroy()
					end
					styleCar(m, def)
					m:SetAttribute("Yaw", 0)
					m:SetAttribute("Recolor", def == nil)
					if def then
						m:SetAttribute("CarName", def.name)
						m:SetAttribute("Rarity", def.rarity)
					end
					m.Parent = dest
					moved = moved + 1
				end
			end
		end
	end
	print(string.format("[CarModels] ApplyImported: %d models installed", moved))
	Tool.Status()
end

function Tool.Preview()
	local VehicleFactory = require(Shared:WaitForChild("VehicleFactory"))
	local old = Workspace:FindFirstChild("CarModelPreview")
	if old then
		old:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = "CarModelPreview"
	f.Parent = Workspace
	for i, def in ipairs(CarConfig.List) do
		local m = VehicleFactory.BuildCar(def)
		m.Name = def.id
		m:PivotTo(CFrame.new(-190 + ((i - 1) % 10) * 40, 0.5, 30 + math.floor((i - 1) / 10) * 30))
		m.Parent = f
	end
	print("[CarModels] preview built in Workspace.CarModelPreview (nose points +X). Fix direction with the Yaw attribute.")
end

function Tool.ClearPreview()
	local old = Workspace:FindFirstChild("CarModelPreview")
	if old then
		old:Destroy()
	end
end

return Tool
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX41"><Properties><string name="Name">BuildCityMap</string><ProtectedString name="Source">local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local BaseLayout = require(Shared:WaitForChild("BaseLayout"))
local TrafficMath = require(Shared:WaitForChild("TrafficMath"))
local VehicleFactory = require(Shared:WaitForChild("VehicleFactory"))
local Prefabs = require(script.Parent:WaitForChild("MapPrefabs"))
local GarageKit = require(Shared:WaitForChild("GarageKit"))
local GarageStyle = GarageKit.Style
local function GarageBay(slotsFolder, model, bcf, n, topY)
	return GarageKit.Bay(slotsFolder, model, bcf, n, topY)
end

local C = Color3.fromRGB
local M = Enum.Material
local Part, Label = Prefabs.Part, Prefabs.Label
local pick, rr = Prefabs.Pick, Prefabs.RR
local HW = MapConfig.MapHalfWidth
local CYL = Enum.PartType.Cylinder
local TL = MapConfig.TunnelLength
local UPRIGHT = CFrame.Angles(0, 0, math.pi / 2)

local Build = {}

local TYPE_FOLDERS = { "Ground", "Roads", "Sidewalks", "Buildings", "StreetProps", "ZoneGates", "Bases", "TrafficRoutes", "PartSpawnPoints" }
local ALL_SECTIONS = { "World", "Plaza" }
local ZONE_OF = {}
for _, zid in ipairs(MapConfig.ZoneOrder) do
	table.insert(ALL_SECTIONS, string.upper(zid))
	ZONE_OF[string.upper(zid)] = zid
end

local function getRoot()
	local root = Workspace:FindFirstChild("GeneratedMap")
	if not root then
		root = Instance.new("Folder")
		root.Name = "GeneratedMap"
		root.Parent = Workspace
	end
	for _, name in ipairs(TYPE_FOLDERS) do
		if not root:FindFirstChild(name) then
			local f = Instance.new("Folder")
			f.Name = name
			f.Parent = root
		end
	end
	return root
end

local function clearSection(root, section)
	for _, name in ipairs(TYPE_FOLDERS) do
		local sub = root[name]:FindFirstChild(section)
		if sub then
			sub:Destroy()
		end
	end
end

local function newFolders(section)
	local t = {}
	for _, name in ipairs(TYPE_FOLDERS) do
		local f = Instance.new("Folder")
		f.Name = section
		t[name] = f
	end
	return t
end

local function inFootprint(foot, x, z, margin)
	for _, r in ipairs(foot) do
		if x &gt; r.x1 - margin and x &lt; r.x2 + margin and z &gt; r.z1 - margin and z &lt; r.z2 + margin then
			return true
		end
	end
	return false
end

local WHITE = C(240, 240, 245)
local YELLOW = C(255, 205, 40)

local function buildWorld(ctx)
	local f = ctx.f
	local zS, zE = MapConfig.StartZ, MapConfig.EndZ
	for z = zS - 700, zE + 700, 2000 do
		local len = math.min(2000, zE + 700 - z)
		Part(f.Ground, "WorldFloor", Vector3.new(2000, 2, len), CFrame.new(0, -2.2, z + len / 2), C(26, 28, 36), M.Concrete)
	end

	local openings = {}
	for _, r in ipairs(MapConfig.Roads) do
		table.insert(openings, { r.z - r.width / 2, r.z + r.width / 2, r })
	end
	table.sort(openings, function(a, b) return a[1] &lt; b[1] end)

	for _, sx in ipairs({ -1, 1 }) do
		local cursor = zS - 2
		local function seg(a, b)
			local len = b - a
			if len &gt; 0.5 then
				local zm = (a + b) / 2
				local zone = MapConfig.ZoneAt(zm)
				local col = (zone == "plaza") and C(140, 146, 160) or MapConfig.Zones[zone].palette.curb
				-- brick wall with stone piers, a light cap, a district-coloured band and a hedge strip in front
				local BRICK, STONE = C(158, 78, 60), C(214, 206, 192)
				Part(f.Buildings, "PerimeterWall", Vector3.new(4, 24, len), CFrame.new(sx * (HW + 2), 12, zm), BRICK, M.Brick)
				Part(f.Buildings, "WallCap", Vector3.new(4.8, 1, len), CFrame.new(sx * (HW + 2), 24.5, zm), STONE, M.Slate, { collide = false })
				Part(f.Buildings, "WallBand", Vector3.new(4.4, 1.4, len), CFrame.new(sx * (HW + 2), 5, zm), col, M.SmoothPlastic, { collide = false })
				Part(f.Buildings, "WallPlinth", Vector3.new(4.6, 1.6, len), CFrame.new(sx * (HW + 2), 0.8, zm), STONE, M.Slate, { collide = false })
				local n = math.max(1, math.floor(len / 24))
				for k = 0, n do
					local pz = a + k * len / n
					Part(f.Buildings, "WallPier", Vector3.new(6, 26, 6), CFrame.new(sx * (HW + 2), 13, pz), STONE, M.Slate)
					Part(f.Buildings, "PierCap", Vector3.new(7, 1.2, 7), CFrame.new(sx * (HW + 2), 26.6, pz), C(232, 226, 214), M.Slate, { collide = false })
				end
				if len &gt; 10 then
					Part(f.Buildings, "Hedge", Vector3.new(3, 3.2, len - 8), CFrame.new(sx * (HW - 2.5), 1.6, zm), C(72, 140, 70), M.Grass)
				end
			end
		end
		for _, o in ipairs(openings) do
			seg(cursor, o[1])
			cursor = o[2]
			local W = o[3].width
			local z0 = o[3].z
			local zone = MapConfig.Zones[o[3].zone]
			Part(f.Buildings, "TunnelLintel", Vector3.new(4, 16, W), CFrame.new(sx * (HW + 2), 18, z0), zone.palette.curb, M.Concrete)
			for k = 0, 7 do
				Part(f.Buildings, "TunnelHazard", Vector3.new(4.5, 0.9, W / 8), CFrame.new(sx * (HW + 2), 10.4, z0 - W / 2 + (k + 0.5) * W / 8), (k % 2 == 0) and C(255, 196, 40) or C(28, 28, 30), M.SmoothPlastic, { collide = false })
			end
			Part(f.Buildings, "TunnelCeiling", Vector3.new(TL, 2, W + 8), CFrame.new(sx * (HW + 2 + TL / 2), 11, z0), C(22, 22, 28), M.Concrete)
			Part(f.Buildings, "TunnelWallA", Vector3.new(TL, 12, 2), CFrame.new(sx * (HW + 2 + TL / 2), 6, z0 + W / 2 + 1), C(22, 22, 28), M.Concrete)
			Part(f.Buildings, "TunnelWallB", Vector3.new(TL, 12, 2), CFrame.new(sx * (HW + 2 + TL / 2), 6, z0 - W / 2 - 1), C(22, 22, 28), M.Concrete)
			Part(f.Buildings, "TunnelBlocker", Vector3.new(2, 16, W), CFrame.new(sx * (HW - 1), 8, z0), C(255, 255, 255), M.SmoothPlastic, { t = 1, cast = false })
		end
		seg(cursor, zE + 2)

		local z = zS
		while z &lt; zE do
			local zone = MapConfig.ZoneAt(z)
			local pal = (zone == "plaza") and { buildings = { C(120, 130, 150), C(150, 160, 180) }, accent = C(80, 200, 255) } or MapConfig.Zones[zone].palette
			local w, d, h = rr(ctx.rng, 24, 44), rr(ctx.rng, 24, 40), rr(ctx.rng, 40, 100)
			local cx = sx * (HW + 92 + rr(ctx.rng, 0, 40))
			local tower = Part(f.Buildings, "Backdrop", Vector3.new(d, h, w), CFrame.new(cx, h / 2 - 1, z), pick(ctx.rng, pal.buildings), M.SmoothPlastic, { cast = false })
			for y = 8, h - 6, 7 do
				Part(f.Buildings, "BackdropWindows", Vector3.new(d + 0.2, 2.6, w * 0.8), CFrame.new(cx, y, z), C(70, 96, 120), M.Glass, { cast = false, collide = false, t = 0.1 })
			end
			z = z + 58 + rr(ctx.rng, 0, 14)
		end
	end
	local crng = ctx.rng
	for _ = 1, math.floor(44 * MapConfig.DecorationDensity + 10) do
		Prefabs.Cloud(f.StreetProps, Vector3.new(rr(crng, -520, 520), rr(crng, 150, 230), rr(crng, zS - 200, zE + 200)), crng)
	end
	for _, ez in ipairs({ zS - 2, zE + 2 }) do
		Part(f.Buildings, "EndWall", Vector3.new(2 * HW + 8, 24, 4), CFrame.new(0, 12, ez), C(158, 78, 60), M.Brick)
		Part(f.Buildings, "EndWallCap", Vector3.new(2 * HW + 8, 1, 4.8), CFrame.new(0, 24.5, ez), C(214, 206, 192), M.Slate, { collide = false })
		for x = -HW, HW, 24 do
			Part(f.Buildings, "WallPier", Vector3.new(6, 26, 6), CFrame.new(x, 13, ez), C(214, 206, 192), M.Slate)
			Part(f.Buildings, "PierCap", Vector3.new(7, 1.2, 7), CFrame.new(x, 26.6, ez), C(232, 226, 214), M.Slate, { collide = false })
		end
	end
	local fin = Part(f.Buildings, "EndSign", Vector3.new(120, 14, 1.2), CFrame.new(0, 19, zE - 1.5), C(26, 30, 38), M.SmoothPlastic)
	Label(fin, Enum.NormalId.Front, "END OF THE CITY", C(255, 210, 60))
end

-- Garage v2: clean showroom. Ground floor is static; floors 2-4 are added by BaseService (GarageFloors).
-- Rule against texture flicker: no two visible faces share a plane; overlays sit &gt;= 0.02 above what they cover.
local function buildBase(ctx, i)
	local f = ctx.f
	local bcf = BaseLayout.GetBaseCFrame(i)
	local model = Instance.new("Model")
	model.Name = string.format("Base%02d", i)
	model:SetAttribute("Index", i)
	local function mk(name, size, off, color, mat, o)
		return Part(model, name, size, bcf * CFrame.new(off), color, mat, o)
	end
	local G = GarageStyle
	local PX, PZ = MapConfig.BasePlot.x / 2, MapConfig.BasePlot.z / 2
	local EDGE = BaseLayout.DeckEdgeX
	local deckW = EDGE + PX -- deck depth along X
	local deckCX = (EDGE - PX) / 2
	local H = BaseLayout.FloorHeight

	-- floor: polished slab + darker showroom inlay under the deck
	mk("Floor", Vector3.new(PX * 2, 1, PZ * 2), Vector3.new(0, 0, 0), G.floor, M.SmoothPlastic, { refl = 0.04 })
	mk("Inlay", Vector3.new(deckW, 0.1, PZ * 2), Vector3.new(deckCX, 0.55, 0), G.inlay, M.SmoothPlastic)
	mk("DriveLine", Vector3.new(0.4, 0.1, PZ * 2 - 6), Vector3.new(BaseLayout.LaneX, 0.55, 0), G.line, M.SmoothPlastic, { collide = false, cast = false })

	local slots = Instance.new("Folder")
	slots.Name = "Slots"
	slots.Parent = model
	for n = 1, BaseLayout.SlotsPerFloor do
		GarageBay(slots, model, bcf, n, 0.6)
	end

	-- shell: charcoal back wall, side fins, white roof deck with black fascia (owner sign lives on it)
	-- walls stop under the roof slab so no faces are shared with it
	mk("BackWall", Vector3.new(2, H - 1, PZ * 2), Vector3.new(-PX + 1, H / 2, 0), G.wall, M.SmoothPlastic)
	for _, s in ipairs({ -1, 1 }) do
		mk("SideFin", Vector3.new(deckW - 2, H - 1, 0.8), Vector3.new(deckCX + 1, H / 2, s * (PZ - 0.6)), G.wall, M.SmoothPlastic)
	end
	mk("Roof", Vector3.new(deckW, 1, PZ * 2), Vector3.new(deckCX, H, 0), G.deck, M.SmoothPlastic)
	local fascia = mk("OwnerSign", Vector3.new(1.2, 2.4, PZ * 2 + 0.4), Vector3.new(EDGE + 0.4, H + 0.2, 0), G.frame, M.SmoothPlastic)
	Label(fascia, Enum.NormalId.Right, "FREE GARAGE", C(255, 255, 255))
	local screen = mk("IncomeScreen", Vector3.new(0.4, 2.4, 24), Vector3.new(EDGE + 1.2, H - 2.1, 0), G.frame, M.SmoothPlastic)
	Label(screen, Enum.NormalId.Right, "", C(110, 230, 140))
	for _, z in ipairs({ -PZ + 1, -15.5, 15.5, PZ - 1 }) do
		mk("Column", Vector3.new(1.2, H - 1, 1.2), Vector3.new(EDGE - 0.8, H / 2, z), G.frame, M.Metal)
	end
	for _, z in ipairs({ -30, 0, 30 }) do
		local lamp = mk("CeilingLight", Vector3.new(12, 0.24, 1.6), Vector3.new(-31, H - 0.56, z), C(255, 244, 222), M.Neon, { collide = false, cast = false, light = true })
		local sl = Instance.new("SurfaceLight")
		sl.Face = Enum.NormalId.Bottom
		sl.Range = 18
		sl.Brightness = 1.1
		sl.Angle = 100
		sl.Color = C(255, 238, 210)
		sl.Parent = lamp
	end

	-- lift shaft (ground stage) to the upper floors
	local el = BaseLayout.ElevatorLocal
	mk("ElevatorPad", Vector3.new(8, 0.4, 8), Vector3.new(el.X, 0.7, el.Z), G.frame, M.Metal)
	GarageKit.Lift(mk, 0.5, H, G.frame, G.accent)

	-- the trap: a clean steel car lift with a magnetic crane
	local t = BaseLayout.TrapLocal
	-- v13 look: a stepped stage (dark plinth + steel deck), hazard bands on the deck's SIDE faces (never laid on a top
	-- face, so nothing can shimmer), a lamp on every post
	mk("TrapBase", Vector3.new(21, 0.5, 21), Vector3.new(t.X, 0.75, t.Z), C(40, 42, 48), M.Metal)
	mk("TrapPad", Vector3.new(18, 0.8, 18), Vector3.new(t.X, 1.2, t.Z), C(96, 100, 108), M.DiamondPlate)
	for _, s in ipairs({ -1, 1 }) do
		mk("TrapEdge", Vector3.new(18.2, 0.5, 0.3), Vector3.new(t.X, 1.3, t.Z + s * 9.05), G.accent, M.SmoothPlastic, { collide = false, cast = false })
		mk("TrapEdge", Vector3.new(0.3, 0.5, 17.8), Vector3.new(t.X + s * 9.05, 1.3, t.Z), G.accent, M.SmoothPlastic, { collide = false, cast = false })
	end
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			mk("LiftPost", Vector3.new(1.2, 13, 1.2), Vector3.new(t.X + sx * 9.6, 7, t.Z + sz * 9.6), G.accent2, M.Metal)
			local lamp = mk("TrapLamp", Vector3.new(0.8, 0.5, 0.8), Vector3.new(t.X + sx * 9.6, 14.7, t.Z + sz * 9.6), C(255, 236, 190), M.Neon, { collide = false, cast = false })
			local pl = Instance.new("PointLight")
			pl.Range, pl.Brightness, pl.Color = 12, 0.8, C(255, 236, 190)
			pl.Parent = lamp
		end
		mk("LiftBeam", Vector3.new(1, 1, 20.4), Vector3.new(t.X + sx * 9.6, 14, t.Z), G.accent2, M.Metal)
	end
	mk("CraneBeam", Vector3.new(20.4, 1.2, 1.2), Vector3.new(t.X, 14.2, t.Z), G.frame, M.Metal)
	mk("CraneCable", Vector3.new(0.2, 3.4, 0.2), Vector3.new(t.X, 12, t.Z), G.frame, M.Metal, { collide = false })
	local magnet = mk("TrapMagnet", Vector3.new(1.2, 6, 6), Vector3.new(t.X, 9.8, t.Z), C(64, 68, 76), M.Metal, { shape = CYL, collide = false })
	magnet.CFrame = bcf * CFrame.new(t.X, 9.8, t.Z) * UPRIGHT
	local trapSign = mk("TrapSign", Vector3.new(0.4, 2.4, 12), Vector3.new(t.X + 10.2, 13.2, t.Z), G.frame, M.SmoothPlastic)
	Label(trapSign, Enum.NormalId.Right, "THROW PARTS HERE", G.accent)

	-- (v11: no drive-in arch / "new cars" sign at the garage entrance; new cars still drive in through the opening)

	-- privacy: invisible walls around the plot; each client makes them solid only for OTHER players' garages
	for _, w in ipairs({
		{ Vector3.new(1, 30, PZ * 2), Vector3.new(PX + 0.5, 15, 0) }, { Vector3.new(1, 30, PZ * 2), Vector3.new(-PX - 0.5, 15, 0) },
		{ Vector3.new(PX * 2, 30, 1), Vector3.new(0, 15, PZ + 0.5) }, { Vector3.new(PX * 2, 30, 1), Vector3.new(0, 15, -PZ - 0.5) },
	}) do
		local pw = mk("PrivacyWall", w[1], w[2], C(255, 255, 255), M.SmoothPlastic, { t = 1, collide = false, cast = false })
		pw.CanQuery = false
		pw:SetAttribute("BaseIndex", i)
	end

	-- garage terminal (menu)
	local tm = BaseLayout.TerminalLocal
	mk("Terminal", Vector3.new(2.4, 4, 4), Vector3.new(tm.X, 2.5, tm.Z), G.frame, M.SmoothPlastic)
	local scr = mk("TerminalScreen", Vector3.new(0.3, 2.4, 3.6), Vector3.new(tm.X + 1.36, 3.4, tm.Z), C(16, 18, 22), M.SmoothPlastic)
	Label(scr, Enum.NormalId.Right, "GARAGE", G.accent)

	local sp = Instance.new("SpawnLocation")
	sp.Name = "Spawn"
	sp.Size = Vector3.new(8, 0.4, 8)
	sp.CFrame = bcf * CFrame.new(BaseLayout.SpawnLocal.X, 0.6, BaseLayout.SpawnLocal.Z)
	sp.Anchored = true
	sp.Neutral = true
	sp.Duration = 0
	sp.Transparency = 1
	sp.CanCollide = false
	sp.Parent = model
	Prefabs.Count = Prefabs.Count + 1

	local cars = Instance.new("Folder")
	cars.Name = "Cars"
	cars.Parent = model
	local floors = Instance.new("Folder")
	floors.Name = "Floors"
	floors.Parent = model
	Prefabs.Lamp(model, bcf:PointToWorldSpace(Vector3.new(PX - 1.5, 0.5, PZ - 3)), 1, C(255, 230, 180), math.pi)
	Prefabs.Lamp(model, bcf:PointToWorldSpace(Vector3.new(PX - 1.5, 0.5, -PZ + 3)), 1, C(255, 230, 180), math.pi)
	model.Parent = f.Bases
end

local function nearBaseRow(z, pad)
	for i = 1, #MapConfig.BaseCenters, 2 do
		if math.abs(z - MapConfig.BaseCenters[i].z) &lt; pad then
			return true
		end
	end
	return false
end

-- Pit Stop: upgrade shop with a mechanic NPC (NPC itself is spawned by ShopService at runtime)
local function buildShop(ctx)
	local f = ctx.f
	local cfg = MapConfig.Shop
	local cf = CFrame.new(cfg.x, 0.2, cfg.z) * CFrame.Angles(0, cfg.yaw, 0) -- local -Z = front
	local m = Instance.new("Model")
	m.Name = "PitStopShop"
	local function mk(name, size, off, color, mat, o)
		return Part(m, name, size, cf * CFrame.new(off), color, mat, o)
	end
	-- compact kiosk 12 x 8: walls never share a visible plane, the roof caps them
	local W, D, H = 12, 8, 8.5
	local G = 0.5 -- top of the slab
	local RED, WHITE, DARK2, WOOD = C(214, 52, 44), C(246, 244, 238), C(36, 40, 48), C(150, 104, 62)
	mk("Slab", Vector3.new(18, 0.6, 16), Vector3.new(0, 0.2, -2), C(206, 204, 198), M.SmoothPlastic)
	mk("BackWall", Vector3.new(W, H, 0.6), Vector3.new(0, G + H / 2, D / 2 - 0.3), WHITE)
	for _, sx in ipairs({ -1, 1 }) do
		mk("SideWall", Vector3.new(0.6, H, D - 0.6), Vector3.new(sx * (W / 2 - 0.3), G + H / 2, -0.3), WHITE)
		mk("Corner", Vector3.new(0.8, H + 0.4, 0.8), Vector3.new(sx * (W / 2 - 0.2), G + (H + 0.4) / 2, -D / 2 + 0.2), RED)
	end
	mk("Counter", Vector3.new(W - 1.6, 3.6, 1.1), Vector3.new(0, G + 1.8, -D / 2 + 0.75), RED)
	mk("CounterTop", Vector3.new(W - 1.2, 0.3, 1.8), Vector3.new(0, G + 3.75, -D / 2 + 0.7), WOOD, M.Wood)
	mk("Header", Vector3.new(W - 1.6, 1.6, 0.5), Vector3.new(0, G + H - 0.8, -D / 2 + 0.45), DARK2)
	mk("Roof", Vector3.new(W + 1.6, 0.6, D + 2), Vector3.new(0, G + H + 0.3, -0.6), DARK2)
	mk("RoofTrim", Vector3.new(W + 1.8, 0.3, 0.3), Vector3.new(0, G + H + 0.15, -D / 2 - 1.75), C(255, 196, 40))
	-- red/white awning over the counter
	for k = 0, 5 do
		Part(m, "Awning", Vector3.new(W / 6, 0.25, 3.2), cf * CFrame.new(-W / 2 + (k + 0.5) * W / 6, G + H - 1.9, -D / 2 - 1.3) * CFrame.Angles(math.rad(-18), 0, 0),
			(k % 2 == 0) and RED or WHITE, M.SmoothPlastic, { collide = false })
	end
	-- sign on the roof
	local sign = mk("ShopSign", Vector3.new(W - 1, 2.6, 0.5), Vector3.new(0, G + H + 1.9, -D / 2 + 0.6), DARK2)
	Label(sign, Enum.NormalId.Front, "PIT STOP", C(255, 210, 63))
	-- back shelves with parts for sale
	for k, y in ipairs({ 3.2, 5.6 }) do
		mk("Shelf", Vector3.new(W - 2.4, 0.25, 1.2), Vector3.new(0, G + y, D / 2 - 1.2), WOOD, M.Wood)
		for i = 0, 3 do
			local x = -W / 2 + 2.2 + i * 2.5
			if (i + k) % 2 == 0 then
				Part(m, "ShelfTire", Vector3.new(0.7, 1.5, 1.5), cf * CFrame.new(x, G + y + 0.88, D / 2 - 1.2) * CFrame.Angles(0, math.pi / 2, 0), C(34, 34, 38), M.SmoothPlastic, { shape = CYL, collide = false })
			else
				mk("OilCan", Vector3.new(0.8, 1.2, 0.6), Vector3.new(x, G + y + 0.73, D / 2 - 1.2), ({ C(255, 196, 40), C(40, 120, 200), C(50, 160, 80), RED })[i + 1], M.SmoothPlastic, { collide = false })
			end
		end
	end
	-- warm light inside
	local bulb = mk("KioskLight", Vector3.new(0.4, 0.4, 0.4), Vector3.new(0, G + H - 0.6, 0.5), C(255, 240, 210), M.SmoothPlastic, { collide = false, t = 1 })
	local l = Instance.new("PointLight")
	l.Range = 14
	l.Brightness = 1.3
	l.Color = C(255, 230, 190)
	l.Parent = bulb
	Prefabs.TireStack(m, cf:PointToWorldSpace(Vector3.new(-W / 2 - 1.6, G, -2)), ctx.rng)
	local npcSpot = mk("NpcSpot", Vector3.new(2, 0.2, 2), Vector3.new(0, G + 0.1, 0.4), WHITE, M.SmoothPlastic, { t = 1, collide = false })
	npcSpot:SetAttribute("Yaw", cfg.yaw)
	local prompt = mk("ShopPrompt", Vector3.new(6, 6, 2), Vector3.new(0, 3.5, -D / 2 - 2.4), WHITE, M.SmoothPlastic, { t = 1, collide = false })
	CollectionService:AddTag(prompt, "ShopPrompt")
	m.Parent = f.Buildings
end

-- Golden Magnate donation stall (the animated NPC is spawned by DonateService)
local function buildDonateStall(ctx)
	local f = ctx.f
	local cfg = MapConfig.DonateStall
	local cf = CFrame.new(cfg.x, 0.2, cfg.z) * CFrame.Angles(0, cfg.yaw, 0)
	local m = Instance.new("Model")
	m.Name = "MagnateStall"
	local function mk(name, size, off, color, mat, o)
		return Part(m, name, size, cf * CFrame.new(off), color, mat, o)
	end
	local GOLD, DEEP, CREAM, WOOD = C(232, 178, 50), C(28, 32, 44), C(250, 240, 214), C(110, 70, 40)
	mk("Rug", Vector3.new(18, 0.12, 14), Vector3.new(0, 0.15, -2), C(150, 30, 40), M.Fabric, { collide = false })
	mk("Counter", Vector3.new(14, 4, 3.4), Vector3.new(0, 2.2, -4), WOOD, M.Wood)
	mk("CounterTop", Vector3.new(14.6, 0.5, 4), Vector3.new(0, 4.4, -4), GOLD, M.Metal, { refl = 0.25 })
	mk("BackPanel", Vector3.new(14, 11, 1), Vector3.new(0, 5.7, 4), DEEP, M.SmoothPlastic)
	for _, s in ipairs({ -1, 1 }) do
		mk("Pillar", Vector3.new(1.2, 13.5, 1.2), Vector3.new(s * 7.4, 6.75, 4), GOLD, M.Metal, { refl = 0.2 })
		mk("PillarFront", Vector3.new(1, 11, 1), Vector3.new(s * 7.4, 5.5, -5.6), GOLD, M.Metal, { refl = 0.2 })
	end
	for k = 0, 6 do
		local c = (k % 2 == 0) and GOLD or CREAM
		Part(m, "Canopy", Vector3.new(16 / 7, 0.4, 11), cf * CFrame.new(-8 + (k + 0.5) * 16 / 7, 12.2, -0.8) * CFrame.Angles(math.rad(-10), 0, 0), c, M.SmoothPlastic, { collide = false })
	end
	local sign = mk("StallSign", Vector3.new(16.4, 3, 0.8), Vector3.new(0, 14.9, 4), DEEP, M.SmoothPlastic)
	Label(sign, Enum.NormalId.Front, "GOLDEN MAGNATE", GOLD)
	-- treasure: coin piles and gold bars
	for k = 0, 4 do
		local c = mk("Coins", Vector3.new(0.6, 1.4, 1.4), Vector3.new(-5 + k * 2.4, 5, -4), GOLD, M.Metal, { shape = CYL, refl = 0.3, collide = false })
		c.CFrame = cf * CFrame.new(-5 + k * 2.4, 4.95 + (k % 2) * 0.3, -4) * UPRIGHT
	end
	for k = 0, 2 do
		mk("GoldBar", Vector3.new(2, 0.7, 1), Vector3.new(-1.5 + k * 1.5, 1.2 + (k == 1 and 0.7 or 0), 1.5), GOLD, M.Metal, { refl = 0.35 })
	end
	local spot = mk("NpcSpot", Vector3.new(2, 0.2, 2), Vector3.new(0, 0.5, 1.6), CREAM, M.SmoothPlastic, { t = 1, collide = false })
	spot:SetAttribute("Yaw", cfg.yaw)
	local prompt = mk("DonatePrompt", Vector3.new(6, 6, 2), Vector3.new(0, 3.5, -7), CREAM, M.SmoothPlastic, { t = 1, collide = false })
	CollectionService:AddTag(prompt, "DonatePrompt")
	local glow = mk("StallLight", Vector3.new(0.6, 0.6, 0.6), Vector3.new(0, 11.4, -3), C(255, 220, 150), M.Neon, { light = true, collide = false })
	local l = Instance.new("PointLight")
	l.Range = 18
	l.Brightness = 1.6
	l.Color = C(255, 210, 120)
	l.Parent = glow
	m.Parent = f.Buildings
end


local function buildPlaza(ctx)
	local f = ctx.f
	local P = MapConfig.Plaza
	local PW = MapConfig.PromenadeHalfWidth
	local zS, zE = MapConfig.StartZ, MapConfig.EntryZ
	local len = zE - zS
	local zm = (zS + zE) / 2
	Part(f.Ground, "PlazaGround", Vector3.new(2 * HW, 2, len), CFrame.new(0, -1, zm), P.ground, M.Grass)
	-- safe-zone floor (v11): light warm stone pavers. Joints are real 0.25-stud gaps over a darker base
	-- (no coplanar overlays -&gt; no flicker), a slate border along the curbs.
	local pz0, pz1 = zS + 2, zE - 4
	local nx = math.floor(2 * PW / 12)
	local sx = 2 * PW / nx
	local nz = math.floor((pz1 - pz0) / 12)
	local sz = (pz1 - pz0) / nz
	local STONE1, STONE2, JOINT, BORDER = C(214, 206, 192), C(200, 192, 178), C(124, 118, 110), C(120, 116, 110)
	Part(f.Ground, "PavingBase", Vector3.new(2 * PW, 0.3, pz1 - pz0), CFrame.new(0, -0.05, (pz0 + pz1) / 2), JOINT, M.Slate, { cast = false })
	for i = 0, nx - 1 do
		for j = 0, nz - 1 do
			local edge = i == 0 or i == nx - 1
			local col = edge and BORDER or (((i + j) % 2 == 0) and STONE1 or STONE2)
			local gap = edge and 0 or 0.25
			Part(f.Ground, "Paving", Vector3.new(sx - gap, 0.4, sz - gap), CFrame.new(-PW + (i + 0.5) * sx, 0, pz0 + (j + 0.5) * sz), col,
				edge and M.Slate or M.Pavement, { cast = false })
		end
	end
	for _, s in ipairs({ -1, 1 }) do
		Part(f.Ground, "Curb", Vector3.new(1.2, 0.6, len - 6), CFrame.new(s * PW, 0.3, zm - 1), C(150, 150, 146), M.Concrete)
	end

	for i = 1, MapConfig.BaseCount do
		buildBase(ctx, i)
	end
	buildShop(ctx)
	buildDonateStall(ctx)

	-- entry: Blender finish arch (truss towers, checkered banner, start lights) with a lit sign
	local function tpl(name, cf, fallback)
		local m = Prefabs.FromTemplate(name, f.Buildings, cf)
		if not m and fallback then
			fallback()
		end
		return m
	end
	tpl("FinishArch", CFrame.new(0, 0.2, zE - 4) * CFrame.Angles(0, math.pi, 0), function()
		for _, s in ipairs({ -1, 1 }) do
			Part(f.Buildings, "ArchPillar", Vector3.new(3, 24, 3), CFrame.new(s * 40, 12, zE - 4), C(52, 56, 64), M.Metal)
		end
		Part(f.Buildings, "ArchBeam", Vector3.new(83, 3, 3), CFrame.new(0, 24, zE - 4), C(26, 30, 38), M.SmoothPlastic)
		Prefabs.Checker(f.Buildings, CFrame.new(0, 20.4, zE - 4), 80, 2.4, 2.8)
	end)
	-- sign sits on top of the arch (mesh top ~27.6): bottom at 28.0, nothing intersects it
	local archSign = Part(f.Buildings, "ArchSign", Vector3.new(40, 4.4, 0.8), CFrame.new(0, 30.2, zE - 4), C(20, 24, 34), M.SmoothPlastic)
	Label(archSign, Enum.NormalId.Back, "CAR HUNTERS", C(255, 210, 63))
	Label(archSign, Enum.NormalId.Front, "SAFE ZONE", C(255, 255, 255))
	for _, s in ipairs({ -1, 1 }) do
		Part(f.Buildings, "ArchSignFoot", Vector3.new(1.2, 0.4, 0.8), CFrame.new(s * 16, 27.8, zE - 4), C(40, 44, 52), M.Metal)
	end

	-- leaderboard (v14, built here, no Blender frame): one big screen between two pillars, and the top-3 podium as a
	-- separate island in front of it, so nothing is squeezed. Local +Z faces the incoming players.
	local lb = MapConfig.Leaderboard
	local lbcf = CFrame.new(lb.x, 0.2, lb.z) * CFrame.Angles(0, math.pi, 0)
	local lbModel = Instance.new("Model")
	lbModel.Name = "LeaderboardStand"
	local function lp(name, size, off, color, mat, o)
		return Part(lbModel, name, size, lbcf * CFrame.new(off), color, mat, o)
	end
	local LBGOLD, LBDARK = C(232, 178, 50), C(30, 32, 40)
	for _, s in ipairs({ -1, 1 }) do
		lp("LBPillar", Vector3.new(2.2, 19, 2.2), Vector3.new(s * 14, 9.5, 0), LBDARK, M.Metal) -- flanks the screen (0.1 overlap)
		lp("LBPillarCap", Vector3.new(2.8, 0.6, 2.8), Vector3.new(s * 14, 19.3, 0), LBGOLD, M.Metal)
	end
	lp("LBFrame", Vector3.new(27, 14, 0.4), Vector3.new(0, 11.5, -0.4), LBGOLD, M.Metal) -- gold rim behind the screen
	-- the screen itself (LeaderboardService draws on its +Z face)
	local screen = lp("LeaderboardScreen", Vector3.new(26, 13, 0.6), Vector3.new(0, 11.5, 0), C(12, 14, 20), M.SmoothPlastic)
	screen:SetAttribute("Facing", "Back")
	CollectionService:AddTag(screen, "LeaderboardScreen")
	-- podium island 14 studs in front: 2nd | 1st | 3rd with big numbers on the fronts
	lp("PodiumBase", Vector3.new(22, 0.6, 9), Vector3.new(0, 0.3, 14), C(236, 232, 224), M.Marble)
	for i, st in ipairs({ { 0, 4.5, LBGOLD }, { -6.5, 3, C(206, 210, 218) }, { 6.5, 2, C(200, 126, 72) } }) do
		local step = lp("PodiumStep" .. i, Vector3.new(6, st[2], 6), Vector3.new(st[1], 0.6 + st[2] / 2, 14), st[3], M.SmoothPlastic)
		Label(step, Enum.NormalId.Back, tostring(i), C(255, 255, 255))
		local spot = lp("StatueSpot" .. i, Vector3.new(2, 0.2, 2), Vector3.new(st[1], 0.7 + st[2], 14), C(255, 255, 255), M.SmoothPlastic, { t = 1, collide = false })
		spot:SetAttribute("Rank", i)
		spot:SetAttribute("Yaw", math.pi)
	end
	lbModel.Parent = f.StreetProps
	table.insert(ctx.foot, { x1 = lb.x - 16, x2 = lb.x + 16, z1 = lb.z - 19, z2 = lb.z + 2 })

	-- contracts stand: lit board with three job cards + Big Tony's spot (NPC spawned by MechanicService)
	local cb = MapConfig.ContractBoard
	local st = Instance.new("Model")
	st.Name = "ContractStand"
	local bcf = CFrame.new(cb.x, 0.4, cb.z) -- front faces -Z
	local function sp(name, size, off, color, mat, o)
		return Part(st, name, size, bcf * CFrame.new(off), color, mat, o)
	end
	local STEEL, WOODD, CREAM2, ORANGE = C(40, 44, 52), C(96, 62, 36), C(250, 240, 214), C(240, 120, 30)
	sp("StandBase", Vector3.new(30, 0.5, 9), Vector3.new(-4, 0.25, 0.5), C(196, 194, 188), M.SmoothPlastic)
	for _, x in ipairs({ -11, 11 }) do
		sp("StandPost", Vector3.new(1.2, 13.5, 1.2), Vector3.new(x, 0.5 + 6.75, 1), STEEL, M.Metal)
	end
	local panel = sp("ContractBoard", Vector3.new(21, 9.5, 0.8), Vector3.new(0, 7.3, 1), WOODD, M.Wood)
	CollectionService:AddTag(panel, "ContractBoard")
	local head = sp("BoardHeader", Vector3.new(24, 2.6, 1.4), Vector3.new(0, 13.4, 1), ORANGE, M.SmoothPlastic)
	Label(head, Enum.NormalId.Front, "CONTRACTS", C(255, 255, 255))
	sp("HeaderTrim", Vector3.new(24.4, 0.35, 1.6), Vector3.new(0, 12, 1), STEEL, M.Metal)
	for i, x in ipairs({ -6.8, 0, 6.8 }) do
		local card = sp("ContractCard" .. i, Vector3.new(6, 7.4, 0.2), Vector3.new(x, 7.1, 0.45), CREAM2, M.SmoothPlastic)
		card:SetAttribute("Index", i)
		CollectionService:AddTag(card, "ContractCard")
		sp("CardPin", Vector3.new(0.35, 0.5, 0.5), Vector3.new(x, 10.5, 0.2), C(214, 52, 44), M.SmoothPlastic, { shape = CYL, collide = false })
	end
	-- two arm lamps light the cards
	for _, x in ipairs({ -6, 6 }) do
		sp("LampArm", Vector3.new(0.3, 0.3, 2.6), Vector3.new(x, 12, -0.6), STEEL, M.Metal, { collide = false })
		local shade = sp("LampShade", Vector3.new(1.4, 0.6, 1), Vector3.new(x, 11.7, -1.9), STEEL, M.Metal, { collide = false })
		local sl = Instance.new("SpotLight")
		sl.Face = Enum.NormalId.Bottom
		sl.Angle = 80
		sl.Range = 14
		sl.Brightness = 2.2
		sl.Color = C(255, 236, 200)
		sl.Parent = shade
	end
	-- Big Tony's corner: gold-trimmed tool chest and a chrome car jack
	local TX, TZ = -15, -1
	sp("ToolChest", Vector3.new(3, 4, 2), Vector3.new(TX - 2.8, 0.5 + 2, TZ + 3), C(200, 30, 36), M.SmoothPlastic)
	for k = 0, 3 do
		sp("ChestHandle", Vector3.new(2, 0.15, 0.2), Vector3.new(TX - 2.8, 1.3 + k * 0.9, TZ + 1.93), C(240, 190, 60), M.Metal, { collide = false })
	end
	sp("Jack", Vector3.new(2.4, 0.5, 1), Vector3.new(TX + 2.4, 0.75, TZ + 2), C(220, 222, 228), M.Metal, { refl = 0.3 })
	local spot = sp("TonySpot", Vector3.new(2, 0.2, 2), Vector3.new(TX, 0.6, TZ), CREAM2, M.SmoothPlastic, { t = 1, collide = false })
	spot:SetAttribute("Yaw", 0)
	local tp = sp("TonyPrompt", Vector3.new(6, 6, 4), Vector3.new(TX, 3.5, TZ - 3), CREAM2, M.SmoothPlastic, { t = 1, collide = false })
	CollectionService:AddTag(tp, "TonyPrompt")
	st.Parent = f.StreetProps

	-- three themed areas along the promenade; everything stays clear of the central running lanes (|x| &lt; 9)
	-- and of the garage connector lanes (base rows +-9)
	local function clearOfRows(z, pad)
		return not nearBaseRow(z, pad or 9)
	end
	local function lamp(x, z, yaw)
		if not Prefabs.FromTemplate("StreetLamp", f.StreetProps, CFrame.new(x, 0.2, z) * CFrame.Angles(0, yaw or 0, 0)) then
			Prefabs.Lamp(f.StreetProps, Vector3.new(x, 0.4, z), 1, C(255, 228, 180), yaw or 0)
		end
	end
	local function planter(x, z)
		if not Prefabs.FromTemplate("Planter", f.StreetProps, CFrame.new(x, 0.2, z)) then
			Prefabs.Tree(f.StreetProps, Vector3.new(x, 0.4, z), ctx.rng, "palm")
		end
	end
	local function bench(x, z, yaw)
		if not Prefabs.FromTemplate("Bench", f.StreetProps, CFrame.new(x, 0.2, z) * CFrame.Angles(0, yaw, 0)) then
			Prefabs.Bench(f.StreetProps, Vector3.new(x, 0.4, z), yaw)
		end
	end
	-- promenade edges: lamps + palms in a steady rhythm
	local toggle = false
	for z = zS + 14, zE - 30, 22 do
		if clearOfRows(z, 10) then
			toggle = not toggle
			for _, sx in ipairs({ -1, 1 }) do
				if toggle then
					lamp(sx * (PW - 5), z, sx &lt; 0 and 0 or math.pi)
				else
					planter(sx * (PW - 6), z)
				end
			end
		end
	end

	-- 1) STREET CAR MEET (near the first garages): string lights, food truck, tuned cars, benches
	local meetZ1, meetZ2 = zS + 6, MapConfig.BaseCenters[3].z - 12
	for z = meetZ1 + 6, meetZ2, 18 do
		if clearOfRows(z) then
			for _, sx in ipairs({ -1, 1 }) do
				Prefabs.FromTemplate("StringLightPole", f.StreetProps, CFrame.new(sx * 16, 0.2, z) * CFrame.Angles(0, math.pi / 2, 0))
			end
		end
	end
	Prefabs.FromTemplate("FoodTruck", f.Buildings, CFrame.new(-42, 0.2, zS + 26) * CFrame.Angles(0, math.pi / 2, 0))
	-- (v13: no parked cars in the safe zone - only the Golden Magnat GT on its podium; planters instead)
	for _, p in ipairs({ { 38, zS + 22 }, { 40, zS + 85 } }) do
		Prefabs.FlowerBed(f.StreetProps, Vector3.new(p[1], 0.2, p[2]), 8, 5, ctx.rng)
	end
	for _, p in ipairs({ { -26, zS + 40, 0 }, { 26, zS + 41, math.pi }, { -28, zS + 100, math.pi / 2 } }) do
		bench(p[1], p[2], p[3])
	end

	-- 2) GARDEN SQUARE (middle, v11): green islands with flower beds, trees, benches and lamps, a fountain,
	-- and the Golden Magnat GT on its podium (walk up and buy it). No more car stands with random cars.
	local rows = { MapConfig.BaseCenters[3].z - 28, MapConfig.Shop.z - 22, MapConfig.Shop.z + 23 }
	local function island(x, z)
		local s = math.sign(x)
		Prefabs.FlowerBed(f.StreetProps, Vector3.new(x, 0.2, z), 10, 6, ctx.rng)
		Prefabs.Tree(f.StreetProps, Vector3.new(x + s * 6, 0.2, z - 7), ctx.rng, "tree")
		Prefabs.Tree(f.StreetProps, Vector3.new(x + s * 6, 0.2, z + 7), ctx.rng, (z % 2 == 0) and "palm" or "tree")
		Prefabs.Bush(f.StreetProps, Vector3.new(x - s * 4, 0.2, z - 7), ctx.rng)
		Prefabs.Bush(f.StreetProps, Vector3.new(x - s * 4, 0.2, z + 7), ctx.rng)
		bench(x - s * 9, z, s &gt; 0 and math.pi / 2 or -math.pi / 2) -- benches face the promenade
		Prefabs.Lamp(f.StreetProps, Vector3.new(x - s * 10, 0.2, z + 8), 1, nil, s &gt; 0 and math.pi or 0)
		table.insert(ctx.foot, { x1 = x - 12, x2 = x + 12, z1 = z - 12, z2 = z + 12 })
	end
	for i, z in ipairs(rows) do
		island(-32, z)
		if i == 1 then
			island(32, z)
		elseif i == 3 then
			-- fountain island
			if not Prefabs.FromTemplate("TrophyFountain", f.Buildings, CFrame.new(32, 0.2, z)) then
				Prefabs.Fountain(f.Buildings, Vector3.new(32, 0.2, z), C(255, 210, 90))
			end
			for _, dz in ipairs({ -11, 11 }) do
				Prefabs.FlowerBed(f.StreetProps, Vector3.new(32, 0.2, z + dz), 8, 4, ctx.rng)
			end
			table.insert(ctx.foot, { x1 = 20, x2 = 44, z1 = z - 14, z2 = z + 14 })
		end
	end

	-- Golden Magnat GT podium (game pass "golden_car"): gold stand, spotlight, plate, Buy prompt
	do
		local x, z = 32, rows[2]
		local def = CarConfig.ById.golden_magnat_gt
		local standTop = 1.57 -- turntable top of the Blender CarStand (pivot y 0.2 + 1.37)
		local stand = Prefabs.FromTemplate("CarStand", f.StreetProps, CFrame.new(x, 0.2, z) * CFrame.Angles(0, -math.pi / 2, 0),
			{ colors = { Accent = C(232, 178, 50), Metal = C(60, 52, 40) } })
		if not stand then
			Part(f.StreetProps, "Podium", Vector3.new(1.2, 18, 18), CFrame.new(x, 0.8, z) * UPRIGHT, C(40, 36, 30), M.Metal, { shape = CYL })
			Part(f.StreetProps, "PodiumRim", Vector3.new(1.0, 18.6, 18.6), CFrame.new(x, 0.7, z) * UPRIGHT, C(232, 178, 50), M.Metal, { shape = CYL, collide = false })
			standTop = 1.4
		end
		if def then
			local car = VehicleFactory.BuildCar(def)
			car.Name = "MagnatShowcar"
			car:PivotTo(CFrame.new(x, standTop + 3, z) * CFrame.Angles(0, math.pi + 0.5, 0))
			local ccf, csize = car:GetBoundingBox()
			car:PivotTo(car:GetPivot() - Vector3.new(0, (ccf.Position.Y - csize.Y / 2) - (standTop + 0.02), 0))
			for _, d in ipairs(car:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Anchored = true
					d.CanCollide = false
				end
			end
			car.Parent = f.StreetProps
		end
		local lamp = Part(f.StreetProps, "MagnatLight", Vector3.new(1, 1, 1), CFrame.new(x, 15, z), C(0, 0, 0), M.SmoothPlastic, { collide = false, t = 1 })
		lamp.CanQuery, lamp.CanTouch = false, false
		local spot = Instance.new("SpotLight")
		spot.Face = Enum.NormalId.Bottom
		spot.Angle = 60
		spot.Range = 20
		spot.Brightness = 3
		spot.Color = C(255, 220, 140)
		spot.Parent = lamp
		-- plate towards the promenade, clear of the stand (0.3 gap)
		local plate = Part(f.StreetProps, "MagnatPlate", Vector3.new(12, 3.2, 0.3), CFrame.new(x - 13.4, 3.4, z) * CFrame.Angles(0, math.pi / 2, 0), C(26, 22, 16), M.SmoothPlastic, { collide = false })
		for _, sz in ipairs({ -1, 1 }) do
			Part(f.StreetProps, "MagnatPlatePost", Vector3.new(0.6, 6, 0.6), CFrame.new(x - 13.4, 3, z + sz * 6.2), C(255, 200, 80), M.Metal)
		end
		Label(plate, Enum.NormalId.Front, "GOLDEN MAGNAT GT", C(255, 210, 90))
		-- walk-up prompt (client: UIExtra opens the game-pass purchase)
		local pp = Part(f.StreetProps, "MagnatPrompt", Vector3.new(2, 2, 2), CFrame.new(x - 12, 3, z), C(0, 0, 0), M.SmoothPlastic, { collide = false, t = 1 })
		pp.CanQuery, pp.CanTouch = false, false
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Buy (game pass)"
		prompt.ObjectText = "Golden Magnat GT"
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 14
		prompt.RequiresLineOfSight = false
		prompt.Parent = pp
		table.insert(ctx.foot, { x1 = x - 14, x2 = x + 12, z1 = z - 12, z2 = z + 12 })
		Prefabs.Count = Prefabs.Count + 1
	end
	-- (marble inlay removed: overlays on the paving flickered)

	-- 3) RACE PADDOCK (towards the exit): trophy fountain, grandstand, tyre walls
	local pz = MapConfig.BaseCenters[7].z - 30
	if not Prefabs.FromTemplate("TrophyFountain", f.Buildings, CFrame.new(-36, 0.2, pz)) then
		Part(f.Buildings, "Fountain", Vector3.new(2, 18, 18), CFrame.new(-36, 1, pz) * UPRIGHT, C(230, 226, 218), M.Marble, { shape = CYL })
	end
	Prefabs.FromTemplate("Grandstand", f.Buildings, CFrame.new(40, 0.2, pz) * CFrame.Angles(0, -math.pi / 2, 0))
	table.insert(ctx.foot, { x1 = -46, x2 = -26, z1 = pz - 10, z2 = pz + 10 })
	table.insert(ctx.foot, { x1 = 30, x2 = 50, z1 = pz - 17, z2 = pz + 17 })
	for _, sx in ipairs({ -1, 1 }) do
		for z = MapConfig.BaseCenters[7].z + 12, zE - 12, 6 do
			Prefabs.TireStack(f.StreetProps, Vector3.new(sx * (PW - 2), 0.2, z), ctx.rng) -- outside the lamp line (PW - 5)
		end
	end
	bench(-20, pz + 16, math.pi)
	bench(20, pz - 16, 0)
end

-- Running lanes: dark asphalt strips, white separator, white arrows. One lane each way.
local function buildSpeedLanes(ctx)
	local f = ctx.f
	local LANE, WHITE = C(54, 56, 62), C(245, 245, 245)
	for _, r in ipairs(MapConfig.SpeedLanes()) do
		local w, l = r[2] - r[1], r[4] - r[3]
		local cx, cz = (r[1] + r[2]) / 2, (r[3] + r[4]) / 2
		local alongZ = r[5] == 0
		local y = (cz &lt; MapConfig.EntryZ and math.abs(cx) &lt; MapConfig.PromenadeHalfWidth) and 0.26 or 0.14
		local lane = Part(f.StreetProps, "RunLane", Vector3.new(w, 0.12, l), CFrame.new(cx, y, cz), LANE, M.SmoothPlastic, { collide = false, cast = false })
		CollectionService:AddTag(lane, "RunLane")
		-- white edge lines
		for _, s in ipairs({ -1, 1 }) do
			local size = alongZ and Vector3.new(0.3, 0.1, l) or Vector3.new(w, 0.1, 0.3)
			local off = alongZ and Vector3.new(s * (w / 2 - 0.25), 0, 0) or Vector3.new(0, 0, s * (l / 2 - 0.25))
			Part(f.StreetProps, "LaneLine", size, CFrame.new(cx, y + 0.1, cz) + off, WHITE, M.SmoothPlastic, { collide = false, cast = false })
		end
		-- arrows: shaft + two head strokes, every 14 studs
		local dir = Vector3.new(r[5], 0, r[6])
		local yaw = math.atan2(-dir.X, -dir.Z)
		local span = alongZ and l or w
		local n = math.max(1, math.floor(span / 14))
		for k = 0, n - 1 do
			local t = (k + 0.5) / n
			local p = alongZ and Vector3.new(cx, y + 0.1, r[3] + t * l) or Vector3.new(r[1] + t * w, y + 0.1, cz)
			local acf = CFrame.new(p) * CFrame.Angles(0, yaw, 0) -- local -Z = arrow direction
			Part(f.StreetProps, "Arrow", Vector3.new(0.7, 0.1, 4), acf * CFrame.new(0, 0, 0.6), WHITE, M.SmoothPlastic, { collide = false, cast = false })
			for _, s in ipairs({ -1, 1 }) do
				Part(f.StreetProps, "ArrowHead", Vector3.new(0.7, 0.1, 2.4), acf * CFrame.new(s * 0.75, 0, -1.6) * CFrame.Angles(0, s * math.rad(40), 0), WHITE, M.SmoothPlastic, { collide = false, cast = false })
			end
		end
	end
end

local function buildGate(ctx, gate, zone)
	local f = ctx.f
	local pal = zone.palette
	local gz = gate.z
	local gw = MapConfig.GateHalfWidth
	local len = HW - gw - 2
	for _, s in ipairs({ -1, 1 }) do
		Part(f.ZoneGates, "Fence", Vector3.new(len, 10, 4), CFrame.new(s * (gw + 2 + len / 2), 5, gz), pal.curb, M.Metal)
		Part(f.ZoneGates, "FenceCap", Vector3.new(len, 0.6, 4.4), CFrame.new(s * (gw + 2 + len / 2), 10.3, gz), C(52, 56, 64), M.Metal, { collide = false })
		Part(f.ZoneGates, "GatePillar", Vector3.new(4, 20, 5), CFrame.new(s * (gw + 2), 10, gz), C(30, 34, 46), M.Metal)
	end
	local beam = Part(f.ZoneGates, "GateBeam", Vector3.new(2 * gw + 8, 4, 5), CFrame.new(0, 22, gz), C(20, 22, 32), M.Metal)
	Label(beam, Enum.NormalId.Front, zone.name, pal.accent)
	Label(beam, Enum.NormalId.Back, zone.name, pal.accent)
	local barrier = Part(f.ZoneGates, "GateBarrier_" .. zone.id, Vector3.new(2 * gw, 20, 1.5), CFrame.new(0, 10, gz), C(214, 52, 44), M.SmoothPlastic)
	barrier:SetAttribute("ZoneId", zone.id)
	CollectionService:AddTag(barrier, "ZoneGate")
	Label(barrier, Enum.NormalId.Front, "LOCKED", C(255, 255, 255))
	Label(barrier, Enum.NormalId.Back, "LOCKED", C(255, 255, 255))
end

local function buildEntryFence(ctx, zone)
	local f = ctx.f
	local pal = zone.palette
	local ez = MapConfig.EntryZ
	local ow = MapConfig.EntryHalfWidth
	local len = HW - ow
	for _, s in ipairs({ -1, 1 }) do
		Part(f.ZoneGates, "EntryFence", Vector3.new(len, 8, 3), CFrame.new(s * (ow + len / 2), 4, ez + 1.5), pal.curb, M.Metal)
		Part(f.ZoneGates, "EntryFenceCap", Vector3.new(len, 0.5, 3.4), CFrame.new(s * (ow + len / 2), 8.2, ez + 1.5), C(52, 56, 64), M.Metal, { collide = false })
	end
end

local buildRail, buildRiver, buildArena -- forward
local function buildRoad(ctx, road, pal, zid)
	local f = ctx.f
	if road.rail then
		return buildRail(ctx, road, pal)
	end
	zid = MapConfig.Zones[zid].style
	local W, z0, len = road.width, road.z, TrafficMath.Length
	local M_ = road.median
	local rid = road.id
	Part(f.Roads, "Road" .. rid, Vector3.new(len, 0.4, W), CFrame.new(0, 0, z0), pal.road, M.Asphalt)
	for _, s in ipairs({ -1, 1 }) do
		Part(f.Roads, "EdgeLine", Vector3.new(len, 0.1, 0.5), CFrame.new(0, 0.24, z0 + s * (W / 2 - 0.8)), WHITE, M.SmoothPlastic, { collide = false, cast = false })
		Part(f.Roads, "MedianLine", Vector3.new(len, 0.1, 0.35), CFrame.new(0, 0.24, z0 + s * (M_ / 2 + 0.5)), YELLOW, M.SmoothPlastic, { collide = false, cast = false })
		Part(f.Sidewalks, "Sidewalk", Vector3.new(2 * HW, 1.6, MapConfig.SidewalkWidth), CFrame.new(0, 0, z0 + s * (W / 2 + MapConfig.SidewalkWidth / 2)), pal.sidewalk, M.Concrete)
		if road.lanesPerSide &gt;= 2 then
			local zl = z0 + s * (M_ / 2 + road.laneWidth)
			for x = -HW + 6, HW - 6, 14 do
				Part(f.Roads, "Dash", Vector3.new(6, 0.1, 0.4), CFrame.new(x, 0.24, zl), WHITE, M.SmoothPlastic, { collide = false, cast = false })
			end
		end
	end
	Part(f.Sidewalks, "Median", Vector3.new(2 * HW, 1.6, M_), CFrame.new(0, 0, z0), pal.curb, M.Concrete)
	local top = (zid == "neon") and C(50, 40, 90) or ((zid == "industrial") and C(130, 120, 100) or C(96, 160, 90))
	Part(f.Sidewalks, "MedianTop", Vector3.new(2 * HW - 4, 0.1, M_ - 1.4), CFrame.new(0, 0.85, z0), top, (zid == "city" or zid == "highway") and M.Grass or M.Concrete)

	for ri, lane in ipairs(TrafficMath.RoadLanes[rid]) do
		for _, x in ipairs({ -HW + 25, -75, 75, HW - 25 }) do
			for _, s in ipairs({ -1, 1 }) do
				Part(f.Roads, "Arrow", Vector3.new(3.5, 0.1, 0.5), CFrame.new(x, 0.24, lane.z + s * 0.9) * CFrame.Angles(0, math.atan2(-s * 1.8, -3 * lane.dir), 0), WHITE, M.SmoothPlastic, { collide = false, cast = false })
			end
		end
		local sx = TrafficMath.MinX * lane.dir
		local a = Part(f.TrafficRoutes, string.format("Road%02d_Lane%d_Start", rid, ri), Vector3.new(1, 1, 1), CFrame.new(sx, 1, lane.z), C(255, 255, 255), M.SmoothPlastic, { t = 1, collide = false })
		local b = Part(f.TrafficRoutes, string.format("Road%02d_Lane%d_End", rid, ri), Vector3.new(1, 1, 1), CFrame.new(-sx, 1, lane.z), C(255, 255, 255), M.SmoothPlastic, { t = 1, collide = false })
		for _, n in ipairs({ a, b }) do
			n:SetAttribute("RoadId", rid)
			n:SetAttribute("Dir", lane.dir)
			n:SetAttribute("Speed", math.floor(lane.speed * 10) / 10)
		end
	end
	for _, x in ipairs({ -HW * 0.5, 0, HW * 0.5 }) do
		for _, s in ipairs({ -1, 1 }) do
			local zs = z0 + s * (M_ / 2 + 1.6)
			while math.abs(zs - z0) &lt; W / 2 - 1 do
				Part(f.Roads, "Zebra", Vector3.new(7, 0.12, 1.6), CFrame.new(x, 0.25, zs), WHITE, M.SmoothPlastic, { collide = false, cast = false })
				zs = zs + s * 3.2
			end
		end
	end
	local v = 1
	for x = -(HW - 30), HW - 30, 60 do
		for _, s in ipairs({ -1, 1 }) do
			Prefabs.Lamp(f.StreetProps, Vector3.new(x + s * 30, 0.8, z0 + s * (W / 2 + 1.6)), v, pal.accent, (s &lt; 0) and (-math.pi / 2) or (math.pi / 2))
		end
		v = v % 3 + 1
	end
	for x = -(HW - 20), HW - 20, 50 do
		if ctx.rng() &lt; MapConfig.DecorationDensity + 0.15 then
			if zid == "neon" then
				Prefabs.Lamp(f.StreetProps, Vector3.new(x, 0.8, z0), 3, pal.accent2, 0)
			elseif zid == "industrial" or zid == "highway" then
				Prefabs.Barrier(f.StreetProps, Vector3.new(x, 0.8, z0), 0, (zid == "highway") and C(190, 192, 200) or C(240, 190, 40))
			else
				Prefabs.Tree(f.StreetProps, Vector3.new(x, 0.8, z0), ctx.rng, "tree")
			end
		end
	end
	for _, x in ipairs({ -HW * 0.5, 0, HW * 0.5 }) do
		for _, s in ipairs({ -1, 1 }) do
			Prefabs.TrafficLight(f.StreetProps, Vector3.new(x + s * 6, 0.8, z0 + s * (W / 2 + 4.6)), (s &lt; 0) and math.pi or 0)
		end
	end
	local srng = ctx.rng
	for x = -(HW - 10), HW - 10, 65 do
		for _, s in ipairs({ -1, 1 }) do
			local px = x + rr(srng, -8, 8)
			if math.abs(px) &gt; 12 and math.abs(math.abs(px) - HW * 0.5) &gt; 10 then
				local pz = z0 + s * (W / 2 + 4.8)
				local roll = srng()
				if zid == "city" or zid == "highway" then
					if roll &lt; 0.4 then
						Prefabs.Hydrant(f.StreetProps, Vector3.new(px, 0.8, pz))
					elseif roll &lt; 0.75 then
						Prefabs.Bin(f.StreetProps, Vector3.new(px, 0.8, pz), pal.accent2)
					end
				elseif zid == "industrial" then
					if roll &lt; 0.6 then
						Prefabs.Cone(f.StreetProps, Vector3.new(px, 0.8, pz))
					end
				elseif roll &lt; 0.5 then
					Prefabs.Bin(f.StreetProps, Vector3.new(px, 0.8, pz), pal.accent)
				end
			end
		end
	end
	if zid == "city" then
		for _, s in ipairs({ -1, 1 }) do
			Prefabs.BusStop(f.StreetProps, Vector3.new(s * (HW - 15), 0.8, z0 + s * (W / 2 + 4)), (s &lt; 0) and math.pi or 0, pal.accent2)
		end
	elseif zid == "highway" then
		Prefabs.Gantry(f.StreetProps, -(HW - 35), z0, W, "NEXT EXIT  &gt;&gt;  INDUSTRIAL", pal.accent)
		Prefabs.Gantry(f.StreetProps, HW - 35, z0, W, "&lt;&lt;  CITY CENTER", pal.accent)
	elseif zid == "industrial" then
		for x = -(HW - 30), HW - 30, 80 do
			Prefabs.Cone(f.StreetProps, Vector3.new(x + 20, 0.8, z0 + M_ / 2 - 1.2))
			Prefabs.Cone(f.StreetProps, Vector3.new(x - 20, 0.8, z0 - M_ / 2 + 1.2))
		end
	elseif zid == "neon" then
		for x = -(HW - 30), HW - 30, 80 do
			Prefabs.Lamp(f.StreetProps, Vector3.new(x, 0.8, z0), 2, C(255, 200, 140), 0)
		end
	end
	if zid == "highway" then
		for _, s in ipairs({ -1, 1 }) do
			local x = s * 75
			Part(f.Buildings, "OverpassDeck", Vector3.new(14, 2, W + 28), CFrame.new(x, 16, z0), C(150, 154, 162), M.Concrete)
			Part(f.Buildings, "OverpassRailA", Vector3.new(0.6, 1.4, W + 28), CFrame.new(x - 6.7, 17.7, z0), C(190, 192, 198), M.Metal, { collide = false })
			Part(f.Buildings, "OverpassRailB", Vector3.new(0.6, 1.4, W + 28), CFrame.new(x + 6.7, 17.7, z0), C(190, 192, 198), M.Metal, { collide = false })
			for _, k in ipairs({ -1, 1 }) do
				Part(f.Buildings, "OverpassPillar", Vector3.new(6, 15, 6), CFrame.new(x, 7.5, z0 + k * (W / 2 + 12)), C(130, 134, 142), M.Concrete)
			end
		end
	end
end

local function placeBlock(ctx, blk, pal, zid)
	local f = ctx.f
	zid = MapConfig.Zones[zid].style
	local rng = ctx.rng
	local zA, zB = blk[1], blk[2]
	local depth = zB - zA
	local rows = {}
	local rd = math.max(0, math.min(34, (depth - 24) / 2))
	if rd &gt;= 12 then
		rows = { { dir = 1, edge = zA }, { dir = -1, edge = zB } }
	elseif depth &gt;= 40 then
		rd = math.min(24, depth - 20)
		rows = { { dir = 1, edge = zB, back = true } }
	end
	local arche = Prefabs.Archetypes[zid]
	for _, row in ipairs(rows) do
		for _, side in ipairs({ -1, 1 }) do
			local cursor = HW - 10
			local guard = 0
			while guard &lt; 12 do
				guard = guard + 1
				local a = pick(rng, arche)
				local w = rr(rng, a[2], a[3])
				if cursor - w &lt; 94 then break end
				local d = a[1] == "billboard" and 8 or math.max(12, rd - rr(rng, 0, 3))
				local h = rr(rng, a[4], a[5])
				local cx = side * (cursor - w / 2)
				local zc, yaw
				if row.back then
					zc = row.edge - d / 2
					yaw = 0
				elseif row.dir == 1 then
					zc = row.edge + d / 2
					yaw = 0
				else
					zc = row.edge - d / 2
					yaw = math.pi
				end
				local cf = CFrame.new(cx, 0, zc) * CFrame.Angles(0, yaw, 0)
				local model = Instance.new("Model")
				model.Name = a[1]
				Prefabs.Building(a[1], model, cf, w, d, h, pal, rng)
				model.Parent = f.Buildings
				table.insert(ctx.foot, { x1 = cx - w / 2, x2 = cx + w / 2, z1 = zc - d / 2, z2 = zc + d / 2 })
				cursor = cursor - w - rr(rng, 4, 8)
			end
		end
	end

	local pathCol = (zid == "neon") and C(44, 36, 78) or ((zid == "industrial") and C(150, 142, 128) or pal.sidewalk)
	Part(f.Ground, "BlockPath", Vector3.new(26, 0.12, depth), CFrame.new(0, 0.06, (zA + zB) / 2), pathCol, M.Concrete, { collide = false })
	for _, s in ipairs({ -1, 1 }) do
		Part(f.Ground, "BlockPathEdge", Vector3.new(0.8, 0.16, depth), CFrame.new(s * 13.4, 0.08, (zA + zB) / 2), C(250, 246, 238), M.Concrete, { collide = false, cast = false })
	end
	if depth &gt; 50 then
		if zid == "city" or zid == "highway" then
			for _, s in ipairs({ -1, 1 }) do
				Prefabs.FlowerBed(f.StreetProps, Vector3.new(s * 22, 0, zA + depth * 0.3), 6, 10, rng)
				Prefabs.Hedge(f.StreetProps, CFrame.new(s * 70, 0, zA + depth * 0.65) * CFrame.Angles(0, math.pi / 2, 0), 14)
				table.insert(ctx.foot, { x1 = s * 70 - 1.5, x2 = s * 70 + 1.5, z1 = zA + depth * 0.65 - 7, z2 = zA + depth * 0.65 + 7 })
				table.insert(ctx.foot, { x1 = s * 22 - 3, x2 = s * 22 + 3, z1 = zA + depth * 0.3 - 5, z2 = zA + depth * 0.3 + 5 })
			end
		elseif zid == "industrial" then
			local fx = rr(rng, 40, 70) * (rng() &lt; 0.5 and -1 or 1)
			local fz = zA + depth * 0.5
			Prefabs.Forklift(f.StreetProps, Vector3.new(fx, 0, fz), rr(rng, 0, math.pi * 2))
			table.insert(ctx.foot, { x1 = fx - 6, x2 = fx + 6, z1 = fz - 6, z2 = fz + 6 })
			for k = 1, 3 do
				local px, pz = -fx + rr(rng, -10, 10), zA + depth * (0.25 + k * 0.15)
				Prefabs.Pallet(f.StreetProps, Vector3.new(px, 0, pz), rr(rng, 0, 1), rng)
				table.insert(ctx.foot, { x1 = px - 3, x2 = px + 3, z1 = pz - 3, z2 = pz + 3 })
			end
		end
	end
	-- car atmosphere: parked cars and tire stacks off the main path
	if depth &gt; 38 and zid ~= "neon" then
		for _, sx in ipairs({ -1, 1 }) do
			local px, pz = sx * rr(rng, 48, 58), zA + depth * 0.5
			if not inFootprint(ctx.foot, px, pz, 6) then
				local kinds = (zid == "industrial") and { "pickup", "truck", "service" } or nil
				Prefabs.ParkedCar(f.StreetProps, CFrame.new(px, 0.15, pz) * CFrame.Angles(0, math.pi / 2 + (rng() &lt; 0.5 and math.pi or 0), 0), rng, kinds)
				table.insert(ctx.foot, { x1 = px - 5, x2 = px + 5, z1 = pz - 10, z2 = pz + 10 })
			end
			local tx, tz = sx * rr(rng, 30, 40), zA + depth * rr(rng, 0.2, 0.8)
			if not inFootprint(ctx.foot, tx, tz, 4) then
				Prefabs.TireStack(f.StreetProps, Vector3.new(tx, 0, tz), rng)
				table.insert(ctx.foot, { x1 = tx - 3, x2 = tx + 3, z1 = tz - 3, z2 = tz + 3 })
			end
		end
	end
	local rngd = MapConfig.DecorationDensity
	local n = math.floor(depth / 14 * rngd)
	for _ = 1, n do
		local x = rr(rng, 14, 85) * (rng() &lt; 0.5 and -1 or 1)
		local z = rr(rng, zA + 6, zB - 6)
		if zid == "neon" then
			Prefabs.Lamp(f.StreetProps, Vector3.new(x, 0.4, z), 3, C(255, 200, 140), 0)
		elseif zid == "industrial" then
			Prefabs.Barrel(f.StreetProps, Vector3.new(x, 0.4, z), pick(rng, { C(200, 70, 50), C(70, 110, 190) }))
		else
			Prefabs.Tree(f.StreetProps, Vector3.new(x, 0.4, z), rng, (zid == "highway") and "palm" or "tree")
		end
	end
	for _ = 1, math.floor(depth / 45) do
		Prefabs.Bench(f.StreetProps, Vector3.new(rr(rng, 16, 70) * (rng() &lt; 0.5 and -1 or 1), 0, rr(rng, zA + 10, zB - 10)), rr(rng, 0, math.pi * 2))
	end
	if zid == "city" and depth &gt; 60 then
		Prefabs.Kiosk(f.StreetProps, Vector3.new(rr(rng, 18, 40) * (rng() &lt; 0.5 and -1 or 1), 0, (zA + zB) / 2), 0, pick(rng, pal.buildings), "SNACKS")
	end
	if zid == "neon" then
		local zc = (zA + zB) / 2
		for _, sx in ipairs({ -1, 1 }) do
			Part(f.StreetProps, "BannerPost", Vector3.new(1.2, 18, 1.2), CFrame.new(sx * 22, 9, zc), C(52, 56, 64), M.Metal)
		end
		local ban = Part(f.StreetProps, "Banner", Vector3.new(43, 4, 0.5), CFrame.new(0, 15.8, zc), C(30, 34, 44), M.SmoothPlastic)
		Label(ban, Enum.NormalId.Front, "NIGHT RACERS ONLY", C(255, 170, 60))
		Label(ban, Enum.NormalId.Back, "DRIVE SAFE", C(255, 255, 255))
	end
end

local function genSpawnPoints(ctx, zid, blocks, roads)
	local f = ctx.f
	local rng = ctx.rng
	local pal = MapConfig.Zones[zid].palette
	local counts = PartConfig.PointCounts[zid]
	local placed = {}
	local idc = 0
	local function addPoint(x, y, z, risk)
		idc = idc + 1
		local p = Part(f.PartSpawnPoints, string.format("SP_%s_%s_%02d", zid, risk, idc), Vector3.new(2, 0.4, 2), CFrame.new(x, y + 0.2, z), C(255, 255, 255), M.SmoothPlastic, { t = 1, collide = false })
		p:SetAttribute("ZoneId", zid)
		p:SetAttribute("Risk", risk)
		table.insert(placed, { x = x, z = z })
	end
	local function farFromOthers(x, z, minD)
		for _, p in ipairs(placed) do
			local dx, dz = p.x - x, p.z - z
			if dx * dx + dz * dz &lt; minD * minD then return false end
		end
		return true
	end

	local xs = { -(HW - 30), -90, 90, HW - 30 }
	local rcount = 0
	for _, r in ipairs(roads) do
		for _, x in ipairs(xs) do
			if rcount &lt; counts.risky then
				addPoint(x + rr(rng, -12, 12), MapConfig.SidewalkTopY, r.z, "risky")
				rcount = rcount + 1
			end
		end
	end

	for _, rp in ipairs(ctx.riverPoints or {}) do
		addPoint(rp.X, rp.Y, rp.Z, "risky") -- loot in the middle of the narrow side bridges
	end

	-- scrap crates right on the traffic lanes: the best loot, the worst place to stand
	for _, r in ipairs(roads) do
		local lanes = TrafficMath.RoadLanes[r.id]
		for k = 1, (counts.road or 0) / #roads do
			local lane = lanes[(k - 1) % #lanes + 1]
			addPoint(rr(rng, -(HW - 40), HW - 40), MapConfig.RoadTopY, lane.z, "road")
		end
	end

	local safe = 0
	if zid == "city" then
		for k = 1, 4 do
			addPoint(-60 + (k - 1) * 40 + rr(rng, -6, 6), 0, MapConfig.EntryZ + 18 + rr(rng, 0, 26), "safe")
			safe = safe + 1
		end
	end
	local tries = 0
	while safe &lt; counts.safe and tries &lt; 600 do
		tries = tries + 1
		local blk = blocks[math.floor(rng() * #blocks) + 1]
		local x = rr(rng, -(HW - 30), HW - 30)
		local z = rr(rng, blk[1] + 5, blk[2] - 5)
		if not inFootprint(ctx.foot, x, z, 5) and farFromOthers(x, z, 24) then
			addPoint(x, 0, z, "safe")
			safe = safe + 1
		end
	end
end

-- Docks: two railway tracks with a level crossing (lights blink client-side when a train comes)
buildRail = function(ctx, road, pal)
	local f = ctx.f
	local W, z0, len = road.width, road.z, TrafficMath.Length
	local GRAVEL, SLEEPER, RAIL = C(120, 112, 104), C(86, 62, 44), C(170, 174, 182)
	Part(f.Roads, "RailBed", Vector3.new(len, 0.4, W), CFrame.new(0, 0, z0), GRAVEL, M.Slate)
	for _, lane in ipairs(TrafficMath.RoadLanes[road.id]) do
		for x = -len / 2 + 2, len / 2 - 2, 4 do
			Part(f.Roads, "Sleeper", Vector3.new(1.2, 0.2, 7), CFrame.new(x, 0.3, lane.z), SLEEPER, M.Wood, { collide = false, cast = false })
		end
		for _, s in ipairs({ -1, 1 }) do
			Part(f.Roads, "Rail", Vector3.new(len, 0.3, 0.4), CFrame.new(0, 0.55, lane.z + s * 2.6), RAIL, M.Metal, { collide = false })
		end
	end
	for _, s in ipairs({ -1, 1 }) do
		Part(f.Sidewalks, "Sidewalk", Vector3.new(2 * HW, 1.6, MapConfig.SidewalkWidth), CFrame.new(0, 0, z0 + s * (W / 2 + MapConfig.SidewalkWidth / 2)), pal.sidewalk, M.Concrete)
	end
	-- crossing planks + signals where the running lanes / paths cross
	Part(f.Roads, "CrossingPlanks", Vector3.new(28, 0.3, W), CFrame.new(0, 0.36, z0), C(150, 104, 62), M.Wood)
	for _, x in ipairs({ -HW * 0.5, 0, HW * 0.5 }) do
		for _, s in ipairs({ -1, 1 }) do
			local px, pz = x + s * 16, z0 + s * (W / 2 + 2.5)
			Part(f.StreetProps, "SignalPost", Vector3.new(0.6, 9, 0.6), CFrame.new(px, 5.3, pz), C(240, 240, 240), M.Metal)
			Part(f.StreetProps, "CrossBuck", Vector3.new(4, 0.6, 0.2), CFrame.new(px, 9.2, pz) * CFrame.Angles(0, 0, math.rad(35)), C(255, 255, 255), M.SmoothPlastic, { collide = false })
			Part(f.StreetProps, "CrossBuck", Vector3.new(4, 0.6, 0.2), CFrame.new(px, 9.2, pz) * CFrame.Angles(0, 0, math.rad(-35)), C(255, 255, 255), M.SmoothPlastic, { collide = false })
			for k, dx in ipairs({ -0.7, 0.7 }) do
				local l = Part(f.StreetProps, "CrossingLight", Vector3.new(0.8, 0.8, 0.4), CFrame.new(px + dx, 7.4, pz - s * 0.4), C(90, 20, 20), M.SmoothPlastic, { collide = false })
				l:SetAttribute("RoadId", road.id)
				l:SetAttribute("Phase", k)
				CollectionService:AddTag(l, "CrossingLight")
			end
			local arm = Part(f.StreetProps, "CrossingArm", Vector3.new(12, 0.5, 0.4), CFrame.new(px - s * 6.5, 3.4, pz), C(255, 255, 255), M.SmoothPlastic, { collide = false })
			arm:SetAttribute("RoadId", road.id)
			arm:SetAttribute("Side", s)
			CollectionService:AddTag(arm, "CrossingArm")
		end
	end
end

-- Bridge district: deep water between the roads, three bridges; falling in = wrecked
buildRiver = function(ctx, riv, pal)
	local f = ctx.f
	local len = riv.z2 - riv.z1
	local zc = (riv.z1 + riv.z2) / 2
	Part(f.Ground, "RiverBed", Vector3.new(2 * HW, 2, len), CFrame.new(0, -14, zc), C(60, 80, 90), M.Slate)
	Part(f.Ground, "RiverWater", Vector3.new(2 * HW, 6, len), CFrame.new(0, -6.2, zc), C(50, 140, 200), M.Glass, { collide = false, t = 0.25 })
	local kill = Part(f.Ground, "RiverKill", Vector3.new(2 * HW, 2, len - 2), CFrame.new(0, -7, zc), C(0, 0, 0), M.SmoothPlastic, { t = 1 })
	kill.CanCollide = false
	kill.CanTouch = true
	CollectionService:AddTag(kill, "KillZone")
	for _, s in ipairs({ -1, 1 }) do
		Part(f.Ground, "RiverBank", Vector3.new(2 * HW, 9, 2), CFrame.new(0, -4.5, zc + s * (len / 2 + 1)), C(150, 140, 126), M.Concrete)
	end
	for _, b in ipairs(riv.bridges) do
		Part(f.Roads, "BridgeDeck", Vector3.new(b.w, 1, len + 6), CFrame.new(b.x, -0.1, zc), C(150, 104, 62), M.Wood)
		for _, s in ipairs({ -1, 1 }) do
			Part(f.Roads, "BridgeRail", Vector3.new(0.4, 0.4, len + 6), CFrame.new(b.x + s * (b.w / 2 - 0.2), 3.2, zc), C(240, 240, 240), M.Metal, { collide = false })
			for z = riv.z1 - 2, riv.z2 + 2, 8 do
				Part(f.Roads, "BridgePost", Vector3.new(0.4, 3, 0.4), CFrame.new(b.x + s * (b.w / 2 - 0.2), 1.9, z), C(240, 240, 240), M.Metal, { collide = false })
			end
			Part(f.Roads, "BridgePier", Vector3.new(b.w, 14, 2), CFrame.new(b.x, -7.6, zc + s * len / 4), C(130, 130, 136), M.Concrete)
		end
	end
	table.insert(ctx.foot, { x1 = -HW, x2 = HW, z1 = riv.z1 - 4, z2 = riv.z2 + 4 })
	ctx.riverPoints = {}
	for _, b in ipairs(riv.bridges) do
		if b.x ~= 0 then
			table.insert(ctx.riverPoints, Vector3.new(b.x, 0.4, zc))
		end
	end
end

-- Boss arena: open ground with cover; the truck is driven by BossService
buildArena = function(ctx, zid)
	local f = ctx.f
	local zone = MapConfig.Zones[zid]
	local pal = zone.palette
	local rng = ctx.rng
	local zc = (zone.zMin + zone.zMax) / 2
	local center = Part(f.StreetProps, "ArenaCenter", Vector3.new(4, 1, 4), CFrame.new(0, 0.5, zc), C(255, 255, 255), M.SmoothPlastic, { t = 1, collide = false })
	center:SetAttribute("ZoneId", zid)
	center:SetAttribute("Boss", zone.boss)
	center:SetAttribute("HalfX", HW - 8)
	center:SetAttribute("HalfZ", (zone.zMax - zone.zMin) / 2 - 8)
	CollectionService:AddTag(center, "Arena")
	-- dirt track ring + start/finish ramps for show
	Part(f.Ground, "ArenaDirt", Vector3.new(2 * HW - 20, 0.1, zone.zMax - zone.zMin - 20), CFrame.new(0, 0.05, zc), pal.ground:Lerp(C(90, 70, 50), 0.35), M.Ground, { collide = false, cast = false })
	local covers = 0
	local tries = 0
	while covers &lt; 14 and tries &lt; 200 do
		tries = tries + 1
		local x = rr(rng, -(HW - 30), HW - 30)
		local z = rr(rng, zone.zMin + 30, zone.zMax - 30)
		if math.abs(x) &gt; 14 and not inFootprint(ctx.foot, x, z, 10) then
			covers = covers + 1
			local w, d, h
			if zone.style == "industrial" then
				w, d, h = 20, 8, 8.6
				Part(f.Buildings, "ScrapContainer", Vector3.new(w, h, d), CFrame.new(x, h / 2, z) * CFrame.Angles(0, rng() &lt; 0.5 and 0 or math.pi / 2, 0), pick(rng, pal.buildings), M.Metal)
			elseif zone.style == "highway" then
				w, d, h = rr(rng, 12, 20), rr(rng, 10, 16), rr(rng, 8, 16)
				Part(f.Buildings, "CanyonRock", Vector3.new(w, h, d), CFrame.new(x, h / 2 - 1, z) * CFrame.Angles(0, rng() * math.pi, 0), pick(rng, pal.buildings), M.Rock)
			else
				w, d, h = 6, 6, 18
				Part(f.Buildings, "Column", Vector3.new(h, w, w), CFrame.new(x, h / 2, z) * UPRIGHT, C(236, 226, 204), M.Marble, { shape = CYL })
				Part(f.Buildings, "ColumnCap", Vector3.new(8, 1.2, 8), CFrame.new(x, h + 0.6, z), C(220, 206, 176), M.Marble)
			end
			table.insert(ctx.foot, { x1 = x - w / 2 - 2, x2 = x + w / 2 + 2, z1 = z - w / 2 - 2, z2 = z + w / 2 + 2 })
		end
	end
	if zid == "colosseum" then
		for _, s in ipairs({ -1, 1 }) do
			for k = 0, 5 do
				Part(f.Buildings, "Stand", Vector3.new(8, 4 + k * 4, zone.zMax - zone.zMin), CFrame.new(s * (HW - 6 - k * 8), 2 + k * 2, zc), C(214 - k * 6, 196 - k * 6, 160 - k * 6), M.Concrete)
			end
		end
	end
	local banner = Part(f.StreetProps, "ArenaBanner", Vector3.new(60, 6, 1), CFrame.new(0, 26, zone.zMin + 4), C(28, 30, 38), M.SmoothPlastic, { collide = false })
	for _, s in ipairs({ -1, 1 }) do
		Part(f.StreetProps, "BannerPost", Vector3.new(1.4, 29.6, 1.4), CFrame.new(s * 30.6, 14.8, zone.zMin + 4), C(52, 56, 64), M.Metal)
	end
	Label(banner, Enum.NormalId.Front, zone.name .. " - BOSS", pal.accent)
	Label(banner, Enum.NormalId.Back, "SURVIVE THE BOSS", pal.accent)
	-- loot: many safe-ish points + a rich centre
	local counts = PartConfig.PointCounts[zid] or { safe = 16, risky = 8 }
	local idc = 0
	local placed = 0
	tries = 0
	while placed &lt; counts.safe + counts.risky and tries &lt; 800 do
		tries = tries + 1
		local x = rr(rng, -(HW - 20), HW - 20)
		local z = rr(rng, zone.zMin + 18, zone.zMax - 18)
		if not inFootprint(ctx.foot, x, z, 4) then
			placed = placed + 1
			idc = idc + 1
			local risk = placed &lt;= counts.safe and "safe" or "risky"
			local p = Part(f.PartSpawnPoints, string.format("SP_%s_%s_%02d", zid, risk, idc), Vector3.new(2, 0.4, 2), CFrame.new(x, 0.2, z), C(255, 255, 255), M.SmoothPlastic, { t = 1, collide = false })
			p:SetAttribute("ZoneId", zid)
			p:SetAttribute("Risk", risk)
			table.insert(ctx.foot, { x1 = x - 6, x2 = x + 6, z1 = z - 6, z2 = z + 6 })
		end
	end
end

local function buildZone(ctx, zid)
	local f = ctx.f
	local zone = MapConfig.Zones[zid]
	local pal = zone.palette
	local gate = MapConfig.GateOfZone(zid)
	local zStart = gate and gate.z or MapConfig.EntryZ
	local zEnd = MapConfig.EndZ
	for _, g in ipairs(MapConfig.Gates) do
		if g.z &gt; zStart then
			zEnd = g.z
			break
		end
	end
	local sty = zone.style
	local ground = (sty == "industrial" or sty == "neon" or zone.arena) and M.Concrete or M.Grass
	if zid == "desert" or zid == "canyon" or zid == "colosseum" then
		ground = M.Sand
	end
	local riv = MapConfig.River.zone == zid and MapConfig.River or nil
	local function groundSeg(a, b)
		if b - a &gt; 0.5 then
			Part(f.Ground, "Ground_" .. zid, Vector3.new(2 * HW, 2, b - a), CFrame.new(0, -1, (a + b) / 2), pal.ground, ground)
		end
	end
	if riv then
		groundSeg(zStart, riv.z1)
		groundSeg(riv.z2, zEnd)
	else
		groundSeg(zStart, zEnd)
	end

	if gate then
		buildGate(ctx, gate, zone)
	else
		buildEntryFence(ctx, zone)
	end
	-- checkpoint at the far end: SAVE &amp; GO HOME or RISK IT (CheckpointService)
	do
		local cz = zone.zMax - 5
		local trig = Part(f.StreetProps, "CheckpointTrigger", Vector3.new(2 * HW - 12, 8, 3), CFrame.new(0, 4, cz), C(255, 255, 255), M.SmoothPlastic, { t = 1, collide = false })
		trig.CanTouch = true
		trig:SetAttribute("ZoneId", zid)
		CollectionService:AddTag(trig, "Checkpoint")
		for k = 0, 39 do
			local x = -HW + 6 + (k + 0.5) * (2 * HW - 12) / 40
			Part(f.StreetProps, "CheckpointStripe", Vector3.new((2 * HW - 12) / 40, 0.12, 2), CFrame.new(x, 0.3, cz), (k % 2 == 0) and C(255, 200, 40) or C(28, 28, 32), M.SmoothPlastic, { collide = false, cast = false })
		end
		for _, sx in ipairs({ -1, 1 }) do
			Part(f.StreetProps, "CheckpointPost", Vector3.new(1.6, 15, 1.6), CFrame.new(sx * 17.7, 7.5, cz), C(40, 44, 52), M.Metal)
		end
		local cb = Part(f.StreetProps, "CheckpointSign", Vector3.new(34, 3.4, 1.2), CFrame.new(0, 13.6, cz), C(255, 200, 40), M.SmoothPlastic)
		Label(cb, Enum.NormalId.Front, "CHECKPOINT - SAVE OR RISK", C(28, 28, 32))
		Label(cb, Enum.NormalId.Back, "CHECKPOINT - SAVE OR RISK", C(28, 28, 32))
	end

	if zone.arena then
		buildArena(ctx, zid)
		return
	end

	local roads = {}
	for _, rid in ipairs(zone.roads) do
		local r = MapConfig.Roads[rid]
		table.insert(roads, r)
		buildRoad(ctx, r, pal, zid)
	end
	if riv then
		buildRiver(ctx, riv, pal)
	end

	local blocks = MapConfig.ZoneBlocks(zid)
	for _, blk in ipairs(blocks) do
		if not (riv and blk[1] &lt; riv.z2 and blk[2] &gt; riv.z1) then
			placeBlock(ctx, blk, pal, zid)
		end
	end

	Prefabs.DistrictSign(f.StreetProps, Vector3.new(-45, 0.4, blocks[1][1] + 10), zone.name, pal.accent2 or pal.accent, 0)
	if sty == "industrial" then
		Prefabs.Crane(f.Buildings, Vector3.new(-(HW + 40), 0, (zone.zMin + zone.zMax) / 2 - 60), 0, pal.accent2)
		Prefabs.Crane(f.Buildings, Vector3.new(HW + 40, 0, (zone.zMin + zone.zMax) / 2 + 60), math.pi, pal.accent)
	end
	genSpawnPoints(ctx, zid, blocks, roads)
end

function Build.Build(opts)
	opts = opts or {}
	local seed = opts.seed or MapConfig.Seed
	local sections = opts.sections or ALL_SECTIONS
	local root = getRoot()
	local started = os.clock()
	Prefabs.Count = 0
	Prefabs.TemplateUse = { placed = 0, missing = {} }
	local summary = {}
	for idx, section in ipairs(sections) do
		clearSection(root, section)
		local ctx = { f = newFolders(section), rng = TrafficMath.NewRng(seed + idx * 1009), foot = {} }
		local before = Prefabs.Count
		if section == "World" then
			buildWorld(ctx)
			buildSpeedLanes(ctx)
		elseif section == "Plaza" then
			buildPlaza(ctx)
		elseif ZONE_OF[section] then
			buildZone(ctx, ZONE_OF[section])
		else
			warn("[BuildCityMap] unknown section:", section)
		end
		for _, name in ipairs(TYPE_FOLDERS) do
			ctx.f[name].Parent = root[name]
		end
		summary[section] = Prefabs.Count - before
	end
	root:SetAttribute("MapVersion", MapConfig.Version)
	-- how many Blender templates were available: a map built while models were missing is rebuilt once they are there
	local props = game:GetService("ServerStorage"):FindFirstChild("BuilderAssets")
	props = props and props:FindFirstChild("Props")
	root:SetAttribute("Templates", props and #props:GetChildren() or 0)
	local missing = {}
	for n in pairs(Prefabs.TemplateUse.missing) do
		table.insert(missing, n)
	end
	print(string.format("[Models] %d Blender models placed on the map%s", Prefabs.TemplateUse.placed,
		#missing &gt; 0 and (" - procedural fallback for: " .. table.concat(missing, ", ")) or ""))
	if not opts.quiet then
		local parts = {}
		for _, s in ipairs(sections) do
			table.insert(parts, s .. "=" .. tostring(summary[s]))
		end
		print(string.format("[BuildCityMap] done in %.2fs, seed=%d, parts: %s (total %d)", os.clock() - started, seed, table.concat(parts, ", "), Prefabs.Count))
	end
	return summary
end

return Build
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX42"><Properties><string name="Name">MapPrefabs</string><ProtectedString name="Source">local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local VehicleFactory = require(Shared:WaitForChild("VehicleFactory"))
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local ModelSizes = require(Shared:WaitForChild("ModelSizes"))
local ServerStorage = game:GetService("ServerStorage")

local C = Color3.fromRGB
local M = Enum.Material

local Prefabs = {}
Prefabs.Count = 0

local GLASS = C(150, 205, 240)
local DARK = C(34, 36, 44)

function Prefabs.Part(parent, name, size, cf, color, mat, o)
	o = o or {}
	local p = Instance.new(o.class or "Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Anchored = true
	p.Color = color
	mat = mat or M.SmoothPlastic
	if MapConfig.NoNeon and mat == M.Neon and not o.light then
		mat = M.SmoothPlastic -- only real light sources glow
	end
	if MapConfig.Cartoon and (mat == M.Concrete or mat == M.Asphalt or mat == M.Grass or mat == M.Wood) then
		mat = M.SmoothPlastic -- clean toy look
	end
	p.Material = mat
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if o.t then p.Transparency = o.t end
	if o.collide == false then
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
	end
	if o.shape then p.Shape = o.shape end
	if o.refl then p.Reflectance = o.refl end
	if o.cast == false then p.CastShadow = false end
	p.Parent = parent
	Prefabs.Count = Prefabs.Count + 1
	return p
end
local Part = Prefabs.Part

function Prefabs.Label(part, face, text, textColor, bg)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Gui"
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 24
	gui.LightInfluence = 0
	gui.Parent = part
	local l = Instance.new("TextLabel")
	l.Name = "Label"
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = bg and 0 or 1
	if bg then l.BackgroundColor3 = bg end
	l.TextColor3 = textColor or C(255, 255, 255)
	l.Font = Enum.Font.LuckiestGuy
	l.TextScaled = true
	l.Text = text
	l.Parent = gui
	return l
end
local Label = Prefabs.Label

-- Blender-made props: ServerStorage.BuilderAssets.Props.&lt;name&gt; (see docs/BLENDER.md). nil if not imported.
Prefabs.TemplateUse = { placed = 0, missing = {} }
-- opts: scale (uniform), colors = { Wall = c, Trim = c, Roof = c } recolours the Blender looks per district
function Prefabs.FromTemplate(name, parent, cf, opts)
	local assets = ServerStorage:FindFirstChild("BuilderAssets")
	local props = assets and assets:FindFirstChild("Props")
	local tpl = props and props:FindFirstChild(name)
	if not tpl then
		Prefabs.TemplateUse.missing[name] = true
		return nil
	end
	Prefabs.TemplateUse.placed = Prefabs.TemplateUse.placed + 1
	local m = tpl:Clone()
	if opts and opts.scale and math.abs(opts.scale - 1) &gt; 0.01 then
		m:ScaleTo(m:GetScale() * opts.scale)
	end
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			local c = opts and opts.colors and opts.colors[d.Name]
			if c then
				d.Color = c
			end
		end
	end
	m:PivotTo(cf)
	m.Parent = parent
	Prefabs.Count = Prefabs.Count + 1
	return m
end

local function pick(rng, list)
	return list[math.floor(rng() * #list) + 1]
end
local function rr(rng, a, b)
	return a + (b - a) * rng()
end
Prefabs.Pick = pick
Prefabs.RR = rr

local CYL = Enum.PartType.Cylinder
local BALL = Enum.PartType.Ball
local UPRIGHT = CFrame.Angles(0, 0, math.pi / 2)

local lampLights = 0
local function addLight(part, range)
	if lampLights &gt;= 70 then
		return -- keep the light count mobile-friendly
	end
	lampLights = lampLights + 1
	local l = Instance.new("PointLight")
	l.Range = range or 14
	l.Brightness = 1.1
	l.Color = Color3.fromRGB(255, 220, 170)
	l.Shadows = false
	l.Parent = part
end

function Prefabs.Lamp(parent, pos, variant, glow, facing)
	local cf = CFrame.new(pos) * CFrame.Angles(0, facing or 0, 0)
	local lm = Prefabs.FromTemplate(({ "LampA", "LampB", "LampC" })[variant] or "LampA", parent, CFrame.new(pos.X, pos.Y - 0.2, pos.Z) * CFrame.Angles(0, facing or 0, 0))
	if lm then
		local g = lm:FindFirstChild("Glow", true)
		if g then
			addLight(g, variant == 3 and 12 or 16)
		end
		return
	end
	local warm = Color3.fromRGB(255, 236, 200)
	local POLE = C(52, 56, 64)
	Part(parent, "LampBase", Vector3.new(1.4, 0.8, 1.4), cf * CFrame.new(0, 0.4, 0), POLE, M.Metal)
	if variant == 1 then
		Part(parent, "LampPole", Vector3.new(0.6, 12, 0.6), cf * CFrame.new(0, 6, 0), POLE, M.Metal)
		Part(parent, "LampArm", Vector3.new(4, 0.4, 0.4), cf * CFrame.new(2, 12, 0), POLE, M.Metal)
		Part(parent, "LampHousing", Vector3.new(2, 0.5, 1.2), cf * CFrame.new(4, 11.9, 0), POLE, M.Metal)
		addLight(Part(parent, "LampHead", Vector3.new(1.6, 0.15, 0.9), cf * CFrame.new(4, 11.6, 0), warm, M.Neon, { light = true }), 16)
	elseif variant == 2 then
		Part(parent, "LampPole", Vector3.new(0.7, 13, 0.7), cf * CFrame.new(0, 6.5, 0), POLE, M.Metal)
		Part(parent, "LampArmL", Vector3.new(7, 0.4, 0.4), cf * CFrame.new(0, 13, 0) * CFrame.Angles(0, math.pi / 2, 0), POLE, M.Metal)
		for _, z in ipairs({ 3.4, -3.4 }) do
			Part(parent, "LampHousing", Vector3.new(1.4, 0.5, 1.4), cf * CFrame.new(0, 12.9, z), POLE, M.Metal)
			addLight(Part(parent, "LampHead", Vector3.new(1.1, 0.15, 1.1), cf * CFrame.new(0, 12.6, z), warm, M.Neon, { light = true }), 14)
		end
	else
		Part(parent, "LampPole", Vector3.new(0.5, 8, 0.5), cf * CFrame.new(0, 4, 0), POLE, M.Metal)
		Part(parent, "LampCap", Vector3.new(2.2, 0.4, 2.2), cf * CFrame.new(0, 10.4, 0), POLE, M.Metal)
		addLight(Part(parent, "LampGlobe", Vector3.new(1.8, 2.2, 1.8), cf * CFrame.new(0, 9.1, 0), warm, M.Glass, { t = 0.2 }), 12)
	end
end

function Prefabs.Tree(parent, pos, rng, variant)
	if Prefabs.FromTemplate(variant == "palm" and "Palm" or "Tree", parent, CFrame.new(pos) * CFrame.Angles(0, rr(rng, 0, 6.28), 0), { scale = rr(rng, 0.85, 1.2) }) then
		return
	end
	local h = rr(rng, 6, 9)
	if variant == "palm" then
		Part(parent, "Trunk", Vector3.new(1.1, h + 3, 1.1), CFrame.new(pos + Vector3.new(0, (h + 3) / 2, 0)), C(150, 110, 70), M.Wood)
		for i = 0, 4 do
			local a = i * math.pi * 2 / 5
			Part(parent, "Frond", Vector3.new(6.5, 0.3, 1.6), CFrame.new(pos + Vector3.new(0, h + 3, 0)) * CFrame.Angles(0, a, 0) * CFrame.new(3, -0.4, 0) * CFrame.Angles(0, 0, -0.3), C(70, 170, 80), M.Grass, { collide = false })
		end
	else
		Part(parent, "Trunk", Vector3.new(1.3, h, 1.3), CFrame.new(pos + Vector3.new(0, h / 2, 0)), C(120, 86, 56), M.Wood)
		local g = pick(rng, { C(70, 160, 70), C(90, 180, 80), C(60, 140, 90), C(120, 190, 70) })
		local s = rr(rng, 6.5, 9)
		Part(parent, "Canopy", Vector3.new(s, s, s), CFrame.new(pos + Vector3.new(0, h + s * 0.3, 0)), g, M.Grass, { shape = BALL, collide = false })
		Part(parent, "Canopy2", Vector3.new(s * 0.7, s * 0.7, s * 0.7), CFrame.new(pos + Vector3.new(s * 0.25, h + s * 0.7, 0)), g, M.Grass, { shape = BALL, collide = false })
	end
end

function Prefabs.Bush(parent, pos, rng)
	if Prefabs.FromTemplate("Bush", parent, CFrame.new(pos) * CFrame.Angles(0, rr(rng, 0, 6.28), 0), { scale = rr(rng, 0.8, 1.3) }) then
		return
	end
	local s = rr(rng, 3, 5)
	Part(parent, "Bush", Vector3.new(s, s * 0.7, s), CFrame.new(pos + Vector3.new(0, s * 0.3, 0)), pick(rng, { C(60, 150, 70), C(80, 170, 90) }), M.Grass, { shape = BALL, collide = false })
end

function Prefabs.Bench(parent, pos, yaw)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw or 0, 0)
	Part(parent, "BenchSeat", Vector3.new(6, 0.5, 2), cf * CFrame.new(0, 1.7, 0), C(150, 100, 60), M.Wood)
	Part(parent, "BenchBack", Vector3.new(6, 1.6, 0.4), cf * CFrame.new(0, 2.8, -0.9), C(150, 100, 60), M.Wood)
	Part(parent, "BenchLegL", Vector3.new(0.5, 1.6, 1.8), cf * CFrame.new(-2.5, 0.8, 0), DARK, M.Metal)
	Part(parent, "BenchLegR", Vector3.new(0.5, 1.6, 1.8), cf * CFrame.new(2.5, 0.8, 0), DARK, M.Metal)
end

function Prefabs.Planter(parent, pos, color)
	Part(parent, "Planter", Vector3.new(5, 2, 5), CFrame.new(pos + Vector3.new(0, 1, 0)), color or C(170, 160, 150), M.Concrete)
	Part(parent, "PlanterGreen", Vector3.new(4.2, 2.4, 4.2), CFrame.new(pos + Vector3.new(0, 2.2, 0)), C(70, 160, 80), M.Grass, { shape = BALL, collide = false })
end

function Prefabs.Kiosk(parent, pos, yaw, color, text)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw or 0, 0)
	if Prefabs.FromTemplate("Kiosk", parent, cf, { colors = { Wall = color } }) then
		local sign = Part(parent, "KioskSign", Vector3.new(5, 1.3, 0.3), cf * CFrame.new(0, 8.3, -2.6), DARK)
		Label(sign, Enum.NormalId.Front, text or "SHOP", C(255, 220, 90))
		return
	end
	Part(parent, "Kiosk", Vector3.new(7, 7, 6), cf * CFrame.new(0, 3.5, 0), color, M.SmoothPlastic)
	Part(parent, "KioskRoof", Vector3.new(8.4, 0.6, 7.4), cf * CFrame.new(0, 7.3, 0), DARK)
	local win = Part(parent, "KioskWindow", Vector3.new(5, 2.6, 0.3), cf * CFrame.new(0, 4.4, -3.1), GLASS, M.Glass, { t = 0.3 })
	local sign = Part(parent, "KioskSign", Vector3.new(5, 1.3, 0.3), cf * CFrame.new(0, 6.3, -3.1), DARK)
	Label(sign, Enum.NormalId.Front, text or "SHOP", C(255, 220, 90))
end

function Prefabs.DistrictSign(parent, pos, text, color, yaw)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw or 0, 0)
	Part(parent, "SignPostL", Vector3.new(0.8, 13.4, 0.8), cf * CFrame.new(-9.3, 6.7, 0), DARK, M.Metal)
	Part(parent, "SignPostR", Vector3.new(0.8, 13.4, 0.8), cf * CFrame.new(9.3, 6.7, 0), DARK, M.Metal)
	local b = Part(parent, "SignBoard", Vector3.new(18, 5, 0.6), cf * CFrame.new(0, 11, 0), color, M.SmoothPlastic)
	Label(b, Enum.NormalId.Front, text, C(255, 255, 255))
	Label(b, Enum.NormalId.Back, text, C(255, 255, 255))
end

function Prefabs.Fountain(parent, pos, accent)
	local cf = CFrame.new(pos)
	Part(parent, "FountainRim", Vector3.new(2.4, 30, 30), cf * CFrame.new(0, 1.2, 0) * UPRIGHT, C(228, 222, 212), M.Concrete, { shape = CYL })
	Part(parent, "FountainWater", Vector3.new(0.3, 27, 27), cf * CFrame.new(0, 2.3, 0) * UPRIGHT, C(110, 196, 240), M.Glass, { shape = CYL, t = 0.25, collide = false })
	Part(parent, "FountainTier", Vector3.new(4, 10, 10), cf * CFrame.new(0, 3.5, 0) * UPRIGHT, C(240, 236, 228), M.Concrete, { shape = CYL })
	Part(parent, "FountainBowl", Vector3.new(1, 14, 14), cf * CFrame.new(0, 6, 0) * UPRIGHT, C(240, 236, 228), M.Concrete, { shape = CYL })
	Part(parent, "FountainWater2", Vector3.new(0.2, 12.5, 12.5), cf * CFrame.new(0, 6.5, 0) * UPRIGHT, C(110, 196, 240), M.Glass, { shape = CYL, t = 0.25, collide = false })
	Part(parent, "FountainSpout", Vector3.new(1.4, 6, 1.4), cf * CFrame.new(0, 9, 0), C(240, 236, 228), M.Concrete)
	local jet = Part(parent, "FountainJet", Vector3.new(1, 5, 1), cf * CFrame.new(0, 14, 0), C(190, 235, 255), M.Neon, { t = 0.45, collide = false, cast = false })
	Part(parent, "FountainGlow", Vector3.new(0.2, 28, 28), cf * CFrame.new(0, 2.45, 0) * UPRIGHT, accent, M.Neon, { shape = CYL, t = 0.85, collide = false, cast = false })
	do
		local e = Instance.new("ParticleEmitter")
		e.Color = ColorSequence.new(C(210, 240, 255))
		e.Size = NumberSequence.new(0.8, 0.2)
		e.Transparency = NumberSequence.new(0.2, 1)
		e.Lifetime = NumberRange.new(1, 1.4)
		e.Speed = NumberRange.new(10, 14)
		e.SpreadAngle = Vector2.new(14, 14)
		e.Acceleration = Vector3.new(0, -24, 0)
		e.Rate = 26
		e.Parent = jet
	end
end

function Prefabs.FlowerBed(parent, pos, w, d, rng)
	if Prefabs.FromTemplate("FlowerBed", parent, CFrame.new(pos) * CFrame.Angles(0, w &lt; d and math.pi / 2 or 0, 0), { scale = math.min(math.max(w, d) / 8, math.min(w, d) / 5) }) then
		return
	end
	Part(parent, "BedEdge", Vector3.new(w, 1, d), CFrame.new(pos + Vector3.new(0, 0.5, 0)), C(232, 224, 212), M.Concrete)
	Part(parent, "BedSoil", Vector3.new(w - 0.8, 0.2, d - 0.8), CFrame.new(pos + Vector3.new(0, 1.05, 0)), C(110, 160, 80), M.Grass, { collide = false })
	local cols = { C(255, 120, 150), C(255, 210, 90), C(120, 200, 255), C(255, 255, 255), C(255, 150, 90) }
	local n = math.floor(w * d / 14)
	for _ = 1, n do
		local x = rr(rng, -w / 2 + 1, w / 2 - 1)
		local z = rr(rng, -d / 2 + 1, d / 2 - 1)
		Part(parent, "Flower", Vector3.new(0.9, 0.9, 0.9), CFrame.new(pos + Vector3.new(x, 1.5, z)), pick(rng, cols), M.SmoothPlastic, { shape = BALL, collide = false, cast = false })
	end
end

function Prefabs.Hedge(parent, cf, len)
	Part(parent, "Hedge", Vector3.new(len, 2.6, 2.4), cf * CFrame.new(0, 1.3, 0), C(76, 156, 84), M.Grass)
	Part(parent, "HedgeTop", Vector3.new(len - 0.4, 0.6, 2.0), cf * CFrame.new(0, 2.8, 0), C(96, 178, 96), M.Grass, { collide = false })
end

function Prefabs.Cloud(parent, pos, rng)
	local s = rr(rng, 16, 30)
	local col = C(255, 255, 255)
	Part(parent, "Cloud", Vector3.new(s * 1.6, s * 0.7, s), CFrame.new(pos), col, M.SmoothPlastic, { shape = BALL, collide = false, cast = false, t = 0.08 })
	Part(parent, "Cloud", Vector3.new(s, s * 0.8, s * 0.9), CFrame.new(pos + Vector3.new(s * 0.6, s * 0.2, 0)), col, M.SmoothPlastic, { shape = BALL, collide = false, cast = false, t = 0.08 })
	Part(parent, "Cloud", Vector3.new(s * 0.9, s * 0.6, s * 0.8), CFrame.new(pos + Vector3.new(-s * 0.7, -s * 0.05, s * 0.1)), col, M.SmoothPlastic, { shape = BALL, collide = false, cast = false, t = 0.08 })
end

function Prefabs.TrafficLight(parent, pos, yaw)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw or 0, 0)
	if Prefabs.FromTemplate("TrafficLight", parent, cf) then
		return
	end
	Part(parent, "TLPole", Vector3.new(0.6, 10, 0.6), cf * CFrame.new(0, 5, 0), DARK, M.Metal)
	Part(parent, "TLBox", Vector3.new(1.4, 4, 1.2), cf * CFrame.new(0, 10.5, 0), C(40, 42, 50), M.SmoothPlastic)
	Part(parent, "TLRed", Vector3.new(0.9, 0.9, 0.3), cf * CFrame.new(0, 11.8, -0.6), C(255, 70, 70), M.Neon, { collide = false, cast = false })
	Part(parent, "TLYellow", Vector3.new(0.9, 0.9, 0.3), cf * CFrame.new(0, 10.6, -0.6), C(120, 110, 60), M.SmoothPlastic, { collide = false, cast = false })
	Part(parent, "TLGreen", Vector3.new(0.9, 0.9, 0.3), cf * CFrame.new(0, 9.4, -0.6), C(60, 110, 70), M.SmoothPlastic, { collide = false, cast = false })
end

function Prefabs.BusStop(parent, pos, yaw, color)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw or 0, 0)
	if Prefabs.FromTemplate("BusStop", parent, cf, { colors = { Trim = color } }) then
		return
	end
	Part(parent, "StopRoof", Vector3.new(10, 0.5, 3.4), cf * CFrame.new(0, 8, 0), color, M.SmoothPlastic)
	Part(parent, "StopBack", Vector3.new(10, 6, 0.3), cf * CFrame.new(0, 4.6, 1.5), GLASS, M.Glass, { t = 0.45 })
	for _, x in ipairs({ -4.8, 4.8 }) do
		Part(parent, "StopPost", Vector3.new(0.4, 7.6, 0.4), cf * CFrame.new(x, 4, 1.4), DARK, M.Metal)
	end
	Part(parent, "StopSeat", Vector3.new(7, 0.5, 1.4), cf * CFrame.new(0, 2, 0.7), C(240, 240, 240), M.SmoothPlastic)
	local sign = Part(parent, "StopSign", Vector3.new(3.6, 1.2, 0.2), cf * CFrame.new(-3, 7, -1.5), color, M.SmoothPlastic, { collide = false })
	Label(sign, Enum.NormalId.Front, "BUS", C(255, 255, 255))
end

function Prefabs.Hydrant(parent, pos)
	if Prefabs.FromTemplate("Hydrant", parent, CFrame.new(pos)) then
		return
	end
	Part(parent, "Hydrant", Vector3.new(2.2, 1.4, 1.4), CFrame.new(pos + Vector3.new(0, 1.1, 0)) * UPRIGHT, C(230, 60, 60), M.SmoothPlastic, { shape = CYL })
	Part(parent, "HydrantCap", Vector3.new(1.2, 1.2, 1.2), CFrame.new(pos + Vector3.new(0, 2.3, 0)), C(230, 60, 60), M.SmoothPlastic, { shape = BALL, collide = false })
end

function Prefabs.Bin(parent, pos, color)
	if Prefabs.FromTemplate("Bin", parent, CFrame.new(pos), { colors = { Green = color } }) then
		return
	end
	Part(parent, "Bin", Vector3.new(3, 2, 2), CFrame.new(pos + Vector3.new(0, 1.5, 0)) * UPRIGHT, color or C(70, 150, 110), M.SmoothPlastic, { shape = CYL })
	Part(parent, "BinLid", Vector3.new(0.3, 2.2, 2.2), CFrame.new(pos + Vector3.new(0, 3.1, 0)) * UPRIGHT, DARK, M.SmoothPlastic, { shape = CYL, collide = false })
end

function Prefabs.Cone(parent, pos)
	if Prefabs.FromTemplate("Cone", parent, CFrame.new(pos)) then
		return
	end
	Part(parent, "ConeBase", Vector3.new(1.8, 0.3, 1.8), CFrame.new(pos + Vector3.new(0, 0.15, 0)), C(255, 130, 30), M.SmoothPlastic, { collide = false })
	Part(parent, "Cone", Vector3.new(1.8, 1.1, 1.1), CFrame.new(pos + Vector3.new(0, 1, 0)) * UPRIGHT, C(255, 130, 30), M.SmoothPlastic, { shape = CYL, collide = false })
	Part(parent, "ConeStripe", Vector3.new(0.4, 1.15, 1.15), CFrame.new(pos + Vector3.new(0, 1.2, 0)) * UPRIGHT, C(250, 250, 250), M.SmoothPlastic, { shape = CYL, collide = false })
end

function Prefabs.Pallet(parent, pos, yaw, rng)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw or 0, 0)
	if Prefabs.FromTemplate("Pallet", parent, cf) then
		return
	end
	Part(parent, "Pallet", Vector3.new(5, 0.6, 5), cf * CFrame.new(0, 0.3, 0), C(176, 132, 84), M.Wood)
	local h = math.floor(rr(rng, 1, 3.99))
	for i = 1, h do
		Part(parent, "Crate", Vector3.new(4.4, 2.2, 4.4), cf * CFrame.new(0, 0.6 + (i - 0.5) * 2.25, 0), pick(rng, { C(196, 150, 96), C(170, 128, 80), C(120, 140, 170) }), M.Wood)
	end
end

function Prefabs.Forklift(parent, pos, yaw)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw or 0, 0)
	if Prefabs.FromTemplate("Forklift", parent, cf) then
		return
	end
	Part(parent, "FLBody", Vector3.new(6, 2.6, 4), cf * CFrame.new(0, 2.1, 0), C(255, 196, 40), M.SmoothPlastic)
	Part(parent, "FLSeat", Vector3.new(2, 1.2, 2.4), cf * CFrame.new(-0.6, 4, 0), DARK)
	Part(parent, "FLRoof", Vector3.new(3.6, 0.3, 3.8), cf * CFrame.new(-0.4, 7.4, 0), DARK, M.Metal)
	for _, z in ipairs({ -1.7, 1.7 }) do
		Part(parent, "FLPost", Vector3.new(0.3, 4, 0.3), cf * CFrame.new(1.2, 5.4, z), DARK, M.Metal)
		Part(parent, "FLPostB", Vector3.new(0.3, 4, 0.3), cf * CFrame.new(-2, 5.4, z), DARK, M.Metal)
		Part(parent, "FLFork", Vector3.new(4, 0.25, 0.6), cf * CFrame.new(5, 0.6, z * 0.6), C(90, 90, 96), M.Metal)
	end
	Part(parent, "FLMast", Vector3.new(0.5, 7, 3.6), cf * CFrame.new(3.2, 4, 0), C(90, 90, 96), M.Metal)
	for _, x in ipairs({ -1.8, 1.8 }) do
		for _, z in ipairs({ -2, 2 }) do
			Part(parent, "FLWheel", Vector3.new(1, 2, 2), cf * CFrame.new(x, 1, z) * CFrame.Angles(0, math.pi / 2, 0), C(30, 30, 34), M.SmoothPlastic, { shape = CYL })
		end
	end
end

function Prefabs.Crane(parent, pos, yaw, accent)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw or 0, 0)
	Part(parent, "CraneMast", Vector3.new(3, 60, 3), cf * CFrame.new(0, 30, 0), accent, M.Metal)
	Part(parent, "CraneJib", Vector3.new(50, 2.4, 2.4), cf * CFrame.new(12, 60, 0), accent, M.Metal)
	Part(parent, "CraneCab", Vector3.new(5, 4, 4), cf * CFrame.new(0, 57, 0), C(240, 240, 240), M.SmoothPlastic)
	Part(parent, "CraneWeight", Vector3.new(6, 4, 4), cf * CFrame.new(-11, 58, 0), C(110, 110, 120), M.Concrete)
	Part(parent, "CraneCable", Vector3.new(0.3, 26, 0.3), cf * CFrame.new(30, 47, 0), DARK, M.Metal, { collide = false })
	Part(parent, "CraneLoad", Vector3.new(10, 4, 4), cf * CFrame.new(30, 32, 0), C(60, 110, 190), M.Metal, { collide = false })
	Part(parent, "CraneBeacon", Vector3.new(1.2, 1.2, 1.2), cf * CFrame.new(0, 62, 0), C(255, 60, 60), M.Neon, { shape = BALL, collide = false })
end

function Prefabs.HoloRing(parent, pos, color, size)
	size = size or 10
	Part(parent, "HoloRing", Vector3.new(0.4, size, size), CFrame.new(pos) * CFrame.Angles(0, math.pi / 2, 0), color, M.Neon, { shape = CYL, t = 0.5, collide = false, cast = false })
	Part(parent, "HoloRingIn", Vector3.new(0.5, size - 1.6, size - 1.6), CFrame.new(pos) * CFrame.Angles(0, math.pi / 2, 0), C(14, 12, 28), M.SmoothPlastic, { shape = CYL, t = 0.75, collide = false, cast = false })
end

function Prefabs.Gantry(parent, x, z0, width, text, accent)
	for _, s in ipairs({ -1, 1 }) do
		Part(parent, "GantryPost", Vector3.new(1.4, 20, 1.4), CFrame.new(x, 10.8, z0 + s * (width / 2 + 3)), C(150, 154, 162), M.Metal)
	end
	Part(parent, "GantryBeam", Vector3.new(1.6, 1.6, width + 8), CFrame.new(x, 20.4, z0), C(150, 154, 162), M.Metal)
	local b = Part(parent, "GantrySign", Vector3.new(0.6, 5.2, width * 0.6), CFrame.new(x, 17.1, z0), C(30, 120, 70), M.SmoothPlastic)
	Label(b, Enum.NormalId.Left, text, C(255, 255, 255))
	Label(b, Enum.NormalId.Right, (text:gsub("%s*[&lt;&gt;]+%s*", "  ")), C(255, 255, 255)) -- arrows only on the side they point right
	Part(parent, "GantryTrim", Vector3.new(0.7, 0.3, width * 0.6 + 0.2), CFrame.new(x, 14.4, z0), accent, M.Neon, { collide = false })
end

-- concrete barrier / barrel: Blender model or a block
function Prefabs.Barrier(parent, pos, yaw, color)
	if Prefabs.FromTemplate("Barrier", parent, CFrame.new(pos) * CFrame.Angles(0, yaw or 0, 0)) then
		return
	end
	Part(parent, "Barrier", Vector3.new(7, 1.6, 1.6), CFrame.new(pos + Vector3.new(0, 0.8, 0)) * CFrame.Angles(0, yaw or 0, 0), color or C(190, 192, 200), M.Concrete)
end

function Prefabs.Barrel(parent, pos, color)
	if Prefabs.FromTemplate("Barrel", parent, CFrame.new(pos), { colors = { Accent = color } }) then
		return
	end
	Part(parent, "Barrel", Vector3.new(3.6, 3, 3), CFrame.new(pos + Vector3.new(0, 1.8, 0)) * UPRIGHT, color, M.Metal, { shape = CYL })
end

local B = {}

local function mkb(parent, cf)
	return function(name, size, off, color, mat, o)
		return Part(parent, name, size, cf * CFrame.new(off), color, mat, o)
	end
end

function B.shop(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	local col = pick(rng, pal.buildings)
	mk("Body", Vector3.new(w, h, d), Vector3.new(0, h / 2, 0), col)
	mk("Trim", Vector3.new(w + 1, 0.8, d + 1), Vector3.new(0, h + 0.4, 0), pal.accent)
	mk("Glass", Vector3.new(w * 0.8, 3.4, 0.3), Vector3.new(0, 2.6, -d / 2 - 0.1), GLASS, M.Glass, { t = 0.3 })
	for i = 1, 3 do
		mk("Mullion", Vector3.new(0.3, 3.4, 0.4), Vector3.new(-w * 0.4 + i * w * 0.2, 2.6, -d / 2 - 0.15), C(250, 250, 250))
	end
	mk("Door", Vector3.new(3, 4.6, 0.4), Vector3.new(w * 0.3, 2.3, -d / 2 - 0.2), DARK)
	mk("Plinth", Vector3.new(w + 0.4, 0.8, d + 0.4), Vector3.new(0, 0.4, 0), C(225, 220, 212), M.Concrete)
	for fl = 1, math.floor((h - 7) / 4) do
		mk("UpperWin", Vector3.new(w * 0.7, 1.8, 0.3), Vector3.new(0, 6.5 + fl * 3.6, -d / 2 - 0.1), GLASS, M.Glass, { t = 0.25 })
	end
	mk("Awning", Vector3.new(w * 0.9, 0.5, 3.4), Vector3.new(0, 5.2, -d / 2 - 1.8), pal.accent2 or pal.accent)
	local sign = mk("Sign", Vector3.new(w * 0.6, 2.2, 0.4), Vector3.new(0, h - 1.8, -d / 2 - 0.3), DARK)
	Label(sign, Enum.NormalId.Front, pick(rng, { "PARTS", "TIRES", "AUTO", "SHOP", "MARKET", "SPEED" }), pal.accent)
	mk("AC", Vector3.new(3.4, 1.6, 3.4), Vector3.new(w / 4, h + 1.6, 0), C(170, 175, 185), M.Metal)
end

function B.house(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	h = math.min(h, 14)
	local col = pick(rng, pal.buildings)
	mk("Body", Vector3.new(w, h, d), Vector3.new(0, h / 2, 0), col)
	local roofH = math.min(9, d * 0.45)
	local roofCol = pick(rng, { C(200, 96, 80), C(110, 120, 150), C(90, 150, 140), C(160, 110, 170) })
	Part(parent, "RoofF", Vector3.new(w + 1.6, roofH, d / 2 + 0.8), cf * CFrame.new(0, h + roofH / 2, -d / 4 - 0.4), roofCol, M.SmoothPlastic, { class = "WedgePart" })
	Part(parent, "RoofB", Vector3.new(w + 1.6, roofH, d / 2 + 0.8), cf * CFrame.new(0, h + roofH / 2, d / 4 + 0.4) * CFrame.Angles(0, math.pi, 0), roofCol, M.SmoothPlastic, { class = "WedgePart" })
	mk("Chimney", Vector3.new(2.2, roofH, 2.2), Vector3.new(w * 0.3, h + roofH / 2 + 1, d * 0.15), C(170, 110, 90), M.Brick)
	local n = math.max(2, math.floor(w / 7))
	for i = 1, n do
		local x = -w / 2 + (i - 0.5) * (w / n)
		for fl = 0, math.floor((h - 3) / 5) - 1 do
			if not (fl == 0 and i == math.ceil(n / 2)) then
				mk("Win", Vector3.new(3, 2.8, 0.3), Vector3.new(x, 3.6 + fl * 5, -d / 2 - 0.1), GLASS, M.Glass, { t = 0.2 })
				mk("WinFrame", Vector3.new(3.6, 0.4, 0.5), Vector3.new(x, 2.1 + fl * 5, -d / 2 - 0.2), C(250, 250, 250))
			end
		end
	end
	mk("Door", Vector3.new(3.4, 5, 0.4), Vector3.new((math.ceil(n / 2) - 0.5) * (w / n) - w / 2, 2.5, -d / 2 - 0.2), pick(rng, { C(120, 80, 60), C(60, 110, 160), C(200, 80, 80) }))
	mk("Step", Vector3.new(5, 0.6, 2), Vector3.new((math.ceil(n / 2) - 0.5) * (w / n) - w / 2, 0.3, -d / 2 - 1), C(220, 214, 204), M.Concrete)
end

function B.cafe(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	h = math.min(h, 9)
	mk("Body", Vector3.new(w, h, d), Vector3.new(0, h / 2, 0), pick(rng, pal.buildings))
	mk("Glass", Vector3.new(w * 0.85, 3.6, 0.3), Vector3.new(0, 2.7, -d / 2 - 0.1), GLASS, M.Glass, { t = 0.3 })
	local n = 6
	for i = 1, n do
		local c = (i % 2 == 0) and C(250, 250, 250) or pal.accent
		mk("Stripe", Vector3.new(w * 0.9 / n, 0.4, 4), Vector3.new(-w * 0.45 + (i - 0.5) * (w * 0.9 / n), 5.4 - 0.1 * i, -d / 2 - 2.2), c)
	end
	local sign = mk("Sign", Vector3.new(w * 0.5, 2, 0.4), Vector3.new(0, h - 1.4, -d / 2 - 0.3), DARK)
	Label(sign, Enum.NormalId.Front, "CAFE", C(255, 200, 120))
	for i = -1, 1, 2 do
		mk("TableTop", Vector3.new(0.3, 3, 3), Vector3.new(i * w * 0.25, 2.4, -d / 2 - 6), C(240, 240, 240), M.SmoothPlastic, { shape = CYL }).CFrame = cf * CFrame.new(i * w * 0.25, 2.4, -d / 2 - 6) * UPRIGHT
		mk("TablePole", Vector3.new(2.2, 0.4, 0.4), Vector3.new(i * w * 0.25, 1.2, -d / 2 - 6), DARK).CFrame = cf * CFrame.new(i * w * 0.25, 1.2, -d / 2 - 6) * UPRIGHT
	end
end

function B.apartment(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	mk("Body", Vector3.new(w, h, d), Vector3.new(0, h / 2, 0), pick(rng, pal.buildings))
	local floors = math.floor((h - 4) / 4)
	for i = 0, floors - 1 do
		mk("Windows", Vector3.new(w - 4, 2.2, 0.3), Vector3.new(0, 5 + i * 4, -d / 2 - 0.1), GLASS, M.Glass, { t = 0.25 })
	end
	mk("Entrance", Vector3.new(5, 4, 0.5), Vector3.new(0, 2, -d / 2 - 0.2), DARK)
	mk("Ledge", Vector3.new(w + 1.2, 1, d + 1.2), Vector3.new(0, h + 0.5, 0), pal.accent)
	mk("Tank", Vector3.new(4, 4, 4), Vector3.new(-w / 4, h + 3, 0), C(140, 140, 150), M.Metal, { shape = CYL }).CFrame = cf * CFrame.new(-w / 4, h + 3, 0) * UPRIGHT
	for i = 0, floors - 1 do
		if i % 2 == 1 then
			for _, sx in ipairs({ -1, 1 }) do
				mk("Balcony", Vector3.new(6, 0.5, 2.2), Vector3.new(sx * w * 0.25, 3.8 + i * 4, -d / 2 - 1.1), C(240, 240, 244))
				mk("Rail", Vector3.new(6, 1.2, 0.2), Vector3.new(sx * w * 0.25, 4.6 + i * 4, -d / 2 - 2.1), pal.accent)
			end
		end
	end
	mk("RoofGarden", Vector3.new(w * 0.35, 0.8, d * 0.4), Vector3.new(w / 5, h + 1.4, 0), C(100, 170, 90), M.Grass)
end

function B.tower(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	local col = pick(rng, pal.buildings)
	local h1 = h * 0.62
	mk("Base", Vector3.new(w, h1, d), Vector3.new(0, h1 / 2, 0), col)
	mk("Top", Vector3.new(w * 0.72, h - h1, d * 0.72), Vector3.new(0, h1 + (h - h1) / 2, 0), col)
	for i = 0, math.floor(h1 / 5) - 1 do
		mk("WinBand", Vector3.new(w - 3, 2.4, 0.3), Vector3.new(0, 4 + i * 5, -d / 2 - 0.1), GLASS, M.Glass, { t = 0.2 })
	end
	mk("Spire", Vector3.new(0.6, 8, 0.6), Vector3.new(0, h + 4, 0), DARK, M.Metal)
	mk("Beacon", Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, h + 8.4, 0), C(255, 60, 60), M.Neon, { shape = BALL })
end

function B.dealership(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	h = math.min(h, 10)
	mk("Back", Vector3.new(w, h, 3), Vector3.new(0, h / 2, d / 2 - 1.5), C(230, 232, 238))
	mk("SideL", Vector3.new(3, h, d), Vector3.new(-w / 2 + 1.5, h / 2, 0), C(230, 232, 238))
	mk("SideR", Vector3.new(3, h, d), Vector3.new(w / 2 - 1.5, h / 2, 0), C(230, 232, 238))
	mk("Roof", Vector3.new(w + 2, 1, d + 4), Vector3.new(0, h + 0.5, -1), pal.accent)
	mk("Glass", Vector3.new(w - 6, h - 2, 0.3), Vector3.new(0, h / 2, -d / 2), GLASS, M.Glass, { t = 0.5 })
	mk("Floor", Vector3.new(w - 6, 0.3, d - 3), Vector3.new(0, 0.3, 0), C(60, 62, 70))
	local sign = mk("Sign", Vector3.new(w * 0.5, 2.6, 0.4), Vector3.new(0, h + 2.2, -d / 2 - 1), DARK)
	Label(sign, Enum.NormalId.Front, "MOTORS", pal.accent)
	local car = VehicleFactory.Build(pick(rng, { "sport", "supercar", "sedan" }), { BodyColor = pick(rng, { C(220, 50, 50), C(240, 200, 40), C(60, 120, 230) }), Spoiler = true })
	car:PivotTo(cf * CFrame.new(0, 0.5, -d / 2 + 9) * CFrame.Angles(0, math.pi / 2 + 0.4, 0))
	car.Parent = parent
end

function B.garage(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	h = math.min(h, 10)
	mk("Body", Vector3.new(w, h, d), Vector3.new(0, h / 2, 0), C(160, 165, 175))
	for i = 0, 3 do
		mk("Roller", Vector3.new(w * 0.55, 1.4, 0.4), Vector3.new(0, 1 + i * 1.5, -d / 2 - 0.2), (i % 2 == 0) and C(235, 235, 240) or C(205, 208, 215))
	end
	mk("Hazard", Vector3.new(w * 0.6, 0.6, 0.5), Vector3.new(0, 7.4, -d / 2 - 0.2), C(255, 200, 30))
	mk("Roof", Vector3.new(w + 1, 0.8, d + 1), Vector3.new(0, h + 0.4, 0), pal.accent)
end

function B.billboard(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	mk("PostL", Vector3.new(1.4, 29.6, 1.4), Vector3.new(-w / 2 - 0.6, 14.8, 0), DARK, M.Metal)
	mk("PostR", Vector3.new(1.4, 29.6, 1.4), Vector3.new(w / 2 + 0.6, 14.8, 0), DARK, M.Metal)
	local b = mk("Board", Vector3.new(w, 12, 1), Vector3.new(0, 24, 0), C(20, 22, 30))
	local msgs = { "TURBO FUEL", "FAST LANE", "HUNT THE CARS", "NITRO DRINK", "ROAD KING" }
	local t = pick(rng, msgs)
	Label(b, Enum.NormalId.Front, t, pal.accent)
	Label(b, Enum.NormalId.Back, t, pal.accent)
end

function B.gasstation(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	mk("Shop", Vector3.new(w * 0.45, 8, d * 0.5), Vector3.new(w * 0.27, 4, d * 0.2), C(235, 235, 240))
	mk("ShopGlass", Vector3.new(w * 0.35, 3, 0.3), Vector3.new(w * 0.27, 3, d * 0.2 - d * 0.25 - 0.1), GLASS, M.Glass, { t = 0.3 })
	mk("Canopy", Vector3.new(w * 0.7, 1, d * 0.45), Vector3.new(-w * 0.12, 10, -d * 0.18), pal.accent2 or pal.accent)
	for _, sx in ipairs({ -1, 1 }) do
		mk("Pillar", Vector3.new(1.2, 10, 1.2), Vector3.new(-w * 0.12 + sx * w * 0.3, 5, -d * 0.18 - d * 0.18), DARK, M.Metal)
	end
	for i = -1, 1, 2 do
		mk("Pump", Vector3.new(1.6, 4, 2.4), Vector3.new(-w * 0.12 + i * w * 0.12, 2, -d * 0.18), pal.accent)
	end
	local s = mk("Sign", Vector3.new(w * 0.5, 2, 0.4), Vector3.new(-w * 0.12, 11.3, -d * 0.4), DARK)
	Label(s, Enum.NormalId.Front, "FUEL", C(255, 240, 120))
end

function B.motel(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	h = math.min(h, 9)
	mk("Body", Vector3.new(w, h, d), Vector3.new(0, h / 2, 0), pick(rng, pal.buildings))
	local n = math.floor(w / 8)
	for i = 1, n do
		local x = -w / 2 + (i - 0.5) * (w / n)
		mk("Door", Vector3.new(2.6, 4.6, 0.4), Vector3.new(x, 2.3, -d / 2 - 0.2), DARK)
		mk("Window", Vector3.new(3, 2.4, 0.3), Vector3.new(x, 6.4, -d / 2 - 0.1), GLASS, M.Glass, { t = 0.25 })
	end
	mk("Roof", Vector3.new(w + 1.5, 0.8, d + 1.5), Vector3.new(0, h + 0.4, 0), pal.accent)
end

function B.warehouse(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	h = math.max(h, 12)
	mk("Body", Vector3.new(w, h, d), Vector3.new(0, h / 2, 0), pick(rng, pal.buildings), M.Metal)
	local ribs = math.floor(w / 6)
	for i = 1, ribs do
		mk("Rib", Vector3.new(1, 1.2, d + 1), Vector3.new(-w / 2 + (i - 0.5) * (w / ribs), h + 0.6, 0), C(120, 126, 136), M.Metal)
	end
	mk("Door", Vector3.new(w * 0.4, h * 0.6, 0.4), Vector3.new(0, h * 0.3, -d / 2 - 0.2), C(90, 96, 108), M.Metal)
	mk("DoorStripe", Vector3.new(w * 0.4, 0.8, 0.5), Vector3.new(0, h * 0.62, -d / 2 - 0.2), pal.accent)
	mk("Vent", Vector3.new(3, 2, 3), Vector3.new(w * 0.3, h + 2, 0), C(170, 175, 185), M.Metal)
end

function B.containers(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	local cols = { C(200, 70, 50), C(60, 110, 190), C(230, 180, 40), C(70, 150, 90), C(180, 180, 190) }
	local nx = math.max(1, math.floor(w / 13))
	for ix = 1, nx do
		local stack = math.floor(rr(rng, 1, 4))
		for iy = 1, stack do
			local off = Vector3.new(-w / 2 + (ix - 0.5) * (w / nx), (iy - 1) * 4.3, -d / 2 + 4)
			if not Prefabs.FromTemplate("Container", parent, cf * CFrame.new(off), { colors = { Trim = pick(rng, cols) } }) then
				mk("Container", Vector3.new(12, 4.2, 5), off + Vector3.new(0, 2.1, 0), pick(rng, cols), M.Metal)
			end
		end
		local stack2 = math.floor(rr(rng, 1, 3))
		for iy = 1, stack2 do
			local off = Vector3.new(-w / 2 + (ix - 0.5) * (w / nx), (iy - 1) * 4.3, -d / 2 + 10)
			if not Prefabs.FromTemplate("Container", parent, cf * CFrame.new(off), { colors = { Trim = pick(rng, cols) } }) then
				mk("Container", Vector3.new(12, 4.2, 5), off + Vector3.new(0, 2.1, 0), pick(rng, cols), M.Metal)
			end
		end
	end
end

function B.silo(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	local r = math.min(w, d) * 0.4
	for i = -1, 1, 2 do
		local x = i * r * 1.1
		mk("Silo", Vector3.new(h, r * 2, r * 2), Vector3.new(x, h / 2, 0), C(200, 204, 212), M.Metal, { shape = CYL }).CFrame = cf * CFrame.new(x, h / 2, 0) * UPRIGHT
		mk("Dome", Vector3.new(r * 2, r * 1.2, r * 2), Vector3.new(x, h + 0.2, 0), C(170, 90, 70), M.Metal, { shape = BALL })
	end
	mk("Pipe", Vector3.new(r * 2.4, 1, 1), Vector3.new(0, h * 0.7, 0), C(90, 96, 108), M.Metal)
end

function B.factory(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	h = math.max(h, 14)
	mk("Body", Vector3.new(w, h, d), Vector3.new(0, h / 2, 0), pick(rng, pal.buildings), M.Brick)
	for i = 1, 3 do
		mk("Window", Vector3.new(w * 0.18, 3, 0.3), Vector3.new(-w * 0.3 + (i - 1) * w * 0.3, h * 0.6, -d / 2 - 0.1), C(255, 210, 120), M.Neon, { t = 0.2 })
	end
	mk("Chimney", Vector3.new(h * 1.2, 3.2, 3.2), Vector3.new(w * 0.3, h + h * 0.55, d * 0.2), C(120, 90, 80), M.Brick, { shape = CYL }).CFrame = cf * CFrame.new(w * 0.3, h + h * 0.55, d * 0.2) * UPRIGHT
	mk("ChimneyTop", Vector3.new(3.8, 1.2, 3.8), Vector3.new(w * 0.3, h + h * 1.1, d * 0.2), pal.accent, M.SmoothPlastic)
	mk("Roof", Vector3.new(w + 1, 1, d + 1), Vector3.new(0, h + 0.5, 0), C(100, 104, 114), M.Metal)
end

function B.pipes(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	for i = 0, 2 do
		mk("Pipe", Vector3.new(w, 2.2, 2.2), Vector3.new(0, 4 + i * 2.8, 0), (i % 2 == 0) and C(190, 90, 60) or C(120, 130, 145), M.Metal, { shape = CYL })
	end
	for i = 0, 3 do
		mk("Support", Vector3.new(1.2, 10, 3), Vector3.new(-w / 2 + 3 + i * (w - 6) / 3, 5, 0), DARK, M.Metal)
	end
end

function B.neontower(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	local col = pick(rng, pal.buildings)
	mk("Body", Vector3.new(w, h, d), Vector3.new(0, h / 2, 0), col)
	local nc = pick(rng, { pal.accent, pal.accent2 })
	for i = -1, 1 do
		mk("NeonStrip", Vector3.new(0.8, h * 0.9, 0.5), Vector3.new(i * w * 0.3, h / 2, -d / 2 - 0.2), nc, M.Neon)
	end
	for i = 0, math.floor(h / 8) - 1 do
		mk("WinBand", Vector3.new(w - 4, 1.2, 0.3), Vector3.new(0, 5 + i * 8, -d / 2 - 0.15), C(120, 180, 255), M.Neon, { t = 0.5 })
	end
	mk("TopRing", Vector3.new(w + 2, 1, d + 2), Vector3.new(0, h + 0.5, 0), nc, M.Neon)
end

function B.club(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	h = math.min(h, 12)
	mk("Body", Vector3.new(w, h, d), Vector3.new(0, h / 2, 0), C(18, 18, 28))
	local sign = mk("Sign", Vector3.new(w * 0.8, 5, 0.6), Vector3.new(0, h - 2, -d / 2 - 0.4), C(8, 8, 14))
	Label(sign, Enum.NormalId.Front, pick(rng, { "NEON CLUB", "TURBO BAR", "HOLO LOUNGE", "DRIFT" }), pal.accent)
	mk("DoorGlow", Vector3.new(5, 6, 0.4), Vector3.new(0, 3, -d / 2 - 0.3), pal.accent2, M.Neon)
	mk("EdgeL", Vector3.new(0.6, h, 0.6), Vector3.new(-w / 2, h / 2, -d / 2), pal.accent, M.Neon)
	mk("EdgeR", Vector3.new(0.6, h, 0.6), Vector3.new(w / 2, h / 2, -d / 2), pal.accent, M.Neon)
end

function B.holosign(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	mk("Pole", Vector3.new(1.2, 12, 1.2), Vector3.new(0, 6, 0), DARK, M.Metal)
	local s = mk("Holo", Vector3.new(w, 10, 0.5), Vector3.new(0, 17, 0), pal.accent2, M.Neon, { t = 0.55, collide = false })
	local word = pick(rng, { "HUNT", "SPEED", "NEON", "WIN" })
	Label(s, Enum.NormalId.Front, word, C(255, 255, 255))
	Label(s, Enum.NormalId.Back, word, C(255, 255, 255))
	mk("Frame", Vector3.new(w + 1, 0.6, 0.8), Vector3.new(0, 22, 0), pal.accent, M.Neon)
	mk("FrameB", Vector3.new(w + 1, 0.6, 0.8), Vector3.new(0, 11.8, 0), pal.accent, M.Neon)
end

Prefabs.Buildings = B

function Prefabs.TireStack(parent, pos, rng)
	if Prefabs.FromTemplate("TireStack", parent, CFrame.new(pos) * CFrame.Angles(0, rr(rng, 0, 6), 0)) then
		return
	end
	local n = math.floor(rr(rng, 2, 4.99))
	for i = 1, n do
		local cf = CFrame.new(pos + Vector3.new(rr(rng, -0.3, 0.3), 0.75 + (i - 1) * 1.45, rr(rng, -0.3, 0.3))) * UPRIGHT
		Part(parent, "Tire", Vector3.new(1.4, 4, 4), cf, C(30, 30, 34), M.SmoothPlastic, { shape = CYL })
		Part(parent, "TireRim", Vector3.new(1.46, 2, 2), cf, pick(rng, { C(255, 210, 63), C(255, 59, 59), C(46, 168, 255), C(52, 208, 88) }), M.SmoothPlastic, { shape = CYL, collide = false })
	end
end

-- checkered strip (finish-line flag look)
function Prefabs.Checker(parent, cf, len, h, d)
	local n = math.floor(len / 2)
	for i = 0, n - 1 do
		for row = 0, 1 do
			if (i + row) % 2 == 0 then
				Part(parent, "Checker", Vector3.new(len / n, h / 2, d), cf * CFrame.new(-len / 2 + (i + 0.5) * len / n, (row - 0.5) * h / 2, 0), C(250, 250, 250), M.SmoothPlastic, { collide = false, cast = false })
			end
		end
	end
	Part(parent, "CheckerBack", Vector3.new(len, h, d - 0.1), cf, C(20, 20, 24), M.SmoothPlastic, { collide = false })
end

local PARKED = { "compact", "sedan", "taxi", "van", "pickup", "sport" }
function Prefabs.ParkedCar(parent, cf, rng, kinds)
	local kind = pick(rng, kinds or PARKED)
	local m = VehicleFactory.BuildTraffic(kind, pick(rng, MapConfig.TrafficColors), math.floor(rr(rng, 1, 9)))
	m:PivotTo(cf)
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = d.Name == "Root" and false or true
		end
	end
	m.Parent = parent
	Prefabs.Count = Prefabs.Count + 1
	return m
end

Prefabs.Archetypes = {
	city = {
		{ "shop", 24, 36, 10, 14 }, { "cafe", 22, 30, 8, 9 }, { "apartment", 26, 36, 18, 28 }, { "house", 22, 30, 10, 13 },
		{ "tower", 26, 32, 28, 40 }, { "dealership", 38, 46, 9, 10 }, { "garage", 24, 32, 9, 10 },
	},
	highway = {
		{ "gasstation", 40, 48, 8, 8 }, { "motel", 40, 58, 8, 9 }, { "billboard", 34, 40, 20, 20 },
		{ "shop", 26, 34, 10, 12 }, { "tower", 26, 32, 24, 34 },
	},
	industrial = {
		{ "warehouse", 36, 56, 12, 16 }, { "containers", 28, 40, 8, 8 }, { "silo", 24, 30, 22, 28 },
		{ "factory", 34, 44, 14, 20 }, { "pipes", 30, 44, 10, 10 },
	},
	neon = {
		{ "neontower", 26, 34, 30, 52 }, { "club", 30, 40, 10, 12 }, { "holosign", 20, 24, 20, 22 },
		{ "neontower", 24, 30, 26, 44 }, { "club", 28, 36, 9, 11 },
	},
}

-- Blender building scaled to fit the lot (footprint from ModelSizes), recoloured with the district palette
local ROOFS = { C(200, 96, 80), C(110, 120, 150), C(90, 150, 140), C(160, 110, 170), C(230, 170, 70) }
function Prefabs.Building(kind, parent, cf, w, d, h, pal, rng)
	local info = ModelSizes["B_" .. kind]
	if info and info.w and kind ~= "containers" and kind ~= "billboard" and kind ~= "holosign" and kind ~= "pipes" then
		local s = math.min(w / info.w, d / info.d)
		local m = Prefabs.FromTemplate("B_" .. kind, parent, cf, { scale = s, colors = { Wall = pick(rng, pal.buildings), Trim = pal.accent, Roof = pick(rng, ROOFS) } })
		if m then
			return
		end
	end
	local fn = B[kind]
	if fn then
		fn(parent, cf, w, d, h, pal, rng)
	end
end

return Prefabs
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX25A622251ACF46EAAB9442173615024F"><Properties><string name="Name">CarStoreTool</string><ProtectedString name="Source">-- Installs real car models from the Roblox Creator Store (free models) into ReplicatedStorage.CarModels.
-- Run in Studio (edit mode), View &gt; Command Bar:
--   require(game.ServerStorage.Tools.CarStoreTool).InstallAll()
--   require(game.ServerStorage.Tools.CarStoreTool).Install("bmv_m3", 2629351758)   -- any other asset id
-- Every model is stripped of scripts, sounds, GUIs, seats logic, welds and constraints before it is used.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local InsertService = game:GetService("InsertService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local WheelKit = require(Shared:WaitForChild("WheelKit"))

