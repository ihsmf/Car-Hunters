}

Strings.Tables = { en = en }
Strings.Lang = "en"

function Strings.SetLocale()
	Strings.Lang = "en"
end

function Strings.T(key, ...)
	local s = en[key] or key
	if select("#", ...) &gt; 0 then
		local ok, res = pcall(string.format, s, ...)
		if ok then
			return res
		end
	end
	return s
end

return Strings
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX21"><Properties><string name="Name">TrafficMath</string><ProtectedString name="Source">local MapConfig = require(script.Parent.MapConfig)

local M = {}

M.Length = 2 * (MapConfig.MapHalfWidth + MapConfig.TunnelLength)
M.MinX = -(MapConfig.MapHalfWidth + MapConfig.TunnelLength)
M.VisibleHalfX = MapConfig.MapHalfWidth + 30

local function newRng(seed)
	local s = (math.floor(seed) % 2147483646) + 1
	return function()
		s = (s * 16807) % 2147483647
		return s / 2147483647
	end
end
M.NewRng = newRng

M.Lanes = {}
M.RoadLanes = {}

for ri, road in ipairs(MapConfig.Roads) do
	local rng = newRng(MapConfig.Seed + ri * 7919)
	local lanes = {}
	local lps, lw, med = road.lanesPerSide, road.laneWidth, road.median
	for _, side in ipairs({ -1, 1 }) do
		for i = 1, lps do
			local zoff
			if side == -1 then
				zoff = -(med / 2) - lw * (i - 0.5)
			else
				zoff = (med / 2) + lw * (i - 0.5)
			end
			local dir = (side == -1) and 1 or -1
			local speed = road.speed[1] + (road.speed[2] - road.speed[1]) * rng()
			local spacing = road.spacing[1] + (road.spacing[2] - road.spacing[1]) * rng()
			local loop = road.loop or M.Length -- trains/planes run a long loop so they show up rarely
			local n = road.count or math.max(2, math.floor(loop / spacing + 0.5))
			local S = loop / n
			local offsets, kinds, colors = {}, {}, {}
			for k = 1, n do
				offsets[k] = (k - 1) * S + (rng() * 2 - 1) * 0.18 * S
				kinds[k] = road.kinds[math.floor(rng() * #road.kinds) + 1]
				colors[k] = math.floor(rng() * #MapConfig.TrafficColors) + 1
			end
			local lane = {
				road = ri, index = #M.Lanes + 1, side = side, dir = dir, z = road.z + zoff,
				speed = speed, count = n, spacing = S, offsets = offsets, kinds = kinds,
				colors = colors, phase = rng() * loop, loop = loop,
			}
			if road.weave then
				lane.weaveA = road.weave
				lane.weaveW = 2 * math.pi / (2.2 + rng() * 1.6)
				lane.weavePh = {}
				for k = 1, n do
					lane.weavePh[k] = rng() * 2 * math.pi
				end
			end
			local sg = MapConfig.Surge
			if sg then
				local period = sg.period[1] + (sg.period[2] - sg.period[1]) * rng()
				lane.surgeW = 2 * math.pi / period
				lane.surgeA = (road.surge or sg.amp) * speed / lane.surgeW
				lane.surgePhase = rng() * 2 * math.pi
			end
			table.insert(lanes, lane)
			table.insert(M.Lanes, lane)
		end
	end
	M.RoadLanes[ri] = lanes
end

function M.CarX(lane, k, t)
	local surge = lane.surgeA and lane.surgeA * math.sin(lane.surgeW * t + lane.surgePhase) or 0
	local d = (lane.speed * t + surge + lane.phase + lane.offsets[k]) % lane.loop
	local x = M.MinX + d
	if lane.dir &lt; 0 then
		x = -x
	end
	return x
end

-- lane centre z of car k at time t (drift lanes weave side to side)
function M.CarZ(lane, k, t)
	if lane.weaveA then
		return lane.z + lane.weaveA * math.sin(lane.weaveW * t + lane.weavePh[k])
	end
	return lane.z
end

function M.RoadAtZ(z, margin)
	margin = margin or 0
	for ri, road in ipairs(MapConfig.Roads) do
		if math.abs(z - road.z) &lt;= road.width / 2 + margin then
			return ri
		end
	end
	return nil
end

return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22"><Properties><string name="Name">Util</string><ProtectedString name="Source">local Util = {}

function Util.Clamp(v, lo, hi)
	if v &lt; lo then return lo end
	if v &gt; hi then return hi end
	return v
end

function Util.IsInt(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge and n == math.floor(n)
end

function Util.FormatNumber(n)
	n = math.floor((tonumber(n) or 0) + 0.5)
	if n &lt; 1000 then
		return tostring(n)
	end
	local units = { { 1e15, "Qa" }, { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } }
	for _, u in ipairs(units) do
		if n &gt;= u[1] then
			local v = n / u[1]
			local s
			if v &gt;= 100 then
				s = string.format("%d", math.floor(v))
			elseif v &gt;= 10 then
				s = string.format("%.1f", v)
			else
				s = string.format("%.2f", v)
			end
			if string.find(s, ".", 1, true) then
				s = string.gsub(s, "0+$", "")
				s = string.gsub(s, "%.$", "")
			end
			return s .. u[2]
		end
	end
	return tostring(n)
end

function Util.WeightedPick(entries, r)
	local total = 0
	for _, e in ipairs(entries) do
		total = total + e[2]
	end
	if total &lt;= 0 then
		return nil
	end
	local acc = 0
	local target = r * total
	for _, e in ipairs(entries) do
		acc = acc + e[2]
		if target &lt; acc then
			return e[1]
		end
	end
	return entries[#entries][1]
end

function Util.CopyTable(t)
	local out = {}
	for k, v in pairs(t) do
		if type(v) == "table" then
			out[k] = Util.CopyTable(v)
		else
			out[k] = v
		end
	end
	return out
end

return Util
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX23"><Properties><string name="Name">VehicleFactory</string><ProtectedString name="Source">local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Kinds = require(script.Parent.VehicleKinds)
local WheelKit = require(script.Parent.WheelKit)

local VehicleFactory = {}
VehicleFactory.Kinds = Kinds

local GLASS = Color3.fromRGB(70, 98, 130)
local DARK = Color3.fromRGB(30, 30, 36)
local TIRE = Color3.fromRGB(26, 26, 30)
local SILVER = Color3.fromRGB(205, 210, 220)
local HEAD = Color3.fromRGB(255, 246, 210)
local TAIL = Color3.fromRGB(255, 46, 60)
local M = Enum.Material
local CYL = Enum.PartType.Cylinder
local ACROSS = CFrame.Angles(0, math.pi / 2, 0)
local SPORTY = { sport = true, supercar = true, proto = true }
local BOXY = { van = true, truck = true, service = true, minibus = true }

local templateCache = {}

-- render-cost trims for decoration parts. CollisionFidelity / RenderFidelity are not writable from every
-- script context, so each is tried once and skipped for good when the engine refuses it.
local canSetFidelity, canSetRender = nil, nil
local function trimPart(d)
	local s = d.Size
	if math.max(s.X, s.Y, s.Z) &lt; 2 then
		d.CastShadow = false -- tiny parts: shadows cost draw calls and are invisible anyway
	end
	if canSetFidelity ~= false and d:IsA("MeshPart") then
		local ok = pcall(function()
			d.CollisionFidelity = Enum.CollisionFidelity.Box
		end)
		canSetFidelity = ok
	end
end
local function lowRender(d)
	if canSetRender ~= false and d:IsA("MeshPart") then
		local ok = pcall(function()
			d.RenderFidelity = Enum.RenderFidelity.Performance
		end)
		canSetRender = ok
	end
end

local function newRoot()
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(1, 0.2, 1)
	root.CFrame = CFrame.new()
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Transparency = 1
	return root
end

local function modelsFolder()
	return ReplicatedStorage:FindFirstChild("CarModels")
end

local function hasGeometry(m)
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			return true
		end
	end
	return false
end

local function prepareTemplate(tpl, targetL, opts)
	local m = tpl:Clone()
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("LuaSourceContainer") or d:IsA("JointInstance") or d:IsA("Constraint") or d:IsA("Sound")
			or d:IsA("ProximityPrompt") or d:IsA("ClickDetector") or d:IsA("BodyMover") or d:IsA("Humanoid") then
			d:Destroy()
		end
	end
	m.PrimaryPart = nil
	m.WorldPivot = CFrame.new(m:GetPivot().Position)
	local bb, size = m:GetBoundingBox()
	local alongZ = size.Z &gt; size.X
	local length = math.max(size.X, size.Z, 0.1)
	local scale = targetL / length
	m.WorldPivot = CFrame.new(bb.Position)
	if math.abs(scale - 1) &gt; 1e-3 then
		m:ScaleTo(m:GetScale() * scale)
	end
	local bottom = bb.Position.Y - size.Y * scale / 2
	local yaw = (alongZ and math.pi / 2 or 0) + math.rad(tonumber(tpl:GetAttribute("Yaw")) or 0)
	local root = newRoot()
	root.CFrame = CFrame.new(bb.Position.X, bottom, bb.Position.Z) * CFrame.Angles(0, yaw, 0)
	root.Parent = m
	-- safety net: put a wheel wherever one should be and nothing visible is (store cars lose theirs)
	if not tpl:GetAttribute("NoWheelFix") then
		local ok, err = pcall(function()
			local fwd = alongZ and Vector3.new(0, 0, -1) or Vector3.new(1, 0, 0)
			WheelKit.Ensure(m, fwd, WheelKit.Load(m, scale))
		end)
		if not ok then
			warn("[CarModels] wheel fix failed for", tpl.Name, err)
		end
	end
	local recolor = tpl:GetAttribute("Recolor") == true
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") and d ~= root then
			d.Anchored = false
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true
			trimPart(d)
			if d:IsA("Seat") or d:IsA("VehicleSeat") then
				d.Disabled = true
			end
			if recolor and opts.BodyColor then
				local n = string.lower(d.Name)
				if string.find(n, "body", 1, true) or string.find(n, "paint", 1, true) then
					d.Color = opts.BodyColor
				end
			end
			local w = Instance.new("WeldConstraint")
			w.Part0 = root
			w.Part1 = d
			w.Parent = d
		end
	end
	m.PrimaryPart = root
	m:PivotTo(CFrame.new())
	m.Name = "Vehicle"
	m:SetAttribute("RealModel", true)
	m:SetAttribute("Height", size.Y * scale)
	return m
end

-- a failed prepare is retried (v25): the model may still be arriving (server start installs the cars after early
-- clients joined), so it is tried again after RETRY_AFTER seconds. After MAX_TRIES failures, or a failure once
-- ReplicatedStorage "CarsReady" is set, the failure is cached for good (templateCache[key] = false: procedural car)
local RETRY_AFTER = 8
local MAX_TRIES = 3
local failedAt, failCount = {}, {}
local function fromTemplate(key, tpl, targetL, opts)
	local cached = templateCache[key]
	if cached == false then
		return nil
	end
	if cached == nil then
		local t = failedAt[key]
		if t and os.clock() - t &lt; RETRY_AFTER then
			return nil
		end
		local ok, res = pcall(prepareTemplate, tpl, targetL, opts)
		if ok and res then
			cached = res
			templateCache[key] = cached
			failedAt[key], failCount[key] = nil, nil
		else
			warn("[CarModels] could not prepare", tpl:GetFullName(), res)
			local n = (failCount[key] or 0) + 1
			if n &gt;= MAX_TRIES or ReplicatedStorage:GetAttribute("CarsReady") == true then
				templateCache[key] = false
				failedAt[key], failCount[key] = nil, nil
			else
				failedAt[key], failCount[key] = os.clock(), n
			end
			return nil
		end
	end
	return cached:Clone()
end

local function addNeonGlow(model, k, neon)
	local root = model.PrimaryPart
	local p = Instance.new("Part")
	p.Name = "Underglow"
	p.Size = Vector3.new(k.L * 0.8, 0.15, k.W * 0.85)
	p.CFrame = root.CFrame * CFrame.new(0, 0.25, 0)
	p.Color = neon
	p.Material = M.Neon
	p.Transparency = 0.15
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	local w = Instance.new("WeldConstraint")
	w.Part0 = root
	w.Part1 = p
	w.Parent = p
	p.Parent = model
end

function VehicleFactory.Build(kindName, opts)
	opts = opts or {}
	local k = Kinds[kindName] or Kinds.sedan
	local body = opts.BodyColor or k.color
	local accent = opts.AccentColor or DARK
	local neon = opts.NeonColor
	local low = opts.Low == true
	local sporty = SPORTY[kindName] == true
	local boxy = BOXY[kindName] == true

	local model = Instance.new("Model")
	model.Name = "Vehicle"
	local root = newRoot()
	root.Parent = model
	model.PrimaryPart = root

	local function add(name, size, cf, color, material, transparency, shape, class)
		local p = Instance.new(class or "Part")
		p.Name = name
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Material = material or M.SmoothPlastic
		p.Transparency = transparency or 0
		if shape then
			p.Shape = shape
		end
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Anchored = false
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.CastShadow = not low
		p.Parent = model
		local w = Instance.new("Weld")
		w.Part0 = root
		w.Part1 = p
		w.C0 = cf
		w.Parent = p
		return p
	end
	local function wedge(name, size, cf, color, material, transparency)
		return add(name, size, cf, color, material, transparency, nil, "WedgePart")
	end

	local L, W = k.L, k.W
	local clear, bodyH = k.clear, k.bodyH
	local r = bodyH / 2
	local topY = clear + bodyH
	local midY = clear + r

	local bodyPart = add("Body", Vector3.new(L - bodyH, bodyH, W), CFrame.new(0, midY, 0), body)
	local noseF = add("BodyNose", Vector3.new(W, bodyH, bodyH), CFrame.new(L / 2 - r, midY, 0) * ACROSS, body, nil, 0, CYL)
	local noseB = add("BodyTail", Vector3.new(W, bodyH, bodyH), CFrame.new(-L / 2 + r, midY, 0) * ACROSS, body, nil, 0, CYL)
	if opts.Chrome then
		for _, p in ipairs({ bodyPart, noseF, noseB }) do
			p.Reflectance = 0.35
			p.Material = M.Metal
		end
	end
	add("Skirt", Vector3.new(L - bodyH * 0.6, 0.35, W + 0.06), CFrame.new(0, clear + 0.18, 0), accent)

	local roofTop = topY
	if k.cabinL and k.cabinL &gt; 0 then
		local gh = k.cabinH
		local cw = W * k.cabinW
		local glassColor, glassMat, glassTr = GLASS, M.Glass, 0.15
		if k.canopyNeon and neon then
			glassColor, glassMat, glassTr = neon, M.Neon, 0.35
		end
		local wfK, wrK = 0.28, 0.2
		if sporty then
			wfK, wrK = 0.4, 0.3
		elseif boxy then
			wfK, wrK = 0.14, 0.05
		elseif kindName == "pickup" then
			wfK, wrK = 0.24, 0.06
		end
		local wf, wr = k.cabinL * wfK, k.cabinL * wrK
		local rl = k.cabinL - wf - wr
		local front = k.cabinX + k.cabinL / 2
		local cy = topY + gh / 2
		wedge("Windshield", Vector3.new(cw, gh, wf), CFrame.new(front - wf / 2, cy, 0) * CFrame.Angles(0, -math.pi / 2, 0), glassColor, glassMat, glassTr)
		add("Cabin", Vector3.new(rl, gh, cw), CFrame.new(front - wf - rl / 2, cy, 0), glassColor, glassMat, glassTr)
		if wr &gt; 0.05 then
			wedge("RearGlass", Vector3.new(cw, gh, wr), CFrame.new(front - wf - rl - wr / 2, cy, 0) * CFrame.Angles(0, math.pi / 2, 0), glassColor, glassMat, glassTr)
		end
		add("Roof", Vector3.new(rl + 0.3, 0.3, cw + 0.12), CFrame.new(front - wf - rl / 2, topY + gh + 0.15, 0), body)
		if not low then
			add("PillarF", Vector3.new(0.35, gh, cw + 0.1), CFrame.new(front - wf - 0.17, cy, 0), body)
			add("PillarB", Vector3.new(0.35, gh, cw + 0.1), CFrame.new(front - wf - rl + 0.17, cy, 0), body)
			add("PillarM", Vector3.new(0.3, gh, cw + 0.1), CFrame.new(front - wf - rl / 2, cy, 0), body)
			for _, s in ipairs({ -1, 1 }) do
				add("Mirror", Vector3.new(0.5, 0.4, 0.5), CFrame.new(front - 0.2, topY + 0.3, s * (W / 2 + 0.15)), body)
			end
			local hoodL = L / 2 - front - r * 0.6
			if hoodL &gt; 1.2 and not boxy then
				wedge("Hood", Vector3.new(W * 0.86, 0.35, hoodL), CFrame.new(front + hoodL / 2, topY + 0.17, 0) * CFrame.Angles(0, -math.pi / 2, 0), body)
			end
		end
		roofTop = topY + gh + 0.3
	end

	if k.box then
		add("Cargo", Vector3.new(k.box.L, k.box.H, W * 0.98), CFrame.new(k.box.x, topY + k.box.H / 2, 0), opts.CargoColor or Color3.fromRGB(236, 238, 244))
		if not low then
			add("CargoTrim", Vector3.new(k.box.L + 0.1, 0.3, W + 0.04), CFrame.new(k.box.x, topY + k.box.H - 0.15, 0), accent)
			add("CargoStripe", Vector3.new(k.box.L * 0.9, 0.6, W + 0.02), CFrame.new(k.box.x, topY + k.box.H * 0.45, 0), body)
		end
		roofTop = math.max(roofTop, topY + k.box.H)
	end

	if k.bed then
		local bw = W * 0.92
		add("BedFloor", Vector3.new(k.bed.L, 0.25, bw), CFrame.new(k.bed.x, topY + 0.12, 0), accent)
		add("BedSideL", Vector3.new(k.bed.L, 0.9, 0.3), CFrame.new(k.bed.x, topY + 0.7, bw / 2 - 0.15), body)
		add("BedSideR", Vector3.new(k.bed.L, 0.9, 0.3), CFrame.new(k.bed.x, topY + 0.7, -bw / 2 + 0.15), body)
		add("BedBack", Vector3.new(0.3, 0.9, bw), CFrame.new(k.bed.x - k.bed.L / 2 + 0.15, topY + 0.7, 0), body)
	end

	local axles = { 0.31, -0.31 }
	if k.sixWheels then
		axles = { 0.36, -0.18, -0.34 }
	end
	local rimColor = (neon and not low) and neon or SILVER
	for _, ax in ipairs(axles) do
		for _, sgn in ipairs({ -1, 1 }) do
			local z = sgn * (W / 2 - 0.4)
			local cf = CFrame.new(L * ax, k.wr, z) * ACROSS
			add("Wheel", Vector3.new(1.0, k.wr * 2, k.wr * 2), cf, TIRE, M.SmoothPlastic, 0, CYL)
			add("Rim", Vector3.new(1.06, k.wr * 1.25, k.wr * 1.25), cf, rimColor, M.Metal, 0, CYL)
			if not low then
				add("Hub", Vector3.new(1.12, k.wr * 0.45, k.wr * 0.45), cf, DARK, M.Metal, 0, CYL)
				add("Arch", Vector3.new(k.wr * 2.3, 0.35, 0.5), CFrame.new(L * ax, clear + bodyH * 0.92, sgn * (W / 2 + 0.05)), accent)
			end
		end
	end

	local function noseX(y)
		local dy = y - midY
		return L / 2 - r + math.sqrt(math.max(0, r * r - dy * dy))
	end
	local ly = midY + bodyH * 0.18
	local hx = noseX(ly)
	add("Grille", Vector3.new(0.3, bodyH * 0.38, W * 0.42), CFrame.new(noseX(midY - bodyH * 0.1) - 0.05, midY - bodyH * 0.1, 0), DARK)
	for _, s in ipairs({ -1, 1 }) do
		add("Head", Vector3.new(0.35, bodyH * 0.22, W * 0.2), CFrame.new(hx - 0.05, ly, s * W * 0.32), HEAD, M.Neon)
		add("Tail", Vector3.new(0.35, bodyH * 0.2, W * 0.24), CFrame.new(-hx + 0.05, ly, s * W * 0.3), TAIL, M.Neon)
	end

	if k.taxiSign then
		add("TaxiSign", Vector3.new(1.6, 0.7, 2.6), CFrame.new(k.cabinX, roofTop + 0.35, 0), Color3.fromRGB(255, 255, 220), M.Neon)
	end
	if not low then
		for _, s in ipairs({ -1, 1 }) do
			add("Stripe", Vector3.new(L * 0.62, 0.22, 0.08), CFrame.new(0, clear + bodyH * 0.62, s * (W / 2 + 0.03)), accent)
			add("Handle", Vector3.new(0.6, 0.15, 0.08), CFrame.new(k.cabinX or 0, topY - 0.35, s * (W / 2 + 0.04)), DARK)
		end
		if sporty then
			add("Splitter", Vector3.new(1.0, 0.18, W * 0.96), CFrame.new(L / 2 - 0.4, clear + 0.09, 0), accent)
			for _, s in ipairs({ -1, 1 }) do
				add("Exhaust", Vector3.new(0.6, 0.45, 0.45), CFrame.new(-L / 2 + 0.05, clear + 0.35, s * 1.0), SILVER, M.Metal, 0, CYL)
			end
		end
	end
	if opts.Spoiler then
		for _, s in ipairs({ -1, 1 }) do
			add("WingPost", Vector3.new(0.35, 1.0, 0.35), CFrame.new(-L * 0.42, topY + 0.5, s * W * 0.28), accent)
		end
		add("Wing", Vector3.new(1.6, 0.22, W * 0.98), CFrame.new(-L * 0.42, topY + 1.1, 0), accent)
	end
	if k.fins then
		for _, s in ipairs({ -1, 1 }) do
			wedge("Fin", Vector3.new(0.25, 1.1, 2.6), CFrame.new(-L * 0.36, topY + 0.55, s * W * 0.32) * CFrame.Angles(0, math.pi / 2, 0), accent)
		end
	end
	if neon then
		add("Underglow", Vector3.new(L * 0.8, 0.18, W * 0.9), CFrame.new(0, clear * 0.5, 0), neon, M.Neon, 0.1)
		if not low then
			for _, s in ipairs({ -1, 1 }) do
				add("Glow", Vector3.new(L * 0.66, 0.14, 0.1), CFrame.new(0, clear + bodyH * 0.25, s * (W / 2 + 0.05)), neon, M.Neon)
			end
		end
	end

	model:SetAttribute("Kind", kindName)
	model:SetAttribute("Height", roofTop)
	return model
end

function VehicleFactory.BuildCar(def, opts)
	opts = opts or {}
	local k = Kinds[def.style] or Kinds.sedan
	local folder = modelsFolder()
	local tpl = folder and folder:FindFirstChild(def.id)
	if tpl and tpl:IsA("Model") and hasGeometry(tpl) then
		local m = fromTemplate("car:" .. def.id, tpl, k.L, { BodyColor = def.body })
		if m then
			if def.neon and not opts.Low then
				addNeonGlow(m, k, def.neon)
			end
			return m
		end
	end
	return VehicleFactory.Build(def.style, {
		BodyColor = def.body, AccentColor = def.accent, NeonColor = def.neon, Spoiler = def.spoiler,
		Chrome = def.chrome, Low = opts.Low,
	})
end

function VehicleFactory.BuildTraffic(kindName, color, variant)
	local k = Kinds[kindName] or Kinds.sedan
	if k.special then
		return require(script.Parent.SpecialVehicles).Build(kindName, k.special == "train" and color or nil)
	end
	local folder = modelsFolder()
	local traffic = folder and folder:FindFirstChild("Traffic")
	if traffic then
		local options = {}
		for _, m in ipairs(traffic:GetChildren()) do
			if m:IsA("Model") and (m.Name == kindName or string.sub(m.Name, 1, #kindName + 1) == kindName .. "_") and hasGeometry(m) then
				table.insert(options, m)
			end
		end
		if #options &gt; 0 then
			table.sort(options, function(a, b) return a.Name &lt; b.Name end)
			local tpl = options[((variant or 1) - 1) % #options + 1]
			local m = fromTemplate("traffic:" .. tpl.Name, tpl, k.L, { BodyColor = color })
			if m then
				for _, d in ipairs(m:GetDescendants()) do
					if d:IsA("BasePart") then
						d.CastShadow = false
						lowRender(d)
					end
				end
				return m
			end
		end
	end
	return VehicleFactory.Build(kindName, { BodyColor = color, Low = true })
end

-- the server sets ReplicatedStorage "CarsReady" once CarStoreTool.InstallMissingEmbedded is done (v25): before that
-- a car can still be missing from CarModels and would be drawn with the procedural body
function VehicleFactory.CarsReady()
	return ReplicatedStorage:GetAttribute("CarsReady") == true
end

-- yields until CarsReady or `timeout` seconds (default 20); returns whether the cars are ready
function VehicleFactory.WaitForCars(timeout)
	local t0 = os.clock()
	local limit = timeout or 20
	while not VehicleFactory.CarsReady() do
		if os.clock() - t0 &gt;= limit then
			return false
		end
		task.wait(0.25)
	end
	return true
end

function VehicleFactory.HeightOf(kindName)
	local k = Kinds[kindName] or Kinds.sedan
	return k.H
end

function VehicleFactory.HeightOfModel(model, kindName)
	local h = model and model:GetAttribute("Height")
	if type(h) == "number" then
		return h
	end
	return VehicleFactory.HeightOf(kindName)
end

return VehicleFactory
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX24"><Properties><string name="Name">VehicleKinds</string><ProtectedString name="Source">local C = Color3.fromRGB

local Kinds = {
	compact = { L = 11.5, W = 5.8, H = 4.6, wr = 1.2, clear = 0.7, bodyH = 1.9, cabinL = 6.0, cabinH = 1.9, cabinX = -0.8, cabinW = 0.9, color = C(220, 90, 70) },
	sedan = { L = 14.5, W = 6.2, H = 4.7, wr = 1.3, clear = 0.8, bodyH = 2.0, cabinL = 7.4, cabinH = 1.9, cabinX = -1.0, cabinW = 0.9, color = C(80, 120, 200) },
	taxi = { L = 14.5, W = 6.2, H = 5.4, wr = 1.3, clear = 0.8, bodyH = 2.0, cabinL = 7.4, cabinH = 1.9, cabinX = -1.0, cabinW = 0.9, color = C(250, 205, 40), taxiSign = true },
	van = { L = 14.5, W = 6.6, H = 6.6, wr = 1.4, clear = 0.9, bodyH = 2.2, cabinL = 4.0, cabinH = 1.9, cabinX = 4.2, cabinW = 0.92,
		box = { L = 9.6, H = 3.6, x = -2.2 }, color = C(235, 235, 240) },
	minibus = { L = 18, W = 6.8, H = 7.0, wr = 1.4, clear = 0.9, bodyH = 2.6, cabinL = 14.0, cabinH = 2.6, cabinX = -0.4, cabinW = 0.94, color = C(240, 180, 40) },
	sport = { L = 14.8, W = 6.6, H = 3.9, wr = 1.2, clear = 0.55, bodyH = 1.7, cabinL = 5.0, cabinH = 1.5, cabinX = -1.8, cabinW = 0.84, color = C(210, 40, 45) },
	supercar = { L = 15.2, W = 7.0, H = 3.5, wr = 1.2, clear = 0.45, bodyH = 1.5, cabinL = 4.4, cabinH = 1.4, cabinX = -1.2, cabinW = 0.8, color = C(255, 120, 30) },
	pickup = { L = 16.5, W = 6.6, H = 5.6, wr = 1.5, clear = 1.0, bodyH = 2.3, cabinL = 5.2, cabinH = 2.0, cabinX = 2.6, cabinW = 0.9,
		bed = { L = 6.8, x = -4.6 }, color = C(196, 164, 110) },
	service = { L = 15.5, W = 6.6, H = 6.2, wr = 1.4, clear = 0.9, bodyH = 2.4, cabinL = 4.4, cabinH = 1.9, cabinX = 4.4, cabinW = 0.92,
		box = { L = 9.0, H = 3.5, x = -2.4 }, color = C(235, 170, 40) },
	truck = { L = 26, W = 7.6, H = 8.8, wr = 2.0, clear = 1.4, bodyH = 2.6, cabinL = 5.4, cabinH = 3.0, cabinX = 9.2, cabinW = 0.92,
		box = { L = 17.0, H = 5.2, x = -3.6 }, sixWheels = true, color = C(170, 80, 70) },
	suv = { L = 15.5, W = 6.8, H = 6.2, wr = 1.5, clear = 1.0, bodyH = 2.7, cabinL = 9.6, cabinH = 2.3, cabinX = -1.9, cabinW = 0.92, color = C(232, 232, 228) },
	muscle = { L = 16.0, W = 6.8, H = 4.5, wr = 1.35, clear = 0.7, bodyH = 2.0, cabinL = 6.0, cabinH = 1.6, cabinX = -1.6, cabinW = 0.86, color = C(210, 40, 36) },
	proto = { L = 15.8, W = 7.0, H = 3.7, wr = 1.2, clear = 0.5, bodyH = 1.5, cabinL = 5.2, cabinH = 1.6, cabinX = -0.6, cabinW = 0.78,
		fins = true, canopyNeon = true, color = C(30, 30, 44) },
	racer = { L = 16.4, W = 7.2, H = 3.4, wr = 1.25, clear = 0.4, bodyH = 1.4, cabinL = 4.2, cabinH = 1.3, cabinX = -0.8, cabinW = 0.74,
		fins = true, color = C(214, 52, 44) },
	-- special shapes, built by SpecialVehicles (W/H are the hitbox)
	train = { L = 150, W = 8, H = 12, special = "train", color = C(214, 52, 44) },
	plane = { L = 42, W = 36, H = 9, special = "plane", color = C(240, 242, 246) },
}

return Kinds
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX592305F4AFE04A079A161B1A133FE8B9"><Properties><string name="Name">DonateConfig</string><ProtectedString name="Source">-- Golden Magnate stall. Prices in Robux. Grants are performed on the server (DonateService).
local DonateConfig = {}

DonateConfig.Products = {
	{ id = "boost_income", tab = "boost", icon = "💸", name = "x2 Income", desc = "Double garage income for 30 min", price = 49, boost = "income", seconds = 1800 },
	{ id = "boost_luck", tab = "boost", icon = "🍀", name = "Lucky Hour", desc = "Better car rarity from the trap for 15 min", price = 39, boost = "luck", seconds = 900, random = true },
	{ id = "pity", tab = "boost", icon = "🎯", name = "Sure Shot", desc = "Next throw: Epic or better (odds in THROW menu)", price = 59, random = true },
	{ id = "hotdrop", tab = "boost", icon = "📦", name = "Call a Hot Drop", desc = "A rare crate lands in your best district right now", price = 25 },
	{ id = "revive", tab = "boost", icon = "❤️", name = "Insurance", desc = "Get back the loot you lost in your last crash", price = 19 },
	{ id = "cash_s", tab = "pack", icon = "💵", name = "Cash Stack", desc = "10 min of income (min $50K)", price = 25, cash = { 600, 50000 } },
	{ id = "cash_m", tab = "pack", icon = "💰", name = "Cash Bag", desc = "30 min of income (min $250K)", price = 75, cash = { 1800, 250000 } },
	{ id = "cash_l", tab = "pack", icon = "🏦", name = "Cash Vault", desc = "1 hour of income (min $1M)", price = 199, cash = { 3600, 1000000 } },
	{ id = "cash_xl", tab = "pack", icon = "👑", name = "Magnate Fortune", desc = "3 hours of income (min $5M)", price = 499, cash = { 10800, 5000000 } },
	{ id = "crate_engine", tab = "pack", icon = "⚙️", name = "Engine Crate", desc = "3 engines", price = 29, parts = { engine = 3 } },
	{ id = "crate_turbo", tab = "pack", icon = "🌀", name = "Turbo Crate", desc = "3 turbos", price = 69, parts = { turbo = 3 } },
	{ id = "crate_core", tab = "pack", icon = "⚡", name = "Core Crate", desc = "1 energy core + 2 turbos", price = 149, parts = { core = 1, turbo = 2 } },
	{ id = "offline_x2", tab = "pack", icon = "2x", name = "Double Offline Cash", desc = "Doubles the cash you earned while away", price = 29 },
	{ id = "slots", tab = "pack", icon = "🅿️", name = "+3 Parking", desc = "Three more garage slots", price = 99, slots = 3 },
}

DonateConfig.Passes = {
	{ id = "vip", tab = "pass", icon = "⭐", name = "VIP", desc = "x1.5 income forever + gold name tag", price = 299 },
	{ id = "big_backpack", tab = "pass", icon = "🎒", name = "Huge Backpack", desc = "Double loot capacity", price = 149 },
	{ id = "auto_collect", tab = "pass", icon = "🧲", name = "Mega Magnet", desc = "Double pickup radius", price = 199 },
	{ id = "golden_car", tab = "pass", icon = "🏎️", name = "Golden Magnat GT", desc = "Gold supercar (+488K/s) + x2 income forever, kept on rebirth", price = 499 },
	{ id = "double_contracts", tab = "pass", icon = "📜", name = "Contract Boss", desc = "x2 contract rewards", price = 149 },
	{ id = "fast_trap", tab = "pass", icon = "⚡", name = "Fast Trap", desc = "Throw parts twice as often", price = 99 },
	{ id = "golden_garage", tab = "pass", icon = "👑", name = "Golden Garage", desc = "Gold garage skin, +20% income", price = 249 },
}

DonateConfig.ById = {}
for _, list in ipairs({ DonateConfig.Products, DonateConfig.Passes }) do
	for i, it in ipairs(list) do
		it.order = i
		it.isPass = list == DonateConfig.Passes
		DonateConfig.ById[it.id] = it
	end
end

-- random = true: the item changes a random outcome. Roblox requires hiding paid random items where
-- PolicyService says ArePaidRandomItemsRestricted (client hides, server refuses).
function DonateConfig.Available(it, productIds, isStudio, randomRestricted)
	if it.random and randomRestricted then
		return false
	end
	local id = it.isPass and productIds.passes[it.id] or productIds.products[it.id]
	return isStudio or (id ~= nil and id &gt; 0)
end

return DonateConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0CE3D618302245C984FEF1567D155387"><Properties><string name="Name">ExhaustFx</string><ProtectedString name="Source">-- Rarity-based exhaust for cars parked in a garage. Rarer = denser, brighter, flashier.
-- Everything is created switched off and tagged: the client (Client/Perf.lua) only runs the ones near the camera.
local CollectionService = game:GetService("CollectionService")
local Kinds = require(script.Parent:WaitForChild("VehicleKinds"))

local C = Color3.fromRGB
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"
local SPARK = "rbxasset://textures/particles/sparkles_main.dds"

local ExhaustFx = {}

-- each layer: texture, colors, rate, life, size {from,to}, speed, light emission, transparency from
local PRESETS = {
	Common = {
		{ SMOKE, { C(150, 150, 150), C(110, 110, 110) }, 3, 1.4, { 0.5, 2.2 }, 2, 0, 0.55 },
	},
	Uncommon = {
		{ SMOKE, { C(200, 255, 210), C(120, 170, 130) }, 6, 1.5, { 0.6, 2.6 }, 3, 0.1, 0.45 },
	},
	Rare = {
		{ SMOKE, { C(150, 210, 255), C(60, 120, 200) }, 9, 1.4, { 0.6, 2.8 }, 4, 0.35, 0.35 },
		{ SPARK, { C(120, 200, 255), C(46, 168, 255) }, 4, 0.5, { 0.4, 0 }, 7, 1, 0 },
	},
	Epic = {
		{ FIRE, { C(255, 230, 120), C(255, 70, 60) }, 22, 0.28, { 0.9, 0.2 }, 9, 1, 0.1 },
		{ SMOKE, { C(90, 60, 60), C(40, 40, 44) }, 10, 1.6, { 0.8, 3.4 }, 4, 0, 0.4 },
		{ SPARK, { C(255, 160, 80), C(255, 77, 109) }, 8, 0.5, { 0.45, 0 }, 10, 1, 0 },
	},
	Legendary = {
		{ FIRE, { C(255, 255, 220), C(255, 176, 32) }, 34, 0.32, { 1.2, 0.2 }, 12, 1, 0 },
		{ SMOKE, { C(255, 230, 150), C(255, 190, 60) }, 14, 1.8, { 1, 4 }, 5, 0.6, 0.3 },
		{ SPARK, { C(255, 255, 255), C(255, 210, 63) }, 16, 0.9, { 0.6, 0 }, 12, 1, 0 },
	},
}

local function emitter(att, layer)
	local e = Instance.new("ParticleEmitter")
	e.Texture = layer[1]
	e.Color = ColorSequence.new(layer[2][1], layer[2][2])
	e.Rate = layer[3]
	e.Lifetime = NumberRange.new(layer[4] * 0.8, layer[4] * 1.2)
	e.Size = NumberSequence.new(layer[5][1], layer[5][2])
	e.Speed = NumberRange.new(layer[6] * 0.7, layer[6])
	e.LightEmission = layer[7]
	e.Transparency = NumberSequence.new(layer[8], 1)
	e.SpreadAngle = Vector2.new(12, 12)
	e.Acceleration = Vector3.new(0, 2.5, 0)
	e.Drag = 1.5
	e.EmissionDirection = Enum.NormalId.Left -- -X = out of the tailpipe (cars face +X)
	e.RotSpeed = NumberRange.new(-60, 60)
	e.Rotation = NumberRange.new(0, 360)
	e.Enabled = false
	CollectionService:AddTag(e, "ExhaustEmitter")
	e.Parent = att
	return e
end

function ExhaustFx.Attach(model, def, rarityIndex)
	local root = model.PrimaryPart
	local preset = PRESETS[def.rarity]
	if not root or not preset then
		return
	end
	local k = Kinds[def.style] or Kinds.sedan
	local pipes = (rarityIndex or 1) &gt;= 3 and { -1, 1 } or { 1 }
	for _, s in ipairs(pipes) do
		local att = Instance.new("Attachment")
		att.Name = "Exhaust"
		att.CFrame = CFrame.new(-k.L / 2 - 0.2, k.clear + 0.3, s * k.W * 0.25)
		att.Parent = root
		for _, layer in ipairs(preset) do
			emitter(att, layer)
		end
		if def.rarity == "Legendary" or def.rarity == "Epic" then
			CollectionService:AddTag(att, "Backfire")
			att:SetAttribute("Color", def.rarity == "Legendary" and C(255, 210, 63) or C(255, 77, 109))
		end
	end
	if def.rarity == "Legendary" then
		local light = Instance.new("PointLight")
		light.Color = C(255, 190, 60)
		light.Range = 10
		light.Brightness = 2
		light.Enabled = false
		CollectionService:AddTag(light, "ExhaustLight")
		light.Parent = root
	end
end

return ExhaustFx
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXCA28CE3ECC224BAA8EA9975C73412BF7"><Properties><string name="Name">GarageKit</string><ProtectedString name="Source">-- Shared garage pieces: colour style, parking bay, upper floors. Used by BuildCityMap (ground floor)
-- and BaseService (floors 2-4 are built per owner). No two visible faces share a plane.
local BaseLayout = require(script.Parent:WaitForChild("BaseLayout"))
local MapConfig = require(script.Parent:WaitForChild("MapConfig"))

local C = Color3.fromRGB
local M = Enum.Material
local GarageKit = {}

GarageKit.Style = {
	floor = C(212, 214, 218), inlay = C(60, 63, 70), line = C(242, 242, 240), wall = C(38, 40, 46),
	deck = C(238, 238, 236), frame = C(28, 30, 34), accent = C(255, 196, 40), accent2 = C(214, 52, 44),
	door = C(200, 204, 210), bay = C(80, 84, 92),
}

-- part names -&gt; style key, so a garage skin can recolour a whole garage in one pass
GarageKit.Paint = {
	Floor = "floor", Inlay = "inlay", DriveLine = "line", BayLine = "line", BackWall = "wall", SideFin = "wall",
	Roof = "deck", OwnerSign = "frame", FloorSign = "frame", Column = "frame", ElevatorPad = "frame", ElevatorPost = "frame",
	LiftBridge = "frame", TrapEdge = "accent", LiftPost = "accent2", LiftBeam = "accent2", Rail = "frame", RailPost = "frame",
	PortalPost = "frame", PortalHeader = "frame", PortalDoor = "door", Terminal = "frame", WheelStop = "accent",
	-- Blender garage kit pieces (renamed on placement, see GarageKit.Dress) + window strips
	DecoFrame = "frame", DecoAccent = "accent", DecoWall = "door", WindowFrame = "frame", DoorRail = "frame", DoorHood = "frame",
	DoorStripe = "accent",
}

local function part(parent, name, size, cf, color, mat, o)
	o = o or {}
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or M.SmoothPlastic
	p.Anchored = true
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	if o.collide == false then
		p.CanCollide, p.CanQuery, p.CanTouch = false, false, false
	end
	if o.cast == false then
		p.CastShadow = false
	end
	if o.refl then
		p.Reflectance = o.refl
	end
	if o.t then
		p.Transparency = o.t
	end
	p.Parent = parent
	return p
end
GarageKit.Part = part

function GarageKit.Label(p, face, text, color)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Gui"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 24
	gui.LightInfluence = 0
	gui.Parent = p
	local l = Instance.new("TextLabel")
	l.Name = "Label"
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.LuckiestGuy
	l.TextScaled = true
	l.TextColor3 = color
	l.Text = text
	l.Parent = gui
	return l
end

-- Blender template (server only): ServerStorage.BuilderAssets.Props.&lt;name&gt;, anchored, pivoted to cf. Pieces named
-- Frame / Accent / Wall get a Deco* name so garage skins recolour them (car parts are never touched).
local DECO = { Frame = "DecoFrame", Accent = "DecoAccent", Wall = "DecoWall" }
function GarageKit.Template(name, parent, cf, style)
	local ok, tpl = pcall(function()
		return game:GetService("ServerStorage").BuilderAssets.Props:FindFirstChild(name)
	end)
	if not ok or not tpl then
		return nil
	end
	local m = tpl:Clone()
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanQuery = false
			d.Name = DECO[string.match(d.Name, "^(%a+)") or ""] or d.Name
		end
	end
	m:PivotTo(cf)
	if style then
		GarageKit.ApplyStyle(m, style) -- painted like the rest of the garage right away
	end
	m.Parent = parent
	return m
end

-- dresses one storey (y0 = deck top) so it reads as a real garage: a raised roller door over every bay opening,
-- tools along the back wall (pegboards, benches, cabinets, tyre racks, drums) and caged wall lamps.
-- Positions are garage-local (deck edge at DeckEdgeX facing +X, back wall face at -PX + 2).
-- floorTop: where props stand (the ground floor's inlay is 0.1 above its deck line)
function GarageKit.Dress(parent, bcf, y0, style, floorTop)
	style = style or GarageKit.Style
	floorTop = floorTop or y0
	local EDGE = BaseLayout.DeckEdgeX
	local back = -MapConfig.BasePlot.x / 2 + 2 -- front face of the back wall
	for col = 0, BaseLayout.SlotsPerFloor - 1 do
		local z = -37.5 + col * 15
		local cf = bcf * CFrame.new(EDGE - 0.9, y0 - 0.9, z) -- hood + hazard band just under the fascia, feet in the slab
		if not GarageKit.Template("G_RollerDoor", parent, cf, style) then
			-- simple raised door: two rails, a hood box and a hazard strip
			for _, s in ipairs({ -1, 1 }) do
				part(parent, "DoorRail", Vector3.new(0.6, 13.2, 0.5), cf * CFrame.new(0, 6.6, s * 7), style.frame, M.Metal)
			end
			part(parent, "DoorHood", Vector3.new(1.6, 1.6, 14.4), cf * CFrame.new(0, 12.4, 0), style.frame, M.Metal)
			part(parent, "DoorStripe", Vector3.new(0.2, 0.5, 14.2), cf * CFrame.new(0.85, 12.1, 0), style.accent, M.SmoothPlastic, { collide = false, cast = false })
		end
	end
	-- back wall (behind the wheel stops at x -41.6): z slots chosen between nothing else, every storey alike
	local function at(name, x, z, dy)
		GarageKit.Template(name, parent, bcf * CFrame.new(back + x, floorTop + (dy or 0), z), style)
	end
	at("G_TireRack", 1.4, -40)
	at("G_Workbench", 1.5, -27)
	at("G_Pegboard", 0, -27, 4.6) -- above the bench (bench + tools reach 4.25)
	at("G_ToolCabinet", 1.1, -19)
	at("G_OilDrum", 1.2, -12)
	at("G_Workbench", 1.5, 4)
	at("G_Pegboard", 0, 4, 4.6) -- above the bench (bench + tools reach 4.25)
	at("G_TireRack", 1.4, 19)
	at("G_ToolCabinet", 1.1, 29)
	at("G_OilDrum", 1.2, 34)
	for _, z in ipairs({ -33, -4, 25 }) do
		local lamp = GarageKit.Template("G_WallLamp", parent, bcf * CFrame.new(back, floorTop + 9, z), style)
		local bulb = lamp and lamp:FindFirstChildWhichIsA("BasePart", true)
		if bulb then
			local pl = Instance.new("PointLight")
			pl.Range, pl.Brightness, pl.Color = 14, 0.7, C(255, 226, 180)
			pl.Parent = bulb
		end
	end
end

-- brick side wall with a strip of high windows (the window frame is thicker than the wall: no shared faces)
function GarageKit.SideWall(mk, x, len, y0, H, z, style)
	mk("SideFin", Vector3.new(len, H - 1, 0.8), Vector3.new(x, y0 + (H - 1) / 2, z), style.wall, M.Brick)
	mk("WindowFrame", Vector3.new(len - 6, 2.6, 1.0), Vector3.new(x, y0 + 9.3, z), style.frame, M.Metal)
	mk("WindowGlass", Vector3.new(len - 6.6, 2.0, 1.2), Vector3.new(x, y0 + 9.3, z), C(120, 170, 205), M.Glass, { t = 0.35 })
end

-- one parking bay; topY = height of the surface it lies on. Returns the pad.
-- lift cabin for one storey (y0 = floor level): steel frame, tinted glass on three sides (open towards the deck, -X),
-- a canopy with a LIFT sign and a call-button panel. mk(name, size, localPos, color, material, opts)
-- yaw turns the Blender cab: 0 = doorway towards the deck (-X, upper floors), pi = towards the forecourt (ground)
function GarageKit.Lift(mk, y0, H, frame, accent, parent, bcf, yaw)
	local el = BaseLayout.ElevatorLocal
	-- the Blender cab (posts, glass with mullions, open sliding doors, header light, floor display, call buttons,
	-- counterweight rails) replaces the block version below; its doorway faces the deck (-X)
	if parent and bcf and GarageKit.Template("G_LiftCab", parent, bcf * CFrame.new(el.X, y0, el.Z) * CFrame.Angles(0, yaw or 0, 0), { frame = frame, accent = accent }) then
		return
	end
	local GLASS = C(150, 190, 215)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			mk("ElevatorPost", Vector3.new(0.6, H, 0.6), Vector3.new(el.X + sx * 4.3, y0 + H / 2, el.Z + sz * 4.3), frame, M.Metal)
		end
	end
	-- glass back (+X) and sides (+-Z), set 0.1 inside the posts so no faces touch
	mk("LiftGlass", Vector3.new(0.2, H - 1.2, 8), Vector3.new(el.X + 4.3, y0 + H / 2 - 0.3, el.Z), GLASS, M.Glass, { t = 0.55 })
	for _, sz in ipairs({ -1, 1 }) do
		mk("LiftGlass", Vector3.new(8, H - 1.2, 0.2), Vector3.new(el.X, y0 + H / 2 - 0.3, el.Z + sz * 4.3), GLASS, M.Glass, { t = 0.55 })
	end
	mk("LiftCanopy", Vector3.new(9.4, 0.5, 9.4), Vector3.new(el.X, y0 + H - 0.55, el.Z), frame, M.Metal)
	local sign = mk("LiftSign", Vector3.new(0.3, 1.4, 4), Vector3.new(el.X - 4.75, y0 + H - 1.42, el.Z), C(20, 24, 34), M.SmoothPlastic, { collide = false })
	GarageKit.Label(sign, Enum.NormalId.Left, "LIFT", accent)
	-- call panel on the front post: a small plate with two lit buttons
	mk("LiftPanel", Vector3.new(0.35, 1.6, 0.8), Vector3.new(el.X - 4.7, y0 + 4, el.Z - 4.3), C(40, 44, 52), M.Metal, { collide = false })
	for i, dy in ipairs({ 0.35, -0.35 }) do
		mk("LiftButton" .. i, Vector3.new(0.2, 0.35, 0.35), Vector3.new(el.X - 4.9, y0 + 4 + dy, el.Z - 4.3), accent, M.Neon, { collide = false, cast = false })
	end
end

function GarageKit.Bay(slotsFolder, model, bcf, slot, topY, style)
	style = style or GarageKit.Style
	local p = BaseLayout.SlotLocal(slot)
	local pad = part(slotsFolder, "Slot" .. slot, Vector3.new(22, 0.1, 12.4), bcf * CFrame.new(p.X, topY + 0.05, p.Z), style.bay, M.SmoothPlastic, { collide = false, cast = false })
	local num = GarageKit.Label(pad, Enum.NormalId.Top, tostring(slot), style.line)
	num.TextTransparency = 0.45
	num.Rotation = 90
	for _, s in ipairs({ -1, 1 }) do
		part(model, "BayLine", Vector3.new(22, 0.1, 0.3), bcf * CFrame.new(p.X, topY + 0.05, p.Z + s * 6.4), style.line, M.SmoothPlastic, { collide = false, cast = false })
	end
	part(model, "WheelStop", Vector3.new(0.6, 0.4, 5), bcf * CFrame.new(p.X - 10.6, topY + 0.2, p.Z), style.accent, M.SmoothPlastic)
	return pad
end

-- builds floor f (2..4): its deck surface is the roof of floor f-1. Returns model, pads by slot.
function GarageKit.BuildFloor(parent, bcf, f, style)
	style = style or GarageKit.Style
	local m = Instance.new("Model")
	m.Name = "Floor" .. f
	local H = BaseLayout.FloorHeight
	local PX, PZ = MapConfig.BasePlot.x / 2, MapConfig.BasePlot.z / 2
	local EDGE = BaseLayout.DeckEdgeX
	local deckW = EDGE + PX
	local deckCX = (EDGE - PX) / 2
	local y0 = (f - 1) * H + 0.5 -- deck top of this floor
	local function mk(name, size, off, color, mat, o)
		return part(m, name, size, bcf * CFrame.new(off), color, mat, o)
	end
	mk("BackWall", Vector3.new(2, H - 1, PZ * 2), Vector3.new(-PX + 1, y0 + (H - 1) / 2, 0), style.wall)
	for _, s in ipairs({ -1, 1 }) do
		GarageKit.SideWall(mk, deckCX + 1, deckW - 2, y0, H, s * (PZ - 0.6), style)
	end
	mk("Roof", Vector3.new(deckW, 1, PZ * 2), Vector3.new(deckCX, f * H, 0), style.deck)
	mk("FloorSign", Vector3.new(1.2, 2.4, PZ * 2 + 0.4), Vector3.new(EDGE + 0.4, f * H + 0.2, 0), style.frame)
	for _, z in ipairs({ -PZ + 1, -15, 15, PZ - 1 }) do
		mk("Column", Vector3.new(1.2, H - 1, 1.2), Vector3.new(EDGE - 0.8, y0 + (H - 1) / 2, z), style.frame, M.Metal)
	end
	-- safety rail along the open edge, with a gap at the lift
	local el = BaseLayout.ElevatorLocal
	local gapA, gapB = el.Z - 5, el.Z + 5
	for _, seg in ipairs({ { -PZ + 1, gapA }, { gapB, PZ - 1 } }) do
		local len = seg[2] - seg[1]
		if len &gt; 1 then
			mk("Rail", Vector3.new(0.3, 0.3, len), Vector3.new(EDGE - 1, y0 + 3.4, (seg[1] + seg[2]) / 2), style.frame, M.Metal)
			for z = seg[1], seg[2], 6 do
				mk("RailPost", Vector3.new(0.3, 3.4, 0.3), Vector3.new(EDGE - 1, y0 + 1.7, z), style.frame, M.Metal)
			end
		end
	end
	for _, z in ipairs({ -30, 0, 30 }) do
		local lamp = mk("CeilingLight", Vector3.new(12, 0.24, 1.6), Vector3.new(-31, f * H - 0.56, z), C(255, 244, 222), M.Neon, { collide = false, cast = false })
		local sl = Instance.new("SurfaceLight")
		sl.Face = Enum.NormalId.Bottom
		sl.Range = 18
		sl.Brightness = 1.1
		sl.Angle = 100
		sl.Color = C(255, 238, 210)
		sl.Parent = lamp
	end
	GarageKit.Lift(mk, y0, H, style.frame, style.accent, m, bcf)
	GarageKit.Dress(m, bcf, y0, style)
	mk("ElevatorPad", Vector3.new(8, 0.4, 8), Vector3.new(el.X, y0 + 0.2, el.Z), style.frame, M.Metal)
	mk("LiftBridge", Vector3.new(2.2, 0.3, 8), Vector3.new(EDGE + 1.9, y0 + 0.15, el.Z), style.frame, M.Metal)
	local slots = Instance.new("Folder")
	slots.Name = "Slots"
	slots.Parent = m
	local pads = {}
	for n = (f - 1) * BaseLayout.SlotsPerFloor + 1, f * BaseLayout.SlotsPerFloor do
		pads[n] = GarageKit.Bay(slots, m, bcf, n, y0, style)
	end
	m.Parent = parent
	return m, pads
end

-- recolour every known part in a garage (skins)
function GarageKit.ApplyStyle(root, style)
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") then
			local key = GarageKit.Paint[d.Name]
			if key and style[key] then
				d.Color = style[key]
			end
		end
	end
end

return GarageKit
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXD3A3ED4A26794E8F8C36BFA98F2EF263"><Properties><string name="Name">GearConfig</string><ProtectedString name="Source">-- Gears (v24; v25: cheaper, x2/x3 income, all money x10): timed boosts bought for money at Big Tony. A gear is applied to one car (car.gear = { id, exp }):
-- income gears boost that car, speed/luck gears boost the player while the geared car is parked (best one counts).
-- Tony's stock changes every Window seconds; every player has their own stock, seeded by userId + window + gear.
local GearConfig = {}

GearConfig.Window = 300
GearConfig.MaxOwned = 5 -- most of one gear a player can hold (Buy refuses, drops are capped)

GearConfig.List = {
	{
		id = "nitro", name = "Nitro Can", icon = "💨", desc = "Run faster while this car is parked.",
		effects = { speed = 1.5 }, seconds = 300, tier = 1, color = Color3.fromRGB(80, 170, 255),
		k = 20, minPrice = 3000, stock = { chance = 0.9, min = 1, max = 3 },
	},
	{
		id = "clover", name = "Lucky Clover", icon = "🍀", desc = "Better car odds while this car is parked.",
		effects = { luck = 1.5 }, seconds = 600, tier = 2, color = Color3.fromRGB(80, 220, 110),
		k = 60, minPrice = 5000, stock = { chance = 0.7, min = 1, max = 2 },
	},
	{
		id = "cashturbo", name = "Cash Turbo", icon = "💵", desc = "Doubles this car's money for 5 min.",
		effects = { income = 2 }, seconds = 300, tier = 2, color = Color3.fromRGB(120, 230, 90),
		k = 100, minPrice = 5000, stock = { chance = 0.75, min = 1, max = 3 },
	},
	{
		id = "rocket", name = "Rocket Boots", icon = "🚀", desc = "Run MUCH faster while this car is parked.",
		effects = { speed = 2 }, seconds = 300, tier = 3, color = Color3.fromRGB(60, 230, 255),
		k = 40, minPrice = 8000, stock = { chance = 0.55, min = 1, max = 2 },
	},
	{
		id = "moneystorm", name = "Money Storm", icon = "💰", desc = "Triples this car's money for 5 min.",
		effects = { income = 3 }, seconds = 300, tier = 4, color = Color3.fromRGB(255, 200, 50),
		k = 200, minPrice = 15000, stock = { chance = 0.4, min = 1, max = 1 },
	},
	{
		id = "goldengine", name = "Golden Engine", icon = "👑", desc = "Triples this car's money + better car odds for 10 min.",
		effects = { income = 3, luck = 1.5 }, seconds = 600, tier = 5, color = Color3.fromRGB(255, 215, 0),
		k = 400, minPrice = 30000, stock = { chance = 0.15, min = 1, max = 1 },
	},
}

GearConfig.ById = {}
for i, def in ipairs(GearConfig.List) do
	def.index = i
	GearConfig.ById[def.id] = def
end

-- the stock window a server time falls in
function GearConfig.WindowAt(t)
	return math.floor(t / GearConfig.Window)
end

-- this player's stock in one window: { [id] = qty } (0 when the gear is not offered). Same result on server and client.
function GearConfig.Stock(userId, window)
	local out = {}
	local uid = math.abs(math.floor(tonumber(userId) or 0)) % 2147483647
	window = math.floor(tonumber(window) or 0)
	for i, def in ipairs(GearConfig.List) do
		local rng = Random.new((uid * 31 + window) * 7 + i * 1000003)
		local st = def.stock
		if rng:NextNumber() &lt; st.chance then
			out[def.id] = rng:NextInteger(st.min, st.max)
		else
			out[def.id] = 0
		end
	end
	return out
end

-- price follows the best single parked car income of this run (gear-less, data.peakCarIncome): a gear boosts ONE car,
-- so k is "seconds of that car's income" (v25: cashturbo 100 vs +300c, moneystorm 200 vs +600c, goldengine 400 vs
-- +1200c and luck: ~3x payback).
-- Un-parking cars does not make gears cheaper. Same call on server (GearService.Buy) and client (UIExtra).
function GearConfig.Price(def, peakCarIncome)
	return math.floor(math.max(def.minPrice, (tonumber(peakCarIncome) or 0) * def.k) + 0.5)
end

local function fmt(m)
	if m % 1 == 0 then
		return string.format("x%d", m)
	end
	return "x" .. string.format("%.2f", m):gsub("0+$", "")
end

-- "x2 INCOME" / "x1.5 LUCK" / "x2 SPEED" / "x3 INCOME + x1.5 LUCK"
function GearConfig.Label(def)
	local parts = {}
	for _, kind in ipairs({ "income", "luck", "speed" }) do
		local m = def.effects[kind]
		if m then
			table.insert(parts, fmt(m) .. " " .. string.upper(kind))
		end
	end
	return table.concat(parts, " + ")
end

-- the def of a car's gear if it is still running at time `now`, else nil
function GearConfig.Active(gear, now)
	if type(gear) ~= "table" or type(gear.exp) ~= "number" then
		return nil
	end
	local def = GearConfig.ById[gear.id]
	if def and gear.exp &gt; (now or os.time()) then
		return def
	end
	return nil
end

-- income multiplier of one owned car (1 without an active income gear)
function GearConfig.CarMult(car, now)
	local def = car and GearConfig.Active(car.gear, now)
	return def and def.effects.income or 1
end

return GearConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX78D30764E0F7456AA6D6046BFF6E38B4"><Properties><string name="Name">IconIds</string><ProtectedString name="Source">-- HUD icons rendered in Blender (blender/make_icons.py), uploaded as Decals (tools/roblox_open_cloud.py icons).
