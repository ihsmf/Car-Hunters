</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3AE9C96505884C168C355026E0417B66"><Properties><string name="Name">Icons</string><ProtectedString name="Source">-- HUD icons rendered from the Blender models (assets/icons), uploaded as Decals; shown through rbxthumb.
local ok, ids = pcall(require, script.Parent:WaitForChild("IconIds"))
ids = ok and ids or {}

local Icons = {}

function Icons.Get(name)
	local id = ids[name]
	if id and id &gt; 0 then
		return string.format("rbxthumb://type=Asset&amp;id=%d&amp;w=420&amp;h=420", id)
	end
	return nil
end

return Icons
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXCEC4D90A071B4CB680CD3A157B4A6D2A"><Properties><string name="Name">ModelIds</string><ProtectedString name="Source">-- Blender models uploaded as Roblox Model assets (tools/roblox_open_cloud.py models). ModelService loads them.
