-- The map lives in Workspace.World (generated by tools/place.py). This module finds the objects the server needs.
local Players = game:GetService("Players")
local C = require(game.ReplicatedStorage.Shared.Config)
local MeshBuilder = require(game.ReplicatedStorage.Shared.MeshBuilder)

local Map = { Bases = {} }

-- round owner photo + name floating above the base
local function ownerBoard(anchor)
	local bb = Instance.new("BillboardGui") -- sized in studs: shrinks with distance like a real sign
	bb.Name, bb.Size, bb.AlwaysOnTop, bb.MaxDistance, bb.LightInfluence = "Owner", UDim2.fromScale(9, 11.6), false, 260, 0
	bb.StudsOffsetWorldSpace = Vector3.new(0, 11.6 * .2, 0)
	local photo = Instance.new("ImageLabel")
	photo.Name, photo.Size, photo.BackgroundColor3 = "Photo", UDim2.fromScale(1, 9 / 11.6), C.UI.Panel
	Instance.new("UICorner", photo).CornerRadius = UDim.new(1, 0)
	local st = Instance.new("UIStroke")
	st.Thickness, st.Color, st.Parent = 5, Color3.new(1, 1, 1), photo
	photo.Parent = bb
	local name = Instance.new("TextLabel")
	name.Name, name.Size, name.Position, name.BackgroundTransparency = "Label", UDim2.fromScale(1.4, 2.2 / 11.6), UDim2.fromScale(-0.2, 9.3 / 11.6), 1
	name.FontFace, name.TextScaled, name.TextColor3 = C.UI.Font, true, Color3.new(1, 1, 1)
	local ns = Instance.new("UIStroke")
	ns.Thickness, ns.Color, ns.Parent = 3, C.UI.Ink, name
	name.Parent, bb.Parent = bb, anchor
	return bb
end

function Map.Build()
	local world = workspace:WaitForChild("World")
	for i = 1, 4 do
		local base = world["Base" .. i]
		local slots = {}
		for s = 1, C.MaxEquipped do
			slots[s] = base.Slots["Slot" .. s].CFrame -- spots on the felt of the base table
		end
		local table0 = base.PoolTable
		local gym = base.Gym
		local board = ownerBoard(base.AvatarAnchor)
		Map.Bases[i] = {
			slots = slots,
			slots0 = slots, -- level 0 layout (2 x 4); Map.SetTable adds rows
			table0 = table0,
			spawn = base.SpawnPoint.CFrame,
			spawn0 = base.SpawnPoint.CFrame,
			gym = gym.TrainSpot,
			pad = base.GymPad,
			dumbbell = gym.Dumbbell,
			shopZone = base.ShopPad.Zone,
			chars = base.Chars,
			board = board,
		}
		Map.SetOwner(i, nil)
	end
	local clouds = Instance.new("Clouds")
	clouds.Cover, clouds.Density, clouds.Parent = 0.5, 0.5, workspace.Terrain
	return Map
end

-- Table capacity level: 0 = the original 8-spot table; level k = 4 + k rows of 2 spots on a longer table
-- (blender/plaza.py PlazaTable<rows>), grown one row towards the back wall, the rest towards the walkway.
function Map.SetTable(i, lvl)
	local base = Map.Bases[i]
	if base.tableLvl == (lvl or 0) then return end
	base.tableLvl = lvl or 0
	if base.longTable then base.longTable:Destroy(); base.longTable = nil end
	local row = C.TableRow
	local s1, s2 = base.slots0[1], base.slots0[2]
	local back = s1.Position.Z - row / 2 - row * math.min(lvl, 1)
	local rows = 4 + lvl
	local slots = {}
	for r = 1, rows do
		local z = back + row * (r - 0.5)
		slots[2 * r - 1] = CFrame.new(s1.Position.X, s1.Position.Y, z) * s1.Rotation
		slots[2 * r] = CFrame.new(s2.Position.X, s2.Position.Y, z) * s2.Rotation
	end
	base.slots = lvl == 0 and base.slots0 or slots
	for _, p in base.table0:GetDescendants() do
		if p:IsA("BasePart") then
			if p:GetAttribute("T0") == nil then p:SetAttribute("T0", p.Transparency); p:SetAttribute("C0", p.CanCollide) end
			p.Transparency = lvl == 0 and p:GetAttribute("T0") or 1
			p.CanCollide = lvl == 0 and p:GetAttribute("C0") or false
		end
	end
	local front = back + row * rows
	base.spawn = CFrame.new(base.spawn0.X, base.spawn0.Y, math.max(base.spawn0.Z, front + 3)) * base.spawn0.Rotation
	if lvl == 0 then return end
	local pivot = base.table0:FindFirstChild("MeshPivot")
	local centre = Vector3.new(pivot and pivot.Position.X or s1.Position.X, pivot and pivot.Position.Y or 0.5, (back + front) / 2)
	local model = Instance.new("Model")
	model.Name = "LongTable"
	local mesh = MeshBuilder.Create("PlazaTable" .. rows, CFrame.new(centre), nil, 1)
	if mesh then mesh.Parent = model end
	local box = Instance.new("Part") -- one solid block for the player to bump into
	box.Name, box.Anchored, box.Transparency, box.CanQuery, box.CanTouch = "Collider", true, 1, false, false
	box.Size = Vector3.new(9.6, 3.8, row * rows + 1.8)
	box.CFrame = CFrame.new(centre + Vector3.new(0, 1.9, 0))
	box.Parent = model
	model.Parent = base.table0.Parent
	base.longTable = model
end

function Map.SetOwner(i, plr)
	local base = Map.Bases[i]
	base.owner = plr
	local display = workspace.World["Base"..i].Showroom
 for _,piece in display:GetDescendants() do
  if piece:IsA("BasePart") then piece.Transparency=plr and 1 or 0 end
 end
 local board = base.board
	board.Label.Text = plr and plr.DisplayName or "Free base"
	board.Photo.Image = ""
	board.Photo.Visible = plr ~= nil
	if plr then
		task.spawn(function()
			local ok, img = pcall(Players.GetUserThumbnailAsync, Players, plr.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
			if ok and plr.Parent and Map.Bases[i].owner == plr then board.Photo.Image = img end
		end)
	end
end

return Map
