	panels.pity = label(body, { Size = UDim2.new(1, 0, 0, 22), Text = "", Font = BODY, TextSize = 12, TextColor3 = LAV, TextXAlignment = Enum.TextXAlignment.Right })
	local row = new("Frame", { Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 78), BackgroundTransparency = 1 }, body)
	list(row, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center)
	panels.partTiles = {}
	for i, id in ipairs(PartConfig.Order) do
		local col = PartConfig.Parts[id].color
		local tile = new("TextButton", { Size = UDim2.fromOffset(74, 78), BackgroundColor3 = lighter(col, 0.78), Text = "", AutoButtonColor = false, LayoutOrder = i, BorderSizePixel = 0 }, row)
		corner(tile, 18)
		local st = stroke(tile, lighter(col, 0.4), 2)
		local icon = new("Frame", { Size = UDim2.fromOffset(26, 26), Position = UDim2.new(0.5, -13, 0, 8), BackgroundColor3 = col, BorderSizePixel = 0 }, tile)
		round(icon)
		gradient(icon, lighter(col, 0.45), col)
		local name = label(tile, { Position = UDim2.fromOffset(0, 38), Size = UDim2.new(1, 0, 0, 16), TextXAlignment = Enum.TextXAlignment.Center, Text = T("part_" .. id), Font = HEAD, TextSize = 14 })
		local cnt = label(tile, { Position = UDim2.fromOffset(0, 55), Size = UDim2.new(1, 0, 0, 16), TextXAlignment = Enum.TextXAlignment.Center, Font = BODY, TextSize = 13, TextColor3 = MUTED })
		pressable(tile)
