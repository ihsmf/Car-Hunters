<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Meta name="ExplicitAutoJoints">true</Meta><Item class="Workspace" referent="RBX12"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">false</bool></Properties></Item><Item class="Lighting" referent="RBX55"><Properties><string name="Name">Lighting</string></Properties></Item><Item class="ReplicatedStorage" referent="RBX27"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX1034"><Properties><string name="Name">CarModels</string></Properties><Item class="Model" referent="RBX1002"><Properties><string name="Name">rusty_compact</string></Properties></Item><Item class="Model" referent="RBX1003"><Properties><string name="Name">pocket_hatch</string></Properties></Item><Item class="Model" referent="RBX1004"><Properties><string name="Name">dusty_sedan</string></Properties></Item><Item class="Model" referent="RBX1005"><Properties><string name="Name">mule_pickup</string></Properties></Item><Item class="Model" referent="RBX1006"><Properties><string name="Name">street_runner</string></Properties></Item><Item class="Model" referent="RBX1007"><Properties><string name="Name">city_taxi</string></Properties></Item><Item class="Model" referent="RBX1008"><Properties><string name="Name">cargo_hopper</string></Properties></Item><Item class="Model" referent="RBX1009"><Properties><string name="Name">boulevard_gt</string></Properties></Item><Item class="Model" referent="RBX1010"><Properties><string name="Name">night_phantom</string></Properties></Item><Item class="Model" referent="RBX1011"><Properties><string name="Name">iron_hauler</string></Properties></Item><Item class="Model" referent="RBX1012"><Properties><string name="Name">redline_coupe</string></Properties></Item><Item class="Model" referent="RBX1013"><Properties><string name="Name">volt_cruiser</string></Properties></Item><Item class="Model" referent="RBX1014"><Properties><string name="Name">turbo_vortex</string></Properties></Item><Item class="Model" referent="RBX1015"><Properties><string name="Name">chrome_viper</string></Properties></Item><Item class="Model" referent="RBX1016"><Properties><string name="Name">apex_predator</string></Properties></Item><Item class="Model" referent="RBX1017"><Properties><string name="Name">solar_flare</string></Properties></Item><Item class="Model" referent="RBX1018"><Properties><string name="Name">neon_specter</string></Properties></Item><Item class="Model" referent="RBX1019"><Properties><string name="Name">hyper_nova</string></Properties></Item><Item class="Model" referent="RBX1020"><Properties><string name="Name">quantum_drift</string></Properties></Item><Item class="Model" referent="RBX1021"><Properties><string name="Name">eclipse_titan</string></Properties></Item><Item class="Folder" referent="RBX1033"><Properties><string name="Name">Traffic</string></Properties><Item class="Model" referent="RBX1022"><Properties><string name="Name">compact</string></Properties></Item><Item class="Model" referent="RBX1023"><Properties><string name="Name">sedan</string></Properties></Item><Item class="Model" referent="RBX1024"><Properties><string name="Name">taxi</string></Properties></Item><Item class="Model" referent="RBX1025"><Properties><string name="Name">van</string></Properties></Item><Item class="Model" referent="RBX1026"><Properties><string name="Name">minibus</string></Properties></Item><Item class="Model" referent="RBX1027"><Properties><string name="Name">sport</string></Properties></Item><Item class="Model" referent="RBX1028"><Properties><string name="Name">supercar</string></Properties></Item><Item class="Model" referent="RBX1029"><Properties><string name="Name">pickup</string></Properties></Item><Item class="Model" referent="RBX1030"><Properties><string name="Name">service</string></Properties></Item><Item class="Model" referent="RBX1031"><Properties><string name="Name">truck</string></Properties></Item><Item class="Model" referent="RBX1032"><Properties><string name="Name">proto</string></Properties></Item></Item></Item><Item class="Folder" referent="RBX25"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">BaseLayout</string><ProtectedString name="Source"><![CDATA[local MapConfig = require(script.Parent.MapConfig)

local BaseLayout = {}

BaseLayout.FloorY = 0.5
BaseLayout.SlotCount = 12
BaseLayout.TrapLocal = Vector3.new(30, 0, -26)
BaseLayout.PortalLocal = Vector3.new(52, 0, 20)
BaseLayout.TerminalLocal = Vector3.new(30, 0, 40)
BaseLayout.SpawnLocal = Vector3.new(44, 0, 0)
BaseLayout.BackWallX = -52
BaseLayout.LaneX = 14

function BaseLayout.SlotLocal(slot)
	local row = math.floor((slot - 1) / 6)
	local col = (slot - 1) % 6
	local x = (row == 0) and -35 or -8
	local z = -37.5 + col * 15
	return Vector3.new(x, 0, z)
end

function BaseLayout.GetBaseCFrame(index)
	local c = MapConfig.BaseCenters[index]
	local yaw = (c.x < 0) and 0 or math.pi
	return CFrame.new(c.x, 0, c.z) * CFrame.Angles(0, yaw, 0)
end

function BaseLayout.ToWorld(index, localPos)
	return BaseLayout.GetBaseCFrame(index):PointToWorldSpace(localPos)
end

function BaseLayout.SlotCFrame(index, slot)
	local p = BaseLayout.SlotLocal(slot)
	return BaseLayout.GetBaseCFrame(index) * CFrame.new(p.X, BaseLayout.FloorY, p.Z)
end

return BaseLayout
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">CarConfig</string><ProtectedString name="Source"><![CDATA[local C = Color3.fromRGB
local PartConfig = require(script.Parent.PartConfig)
local EconomyConfig = require(script.Parent.EconomyConfig)

local CarConfig = {}

CarConfig.RarityOrder = { "Common", "Uncommon", "Rare", "Epic", "Legendary" }
CarConfig.Rarities = {
	Common = { index = 1, color = C(176, 184, 196), soft = C(232, 235, 240) },
	Uncommon = { index = 2, color = C(76, 201, 128), soft = C(214, 245, 226) },
	Rare = { index = 3, color = C(72, 152, 255), soft = C(214, 232, 255) },
	Epic = { index = 4, color = C(170, 104, 255), soft = C(236, 222, 255) },
	Legendary = { index = 5, color = C(255, 176, 32), soft = C(255, 238, 200) },
}

CarConfig.MaxLevel = 10
CarConfig.IncomeGrowth = 0.25
CarConfig.ValueMultiplier = 40
CarConfig.UpgradeCostBase = 0.5
CarConfig.UpgradeCostGrowth = 1.35

local list = {
	{ id = "rusty_compact", name = "Rusty Compact", rarity = "Common", style = "compact", income = 2, body = C(176, 108, 70), accent = C(80, 60, 48), tag = "Held together by hope." },
	{ id = "pocket_hatch", name = "Pocket Hatch", rarity = "Common", style = "compact", income = 3, body = C(120, 210, 180), accent = C(255, 255, 255), tag = "Tiny, cheerful, always parks." },
	{ id = "dusty_sedan", name = "Dusty Sedan", rarity = "Common", style = "sedan", income = 4, body = C(160, 162, 170), accent = C(70, 72, 80), tag = "Grandpa's daily driver." },
	{ id = "mule_pickup", name = "Mule Pickup", rarity = "Common", style = "pickup", income = 5, body = C(206, 170, 112), accent = C(90, 70, 50), tag = "Hauls anything, anywhere." },
	{ id = "street_runner", name = "Street Runner", rarity = "Uncommon", style = "sedan", income = 8, body = C(60, 128, 236), accent = C(250, 250, 250), tag = "Quick off the line." },
	{ id = "city_taxi", name = "City Taxi Mk2", rarity = "Uncommon", style = "taxi", income = 10, body = C(255, 206, 50), accent = C(30, 30, 30), tag = "The meter is always running." },
	{ id = "cargo_hopper", name = "Cargo Hopper", rarity = "Uncommon", style = "van", income = 12, body = C(80, 180, 110), accent = C(240, 240, 240), tag = "Delivers before you order." },
	{ id = "boulevard_gt", name = "Boulevard GT", rarity = "Uncommon", style = "sedan", income = 15, body = C(250, 146, 60), accent = C(40, 40, 46), spoiler = true, tag = "Sunday cruising, Monday racing." },
	{ id = "night_phantom", name = "Night Phantom", rarity = "Rare", style = "sport", income = 25, body = C(34, 32, 44), accent = C(150, 70, 230), neon = C(150, 70, 230), tag = "Seen only after midnight." },
	{ id = "iron_hauler", name = "Iron Hauler", rarity = "Rare", style = "truck", income = 32, body = C(118, 126, 140), accent = C(255, 160, 40), tag = "Eighteen tons of attitude." },
	{ id = "redline_coupe", name = "Redline Coupe", rarity = "Rare", style = "sport", income = 40, body = C(225, 46, 52), accent = C(255, 255, 255), spoiler = true, tag = "Lives at the rev limiter." },
	{ id = "volt_cruiser", name = "Volt Cruiser", rarity = "Rare", style = "sedan", income = 50, body = C(50, 178, 184), accent = C(30, 40, 50), neon = C(60, 240, 255), tag = "Silent, smooth, electric." },
	{ id = "turbo_vortex", name = "Turbo Vortex", rarity = "Epic", style = "sport", income = 100, body = C(255, 124, 36), accent = C(30, 30, 36), spoiler = true, neon = C(255, 150, 40), tag = "Spools up a storm." },
	{ id = "chrome_viper", name = "Chrome Viper", rarity = "Epic", style = "supercar", income = 125, body = C(206, 214, 226), accent = C(40, 44, 52), chrome = true, tag = "Mirror finish, venom bite." },
	{ id = "apex_predator", name = "Apex Predator", rarity = "Epic", style = "supercar", income = 150, body = C(36, 120, 70), accent = C(20, 20, 24), spoiler = true, neon = C(90, 255, 120), tag = "Top of the food chain." },
	{ id = "solar_flare", name = "Solar Flare", rarity = "Epic", style = "supercar", income = 200, body = C(255, 214, 50), accent = C(210, 60, 30), neon = C(255, 190, 40), tag = "Too bright to look at." },
	{ id = "neon_specter", name = "Neon Specter", rarity = "Legendary", style = "proto", income = 500, body = C(26, 30, 46), accent = C(40, 230, 255), neon = C(40, 230, 255), tag = "A ghost made of light." },
	{ id = "hyper_nova", name = "Hyper Nova", rarity = "Legendary", style = "proto", income = 650, body = C(52, 24, 62), accent = C(255, 50, 210), neon = C(255, 50, 210), tag = "Born in a dying star." },
	{ id = "quantum_drift", name = "Quantum Drift", rarity = "Legendary", style = "proto", income = 800, body = C(236, 240, 255), accent = C(80, 120, 255), neon = C(110, 150, 255), tag = "Everywhere at once." },
	{ id = "eclipse_titan", name = "Eclipse Titan", rarity = "Legendary", style = "proto", income = 1000, body = C(18, 18, 22), accent = C(255, 190, 40), neon = C(255, 190, 40), tag = "The final hunt." },
}

CarConfig.List = list
CarConfig.ById = {}
CarConfig.ByRarity = { Common = {}, Uncommon = {}, Rare = {}, Epic = {}, Legendary = {} }
for i, def in ipairs(list) do
	def.order = i
	def.value = def.income * CarConfig.ValueMultiplier
	def.maxLevel = CarConfig.MaxLevel
	CarConfig.ById[def.id] = def
	table.insert(CarConfig.ByRarity[def.rarity], def)
end

CarConfig.DropChances = {
	bolts = { Common = 55, Uncommon = 25, Rare = 13, Epic = 6, Legendary = 1 },
	tire = { Common = 40, Uncommon = 30, Rare = 18, Epic = 9, Legendary = 3 },
	engine = { Common = 22, Uncommon = 30, Rare = 26, Epic = 16, Legendary = 6 },
	turbo = { Common = 10, Uncommon = 22, Rare = 30, Epic = 26, Legendary = 12 },
	core = { Common = 4, Uncommon = 10, Rare = 26, Epic = 36, Legendary = 24 },
}

function CarConfig.IncomeAt(def, level)
	return math.floor(def.income * (1 + CarConfig.IncomeGrowth * (level - 1)) + 0.5)
end

function CarConfig.ValueAt(def, level)
	return math.floor(def.value * (1 + 0.3 * (level - 1)))
end

function CarConfig.SellPrice(def, level)
	return math.floor(CarConfig.ValueAt(def, level) * EconomyConfig.SellFraction)
end

function CarConfig.DiscoverBonus(def)
	return math.floor(def.value * EconomyConfig.DiscoverBonusMult)
end

function CarConfig.UpgradeCost(def, level)
	return math.ceil(def.value * CarConfig.UpgradeCostBase * (CarConfig.UpgradeCostGrowth ^ (level - 1)))
end

function CarConfig.UpgradeParts(def, level)
	return PartConfig.PartForRarity[def.rarity], 1 + math.floor((level - 1) / 3)
end

function CarConfig.IsHighTier(rarity)
	return rarity == "Epic" or rarity == "Legendary"
end

function CarConfig.PityRow(partId)
	local row = CarConfig.DropChances[partId]
	local e, l = row.Epic, row.Legendary
	local t = e + l
	return { Common = 0, Uncommon = 0, Rare = 0, Epic = e / t * 100, Legendary = l / t * 100 }
end

function CarConfig.Roll(partId, pity, r1, r2)
	local row = CarConfig.DropChances[partId]
	if pity and pity >= EconomyConfig.PityThreshold - 1 then
		row = CarConfig.PityRow(partId)
	end
	local total = 0
	for _, r in ipairs(CarConfig.RarityOrder) do
		total = total + row[r]
	end
	local target = r1 * total
	local acc = 0
	local rarity = "Legendary"
	for _, r in ipairs(CarConfig.RarityOrder) do
		acc = acc + row[r]
		if row[r] > 0 and target < acc then
			rarity = r
			break
		end
	end
	local pool = CarConfig.ByRarity[rarity]
	local def = pool[math.floor(r2 * #pool) + 1] or pool[#pool]
	return rarity, def
end

function CarConfig.IndexStats(discovered)
	local tiers, found = 0, 0
	for _, r in ipairs(CarConfig.RarityOrder) do
		local all = true
		for _, def in ipairs(CarConfig.ByRarity[r]) do
			if discovered[def.id] then
				found = found + 1
			else
				all = false
			end
		end
		if all then
			tiers = tiers + 1
		end
	end
	local mult = 1 + tiers * EconomyConfig.IndexTierBonus
	if found >= #list then
		mult = mult + EconomyConfig.IndexFullBonus
	end
	return found, #list, tiers, mult
end

function CarConfig.Validate()
	local errors = {}
	local count = 0
	for _, r in ipairs(CarConfig.RarityOrder) do
		if #CarConfig.ByRarity[r] ~= 4 then
			table.insert(errors, r .. ": expected 4 cars, got " .. #CarConfig.ByRarity[r])
		end
		count = count + #CarConfig.ByRarity[r]
	end
	if count ~= 20 then
		table.insert(errors, "expected 20 cars, got " .. count)
	end
	for partId, row in pairs(CarConfig.DropChances) do
		local sum = 0
		for _, r in ipairs(CarConfig.RarityOrder) do
			sum = sum + (row[r] or 0)
		end
		if math.abs(sum - 100) > 1e-9 then
			table.insert(errors, partId .. ": drop chances sum to " .. sum)
		end
	end
	return errors
end

return CarConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">EconomyConfig</string><ProtectedString name="Source"><![CDATA[local EconomyConfig = {}

EconomyConfig.StarterParts = { bolts = 2 }
EconomyConfig.CarryCapacity = 20
EconomyConfig.DeathLossFraction = 0.3
EconomyConfig.MaxCars = 200
EconomyConfig.MaxMoney = 1e15
EconomyConfig.StartSlots = 3
EconomyConfig.MaxSlots = 12
EconomyConfig.MaxPlayers = 8

EconomyConfig.SlotCosts = {
	[4] = 1500, [5] = 4000, [6] = 10000, [7] = 25000, [8] = 60000,
	[9] = 150000, [10] = 350000, [11] = 800000, [12] = 2000000,
}

EconomyConfig.ZoneUnlock = {
	highway = { cost = 16000, minValue = 7000 },
	industrial = { cost = 180000, minValue = 70000 },
	neon = { cost = 1000000, minValue = 400000 },
}

EconomyConfig.SellFraction = 0.35
EconomyConfig.DiscoverBonusMult = 1.0
EconomyConfig.IndexTierBonus = 0.05
EconomyConfig.IndexFullBonus = 0.10
EconomyConfig.PityThreshold = 40

EconomyConfig.ThrowCooldown = 0.8
EconomyConfig.ThrowAnimTime = 3.8
EconomyConfig.ThrowMaxDistance = 45
EconomyConfig.BaseActionDistance = 100
EconomyConfig.PickupRadius = 7
EconomyConfig.PickupCheckInterval = 0.15
EconomyConfig.SpawnProtection = 2.5
EconomyConfig.HitCooldown = 1.0
EconomyConfig.TrafficTickRate = 1 / 30
EconomyConfig.AutosaveInterval = 60
EconomyConfig.ActionCooldown = 0.12

return EconomyConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">MapConfig</string><ProtectedString name="Source"><![CDATA[local C = Color3.fromRGB

local MapConfig = {}

MapConfig.Seed = 12345
MapConfig.MapHalfWidth = 300
MapConfig.StartZ = -510
MapConfig.EndZ = 1430
MapConfig.PlazaEndZ = 80
MapConfig.DecorationDensity = 0.7
MapConfig.GraphicsQuality = "MobileFriendly"

MapConfig.RoadTopY = 0.2
MapConfig.SidewalkTopY = 0.8
MapConfig.SidewalkWidth = 6
MapConfig.TunnelLength = 60
MapConfig.EntryHalfWidth = 60
MapConfig.GateHalfWidth = 30
MapConfig.EntryZ = 90

MapConfig.BasePlot = { x = 110, z = 95 }
MapConfig.BaseCount = 8
MapConfig.BaseCenters = {
	{ x = -185, z = -395 }, { x = 185, z = -395 },
	{ x = -185, z = -275 }, { x = 185, z = -275 },
	{ x = -185, z = -155 }, { x = 185, z = -155 },
	{ x = -185, z = -35 },  { x = 185, z = -35 },
}

MapConfig.ZoneOrder = { "city", "highway", "industrial", "neon" }

MapConfig.Gates = {
	{ zone = "highway", z = 420 },
	{ zone = "industrial", z = 750 },
	{ zone = "neon", z = 1080 },
}

MapConfig.Zones = {
	city = {
		id = "city", name = "CITY DISTRICT", zMin = 100, zMax = 410, roads = { 1, 2 }, hitDamage = 35,
		palette = {
			ground = C(118, 178, 100), road = C(62, 64, 72), sidewalk = C(222, 212, 192), curb = C(180, 172, 156),
			accent = C(255, 160, 50), accent2 = C(60, 170, 230),
			buildings = { C(240, 205, 160), C(235, 140, 120), C(150, 200, 230), C(245, 230, 150), C(190, 160, 220), C(160, 215, 170) },
		},
	},
	highway = {
		id = "highway", name = "HIGHWAY DISTRICT", zMin = 430, zMax = 740, roads = { 3, 4 }, hitDamage = 60,
		palette = {
			ground = C(126, 146, 116), road = C(50, 52, 58), sidewalk = C(176, 178, 184), curb = C(140, 142, 150),
			accent = C(255, 210, 40), accent2 = C(230, 70, 60),
			buildings = { C(200, 205, 215), C(120, 150, 190), C(230, 230, 235), C(90, 100, 120), C(255, 190, 70) },
		},
	},
	industrial = {
		id = "industrial", name = "INDUSTRIAL DISTRICT", zMin = 760, zMax = 1070, roads = { 5, 6 }, hitDamage = 80,
		palette = {
			ground = C(150, 136, 116), road = C(52, 50, 50), sidewalk = C(168, 160, 148), curb = C(120, 114, 104),
			accent = C(255, 120, 30), accent2 = C(255, 220, 60),
			buildings = { C(150, 120, 100), C(110, 120, 130), C(170, 90, 70), C(130, 150, 120), C(190, 170, 130) },
		},
	},
	neon = {
		id = "neon", name = "NEON DISTRICT", zMin = 1090, zMax = 1400, roads = { 7, 8 }, hitDamage = 100,
		palette = {
			ground = C(30, 24, 52), road = C(18, 18, 28), sidewalk = C(50, 44, 80), curb = C(90, 70, 150),
			accent = C(255, 40, 200), accent2 = C(40, 230, 255),
			buildings = { C(36, 30, 70), C(24, 40, 80), C(60, 24, 80), C(20, 20, 40), C(44, 36, 100) },
		},
	},
}

MapConfig.Plaza = {
	ground = C(100, 160, 90), paving = C(206, 200, 190), floor = C(52, 54, 62),
	accent = C(60, 200, 255),
}

MapConfig.Roads = {
	{ id = 1, zone = "city", z = 200, width = 32, lanesPerSide = 1, laneWidth = 11, median = 10,
		speed = { 20, 32 }, spacing = { 150, 200 }, kinds = { "compact", "sedan", "taxi", "van" } },
	{ id = 2, zone = "city", z = 335, width = 32, lanesPerSide = 1, laneWidth = 11, median = 10,
		speed = { 22, 32 }, spacing = { 140, 190 }, kinds = { "compact", "sedan", "taxi", "van" } },
	{ id = 3, zone = "highway", z = 530, width = 40, lanesPerSide = 2, laneWidth = 8, median = 8,
		speed = { 35, 50 }, spacing = { 120, 160 }, kinds = { "sedan", "sport", "minibus" } },
	{ id = 4, zone = "highway", z = 665, width = 40, lanesPerSide = 2, laneWidth = 8, median = 8,
		speed = { 36, 50 }, spacing = { 115, 155 }, kinds = { "sedan", "sport", "minibus" } },
	{ id = 5, zone = "industrial", z = 860, width = 38, lanesPerSide = 2, laneWidth = 7, median = 10,
		speed = { 28, 45 }, spacing = { 130, 175 }, kinds = { "truck", "pickup", "service" } },
	{ id = 6, zone = "industrial", z = 995, width = 38, lanesPerSide = 2, laneWidth = 7, median = 10,
		speed = { 30, 45 }, spacing = { 125, 170 }, kinds = { "truck", "pickup", "service" } },
	{ id = 7, zone = "neon", z = 1190, width = 40, lanesPerSide = 2, laneWidth = 8, median = 8,
		speed = { 50, 70 }, spacing = { 110, 150 }, kinds = { "proto", "sport" } },
	{ id = 8, zone = "neon", z = 1325, width = 40, lanesPerSide = 2, laneWidth = 8, median = 8,
		speed = { 52, 70 }, spacing = { 105, 145 }, kinds = { "proto", "sport" } },
}

MapConfig.TrafficColors = {
	C(220, 60, 60), C(60, 120, 220), C(240, 200, 50), C(70, 70, 78),
	C(235, 235, 240), C(70, 170, 100), C(240, 130, 40), C(150, 90, 200),
}

function MapConfig.ZoneAt(z)
	if z < MapConfig.EntryZ then
		return "plaza"
	end
	for i = #MapConfig.Gates, 1, -1 do
		if z >= MapConfig.Gates[i].z then
			return MapConfig.Gates[i].zone
		end
	end
	return "city"
end

function MapConfig.GateOfZone(zoneId)
	for _, g in ipairs(MapConfig.Gates) do
		if g.zone == zoneId then
			return g
		end
	end
	return nil
end

function MapConfig.ZoneIndex(zoneId)
	for i, id in ipairs(MapConfig.ZoneOrder) do
		if id == zoneId then
			return i
		end
	end
	return 0
end

function MapConfig.Validate()
	local errors = {}
	for _, r in ipairs(MapConfig.Roads) do
		local w = 2 * r.lanesPerSide * r.laneWidth + r.median
		if w ~= r.width then
			table.insert(errors, "Road" .. r.id .. ": width " .. r.width .. " ~= computed " .. w)
		end
	end
	for i = 1, #MapConfig.BaseCenters do
		for j = i + 1, #MapConfig.BaseCenters do
			local a, b = MapConfig.BaseCenters[i], MapConfig.BaseCenters[j]
			local ox = math.abs(a.x - b.x) < MapConfig.BasePlot.x
			local oz = math.abs(a.z - b.z) < MapConfig.BasePlot.z
			if ox and oz then
				table.insert(errors, "Bases " .. i .. " and " .. j .. " overlap")
			end
		end
	end
	return errors
end

return MapConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = {}

Net.Names = {
	"StateUpdate",
	"MoneySync",
	"Notify",
	"ThrowPart",
	"ThrowResult",
	"PlaceCar",
	"RemoveCar",
	"UpgradeCar",
	"BuySlot",
	"UnlockZone",
	"HitFx",
	"SellCar",
	"AutoPark",
}

function Net.Folder()
	local f = ReplicatedStorage:FindFirstChild("Remotes")
	if f then
		return f
	end
	if RunService:IsServer() then
		f = Instance.new("Folder")
		f.Name = "Remotes"
		f.Parent = ReplicatedStorage
		return f
	end
	return ReplicatedStorage:WaitForChild("Remotes")
end

function Net.Get(name)
	local folder = Net.Folder()
	local r = folder:FindFirstChild(name)
	if r then
		return r
	end
	if RunService:IsServer() then
		r = Instance.new("RemoteEvent")
		r.Name = name
		r.Parent = folder
		return r
	end
	return folder:WaitForChild(name)
end

function Net.EnsureAll()
	for _, n in ipairs(Net.Names) do
		Net.Get(n)
	end
end

return Net
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX18"><Properties><string name="Name">PartConfig</string><ProtectedString name="Source"><![CDATA[local C = Color3.fromRGB

local PartConfig = {}

PartConfig.Order = { "bolts", "tire", "engine", "turbo", "core" }

PartConfig.Parts = {
	bolts = { id = "bolts", rarity = "Common", color = C(200, 205, 215) },
	tire = { id = "tire", rarity = "Uncommon", color = C(90, 220, 140) },
	engine = { id = "engine", rarity = "Rare", color = C(80, 170, 255) },
	turbo = { id = "turbo", rarity = "Epic", color = C(180, 100, 255) },
	core = { id = "core", rarity = "Legendary", color = C(255, 195, 50) },
}

PartConfig.PartForRarity = {
	Common = "bolts", Uncommon = "tire", Rare = "engine", Epic = "turbo", Legendary = "core",
}

PartConfig.SpawnTables = {
	city = {
		safe = { { "bolts", 85 }, { "tire", 15 } },
		risky = { { "bolts", 50 }, { "tire", 45 }, { "engine", 5 } },
	},
	highway = {
		safe = { { "tire", 70 }, { "engine", 30 } },
		risky = { { "tire", 30 }, { "engine", 60 }, { "turbo", 10 } },
	},
	industrial = {
		safe = { { "engine", 80 }, { "turbo", 20 } },
		risky = { { "engine", 55 }, { "turbo", 45 } },
	},
	neon = {
		safe = { { "turbo", 75 }, { "core", 25 } },
		risky = { { "turbo", 40 }, { "core", 60 } },
	},
}

PartConfig.PointCounts = {
	city = { safe = 18, risky = 8 },
	highway = { safe = 16, risky = 8 },
	industrial = { safe = 16, risky = 8 },
	neon = { safe = 14, risky = 8 },
}

PartConfig.Cooldowns = { safe = { 55, 85 }, risky = { 70, 110 } }

return PartConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX19"><Properties><string name="Name">PartVisual</string><ProtectedString name="Source"><![CDATA[local PartConfig = require(script.Parent.PartConfig)

local PartVisual = {}

local METAL = Color3.fromRGB(90, 96, 108)
local SILVER = Color3.fromRGB(205, 210, 220)
local DARK = Color3.fromRGB(30, 30, 34)

function PartVisual.Build(partId)
	local def = PartConfig.Parts[partId] or PartConfig.Parts.bolts
	local col = def.color

	local model = Instance.new("Model")
	model.Name = "Drop_" .. def.id

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(1, 1, 1)
	root.CFrame = CFrame.new(0, 0, 0)
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Transparency = 1
	root.Parent = model
	model.PrimaryPart = root

	local function add(name, size, cf, color, material, transparency, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Material = material or Enum.Material.SmoothPlastic
		p.Transparency = transparency or 0
		if shape then
			p.Shape = shape
		end
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Anchored = false
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.CastShadow = false
		p.Parent = model
		local w = Instance.new("Weld")
		w.Part0 = root
		w.Part1 = p
		w.C0 = cf
		w.Parent = p
		return p
	end

	local CYL = Enum.PartType.Cylinder
	local BALL = Enum.PartType.Ball
	local upright = CFrame.Angles(0, 0, math.pi / 2)

	if def.id == "bolts" then
		add("Nut", Vector3.new(0.9, 2.0, 2.0), upright, SILVER, Enum.Material.Metal, 0, CYL)
		add("NutGlow", Vector3.new(0.95, 1.2, 1.2), upright, col, Enum.Material.Neon, 0, CYL)
		add("Shaft", Vector3.new(2.2, 0.8, 0.8), CFrame.new(0, -1.5, 0) * upright, METAL, Enum.Material.Metal, 0, CYL)
	elseif def.id == "tire" then
		add("Tire", Vector3.new(1.4, 3.4, 3.4), CFrame.new(), DARK, Enum.Material.SmoothPlastic, 0, CYL)
		add("Hub", Vector3.new(1.5, 1.7, 1.7), CFrame.new(), SILVER, Enum.Material.Metal, 0, CYL)
		add("HubGlow", Vector3.new(1.55, 0.8, 0.8), CFrame.new(), col, Enum.Material.Neon, 0, CYL)
	elseif def.id == "engine" then
		add("Block", Vector3.new(3.2, 2.0, 2.2), CFrame.new(), METAL, Enum.Material.Metal)
		for i = -1, 1 do
			add("Piston", Vector3.new(0.9, 0.9, 0.9), CFrame.new(i * 1.0, 1.4, 0) * upright, SILVER, Enum.Material.Metal, 0, CYL)
		end
		add("Strip", Vector3.new(3.25, 0.35, 2.25), CFrame.new(0, -0.2, 0), col, Enum.Material.Neon)
	elseif def.id == "turbo" then
		add("Housing", Vector3.new(2.2, 2.8, 2.8), CFrame.new(), col, Enum.Material.Metal, 0, CYL)
		add("Inlet", Vector3.new(1.2, 1.7, 1.7), CFrame.new(1.6, 0, 0), SILVER, Enum.Material.Metal, 0, CYL)
		add("InletGlow", Vector3.new(0.4, 1.2, 1.2), CFrame.new(2.2, 0, 0), col, Enum.Material.Neon, 0, CYL)
		add("Pipe", Vector3.new(1.4, 0.8, 0.8), CFrame.new(-0.2, 1.8, 0) * upright, METAL, Enum.Material.Metal, 0, CYL)
	else
		add("Core", Vector3.new(2.4, 2.4, 2.4), CFrame.new(), col, Enum.Material.Neon, 0, BALL)
		add("RingA", Vector3.new(0.18, 4.0, 4.0), CFrame.new(), SILVER, Enum.Material.Metal, 0.1, CYL)
		add("RingB", Vector3.new(0.18, 4.0, 4.0), CFrame.Angles(0, math.pi / 2, 0), SILVER, Enum.Material.Metal, 0.1, CYL)
	end

	add("Halo", Vector3.new(0.15, 5.5, 5.5), CFrame.new(0, -2.55, 0) * upright, col, Enum.Material.Neon, 0.55, CYL)

	if def.rarity == "Epic" or def.rarity == "Legendary" then
		local pe = Instance.new("ParticleEmitter")
		pe.Color = ColorSequence.new(col)
		pe.Rate = (def.rarity == "Legendary") and 10 or 5
		pe.Lifetime = NumberRange.new(1, 1.6)
		pe.Speed = NumberRange.new(2, 4)
		pe.Size = NumberSequence.new(0.5, 0)
		pe.LightEmission = 1
		pe.Parent = root
	end
	if def.rarity == "Legendary" then
		local light = Instance.new("PointLight")
		light.Color = col
		light.Range = 14
		light.Brightness = 1.5
		light.Parent = root
	end

	model:SetAttribute("PartId", def.id)
	return model
end

return PartVisual
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX20"><Properties><string name="Name">Strings</string><ProtectedString name="Source"><![CDATA[local Strings = {}

local en = {
	hud_money = "Money", hud_income = "Income", hud_zone = "District", hud_carry = "Backpack",
	zone_plaza = "Safe Plaza", zone_city = "City", zone_highway = "Highway",
	zone_industrial = "Industrial", zone_neon = "Neon",
	part_bolts = "Bolts", part_tire = "Tire", part_engine = "Engine", part_turbo = "Turbo", part_core = "Core",
	rarity_Common = "Common", rarity_Uncommon = "Uncommon", rarity_Rare = "Rare", rarity_Epic = "Epic", rarity_Legendary = "Legendary",
	btn_throw = "THROW", btn_garage = "Garage", btn_zones = "Map", btn_index = "Cars", btn_close = "Close",
	btn_place = "Park", btn_remove = "Unpark", btn_upgrade = "Upgrade", btn_unlock = "Unlock", btn_max = "MAX LEVEL",
	btn_buyslot = "Buy slot", btn_sell = "Sell", btn_sure = "Sure?", btn_autopark = "Park best",
	throw_title = "Choose your bait", throw_none = "No parts yet",
	throw_odds = "Drop chances", throw_pity = "Epic+ guaranteed in %d throws", throw_pity_now = "Next throw: Epic+ guaranteed!",
	garage_title = "My Garage", garage_slots = "Parking", garage_cars = "My Cars",
	garage_empty = "No cars yet. Grab parts in the city and throw them on your trap!",
	car_level = "Lv %d", car_income = "+%s/s", car_parked = "Slot %d", car_stored = "Storage",
	reveal_new = "NEW CAR!", reveal_got = "YOU GOT", reveal_first = "FIRST DISCOVERY  +$%s",
	reveal_placed = "Parked in slot %d", reveal_stored = "Garage full - sent to storage", reveal_pity = "Lucky guarantee!",
	index_title = "Car Collection", index_found = "%d / %d discovered", index_bonus = "Income bonus x%s",
	index_hint = "Complete a rarity row: +5% income. Complete all: +10% more.", index_unknown = "???",
	zones_title = "City Map", zones_open = "Unlocked", zones_locked = "Locked", zones_need_prev = "Unlock previous first",
	zones_cost = "Price", zones_value = "Collection value", zones_done = "Every district is open. You rule the streets!",
	zone_desc_city = "Calm streets. Bolts and tires.", zone_desc_highway = "Fast lanes. Tires, engines, turbos.",
	zone_desc_industrial = "Heavy trucks. Engines and turbos.", zone_desc_neon = "Hyper traffic. Turbos and cores.",
	tut_find = "Run into the city and grab a glowing part. Watch the traffic!",
	tut_return = "Bring it back to the plaza - loot is saved once you're safe.",
	tut_throw = "Go to the glowing trap in your garage and press THROW.",
	tut_upgrade = "Open Garage and upgrade a car to earn faster.",
	tut_zone = "You can open a new district! Check the Map.",
	n_noPart = "You don't have that part.", n_trapBusy = "The trap is busy - one moment.",
	n_tooFar = "Get closer to your garage.", n_storageFull = "Car storage is full. Sell some cars.",
	n_dataFail = "Your data failed to load. Progress will NOT be saved this session.",
	n_studioNoSave = "Studio test without API access: progress is not saved.",
	n_carryFull = "Backpack full! Head back to the plaza.", n_picked = "+1 %s",
	n_banked = "Loot secured!", n_lost = "Hit by traffic! Lost %d carried part(s).",
	n_hit = "Ouch! Watch the traffic!", n_zoneLocked = "This district is locked.",
	n_zoneUnlocked = "District unlocked: %s!", n_upgraded = "Upgraded to level %d!",
	n_slotBought = "Parking slot %d unlocked!", n_noMoney = "Not enough money.", n_noParts = "Not enough parts.",
	n_maxLevel = "Already max level.", n_slow = "Too fast - slow down.", n_busy = "Please wait...",
	n_starter = "Here's a free bolt to get you going!", n_noBase = "No garage assigned.", n_stale = "Out of date - try again.",
	n_needPrev = "Unlock the previous district first.", n_needValue = "Collection value too low.",
	n_full = "Server is full.", n_moved = "Car moved.", n_removed = "Car unparked.",
	n_sold = "Sold %s for $%s", n_autoParked = "Best cars parked!",
	lb_title = "TOP INCOME / SEC", free_garage = "FREE GARAGE", garage_of = "%s's Garage",
	locked_sign = "LOCKED", income_sign = "INCOME",
}

Strings.Tables = { en = en }
Strings.Lang = "en"

function Strings.SetLocale()
	Strings.Lang = "en"
end

function Strings.T(key, ...)
	local s = en[key] or key
	if select("#", ...) > 0 then
		local ok, res = pcall(string.format, s, ...)
		if ok then
			return res
		end
	end
	return s
end

return Strings
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX21"><Properties><string name="Name">TrafficMath</string><ProtectedString name="Source"><![CDATA[local MapConfig = require(script.Parent.MapConfig)

local M = {}

M.Length = 2 * (MapConfig.MapHalfWidth + MapConfig.TunnelLength)
M.MinX = -(MapConfig.MapHalfWidth + MapConfig.TunnelLength)
M.VisibleHalfX = MapConfig.MapHalfWidth + 30

local function newRng(seed)
	local s = (math.floor(seed) % 2147483646) + 1
	return function()
		s = (s * 16807) % 2147483647
		return s / 2147483647
	end
end
M.NewRng = newRng

M.Lanes = {}
M.RoadLanes = {}

for ri, road in ipairs(MapConfig.Roads) do
	local rng = newRng(MapConfig.Seed + ri * 7919)
	local lanes = {}
	local lps, lw, med = road.lanesPerSide, road.laneWidth, road.median
	for _, side in ipairs({ -1, 1 }) do
		for i = 1, lps do
			local zoff
			if side == -1 then
				zoff = -(med / 2) - lw * (i - 0.5)
			else
				zoff = (med / 2) + lw * (i - 0.5)
			end
			local dir = (side == -1) and 1 or -1
			local speed = road.speed[1] + (road.speed[2] - road.speed[1]) * rng()
			local spacing = road.spacing[1] + (road.spacing[2] - road.spacing[1]) * rng()
			local n = math.max(2, math.floor(M.Length / spacing + 0.5))
			local S = M.Length / n
			local offsets, kinds, colors = {}, {}, {}
			for k = 1, n do
				offsets[k] = (k - 1) * S + (rng() * 2 - 1) * 0.18 * S
				kinds[k] = road.kinds[math.floor(rng() * #road.kinds) + 1]
				colors[k] = math.floor(rng() * #MapConfig.TrafficColors) + 1
			end
			local lane = {
				road = ri, index = #M.Lanes + 1, side = side, dir = dir, z = road.z + zoff,
				speed = speed, count = n, spacing = S, offsets = offsets, kinds = kinds,
				colors = colors, phase = rng() * M.Length,
			}
			table.insert(lanes, lane)
			table.insert(M.Lanes, lane)
		end
	end
	M.RoadLanes[ri] = lanes
end

function M.CarX(lane, k, t)
	local d = (lane.speed * t + lane.phase + lane.offsets[k]) % M.Length
	local x = M.MinX + d
	if lane.dir < 0 then
		x = -x
	end
	return x
end

function M.RoadAtZ(z, margin)
	margin = margin or 0
	for ri, road in ipairs(MapConfig.Roads) do
		if math.abs(z - road.z) <= road.width / 2 + margin then
			return ri
		end
	end
	return nil
end

return M
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22"><Properties><string name="Name">Util</string><ProtectedString name="Source"><![CDATA[local Util = {}

function Util.Clamp(v, lo, hi)
	if v < lo then return lo end
	if v > hi then return hi end
	return v
end

function Util.IsInt(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge and n == math.floor(n)
end

function Util.FormatNumber(n)
	n = math.floor((tonumber(n) or 0) + 0.5)
	if n < 1000 then
		return tostring(n)
	end
	local units = { { 1e15, "Qa" }, { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } }
	for _, u in ipairs(units) do
		if n >= u[1] then
			local v = n / u[1]
			local s
			if v >= 100 then
				s = string.format("%d", math.floor(v))
			elseif v >= 10 then
				s = string.format("%.1f", v)
			else
				s = string.format("%.2f", v)
			end
			if string.find(s, ".", 1, true) then
				s = string.gsub(s, "0+$", "")
				s = string.gsub(s, "%.$", "")
			end
			return s .. u[2]
		end
	end
	return tostring(n)
end

function Util.WeightedPick(entries, r)
	local total = 0
	for _, e in ipairs(entries) do
		total = total + e[2]
	end
	if total <= 0 then
		return nil
	end
	local acc = 0
	local target = r * total
	for _, e in ipairs(entries) do
		acc = acc + e[2]
		if target < acc then
			return e[1]
		end
	end
	return entries[#entries][1]
end

function Util.CopyTable(t)
	local out = {}
	for k, v in pairs(t) do
		if type(v) == "table" then
			out[k] = Util.CopyTable(v)
		else
			out[k] = v
		end
	end
	return out
end

return Util
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX23"><Properties><string name="Name">VehicleFactory</string><ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Kinds = require(script.Parent.VehicleKinds)

local VehicleFactory = {}
VehicleFactory.Kinds = Kinds

local GLASS = Color3.fromRGB(70, 98, 130)
local DARK = Color3.fromRGB(30, 30, 36)
local TIRE = Color3.fromRGB(26, 26, 30)
local SILVER = Color3.fromRGB(205, 210, 220)
local HEAD = Color3.fromRGB(255, 246, 210)
local TAIL = Color3.fromRGB(255, 46, 60)
local M = Enum.Material
local CYL = Enum.PartType.Cylinder
local ACROSS = CFrame.Angles(0, math.pi / 2, 0)
local SPORTY = { sport = true, supercar = true, proto = true }
local BOXY = { van = true, truck = true, service = true, minibus = true }

local templateCache = {}

local function newRoot()
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(1, 0.2, 1)
	root.CFrame = CFrame.new()
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Transparency = 1
	return root
end

local function modelsFolder()
	return ReplicatedStorage:FindFirstChild("CarModels")
end

local function hasGeometry(m)
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			return true
		end
	end
	return false
end

local function prepareTemplate(tpl, targetL, opts)
	local m = tpl:Clone()
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("LuaSourceContainer") or d:IsA("JointInstance") or d:IsA("Constraint") or d:IsA("Sound")
			or d:IsA("ProximityPrompt") or d:IsA("ClickDetector") or d:IsA("BodyMover") or d:IsA("Humanoid") then
			d:Destroy()
		end
	end
	m.PrimaryPart = nil
	m.WorldPivot = CFrame.new(m:GetPivot().Position)
	local bb, size = m:GetBoundingBox()
	local alongZ = size.Z > size.X
	local length = math.max(size.X, size.Z, 0.1)
	local scale = targetL / length
	m.WorldPivot = CFrame.new(bb.Position)
	if math.abs(scale - 1) > 1e-3 then
		m:ScaleTo(m:GetScale() * scale)
	end
	local bottom = bb.Position.Y - size.Y * scale / 2
	local yaw = (alongZ and math.pi / 2 or 0) + math.rad(tonumber(tpl:GetAttribute("Yaw")) or 0)
	local root = newRoot()
	root.CFrame = CFrame.new(bb.Position.X, bottom, bb.Position.Z) * CFrame.Angles(0, yaw, 0)
	root.Parent = m
	local recolor = tpl:GetAttribute("Recolor") == true
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") and d ~= root then
			d.Anchored = false
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true
			if d:IsA("Seat") or d:IsA("VehicleSeat") then
				d.Disabled = true
			end
			if recolor and opts.BodyColor then
				local n = string.lower(d.Name)
				if string.find(n, "body", 1, true) or string.find(n, "paint", 1, true) then
					d.Color = opts.BodyColor
				end
			end
			local w = Instance.new("WeldConstraint")
			w.Part0 = root
			w.Part1 = d
			w.Parent = d
		end
	end
	m.PrimaryPart = root
	m:PivotTo(CFrame.new())
	m.Name = "Vehicle"
	m:SetAttribute("RealModel", true)
	m:SetAttribute("Height", size.Y * scale)
	return m
end

local function fromTemplate(key, tpl, targetL, opts)
	local cached = templateCache[key]
	if cached == nil then
		local ok, res = pcall(prepareTemplate, tpl, targetL, opts)
		if ok then
			cached = res
		else
			warn("[CarModels] could not prepare", tpl:GetFullName(), res)
			cached = false
		end
		templateCache[key] = cached
	end
	if cached then
		return cached:Clone()
	end
	return nil
end

local function addNeonGlow(model, k, neon)
	local root = model.PrimaryPart
	local p = Instance.new("Part")
	p.Name = "Underglow"
	p.Size = Vector3.new(k.L * 0.8, 0.15, k.W * 0.85)
	p.CFrame = root.CFrame * CFrame.new(0, 0.25, 0)
	p.Color = neon
	p.Material = M.Neon
	p.Transparency = 0.15
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	local w = Instance.new("WeldConstraint")
	w.Part0 = root
	w.Part1 = p
	w.Parent = p
	p.Parent = model
end

function VehicleFactory.Build(kindName, opts)
	opts = opts or {}
	local k = Kinds[kindName] or Kinds.sedan
	local body = opts.BodyColor or k.color
	local accent = opts.AccentColor or DARK
	local neon = opts.NeonColor
	local low = opts.Low == true
	local sporty = SPORTY[kindName] == true
	local boxy = BOXY[kindName] == true

	local model = Instance.new("Model")
	model.Name = "Vehicle"
	local root = newRoot()
	root.Parent = model
	model.PrimaryPart = root

	local function add(name, size, cf, color, material, transparency, shape, class)
		local p = Instance.new(class or "Part")
		p.Name = name
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Material = material or M.SmoothPlastic
		p.Transparency = transparency or 0
		if shape then
			p.Shape = shape
		end
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Anchored = false
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.CastShadow = not low
		p.Parent = model
		local w = Instance.new("Weld")
		w.Part0 = root
		w.Part1 = p
		w.C0 = cf
		w.Parent = p
		return p
	end
	local function wedge(name, size, cf, color, material, transparency)
		return add(name, size, cf, color, material, transparency, nil, "WedgePart")
	end

	local L, W = k.L, k.W
	local clear, bodyH = k.clear, k.bodyH
	local r = bodyH / 2
	local topY = clear + bodyH
	local midY = clear + r

	local bodyPart = add("Body", Vector3.new(L - bodyH, bodyH, W), CFrame.new(0, midY, 0), body)
	local noseF = add("BodyNose", Vector3.new(W, bodyH, bodyH), CFrame.new(L / 2 - r, midY, 0) * ACROSS, body, nil, 0, CYL)
	local noseB = add("BodyTail", Vector3.new(W, bodyH, bodyH), CFrame.new(-L / 2 + r, midY, 0) * ACROSS, body, nil, 0, CYL)
	if opts.Chrome then
		for _, p in ipairs({ bodyPart, noseF, noseB }) do
			p.Reflectance = 0.35
			p.Material = M.Metal
		end
	end
	add("Skirt", Vector3.new(L - bodyH * 0.6, 0.35, W + 0.06), CFrame.new(0, clear + 0.18, 0), accent)

	local roofTop = topY
	if k.cabinL and k.cabinL > 0 then
		local gh = k.cabinH
		local cw = W * k.cabinW
		local glassColor, glassMat, glassTr = GLASS, M.Glass, 0.15
		if k.canopyNeon and neon then
			glassColor, glassMat, glassTr = neon, M.Neon, 0.35
		end
		local wfK, wrK = 0.28, 0.2
		if sporty then
			wfK, wrK = 0.4, 0.3
		elseif boxy then
			wfK, wrK = 0.14, 0.05
		elseif kindName == "pickup" then
			wfK, wrK = 0.24, 0.06
		end
		local wf, wr = k.cabinL * wfK, k.cabinL * wrK
		local rl = k.cabinL - wf - wr
		local front = k.cabinX + k.cabinL / 2
		local cy = topY + gh / 2
		wedge("Windshield", Vector3.new(cw, gh, wf), CFrame.new(front - wf / 2, cy, 0) * CFrame.Angles(0, -math.pi / 2, 0), glassColor, glassMat, glassTr)
		add("Cabin", Vector3.new(rl, gh, cw), CFrame.new(front - wf - rl / 2, cy, 0), glassColor, glassMat, glassTr)
		if wr > 0.05 then
			wedge("RearGlass", Vector3.new(cw, gh, wr), CFrame.new(front - wf - rl - wr / 2, cy, 0) * CFrame.Angles(0, math.pi / 2, 0), glassColor, glassMat, glassTr)
		end
		add("Roof", Vector3.new(rl + 0.3, 0.3, cw + 0.12), CFrame.new(front - wf - rl / 2, topY + gh + 0.15, 0), body)
		if not low then
			add("PillarF", Vector3.new(0.35, gh, cw + 0.1), CFrame.new(front - wf - 0.17, cy, 0), body)
			add("PillarB", Vector3.new(0.35, gh, cw + 0.1), CFrame.new(front - wf - rl + 0.17, cy, 0), body)
			add("PillarM", Vector3.new(0.3, gh, cw + 0.1), CFrame.new(front - wf - rl / 2, cy, 0), body)
			for _, s in ipairs({ -1, 1 }) do
				add("Mirror", Vector3.new(0.5, 0.4, 0.5), CFrame.new(front - 0.2, topY + 0.3, s * (W / 2 + 0.15)), body)
			end
			local hoodL = L / 2 - front - r * 0.6
			if hoodL > 1.2 and not boxy then
				wedge("Hood", Vector3.new(W * 0.86, 0.35, hoodL), CFrame.new(front + hoodL / 2, topY + 0.17, 0) * CFrame.Angles(0, -math.pi / 2, 0), body)
			end
		end
		roofTop = topY + gh + 0.3
	end

	if k.box then
		add("Cargo", Vector3.new(k.box.L, k.box.H, W * 0.98), CFrame.new(k.box.x, topY + k.box.H / 2, 0), opts.CargoColor or Color3.fromRGB(236, 238, 244))
		if not low then
			add("CargoTrim", Vector3.new(k.box.L + 0.1, 0.3, W + 0.04), CFrame.new(k.box.x, topY + k.box.H - 0.15, 0), accent)
			add("CargoStripe", Vector3.new(k.box.L * 0.9, 0.6, W + 0.02), CFrame.new(k.box.x, topY + k.box.H * 0.45, 0), body)
		end
		roofTop = math.max(roofTop, topY + k.box.H)
	end

	if k.bed then
		local bw = W * 0.92
		add("BedFloor", Vector3.new(k.bed.L, 0.25, bw), CFrame.new(k.bed.x, topY + 0.12, 0), accent)
		add("BedSideL", Vector3.new(k.bed.L, 0.9, 0.3), CFrame.new(k.bed.x, topY + 0.7, bw / 2 - 0.15), body)
		add("BedSideR", Vector3.new(k.bed.L, 0.9, 0.3), CFrame.new(k.bed.x, topY + 0.7, -bw / 2 + 0.15), body)
		add("BedBack", Vector3.new(0.3, 0.9, bw), CFrame.new(k.bed.x - k.bed.L / 2 + 0.15, topY + 0.7, 0), body)
	end

	local axles = { 0.31, -0.31 }
	if k.sixWheels then
		axles = { 0.36, -0.18, -0.34 }
	end
	local rimColor = (neon and not low) and neon or SILVER
	for _, ax in ipairs(axles) do
		for _, sgn in ipairs({ -1, 1 }) do
			local z = sgn * (W / 2 - 0.4)
			local cf = CFrame.new(L * ax, k.wr, z) * ACROSS
			add("Wheel", Vector3.new(1.0, k.wr * 2, k.wr * 2), cf, TIRE, M.SmoothPlastic, 0, CYL)
			add("Rim", Vector3.new(1.06, k.wr * 1.25, k.wr * 1.25), cf, rimColor, M.Metal, 0, CYL)
			if not low then
				add("Hub", Vector3.new(1.12, k.wr * 0.45, k.wr * 0.45), cf, DARK, M.Metal, 0, CYL)
				add("Arch", Vector3.new(k.wr * 2.3, 0.35, 0.5), CFrame.new(L * ax, clear + bodyH * 0.92, sgn * (W / 2 + 0.05)), accent)
			end
		end
	end

	local function noseX(y)
		local dy = y - midY
		return L / 2 - r + math.sqrt(math.max(0, r * r - dy * dy))
	end
	local ly = midY + bodyH * 0.18
	local hx = noseX(ly)
	add("Grille", Vector3.new(0.3, bodyH * 0.38, W * 0.42), CFrame.new(noseX(midY - bodyH * 0.1) - 0.05, midY - bodyH * 0.1, 0), DARK)
	for _, s in ipairs({ -1, 1 }) do
		add("Head", Vector3.new(0.35, bodyH * 0.22, W * 0.2), CFrame.new(hx - 0.05, ly, s * W * 0.32), HEAD, M.Neon)
		add("Tail", Vector3.new(0.35, bodyH * 0.2, W * 0.24), CFrame.new(-hx + 0.05, ly, s * W * 0.3), TAIL, M.Neon)
	end

	if k.taxiSign then
		add("TaxiSign", Vector3.new(1.6, 0.7, 2.6), CFrame.new(k.cabinX, roofTop + 0.35, 0), Color3.fromRGB(255, 255, 220), M.Neon)
	end
	if not low then
		for _, s in ipairs({ -1, 1 }) do
			add("Stripe", Vector3.new(L * 0.62, 0.22, 0.08), CFrame.new(0, clear + bodyH * 0.62, s * (W / 2 + 0.03)), accent)
			add("Handle", Vector3.new(0.6, 0.15, 0.08), CFrame.new(k.cabinX or 0, topY - 0.35, s * (W / 2 + 0.04)), DARK)
		end
		if sporty then
			add("Splitter", Vector3.new(1.0, 0.18, W * 0.96), CFrame.new(L / 2 - 0.4, clear + 0.09, 0), accent)
			for _, s in ipairs({ -1, 1 }) do
				add("Exhaust", Vector3.new(0.6, 0.45, 0.45), CFrame.new(-L / 2 + 0.05, clear + 0.35, s * 1.0), SILVER, M.Metal, 0, CYL)
			end
		end
	end
	if opts.Spoiler then
		for _, s in ipairs({ -1, 1 }) do
			add("WingPost", Vector3.new(0.35, 1.0, 0.35), CFrame.new(-L * 0.42, topY + 0.5, s * W * 0.28), accent)
		end
		add("Wing", Vector3.new(1.6, 0.22, W * 0.98), CFrame.new(-L * 0.42, topY + 1.1, 0), accent)
	end
	if k.fins then
		for _, s in ipairs({ -1, 1 }) do
			wedge("Fin", Vector3.new(0.25, 1.1, 2.6), CFrame.new(-L * 0.36, topY + 0.55, s * W * 0.32) * CFrame.Angles(0, math.pi / 2, 0), accent)
		end
	end
	if neon then
		add("Underglow", Vector3.new(L * 0.8, 0.18, W * 0.9), CFrame.new(0, clear * 0.5, 0), neon, M.Neon, 0.1)
		if not low then
			for _, s in ipairs({ -1, 1 }) do
				add("Glow", Vector3.new(L * 0.66, 0.14, 0.1), CFrame.new(0, clear + bodyH * 0.25, s * (W / 2 + 0.05)), neon, M.Neon)
			end
		end
	end

	model:SetAttribute("Kind", kindName)
	model:SetAttribute("Height", roofTop)
	return model
end

function VehicleFactory.BuildCar(def, opts)
	opts = opts or {}
	local k = Kinds[def.style] or Kinds.sedan
	local folder = modelsFolder()
	local tpl = folder and folder:FindFirstChild(def.id)
	if tpl and tpl:IsA("Model") and hasGeometry(tpl) then
		local m = fromTemplate("car:" .. def.id, tpl, k.L, { BodyColor = def.body })
		if m then
			if def.neon and not opts.Low then
				addNeonGlow(m, k, def.neon)
			end
			return m
		end
	end
	return VehicleFactory.Build(def.style, {
		BodyColor = def.body, AccentColor = def.accent, NeonColor = def.neon, Spoiler = def.spoiler,
		Chrome = def.chrome, Low = opts.Low,
	})
end

function VehicleFactory.BuildTraffic(kindName, color, variant)
	local k = Kinds[kindName] or Kinds.sedan
	local folder = modelsFolder()
	local traffic = folder and folder:FindFirstChild("Traffic")
	if traffic then
		local options = {}
		for _, m in ipairs(traffic:GetChildren()) do
			if m:IsA("Model") and (m.Name == kindName or string.sub(m.Name, 1, #kindName + 1) == kindName .. "_") and hasGeometry(m) then
				table.insert(options, m)
			end
		end
		if #options > 0 then
			table.sort(options, function(a, b) return a.Name < b.Name end)
			local tpl = options[((variant or 1) - 1) % #options + 1]
			local m = fromTemplate("traffic:" .. tpl.Name, tpl, k.L, { BodyColor = color })
			if m then
				for _, d in ipairs(m:GetDescendants()) do
					if d:IsA("BasePart") then
						d.CastShadow = false
					end
				end
				return m
			end
		end
	end
	return VehicleFactory.Build(kindName, { BodyColor = color, Low = true })
end

function VehicleFactory.HeightOf(kindName)
	local k = Kinds[kindName] or Kinds.sedan
	return k.H
end

function VehicleFactory.HeightOfModel(model, kindName)
	local h = model and model:GetAttribute("Height")
	if type(h) == "number" then
		return h
	end
	return VehicleFactory.HeightOf(kindName)
end

return VehicleFactory
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX24"><Properties><string name="Name">VehicleKinds</string><ProtectedString name="Source"><![CDATA[local C = Color3.fromRGB

local Kinds = {
	compact = { L = 11.5, W = 5.8, H = 4.6, wr = 1.2, clear = 0.7, bodyH = 1.9, cabinL = 6.0, cabinH = 1.9, cabinX = -0.8, cabinW = 0.9, color = C(220, 90, 70) },
	sedan = { L = 14.5, W = 6.2, H = 4.7, wr = 1.3, clear = 0.8, bodyH = 2.0, cabinL = 7.4, cabinH = 1.9, cabinX = -1.0, cabinW = 0.9, color = C(80, 120, 200) },
	taxi = { L = 14.5, W = 6.2, H = 5.4, wr = 1.3, clear = 0.8, bodyH = 2.0, cabinL = 7.4, cabinH = 1.9, cabinX = -1.0, cabinW = 0.9, color = C(250, 205, 40), taxiSign = true },
	van = { L = 14.5, W = 6.6, H = 6.6, wr = 1.4, clear = 0.9, bodyH = 2.2, cabinL = 4.0, cabinH = 1.9, cabinX = 4.2, cabinW = 0.92,
		box = { L = 9.6, H = 3.6, x = -2.2 }, color = C(235, 235, 240) },
	minibus = { L = 18, W = 6.8, H = 7.0, wr = 1.4, clear = 0.9, bodyH = 2.6, cabinL = 14.0, cabinH = 2.6, cabinX = -0.4, cabinW = 0.94, color = C(240, 180, 40) },
	sport = { L = 14.8, W = 6.6, H = 3.9, wr = 1.2, clear = 0.55, bodyH = 1.7, cabinL = 5.0, cabinH = 1.5, cabinX = -1.8, cabinW = 0.84, color = C(210, 40, 45) },
	supercar = { L = 15.2, W = 7.0, H = 3.5, wr = 1.2, clear = 0.45, bodyH = 1.5, cabinL = 4.4, cabinH = 1.4, cabinX = -1.2, cabinW = 0.8, color = C(255, 120, 30) },
	pickup = { L = 16.5, W = 6.6, H = 5.6, wr = 1.5, clear = 1.0, bodyH = 2.3, cabinL = 5.2, cabinH = 2.0, cabinX = 2.6, cabinW = 0.9,
		bed = { L = 6.8, x = -4.6 }, color = C(196, 164, 110) },
	service = { L = 15.5, W = 6.6, H = 6.2, wr = 1.4, clear = 0.9, bodyH = 2.4, cabinL = 4.4, cabinH = 1.9, cabinX = 4.4, cabinW = 0.92,
		box = { L = 9.0, H = 3.5, x = -2.4 }, color = C(235, 170, 40) },
	truck = { L = 26, W = 7.6, H = 8.8, wr = 2.0, clear = 1.4, bodyH = 2.6, cabinL = 5.4, cabinH = 3.0, cabinX = 9.2, cabinW = 0.92,
		box = { L = 17.0, H = 5.2, x = -3.6 }, sixWheels = true, color = C(170, 80, 70) },
	proto = { L = 15.8, W = 7.0, H = 3.7, wr = 1.2, clear = 0.5, bodyH = 1.5, cabinL = 5.2, cabinH = 1.6, cabinX = -0.6, cabinW = 0.78,
		fins = true, canopyNeon = true, color = C(30, 30, 44) },
}

return Kinds
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX26"><Properties><string name="Name">Remotes</string></Properties><Item class="RemoteEvent" referent="RBX1036"><Properties><string name="Name">AutoPark</string></Properties></Item><Item class="RemoteEvent" referent="RBX1035"><Properties><string name="Name">SellCar</string></Properties></Item><Item class="RemoteEvent" referent="RBX1"><Properties><string name="Name">StateUpdate</string></Properties></Item><Item class="RemoteEvent" referent="RBX2"><Properties><string name="Name">MoneySync</string></Properties></Item><Item class="RemoteEvent" referent="RBX3"><Properties><string name="Name">Notify</string></Properties></Item><Item class="RemoteEvent" referent="RBX4"><Properties><string name="Name">ThrowPart</string></Properties></Item><Item class="RemoteEvent" referent="RBX5"><Properties><string name="Name">ThrowResult</string></Properties></Item><Item class="RemoteEvent" referent="RBX6"><Properties><string name="Name">PlaceCar</string></Properties></Item><Item class="RemoteEvent" referent="RBX7"><Properties><string name="Name">RemoveCar</string></Properties></Item><Item class="RemoteEvent" referent="RBX8"><Properties><string name="Name">UpgradeCar</string></Properties></Item><Item class="RemoteEvent" referent="RBX9"><Properties><string name="Name">BuySlot</string></Properties></Item><Item class="RemoteEvent" referent="RBX10"><Properties><string name="Name">UnlockZone</string></Properties></Item><Item class="RemoteEvent" referent="RBX11"><Properties><string name="Name">HitFx</string></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX40"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX28"><Properties><string name="Name">ServerBootstrap</string><token name="RunContext">0</token><ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))

Net.EnsureAll()

for _, e in ipairs(MapConfig.Validate()) do warn("[MapConfig]", e) end
for _, e in ipairs(CarConfig.Validate()) do warn("[CarConfig]", e) end

Players.CharacterAutoLoads = false
Players.RespawnTime = 2.5

pcall(function()
	Lighting.ClockTime = 14.3
	Lighting.Brightness = 2.3
	Lighting.Ambient = Color3.fromRGB(118, 112, 136)
	Lighting.OutdoorAmbient = Color3.fromRGB(128, 124, 146)
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.6
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.5
	Lighting.GeographicLatitude = 30
	if not Lighting:FindFirstChild("CHAtmosphere") then
		local sky = Instance.new("Sky")
		sky.Name = "CHSky"
		sky.SunAngularSize = 14
		sky.MoonAngularSize = 9
		sky.StarCount = 4000
		sky.Parent = Lighting
		local a = Instance.new("Atmosphere")
		a.Name = "CHAtmosphere"
		a.Density = 0.26
		a.Offset = 0.15
		a.Color = Color3.fromRGB(214, 214, 236)
		a.Decay = Color3.fromRGB(170, 160, 200)
		a.Glare = 0.25
		a.Haze = 1.3
		a.Parent = Lighting
		local b = Instance.new("BloomEffect")
		b.Name = "CHBloom"
		b.Intensity = 0.45
		b.Size = 24
		b.Threshold = 1.15
		b.Parent = Lighting
		local r = Instance.new("SunRaysEffect")
		r.Name = "CHSunRays"
		r.Intensity = 0.05
		r.Spread = 0.6
		r.Parent = Lighting
		local c = Instance.new("ColorCorrectionEffect")
		c.Name = "CHColor"
		c.Saturation = 0.02
		c.Contrast = 0.06
		c.Brightness = 0.02
		c.Parent = Lighting
	end
end)

for _, name in ipairs({ "RuntimeTraffic", "RuntimeDrops" }) do
	if not Workspace:FindFirstChild(name) then
		local f = Instance.new("Folder")
		f.Name = name
		f.Parent = Workspace
	end
end

if not Workspace:FindFirstChild("GeneratedMap") then
	local ok, err = pcall(function()
		local Build = require(ServerStorage:WaitForChild("Tools"):WaitForChild("BuildCityMap"))
		Build.Build({ runtime = true })
	end)
	if not ok then
		warn("[CarHunters] MAP BUILD FAILED:", err)
	end
end

local Services = ServerScriptService:WaitForChild("Services")
local S = {}
local names = { Data = "DataService", Inventory = "InventoryService", Base = "BaseService", PartSpawn = "PartSpawnService",
	Traffic = "TrafficService", Capture = "CaptureService", Cars = "CarCollectionService", Income = "IncomeService",
	Upgrade = "UpgradeService", Zone = "ZoneService" }
for key, moduleName in pairs(names) do
	S[key] = require(Services:WaitForChild(moduleName))
end
for _, svc in pairs(S) do
	if svc.Init then svc.Init(S) end
end
for _, svc in pairs(S) do
	if svc.Start then svc.Start() end
end

Net.Get("ThrowPart").OnServerEvent:Connect(function(p, partId) S.Capture.Throw(p, partId) end)
Net.Get("PlaceCar").OnServerEvent:Connect(function(p, uid, slot) S.Cars.Place(p, uid, slot) end)
Net.Get("RemoveCar").OnServerEvent:Connect(function(p, uid) S.Cars.Remove(p, uid) end)
Net.Get("UpgradeCar").OnServerEvent:Connect(function(p, uid, lvl) S.Upgrade.UpgradeCar(p, uid, lvl) end)
Net.Get("BuySlot").OnServerEvent:Connect(function(p, n) S.Upgrade.BuySlot(p, n) end)
Net.Get("UnlockZone").OnServerEvent:Connect(function(p, z) S.Zone.Unlock(p, z) end)
Net.Get("SellCar").OnServerEvent:Connect(function(p, uid) S.Cars.Sell(p, uid) end)
Net.Get("AutoPark").OnServerEvent:Connect(function(p) S.Cars.AutoPark(p) end)

local function hookCharacter(player, char)
	local hum = char:WaitForChild("Humanoid", 10)
	if not hum then return end
	S.Traffic.Protect(player, EconomyConfig.SpawnProtection)
	task.defer(function() S.Inventory.EnsureNotStuck(player) end)
	hum.Died:Connect(function()
		S.Inventory.OnDeath(player)
		task.delay(Players.RespawnTime, function()
			if player.Parent and player.Character == char then
				player:LoadCharacter()
			end
		end)
	end)
end

local function cleanup(player)
	local s = S.Data.Get(player)
	if not s then return end
	S.Base.Release(player)
	S.Data.Save(player, true)
	S.Data.Unload(player)
end

local function onPlayerAdded(player)
	player.CharacterAdded:Connect(function(char) hookCharacter(player, char) end)
	local s = S.Data.Load(player)
	if not s then return end
	if not player.Parent then
		cleanup(player)
		return
	end
	S.Income.CreateLeaderstats(player)
	local idx = S.Base.Assign(player)
	if not idx then
		player:Kick("Server is full (max " .. EconomyConfig.MaxPlayers .. " players).")
		S.Data.Unload(player)
		return
	end
	S.Income.Recalc(player)
	S.Base.RefreshAll(player)
	s.ready = true
	S.Data.Push(player)
	player:LoadCharacter()
	if s.leftEarly then cleanup(player) end
end

Players.PlayerAdded:Connect(function(p) task.spawn(onPlayerAdded, p) end)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, p)
end

Players.PlayerRemoving:Connect(function(player)
	local s = S.Data.Get(player)
	if not s then return end
	if s.ready then
		cleanup(player)
	else
		s.leftEarly = true
	end
end)

game:BindToClose(function()
	S.Data.SaveAll()
end)

print("[CarHunters] server ready. Spawn points:", S.PartSpawn.PointCount())
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX39"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX29"><Properties><string name="Name">BaseService</string><ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local Strings = require(Shared:WaitForChild("Strings"))
local BaseLayout = require(Shared:WaitForChild("BaseLayout"))
local VehicleFactory = require(Shared:WaitForChild("VehicleFactory"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))
local Util = require(Shared:WaitForChild("Util"))

local Base = {}
local S
local bases = {}

local PAD_LOCKED = Color3.fromRGB(45, 46, 54)
local PAD_FREE = Color3.fromRGB(50, 120, 180)

function Base.Init(hub)
	S = hub
end

function Base.Start()
	local map = Workspace:WaitForChild("GeneratedMap", 30)
	assert(map, "GeneratedMap not found - run BuildCityMap")
	local basesFolder = map:WaitForChild("Bases")
	for i = 1, MapConfig.BaseCount do
		local m = basesFolder:FindFirstChild(string.format("Base%02d", i), true)
		assert(m, "Base model missing: Base" .. i)
		local b = { index = i, model = m, owner = nil, sig = {}, carModels = {}, pads = {} }
		local slots = m:WaitForChild("Slots")
		for n = 1, BaseLayout.SlotCount do
			b.pads[n] = slots:WaitForChild("Slot" .. n)
		end
		b.spawn = m:WaitForChild("Spawn")
		b.sign = m:WaitForChild("OwnerSign"):FindFirstChildWhichIsA("SurfaceGui", true)
		b.screen = m:WaitForChild("IncomeScreen"):FindFirstChildWhichIsA("SurfaceGui", true)
		b.cars = m:FindFirstChild("Cars")
		if not b.cars then
			b.cars = Instance.new("Folder")
			b.cars.Name = "Cars"
			b.cars.Parent = m
		end
		bases[i] = b
		Base.SetFree(b)
	end
end

local function setPad(pad, state, rarityColor)
	if state == "locked" then
		pad.Color = PAD_LOCKED
		pad.Material = Enum.Material.SmoothPlastic
		pad.Transparency = 0
	elseif state == "free" then
		pad.Color = PAD_FREE
		pad.Material = Enum.Material.SmoothPlastic
		pad.Transparency = 0
	else
		pad.Color = rarityColor
		pad.Material = Enum.Material.Neon
		pad.Transparency = 0.35
	end
end

local function setLabel(gui, text)
	if gui then
		local label = gui:FindFirstChild("Label")
		if label then
			label.Text = text
		end
	end
end

function Base.SetFree(b)
	b.owner = nil
	for slot, model in pairs(b.carModels) do
		model:Destroy()
	end
	b.carModels = {}
	b.sig = {}
	for _, pad in ipairs(b.pads) do
		setPad(pad, "locked")
	end
	setLabel(b.sign, Strings.Tables.en.free_garage)
	setLabel(b.screen, "")
end

function Base.Assign(player)
	local s = S.Data.Get(player)
	if not s then
		return nil
	end
	for i = 1, MapConfig.BaseCount do
		local b = bases[i]
		if not b.owner then
			b.owner = player
			s.baseIndex = i
			player:SetAttribute("BaseIndex", i)
			player.RespawnLocation = b.spawn
			setLabel(b.sign, string.format(Strings.Tables.en.garage_of, player.DisplayName))
			return i
		end
	end
	return nil
end

function Base.Release(player)
	local s = S.Data.Get(player)
	if s and s.baseIndex then
		local b = bases[s.baseIndex]
		if b and b.owner == player then
			Base.SetFree(b)
		end
		s.baseIndex = nil
	end
end

function Base.GetBase(index)
	return bases[index]
end

function Base.IsNearOwnBase(player)
	local s = S.Data.Get(player)
	if not s or not s.baseIndex then
		return false
	end
	local hrp = S.Data.GetRoot(player)
	if not hrp then
		return false
	end
	local center = BaseLayout.GetBaseCFrame(s.baseIndex).Position
	return (hrp.Position - center).Magnitude <= EconomyConfig.BaseActionDistance
end

local function buildCarModel(def, level, slotCF)
	local model = VehicleFactory.BuildCar(def)
	model:PivotTo(slotCF)
	local rarity = CarConfig.Rarities[def.rarity]
	local gui = Instance.new("BillboardGui")
	gui.Name = "Tag"
	gui.Size = UDim2.fromOffset(150, 40)
	gui.StudsOffset = Vector3.new(0, VehicleFactory.HeightOfModel(model, def.style) + 2, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 70
	gui.Adornee = model.PrimaryPart
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 14
	label.TextColor3 = rarity.color
	label.TextStrokeTransparency = 0.3
	label.Text = string.format("%s  Lv%d\n+%s/s", def.name, level, Util.FormatNumber(CarConfig.IncomeAt(def, level)))
	label.Parent = gui
	gui.Parent = model.PrimaryPart
	return model
end

function Base.RefreshAll(player)
	local s = S.Data.Get(player)
	if not s or not s.baseIndex then
		return
	end
	local b = bases[s.baseIndex]
	if not b or b.owner ~= player then
		return
	end
	local d = s.data
	local now = os.clock()
	local bySlot = {}
	for _, c in ipairs(d.cars) do
		if c.parkedSlot then
			bySlot[c.parkedSlot] = c
		end
	end
	for slot = 1, BaseLayout.SlotCount do
		local pad = b.pads[slot]
		local car = bySlot[slot]
		local hidden = car and s.hidden[car.uid] and s.hidden[car.uid] > now
		if slot > d.garageSlotCount then
			setPad(pad, "locked")
			car = nil
		elseif car and not hidden then
			local def = CarConfig.ById[car.typeId]
			setPad(pad, "occupied", CarConfig.Rarities[def.rarity].color)
		else
			setPad(pad, "free")
		end
		local want = (car and not hidden) and (car.uid .. ":" .. car.level) or nil
		if b.sig[slot] ~= want then
			if b.carModels[slot] then
				b.carModels[slot]:Destroy()
				b.carModels[slot] = nil
			end
			b.sig[slot] = want
			if want then
				local def = CarConfig.ById[car.typeId]
				local model = buildCarModel(def, car.level, BaseLayout.SlotCFrame(b.index, slot))
				model.Name = "Car_" .. slot
				model.Parent = b.cars
				b.carModels[slot] = model
			end
		end
	end
end

function Base.SetIncomeText(player, text)
	local s = S.Data.Get(player)
	if s and s.baseIndex and bases[s.baseIndex] then
		setLabel(bases[s.baseIndex].screen, text)
	end
end

return Base
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX30"><Properties><string name="Name">CaptureService</string><ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local BaseLayout = require(Shared:WaitForChild("BaseLayout"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))

local Capture = {}
local S
local rng = Random.new()

function Capture.Init(hub)
	S = hub
end

function Capture.Roll(partId, r1, r2, pity)
	return CarConfig.Roll(partId, pity or 0, r1, r2)
end

local function firstFreeSlot(d)
	local used = {}
	for _, c in ipairs(d.cars) do
		if c.parkedSlot then
			used[c.parkedSlot] = true
		end
	end
	for i = 1, d.garageSlotCount do
		if not used[i] then
			return i
		end
	end
	return nil
end

function Capture.Throw(player, partId)
	if type(partId) ~= "string" or not PartConfig.Parts[partId] then
		return
	end
	local s = S.Data.Get(player)
	if not s or not s.ready then
		return
	end
	if not S.Data.RateLimit(player, "throw", EconomyConfig.ThrowCooldown) then
		return
	end
	if s.busy then
		S.Data.Notify(player, "trapBusy", nil, "warn")
		return
	end
	if not s.baseIndex then
		S.Data.Notify(player, "noBase", nil, "error")
		return
	end
	local hrp = S.Data.GetRoot(player)
	if not hrp then
		return
	end
	local trap = BaseLayout.ToWorld(s.baseIndex, BaseLayout.TrapLocal)
	local flat = Vector3.new(hrp.Position.X - trap.X, 0, hrp.Position.Z - trap.Z)
	if flat.Magnitude > EconomyConfig.ThrowMaxDistance then
		S.Data.Notify(player, "tooFar", nil, "warn")
		return
	end
	local d = s.data
	if #d.cars >= EconomyConfig.MaxCars then
		S.Data.Notify(player, "storageFull", nil, "error")
		return
	end
	if not S.Inventory.HasBanked(s, partId, 1) then
		S.Data.Notify(player, "noPart", nil, "error")
		return
	end

	s.busy = true
	S.Inventory.SpendBanked(player, partId, 1)
	local pityUsed = d.pity >= EconomyConfig.PityThreshold - 1
	local rarity, def = Capture.Roll(partId, rng:NextNumber(), rng:NextNumber(), d.pity)
	if CarConfig.IsHighTier(rarity) then
		d.pity = 0
	else
		d.pity = d.pity + 1
	end
	local isNew = not d.discovered[def.id]
	local bonus = 0
	if isNew then
		d.discovered[def.id] = true
		bonus = CarConfig.DiscoverBonus(def)
		d.money = math.min(d.money + bonus, EconomyConfig.MaxMoney)
	end
	local uid = HttpService:GenerateGUID(false)
	local slot = firstFreeSlot(d)
	table.insert(d.cars, { uid = uid, typeId = def.id, level = 1, parkedSlot = slot })
	d.stats.throws = d.stats.throws + 1
	s.hidden[uid] = os.clock() + EconomyConfig.ThrowAnimTime + 0.1

	S.Income.Recalc(player)
	Net.Get("ThrowResult"):FireClient(player, {
		partId = partId, typeId = def.id, uid = uid, rarity = rarity, slot = slot,
		animTime = EconomyConfig.ThrowAnimTime, isNew = isNew, bonus = bonus, pityUsed = pityUsed,
	})
	S.Data.Push(player)

	task.delay(EconomyConfig.ThrowAnimTime + 0.15, function()
		s.busy = false
		s.hidden[uid] = nil
		if player.Parent then
			S.Base.RefreshAll(player)
		end
	end)
end

return Capture
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX31"><Properties><string name="Name">CarCollectionService</string><ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared:WaitForChild("Util"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))

local Cars = {}
local S

function Cars.Init(hub)
	S = hub
end

function Cars.Find(d, uid)
	for _, c in ipairs(d.cars) do
		if c.uid == uid then
			return c
		end
	end
	return nil
end

local function ctx(player, uid)
	if type(uid) ~= "string" or #uid > 64 then
		return nil
	end
	local s = S.Data.Get(player)
	if not s or not s.ready then
		return nil
	end
	if not S.Data.RateLimit(player, "cars", EconomyConfig.ActionCooldown) then
		return nil
	end
	if not S.Base.IsNearOwnBase(player) then
		S.Data.Notify(player, "tooFar", nil, "warn")
		return nil
	end
	return s
end

local function finish(player)
	S.Base.RefreshAll(player)
	S.Income.Recalc(player)
	S.Data.Push(player)
end

function Cars.Place(player, uid, slot)
	local s = ctx(player, uid)
	if not s or not Util.IsInt(slot) then
		return
	end
	local d = s.data
	if slot < 1 or slot > d.garageSlotCount then
		return
	end
	local car = Cars.Find(d, uid)
	if not car then
		return
	end
	local occupant
	for _, c in ipairs(d.cars) do
		if c ~= car and c.parkedSlot == slot then
			occupant = c
			break
		end
	end
	local oldSlot = car.parkedSlot
	car.parkedSlot = slot
	if occupant then
		occupant.parkedSlot = oldSlot
	end
	finish(player)
end

function Cars.Remove(player, uid)
	local s = ctx(player, uid)
	if not s then
		return
	end
	local car = Cars.Find(s.data, uid)
	if not car or not car.parkedSlot then
		return
	end
	car.parkedSlot = nil
	finish(player)
end

function Cars.Sell(player, uid)
	local s = ctx(player, uid)
	if not s then
		return
	end
	local d = s.data
	if s.hidden[uid] then
		S.Data.Notify(player, "busy", nil, "warn")
		return
	end
	local idx
	for i, c in ipairs(d.cars) do
		if c.uid == uid then
			idx = i
			break
		end
	end
	if not idx then
		return
	end
	local car = d.cars[idx]
	local def = CarConfig.ById[car.typeId]
	local price = CarConfig.SellPrice(def, car.level)
	table.remove(d.cars, idx)
	d.money = math.min(d.money + price, EconomyConfig.MaxMoney)
	d.stats.sold = (d.stats.sold or 0) + 1
	S.Data.Notify(player, "sold", { def.name, price }, "good")
	finish(player)
end

function Cars.AutoPark(player)
	local s = S.Data.Get(player)
	if not s or not s.ready then
		return
	end
	if not S.Data.RateLimit(player, "autopark", 1) then
		return
	end
	if not S.Base.IsNearOwnBase(player) then
		S.Data.Notify(player, "tooFar", nil, "warn")
		return
	end
	local d = s.data
	local list = {}
	for _, c in ipairs(d.cars) do
		if not s.hidden[c.uid] then
			table.insert(list, c)
		end
	end
	table.sort(list, function(a, b)
		local ia = CarConfig.IncomeAt(CarConfig.ById[a.typeId], a.level)
		local ib = CarConfig.IncomeAt(CarConfig.ById[b.typeId], b.level)
		if ia ~= ib then
			return ia > ib
		end
		return a.uid < b.uid
	end)
	local reserved = {}
	for _, c in ipairs(d.cars) do
		if s.hidden[c.uid] and c.parkedSlot then
			reserved[c.parkedSlot] = true
		end
	end
	local free = {}
	for i = 1, d.garageSlotCount do
		if not reserved[i] then
			table.insert(free, i)
		end
	end
	for i, c in ipairs(list) do
		c.parkedSlot = free[i]
	end
	S.Data.Notify(player, "autoParked", nil, "good")
	finish(player)
end

return Cars
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX32"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared:WaitForChild("Util"))
local Net = require(Shared:WaitForChild("Net"))
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))

local DataService = {}
local S

local STORE_NAME = "CarHunters_Profiles_v1"
local SCHEMA_VERSION = 2
local LOCK_TIMEOUT = 120
local SERVER_ID = (game.JobId ~= "" and game.JobId) or ("studio-" .. HttpService:GenerateGUID(false))

local store = nil
local sessions = {}

local function newProfile(isNew)
	local p = {
		schemaVersion = SCHEMA_VERSION,
		money = 0,
		parts = { bolts = 0, tire = 0, engine = 0, turbo = 0, core = 0 },
		unlockedZones = { city = true },
		garageSlotCount = EconomyConfig.StartSlots,
		cars = {},
		stats = { throws = 0, upgrades = 0, deaths = 0, sold = 0 },
		discovered = {},
		pity = 0,
		saveCount = 0,
	}
	if isNew then
		for id, n in pairs(EconomyConfig.StarterParts) do
			p.parts[id] = n
		end
	end
	return p
end

local function toCount(v, maxV)
	if type(v) == "number" and v == v and v >= 0 and v ~= math.huge then
		return math.min(math.floor(v), maxV)
	end
	return 0
end

local function sanitize(raw)
	if type(raw) ~= "table" then
		return newProfile(true)
	end
	local p = newProfile(false)

	p.money = math.min(toCount(raw.money, EconomyConfig.MaxMoney), EconomyConfig.MaxMoney)
	if type(raw.parts) == "table" then
		for id in pairs(PartConfig.Parts) do
			p.parts[id] = toCount(raw.parts[id], 1e6)
		end
	end
	if type(raw.unlockedZones) == "table" then
		for _, id in ipairs(require(Shared.MapConfig).ZoneOrder) do
			if raw.unlockedZones[id] == true then
				p.unlockedZones[id] = true
			end
		end
	end
	p.unlockedZones.city = true
	local slots = toCount(raw.garageSlotCount, EconomyConfig.MaxSlots)
	p.garageSlotCount = Util.Clamp(slots, EconomyConfig.StartSlots, EconomyConfig.MaxSlots)

	local seenUid, seenSlot = {}, {}
	if type(raw.cars) == "table" then
		for _, c in ipairs(raw.cars) do
			if #p.cars >= EconomyConfig.MaxCars then
				break
			end
			if type(c) == "table" and type(c.uid) == "string" and #c.uid >= 8 and #c.uid <= 64
				and not seenUid[c.uid] and CarConfig.ById[c.typeId] then
				seenUid[c.uid] = true
				local level = Util.Clamp(toCount(c.level, CarConfig.MaxLevel), 1, CarConfig.MaxLevel)
				local slot = nil
				if Util.IsInt(c.parkedSlot) and c.parkedSlot >= 1 and c.parkedSlot <= p.garageSlotCount and not seenSlot[c.parkedSlot] then
					slot = c.parkedSlot
					seenSlot[slot] = true
				end
				table.insert(p.cars, { uid = c.uid, typeId = c.typeId, level = level, parkedSlot = slot })
			end
		end
	end
	if type(raw.stats) == "table" then
		p.stats.throws = toCount(raw.stats.throws, 1e9)
		p.stats.upgrades = toCount(raw.stats.upgrades, 1e9)
		p.stats.deaths = toCount(raw.stats.deaths, 1e9)
		p.stats.sold = toCount(raw.stats.sold, 1e9)
	end
	if type(raw.discovered) == "table" then
		for id, v in pairs(raw.discovered) do
			if v == true and CarConfig.ById[id] then
				p.discovered[id] = true
			end
		end
	end
	for _, c in ipairs(p.cars) do
		p.discovered[c.typeId] = true
	end
	p.pity = math.min(toCount(raw.pity, 1e6), EconomyConfig.PityThreshold)
	p.saveCount = toCount(raw.saveCount, 1e12)
	return p
end
DataService.Sanitize = sanitize

local function keyFor(userId)
	return "P_" .. tostring(userId)
end

local function acquire(userId)
	local key = keyFor(userId)
	local lastErr = "unknown"
	for attempt = 1, 5 do
		local lockedByOther = false
		local loaded = nil
		local ok, err = pcall(function()
			store:UpdateAsync(key, function(old)
				lockedByOther = false
				loaded = nil
				if type(old) == "table" then
					local lock = old.lock
					if type(lock) == "table" and lock.id ~= SERVER_ID and os.time() - (tonumber(lock.time) or 0) < LOCK_TIMEOUT then
						lockedByOther = true
						return nil
					end
					loaded = old.data
					old.lock = { id = SERVER_ID, time = os.time() }
					return old
				end
				return { lock = { id = SERVER_ID, time = os.time() } }
			end)
		end)
		if ok then
			if lockedByOther then
				lastErr = "locked"
				task.wait(6)
			else
				return true, loaded
			end
		else
			lastErr = tostring(err)
			if RunService:IsStudio() then
				return false, "studio"
			end
			task.wait(math.min(2 ^ attempt, 8))
		end
	end
	return false, lastErr
end

function DataService.Init(hub)
	S = hub
end

function DataService.Start()
	local ok, res = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = res
	else
		warn("[CarHunters] DataStore unavailable:", res)
	end
	task.spawn(function()
		while true do
			task.wait(EconomyConfig.AutosaveInterval)
			for player, s in pairs(sessions) do
				if s.ready and not s.ephemeral and not s.saving then
					task.spawn(DataService.Save, player, false)
				end
			end
		end
	end)
end

function DataService.Get(player)
	return sessions[player]
end

function DataService.GetRoot(player)
	local char = player.Character
	if not char then
		return nil
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if hum and hum.Health > 0 and hrp then
		return hrp, hum
	end
	return nil
end

function DataService.Notify(player, key, args, kind)
	if player.Parent then
		Net.Get("Notify"):FireClient(player, { key = key, args = args or {}, kind = kind or "info" })
	end
end

function DataService.RateLimit(player, key, interval)
	local s = sessions[player]
	if not s then
		return false
	end
	local now = os.clock()
	if now - (s.rl[key] or 0) < interval then
		return false
	end
	s.rl[key] = now
	return true
end

function DataService.Load(player)
	local s = {
		player = player, ready = false, carried = {}, hidden = {}, rl = {}, income = 0, collectionValue = 0,
		moneyFrac = 0, busy = false, protectedUntil = 0, lastHit = 0, baseIndex = nil,
		ephemeral = false, loadFailed = false,
	}
	sessions[player] = s

	if not store then
		s.ephemeral = true
		s.data = newProfile(true)
		DataService.Notify(player, "studioNoSave", nil, "warn")
		return s
	end

	local ok, raw = acquire(player.UserId)
	if ok then
		s.data = sanitize(raw)
		s.locked = true
	elseif raw == "locked" then
		sessions[player] = nil
		player:Kick("Your data is open on another server. Please rejoin in a minute.")
		return nil
	elseif raw == "studio" then
		s.ephemeral = true
		s.data = newProfile(true)
		DataService.Notify(player, "studioNoSave", nil, "warn")
	else
		warn("[CarHunters] Profile load failed for", player.Name, raw)
		s.ephemeral = true
		s.loadFailed = true
		s.data = newProfile(true)
		DataService.Notify(player, "dataFail", nil, "error")
	end
	return s
end

local function snapshot(s, mergeCarried)
	local d = Util.CopyTable(s.data)
	if mergeCarried then
		for id, n in pairs(s.carried) do
			d.parts[id] = (d.parts[id] or 0) + n
		end
	end
	d.schemaVersion = SCHEMA_VERSION
	d.saveCount = (d.saveCount or 0) + 1
	return d
end

function DataService.Save(player, release)
	local s = sessions[player]
	if not s or not s.data or s.ephemeral or not store or not s.locked then
		return false
	end
	local waited = 0
	while s.saving and waited < 10 do
		task.wait(0.1)
		waited = waited + 0.1
	end
	s.saving = true
	local snap = snapshot(s, release)
	local key = keyFor(player.UserId)
	local success = false
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			store:UpdateAsync(key, function(old)
				if type(old) == "table" and type(old.lock) == "table" and old.lock.id ~= SERVER_ID
					and os.time() - (tonumber(old.lock.time) or 0) < LOCK_TIMEOUT then
					return nil
				end
				local out = { data = snap }
				if not release then
					out.lock = { id = SERVER_ID, time = os.time() }
				end
				return out
			end)
		end)
		if ok then
			success = true
			break
		end
		warn("[CarHunters] Save failed (" .. attempt .. "):", err)
		task.wait(2 ^ attempt)
	end
	s.saving = false
	if success then
		s.data.saveCount = snap.saveCount
	end
	return success
end

function DataService.SaveAll()
	local pending = 0
	for player, s in pairs(sessions) do
		if s.ready and not s.ephemeral then
			pending = pending + 1
			task.spawn(function()
				DataService.Save(player, true)
				pending = pending - 1
			end)
		end
	end
	local t = 0
	while pending > 0 and t < 25 do
		task.wait(0.2)
		t = t + 0.2
	end
end

function DataService.Unload(player)
	sessions[player] = nil
end

function DataService.BuildState(s)
	local d = s.data
	local cars = {}
	for _, c in ipairs(d.cars) do
		table.insert(cars, { uid = c.uid, typeId = c.typeId, level = c.level, slot = c.parkedSlot })
	end
	return {
		money = d.money,
		parts = Util.CopyTable(d.parts),
		carried = Util.CopyTable(s.carried),
		carryCap = EconomyConfig.CarryCapacity,
		zones = Util.CopyTable(d.unlockedZones),
		slots = d.garageSlotCount,
		cars = cars,
		stats = Util.CopyTable(d.stats),
		baseIndex = s.baseIndex,
		income = s.income,
		collectionValue = s.collectionValue,
		ephemeral = s.ephemeral,
		discovered = Util.CopyTable(d.discovered),
		pity = d.pity,
		indexMult = s.indexMult or 1,
	}
end

function DataService.Push(player)
	local s = sessions[player]
	if not s or s.pushQueued then
		return
	end
	s.pushQueued = true
	task.defer(function()
		s.pushQueued = false
		if player.Parent and s.data then
			Net.Get("StateUpdate"):FireClient(player, DataService.BuildState(s))
		end
	end)
end

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX33"><Properties><string name="Name">IncomeService</string><ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local Util = require(Shared:WaitForChild("Util"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))

local Income = {}
local S
local boardLabel

function Income.Init(hub)
	S = hub
end

function Income.CreateLeaderstats(player)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local inc = Instance.new("IntValue")
	inc.Name = "Income"
	inc.Parent = ls
	local col = Instance.new("IntValue")
	col.Name = "Collection"
	col.Parent = ls
	ls.Parent = player
end

function Income.Recalc(player)
	local s = S.Data.Get(player)
	if not s or not s.data then
		return
	end
	local inc, value = 0, 0
	for _, c in ipairs(s.data.cars) do
		local def = CarConfig.ById[c.typeId]
		if def then
			value = value + CarConfig.ValueAt(def, c.level)
			if c.parkedSlot then
				inc = inc + CarConfig.IncomeAt(def, c.level)
			end
		end
	end
	local _, _, _, mult = CarConfig.IndexStats(s.data.discovered or {})
	s.indexMult = mult
	s.income = math.floor(inc * mult + 0.5)
	s.collectionValue = value
	local ls = player:FindFirstChild("leaderstats")
	if ls then
		ls.Income.Value = math.min(inc, 2e9)
		ls.Collection.Value = math.min(value, 2e9)
	end
	S.Base.SetIncomeText(player, "+" .. Util.FormatNumber(s.income) .. "/s")
end

function Income.Start()
	local map = Workspace:FindFirstChild("GeneratedMap")
	local board = map and map:FindFirstChild("Leaderboard", true)
	if board then
		local gui = board:FindFirstChildWhichIsA("SurfaceGui", true)
		boardLabel = gui and gui:FindFirstChild("Rows")
	end
	local last = os.clock()
	local boardTimer = 0
	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.clock()
			local dt = now - last
			last = now
			boardTimer = boardTimer + dt
			for _, player in ipairs(Players:GetPlayers()) do
				local s = S.Data.Get(player)
				if s and s.ready then
					s.moneyFrac = s.moneyFrac + s.income * dt
					local whole = math.floor(s.moneyFrac)
					if whole > 0 then
						s.moneyFrac = s.moneyFrac - whole
						s.data.money = math.min(s.data.money + whole, EconomyConfig.MaxMoney)
					end
					Net.Get("MoneySync"):FireClient(player, s.data.money, s.income, s.collectionValue)
				end
			end
			if boardTimer >= 4 and boardLabel then
				boardTimer = 0
				local rows = {}
				for _, player in ipairs(Players:GetPlayers()) do
					local s = S.Data.Get(player)
					if s and s.ready then
						table.insert(rows, { name = player.DisplayName, inc = s.income })
					end
				end
				table.sort(rows, function(a, b)
					return a.inc > b.inc
				end)
				local lines = {}
				for i = 1, math.min(8, #rows) do
					table.insert(lines, string.format("%d. %s  +%s/s", i, rows[i].name, Util.FormatNumber(rows[i].inc)))
				end
				boardLabel.Text = table.concat(lines, "\n")
			end
		end
	end)
end

return Income
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX34"><Properties><string name="Name">InventoryService</string><ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))

local Inv = {}
local S

function Inv.Init(hub)
	S = hub
end

function Inv.CarriedTotal(s)
	local n = 0
	for _, v in pairs(s.carried) do
		n = n + v
	end
	return n
end

function Inv.BankedTotal(s)
	local n = 0
	for _, v in pairs(s.data.parts) do
		n = n + v
	end
	return n
end

function Inv.AddCarried(player, partId, n)
	local s = S.Data.Get(player)
	if not s or not s.ready or not PartConfig.Parts[partId] then
		return false
	end
	if Inv.CarriedTotal(s) + n > EconomyConfig.CarryCapacity then
		return false
	end
	s.carried[partId] = (s.carried[partId] or 0) + n
	S.Data.Push(player)
	return true
end

function Inv.Bank(player)
	local s = S.Data.Get(player)
	if not s or not s.ready then
		return false
	end
	local moved = 0
	for id, n in pairs(s.carried) do
		if n > 0 then
			s.data.parts[id] = (s.data.parts[id] or 0) + n
			moved = moved + n
		end
	end
	s.carried = {}
	if moved > 0 then
		S.Data.Notify(player, "banked", nil, "good")
		S.Data.Push(player)
	end
	return moved > 0
end

function Inv.HasBanked(s, partId, n)
	return (s.data.parts[partId] or 0) >= n
end

function Inv.SpendBanked(player, partId, n)
	local s = S.Data.Get(player)
	if not s or n <= 0 or (s.data.parts[partId] or 0) < n then
		return false
	end
	s.data.parts[partId] = s.data.parts[partId] - n
	return true
end

function Inv.OnDeath(player)
	local s = S.Data.Get(player)
	if not s or not s.ready then
		return
	end
	s.data.stats.deaths = s.data.stats.deaths + 1
	local lost = 0
	for id, n in pairs(s.carried) do
		local l = math.floor(n * EconomyConfig.DeathLossFraction + 0.5)
		if l > 0 then
			s.carried[id] = n - l
			lost = lost + l
		end
	end
	if lost > 0 then
		S.Data.Notify(player, "lost", { lost }, "error")
		S.Data.Push(player)
	end
end

function Inv.EnsureNotStuck(player)
	local s = S.Data.Get(player)
	if not s or not s.ready then
		return
	end
	local anyCar = #s.data.cars > 0
	if Inv.BankedTotal(s) + Inv.CarriedTotal(s) == 0 and not anyCar and s.data.money < 50 then
		s.data.parts.bolts = (s.data.parts.bolts or 0) + 1
		S.Data.Notify(player, "starter", nil, "good")
		S.Data.Push(player)
	end
end

function Inv.Start()
	task.spawn(function()
		while true do
			task.wait(0.5)
			for _, player in ipairs(Players:GetPlayers()) do
				local s = S.Data.Get(player)
				if s and s.ready and Inv.CarriedTotal(s) > 0 then
					local hrp = S.Data.GetRoot(player)
					if hrp and hrp.Position.Z < MapConfig.PlazaEndZ then
						Inv.Bank(player)
					end
				end
			end
		end
	end)
end

return Inv
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX35"><Properties><string name="Name">PartSpawnService</string><ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared:WaitForChild("Util"))
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local PartVisual = require(Shared:WaitForChild("PartVisual"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))

local PartSpawn = {}
local S
local points = {}
local rng = Random.new()
local drops

function PartSpawn.Init(hub)
	S = hub
end

local function cooldownFor(risk)
	local c = PartConfig.Cooldowns[risk] or PartConfig.Cooldowns.safe
	return c[1] + rng:NextNumber() * (c[2] - c[1])
end

local function spawnAt(pt)
	local zoneTables = PartConfig.SpawnTables[pt.zone]
	local entries = zoneTables and zoneTables[pt.risk]
	if not entries then
		return
	end
	local partId = Util.WeightedPick(entries, rng:NextNumber())
	local model = PartVisual.Build(partId)
	model:PivotTo(CFrame.new(pt.pos + Vector3.new(0, 3, 0)))
	model:SetAttribute("PointId", pt.id)
	CollectionService:AddTag(model, "SpinBob")
	model.Parent = drops
	pt.model = model
	pt.partId = partId
	pt.active = true
end

function PartSpawn.Start()
	drops = Workspace:FindFirstChild("RuntimeDrops")
	if not drops then
		drops = Instance.new("Folder")
		drops.Name = "RuntimeDrops"
		drops.Parent = Workspace
	end
	local map = Workspace:WaitForChild("GeneratedMap")
	local folder = map:WaitForChild("PartSpawnPoints")
	for _, inst in ipairs(folder:GetDescendants()) do
		if inst:IsA("BasePart") and inst:GetAttribute("ZoneId") then
			table.insert(points, {
				id = inst:GetFullName(), pos = inst.Position, zone = inst:GetAttribute("ZoneId"),
				risk = inst:GetAttribute("Risk") or "safe", active = false, readyAt = 0,
			})
		end
	end
	local now = os.clock()
	for _, pt in ipairs(points) do
		pt.readyAt = now + rng:NextNumber() * 5
	end

	local acc = 0
	local warnedAt = {}
	RunService.Heartbeat:Connect(function(dt)
		acc = acc + dt
		if acc < EconomyConfig.PickupCheckInterval then
			return
		end
		acc = 0
		local t = os.clock()
		for _, pt in ipairs(points) do
			if not pt.active and t >= pt.readyAt then
				spawnAt(pt)
			end
		end
		local r2 = EconomyConfig.PickupRadius * EconomyConfig.PickupRadius
		for _, player in ipairs(Players:GetPlayers()) do
			local s = S.Data.Get(player)
			if s and s.ready then
				local hrp = S.Data.GetRoot(player)
				if hrp then
					local pos = hrp.Position
					for _, pt in ipairs(points) do
						if pt.active then
							local d = pt.pos - pos
							if d.X * d.X + d.Z * d.Z <= r2 and math.abs(d.Y) < 12 then
								if S.Inventory.CarriedTotal(s) >= EconomyConfig.CarryCapacity then
									if t - (warnedAt[player] or 0) > 3 then
										warnedAt[player] = t
										S.Data.Notify(player, "carryFull", nil, "warn")
									end
								else
									pt.active = false
									local partId = pt.partId
									if pt.model then
										pt.model:Destroy()
										pt.model = nil
									end
									pt.readyAt = t + cooldownFor(pt.risk)
									if S.Inventory.AddCarried(player, partId, 1) then
										S.Data.Notify(player, "picked", { partId }, "pickup")
									end
								end
							end
						end
					end
				end
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(p)
		warnedAt[p] = nil
	end)
end

function PartSpawn.PointCount()
	return #points
end

return PartSpawn
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX36"><Properties><string name="Name">TrafficService</string><ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local Net = require(Shared:WaitForChild("Net"))
local TrafficMath = require(Shared:WaitForChild("TrafficMath"))
local VehicleKinds = require(Shared:WaitForChild("VehicleKinds"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))

local Traffic = {}
local S

function Traffic.Init(hub)
	S = hub
end

local function hitTest(pos, t, roadIdx)
	local road = MapConfig.Roads[roadIdx]
	local groundY = MapConfig.RoadTopY
	for _, lane in ipairs(TrafficMath.RoadLanes[roadIdx]) do
		local dz = math.abs(pos.Z - lane.z)
		if dz < 6 then
			for k = 1, lane.count do
				local kind = VehicleKinds[lane.kinds[k]]
				local x = TrafficMath.CarX(lane, k, t)
				local halfL = kind.L / 2 + 0.6
				local halfW = kind.W / 2 + 0.9
				if math.abs(pos.X - x) <= halfL and dz <= halfW and pos.Y < groundY + kind.H + 2.2 then
					return lane
				end
			end
		end
	end
	return nil
end

function Traffic.Start()
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc = acc + dt
		if acc < EconomyConfig.TrafficTickRate then
			return
		end
		acc = 0
		local t = Workspace:GetServerTimeNow()
		local now = os.clock()
		for _, player in ipairs(Players:GetPlayers()) do
			local s = S.Data.Get(player)
			if s and s.ready and now > s.protectedUntil and now - s.lastHit >= EconomyConfig.HitCooldown then
				local hrp, hum = S.Data.GetRoot(player)
				if hrp then
					local pos = hrp.Position
					local ri = TrafficMath.RoadAtZ(pos.Z, 2)
					if ri and math.abs(pos.X) <= MapConfig.MapHalfWidth + 6 then
						local lane = hitTest(pos, t, ri)
						if lane then
							s.lastHit = now
							local zone = MapConfig.Zones[MapConfig.Roads[ri].zone]
							local dmg = zone.hitDamage
							hum.Health = math.max(0, hum.Health - dmg)
							s.protectedUntil = now + 0.6
							Net.Get("HitFx"):FireClient(player, Vector3.new(lane.dir, 0, 0), dmg)
							if hum.Health > 0 then
								S.Data.Notify(player, "hit", nil, "error")
							end
						end
					end
				end
			end
		end
	end)
end

function Traffic.Protect(player, seconds)
	local s = S.Data.Get(player)
	if s then
		s.protectedUntil = math.max(s.protectedUntil, os.clock() + seconds)
	end
end

return Traffic
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX37"><Properties><string name="Name">UpgradeService</string><ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared:WaitForChild("Util"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))

local Upgrade = {}
local S

function Upgrade.Init(hub)
	S = hub
end

function Upgrade.UpgradeCar(player, uid, expectedLevel)
	if type(uid) ~= "string" or #uid > 64 or not Util.IsInt(expectedLevel) then
		return
	end
	local s = S.Data.Get(player)
	if not s or not s.ready then
		return
	end
	if not S.Data.RateLimit(player, "upgrade", 0.25) then
		return
	end
	if not S.Base.IsNearOwnBase(player) then
		S.Data.Notify(player, "tooFar", nil, "warn")
		return
	end
	local d = s.data
	local car = S.Cars.Find(d, uid)
	if not car then
		return
	end
	if car.level ~= expectedLevel then
		S.Data.Notify(player, "stale", nil, "warn")
		S.Data.Push(player)
		return
	end
	local def = CarConfig.ById[car.typeId]
	if car.level >= def.maxLevel then
		S.Data.Notify(player, "maxLevel", nil, "warn")
		return
	end
	local cost = CarConfig.UpgradeCost(def, car.level)
	local partId, amount = CarConfig.UpgradeParts(def, car.level)
	if d.money < cost then
		S.Data.Notify(player, "noMoney", nil, "error")
		return
	end
	if (d.parts[partId] or 0) < amount then
		S.Data.Notify(player, "noParts", nil, "error")
		return
	end
	d.money = d.money - cost
	d.parts[partId] = d.parts[partId] - amount
	car.level = car.level + 1
	d.stats.upgrades = d.stats.upgrades + 1
	S.Data.Notify(player, "upgraded", { car.level }, "good")
	S.Base.RefreshAll(player)
	S.Income.Recalc(player)
	S.Data.Push(player)
end

function Upgrade.BuySlot(player, expectedCount)
	if not Util.IsInt(expectedCount) then
		return
	end
	local s = S.Data.Get(player)
	if not s or not s.ready then
		return
	end
	if not S.Data.RateLimit(player, "slot", 0.4) then
		return
	end
	if not S.Base.IsNearOwnBase(player) then
		S.Data.Notify(player, "tooFar", nil, "warn")
		return
	end
	local d = s.data
	if d.garageSlotCount ~= expectedCount then
		S.Data.Notify(player, "stale", nil, "warn")
		S.Data.Push(player)
		return
	end
	local nextSlot = d.garageSlotCount + 1
	local cost = EconomyConfig.SlotCosts[nextSlot]
	if not cost or nextSlot > EconomyConfig.MaxSlots then
		return
	end
	if d.money < cost then
		S.Data.Notify(player, "noMoney", nil, "error")
		return
	end
	d.money = d.money - cost
	d.garageSlotCount = nextSlot
	S.Data.Notify(player, "slotBought", { nextSlot }, "good")
	S.Base.RefreshAll(player)
	S.Data.Push(player)
end

return Upgrade
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX38"><Properties><string name="Name">ZoneService</string><ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))

local Zone = {}
local S

function Zone.Init(hub)
	S = hub
end

function Zone.IsUnlocked(s, zoneId)
	return zoneId == "plaza" or s.data.unlockedZones[zoneId] == true
end

function Zone.Unlock(player, zoneId)
	if type(zoneId) ~= "string" or not MapConfig.Zones[zoneId] then
		return
	end
	local s = S.Data.Get(player)
	if not s or not s.ready then
		return
	end
	if not S.Data.RateLimit(player, "zone", 0.5) then
		return
	end
	local d = s.data
	if d.unlockedZones[zoneId] then
		return
	end
	local idx = MapConfig.ZoneIndex(zoneId)
	local prev = MapConfig.ZoneOrder[idx - 1]
	if not prev or not d.unlockedZones[prev] then
		S.Data.Notify(player, "needPrev", nil, "warn")
		return
	end
	local req = EconomyConfig.ZoneUnlock[zoneId]
	if not req then
		return
	end
	if s.collectionValue < req.minValue then
		S.Data.Notify(player, "needValue", nil, "warn")
		return
	end
	if d.money < req.cost then
		S.Data.Notify(player, "noMoney", nil, "error")
		return
	end
	d.money = d.money - req.cost
	d.unlockedZones[zoneId] = true
	S.Data.Notify(player, "zoneUnlocked", { MapConfig.Zones[zoneId].name }, "good")
	S.Data.Push(player)
end

function Zone.Start()
	task.spawn(function()
		while true do
			task.wait(0.25)
			for _, player in ipairs(Players:GetPlayers()) do
				local s = S.Data.Get(player)
				if s and s.ready then
					local hrp = S.Data.GetRoot(player)
					if hrp then
						local zone = MapConfig.ZoneAt(hrp.Position.Z)
						if not Zone.IsUnlocked(s, zone) then
							local gate = MapConfig.GateOfZone(zone)
							local p = hrp.Position
							hrp.CFrame = CFrame.new(p.X, p.Y + 1, gate.z - 14)
							hrp.AssemblyLinearVelocity = Vector3.zero
							S.Data.Notify(player, "zoneLocked", nil, "warn")
						end
					end
				end
			end
		end
	end)
end

return Zone
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerStorage" referent="RBX44"><Properties><string name="Name">ServerStorage</string></Properties><Item class="Folder" referent="RBX43"><Properties><string name="Name">Tools</string></Properties><Item class="ModuleScript" referent="RBX1001"><Properties><string name="Name">CarModelTool</string><ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local VehicleKinds = require(Shared:WaitForChild("VehicleKinds"))

local Tool = {}

local function ensure(parent, class, name)
	local o = parent:FindFirstChild(name)
	if not o then
		o = Instance.new(class)
		o.Name = name
		o.Parent = parent
	end
	return o
end

local function filled(m)
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			return true
		end
	end
	return false
end

function Tool.Setup()
	local root = ensure(ReplicatedStorage, "Folder", "CarModels")
	for _, def in ipairs(CarConfig.List) do
		local m = ensure(root, "Model", def.id)
		m:SetAttribute("CarName", def.name)
		m:SetAttribute("Rarity", def.rarity)
		if m:GetAttribute("Yaw") == nil then
			m:SetAttribute("Yaw", 0)
		end
	end
	local traffic = ensure(root, "Folder", "Traffic")
	for kind in pairs(VehicleKinds) do
		local m = ensure(traffic, "Model", kind)
		if m:GetAttribute("Yaw") == nil then
			m:SetAttribute("Yaw", 0)
		end
	end
	Tool.Status()
end

function Tool.Status()
	local root = ReplicatedStorage:FindFirstChild("CarModels")
	if not root then
		print("[CarModels] folder missing - run Setup()")
		return
	end
	local done, missing = 0, {}
	for _, def in ipairs(CarConfig.List) do
		local m = root:FindFirstChild(def.id)
		if m and filled(m) then
			done = done + 1
		else
			table.insert(missing, def.id)
		end
	end
	print(string.format("[CarModels] collection: %d/%d real models", done, #CarConfig.List))
	if #missing > 0 then
		print("[CarModels] procedural fallback for: " .. table.concat(missing, ", "))
	end
end

function Tool.Preview()
	local VehicleFactory = require(Shared:WaitForChild("VehicleFactory"))
	local old = Workspace:FindFirstChild("CarModelPreview")
	if old then
		old:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = "CarModelPreview"
	f.Parent = Workspace
	for i, def in ipairs(CarConfig.List) do
		local m = VehicleFactory.BuildCar(def)
		m.Name = def.id
		m:PivotTo(CFrame.new(-190 + ((i - 1) % 10) * 40, 0.5, 30 + math.floor((i - 1) / 10) * 30))
		m.Parent = f
	end
	print("[CarModels] preview built in Workspace.CarModelPreview (nose points +X). Fix direction with the Yaw attribute.")
end

function Tool.ClearPreview()
	local old = Workspace:FindFirstChild("CarModelPreview")
	if old then
		old:Destroy()
	end
end

return Tool
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX41"><Properties><string name="Name">BuildCityMap</string><ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local BaseLayout = require(Shared:WaitForChild("BaseLayout"))
local TrafficMath = require(Shared:WaitForChild("TrafficMath"))
local VehicleFactory = require(Shared:WaitForChild("VehicleFactory"))
local Prefabs = require(script.Parent:WaitForChild("MapPrefabs"))

local C = Color3.fromRGB
local M = Enum.Material
local Part, Label = Prefabs.Part, Prefabs.Label
local pick, rr = Prefabs.Pick, Prefabs.RR
local HW = MapConfig.MapHalfWidth
local CYL = Enum.PartType.Cylinder
local UPRIGHT = CFrame.Angles(0, 0, math.pi / 2)

local Build = {}

local TYPE_FOLDERS = { "Ground", "Roads", "Sidewalks", "Buildings", "StreetProps", "ZoneGates", "Bases", "TrafficRoutes", "PartSpawnPoints" }
local ALL_SECTIONS = { "World", "Plaza", "CITY", "HIGHWAY", "INDUSTRIAL", "NEON" }
local ZONE_OF = { CITY = "city", HIGHWAY = "highway", INDUSTRIAL = "industrial", NEON = "neon" }

local function getRoot()
	local root = Workspace:FindFirstChild("GeneratedMap")
	if not root then
		root = Instance.new("Folder")
		root.Name = "GeneratedMap"
		root.Parent = Workspace
	end
	for _, name in ipairs(TYPE_FOLDERS) do
		if not root:FindFirstChild(name) then
			local f = Instance.new("Folder")
			f.Name = name
			f.Parent = root
		end
	end
	return root
end

local function clearSection(root, section)
	for _, name in ipairs(TYPE_FOLDERS) do
		local sub = root[name]:FindFirstChild(section)
		if sub then
			sub:Destroy()
		end
	end
end

local function newFolders(section)
	local t = {}
	for _, name in ipairs(TYPE_FOLDERS) do
		local f = Instance.new("Folder")
		f.Name = section
		t[name] = f
	end
	return t
end

local function inFootprint(foot, x, z, margin)
	for _, r in ipairs(foot) do
		if x > r.x1 - margin and x < r.x2 + margin and z > r.z1 - margin and z < r.z2 + margin then
			return true
		end
	end
	return false
end

local WHITE = C(240, 240, 245)
local YELLOW = C(255, 205, 40)

local function buildWorld(ctx)
	local f = ctx.f
	local zS, zE = MapConfig.StartZ, MapConfig.EndZ
	Part(f.Ground, "WorldFloor", Vector3.new(2800, 2, zE - zS + 1400), CFrame.new(0, -2.2, (zS + zE) / 2), C(26, 28, 36), M.Concrete)

	local openings = {}
	for _, r in ipairs(MapConfig.Roads) do
		table.insert(openings, { r.z - r.width / 2, r.z + r.width / 2, r })
	end
	table.sort(openings, function(a, b) return a[1] < b[1] end)

	for _, sx in ipairs({ -1, 1 }) do
		local cursor = zS - 2
		local function seg(a, b)
			local len = b - a
			if len > 0.5 then
				local zm = (a + b) / 2
				local zone = MapConfig.ZoneAt(zm)
				local col = (zone == "plaza") and C(140, 146, 160) or MapConfig.Zones[zone].palette.curb
				Part(f.Buildings, "PerimeterWall", Vector3.new(4, 26, len), CFrame.new(sx * 302, 13, zm), col, M.Concrete)
				local acc = (zone == "plaza") and MapConfig.Plaza.accent or MapConfig.Zones[zone].palette.accent
				Part(f.Buildings, "WallTrim", Vector3.new(4.4, 0.6, len), CFrame.new(sx * 302, 26.3, zm), acc, M.Neon, { collide = false })
			end
		end
		for _, o in ipairs(openings) do
			seg(cursor, o[1])
			cursor = o[2]
			local W = o[3].width
			local z0 = o[3].z
			local zone = MapConfig.Zones[o[3].zone]
			Part(f.Buildings, "TunnelLintel", Vector3.new(4, 16, W), CFrame.new(sx * 302, 18, z0), zone.palette.curb, M.Concrete)
			Part(f.Buildings, "TunnelTrim", Vector3.new(4.4, 0.7, W), CFrame.new(sx * 302, 10.2, z0), zone.palette.accent, M.Neon, { collide = false })
			Part(f.Buildings, "TunnelCeiling", Vector3.new(60, 2, W + 8), CFrame.new(sx * 332, 11, z0), C(22, 22, 28), M.Concrete)
			Part(f.Buildings, "TunnelWallA", Vector3.new(60, 12, 2), CFrame.new(sx * 332, 6, z0 + W / 2 + 1), C(22, 22, 28), M.Concrete)
			Part(f.Buildings, "TunnelWallB", Vector3.new(60, 12, 2), CFrame.new(sx * 332, 6, z0 - W / 2 - 1), C(22, 22, 28), M.Concrete)
			Part(f.Buildings, "TunnelBlocker", Vector3.new(2, 16, W), CFrame.new(sx * 299, 8, z0), C(255, 255, 255), M.SmoothPlastic, { t = 1, cast = false })
		end
		seg(cursor, zE + 2)

		local z = zS
		while z < zE do
			local zone = MapConfig.ZoneAt(z)
			local pal = (zone == "plaza") and { buildings = { C(120, 130, 150), C(150, 160, 180) }, accent = C(80, 200, 255) } or MapConfig.Zones[zone].palette
			local w, d, h = rr(ctx.rng, 24, 44), rr(ctx.rng, 24, 40), rr(ctx.rng, 40, 100)
			local cx = sx * (392 + rr(ctx.rng, 0, 40))
			local tower = Part(f.Buildings, "Backdrop", Vector3.new(d, h, w), CFrame.new(cx, h / 2 - 1, z), pick(ctx.rng, pal.buildings), M.SmoothPlastic, { cast = false })
			Part(f.Buildings, "BackdropBand", Vector3.new(d + 0.3, 2, w * 0.8), CFrame.new(cx, h * 0.6, z), pal.accent, M.Neon, { cast = false, collide = false })
			z = z + 58 + rr(ctx.rng, 0, 14)
		end
	end
	local crng = ctx.rng
	for _ = 1, math.floor(44 * MapConfig.DecorationDensity + 10) do
		Prefabs.Cloud(f.StreetProps, Vector3.new(rr(crng, -520, 520), rr(crng, 150, 230), rr(crng, zS - 200, zE + 200)), crng)
	end
	Part(f.Buildings, "EndWallStart", Vector3.new(608, 26, 4), CFrame.new(0, 13, zS - 2), C(140, 146, 160), M.Concrete)
	Part(f.Buildings, "EndWallEnd", Vector3.new(608, 26, 4), CFrame.new(0, 13, zE + 2), C(60, 40, 110), M.Concrete)
	local fin = Part(f.Buildings, "EndSign", Vector3.new(120, 14, 1), CFrame.new(0, 19, zE - 0.5), C(10, 8, 20), M.SmoothPlastic)
	Label(fin, Enum.NormalId.Front, "END OF THE CITY", C(255, 60, 220))
end

local function buildBase(ctx, i)
	local f = ctx.f
	local P = MapConfig.Plaza
	local bcf = BaseLayout.GetBaseCFrame(i)
	local model = Instance.new("Model")
	model.Name = string.format("Base%02d", i)
	model:SetAttribute("Index", i)
	local function mk(name, size, off, color, mat, o)
		return Part(model, name, size, bcf * CFrame.new(off), color, mat, o)
	end

	mk("Floor", Vector3.new(110, 1, 95), Vector3.new(0, 0, 0), P.floor, M.SmoothPlastic)
	mk("EdgeFront", Vector3.new(0.6, 0.1, 95), Vector3.new(54.7, 0.55, 0), P.accent, M.Neon, { collide = false })
	mk("EdgeL", Vector3.new(110, 0.1, 0.6), Vector3.new(0, 0.55, 47.2), P.accent, M.Neon, { collide = false })
	mk("EdgeR", Vector3.new(110, 0.1, 0.6), Vector3.new(0, 0.55, -47.2), P.accent, M.Neon, { collide = false })
	mk("BackWall", Vector3.new(2, 14, 95), Vector3.new(-54, 7, 0), C(38, 40, 50), M.SmoothPlastic)
	mk("WallGlowTop", Vector3.new(2.2, 0.6, 95), Vector3.new(-54, 14.3, 0), P.accent, M.Neon, { collide = false })
	mk("GlassL", Vector3.new(110, 5, 0.6), Vector3.new(0, 3, 47.5), C(150, 205, 240), M.Glass, { t = 0.5 })
	mk("GlassR", Vector3.new(110, 5, 0.6), Vector3.new(0, 3, -47.5), C(150, 205, 240), M.Glass, { t = 0.5 })

	local sign = mk("OwnerSign", Vector3.new(1, 5, 34), Vector3.new(-53, 11.5, 0), C(14, 16, 24), M.SmoothPlastic)
	local l1 = Label(sign, Enum.NormalId.Right, "FREE GARAGE", C(255, 255, 255))
	local screen = mk("IncomeScreen", Vector3.new(1, 4.6, 24), Vector3.new(-53, 5.2, 0), C(10, 12, 18), M.SmoothPlastic)
	local l2 = Label(screen, Enum.NormalId.Right, "", C(90, 255, 140))

	local slots = Instance.new("Folder")
	slots.Name = "Slots"
	slots.Parent = model
	for n = 1, BaseLayout.SlotCount do
		local p = BaseLayout.SlotLocal(n)
		local pad = Part(slots, "Slot" .. n, Vector3.new(22, 0.2, 12), bcf * CFrame.new(p.X, 0.6, p.Z), C(45, 46, 54), M.SmoothPlastic, { collide = false })
		local num = Label(pad, Enum.NormalId.Top, tostring(n), C(255, 255, 255))
		num.TextTransparency = 0.55
		num.Rotation = 90
		mk("SlotLineA", Vector3.new(22, 0.06, 0.4), Vector3.new(p.X, 0.53, p.Z + 6.6), C(235, 235, 240), M.SmoothPlastic, { collide = false, cast = false })
		mk("SlotLineB", Vector3.new(22, 0.06, 0.4), Vector3.new(p.X, 0.53, p.Z - 6.6), C(235, 235, 240), M.SmoothPlastic, { collide = false, cast = false })
	end
	for z = -44, 44, 8 do
		mk("LaneDash", Vector3.new(0.5, 0.06, 4), Vector3.new(BaseLayout.LaneX, 0.53, z), C(255, 210, 70), M.SmoothPlastic, { collide = false, cast = false })
	end
	mk("Canopy", Vector3.new(44, 0.4, 95), Vector3.new(-30, 15.2, 0), C(200, 230, 255), M.Glass, { t = 0.6, collide = false })
	mk("CanopyFrameF", Vector3.new(1, 1, 95), Vector3.new(-8.5, 15.2, 0), C(40, 44, 56), M.Metal, { collide = false })
	for _, z in ipairs({ -46.5, 0, 46.5 }) do
		mk("CanopyBeam", Vector3.new(44, 1, 1), Vector3.new(-30, 15.2, z), C(40, 44, 56), M.Metal, { collide = false })
		mk("CanopyPost", Vector3.new(1, 14.6, 1), Vector3.new(-8.5, 7.8, z), C(40, 44, 56), M.Metal)
	end
	mk("CanopyGlow", Vector3.new(0.4, 0.3, 95), Vector3.new(-8.5, 14.5, 0), P.accent, M.Neon, { collide = false, cast = false })
	for _, z in ipairs({ -44, 44 }) do
		Prefabs.Planter(model, bcf:PointToWorldSpace(Vector3.new(46, 0.5, z * 0.82)), C(232, 226, 216))
	end

	local t = BaseLayout.TrapLocal
	local pad = mk("TrapPad", Vector3.new(0.5, 18, 18), Vector3.new(t.X, 0.75, t.Z), C(40, 230, 255), M.Neon, { shape = CYL, collide = false })
	pad.CFrame = bcf * CFrame.new(t.X, 0.75, t.Z) * UPRIGHT
	local inner = mk("TrapInner", Vector3.new(0.6, 11, 11), Vector3.new(t.X, 0.8, t.Z), C(18, 26, 44), M.SmoothPlastic, { shape = CYL, collide = false })
	inner.CFrame = bcf * CFrame.new(t.X, 0.8, t.Z) * UPRIGHT
	mk("TrapArchL", Vector3.new(1.6, 12, 1.6), Vector3.new(t.X, 6.5, t.Z + 9.5), C(200, 205, 215), M.Metal)
	mk("TrapArchR", Vector3.new(1.6, 12, 1.6), Vector3.new(t.X, 6.5, t.Z - 9.5), C(200, 205, 215), M.Metal)
	local top = mk("TrapArchTop", Vector3.new(1.6, 2.2, 21), Vector3.new(t.X, 13, t.Z), C(30, 34, 46), M.Metal)
	Label(top, Enum.NormalId.Right, "DROP PART", C(40, 230, 255))
	mk("TrapArchGlow", Vector3.new(1.0, 0.5, 19), Vector3.new(t.X, 11.7, t.Z), C(40, 230, 255), M.Neon, { collide = false })

	local pl = BaseLayout.PortalLocal
	mk("PortalL", Vector3.new(3, 14, 3), Vector3.new(pl.X, 7.5, pl.Z + 9.5), C(30, 34, 46), M.Metal)
	mk("PortalR", Vector3.new(3, 14, 3), Vector3.new(pl.X, 7.5, pl.Z - 9.5), C(30, 34, 46), M.Metal)
	local ptop = mk("PortalTop", Vector3.new(3, 3, 22), Vector3.new(pl.X, 15.5, pl.Z), C(30, 34, 46), M.Metal)
	Label(ptop, Enum.NormalId.Right, "VEHICLE ENTRANCE", C(255, 200, 60))
	mk("PortalField", Vector3.new(0.6, 12, 16), Vector3.new(pl.X, 7.5, pl.Z), C(255, 190, 40), M.Neon, { t = 0.78, collide = false })

	local tm = BaseLayout.TerminalLocal
	local term = mk("Terminal", Vector3.new(4, 8, 7), Vector3.new(tm.X, 4.5, tm.Z), C(30, 34, 46), M.Metal)
	Label(term, Enum.NormalId.Right, "GARAGE", C(255, 255, 255))
	mk("TerminalGlow", Vector3.new(4.2, 0.5, 7.2), Vector3.new(tm.X, 8.7, tm.Z), P.accent, M.Neon, { collide = false })

	local sp = Instance.new("SpawnLocation")
	sp.Name = "Spawn"
	sp.Size = Vector3.new(8, 0.4, 8)
	sp.CFrame = bcf * CFrame.new(BaseLayout.SpawnLocal.X, 0.7, BaseLayout.SpawnLocal.Z)
	sp.Anchored = true
	sp.Neutral = true
	sp.Duration = 0
	sp.Enabled = true
	sp.Transparency = 1
	sp.CanCollide = false
	sp.Parent = model
	Prefabs.Count = Prefabs.Count + 1

	local cars = Instance.new("Folder")
	cars.Name = "Cars"
	cars.Parent = model

	Prefabs.Lamp(model, bcf:PointToWorldSpace(Vector3.new(53, 0.5, 44)), 3, P.accent, 0)
	Prefabs.Lamp(model, bcf:PointToWorldSpace(Vector3.new(53, 0.5, -44)), 3, P.accent, 0)
	model.Parent = f.Bases
end

local function buildPlaza(ctx)
	local f = ctx.f
	local P = MapConfig.Plaza
	local zS, zE = MapConfig.StartZ, MapConfig.EntryZ
	local len = zE - zS
	local zm = (zS + zE) / 2
	Part(f.Ground, "PlazaGround", Vector3.new(600, 2, len), CFrame.new(0, -1, zm), P.ground, M.Grass)
	Part(f.Ground, "Promenade", Vector3.new(260, 0.4, len - 6), CFrame.new(0, 0, zm - 1), P.paving, M.Concrete)
	local band = 0
	for z = zS + 10, zE - 20, 20 do
		band = band + 1
		if band % 2 == 0 then
			Part(f.Ground, "PavingBand", Vector3.new(256, 0.06, 10), CFrame.new(0, 0.23, z), C(226, 218, 206), M.Concrete, { collide = false, cast = false })
		end
	end
	for _, s in ipairs({ -1, 1 }) do
		Part(f.Ground, "PromenadeEdge", Vector3.new(1.2, 0.5, len - 6), CFrame.new(s * 130, 0.25, zm - 1), C(250, 246, 238), M.Concrete, { collide = false })
	end
	for z = zS + 30, zE - 20, 26 do
		if math.abs(z + 150) > 24 then
			Part(f.Ground, "GuideDash", Vector3.new(1.2, 0.1, 12), CFrame.new(0, 0.25, z), P.accent, M.Neon, { collide = false })
		end
	end
	Prefabs.Fountain(f.StreetProps, Vector3.new(0, 0.2, -150), P.accent)
	for _, s in ipairs({ -1, 1 }) do
		for z = zS + 60, zE - 60, 100 do
			Prefabs.FlowerBed(f.StreetProps, Vector3.new(s * 40, 0.2, z), 12, 6, ctx.rng)
		end
		Prefabs.FlowerBed(f.StreetProps, Vector3.new(s * 26, 0.2, -150), 6, 16, ctx.rng)
	end

	for i = 1, MapConfig.BaseCount do
		buildBase(ctx, i)
	end

	for _, s in ipairs({ -1, 1 }) do
		Part(f.Buildings, "ArchPillar", Vector3.new(6, 24, 6), CFrame.new(s * 62, 12, MapConfig.EntryZ - 4), C(40, 44, 58), M.Metal)
		Part(f.Buildings, "ArchGlow", Vector3.new(1, 22, 1), CFrame.new(s * 58.8, 12, MapConfig.EntryZ - 7.2), P.accent, M.Neon, { collide = false })
	end
	local beam = Part(f.Buildings, "ArchBeam", Vector3.new(130, 6, 8), CFrame.new(0, 24, MapConfig.EntryZ - 4), C(20, 22, 32), M.Metal)
	Label(beam, Enum.NormalId.Front, "CAR HUNTERS", C(255, 210, 60))
	Label(beam, Enum.NormalId.Back, "SAFE PLAZA", C(80, 230, 255))
	Part(f.Buildings, "ArchTrim", Vector3.new(130, 0.6, 8.4), CFrame.new(0, 21.3, MapConfig.EntryZ - 4), P.accent, M.Neon, { collide = false })

	local legends = CarConfig.ByRarity.Legendary
	for k = 1, 3 do
		local x = (k - 2) * 62
		local pod = Part(f.StreetProps, "Podium", Vector3.new(1.2, 18, 18), CFrame.new(x, 0.8, -250) * UPRIGHT, C(30, 34, 46), M.Metal, { shape = CYL })
		Part(f.StreetProps, "PodiumRing", Vector3.new(0.3, 19, 19), CFrame.new(x, 1.45, -250) * UPRIGHT, legends[k].neon or P.accent, M.Neon, { shape = CYL, collide = false })
		local def = legends[k]
		local car = VehicleFactory.BuildCar(def)
		car:PivotTo(CFrame.new(x, 1.5, -250) * CFrame.Angles(0, math.rad(35 + k * 40), 0))
		car.Parent = f.StreetProps
		Prefabs.Count = Prefabs.Count + 1
	end
	local sb = Part(f.StreetProps, "ShowcaseSign", Vector3.new(40, 6, 1), CFrame.new(0, 14, -272), C(14, 16, 24), M.SmoothPlastic)
	Label(sb, Enum.NormalId.Front, "COLLECT THEM ALL", C(255, 210, 60))
	Part(f.StreetProps, "ShowcasePostL", Vector3.new(1, 12, 1), CFrame.new(-18, 6, -272), C(40, 44, 58), M.Metal)
	Part(f.StreetProps, "ShowcasePostR", Vector3.new(1, 12, 1), CFrame.new(18, 6, -272), C(40, 44, 58), M.Metal)

	Prefabs.DistrictSign(f.StreetProps, Vector3.new(-80, 0, 30), "GRAB PARTS IN THE CITY - BRING THEM BACK - THROW ON THE TRAP", C(30, 110, 200), 0)

	local lbPos = Vector3.new(86, 0, 38)
	Part(f.StreetProps, "LBPostL", Vector3.new(1, 12, 1), CFrame.new(lbPos.X - 15, 6, lbPos.Z), C(40, 44, 58), M.Metal)
	Part(f.StreetProps, "LBPostR", Vector3.new(1, 12, 1), CFrame.new(lbPos.X + 15, 6, lbPos.Z), C(40, 44, 58), M.Metal)
	local lb = Part(f.StreetProps, "Leaderboard", Vector3.new(36, 20, 1), CFrame.new(lbPos.X, 18, lbPos.Z), C(12, 14, 22), M.SmoothPlastic)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Gui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 24
	gui.LightInfluence = 0
	gui.Parent = lb
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Size = UDim2.fromScale(1, 0.18)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBlack
	title.TextScaled = true
	title.TextColor3 = C(255, 210, 60)
	title.Text = "TOP INCOME / SEC"
	title.Parent = gui
	local rows = Instance.new("TextLabel")
	rows.Name = "Rows"
	rows.Position = UDim2.fromScale(0.04, 0.2)
	rows.Size = UDim2.fromScale(0.92, 0.76)
	rows.BackgroundTransparency = 1
	rows.Font = Enum.Font.GothamBold
	rows.TextSize = 26
	rows.TextXAlignment = Enum.TextXAlignment.Left
	rows.TextYAlignment = Enum.TextYAlignment.Top
	rows.TextColor3 = C(255, 255, 255)
	rows.Text = ""
	rows.Parent = gui
	Part(f.StreetProps, "LBTrim", Vector3.new(37, 0.7, 1.4), CFrame.new(lbPos.X, 28.2, lbPos.Z), P.accent, M.Neon, { collide = false })

	local rng = ctx.rng
	local density = MapConfig.DecorationDensity
	local lampV = 1
	for z = zS + 20, zE - 20, 40 do
		for _, s in ipairs({ -1, 1 }) do
			Prefabs.Lamp(f.StreetProps, Vector3.new(s * 122, 0.4, z), lampV, P.accent, (s < 0) and 0 or math.pi)
		end
		lampV = lampV % 3 + 1
	end
	for z = zS + 40, zE - 40, 70 do
		for _, s in ipairs({ -1, 1 }) do
			if rng() < density + 0.2 then
				Prefabs.Tree(f.StreetProps, Vector3.new(s * (108 + rr(rng, 0, 12)), 0.4, z + rr(rng, -10, 10)), rng, "tree")
			end
			Prefabs.Bench(f.StreetProps, Vector3.new(s * 104, 0.4, z + 22), (s < 0) and math.pi / 2 or -math.pi / 2)
			if rng() < 0.5 then
				Prefabs.Planter(f.StreetProps, Vector3.new(s * 96, 0.4, z - 20), C(190, 180, 165))
			end
		end
	end
	for _, s in ipairs({ -1, 1 }) do
		for z = zS + 10, zE - 10, 60 do
			if rng() < density then
				Prefabs.Tree(f.StreetProps, Vector3.new(s * (252 + rr(rng, 0, 30)), 0, z), rng, "tree")
			end
		end
	end
end

local function buildGate(ctx, gate, zone)
	local f = ctx.f
	local pal = zone.palette
	local gz = gate.z
	local gw = MapConfig.GateHalfWidth
	local len = HW - gw
	for _, s in ipairs({ -1, 1 }) do
		Part(f.ZoneGates, "Fence", Vector3.new(len, 10, 4), CFrame.new(s * (gw + len / 2), 5, gz), pal.curb, M.Metal)
		Part(f.ZoneGates, "FenceNeon", Vector3.new(len, 0.6, 4.4), CFrame.new(s * (gw + len / 2), 10.3, gz), pal.accent, M.Neon, { collide = false })
		Part(f.ZoneGates, "GatePillar", Vector3.new(4, 20, 5), CFrame.new(s * (gw + 2), 10, gz), C(30, 34, 46), M.Metal)
	end
	local beam = Part(f.ZoneGates, "GateBeam", Vector3.new(2 * gw + 8, 4, 5), CFrame.new(0, 22, gz), C(20, 22, 32), M.Metal)
	Label(beam, Enum.NormalId.Front, zone.name, pal.accent)
	Label(beam, Enum.NormalId.Back, zone.name, pal.accent)
	local barrier = Part(f.ZoneGates, "GateBarrier_" .. zone.id, Vector3.new(2 * gw, 20, 1.5), CFrame.new(0, 10, gz), C(255, 60, 60), M.Neon, { t = 0.5 })
	barrier:SetAttribute("ZoneId", zone.id)
	CollectionService:AddTag(barrier, "ZoneGate")
	Label(barrier, Enum.NormalId.Front, "LOCKED", C(255, 255, 255))
	Label(barrier, Enum.NormalId.Back, "LOCKED", C(255, 255, 255))
end

local function buildEntryFence(ctx, zone)
	local f = ctx.f
	local pal = zone.palette
	local ez = MapConfig.EntryZ
	local ow = MapConfig.EntryHalfWidth
	local len = HW - ow
	for _, s in ipairs({ -1, 1 }) do
		Part(f.ZoneGates, "EntryFence", Vector3.new(len, 8, 3), CFrame.new(s * (ow + len / 2), 4, ez + 1.5), pal.curb, M.Metal)
		Part(f.ZoneGates, "EntryFenceNeon", Vector3.new(len, 0.5, 3.4), CFrame.new(s * (ow + len / 2), 8.2, ez + 1.5), pal.accent, M.Neon, { collide = false })
	end
end

local function buildRoad(ctx, road, pal, zid)
	local f = ctx.f
	local W, z0, len = road.width, road.z, TrafficMath.Length
	local M_ = road.median
	local rid = road.id
	Part(f.Roads, "Road" .. rid, Vector3.new(len, 0.4, W), CFrame.new(0, 0, z0), pal.road, M.Asphalt)
	for _, s in ipairs({ -1, 1 }) do
		Part(f.Roads, "EdgeLine", Vector3.new(len, 0.05, 0.5), CFrame.new(0, 0.22, z0 + s * (W / 2 - 0.8)), WHITE, M.SmoothPlastic, { collide = false, cast = false })
		Part(f.Roads, "MedianLine", Vector3.new(len, 0.05, 0.35), CFrame.new(0, 0.22, z0 + s * (M_ / 2 + 0.5)), YELLOW, M.SmoothPlastic, { collide = false, cast = false })
		Part(f.Sidewalks, "Sidewalk", Vector3.new(2 * HW, 1.6, MapConfig.SidewalkWidth), CFrame.new(0, 0, z0 + s * (W / 2 + MapConfig.SidewalkWidth / 2)), pal.sidewalk, M.Concrete)
		if zid == "neon" then
			Part(f.StreetProps, "NeonEdge", Vector3.new(2 * HW, 0.15, 0.3), CFrame.new(0, 0.86, z0 + s * (W / 2 + 0.2)), pal.accent, M.Neon, { collide = false, cast = false })
		end
		if road.lanesPerSide >= 2 then
			local zl = z0 + s * (M_ / 2 + road.laneWidth)
			for x = -HW + 6, HW - 6, 14 do
				Part(f.Roads, "Dash", Vector3.new(6, 0.05, 0.4), CFrame.new(x, 0.22, zl), WHITE, M.SmoothPlastic, { collide = false, cast = false })
			end
		end
	end
	Part(f.Sidewalks, "Median", Vector3.new(2 * HW, 1.6, M_), CFrame.new(0, 0, z0), pal.curb, M.Concrete)
	local top = (zid == "neon") and C(50, 40, 90) or ((zid == "industrial") and C(130, 120, 100) or C(96, 160, 90))
	Part(f.Sidewalks, "MedianTop", Vector3.new(2 * HW - 4, 0.1, M_ - 1.4), CFrame.new(0, 0.85, z0), top, (zid == "city" or zid == "highway") and M.Grass or M.Concrete)

	for ri, lane in ipairs(TrafficMath.RoadLanes[rid]) do
		for _, x in ipairs({ -225, -75, 75, 225 }) do
			for _, s in ipairs({ -1, 1 }) do
				Part(f.Roads, "Arrow", Vector3.new(3.5, 0.05, 0.5), CFrame.new(x, 0.23, lane.z + s * 0.9) * CFrame.Angles(0, math.atan2(-s * 1.8, -3 * lane.dir), 0), WHITE, M.SmoothPlastic, { collide = false, cast = false })
			end
		end
		local sx = TrafficMath.MinX * lane.dir
		local a = Part(f.TrafficRoutes, string.format("Road%02d_Lane%d_Start", rid, ri), Vector3.new(1, 1, 1), CFrame.new(sx, 1, lane.z), C(255, 255, 255), M.SmoothPlastic, { t = 1, collide = false })
		local b = Part(f.TrafficRoutes, string.format("Road%02d_Lane%d_End", rid, ri), Vector3.new(1, 1, 1), CFrame.new(-sx, 1, lane.z), C(255, 255, 255), M.SmoothPlastic, { t = 1, collide = false })
		for _, n in ipairs({ a, b }) do
			n:SetAttribute("RoadId", rid)
			n:SetAttribute("Dir", lane.dir)
			n:SetAttribute("Speed", math.floor(lane.speed * 10) / 10)
		end
	end
	for _, x in ipairs({ -150, 0, 150 }) do
		for _, s in ipairs({ -1, 1 }) do
			local zs = z0 + s * (M_ / 2 + 1.6)
			while math.abs(zs - z0) < W / 2 - 1 do
				Part(f.Roads, "Zebra", Vector3.new(7, 0.06, 1.6), CFrame.new(x, 0.24, zs), WHITE, M.SmoothPlastic, { collide = false, cast = false })
				zs = zs + s * 3.2
			end
		end
	end
	local v = 1
	for x = -270, 270, 60 do
		for _, s in ipairs({ -1, 1 }) do
			Prefabs.Lamp(f.StreetProps, Vector3.new(x + s * 30, 0.8, z0 + s * (W / 2 + 1.6)), v, pal.accent, (s < 0) and (-math.pi / 2) or (math.pi / 2))
		end
		v = v % 3 + 1
	end
	for x = -250, 250, 50 do
		if ctx.rng() < MapConfig.DecorationDensity + 0.15 then
			if zid == "neon" then
				Prefabs.Lamp(f.StreetProps, Vector3.new(x, 0.8, z0), 3, pal.accent2, 0)
			elseif zid == "industrial" or zid == "highway" then
				Part(f.StreetProps, "Barrier", Vector3.new(7, 1.6, 1.6), CFrame.new(x, 1.6, z0), (zid == "highway") and C(190, 192, 200) or C(240, 190, 40), M.Concrete)
			else
				Prefabs.Tree(f.StreetProps, Vector3.new(x, 0.8, z0), ctx.rng, "tree")
			end
		end
	end
	for _, x in ipairs({ -150, 0, 150 }) do
		for _, s in ipairs({ -1, 1 }) do
			Prefabs.TrafficLight(f.StreetProps, Vector3.new(x + s * 6, 0.8, z0 + s * (W / 2 + 4.6)), (s < 0) and math.pi or 0)
		end
	end
	local srng = ctx.rng
	for x = -260, 260, 65 do
		for _, s in ipairs({ -1, 1 }) do
			local px = x + rr(srng, -8, 8)
			if math.abs(px) > 12 and math.abs(math.abs(px) - 150) > 10 then
				local pz = z0 + s * (W / 2 + 4.8)
				local roll = srng()
				if zid == "city" or zid == "highway" then
					if roll < 0.4 then
						Prefabs.Hydrant(f.StreetProps, Vector3.new(px, 0.8, pz))
					elseif roll < 0.75 then
						Prefabs.Bin(f.StreetProps, Vector3.new(px, 0.8, pz), pal.accent2)
					end
				elseif zid == "industrial" then
					if roll < 0.6 then
						Prefabs.Cone(f.StreetProps, Vector3.new(px, 0.8, pz))
					end
				elseif roll < 0.5 then
					Prefabs.Bin(f.StreetProps, Vector3.new(px, 0.8, pz), pal.accent)
				end
			end
		end
	end
	if zid == "city" then
		for _, s in ipairs({ -1, 1 }) do
			Prefabs.BusStop(f.StreetProps, Vector3.new(s * 225, 0.8, z0 + s * (W / 2 + 4)), (s < 0) and math.pi or 0, pal.accent2)
		end
	elseif zid == "highway" then
		Prefabs.Gantry(f.StreetProps, -205, z0, W, "NEXT EXIT  >>  INDUSTRIAL", pal.accent)
		Prefabs.Gantry(f.StreetProps, 205, z0, W, "<<  CITY CENTER", pal.accent)
	elseif zid == "industrial" then
		for x = -240, 240, 80 do
			Prefabs.Cone(f.StreetProps, Vector3.new(x + 20, 0.8, z0 + M_ / 2 - 1.2))
			Prefabs.Cone(f.StreetProps, Vector3.new(x - 20, 0.8, z0 - M_ / 2 + 1.2))
		end
	elseif zid == "neon" then
		for x = -240, 240, 80 do
			Prefabs.HoloRing(f.StreetProps, Vector3.new(x, 16, z0), (x % 160 == 0) and pal.accent or pal.accent2, 12)
		end
	end
	if zid == "highway" then
		for _, s in ipairs({ -1, 1 }) do
			local x = s * 75
			Part(f.Buildings, "OverpassDeck", Vector3.new(14, 2, W + 28), CFrame.new(x, 16, z0), C(150, 154, 162), M.Concrete)
			Part(f.Buildings, "OverpassRailA", Vector3.new(0.6, 1.4, W + 28), CFrame.new(x - 6.7, 17.7, z0), pal.accent, M.Neon, { collide = false })
			Part(f.Buildings, "OverpassRailB", Vector3.new(0.6, 1.4, W + 28), CFrame.new(x + 6.7, 17.7, z0), pal.accent, M.Neon, { collide = false })
			for _, k in ipairs({ -1, 1 }) do
				Part(f.Buildings, "OverpassPillar", Vector3.new(6, 15, 6), CFrame.new(x, 7.5, z0 + k * (W / 2 + 12)), C(130, 134, 142), M.Concrete)
			end
		end
	end
end

local function placeBlock(ctx, blk, pal, zid)
	local f = ctx.f
	local rng = ctx.rng
	local zA, zB = blk[1], blk[2]
	local depth = zB - zA
	local rows = {}
	local rd = math.max(0, math.min(34, (depth - 24) / 2))
	if rd >= 12 then
		rows = { { dir = 1, edge = zA }, { dir = -1, edge = zB } }
	elseif depth >= 40 then
		rd = math.min(24, depth - 20)
		rows = { { dir = 1, edge = zB, back = true } }
	end
	local arche = Prefabs.Archetypes[zid]
	for _, row in ipairs(rows) do
		for _, side in ipairs({ -1, 1 }) do
			local cursor = HW - 10
			local guard = 0
			while guard < 12 do
				guard = guard + 1
				local a = pick(rng, arche)
				local w = rr(rng, a[2], a[3])
				if cursor - w < 94 then break end
				local d = math.max(12, rd - rr(rng, 0, 3))
				local h = rr(rng, a[4], a[5])
				local cx = side * (cursor - w / 2)
				local zc, yaw
				if row.back then
					zc = row.edge - d / 2
					yaw = 0
				elseif row.dir == 1 then
					zc = row.edge + d / 2
					yaw = 0
				else
					zc = row.edge - d / 2
					yaw = math.pi
				end
				if a[1] == "billboard" then d = 8 end
				local cf = CFrame.new(cx, 0.4, zc) * CFrame.Angles(0, yaw, 0)
				local model = Instance.new("Model")
				model.Name = a[1]
				Prefabs.Building(a[1], model, cf, w, d, h, pal, rng)
				model.Parent = f.Buildings
				table.insert(ctx.foot, { x1 = cx - w / 2, x2 = cx + w / 2, z1 = zc - d / 2, z2 = zc + d / 2 })
				cursor = cursor - w - rr(rng, 4, 8)
			end
		end
	end

	local pathCol = (zid == "neon") and C(44, 36, 78) or ((zid == "industrial") and C(150, 142, 128) or pal.sidewalk)
	Part(f.Ground, "BlockPath", Vector3.new(26, 0.12, depth), CFrame.new(0, 0.06, (zA + zB) / 2), pathCol, M.Concrete, { collide = false })
	for _, s in ipairs({ -1, 1 }) do
		Part(f.Ground, "BlockPathEdge", Vector3.new(0.8, 0.16, depth), CFrame.new(s * 13.4, 0.08, (zA + zB) / 2), (zid == "neon") and pal.accent or C(250, 246, 238), (zid == "neon") and M.Neon or M.Concrete, { collide = false, cast = false })
	end
	if depth > 50 then
		if zid == "city" or zid == "highway" then
			for _, s in ipairs({ -1, 1 }) do
				Prefabs.FlowerBed(f.StreetProps, Vector3.new(s * 22, 0, zA + depth * 0.3), 6, 10, rng)
				Prefabs.Hedge(f.StreetProps, CFrame.new(s * 70, 0, zA + depth * 0.65) * CFrame.Angles(0, math.pi / 2, 0), 14)
				table.insert(ctx.foot, { x1 = s * 70 - 1.5, x2 = s * 70 + 1.5, z1 = zA + depth * 0.65 - 7, z2 = zA + depth * 0.65 + 7 })
				table.insert(ctx.foot, { x1 = s * 22 - 3, x2 = s * 22 + 3, z1 = zA + depth * 0.3 - 5, z2 = zA + depth * 0.3 + 5 })
			end
		elseif zid == "industrial" then
			local fx = rr(rng, 40, 70) * (rng() < 0.5 and -1 or 1)
			local fz = zA + depth * 0.5
			Prefabs.Forklift(f.StreetProps, Vector3.new(fx, 0, fz), rr(rng, 0, math.pi * 2))
			table.insert(ctx.foot, { x1 = fx - 6, x2 = fx + 6, z1 = fz - 6, z2 = fz + 6 })
			for k = 1, 3 do
				local px, pz = -fx + rr(rng, -10, 10), zA + depth * (0.25 + k * 0.15)
				Prefabs.Pallet(f.StreetProps, Vector3.new(px, 0, pz), rr(rng, 0, 1), rng)
				table.insert(ctx.foot, { x1 = px - 3, x2 = px + 3, z1 = pz - 3, z2 = pz + 3 })
			end
		end
	end
	local rngd = MapConfig.DecorationDensity
	local n = math.floor(depth / 14 * rngd)
	for _ = 1, n do
		local x = rr(rng, -85, 85)
		local z = rr(rng, zA + 6, zB - 6)
		if zid == "neon" then
			Part(f.StreetProps, "NeonPost", Vector3.new(0.8, 6, 0.8), CFrame.new(x, 3.4, z), pal.curb, M.Metal)
			Part(f.StreetProps, "NeonOrb", Vector3.new(1.8, 1.8, 1.8), CFrame.new(x, 6.8, z), pick(rng, { pal.accent, pal.accent2 }), M.Neon, { shape = Enum.PartType.Ball, collide = false })
		elseif zid == "industrial" then
			Part(f.StreetProps, "Barrel", Vector3.new(3, 3.6, 3), CFrame.new(x, 2.2, z), pick(rng, { C(200, 70, 50), C(70, 110, 190) }), M.Metal, { shape = CYL }).CFrame = CFrame.new(x, 2.2, z) * UPRIGHT
		else
			Prefabs.Tree(f.StreetProps, Vector3.new(x, 0.4, z), rng, (zid == "highway") and "palm" or "tree")
		end
	end
	for _ = 1, math.floor(depth / 45) do
		Prefabs.Bench(f.StreetProps, Vector3.new(rr(rng, -70, 70), 0.4, rr(rng, zA + 10, zB - 10)), rr(rng, 0, math.pi * 2))
	end
	if zid == "city" and depth > 60 then
		Prefabs.Kiosk(f.StreetProps, Vector3.new(rr(rng, -50, 50), 0.4, (zA + zB) / 2), 0, pick(rng, pal.buildings), "SNACKS")
	end
	if zid == "neon" then
		local zc = (zA + zB) / 2
		for _, s in ipairs({ -1, 1 }) do
			Part(f.StreetProps, "NeonArchPillar", Vector3.new(2, 18, 2), CFrame.new(s * 42, 9, zc), C(30, 24, 60), M.Metal)
			Part(f.StreetProps, "NeonArchGlow", Vector3.new(0.5, 18, 0.5), CFrame.new(s * 42 - s * 1.1, 9, zc), pal.accent, M.Neon, { collide = false })
		end
		Part(f.StreetProps, "NeonArchTop", Vector3.new(86, 2, 3), CFrame.new(0, 19, zc), C(30, 24, 60), M.Metal)
		Part(f.StreetProps, "NeonArchTopGlow", Vector3.new(86, 0.5, 3.4), CFrame.new(0, 17.8, zc), pal.accent2, M.Neon, { collide = false })
	end
end

local function genSpawnPoints(ctx, zid, blocks, roads)
	local f = ctx.f
	local rng = ctx.rng
	local pal = MapConfig.Zones[zid].palette
	local counts = PartConfig.PointCounts[zid]
	local placed = {}
	local idc = 0
	local function addPoint(x, y, z, risk)
		idc = idc + 1
		local p = Part(f.PartSpawnPoints, string.format("SP_%s_%s_%02d", zid, risk, idc), Vector3.new(2, 0.4, 2), CFrame.new(x, y + 0.2, z), (risk == "risky") and C(255, 80, 80) or C(80, 255, 140), M.Neon, { t = 0.85, collide = false })
		p:SetAttribute("ZoneId", zid)
		p:SetAttribute("Risk", risk)
		table.insert(placed, { x = x, z = z })
	end
	local function farFromOthers(x, z, minD)
		for _, p in ipairs(placed) do
			local dx, dz = p.x - x, p.z - z
			if dx * dx + dz * dz < minD * minD then return false end
		end
		return true
	end

	local xs = { -210, -90, 90, 210 }
	local rcount = 0
	for _, r in ipairs(roads) do
		for _, x in ipairs(xs) do
			if rcount < counts.risky then
				addPoint(x + rr(rng, -12, 12), MapConfig.SidewalkTopY, r.z, "risky")
				rcount = rcount + 1
			end
		end
	end

	local safe = 0
	if zid == "city" then
		for k = 1, 4 do
			addPoint(-60 + (k - 1) * 40 + rr(rng, -6, 6), 0, 104 + rr(rng, 6, 60), "safe")
			safe = safe + 1
		end
	end
	local tries = 0
	while safe < counts.safe and tries < 600 do
		tries = tries + 1
		local blk = blocks[math.floor(rng() * #blocks) + 1]
		local x = rr(rng, -270, 270)
		local z = rr(rng, blk[1] + 5, blk[2] - 5)
		if not inFootprint(ctx.foot, x, z, 5) and farFromOthers(x, z, 24) then
			addPoint(x, 0, z, "safe")
			safe = safe + 1
		end
	end
end

local function buildZone(ctx, zid)
	local f = ctx.f
	local zone = MapConfig.Zones[zid]
	local pal = zone.palette
	local gate = MapConfig.GateOfZone(zid)
	local zStart = gate and gate.z or MapConfig.EntryZ
	local zEnd = MapConfig.EndZ
	for _, g in ipairs(MapConfig.Gates) do
		if g.z > zStart then
			zEnd = g.z
			break
		end
	end
	local ground = (zid == "industrial" or zid == "neon") and M.Concrete or M.Grass
	Part(f.Ground, "Ground_" .. zid, Vector3.new(600, 2, zEnd - zStart), CFrame.new(0, -1, (zStart + zEnd) / 2), pal.ground, ground)

	if gate then
		buildGate(ctx, gate, zone)
	else
		buildEntryFence(ctx, zone)
	end

	local roads = {}
	for _, rid in ipairs(zone.roads) do
		local r = MapConfig.Roads[rid]
		table.insert(roads, r)
		buildRoad(ctx, r, pal, zid)
	end

	local blocks = {}
	local prev = (zid == "city") and 100 or zone.zMin
	for _, r in ipairs(roads) do
		local lo = r.z - r.width / 2 - MapConfig.SidewalkWidth
		local hi = r.z + r.width / 2 + MapConfig.SidewalkWidth
		table.insert(blocks, { prev, lo })
		prev = hi
	end
	table.insert(blocks, { prev, zone.zMax })
	for _, blk in ipairs(blocks) do
		placeBlock(ctx, blk, pal, zid)
	end

	Prefabs.DistrictSign(f.StreetProps, Vector3.new(-45, 0.4, blocks[1][1] + 10), zone.name, pal.accent2 or pal.accent, 0)
	if zid == "industrial" then
		Prefabs.Crane(f.Buildings, Vector3.new(-330, 0, (zone.zMin + zone.zMax) / 2 - 60), 0, pal.accent2)
		Prefabs.Crane(f.Buildings, Vector3.new(330, 0, (zone.zMin + zone.zMax) / 2 + 60), math.pi, pal.accent)
	elseif zid == "neon" then
		for k = 1, 6 do
			Prefabs.HoloRing(f.StreetProps, Vector3.new(((k % 2 == 0) and 1 or -1) * rr(ctx.rng, 20, 80), rr(ctx.rng, 24, 40), zone.zMin + k * 48), (k % 2 == 0) and pal.accent or pal.accent2, rr(ctx.rng, 10, 18))
		end
	end
	genSpawnPoints(ctx, zid, blocks, roads)
end

function Build.Build(opts)
	opts = opts or {}
	local seed = opts.seed or MapConfig.Seed
	local sections = opts.sections or ALL_SECTIONS
	local root = getRoot()
	local started = os.clock()
	Prefabs.Count = 0
	local summary = {}
	for idx, section in ipairs(sections) do
		clearSection(root, section)
		local ctx = { f = newFolders(section), rng = TrafficMath.NewRng(seed + idx * 1009), foot = {} }
		local before = Prefabs.Count
		if section == "World" then
			buildWorld(ctx)
		elseif section == "Plaza" then
			buildPlaza(ctx)
		elseif ZONE_OF[section] then
			buildZone(ctx, ZONE_OF[section])
		else
			warn("[BuildCityMap] unknown section:", section)
		end
		for _, name in ipairs(TYPE_FOLDERS) do
			ctx.f[name].Parent = root[name]
		end
		summary[section] = Prefabs.Count - before
	end
	if not opts.quiet then
		local parts = {}
		for _, s in ipairs(sections) do
			table.insert(parts, s .. "=" .. tostring(summary[s]))
		end
		print(string.format("[BuildCityMap] done in %.2fs, seed=%d, parts: %s (total %d)", os.clock() - started, seed, table.concat(parts, ", "), Prefabs.Count))
	end
	return summary
end

return Build
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX42"><Properties><string name="Name">MapPrefabs</string><ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local VehicleFactory = require(Shared:WaitForChild("VehicleFactory"))

local C = Color3.fromRGB
local M = Enum.Material

local Prefabs = {}
Prefabs.Count = 0

local GLASS = C(150, 205, 240)
local DARK = C(34, 36, 44)

function Prefabs.Part(parent, name, size, cf, color, mat, o)
	o = o or {}
	local p = Instance.new(o.class or "Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Anchored = true
	p.Color = color
	p.Material = mat or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if o.t then p.Transparency = o.t end
	if o.collide == false then
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
	end
	if o.shape then p.Shape = o.shape end
	if o.refl then p.Reflectance = o.refl end
	if o.cast == false then p.CastShadow = false end
	p.Parent = parent
	Prefabs.Count = Prefabs.Count + 1
	return p
end
local Part = Prefabs.Part

function Prefabs.Label(part, face, text, textColor, bg)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Gui"
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 24
	gui.LightInfluence = 0
	gui.Parent = part
	local l = Instance.new("TextLabel")
	l.Name = "Label"
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = bg and 0 or 1
	if bg then l.BackgroundColor3 = bg end
	l.TextColor3 = textColor or C(255, 255, 255)
	l.Font = Enum.Font.GothamBlack
	l.TextScaled = true
	l.Text = text
	l.Parent = gui
	return l
end
local Label = Prefabs.Label

local function pick(rng, list)
	return list[math.floor(rng() * #list) + 1]
end
local function rr(rng, a, b)
	return a + (b - a) * rng()
end
Prefabs.Pick = pick
Prefabs.RR = rr

local CYL = Enum.PartType.Cylinder
local BALL = Enum.PartType.Ball
local UPRIGHT = CFrame.Angles(0, 0, math.pi / 2)

function Prefabs.Lamp(parent, pos, variant, glow, facing)
	local cf = CFrame.new(pos) * CFrame.Angles(0, facing or 0, 0)
	if variant == 1 then
		Part(parent, "LampPole", Vector3.new(0.7, 12, 0.7), cf * CFrame.new(0, 6, 0), DARK, M.Metal)
		Part(parent, "LampArm", Vector3.new(4, 0.5, 0.5), cf * CFrame.new(2, 12, 0), DARK, M.Metal)
		Part(parent, "LampHead", Vector3.new(1.8, 0.6, 1.2), cf * CFrame.new(4, 11.7, 0), glow, M.Neon)
	elseif variant == 2 then
		Part(parent, "LampPole", Vector3.new(0.8, 13, 0.8), cf * CFrame.new(0, 6.5, 0), DARK, M.Metal)
		Part(parent, "LampArmL", Vector3.new(7, 0.5, 0.5), cf * CFrame.new(0, 13, 0) * CFrame.Angles(0, math.pi / 2, 0), DARK, M.Metal)
		Part(parent, "LampHeadL", Vector3.new(1.4, 0.5, 1.4), cf * CFrame.new(0, 12.7, 3.4), glow, M.Neon)
		Part(parent, "LampHeadR", Vector3.new(1.4, 0.5, 1.4), cf * CFrame.new(0, 12.7, -3.4), glow, M.Neon)
	else
		Part(parent, "LampPole", Vector3.new(0.6, 8, 0.6), cf * CFrame.new(0, 4, 0), DARK, M.Metal)
		Part(parent, "LampGlobe", Vector3.new(2.4, 2.4, 2.4), cf * CFrame.new(0, 9.2, 0), glow, M.Neon, { shape = BALL, t = 0.1 })
	end
end

function Prefabs.Tree(parent, pos, rng, variant)
	local h = rr(rng, 6, 9)
	if variant == "palm" then
		Part(parent, "Trunk", Vector3.new(1.1, h + 3, 1.1), CFrame.new(pos + Vector3.new(0, (h + 3) / 2, 0)), C(150, 110, 70), M.Wood)
		for i = 0, 4 do
			local a = i * math.pi * 2 / 5
			Part(parent, "Frond", Vector3.new(6.5, 0.3, 1.6), CFrame.new(pos + Vector3.new(0, h + 3, 0)) * CFrame.Angles(0, a, 0) * CFrame.new(3, -0.4, 0) * CFrame.Angles(0, 0, -0.3), C(70, 170, 80), M.Grass, { collide = false })
		end
	else
		Part(parent, "Trunk", Vector3.new(1.3, h, 1.3), CFrame.new(pos + Vector3.new(0, h / 2, 0)), C(120, 86, 56), M.Wood)
		local g = pick(rng, { C(70, 160, 70), C(90, 180, 80), C(60, 140, 90), C(120, 190, 70) })
		local s = rr(rng, 6.5, 9)
		Part(parent, "Canopy", Vector3.new(s, s, s), CFrame.new(pos + Vector3.new(0, h + s * 0.3, 0)), g, M.Grass, { shape = BALL, collide = false })
		Part(parent, "Canopy2", Vector3.new(s * 0.7, s * 0.7, s * 0.7), CFrame.new(pos + Vector3.new(s * 0.25, h + s * 0.7, 0)), g, M.Grass, { shape = BALL, collide = false })
	end
end

function Prefabs.Bush(parent, pos, rng)
	local s = rr(rng, 3, 5)
	Part(parent, "Bush", Vector3.new(s, s * 0.7, s), CFrame.new(pos + Vector3.new(0, s * 0.3, 0)), pick(rng, { C(60, 150, 70), C(80, 170, 90) }), M.Grass, { shape = BALL, collide = false })
end

function Prefabs.Bench(parent, pos, yaw)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw or 0, 0)
	Part(parent, "BenchSeat", Vector3.new(6, 0.5, 2), cf * CFrame.new(0, 1.7, 0), C(150, 100, 60), M.Wood)
	Part(parent, "BenchBack", Vector3.new(6, 1.6, 0.4), cf * CFrame.new(0, 2.8, -0.9), C(150, 100, 60), M.Wood)
	Part(parent, "BenchLegL", Vector3.new(0.5, 1.6, 1.8), cf * CFrame.new(-2.5, 0.8, 0), DARK, M.Metal)
	Part(parent, "BenchLegR", Vector3.new(0.5, 1.6, 1.8), cf * CFrame.new(2.5, 0.8, 0), DARK, M.Metal)
end

function Prefabs.Planter(parent, pos, color)
	Part(parent, "Planter", Vector3.new(5, 2, 5), CFrame.new(pos + Vector3.new(0, 1, 0)), color or C(170, 160, 150), M.Concrete)
	Part(parent, "PlanterGreen", Vector3.new(4.2, 2.4, 4.2), CFrame.new(pos + Vector3.new(0, 2.2, 0)), C(70, 160, 80), M.Grass, { shape = BALL, collide = false })
end

function Prefabs.Kiosk(parent, pos, yaw, color, text)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw or 0, 0)
	Part(parent, "Kiosk", Vector3.new(7, 7, 6), cf * CFrame.new(0, 3.5, 0), color, M.SmoothPlastic)
	Part(parent, "KioskRoof", Vector3.new(8.4, 0.6, 7.4), cf * CFrame.new(0, 7.3, 0), DARK)
	local win = Part(parent, "KioskWindow", Vector3.new(5, 2.6, 0.3), cf * CFrame.new(0, 4.4, -3.1), GLASS, M.Glass, { t = 0.3 })
	local sign = Part(parent, "KioskSign", Vector3.new(5, 1.3, 0.3), cf * CFrame.new(0, 6.3, -3.1), DARK)
	Label(sign, Enum.NormalId.Front, text or "SHOP", C(255, 220, 90))
end

function Prefabs.DistrictSign(parent, pos, text, color, yaw)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw or 0, 0)
	Part(parent, "SignPostL", Vector3.new(0.8, 12, 0.8), cf * CFrame.new(-7, 6, 0), DARK, M.Metal)
	Part(parent, "SignPostR", Vector3.new(0.8, 12, 0.8), cf * CFrame.new(7, 6, 0), DARK, M.Metal)
	local b = Part(parent, "SignBoard", Vector3.new(18, 5, 0.6), cf * CFrame.new(0, 11, 0), color, M.SmoothPlastic)
	Label(b, Enum.NormalId.Front, text, C(255, 255, 255))
	Label(b, Enum.NormalId.Back, text, C(255, 255, 255))
end

function Prefabs.Fountain(parent, pos, accent)
	local cf = CFrame.new(pos)
	Part(parent, "FountainRim", Vector3.new(2.4, 30, 30), cf * CFrame.new(0, 1.2, 0) * UPRIGHT, C(228, 222, 212), M.Concrete, { shape = CYL })
	Part(parent, "FountainWater", Vector3.new(0.3, 27, 27), cf * CFrame.new(0, 2.3, 0) * UPRIGHT, C(110, 196, 240), M.Glass, { shape = CYL, t = 0.25, collide = false })
	Part(parent, "FountainTier", Vector3.new(4, 10, 10), cf * CFrame.new(0, 3.5, 0) * UPRIGHT, C(240, 236, 228), M.Concrete, { shape = CYL })
	Part(parent, "FountainBowl", Vector3.new(1, 14, 14), cf * CFrame.new(0, 6, 0) * UPRIGHT, C(240, 236, 228), M.Concrete, { shape = CYL })
	Part(parent, "FountainWater2", Vector3.new(0.2, 12.5, 12.5), cf * CFrame.new(0, 6.5, 0) * UPRIGHT, C(110, 196, 240), M.Glass, { shape = CYL, t = 0.25, collide = false })
	Part(parent, "FountainSpout", Vector3.new(1.4, 6, 1.4), cf * CFrame.new(0, 9, 0), C(240, 236, 228), M.Concrete)
	local jet = Part(parent, "FountainJet", Vector3.new(1, 5, 1), cf * CFrame.new(0, 14, 0), C(190, 235, 255), M.Neon, { t = 0.45, collide = false, cast = false })
	Part(parent, "FountainGlow", Vector3.new(0.2, 28, 28), cf * CFrame.new(0, 2.45, 0) * UPRIGHT, accent, M.Neon, { shape = CYL, t = 0.85, collide = false, cast = false })
	do
		local e = Instance.new("ParticleEmitter")
		e.Color = ColorSequence.new(C(210, 240, 255))
		e.Size = NumberSequence.new(0.8, 0.2)
		e.Transparency = NumberSequence.new(0.2, 1)
		e.Lifetime = NumberRange.new(1, 1.4)
		e.Speed = NumberRange.new(10, 14)
		e.SpreadAngle = Vector2.new(14, 14)
		e.Acceleration = Vector3.new(0, -24, 0)
		e.Rate = 26
		e.Parent = jet
	end
end

function Prefabs.FlowerBed(parent, pos, w, d, rng)
	Part(parent, "BedEdge", Vector3.new(w, 1, d), CFrame.new(pos + Vector3.new(0, 0.5, 0)), C(232, 224, 212), M.Concrete)
	Part(parent, "BedSoil", Vector3.new(w - 0.8, 0.2, d - 0.8), CFrame.new(pos + Vector3.new(0, 1.05, 0)), C(110, 160, 80), M.Grass, { collide = false })
	local cols = { C(255, 120, 150), C(255, 210, 90), C(190, 140, 255), C(255, 255, 255), C(255, 150, 90) }
	local n = math.floor(w * d / 14)
	for _ = 1, n do
		local x = rr(rng, -w / 2 + 1, w / 2 - 1)
		local z = rr(rng, -d / 2 + 1, d / 2 - 1)
		Part(parent, "Flower", Vector3.new(0.9, 0.9, 0.9), CFrame.new(pos + Vector3.new(x, 1.5, z)), pick(rng, cols), M.SmoothPlastic, { shape = BALL, collide = false, cast = false })
	end
end

function Prefabs.Hedge(parent, cf, len)
	Part(parent, "Hedge", Vector3.new(len, 2.6, 2.4), cf * CFrame.new(0, 1.3, 0), C(76, 156, 84), M.Grass)
	Part(parent, "HedgeTop", Vector3.new(len - 0.4, 0.6, 2.0), cf * CFrame.new(0, 2.8, 0), C(96, 178, 96), M.Grass, { collide = false })
end

function Prefabs.Cloud(parent, pos, rng)
	local s = rr(rng, 16, 30)
	local col = C(255, 255, 255)
	Part(parent, "Cloud", Vector3.new(s * 1.6, s * 0.7, s), CFrame.new(pos), col, M.SmoothPlastic, { shape = BALL, collide = false, cast = false, t = 0.08 })
	Part(parent, "Cloud", Vector3.new(s, s * 0.8, s * 0.9), CFrame.new(pos + Vector3.new(s * 0.6, s * 0.2, 0)), col, M.SmoothPlastic, { shape = BALL, collide = false, cast = false, t = 0.08 })
	Part(parent, "Cloud", Vector3.new(s * 0.9, s * 0.6, s * 0.8), CFrame.new(pos + Vector3.new(-s * 0.7, -s * 0.05, s * 0.1)), col, M.SmoothPlastic, { shape = BALL, collide = false, cast = false, t = 0.08 })
end

function Prefabs.TrafficLight(parent, pos, yaw)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw or 0, 0)
	Part(parent, "TLPole", Vector3.new(0.6, 10, 0.6), cf * CFrame.new(0, 5, 0), DARK, M.Metal)
	Part(parent, "TLBox", Vector3.new(1.4, 4, 1.2), cf * CFrame.new(0, 10.5, 0), C(40, 42, 50), M.SmoothPlastic)
	Part(parent, "TLRed", Vector3.new(0.9, 0.9, 0.3), cf * CFrame.new(0, 11.8, -0.6), C(255, 70, 70), M.Neon, { collide = false, cast = false })
	Part(parent, "TLYellow", Vector3.new(0.9, 0.9, 0.3), cf * CFrame.new(0, 10.6, -0.6), C(120, 110, 60), M.SmoothPlastic, { collide = false, cast = false })
	Part(parent, "TLGreen", Vector3.new(0.9, 0.9, 0.3), cf * CFrame.new(0, 9.4, -0.6), C(60, 110, 70), M.SmoothPlastic, { collide = false, cast = false })
end

function Prefabs.BusStop(parent, pos, yaw, color)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw or 0, 0)
	Part(parent, "StopRoof", Vector3.new(10, 0.5, 3.4), cf * CFrame.new(0, 8, 0), color, M.SmoothPlastic)
	Part(parent, "StopBack", Vector3.new(10, 6, 0.3), cf * CFrame.new(0, 4.6, 1.5), GLASS, M.Glass, { t = 0.45 })
	for _, x in ipairs({ -4.8, 4.8 }) do
		Part(parent, "StopPost", Vector3.new(0.4, 7.6, 0.4), cf * CFrame.new(x, 4, 1.4), DARK, M.Metal)
	end
	Part(parent, "StopSeat", Vector3.new(7, 0.5, 1.4), cf * CFrame.new(0, 2, 0.7), C(240, 240, 240), M.SmoothPlastic)
	local sign = Part(parent, "StopSign", Vector3.new(3.6, 1.2, 0.2), cf * CFrame.new(-3, 7, -1.5), color, M.SmoothPlastic, { collide = false })
	Label(sign, Enum.NormalId.Front, "BUS", C(255, 255, 255))
end

function Prefabs.Hydrant(parent, pos)
	Part(parent, "Hydrant", Vector3.new(2.2, 1.4, 1.4), CFrame.new(pos + Vector3.new(0, 1.1, 0)) * UPRIGHT, C(230, 60, 60), M.SmoothPlastic, { shape = CYL })
	Part(parent, "HydrantCap", Vector3.new(1.2, 1.2, 1.2), CFrame.new(pos + Vector3.new(0, 2.3, 0)), C(230, 60, 60), M.SmoothPlastic, { shape = BALL, collide = false })
end

function Prefabs.Bin(parent, pos, color)
	Part(parent, "Bin", Vector3.new(3, 2, 2), CFrame.new(pos + Vector3.new(0, 1.5, 0)) * UPRIGHT, color or C(70, 150, 110), M.SmoothPlastic, { shape = CYL })
	Part(parent, "BinLid", Vector3.new(0.3, 2.2, 2.2), CFrame.new(pos + Vector3.new(0, 3.1, 0)) * UPRIGHT, DARK, M.SmoothPlastic, { shape = CYL, collide = false })
end

function Prefabs.Cone(parent, pos)
	Part(parent, "ConeBase", Vector3.new(1.8, 0.3, 1.8), CFrame.new(pos + Vector3.new(0, 0.15, 0)), C(255, 130, 30), M.SmoothPlastic, { collide = false })
	Part(parent, "Cone", Vector3.new(1.8, 1.1, 1.1), CFrame.new(pos + Vector3.new(0, 1, 0)) * UPRIGHT, C(255, 130, 30), M.SmoothPlastic, { shape = CYL, collide = false })
	Part(parent, "ConeStripe", Vector3.new(0.4, 1.15, 1.15), CFrame.new(pos + Vector3.new(0, 1.2, 0)) * UPRIGHT, C(250, 250, 250), M.SmoothPlastic, { shape = CYL, collide = false })
end

function Prefabs.Pallet(parent, pos, yaw, rng)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw or 0, 0)
	Part(parent, "Pallet", Vector3.new(5, 0.6, 5), cf * CFrame.new(0, 0.3, 0), C(176, 132, 84), M.Wood)
	local h = math.floor(rr(rng, 1, 3.99))
	for i = 1, h do
		Part(parent, "Crate", Vector3.new(4.4, 2.2, 4.4), cf * CFrame.new(0, 0.6 + (i - 0.5) * 2.25, 0), pick(rng, { C(196, 150, 96), C(170, 128, 80), C(120, 140, 170) }), M.Wood)
	end
end

function Prefabs.Forklift(parent, pos, yaw)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw or 0, 0)
	Part(parent, "FLBody", Vector3.new(6, 2.6, 4), cf * CFrame.new(0, 2.1, 0), C(255, 196, 40), M.SmoothPlastic)
	Part(parent, "FLSeat", Vector3.new(2, 1.2, 2.4), cf * CFrame.new(-0.6, 4, 0), DARK)
	Part(parent, "FLRoof", Vector3.new(3.6, 0.3, 3.8), cf * CFrame.new(-0.4, 7.4, 0), DARK, M.Metal)
	for _, z in ipairs({ -1.7, 1.7 }) do
		Part(parent, "FLPost", Vector3.new(0.3, 4, 0.3), cf * CFrame.new(1.2, 5.4, z), DARK, M.Metal)
		Part(parent, "FLPostB", Vector3.new(0.3, 4, 0.3), cf * CFrame.new(-2, 5.4, z), DARK, M.Metal)
		Part(parent, "FLFork", Vector3.new(4, 0.25, 0.6), cf * CFrame.new(5, 0.6, z * 0.6), C(90, 90, 96), M.Metal)
	end
	Part(parent, "FLMast", Vector3.new(0.5, 7, 3.6), cf * CFrame.new(3.2, 4, 0), C(90, 90, 96), M.Metal)
	for _, x in ipairs({ -1.8, 1.8 }) do
		for _, z in ipairs({ -2, 2 }) do
			Part(parent, "FLWheel", Vector3.new(1, 2, 2), cf * CFrame.new(x, 1, z) * CFrame.Angles(0, math.pi / 2, 0), C(30, 30, 34), M.SmoothPlastic, { shape = CYL })
		end
	end
end

function Prefabs.Crane(parent, pos, yaw, accent)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw or 0, 0)
	Part(parent, "CraneMast", Vector3.new(3, 60, 3), cf * CFrame.new(0, 30, 0), accent, M.Metal)
	Part(parent, "CraneJib", Vector3.new(50, 2.4, 2.4), cf * CFrame.new(12, 60, 0), accent, M.Metal)
	Part(parent, "CraneCab", Vector3.new(5, 4, 4), cf * CFrame.new(0, 57, 0), C(240, 240, 240), M.SmoothPlastic)
	Part(parent, "CraneWeight", Vector3.new(6, 4, 4), cf * CFrame.new(-11, 58, 0), C(110, 110, 120), M.Concrete)
	Part(parent, "CraneCable", Vector3.new(0.3, 26, 0.3), cf * CFrame.new(30, 47, 0), DARK, M.Metal, { collide = false })
	Part(parent, "CraneLoad", Vector3.new(10, 4, 4), cf * CFrame.new(30, 32, 0), C(60, 110, 190), M.Metal, { collide = false })
	Part(parent, "CraneBeacon", Vector3.new(1.2, 1.2, 1.2), cf * CFrame.new(0, 62, 0), C(255, 60, 60), M.Neon, { shape = BALL, collide = false })
end

function Prefabs.HoloRing(parent, pos, color, size)
	size = size or 10
	Part(parent, "HoloRing", Vector3.new(0.4, size, size), CFrame.new(pos) * CFrame.Angles(0, math.pi / 2, 0), color, M.Neon, { shape = CYL, t = 0.5, collide = false, cast = false })
	Part(parent, "HoloRingIn", Vector3.new(0.5, size - 1.6, size - 1.6), CFrame.new(pos) * CFrame.Angles(0, math.pi / 2, 0), C(14, 12, 28), M.SmoothPlastic, { shape = CYL, t = 0.75, collide = false, cast = false })
end

function Prefabs.Gantry(parent, x, z0, width, text, accent)
	for _, s in ipairs({ -1, 1 }) do
		Part(parent, "GantryPost", Vector3.new(1.4, 20, 1.4), CFrame.new(x, 10.8, z0 + s * (width / 2 + 3)), C(150, 154, 162), M.Metal)
	end
	Part(parent, "GantryBeam", Vector3.new(1.6, 1.6, width + 8), CFrame.new(x, 20.4, z0), C(150, 154, 162), M.Metal)
	local b = Part(parent, "GantrySign", Vector3.new(0.6, 5, width * 0.6), CFrame.new(x, 17, z0), C(30, 120, 70), M.SmoothPlastic)
	Label(b, Enum.NormalId.Left, text, C(255, 255, 255))
	Label(b, Enum.NormalId.Right, text, C(255, 255, 255))
	Part(parent, "GantryTrim", Vector3.new(0.7, 0.3, width * 0.6), CFrame.new(x, 14.4, z0), accent, M.Neon, { collide = false })
end

local B = {}

local function mkb(parent, cf)
	return function(name, size, off, color, mat, o)
		return Part(parent, name, size, cf * CFrame.new(off), color, mat, o)
	end
end

function B.shop(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	local col = pick(rng, pal.buildings)
	mk("Body", Vector3.new(w, h, d), Vector3.new(0, h / 2, 0), col)
	mk("Trim", Vector3.new(w + 1, 0.8, d + 1), Vector3.new(0, h + 0.4, 0), pal.accent)
	mk("Glass", Vector3.new(w * 0.8, 3.4, 0.3), Vector3.new(0, 2.6, -d / 2 - 0.1), GLASS, M.Glass, { t = 0.3 })
	for i = 1, 3 do
		mk("Mullion", Vector3.new(0.3, 3.4, 0.4), Vector3.new(-w * 0.4 + i * w * 0.2, 2.6, -d / 2 - 0.15), C(250, 250, 250))
	end
	mk("Door", Vector3.new(3, 4.6, 0.4), Vector3.new(w * 0.3, 2.3, -d / 2 - 0.2), DARK)
	mk("Plinth", Vector3.new(w + 0.4, 0.8, d + 0.4), Vector3.new(0, 0.4, 0), C(225, 220, 212), M.Concrete)
	for fl = 1, math.floor((h - 7) / 4) do
		mk("UpperWin", Vector3.new(w * 0.7, 1.8, 0.3), Vector3.new(0, 6.5 + fl * 3.6, -d / 2 - 0.1), GLASS, M.Glass, { t = 0.25 })
	end
	mk("Awning", Vector3.new(w * 0.9, 0.5, 3.4), Vector3.new(0, 5.2, -d / 2 - 1.8), pal.accent2 or pal.accent)
	local sign = mk("Sign", Vector3.new(w * 0.6, 2.2, 0.4), Vector3.new(0, h - 1.8, -d / 2 - 0.3), DARK)
	Label(sign, Enum.NormalId.Front, pick(rng, { "PARTS", "TIRES", "AUTO", "SHOP", "MARKET", "SPEED" }), pal.accent)
	mk("AC", Vector3.new(3.4, 1.6, 3.4), Vector3.new(w / 4, h + 1.6, 0), C(170, 175, 185), M.Metal)
end

function B.house(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	h = math.min(h, 14)
	local col = pick(rng, pal.buildings)
	mk("Body", Vector3.new(w, h, d), Vector3.new(0, h / 2, 0), col)
	local roofH = math.min(9, d * 0.45)
	local roofCol = pick(rng, { C(200, 96, 80), C(110, 120, 150), C(90, 150, 140), C(160, 110, 170) })
	Part(parent, "RoofF", Vector3.new(w + 1.6, roofH, d / 2 + 0.8), cf * CFrame.new(0, h + roofH / 2, -d / 4 - 0.4), roofCol, M.SmoothPlastic, { class = "WedgePart" })
	Part(parent, "RoofB", Vector3.new(w + 1.6, roofH, d / 2 + 0.8), cf * CFrame.new(0, h + roofH / 2, d / 4 + 0.4) * CFrame.Angles(0, math.pi, 0), roofCol, M.SmoothPlastic, { class = "WedgePart" })
	mk("Chimney", Vector3.new(2.2, roofH, 2.2), Vector3.new(w * 0.3, h + roofH / 2 + 1, d * 0.15), C(170, 110, 90), M.Brick)
	local n = math.max(2, math.floor(w / 7))
	for i = 1, n do
		local x = -w / 2 + (i - 0.5) * (w / n)
		for fl = 0, math.floor((h - 3) / 5) - 1 do
			if not (fl == 0 and i == math.ceil(n / 2)) then
				mk("Win", Vector3.new(3, 2.8, 0.3), Vector3.new(x, 3.6 + fl * 5, -d / 2 - 0.1), GLASS, M.Glass, { t = 0.2 })
				mk("WinFrame", Vector3.new(3.6, 0.4, 0.5), Vector3.new(x, 2.1 + fl * 5, -d / 2 - 0.2), C(250, 250, 250))
			end
		end
	end
	mk("Door", Vector3.new(3.4, 5, 0.4), Vector3.new((math.ceil(n / 2) - 0.5) * (w / n) - w / 2, 2.5, -d / 2 - 0.2), pick(rng, { C(120, 80, 60), C(60, 110, 160), C(200, 80, 80) }))
	mk("Step", Vector3.new(5, 0.6, 2), Vector3.new((math.ceil(n / 2) - 0.5) * (w / n) - w / 2, 0.3, -d / 2 - 1), C(220, 214, 204), M.Concrete)
end

function B.cafe(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	h = math.min(h, 9)
	mk("Body", Vector3.new(w, h, d), Vector3.new(0, h / 2, 0), pick(rng, pal.buildings))
	mk("Glass", Vector3.new(w * 0.85, 3.6, 0.3), Vector3.new(0, 2.7, -d / 2 - 0.1), GLASS, M.Glass, { t = 0.3 })
	local n = 6
	for i = 1, n do
		local c = (i % 2 == 0) and C(250, 250, 250) or pal.accent
		mk("Stripe", Vector3.new(w * 0.9 / n, 0.4, 4), Vector3.new(-w * 0.45 + (i - 0.5) * (w * 0.9 / n), 5.4 - 0.1 * i, -d / 2 - 2.2), c)
	end
	local sign = mk("Sign", Vector3.new(w * 0.5, 2, 0.4), Vector3.new(0, h - 1.4, -d / 2 - 0.3), DARK)
	Label(sign, Enum.NormalId.Front, "CAFE", C(255, 200, 120))
	for i = -1, 1, 2 do
		mk("TableTop", Vector3.new(0.3, 3, 3), Vector3.new(i * w * 0.25, 2.4, -d / 2 - 6), C(240, 240, 240), M.SmoothPlastic, { shape = CYL }).CFrame = cf * CFrame.new(i * w * 0.25, 2.4, -d / 2 - 6) * UPRIGHT
		mk("TablePole", Vector3.new(2.2, 0.4, 0.4), Vector3.new(i * w * 0.25, 1.2, -d / 2 - 6), DARK).CFrame = cf * CFrame.new(i * w * 0.25, 1.2, -d / 2 - 6) * UPRIGHT
	end
end

function B.apartment(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	mk("Body", Vector3.new(w, h, d), Vector3.new(0, h / 2, 0), pick(rng, pal.buildings))
	local floors = math.floor((h - 4) / 4)
	for i = 0, floors - 1 do
		mk("Windows", Vector3.new(w - 4, 2.2, 0.3), Vector3.new(0, 5 + i * 4, -d / 2 - 0.1), GLASS, M.Glass, { t = 0.25 })
	end
	mk("Entrance", Vector3.new(5, 4, 0.5), Vector3.new(0, 2, -d / 2 - 0.2), DARK)
	mk("Ledge", Vector3.new(w + 1.2, 1, d + 1.2), Vector3.new(0, h + 0.5, 0), pal.accent)
	mk("Tank", Vector3.new(4, 4, 4), Vector3.new(-w / 4, h + 3, 0), C(140, 140, 150), M.Metal, { shape = CYL }).CFrame = cf * CFrame.new(-w / 4, h + 3, 0) * UPRIGHT
	for i = 0, floors - 1 do
		if i % 2 == 1 then
			for _, sx in ipairs({ -1, 1 }) do
				mk("Balcony", Vector3.new(6, 0.5, 2.2), Vector3.new(sx * w * 0.25, 3.8 + i * 4, -d / 2 - 1.1), C(240, 240, 244))
				mk("Rail", Vector3.new(6, 1.2, 0.2), Vector3.new(sx * w * 0.25, 4.6 + i * 4, -d / 2 - 2.1), pal.accent)
			end
		end
	end
	mk("RoofGarden", Vector3.new(w * 0.35, 0.8, d * 0.4), Vector3.new(w / 5, h + 1.4, 0), C(100, 170, 90), M.Grass)
end

function B.tower(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	local col = pick(rng, pal.buildings)
	local h1 = h * 0.62
	mk("Base", Vector3.new(w, h1, d), Vector3.new(0, h1 / 2, 0), col)
	mk("Top", Vector3.new(w * 0.72, h - h1, d * 0.72), Vector3.new(0, h1 + (h - h1) / 2, 0), col)
	for i = 0, math.floor(h1 / 5) - 1 do
		mk("WinBand", Vector3.new(w - 3, 2.4, 0.3), Vector3.new(0, 4 + i * 5, -d / 2 - 0.1), GLASS, M.Glass, { t = 0.2 })
	end
	mk("Spire", Vector3.new(0.6, 8, 0.6), Vector3.new(0, h + 4, 0), DARK, M.Metal)
	mk("Beacon", Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, h + 8.4, 0), C(255, 60, 60), M.Neon, { shape = BALL })
end

function B.dealership(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	h = math.min(h, 10)
	mk("Back", Vector3.new(w, h, 3), Vector3.new(0, h / 2, d / 2 - 1.5), C(230, 232, 238))
	mk("SideL", Vector3.new(3, h, d), Vector3.new(-w / 2 + 1.5, h / 2, 0), C(230, 232, 238))
	mk("SideR", Vector3.new(3, h, d), Vector3.new(w / 2 - 1.5, h / 2, 0), C(230, 232, 238))
	mk("Roof", Vector3.new(w + 2, 1, d + 4), Vector3.new(0, h + 0.5, -1), pal.accent)
	mk("Glass", Vector3.new(w - 6, h - 2, 0.3), Vector3.new(0, h / 2, -d / 2), GLASS, M.Glass, { t = 0.5 })
	mk("Floor", Vector3.new(w - 6, 0.3, d - 3), Vector3.new(0, 0.3, 0), C(60, 62, 70))
	local sign = mk("Sign", Vector3.new(w * 0.5, 2.6, 0.4), Vector3.new(0, h + 2.2, -d / 2 - 1), DARK)
	Label(sign, Enum.NormalId.Front, "MOTORS", pal.accent)
	local car = VehicleFactory.Build(pick(rng, { "sport", "supercar", "sedan" }), { BodyColor = pick(rng, { C(220, 50, 50), C(240, 200, 40), C(60, 120, 230) }), Spoiler = true })
	car:PivotTo(cf * CFrame.new(0, 0.5, -d / 2 + 9) * CFrame.Angles(0, math.pi / 2 + 0.4, 0))
	car.Parent = parent
end

function B.garage(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	h = math.min(h, 10)
	mk("Body", Vector3.new(w, h, d), Vector3.new(0, h / 2, 0), C(160, 165, 175))
	for i = 0, 3 do
		mk("Roller", Vector3.new(w * 0.55, 1.4, 0.4), Vector3.new(0, 1 + i * 1.5, -d / 2 - 0.2), (i % 2 == 0) and C(235, 235, 240) or C(205, 208, 215))
	end
	mk("Hazard", Vector3.new(w * 0.6, 0.6, 0.5), Vector3.new(0, 7.4, -d / 2 - 0.2), C(255, 200, 30))
	mk("Roof", Vector3.new(w + 1, 0.8, d + 1), Vector3.new(0, h + 0.4, 0), pal.accent)
end

function B.billboard(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	mk("PostL", Vector3.new(1.4, 20, 1.4), Vector3.new(-w / 3, 10, 0), DARK, M.Metal)
	mk("PostR", Vector3.new(1.4, 20, 1.4), Vector3.new(w / 3, 10, 0), DARK, M.Metal)
	local b = mk("Board", Vector3.new(w, 12, 1), Vector3.new(0, 24, 0), C(20, 22, 30))
	local msgs = { "TURBO FUEL", "FAST LANE", "HUNT THE CARS", "NITRO DRINK", "ROAD KING" }
	local t = pick(rng, msgs)
	Label(b, Enum.NormalId.Front, t, pal.accent)
	Label(b, Enum.NormalId.Back, t, pal.accent)
end

function B.gasstation(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	mk("Shop", Vector3.new(w * 0.45, 8, d * 0.5), Vector3.new(w * 0.27, 4, d * 0.2), C(235, 235, 240))
	mk("ShopGlass", Vector3.new(w * 0.35, 3, 0.3), Vector3.new(w * 0.27, 3, d * 0.2 - d * 0.25 - 0.1), GLASS, M.Glass, { t = 0.3 })
	mk("Canopy", Vector3.new(w * 0.7, 1, d * 0.45), Vector3.new(-w * 0.12, 10, -d * 0.18), pal.accent2 or pal.accent)
	for _, sx in ipairs({ -1, 1 }) do
		mk("Pillar", Vector3.new(1.2, 10, 1.2), Vector3.new(-w * 0.12 + sx * w * 0.3, 5, -d * 0.18 - d * 0.18), DARK, M.Metal)
	end
	for i = -1, 1, 2 do
		mk("Pump", Vector3.new(1.6, 4, 2.4), Vector3.new(-w * 0.12 + i * w * 0.12, 2, -d * 0.18), pal.accent)
	end
	local s = mk("Sign", Vector3.new(w * 0.5, 2, 0.4), Vector3.new(-w * 0.12, 11.3, -d * 0.4), DARK)
	Label(s, Enum.NormalId.Front, "FUEL", C(255, 240, 120))
end

function B.motel(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	h = math.min(h, 9)
	mk("Body", Vector3.new(w, h, d), Vector3.new(0, h / 2, 0), pick(rng, pal.buildings))
	local n = math.floor(w / 8)
	for i = 1, n do
		local x = -w / 2 + (i - 0.5) * (w / n)
		mk("Door", Vector3.new(2.6, 4.6, 0.4), Vector3.new(x, 2.3, -d / 2 - 0.2), DARK)
		mk("Window", Vector3.new(3, 2.4, 0.3), Vector3.new(x, 6.4, -d / 2 - 0.1), GLASS, M.Glass, { t = 0.25 })
	end
	mk("Roof", Vector3.new(w + 1.5, 0.8, d + 1.5), Vector3.new(0, h + 0.4, 0), pal.accent)
end

function B.warehouse(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	h = math.max(h, 12)
	mk("Body", Vector3.new(w, h, d), Vector3.new(0, h / 2, 0), pick(rng, pal.buildings), M.Metal)
	local ribs = math.floor(w / 6)
	for i = 1, ribs do
		mk("Rib", Vector3.new(1, 1.2, d + 1), Vector3.new(-w / 2 + (i - 0.5) * (w / ribs), h + 0.6, 0), C(120, 126, 136), M.Metal)
	end
	mk("Door", Vector3.new(w * 0.4, h * 0.6, 0.4), Vector3.new(0, h * 0.3, -d / 2 - 0.2), C(90, 96, 108), M.Metal)
	mk("DoorStripe", Vector3.new(w * 0.4, 0.8, 0.5), Vector3.new(0, h * 0.62, -d / 2 - 0.2), pal.accent)
	mk("Vent", Vector3.new(3, 2, 3), Vector3.new(w * 0.3, h + 2, 0), C(170, 175, 185), M.Metal)
end

function B.containers(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	local cols = { C(200, 70, 50), C(60, 110, 190), C(230, 180, 40), C(70, 150, 90), C(180, 180, 190) }
	local nx = math.max(1, math.floor(w / 13))
	for ix = 1, nx do
		local stack = math.floor(rr(rng, 1, 4))
		for iy = 1, stack do
			mk("Container", Vector3.new(12, 4.2, 5), Vector3.new(-w / 2 + (ix - 0.5) * (w / nx), 2.1 + (iy - 1) * 4.3, -d / 2 + 4), pick(rng, cols), M.Metal)
		end
		local stack2 = math.floor(rr(rng, 1, 3))
		for iy = 1, stack2 do
			mk("Container", Vector3.new(12, 4.2, 5), Vector3.new(-w / 2 + (ix - 0.5) * (w / nx), 2.1 + (iy - 1) * 4.3, -d / 2 + 10), pick(rng, cols), M.Metal)
		end
	end
end

function B.silo(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	local r = math.min(w, d) * 0.4
	for i = -1, 1, 2 do
		local x = i * r * 1.1
		mk("Silo", Vector3.new(h, r * 2, r * 2), Vector3.new(x, h / 2, 0), C(200, 204, 212), M.Metal, { shape = CYL }).CFrame = cf * CFrame.new(x, h / 2, 0) * UPRIGHT
		mk("Dome", Vector3.new(r * 2, r * 1.2, r * 2), Vector3.new(x, h + 0.2, 0), C(170, 90, 70), M.Metal, { shape = BALL })
	end
	mk("Pipe", Vector3.new(r * 2.4, 1, 1), Vector3.new(0, h * 0.7, 0), C(90, 96, 108), M.Metal)
end

function B.factory(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	h = math.max(h, 14)
	mk("Body", Vector3.new(w, h, d), Vector3.new(0, h / 2, 0), pick(rng, pal.buildings), M.Brick)
	for i = 1, 3 do
		mk("Window", Vector3.new(w * 0.18, 3, 0.3), Vector3.new(-w * 0.3 + (i - 1) * w * 0.3, h * 0.6, -d / 2 - 0.1), C(255, 210, 120), M.Neon, { t = 0.2 })
	end
	mk("Chimney", Vector3.new(h * 1.2, 3.2, 3.2), Vector3.new(w * 0.3, h + h * 0.55, d * 0.2), C(120, 90, 80), M.Brick, { shape = CYL }).CFrame = cf * CFrame.new(w * 0.3, h + h * 0.55, d * 0.2) * UPRIGHT
	mk("ChimneyTop", Vector3.new(3.8, 1.2, 3.8), Vector3.new(w * 0.3, h + h * 1.1, d * 0.2), pal.accent, M.SmoothPlastic)
	mk("Roof", Vector3.new(w + 1, 1, d + 1), Vector3.new(0, h + 0.5, 0), C(100, 104, 114), M.Metal)
end

function B.pipes(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	for i = 0, 2 do
		mk("Pipe", Vector3.new(w, 2.2, 2.2), Vector3.new(0, 4 + i * 2.8, 0), (i % 2 == 0) and C(190, 90, 60) or C(120, 130, 145), M.Metal, { shape = CYL })
	end
	for i = 0, 3 do
		mk("Support", Vector3.new(1.2, 10, 3), Vector3.new(-w / 2 + 3 + i * (w - 6) / 3, 5, 0), DARK, M.Metal)
	end
end

function B.neontower(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	local col = pick(rng, pal.buildings)
	mk("Body", Vector3.new(w, h, d), Vector3.new(0, h / 2, 0), col)
	local nc = pick(rng, { pal.accent, pal.accent2 })
	for i = -1, 1 do
		mk("NeonStrip", Vector3.new(0.8, h * 0.9, 0.5), Vector3.new(i * w * 0.3, h / 2, -d / 2 - 0.2), nc, M.Neon)
	end
	for i = 0, math.floor(h / 8) - 1 do
		mk("WinBand", Vector3.new(w - 4, 1.2, 0.3), Vector3.new(0, 5 + i * 8, -d / 2 - 0.15), C(120, 180, 255), M.Neon, { t = 0.5 })
	end
	mk("TopRing", Vector3.new(w + 2, 1, d + 2), Vector3.new(0, h + 0.5, 0), nc, M.Neon)
end

function B.club(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	h = math.min(h, 12)
	mk("Body", Vector3.new(w, h, d), Vector3.new(0, h / 2, 0), C(18, 18, 28))
	local sign = mk("Sign", Vector3.new(w * 0.8, 5, 0.6), Vector3.new(0, h - 2, -d / 2 - 0.4), C(8, 8, 14))
	Label(sign, Enum.NormalId.Front, pick(rng, { "NEON CLUB", "TURBO BAR", "HOLO LOUNGE", "DRIFT" }), pal.accent)
	mk("DoorGlow", Vector3.new(5, 6, 0.4), Vector3.new(0, 3, -d / 2 - 0.3), pal.accent2, M.Neon)
	mk("EdgeL", Vector3.new(0.6, h, 0.6), Vector3.new(-w / 2, h / 2, -d / 2), pal.accent, M.Neon)
	mk("EdgeR", Vector3.new(0.6, h, 0.6), Vector3.new(w / 2, h / 2, -d / 2), pal.accent, M.Neon)
end

function B.holosign(parent, cf, w, d, h, pal, rng)
	local mk = mkb(parent, cf)
	mk("Pole", Vector3.new(1.2, 12, 1.2), Vector3.new(0, 6, 0), DARK, M.Metal)
	local s = mk("Holo", Vector3.new(w, 10, 0.5), Vector3.new(0, 17, 0), pal.accent2, M.Neon, { t = 0.55, collide = false })
	Label(s, Enum.NormalId.Front, pick(rng, { "HUNT", "SPEED", "NEON", "WIN" }), C(255, 255, 255))
	Label(s, Enum.NormalId.Back, "HUNT", C(255, 255, 255))
	mk("Frame", Vector3.new(w + 1, 0.6, 0.8), Vector3.new(0, 22.2, 0), pal.accent, M.Neon)
	mk("FrameB", Vector3.new(w + 1, 0.6, 0.8), Vector3.new(0, 11.8, 0), pal.accent, M.Neon)
end

Prefabs.Buildings = B

Prefabs.Archetypes = {
	city = {
		{ "shop", 24, 36, 10, 14 }, { "cafe", 22, 30, 8, 9 }, { "apartment", 26, 36, 18, 28 }, { "house", 22, 30, 10, 13 },
		{ "tower", 26, 32, 28, 40 }, { "dealership", 38, 46, 9, 10 }, { "garage", 24, 32, 9, 10 },
	},
	highway = {
		{ "gasstation", 40, 48, 8, 8 }, { "motel", 40, 58, 8, 9 }, { "billboard", 34, 40, 20, 20 },
		{ "shop", 26, 34, 10, 12 }, { "tower", 26, 32, 24, 34 },
	},
	industrial = {
		{ "warehouse", 36, 56, 12, 16 }, { "containers", 28, 40, 8, 8 }, { "silo", 24, 30, 22, 28 },
		{ "factory", 34, 44, 14, 20 }, { "pipes", 30, 44, 10, 10 },
	},
	neon = {
		{ "neontower", 26, 34, 30, 52 }, { "club", 30, 40, 10, 12 }, { "holosign", 20, 24, 20, 22 },
		{ "neontower", 24, 30, 26, 44 }, { "club", 28, 36, 9, 11 },
	},
}

function Prefabs.Building(kind, parent, cf, w, d, h, pal, rng)
	local fn = B[kind]
	if fn then
		fn(parent, cf, w, d, h, pal, rng)
	end
end

return Prefabs
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX54"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX53"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX45"><Properties><string name="Name">ClientController</string><ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Strings = require(Shared:WaitForChild("Strings"))
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local BaseLayout = require(Shared:WaitForChild("BaseLayout"))

local Client = script.Parent:WaitForChild("Client")
local Store = require(Client:WaitForChild("StateStore"))
local UI = require(Client:WaitForChild("UI"))
local TrafficRenderer = require(Client:WaitForChild("TrafficRenderer"))
local TrapFx = require(Client:WaitForChild("TrapFx"))
local WorldFx = require(Client:WaitForChild("WorldFx"))
local Guidance = require(Client:WaitForChild("Guidance"))

local player = Players.LocalPlayer
Strings.SetLocale(player.LocaleId)

local actions = {
	Throw = function(partId) Net.Get("ThrowPart"):FireServer(partId) end,
	Place = function(uid, slot) Net.Get("PlaceCar"):FireServer(uid, slot) end,
	Remove = function(uid) Net.Get("RemoveCar"):FireServer(uid) end,
	Upgrade = function(uid, level) Net.Get("UpgradeCar"):FireServer(uid, level) end,
	BuySlot = function(count) Net.Get("BuySlot"):FireServer(count) end,
	Unlock = function(zoneId) Net.Get("UnlockZone"):FireServer(zoneId) end,
	Sell = function(uid) Net.Get("SellCar"):FireServer(uid) end,
	AutoPark = function() Net.Get("AutoPark"):FireServer() end,
}

UI.Init(Store, actions)
WorldFx.Start(Store)
TrafficRenderer.Start()
Guidance.Start(Store)

Net.Get("StateUpdate").OnClientEvent:Connect(function(state) Store.Set(state) end)
Net.Get("MoneySync").OnClientEvent:Connect(function(m, inc, val) Store.SetMoney(m, inc, val) end)
Net.Get("Notify").OnClientEvent:Connect(function(payload) UI.Notify(payload) end)
Net.Get("HitFx").OnClientEvent:Connect(function(dir) WorldFx.Hit(dir, UI.FlashFrame()) UI.Sfx("hit") end)
Net.Get("ThrowResult").OnClientEvent:Connect(function(res)
	UI.Sfx("throw")
	local idx = Store.State and Store.State.baseIndex
	TrapFx.Play(res, idx, function() UI.ShowReveal(res) end)
end)

task.spawn(function()
	while true do
		task.wait(0.2)
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local st = Store.State
		if hrp then
			UI.SetZoneName(MapConfig.ZoneAt(hrp.Position.Z))
			local near = false
			if st and st.baseIndex then
				local trap = BaseLayout.ToWorld(st.baseIndex, BaseLayout.TrapLocal)
				local d = Vector3.new(hrp.Position.X - trap.X, 0, hrp.Position.Z - trap.Z).Magnitude
				near = d <= 35
			end
			UI.SetNearTrap(near)
		end
	end
end)
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX52"><Properties><string name="Name">Client</string></Properties><Item class="ModuleScript" referent="RBX46"><Properties><string name="Name">Guidance</string><ProtectedString name="Source"><![CDATA[local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BaseLayout = require(Shared:WaitForChild("BaseLayout"))

local Guidance = {}
local beam, att0, att1Holder

local function ensure(hrp)
	if not beam or not beam.Parent then
		att0 = Instance.new("Attachment")
		att0.Name = "GuideA"
		att0.Position = Vector3.new(0, -2, 0)
		att0.Parent = hrp
		beam = Instance.new("Beam")
		beam.Name = "GuideBeam"
		beam.Width0 = 0.8
		beam.Width1 = 0.8
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.Color = ColorSequence.new(Color3.fromRGB(255, 220, 60))
		beam.Transparency = NumberSequence.new(0.25)
		beam.Segments = 1
		beam.Attachment0 = att0
		beam.Parent = hrp
	end
	return beam
end

local function clear()
	if beam then
		beam.Enabled = false
	end
end

function Guidance.Start(store)
	task.spawn(function()
		while true do
			task.wait(0.4)
			local st = store.State
			local char = Players.LocalPlayer.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if not st or not hrp or (st.stats and st.stats.throws > 0) then
				clear()
			else
				local target
				local banked, carried = store.BankedTotal(), store.CarriedTotal()
				if banked == 0 and carried == 0 then
					local drops = Workspace:FindFirstChild("RuntimeDrops")
					local best = math.huge
					if drops then
						for _, m in ipairs(drops:GetChildren()) do
							local root = m:FindFirstChild("Root")
							if root then
								local d = (root.Position - hrp.Position).Magnitude
								if d < best then
									best, target = d, root
								end
							end
						end
					end
				elseif st.baseIndex then
					local map = Workspace:FindFirstChild("GeneratedMap")
					local base = map and map.Bases:FindFirstChild(string.format("Base%02d", st.baseIndex), true)
					target = base and base:FindFirstChild("TrapPad")
				end
				if target then
					local b = ensure(hrp)
					local a1 = target:FindFirstChild("GuideB")
					if not a1 then
						a1 = Instance.new("Attachment")
						a1.Name = "GuideB"
						a1.Parent = target
					end
					b.Attachment1 = a1
					b.Enabled = true
				else
					clear()
				end
			end
		end
	end)
end

return Guidance
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX47"><Properties><string name="Name">StateStore</string><ProtectedString name="Source"><![CDATA[local Store = {}

Store.State = nil
Store.Money = 0
Store.Income = 0
Store.CollectionValue = 0
Store.Changed = Instance.new("BindableEvent")
Store.MoneyChanged = Instance.new("BindableEvent")

function Store.Set(state)
	Store.State = state
	Store.Money = state.money
	Store.Income = state.income or 0
	Store.CollectionValue = state.collectionValue or 0
	Store.Changed:Fire()
end

function Store.SetMoney(money, income, value)
	Store.Money = money
	Store.Income = income
	Store.CollectionValue = value or Store.CollectionValue
	if Store.State then
		Store.State.money = money
		Store.State.income = income
	end
	Store.MoneyChanged:Fire()
end

function Store.Banked(partId)
	return Store.State and Store.State.parts[partId] or 0
end

function Store.Carried(partId)
	return Store.State and Store.State.carried[partId] or 0
end

function Store.CarriedTotal()
	local n = 0
	if Store.State then
		for _, v in pairs(Store.State.carried) do
			n = n + v
		end
	end
	return n
end

function Store.BankedTotal()
	local n = 0
	if Store.State then
		for _, v in pairs(Store.State.parts) do
			n = n + v
		end
	end
	return n
end

return Store
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX48"><Properties><string name="Name">TrafficRenderer</string><ProtectedString name="Source"><![CDATA[local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local TrafficMath = require(Shared:WaitForChild("TrafficMath"))
local VehicleFactory = require(Shared:WaitForChild("VehicleFactory"))

local Renderer = {}
local pools = {}
local ACTIVE_DIST = 420

function Renderer.Start()
	local folder = Workspace:WaitForChild("RuntimeTraffic")
	local flip = CFrame.Angles(0, math.pi, 0)
	RunService.RenderStepped:Connect(function()
		local cam = Workspace.CurrentCamera
		if not cam then
			return
		end
		local camZ = cam.CFrame.Position.Z
		local t = Workspace:GetServerTimeNow()
		for ri, road in ipairs(MapConfig.Roads) do
			local active = math.abs(camZ - road.z) < ACTIVE_DIST
			for _, lane in ipairs(TrafficMath.RoadLanes[ri]) do
				local pool = pools[lane.index]
				if active then
					if not pool then
						pool = { models = {}, shown = false }
						for k = 1, lane.count do
							pool.models[k] = VehicleFactory.BuildTraffic(lane.kinds[k], MapConfig.TrafficColors[lane.colors[k]], lane.colors[k])
						end
						pools[lane.index] = pool
					end
					if not pool.shown then
						pool.shown = true
						for k, m in ipairs(pool.models) do
							m:PivotTo(CFrame.new(0, -500, 0))
							m.Parent = folder
						end
					end
					for k, m in ipairs(pool.models) do
						local x = TrafficMath.CarX(lane, k, t)
						local cf = CFrame.new(x, MapConfig.RoadTopY, lane.z)
						if lane.dir < 0 then
							cf = cf * flip
						end
						m.PrimaryPart.CFrame = cf
					end
				elseif pool and pool.shown then
					pool.shown = false
					for _, m in ipairs(pool.models) do
						m.Parent = nil
					end
				end
			end
		end
	end)
end

return Renderer
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX49"><Properties><string name="Name">TrapFx</string><ProtectedString name="Source"><![CDATA[local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local BaseLayout = require(Shared:WaitForChild("BaseLayout"))
local VehicleFactory = require(Shared:WaitForChild("VehicleFactory"))
local PartVisual = require(Shared:WaitForChild("PartVisual"))

local TrapFx = {}

local function animate(duration, fn)
	local t0 = os.clock()
	while true do
		local a = math.min(1, (os.clock() - t0) / duration)
		fn(a)
		if a >= 1 then
			break
		end
		RunService.Heartbeat:Wait()
	end
end

local function faceCF(pos, dir)
	local yaw = math.atan2(-dir.Z, dir.X)
	return CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
end

local function findBase(idx)
	local map = Workspace:FindFirstChild("GeneratedMap")
	local bases = map and map:FindFirstChild("Bases")
	return bases and bases:FindFirstChild(string.format("Base%02d", idx), true)
end

local function burst(pos, color, count)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.Transparency = 1
	p.Size = Vector3.new(1, 1, 1)
	p.Position = pos
	p.Parent = Workspace
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(color)
	e.Lifetime = NumberRange.new(0.6, 1.2)
	e.Speed = NumberRange.new(14, 28)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new(1.2, 0)
	e.LightEmission = 1
	e.Rate = 0
	e.Parent = p
	e:Emit(count)
	task.delay(2, function()
		p:Destroy()
	end)
end

local function pulse(part, toColor, toTransparency, t)
	if not part then
		return
	end
	local orig = { Color = part.Color, Transparency = part.Transparency }
	local tw = TweenService:Create(part, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true), { Color = toColor, Transparency = toTransparency })
	tw:Play()
	task.delay(t * 2 + 0.05, function()
		if part.Parent then
			part.Color = orig.Color
			part.Transparency = orig.Transparency
		end
	end)
end

function TrapFx.Play(res, baseIndex, onDone)
	task.spawn(function()
		local def = CarConfig.ById[res.typeId]
		if not def or not baseIndex then
			if onDone then onDone() end
			return
		end
		local bcf = BaseLayout.GetBaseCFrame(baseIndex)
		local trapPos = bcf:PointToWorldSpace(BaseLayout.TrapLocal) + Vector3.new(0, 1, 0)
		local char = Players.LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local startPos = hrp and (hrp.Position + Vector3.new(0, 2, 0)) or (trapPos + Vector3.new(0, 10, 12))
		local base = findBase(baseIndex)
		local pad = base and base:FindFirstChild("TrapPad")
		local glow = base and base:FindFirstChild("TrapArchGlow")
		local portal = base and base:FindFirstChild("PortalField")

		local item = PartVisual.Build(res.partId)
		item:PivotTo(CFrame.new(startPos))
		item.Parent = Workspace
		local target = trapPos + Vector3.new(0, 3, 0)
		animate(0.7, function(a)
			local p = startPos:Lerp(target, a) + Vector3.new(0, math.sin(a * math.pi) * 9, 0)
			item.PrimaryPart.CFrame = CFrame.new(p) * CFrame.Angles(a * 9, a * 6, 0)
		end)
		item:Destroy()

		local rarityColor = CarConfig.Rarities[res.rarity].color
		burst(trapPos, Color3.fromRGB(80, 240, 255), 45)
		pulse(pad, Color3.fromRGB(255, 255, 255), 0, 0.25)
		pulse(glow, Color3.fromRGB(255, 255, 255), 0, 0.25)
		task.wait(0.6)

		local portalPos = bcf:PointToWorldSpace(BaseLayout.PortalLocal)
		burst(portalPos + Vector3.new(0, 6, 0), rarityColor, 35)
		pulse(portal, rarityColor, 0.15, 0.3)
		local ghost = VehicleFactory.BuildCar(def)
		local y = BaseLayout.FloorY
		local p0 = Vector3.new(portalPos.X, y, portalPos.Z)
		local laneX = BaseLayout.LaneX
		local pts = { p0, bcf:PointToWorldSpace(Vector3.new(laneX, y, BaseLayout.PortalLocal.Z)) }
		if res.slot then
			local sl = BaseLayout.SlotLocal(res.slot)
			table.insert(pts, bcf:PointToWorldSpace(Vector3.new(laneX, y, sl.Z)))
			table.insert(pts, bcf:PointToWorldSpace(Vector3.new(sl.X, y, sl.Z)))
		end
		local total = 0
		for i = 2, #pts do
			total = total + (pts[i] - pts[i - 1]).Magnitude
		end
		ghost:PivotTo(faceCF(p0, pts[2] - pts[1]))
		ghost.Parent = Workspace
		local driveTime = 2.1
		local travelled = 0
		animate(driveTime, function(a)
			local d = a * total
			local acc = 0
			for i = 2, #pts do
				local seg = (pts[i] - pts[i - 1]).Magnitude
				if d <= acc + seg or i == #pts then
					local f = math.clamp((d - acc) / math.max(seg, 0.001), 0, 1)
					local pos = pts[i - 1]:Lerp(pts[i], f)
					ghost.PrimaryPart.CFrame = faceCF(pos, pts[i] - pts[i - 1])
					break
				end
				acc = acc + seg
			end
		end)
		if res.slot then
			local final = pts[#pts]
			local frontDir = bcf:VectorToWorldSpace(Vector3.new(1, 0, 0))
			local fromDir = (pts[#pts] - pts[#pts - 1])
			local a0 = math.atan2(-fromDir.Z, fromDir.X)
			local a1 = math.atan2(-frontDir.Z, frontDir.X)
			local diff = (a1 - a0 + math.pi) % (2 * math.pi) - math.pi
			animate(0.35, function(a)
				ghost.PrimaryPart.CFrame = CFrame.new(final) * CFrame.Angles(0, a0 + diff * a, 0)
			end)
		else
			for _, d in ipairs(ghost:GetDescendants()) do
				if d:IsA("BasePart") and d.Name ~= "Root" then
					TweenService:Create(d, TweenInfo.new(0.5), { Transparency = 1 }):Play()
				end
			end
			task.wait(0.5)
		end
		ghost:Destroy()
		if onDone then
			onDone()
		end
	end)
end

return TrapFx
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX50"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Strings = require(Shared:WaitForChild("Strings"))
local Util = require(Shared:WaitForChild("Util"))
local MapConfig = require(Shared:WaitForChild("MapConfig"))
local PartConfig = require(Shared:WaitForChild("PartConfig"))
local CarConfig = require(Shared:WaitForChild("CarConfig"))
local EconomyConfig = require(Shared:WaitForChild("EconomyConfig"))
local VehicleFactory = require(Shared:WaitForChild("VehicleFactory"))

local T = Strings.T
local C = Color3.fromRGB
local HEAD = Enum.Font.FredokaOne
local BODY = Enum.Font.GothamBold
local BODY2 = Enum.Font.GothamMedium

local INK = C(52, 47, 72)
local MUTED = C(138, 131, 158)
local CARD = C(255, 252, 248)
local CARD2 = C(246, 241, 236)
local LINE = C(234, 227, 219)
local WHITE = C(255, 255, 255)
local MINT = C(94, 206, 156)
local SKY = C(104, 168, 255)
local LAV = C(162, 134, 255)
local PEACH = C(255, 168, 112)
local CORAL = C(255, 114, 124)
local SUN = C(255, 198, 76)
local GREY = C(196, 190, 204)

local UI = {}
local store, actions
local gui, root, uiScale
local hud = {}
local panels = {}
local state = { selectedPart = nil, selectedSlot = nil, nearTrap = false, open = nil, sellArm = {} }
local sounds = {}
local upgradeButtons = {}

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	if parent then
		o.Parent = parent
	end
	return o
end

local function corner(o, r)
	return new("UICorner", { CornerRadius = UDim.new(0, r or 14) }, o)
end

local function round(o)
	return new("UICorner", { CornerRadius = UDim.new(1, 0) }, o)
end

local function stroke(o, color, th, tr)
	return new("UIStroke", { Color = color or LINE, Thickness = th or 2, Transparency = tr or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
end

local function padding(o, l, t, r, b)
	return new("UIPadding", { PaddingLeft = UDim.new(0, l or 0), PaddingTop = UDim.new(0, t or l or 0), PaddingRight = UDim.new(0, r or l or 0), PaddingBottom = UDim.new(0, b or t or l or 0) }, o)
end

local function gradient(o, top, bottom, rot)
	return new("UIGradient", { Color = ColorSequence.new(top, bottom), Rotation = rot or 90 }, o)
end

local function list(o, dir, gap, halign, valign)
	return new("UIListLayout", {
		FillDirection = dir or Enum.FillDirection.Vertical, Padding = UDim.new(0, gap or 8), SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = halign or Enum.HorizontalAlignment.Left, VerticalAlignment = valign or Enum.VerticalAlignment.Top,
	}, o)
end

local function tween(o, t, props, style, dir)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function darker(c, a)
	return c:Lerp(C(0, 0, 0), a or 0.18)
end

local function lighter(c, a)
	return c:Lerp(WHITE, a or 0.35)
end

local function label(parent, props)
	local p = { BackgroundTransparency = 1, Font = BODY, TextColor3 = INK, TextSize = 16, Text = "", TextXAlignment = Enum.TextXAlignment.Left }
	for k, v in pairs(props) do
		p[k] = v
	end
	return new("TextLabel", p, parent)
end

local function card(parent, props, radius, shadowDepth)
	local outer = new("Frame", { BackgroundTransparency = 1, Size = props.Size or UDim2.fromOffset(100, 100), Position = props.Position or UDim2.new(), AnchorPoint = props.AnchorPoint or Vector2.new(), LayoutOrder = props.LayoutOrder or 0, Name = props.Name or "Card", ZIndex = props.ZIndex or 1, Visible = props.Visible ~= false }, parent)
	local z = props.ZIndex or 1
	local sh = new("Frame", { Name = "Shadow", Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(0, shadowDepth or 5), BackgroundColor3 = props.ShadowColor or C(60, 40, 90), BackgroundTransparency = 0.86, BorderSizePixel = 0, ZIndex = z }, outer)
	corner(sh, radius or 18)
	local body = new("Frame", { Name = "Body", Size = UDim2.fromScale(1, 1), BackgroundColor3 = props.Color or CARD, BorderSizePixel = 0, ZIndex = z, ClipsDescendants = props.Clip == true }, outer)
	corner(body, radius or 18)
	if props.Stroke ~= false then
		stroke(body, props.StrokeColor or WHITE, props.StrokeThickness or 2, props.StrokeTransparency or 0.2)
	end
	return outer, body
end

local function pressable(btn, scaleTarget)
	local sc = new("UIScale", { Scale = 1 }, scaleTarget or btn)
	btn.MouseButton1Down:Connect(function() tween(sc, 0.08, { Scale = 0.93 }) end)
	btn.MouseButton1Up:Connect(function() tween(sc, 0.18, { Scale = 1 }, Enum.EasingStyle.Back) end)
	btn.MouseLeave:Connect(function() tween(sc, 0.15, { Scale = 1 }) end)
	return sc
end

local function pill(parent, text, color, onClick, props)
	props = props or {}
	local size = props.Size or UDim2.fromOffset(140, 46)
	local outer = new("Frame", { Name = props.Name or "Pill", BackgroundTransparency = 1, Size = size, Position = props.Position or UDim2.new(), AnchorPoint = props.AnchorPoint or Vector2.new(), LayoutOrder = props.LayoutOrder or 0, ZIndex = props.ZIndex or 1 }, parent)
	local z = props.ZIndex or 1
	local holder = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = z }, outer)
	local lip = new("Frame", { Name = "Lip", Size = UDim2.new(1, 0, 1, 0), Position = UDim2.fromOffset(0, 4), BackgroundColor3 = darker(color, 0.22), BorderSizePixel = 0, ZIndex = z }, holder)
	local face = new("TextButton", {
		Name = "Face", Size = UDim2.fromScale(1, 1), BackgroundColor3 = color, BorderSizePixel = 0, AutoButtonColor = false,
		Text = text, Font = HEAD, TextSize = props.TextSize or 18, TextColor3 = props.TextColor or WHITE, TextWrapped = true, ZIndex = z,
		RichText = props.RichText == true,
	}, holder)
	local r = props.Radius or 16
	corner(lip, r)
	corner(face, r)
	new("UIGradient", { Color = ColorSequence.new(WHITE, C(235, 235, 235)), Rotation = 90 }, face)
	pressable(face, holder)
	if onClick then
		face.Activated:Connect(function()
			UI.Sfx("click")
			onClick()
		end)
	end
	local api = { outer = outer, face = face, lip = lip }
	function api.SetColor(c)
		face.BackgroundColor3 = c
		lip.BackgroundColor3 = darker(c, 0.22)
	end
	function api.SetText(t)
		face.Text = t
	end
	return api
end

local function rarityColor(r)
	return CarConfig.Rarities[r].color
end

local function clearChildren(f)
	for _, k in ipairs(f:GetChildren()) do
		if k:IsA("GuiObject") then
			k:Destroy()
		end
	end
end

local function fitCamera(vp, model, angle)
	local cam = vp.CurrentCamera
	if not cam then
		cam = new("Camera", { FieldOfView = 40 }, vp)
		vp.CurrentCamera = cam
	end
	local size = model:GetExtentsSize()
	local d = math.max(size.X, size.Z, size.Y * 1.6) * 1.35
	local a = angle or math.rad(35)
	local center = Vector3.new(0, size.Y * 0.45, 0)
	cam.CFrame = CFrame.lookAt(center + Vector3.new(math.cos(a) * d, d * 0.42, math.sin(a) * d), center)
end

function UI.Sfx(name)
	local s = sounds[name]
	if s then
		s:Play()
	end
end

local function makeSound(name, id, vol, speed)
	sounds[name] = new("Sound", { Name = "UI_" .. name, SoundId = id, Volume = vol or 0.5, PlaybackSpeed = speed or 1 }, SoundService)
end

function UI.Toast(text, kind)
	local color = ({ error = CORAL, warn = SUN, good = MINT, pickup = SKY, info = LAV })[kind or "info"] or LAV
	local outer, body = card(hud.toasts, { Size = UDim2.fromOffset(360, 42), LayoutOrder = math.floor(os.clock() * 1000) % 1e9 }, 21, 3)
	local dot = new("Frame", { Size = UDim2.fromOffset(14, 14), Position = UDim2.new(0, 14, 0.5, -7), BackgroundColor3 = color, BorderSizePixel = 0 }, body)
	round(dot)
	local l = label(body, { Position = UDim2.fromOffset(38, 0), Size = UDim2.new(1, -48, 1, 0), Text = text, TextSize = 15, TextWrapped = true, TextTruncate = Enum.TextTruncate.AtEnd })
	local sc = new("UIScale", { Scale = 0.6 }, outer)
	tween(sc, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	local count = 0
	local oldest
	for _, k in ipairs(hud.toasts:GetChildren()) do
		if k:IsA("Frame") then
			count = count + 1
			if not oldest or k.LayoutOrder < oldest.LayoutOrder then
				oldest = k
			end
		end
	end
	if count > 4 and oldest then
		oldest:Destroy()
	end
	if kind == "error" then
		UI.Sfx("err")
	elseif kind == "pickup" then
		UI.Sfx("ping")
	elseif kind == "good" then
		UI.Sfx("good")
	end
	task.delay(2.8, function()
		if outer.Parent then
			tween(sc, 0.25, { Scale = 0.01 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			tween(l, 0.2, { TextTransparency = 1 })
			task.wait(0.27)
			outer:Destroy()
		end
	end)
end

function UI.Notify(payload)
	local key, args = payload.key, payload.args or {}
	local text
	if key == "picked" then
		text = T("n_picked", T("part_" .. tostring(args[1])))
	elseif key == "zoneUnlocked" then
		text = T("n_zoneUnlocked", tostring(args[1]))
	elseif key == "sold" then
		text = T("n_sold", tostring(args[1]), Util.FormatNumber(args[2] or 0))
	else
		text = T("n_" .. tostring(key), table.unpack(args))
	end
	UI.Toast(text, payload.kind)
end

local function partChip(parent, id, order)
	local col = PartConfig.Parts[id].color
	local outer, body = card(parent, { Size = UDim2.fromOffset(62, 66), LayoutOrder = order }, 16, 3)
	local icon = new("Frame", { Size = UDim2.fromOffset(22, 22), Position = UDim2.new(0.5, -11, 0, 7), BackgroundColor3 = col, BorderSizePixel = 0 }, body)
	round(icon)
	gradient(icon, lighter(col, 0.45), col)
	stroke(icon, WHITE, 2)
	local n = label(body, { Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Center, Font = HEAD, TextSize = 18, RichText = true })
	label(body, { Position = UDim2.fromOffset(0, 48), Size = UDim2.new(1, 0, 0, 14), TextXAlignment = Enum.TextXAlignment.Center, Font = BODY2, TextSize = 10, TextColor3 = MUTED, Text = T("part_" .. id) })
	return n
end

local function navButton(parent, icon, text, key, color, order, onClick)
	local holder = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(82, 98), LayoutOrder = order }, parent)
	local b = pill(holder, icon, color, onClick, { Size = UDim2.fromOffset(72, 72), Position = UDim2.fromOffset(5, 0), Radius = 36, TextSize = 32 })
	stroke(b.face, WHITE, 3)
	label(holder, { Position = UDim2.fromOffset(0, 78), Size = UDim2.new(1, 0, 0, 18), Text = text .. (UserInputService.KeyboardEnabled and ("  [" .. key .. "]") or ""), TextXAlignment = Enum.TextXAlignment.Center, Font = HEAD, TextSize = 14, TextColor3 = WHITE, TextStrokeTransparency = 0.55, TextStrokeColor3 = INK })
	local badge = new("Frame", { Size = UDim2.fromOffset(18, 18), Position = UDim2.fromOffset(60, -2), BackgroundColor3 = CORAL, BorderSizePixel = 0, Visible = false, ZIndex = 3 }, holder)
	round(badge)
	stroke(badge, WHITE, 2)
	return b, badge
end

local function buildHud()
	local left = new("Frame", { Name = "Left", Position = UDim2.fromOffset(14, 10), Size = UDim2.fromOffset(240, 200), BackgroundTransparency = 1 }, root)
	list(left, nil, 8)
	local _, mb = card(left, { Size = UDim2.fromOffset(240, 66), LayoutOrder = 1 }, 22)
