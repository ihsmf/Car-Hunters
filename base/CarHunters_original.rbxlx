	end
	label(body, { Position = UDim2.fromOffset(0, 114), Size = UDim2.new(1, 0, 0, 14), Text = T("throw_odds"), Font = BODY, TextSize = 11, TextColor3 = MUTED })
	local oddsBar = new("Frame", { Position = UDim2.fromOffset(0, 130), Size = UDim2.new(1, 0, 0, 12), BackgroundColor3 = CARD2, BorderSizePixel = 0, ClipsDescendants = true }, body)
	round(oddsBar)
	list(oddsBar, Enum.FillDirection.Horizontal, 0)
	local oddsLabels = new("Frame", { Position = UDim2.fromOffset(0, 144), Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1 }, body)
	list(oddsLabels, Enum.FillDirection.Horizontal, 0)
	panels.oddsSeg, panels.oddsTxt = {}, {}
	for i, r in ipairs(CarConfig.RarityOrder) do
		panels.oddsSeg[r] = new("Frame", { Size = UDim2.fromScale(0.2, 1), BackgroundColor3 = rarityColor(r), BorderSizePixel = 0, LayoutOrder = i }, oddsBar)
		panels.oddsTxt[r] = label(oddsLabels, { Size = UDim2.fromScale(0.2, 1), TextXAlignment = Enum.TextXAlignment.Center, Font = BODY, TextSize = 11, TextColor3 = darker(rarityColor(r), 0.15), LayoutOrder = i })
	end
	panels.throwBtn = pill(body, T("btn_throw"), MINT, function()
		if state.selectedPart then
			actions.Throw(state.selectedPart)
		end
	end, { Position = UDim2.new(0, 0, 1, -52), Size = UDim2.new(1, 0, 0, 48), TextSize = 24 })
	panels.throw = outer
	panels.throwScale = new("UIScale", { Scale = 1 }, outer)
end

