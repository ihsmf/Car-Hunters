	local outer, body = card(root, { Name = "Throw", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -16), Size = UDim2.fromOffset(440, 236), Visible = false }, 26)
	padding(body, 14, 12, 14, 14)
