	gradient(head, lighter(accent, 0.25), accent)
	new("Frame", { Size = UDim2.new(1, 0, 0, 28), Position = UDim2.new(0, 0, 1, -28), BackgroundColor3 = CARD, BorderSizePixel = 0, ZIndex = 10 }, head)
	label(head, { Position = UDim2.fromOffset(24, 10), Size = UDim2.new(1, -120, 0, 34), Text = title, Font = HEAD, TextSize = 28, TextColor3 = WHITE, ZIndex = 11 })
	local sub = label(head, { Position = UDim2.fromOffset(24, 46), Size = UDim2.new(1, -200, 0, 20), Text = "", Font = BODY, TextSize = 13, TextColor3 = MUTED, ZIndex = 11 })
	local close = pill(body, "X", CORAL, function() UI.TogglePanel(name, false) end, { Size = UDim2.fromOffset(44, 44), Position = UDim2.new(1, -58, 0, 12), Radius = 22, ZIndex = 12, TextSize = 20 })
	stroke(close.face, WHITE, 3)
	local content = new("Frame", { Name = "Content", Position = UDim2.fromOffset(20, 78), Size = UDim2.new(1, -40, 1, -94), BackgroundTransparency = 1, ZIndex = 10 }, body)
	local sc = new("UIScale", { Scale = 1 }, outer)
	return { outer = outer, body = body, content = content, sub = sub, scale = sc, head = head }
end

