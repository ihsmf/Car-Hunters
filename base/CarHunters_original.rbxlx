	panels.slotBtn = pill(actionsRow, T("btn_buyslot"), MINT, function()
		local st = store.State
		if st then
			actions.BuySlot(st.slots)
		end
	end, { Size = UDim2.fromOffset(200, 40), TextSize = 16, ZIndex = 11, LayoutOrder = 2 })
	label(c, { Position = UDim2.fromOffset(4, 52), Size = UDim2.fromOffset(200, 18), Text = T("garage_slots"), Font = HEAD, TextSize = 15, TextColor3 = MUTED, ZIndex = 10 })
	panels.slots = new("Frame", { Position = UDim2.fromOffset(0, 72), Size = UDim2.new(1, 0, 0, 120), BackgroundTransparency = 1, ZIndex = 10 }, c)
	new("UIGridLayout", { CellSize = UDim2.fromOffset(102, 54), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }, panels.slots)
	label(c, { Position = UDim2.fromOffset(4, 196), Size = UDim2.fromOffset(200, 18), Text = T("garage_cars"), Font = HEAD, TextSize = 15, TextColor3 = MUTED, ZIndex = 10 })
	panels.carList = scroller(c, UDim2.fromOffset(0, 218), UDim2.new(1, 0, 1, -218))
	list(panels.carList, nil, 8)
	padding(panels.carList, 2, 2, 10, 8)
	panels.garage = p
end

local function sortedCars(st)
	local out = {}
	for _, c in ipairs(st.cars) do
		table.insert(out, c)
	end
	table.sort(out, function(a, b)
		local da, db = CarConfig.ById[a.typeId], CarConfig.ById[b.typeId]
		local ia, ib = CarConfig.IncomeAt(da, a.level), CarConfig.IncomeAt(db, b.level)
		if ia ~= ib then return ia > ib end
		return a.uid < b.uid
	end)
	return out
end

local function bestSlotFor(st)
	local used = {}
	local worst, worstInc
	for _, c in ipairs(st.cars) do
		if c.slot then
			used[c.slot] = true
			local inc = CarConfig.IncomeAt(CarConfig.ById[c.typeId], c.level)
			if not worstInc or inc < worstInc then
				worst, worstInc = c.slot, inc
			end
		end
	end
	if state.selectedSlot and state.selectedSlot <= st.slots then
		return state.selectedSlot
	end
	for i = 1, st.slots do
		if not used[i] then return i end
	end
	return worst or 1
end

local function upgradeAffordable(st, c)
	local def = CarConfig.ById[c.typeId]
	if c.level >= def.maxLevel then
		return false
	end
	local cost = CarConfig.UpgradeCost(def, c.level)
	local partId, amount = CarConfig.UpgradeParts(def, c.level)
	return store.Money >= cost and (st.parts[partId] or 0) >= amount
end

local function refreshSlotButton()
	local st = store.State
	local nextSlot = st.slots + 1
	local cost = EconomyConfig.SlotCosts[nextSlot]
	if not cost then
		panels.slotBtn.SetText(T("btn_max"))
		panels.slotBtn.SetColor(GREY)
	else
		panels.slotBtn.SetText(T("btn_buyslot") .. "  $" .. Util.FormatNumber(cost))
		panels.slotBtn.SetColor(store.Money >= cost and MINT or GREY)
	end
end

local function refreshUpgradeColors()
	local st = store.State
	if not st then return end
	for _, u in ipairs(upgradeButtons) do
		if u.btn.face.Parent then
			u.btn.SetColor(upgradeAffordable(st, u.car) and SKY or GREY)
		end
	end
end

local function refreshGarage()
	local st = store.State
	if not st or state.open ~= "garage" then return end
	local p = panels.garage
	p.sub.Text = string.format("%s: +%s/s   %d %s", T("hud_income"), Util.FormatNumber(store.Income), #st.cars, T("garage_cars"))
	refreshSlotButton()
	clearChildren(panels.slots)
	local bySlot = {}
	for _, c in ipairs(st.cars) do
		if c.slot then bySlot[c.slot] = c end
	end
	for i = 1, EconomyConfig.MaxSlots do
		local c = bySlot[i]
		local unlocked = i <= st.slots
		local col, txtCol = CARD2, MUTED
		local text = tostring(i)
		if unlocked and c then
			local def = CarConfig.ById[c.typeId]
			col = CarConfig.Rarities[def.rarity].soft
			txtCol = INK
			text = string.format('<font size="12" color="#8a839e">%d</font>\n%s', i, def.name)
		elseif unlocked then
			text = string.format('<font size="12">%d</font>\nFree', i)
		else
			text = "Locked"
			col = C(236, 232, 240)
		end
		local b = new("TextButton", { BackgroundColor3 = col, Text = text, RichText = true, Font = HEAD, TextSize = 13, TextColor3 = txtCol, TextWrapped = true, AutoButtonColor = false, LayoutOrder = i, BorderSizePixel = 0, ZIndex = 11 }, panels.slots)
		corner(b, 14)
		if state.selectedSlot == i then
			stroke(b, SUN, 3)
		elseif c then
			stroke(b, rarityColor(CarConfig.ById[c.typeId].rarity), 2)
		else
			stroke(b, LINE, 2)
		end
		pressable(b)
		b.Activated:Connect(function()
			if unlocked then
				state.selectedSlot = (state.selectedSlot == i) and nil or i
				UI.Sfx("click")
				refreshGarage()
			end
		end)
	end

	clearChildren(panels.carList)
	upgradeButtons = {}
	local cars = sortedCars(st)
	if #cars == 0 then
		label(panels.carList, { Size = UDim2.new(1, 0, 0, 60), Text = T("garage_empty"), TextWrapped = true, TextColor3 = MUTED, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 11 })
		return
	end
	local now = os.clock()
	for i, c in ipairs(cars) do
		local def = CarConfig.ById[c.typeId]
		local rc = rarityColor(def.rarity)
		local outer, body = card(panels.carList, { Size = UDim2.new(1, -4, 0, 72), LayoutOrder = i, Color = WHITE, StrokeColor = LINE, ZIndex = 11 }, 18, 3)
		local band = new("Frame", { Size = UDim2.new(0, 8, 1, -16), Position = UDim2.fromOffset(8, 8), BackgroundColor3 = rc, BorderSizePixel = 0, ZIndex = 11 }, body)
		round(band)
		label(body, { Position = UDim2.fromOffset(26, 10), Size = UDim2.fromOffset(220, 24), Text = def.name, Font = HEAD, TextSize = 18, ZIndex = 11 })
		local tag = label(body, { Position = UDim2.fromOffset(26, 38), Size = UDim2.fromOffset(78, 22), Text = T("rarity_" .. def.rarity), Font = HEAD, TextSize = 12, TextColor3 = darker(rc, 0.2), BackgroundTransparency = 0, BackgroundColor3 = CarConfig.Rarities[def.rarity].soft, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 11 })
		round(tag)
		local where = c.slot and T("car_parked", c.slot) or T("car_stored")
		label(body, { Position = UDim2.fromOffset(112, 38), Size = UDim2.fromOffset(170, 22), Text = T("car_level", c.level) .. "  \u{2022}  " .. T("car_income", Util.FormatNumber(CarConfig.IncomeAt(def, c.level))) .. "  \u{2022}  " .. where, Font = BODY, TextSize = 12, TextColor3 = MUTED, ZIndex = 11 })

		local btns = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, -2), Size = UDim2.fromOffset(352, 44), BackgroundTransparency = 1, ZIndex = 11 }, body)
		list(btns, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
		if c.slot then
			pill(btns, T("btn_remove"), PEACH, function() actions.Remove(c.uid) end, { Size = UDim2.fromOffset(78, 40), TextSize = 14, ZIndex = 12, LayoutOrder = 1 })
		else
			pill(btns, T("btn_place"), MINT, function() actions.Place(c.uid, bestSlotFor(st)) end, { Size = UDim2.fromOffset(78, 40), TextSize = 14, ZIndex = 12, LayoutOrder = 1 })
		end
		if c.level >= def.maxLevel then
			pill(btns, T("btn_max"), GREY, nil, { Size = UDim2.fromOffset(180, 40), TextSize = 14, ZIndex = 12, LayoutOrder = 2 })
		else
			local cost = CarConfig.UpgradeCost(def, c.level)
			local partId, amount = CarConfig.UpgradeParts(def, c.level)
			local delta = CarConfig.IncomeAt(def, c.level + 1) - CarConfig.IncomeAt(def, c.level)
			local txt = string.format('%s <font size="12">+%s/s</font>\n<font size="11">$%s + %d %s</font>', T("btn_upgrade"), Util.FormatNumber(delta), Util.FormatNumber(cost), amount, T("part_" .. partId))
			local b = pill(btns, txt, upgradeAffordable(st, c) and SKY or GREY, function() actions.Upgrade(c.uid, c.level) end, { Size = UDim2.fromOffset(180, 40), TextSize = 15, ZIndex = 12, LayoutOrder = 2, RichText = true })
			table.insert(upgradeButtons, { btn = b, car = c })
		end
		local armed = state.sellArm[c.uid] and now - state.sellArm[c.uid] < 3
		local price = CarConfig.SellPrice(def, c.level)
		pill(btns, armed and T("btn_sure") or (T("btn_sell") .. "\n$" .. Util.FormatNumber(price)), armed and darker(CORAL, 0.1) or CORAL, function()
			local t = state.sellArm[c.uid]
			if t and os.clock() - t < 3 then
				state.sellArm[c.uid] = nil
				actions.Sell(c.uid)
			else
				state.sellArm[c.uid] = os.clock()
				refreshGarage()
				task.delay(3.1, function()
					if state.open == "garage" then refreshGarage() end
				end)
			end
		end, { Size = UDim2.fromOffset(70, 40), TextSize = 12, ZIndex = 12, LayoutOrder = 3 })
	end
end

local function buildIndex()
	local p = panelShell("index", T("index_title"), 700, 520, LAV)
	local c = p.content
	panels.indexHint = label(c, { Size = UDim2.new(1, 0, 0, 20), Text = T("index_hint"), Font = BODY, TextSize = 13, TextColor3 = MUTED, ZIndex = 10 })
	panels.indexList = scroller(c, UDim2.fromOffset(0, 26), UDim2.new(1, 0, 1, -26))
	list(panels.indexList, nil, 10)
	padding(panels.indexList, 2, 2, 10, 8)
	panels.index = p
end

local function refreshIndex()
	local st = store.State
	if not st or state.open ~= "index" then return end
	local disc = st.discovered or {}
	local found, total, _, mult = CarConfig.IndexStats(disc)
	panels.index.sub.Text = T("index_found", found, total) .. "   \u{2022}   " .. T("index_bonus", string.format("%.2f", mult))
	local owned = {}
	for _, c in ipairs(st.cars) do
		owned[c.typeId] = (owned[c.typeId] or 0) + 1
	end
	clearChildren(panels.indexList)
	for ri, rarity in ipairs(CarConfig.RarityOrder) do
		local rc = rarityColor(rarity)
		local row = new("Frame", { Size = UDim2.new(1, -4, 0, 152), BackgroundTransparency = 1, LayoutOrder = ri, ZIndex = 10 }, panels.indexList)
		local tag = label(row, { Size = UDim2.fromOffset(120, 24), Text = T("rarity_" .. rarity), Font = HEAD, TextSize = 14, TextColor3 = WHITE, BackgroundTransparency = 0, BackgroundColor3 = rc, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 11 })
		round(tag)
		local grid = new("Frame", { Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 120), BackgroundTransparency = 1, ZIndex = 10 }, row)
		list(grid, Enum.FillDirection.Horizontal, 10)
		for ci, def in ipairs(CarConfig.ByRarity[rarity]) do
			local known = disc[def.id] == true
			local _, b = card(grid, { Size = UDim2.new(0.25, -8, 1, -6), LayoutOrder = ci, Color = known and CarConfig.Rarities[rarity].soft or C(236, 232, 240), StrokeColor = known and rc or LINE, ZIndex = 11 }, 18, 3)
			if known then
				local vp = new("ViewportFrame", { Size = UDim2.new(1, -12, 0, 64), Position = UDim2.fromOffset(6, 4), BackgroundTransparency = 1, Ambient = C(200, 200, 215), LightColor = WHITE, LightDirection = Vector3.new(-1, -1, -0.5), ZIndex = 12 }, b)
				local m = VehicleFactory.BuildCar(def)
				m.Parent = vp
				fitCamera(vp, m, math.rad(40))
				label(b, { Position = UDim2.fromOffset(10, 68), Size = UDim2.new(1, -20, 0, 18), Text = def.name, Font = HEAD, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Center, TextScaled = false, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 12 })
				label(b, { Position = UDim2.fromOffset(10, 86), Size = UDim2.new(1, -20, 0, 16), Text = T("car_income", Util.FormatNumber(def.income)) .. (owned[def.id] and ("  x" .. owned[def.id]) or ""), Font = BODY, TextSize = 11, TextColor3 = MUTED, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 12 })
			else
				label(b, { Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 44), Text = "?", Font = HEAD, TextSize = 44, TextColor3 = GREY, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 12 })
				label(b, { Position = UDim2.fromOffset(10, 76), Size = UDim2.new(1, -20, 0, 18), Text = T("index_unknown"), Font = HEAD, TextSize = 14, TextColor3 = MUTED, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 12 })
			end
		end
	end
end

local function buildZones()
	local p = panelShell("zones", T("zones_title"), 640, 500, MINT)
	panels.zoneList = scroller(p.content, UDim2.fromOffset(0, 0), UDim2.new(1, 0, 1, 0))
	list(panels.zoneList, nil, 10)
	padding(panels.zoneList, 2, 2, 10, 8)
	panels.zones = p
end

local function progressBar(parent, y, frac, color, text)
	label(parent, { Position = UDim2.fromOffset(16, y), Size = UDim2.new(0.6, 0, 0, 16), Text = text, Font = BODY, TextSize = 12, TextColor3 = MUTED, ZIndex = 12 })
	local bg = new("Frame", { Position = UDim2.fromOffset(16, y + 18), Size = UDim2.new(1, -220, 0, 12), BackgroundColor3 = CARD2, BorderSizePixel = 0, ZIndex = 12 }, parent)
	round(bg)
	local fill = new("Frame", { Size = UDim2.fromScale(math.clamp(frac, 0.02, 1), 1), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 12 }, bg)
	round(fill)
	gradient(fill, lighter(color, 0.3), color, 0)
end

local function refreshZones()
	local st = store.State
	if not st or state.open ~= "zones" then return end
	clearChildren(panels.zoneList)
	local allDone = true
	for idx = 1, #MapConfig.ZoneOrder do
		local zid = MapConfig.ZoneOrder[idx]
		local zone = MapConfig.Zones[zid]
		local acc = zone.palette.accent
		local open = st.zones[zid] == true
		local req = EconomyConfig.ZoneUnlock[zid]
		if not open then allDone = false end
		local h = open and 64 or 118
		local _, b = card(panels.zoneList, { Size = UDim2.new(1, -4, 0, h), LayoutOrder = idx, Color = WHITE, StrokeColor = LINE, ZIndex = 11 }, 20, 3)
		local band = new("Frame", { Size = UDim2.new(0, 10, 1, -20), Position = UDim2.fromOffset(10, 10), BackgroundColor3 = acc, BorderSizePixel = 0, ZIndex = 12 }, b)
		round(band)
		local inner = new("Frame", { Position = UDim2.fromOffset(18, 0), Size = UDim2.new(1, -18, 1, 0), BackgroundTransparency = 1, ZIndex = 11 }, b)
		label(inner, { Position = UDim2.fromOffset(16, 8), Size = UDim2.fromOffset(300, 26), Text = T("zone_" .. zid), Font = HEAD, TextSize = 22, ZIndex = 12 })
		label(inner, { Position = UDim2.fromOffset(16, 34), Size = UDim2.fromOffset(360, 18), Text = T("zone_desc_" .. zid), Font = BODY2, TextSize = 13, TextColor3 = MUTED, ZIndex = 12 })
		local status = label(inner, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 12), Size = UDim2.fromOffset(96, 26), Text = open and T("zones_open") or T("zones_locked"), Font = HEAD, TextSize = 13, TextColor3 = WHITE, BackgroundTransparency = 0, BackgroundColor3 = open and MINT or GREY, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 12 })
		round(status)
		if not open and req then
			local prevOpen = st.zones[MapConfig.ZoneOrder[idx - 1]] == true
			progressBar(inner, 56, store.Money / req.cost, SUN, string.format("%s  $%s / $%s", T("zones_cost"), Util.FormatNumber(store.Money), Util.FormatNumber(req.cost)))
			progressBar(inner, 84, store.CollectionValue / req.minValue, LAV, string.format("%s  %s / %s", T("zones_value"), Util.FormatNumber(store.CollectionValue), Util.FormatNumber(req.minValue)))
			local can = prevOpen and store.Money >= req.cost and store.CollectionValue >= req.minValue
			pill(inner, prevOpen and T("btn_unlock") or T("zones_need_prev"), can and MINT or GREY, function() actions.Unlock(zid) end, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -14, 1, -14), Size = UDim2.fromOffset(170, 44), TextSize = prevOpen and 18 or 13, ZIndex = 12 })
		end
	end
	if allDone then
		label(panels.zoneList, { Size = UDim2.new(1, 0, 0, 40), Text = T("zones_done"), Font = HEAD, TextSize = 18, TextColor3 = darker(MINT, 0.1), TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 99, ZIndex = 11 })
	end
end

local function buildReveal()
	local dim = new("TextButton", { Name = "RevealDim", Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(30, 20, 50), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Visible = false, ZIndex = 50 }, root)
	local rays = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.47), Size = UDim2.fromOffset(720, 720), BackgroundColor3 = WHITE, BackgroundTransparency = 0.2, BorderSizePixel = 0, ZIndex = 51 }, dim)
	round(rays)
	local raysGrad = new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(0.5, 0.75), NumberSequenceKeypoint.new(1, 1) }) }, rays)
	local outer, body = card(dim, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(400, 430), ZIndex = 52 }, 30, 8)
	local ribbon = label(body, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, -18), Size = UDim2.fromOffset(200, 38), Font = HEAD, TextSize = 20, TextColor3 = WHITE, BackgroundTransparency = 0, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 55 })
	round(ribbon)
	stroke(ribbon, WHITE, 3)
	local title = label(body, { Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 22), Font = HEAD, TextSize = 16, TextColor3 = MUTED, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 53 })
	local vpHolder = new("Frame", { Position = UDim2.fromOffset(20, 52), Size = UDim2.new(1, -40, 0, 170), BorderSizePixel = 0, ZIndex = 53 }, body)
	corner(vpHolder, 22)
	local vpGrad = gradient(vpHolder, WHITE, CARD2)
	local vp = new("ViewportFrame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Ambient = C(190, 190, 205), LightColor = WHITE, LightDirection = Vector3.new(-1, -1.2, -0.6), ZIndex = 54 }, vpHolder)
	local name = label(body, { Position = UDim2.fromOffset(0, 230), Size = UDim2.new(1, 0, 0, 34), Font = HEAD, TextSize = 30, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 53 })
	local tagline = label(body, { Position = UDim2.fromOffset(20, 264), Size = UDim2.new(1, -40, 0, 18), Font = BODY2, TextSize = 13, TextColor3 = MUTED, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 53 })
	local info = label(body, { Position = UDim2.fromOffset(20, 286), Size = UDim2.new(1, -40, 0, 20), Font = HEAD, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 53 })
	local extra = label(body, { Position = UDim2.fromOffset(20, 308), Size = UDim2.new(1, -40, 0, 34), Font = BODY, TextSize = 13, TextColor3 = MUTED, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center, RichText = true, ZIndex = 53 })
	local sc = new("UIScale", { Scale = 1 }, outer)
	local function close()
		if dim.Visible then
			tween(sc, 0.18, { Scale = 0.6 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			tween(dim, 0.18, { BackgroundTransparency = 1 })
			task.delay(0.19, function() dim.Visible = false end)
		end
	end
	pill(body, "Awesome!", MINT, close, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -20), Size = UDim2.fromOffset(200, 50), TextSize = 22, ZIndex = 54 })
	dim.Activated:Connect(close)
	panels.reveal = { dim = dim, rays = rays, raysGrad = raysGrad, ribbon = ribbon, title = title, vp = vp, vpHolder = vpHolder, vpGrad = vpGrad, name = name, tagline = tagline, info = info, extra = extra, scale = sc, close = close }
	RunService.RenderStepped:Connect(function(dt)
		if dim.Visible then
			rays.Rotation = (rays.Rotation + dt * 25) % 360
			local m = panels.revealModel
			if m and m.Parent then
				m:PivotTo(CFrame.Angles(0, os.clock() * 1.1, 0))
			end
		end
	end)
end

function UI.ShowReveal(res)
	local def = CarConfig.ById[res.typeId]
	if not def then return end
	local R = panels.reveal
	local rc = rarityColor(res.rarity)
	if panels.revealModel then panels.revealModel:Destroy() end
	local m = VehicleFactory.BuildCar(def)
	m:PivotTo(CFrame.new())
	m.Parent = R.vp
	panels.revealModel = m
	fitCamera(R.vp, m, math.rad(30))
	R.ribbon.Text = string.upper(T("rarity_" .. res.rarity))
	R.ribbon.BackgroundColor3 = rc
	R.rays.BackgroundColor3 = lighter(rc, 0.2)
	R.vpGrad.Color = ColorSequence.new(WHITE, CarConfig.Rarities[res.rarity].soft)
	R.title.Text = res.isNew and T("reveal_new") or T("reveal_got")
	R.name.Text = def.name
	R.name.TextColor3 = darker(rc, 0.15)
	R.tagline.Text = def.tag or ""
	R.info.Text = T("car_income", Util.FormatNumber(def.income)) .. "   \u{2022}   " .. (res.slot and T("reveal_placed", res.slot) or T("reveal_stored"))
	R.info.TextColor3 = darker(MINT, 0.15)
	local lines = {}
	if res.isNew and (res.bonus or 0) > 0 then
		table.insert(lines, string.format('<font color="#e8a21c">%s</font>', T("reveal_first", Util.FormatNumber(res.bonus))))
	end
	if res.pityUsed then
		table.insert(lines, string.format('<font color="#9a7cff">%s</font>', T("reveal_pity")))
	end
	R.extra.Text = table.concat(lines, "\n")
	R.dim.BackgroundTransparency = 1
	R.dim.Visible = true
	R.scale.Scale = 0.4
	tween(R.dim, 0.25, { BackgroundTransparency = 0.45 })
	tween(R.scale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	UI.Sfx(CarConfig.IsHighTier(res.rarity) and "fanfare" or "good")
	task.delay(7, function()
		if panels.revealModel == m then R.close() end
	end)
end

local panelMap = {}

function UI.TogglePanel(name, force)
	local p = panelMap[name]
	if not p then return end
	local show = force
	if show == nil then show = state.open ~= name end
	for n, other in pairs(panelMap) do
		if n ~= name and other.outer.Visible then
			other.outer.Visible = false
		end
	end
	if show then
		state.open = name
		p.outer.Visible = true
		p.scale.Scale = 0.85
		tween(p.scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		panels.dim.Visible = true
		tween(panels.dim, 0.2, { BackgroundTransparency = 0.55 })
		UI.Sfx("open")
	else
		if state.open == name then state.open = nil end
		p.outer.Visible = false
		if not state.open then
			panels.dim.Visible = false
			panels.dim.BackgroundTransparency = 1
		end
	end
	UI.Refresh()
end

function UI.SetNearTrap(v)
	if state.nearTrap ~= v then
		state.nearTrap = v
		UI.Refresh()
	end
end

function UI.GetSelectedPart()
	return state.selectedPart
end

local function refreshHud()
	local st = store.State
	if not st then return end
	hud.money.Text = Util.FormatNumber(store.Money)
	local mult = st.indexMult or 1
	hud.income.Text = "+" .. Util.FormatNumber(store.Income) .. "/s" .. (mult > 1.001 and string.format("   x%.2f", mult) or "")
	local carried, cap = store.CarriedTotal(), st.carryCap or EconomyConfig.CarryCapacity
	hud.carry.Text = string.format("%s  %d / %d", T("hud_carry"), carried, cap)
	local frac = carried / math.max(1, cap)
	tween(hud.carryFill, 0.25, { Size = UDim2.fromScale(frac, 1) })
	hud.carryFill.BackgroundColor3 = frac >= 1 and CORAL or (frac > 0.7 and PEACH or SKY)
	for _, id in ipairs(PartConfig.Order) do
		local b, c = store.Banked(id), store.Carried(id)
		hud.chips[id].Text = string.format("%d%s", b, c > 0 and string.format('<font size="13" color="#5aa8ff"> +%d</font>', c) or "")
	end
	local anyUp = false
	for _, c in ipairs(st.cars) do
		if upgradeAffordable(st, c) then
			anyUp = true
			break
		end
	end
	hud.badgeGarage.Visible = anyUp
	local canZone = false
	for idx = 2, #MapConfig.ZoneOrder do
		local zid = MapConfig.ZoneOrder[idx]
		local req = EconomyConfig.ZoneUnlock[zid]
		if not st.zones[zid] and st.zones[MapConfig.ZoneOrder[idx - 1]] and store.Money >= req.cost and store.CollectionValue >= req.minValue then
			canZone = true
		end
	end
	hud.badgeZones.Visible = canZone
end

local function refreshThrow()
	local st = store.State
	if not st then return end
	local show = state.nearTrap and state.open == nil
	if show ~= panels.throw.Visible then
		panels.throw.Visible = show
		if show then
			panels.throwScale.Scale = 0.8
			tween(panels.throwScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	end
	if not state.selectedPart or store.Banked(state.selectedPart) <= 0 then
		state.selectedPart = nil
		for _, id in ipairs(PartConfig.Order) do
			if store.Banked(id) > 0 then
				state.selectedPart = id
				break
			end
		end
	end
	for _, id in ipairs(PartConfig.Order) do
		local t = panels.partTiles[id]
		local n = store.Banked(id)
		local col = PartConfig.Parts[id].color
		local sel = state.selectedPart == id
		t.count.Text = "x" .. n
		t.tile.BackgroundColor3 = sel and lighter(col, 0.55) or (n > 0 and lighter(col, 0.82) or C(240, 237, 243))
		t.stroke.Color = sel and darker(col, 0.05) or (n > 0 and lighter(col, 0.45) or LINE)
		t.stroke.Thickness = sel and 3 or 2
		t.name.TextColor3 = n > 0 and INK or MUTED
	end
	local pid = state.selectedPart or "bolts"
	local pity = st.pity or 0
	local row = CarConfig.DropChances[pid]
	if pity >= EconomyConfig.PityThreshold - 1 then
		row = CarConfig.PityRow(pid)
		panels.pity.Text = T("throw_pity_now")
	else
		panels.pity.Text = T("throw_pity", EconomyConfig.PityThreshold - pity)
	end
	for _, r in ipairs(CarConfig.RarityOrder) do
		local v = row[r]
		panels.oddsSeg[r].Size = UDim2.fromScale(v / 100, 1)
		panels.oddsTxt[r].Text = (v >= 1 and string.format("%d%%", math.floor(v + 0.5)) or (v > 0 and string.format("%.1f%%", v) or "-"))
	end
	panels.throwBtn.SetColor(state.selectedPart and MINT or GREY)
	panels.throwBtn.SetText(state.selectedPart and (T("btn_throw") .. (UserInputService.KeyboardEnabled and "  [E]" or "")) or T("throw_none"))
end

local function refreshHint()
	local st = store.State
	local text
	if st then
		local throws = st.stats and st.stats.throws or 0
		if throws == 0 then
			if store.BankedTotal() == 0 and store.CarriedTotal() == 0 then
				text = T("tut_find")
			elseif store.BankedTotal() == 0 then
				text = T("tut_return")
			else
				text = T("tut_throw")
			end
		elseif (st.stats.upgrades or 0) == 0 and #st.cars > 0 then
			text = T("tut_upgrade")
		elseif hud.badgeZones.Visible and not st.zones.highway then
			text = T("tut_zone")
		end
	end
	hud.hintOuter.Visible = text ~= nil and state.open == nil
	if text then hud.hint.Text = text end
end

function UI.Refresh()
	if not store.State then return end
	refreshHud()
	refreshThrow()
	refreshHint()
	refreshGarage()
	refreshIndex()
	refreshZones()
end

function UI.SetZoneName(zoneId)
	hud.zone.Text = T("zone_" .. zoneId)
	local z = MapConfig.Zones[zoneId]
	hud.zoneDot.BackgroundColor3 = z and z.palette.accent or MINT
end

function UI.FlashFrame()
	return hud.flash
end

function UI.Init(storeModule, actionTable)
	store, actions = storeModule, actionTable
	local player = Players.LocalPlayer
	gui = new("ScreenGui", { Name = "MainUI", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = false, DisplayOrder = 10 })
	pcall(function() gui.ScreenInsets = Enum.ScreenInsets.CoreUISafe end)
	root = new("Frame", { Name = "Root", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, gui)
	uiScale = new("UIScale", { Scale = 1 }, root)
	local function rescale()
		local vp = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
		local s = math.clamp(math.min(vp.Y / 760, vp.X / 1180), 0.55, 1.25)
		uiScale.Scale = s
		root.Size = UDim2.fromScale(1 / s, 1 / s)
	end
	rescale()
	if Workspace.CurrentCamera then
		Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	end

	makeSound("ping", "rbxasset://sounds/electronicpingshort.wav", 0.45, 1.2)
	makeSound("click", "rbxasset://sounds/button.wav", 0.35)
	makeSound("open", "rbxasset://sounds/swoosh.wav", 0.25, 1.3)
	makeSound("good", "rbxasset://sounds/electronicpingshort.wav", 0.5, 0.9)
	makeSound("fanfare", "rbxasset://sounds/victory.wav", 0.5)
	makeSound("err", "rbxasset://sounds/uuhhh.mp3", 0.3, 1.2)
	makeSound("throw", "rbxasset://sounds/snap.mp3", 0.6)
	makeSound("hit", "rbxasset://sounds/uuhhh.mp3", 0.5)

	panels.dim = new("TextButton", { Name = "Dim", Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(40, 30, 60), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Visible = false, ZIndex = 9 }, root)
	panels.dim.Activated:Connect(function()
		if state.open then UI.TogglePanel(state.open, false) end
	end)

	buildHud()
	buildThrow()
	buildGarage()
	buildIndex()
	buildZones()
	buildReveal()
	panelMap = { garage = panels.garage, index = panels.index, zones = panels.zones }
	gui.Parent = player:WaitForChild("PlayerGui")

	store.Changed.Event:Connect(function() UI.Refresh() end)
	local ticks = 0
	store.MoneyChanged.Event:Connect(function()
		refreshHud()
		ticks = ticks + 1
		if state.open == "garage" and store.State then
			refreshUpgradeColors()
			refreshSlotButton()
			panels.garage.sub.Text = string.format("%s: +%s/s   %d %s", T("hud_income"), Util.FormatNumber(store.Income), #store.State.cars, T("garage_cars"))
		end
		if ticks % 3 == 0 then
			refreshHint()
			if state.open == "zones" then refreshZones() end
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		local kc = input.KeyCode
		if kc == Enum.KeyCode.G then
			UI.TogglePanel("garage")
		elseif kc == Enum.KeyCode.C then
			UI.TogglePanel("index")
		elseif kc == Enum.KeyCode.M or kc == Enum.KeyCode.Z then
			UI.TogglePanel("zones")
		elseif kc == Enum.KeyCode.E then
			if state.nearTrap and state.selectedPart and state.open == nil then
				actions.Throw(state.selectedPart)
			end
		end
	end)
end

return UI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX51"><Properties><string name="Name">WorldFx</string><ProtectedString name="Source"><![CDATA[local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MapConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MapConfig"))

local MOODS = {
	plaza = { clock = 14.3, bright = 2.3, tint = Color3.fromRGB(255, 250, 244), sat = 0.16, amb = Color3.fromRGB(120, 116, 136) },
	city = { clock = 14.3, bright = 2.3, tint = Color3.fromRGB(255, 250, 240), sat = 0.16, amb = Color3.fromRGB(120, 116, 136) },
	highway = { clock = 15.9, bright = 2.2, tint = Color3.fromRGB(255, 244, 226), sat = 0.14, amb = Color3.fromRGB(126, 116, 126) },
	industrial = { clock = 17.3, bright = 2.0, tint = Color3.fromRGB(255, 234, 212), sat = 0.06, amb = Color3.fromRGB(130, 110, 104) },
	neon = { clock = 20.4, bright = 1.4, tint = Color3.fromRGB(228, 214, 255), sat = 0.3, amb = Color3.fromRGB(96, 70, 150) },
}
local mood = { clock = 14.3, bright = 2.3, tint = Color3.fromRGB(255, 250, 244), sat = 0.16, amb = Color3.fromRGB(120, 116, 136) }
local tintFx

local Fx = {}
local spinning = {}
local gates = {}
local store

local function applyGate(part)
	local zone = part:GetAttribute("ZoneId")
	local unlocked = store.State and store.State.zones and store.State.zones[zone] == true
	part.CanCollide = not unlocked
	part.Transparency = unlocked and 1 or 0.5
	for _, g in ipairs(part:GetChildren()) do
		if g:IsA("SurfaceGui") then
			g.Enabled = not unlocked
		end
	end
end

local function addSpin(model)
	local root = model:IsA("Model") and model.PrimaryPart or model:FindFirstChild("Root")
	if not root then
		task.wait(0.2)
		root = model.PrimaryPart or model:FindFirstChild("Root")
	end
	if root then
		spinning[model] = { root = root, base = root.CFrame, phase = math.random() * 6 }
	end
end

function Fx.Start(storeModule)
	store = storeModule
	for _, m in ipairs(CollectionService:GetTagged("SpinBob")) do
		task.spawn(addSpin, m)
	end
	CollectionService:GetInstanceAddedSignal("SpinBob"):Connect(function(m)
		task.spawn(addSpin, m)
	end)
	CollectionService:GetInstanceRemovedSignal("SpinBob"):Connect(function(m)
		spinning[m] = nil
	end)
	local function regGate(p)
		gates[p] = true
		applyGate(p)
	end
	for _, p in ipairs(CollectionService:GetTagged("ZoneGate")) do
		regGate(p)
	end
	CollectionService:GetInstanceAddedSignal("ZoneGate"):Connect(regGate)
	store.Changed.Event:Connect(function()
		for p in pairs(gates) do
			if p.Parent then
				applyGate(p)
			end
		end
	end)
	tintFx = Lighting:FindFirstChild("ZoneTint") or Instance.new("ColorCorrectionEffect")
	tintFx.Name = "ZoneTint"
	tintFx.Parent = Lighting
	RunService.RenderStepped:Connect(function(dt)
		local cam = Workspace.CurrentCamera
		if cam then
			local target = MOODS[MapConfig.ZoneAt(cam.CFrame.Position.Z)] or MOODS.city
			local a = math.min(1, dt * 1.2)
			mood.clock = mood.clock + (target.clock - mood.clock) * a
			mood.bright = mood.bright + (target.bright - mood.bright) * a
			mood.sat = mood.sat + (target.sat - mood.sat) * a
			mood.tint = mood.tint:Lerp(target.tint, a)
			mood.amb = mood.amb:Lerp(target.amb, a)
			Lighting.ClockTime = mood.clock
			Lighting.Brightness = mood.bright
			Lighting.OutdoorAmbient = mood.amb
			tintFx.TintColor = mood.tint
			tintFx.Saturation = mood.sat
		end
		local t = os.clock()
		for m, s in pairs(spinning) do
			if s.root.Parent then
				s.root.CFrame = s.base * CFrame.Angles(0, t * 2 + s.phase, 0) + Vector3.new(0, math.sin(t * 2 + s.phase) * 0.5, 0)
			else
				spinning[m] = nil
			end
		end
	end)
end

function Fx.Hit(dir, flashFrame)
	local char = Players.LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.AssemblyLinearVelocity = dir.Unit * 70 + Vector3.new(0, 40, 0)
	end
	if flashFrame then
		flashFrame.BackgroundTransparency = 0.55
		task.spawn(function()
			for i = 1, 10 do
				flashFrame.BackgroundTransparency = 0.55 + i * 0.045
				task.wait(0.03)
			end
			flashFrame.BackgroundTransparency = 1
		end)
	end
end

return Fx
]]></ProtectedString></Properties></Item></Item></Item></Item></roblox>