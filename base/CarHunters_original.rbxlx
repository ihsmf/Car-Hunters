	round(coin)
	gradient(coin, lighter(SUN, 0.35), darker(SUN, 0.05))
	stroke(coin, WHITE, 2)
	hud.money = label(mb, { Position = UDim2.fromOffset(64, 8), Size = UDim2.new(1, -72, 0, 30), Font = HEAD, TextSize = 28 })
	hud.income = label(mb, { Position = UDim2.fromOffset(64, 38), Size = UDim2.new(1, -72, 0, 18), Font = BODY, TextSize = 14, TextColor3 = darker(MINT, 0.12) })

	local _, zb = card(left, { Size = UDim2.fromOffset(240, 34), LayoutOrder = 2 }, 17, 3)
	hud.zoneDot = new("Frame", { Size = UDim2.fromOffset(12, 12), Position = UDim2.new(0, 14, 0.5, -6), BackgroundColor3 = SKY, BorderSizePixel = 0 }, zb)
	round(hud.zoneDot)
	hud.zone = label(zb, { Position = UDim2.fromOffset(34, 0), Size = UDim2.new(1, -40, 1, 0), Font = HEAD, TextSize = 15 })

	local _, cb = card(left, { Size = UDim2.fromOffset(240, 46), LayoutOrder = 3 }, 17, 3)
	hud.carry = label(cb, { Position = UDim2.fromOffset(14, 5), Size = UDim2.new(1, -28, 0, 18), Font = BODY, TextSize = 13, TextColor3 = MUTED })
	local barBg = new("Frame", { Position = UDim2.fromOffset(14, 27), Size = UDim2.new(1, -28, 0, 10), BackgroundColor3 = CARD2, BorderSizePixel = 0 }, cb)
	round(barBg)
	hud.carryFill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = SKY, BorderSizePixel = 0 }, barBg)
	round(hud.carryFill)

	local bar = new("Frame", { Name = "Parts", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 10), Size = UDim2.fromOffset(5 * 68, 72), BackgroundTransparency = 1 }, root)
	list(bar, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Right)
	hud.chips = {}
	for i, id in ipairs(PartConfig.Order) do
		hud.chips[id] = partChip(bar, id, i)
	end

	local side = new("Frame", { Name = "Nav", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.45, 0), Size = UDim2.fromOffset(82, 3 * 98 + 16), BackgroundTransparency = 1 }, root)
	list(side, nil, 8, Enum.HorizontalAlignment.Center)
	hud.btnGarage, hud.badgeGarage = navButton(side, "\u{1F697}", T("btn_garage"), "G", SKY, 1, function() UI.TogglePanel("garage") end)
	hud.btnIndex, hud.badgeIndex = navButton(side, "\u{2B50}", T("btn_index"), "C", LAV, 2, function() UI.TogglePanel("index") end)
	hud.btnZones, hud.badgeZones = navButton(side, "\u{1F5FA}", T("btn_zones"), "M", MINT, 3, function() UI.TogglePanel("zones") end)

	local hintOuter, hintBody = card(root, { Name = "Hint", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.fromOffset(460, 50), Visible = false }, 25, 4)
	local bulb = new("TextLabel", { Size = UDim2.fromOffset(34, 34), Position = UDim2.new(0, 8, 0.5, -17), BackgroundColor3 = SUN, Text = "!", Font = HEAD, TextSize = 22, TextColor3 = WHITE, BorderSizePixel = 0 }, hintBody)
	round(bulb)
	hud.hint = label(hintBody, { Position = UDim2.fromOffset(52, 0), Size = UDim2.new(1, -62, 1, 0), TextSize = 15, TextWrapped = true })
	hud.hintOuter = hintOuter
	task.spawn(function()
		local sc = new("UIScale", { Scale = 1 }, hintOuter)
		while true do
			if hintOuter.Visible then
				tween(sc, 0.9, { Scale = 1.03 }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
				task.wait(0.9)
				tween(sc, 0.9, { Scale = 1 }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
				task.wait(0.9)
			else
				task.wait(0.5)
			end
		end
	end)

	hud.toasts = new("Frame", { Name = "Toasts", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 70), Size = UDim2.fromOffset(360, 240), BackgroundTransparency = 1, ZIndex = 30 }, root)
	list(hud.toasts, nil, 6, Enum.HorizontalAlignment.Center)

	hud.flash = new("Frame", { Name = "HitFlash", Size = UDim2.fromScale(1, 1), BackgroundColor3 = CORAL, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 40, Active = false }, root)
end

