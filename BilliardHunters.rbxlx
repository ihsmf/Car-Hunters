,0.048,0.252,0.081,0.048,0.252,0.081,0.048,0.252,0.081,0.048,0.252,-0.152,0.016,0.166,-0.152,0.016,0.166,-0.152,0.016,0.166,-0.152,0.016,0.166,-0.152,0.016,0.166,-0.266,0.032,0.054,-0.266,0.032,0.054,-0.266,0.032,0.054,-0.266,0.032,0.054,-0.266,0.032,0.054,-0.237,0.087,-0.089,-0.237,0.087,-0.089,-0.237,0.087,-0.089,-0.237,0.087,-0.089,-0.237,0.087,-0.089,-0.095,0.03,-0.242,-0.095,0.03,-0.242,-0.095,0.03,-0.242,-0.095,0.03,-0.242,-0.095,0.03,-0.242,0.017,0.074,-0.259,0.017,0.074,-0.259,0.017,0.074,-0.259,0.017,0.074,-0.259,0.192,0.046,-0.224,0.192,0.046,-0.224,0.192,0.046,-0.224,0.192,0.046,-0.224,0.099,0.274,0.053,0.099,0.274,0.053,0.099,0.274,0.053,0.099,0.274,0.053,0.16,0.25,-0.048,0.16,0.25,-0.048,0.16,0.25,-0.048,0.04,0.318,0.097,0.04,0.318,0.097,0.04,0.318,0.097,0.04,0.318,0.097,-0.074,0.311,0.078,-0.074,0.311,0.078,-0.074,0.311,0.078,-0.074,0.311,0.078,-0.123,0.308,0.026,-0.123,0.308,0.026,-0.123,0.308,0.026,-0.123,0.308,0.026,-0.113,0.319,-0.082,-0.113,0.319,-0.082,-0.113,0.319,-0.082,-0.113,0.319,-0.082,-0.072,0.302,-0.144,-0.072,0.302,-0.144,-0.072,0.302,-0.144,-0.072,0.302,-0.144,0.022,0.246,-0.169,0.022,0.246,-0.169,0.022,0.246,-0.169,0.022,0.246,-0.169,0.107,0.259,-0.142,0.107,0.259,-0.142,0.107,0.259,-0.142,0.015,0.5,-0.046,0.015,0.5,-0.046,0.015,0.5,-0.046,0.015,0.5,-0.046,0.015,0.5,-0.046,0.015,0.5,-0.046,0.015,0.5,-0.046,0.015,0.5,-0.046 },
