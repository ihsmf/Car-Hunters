<roblox version="4"><Item class="ReplicatedStorage" referent="RBX8"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX1"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX0"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Все игровые константы и UI-токены (соответствуют макету Figma)
local C = {}

local rgb = Color3.fromRGB

C.UI = {
	Font = Font.new("rbxasset://fonts/families/FredokaOne.json", Enum.FontWeight.Bold),
	Stroke = rgb(40, 20, 60),
	Panel = rgb(255, 244, 222),
	Accent = rgb(255, 190, 40),
	Buttons = {
		Settings = { "⚙️", "Настройки", rgb(120, 140, 255) },
		Inventory = { "🎒", "Инвентарь", rgb(90, 210, 120) },
		Daily = { "🎁", "Бонус", rgb(255, 120, 170) },
		Shop = { "💎", "Магазин", rgb(255, 175, 40) },
	},
}

C.Sounds = {
	Music = "rbxassetid://1837849285",
	Hit = "rbxassetid://9119720940",
	Pocket = "rbxassetid://9118823101",
	Click = "rbxassetid://6895079853",
	Reward = "rbxassetid://9125402735",
}

-- 25 редкостей: name, color, тема персонажей. Доход растёт x2.2 за ступень
local R = {
	{ "Обычный", rgb(200, 200, 200), "Новичок" }, { "Необычный", rgb(90, 220, 90), "Любитель" },
	{ "Редкий", rgb(70, 150, 255), "Снайпер" }, { "Эпический", rgb(170, 80, 255), "Граф" },
	{ "Легендарный", rgb(255, 170, 0), "Король" }, { "Мифический", rgb(255, 60, 90), "Дракон" },
	{ "Древний", rgb(190, 140, 90), "Фараон" }, { "Ледяной", rgb(160, 230, 255), "Йети" },
	{ "Огненный", rgb(255, 100, 30), "Феникс" }, { "Токсичный", rgb(150, 255, 40), "Мутант" },
	{ "Кибер", rgb(0, 255, 200), "Робот" }, { "Пиратский", rgb(120, 80, 40), "Капитан" },
	{ "Самурай", rgb(220, 30, 50), "Ронин" }, { "Призрачный", rgb(200, 220, 255), "Призрак" },
	{ "Божественный", rgb(255, 240, 120), "Ангел" }, { "Демонический", rgb(140, 0, 30), "Демон" },
	{ "Небесный", rgb(120, 255, 255), "Небожитель" }, { "Звёздный", rgb(255, 255, 200), "Звездочёт" },
	{ "Космический", rgb(110, 60, 230), "Астронавт" }, { "Галактический", rgb(60, 20, 140), "Император" },
	{ "Радужный", rgb(255, 120, 255), "Единорог" }, { "Квантовый", rgb(40, 200, 255), "Учёный" },
	{ "Секретный", rgb(30, 30, 30), "Аноним" }, { "Глитч", rgb(255, 0, 255), "Ошибка" },
	{ "Абсолютный", rgb(255, 0, 140), "Бог Бильярда" },
}
local titles = { "Юный", "Ловкий", "Мастер", "Великий" }

C.Rarities, C.Characters = {}, {} -- C.Rarities[i] = {name, color, income}
for r, v in R do
	local inc = math.floor(2.2 ^ (r - 1))
	C.Rarities[r] = { v[1], v[2], inc }
	for i, t in titles do
		table.insert(C.Characters, {
			name = t .. " " .. v[3],
			rarity = r,
			income = math.floor(inc * (1 + (i - 1) * 0.3)),
			shirt = v[2]:Lerp(rgb(255, 255, 255), (i - 1) * 0.18),
		})
	end
end

C.Table = { Length = 900, Width = 48, StartZ = 70, Lanes = 4 }
C.LuckCycle = 45 -- каждые N секунд стол сдвигает редкости вверх
C.MaxLuckShift = 4
C.ThrowCooldown = 1
C.Anim = { Windup = 0.9, Slide = 0.7 }
function C.RollTime(dist) return 1.2 + dist / 130 end
function C.ThrowTime(dist) return C.Anim.Windup + C.RollTime(dist) + C.Anim.Slide end -- до падения в лузу
C.MaxEquipped = 8
C.MaxInventory = 100

C.Cues = { -- name, distance mult, price (Cash), color
	{ "Деревянный", 1, 0, rgb(160, 110, 60) },
	{ "Клёновый", 1.3, 500, rgb(230, 190, 120) },
	{ "Карбоновый", 1.7, 5000, rgb(50, 50, 55) },
	{ "Золотой", 2.3, 50000, rgb(255, 200, 40) },
	{ "Алмазный", 3, 500000, rgb(140, 240, 255) },
	{ "Неоновый", 4, 5e6, rgb(255, 60, 220) },
	{ "Лавовый", 5.5, 5e7, rgb(255, 80, 0) },
	{ "Звёздный", 7.5, 5e8, rgb(255, 255, 180) },
	{ "Галактический", 10, 5e9, rgb(90, 40, 200) },
	{ "Абсолютный", 14, 5e10, rgb(255, 0, 140) },
}

function C.LiftCost(lvl) return math.floor(50 * 1.6 ^ (lvl - 1)) end
function C.CueUpCost(lvl) return math.floor(100 * 1.8 ^ (lvl - 1)) end
function C.Distance(power, d)
	local cueMult = math.max(d.passes.DragonCue and 6 or 0, C.Cues[d.cue][2]) * (1 + (d.cueLevel - 1) * 0.1)
	return math.min(C.Table.Length, power * (30 + d.strength * 0.4) * cueMult)
end

-- Заменить 0 на реальные ID из Creator Dashboard
C.GamePasses = {
	Cash2x = { id = 0, icon = "💰", name = "x2 Деньги" },
	Luck2x = { id = 0, icon = "🍀", name = "x2 Удача" },
	DragonCue = { id = 0, icon = "🐉", name = "Кий Дракона" },
	GoldStick = { id = 0, icon = "🪄", name = "Золотая Палка" },
}
C.Products = { -- id -> cash
	{ id = 0, cash = 5000, icon = "💵" },
	{ id = 0, cash = 50000, icon = "💰" },
}

C.Daily = { 100, 250, 500, 1000, 2500, 5000, 15000 }
C.Playtime = { { 5, 300 }, { 15, 1000 }, { 30, 3000 }, { 60, 10000 } } -- минуты, награда

function C.Short(n)
	for _, s in { { 1e15, "Qa" }, { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } } do
		if n >= s[1] then return string.format("%.1f%s", n / s[1], s[2]) end
	end
	return tostring(math.floor(n))
end

return C
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX9"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX4"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX2"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local RS = game:GetService("ReplicatedStorage")
local C = require(RS.Shared.Config)
local Map = require(script.Parent.Map).Build()

local store = DataStoreService:GetDataStore("BilliardV1")
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local Request = Instance.new("RemoteFunction", remotes)
Request.Name = "Request"
local Fx = Instance.new("RemoteEvent", remotes)
Fx.Name = "Fx"
remotes.Parent = RS

local sessions = {} -- player -> {d, slot, passes, join, claimed, lastThrow, lastLift}
local taken = {} -- slot -> player
local luckShift = 0
local rng = Random.new()
local N = #C.Rarities

local function default()
	return { cash = 0, strength = 0, dumbLevel = 1, cue = 1, cues = { ["1"] = true }, cueLevel = 1, inv = {}, daily = { day = 0, streak = 0 } }
end

local function income(s)
	local sum = 0
	for _, it in s.d.inv do
		if it.eq then sum += C.Characters[it.id].income end
	end
	return sum * (s.passes.Cash2x and 2 or 1) * (s.passes.GoldStick and 1.5 or 1)
end

local function sync(plr)
	local s = sessions[plr]
	s.d.passes = s.passes
	Fx:FireClient(plr, "State", { d = s.d, slot = s.slot, income = income(s), luck = luckShift, join = s.join, claimed = s.claimed })
	plr.leaderstats.Cash.Value = math.floor(s.d.cash)
end

-- NPC персонаж с палкой и аурой
local function makeNPC(id, cf, gold)
	local info, r = C.Characters[id], C.Rarities[C.Characters[id].rarity]
	local desc = Instance.new("HumanoidDescription")
	desc.TorsoColor, desc.LeftArmColor, desc.RightArmColor = info.shirt, info.shirt, info.shirt
	desc.HeadColor, desc.LeftLegColor, desc.RightLegColor = Color3.fromRGB(255, 210, 170), Color3.fromRGB(255, 210, 170), r[2]:Lerp(Color3.new(0, 0, 0), 0.4)
	local k = 1 + info.rarity * 0.012
	desc.HeightScale, desc.WidthScale, desc.DepthScale, desc.HeadScale = k, k, k, k
	local m = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	m.Name = info.name
	m.Humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	m.HumanoidRootPart.Anchored = true
	m:PivotTo(cf * CFrame.new(0, 3, 0))

	local stick = Instance.new("Part")
	stick.Shape, stick.Size, stick.CanCollide, stick.Massless = Enum.PartType.Cylinder, Vector3.new(7, 0.3, 0.3), false, true
	stick.Color = gold and Color3.fromRGB(255, 200, 40) or Color3.fromRGB(160, 110, 60)
	stick.Material = gold and Enum.Material.Neon or Enum.Material.Wood
	local hand = m:FindFirstChild("RightHand")
	stick.CFrame = hand.CFrame * CFrame.Angles(0, math.rad(90), math.rad(75))
	local w = Instance.new("WeldConstraint")
	w.Part0, w.Part1, w.Parent = hand, stick, stick
	stick.Parent = m

	local aura = Instance.new("ParticleEmitter")
	aura.Color = ColorSequence.new(r[2])
	aura.LightEmission, aura.Rate, aura.Lifetime = 0.8, 10 + info.rarity * 4, NumberRange.new(1, 1.6)
	aura.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4 + info.rarity * 0.12), NumberSequenceKeypoint.new(1, 0) })
	aura.Speed, aura.SpreadAngle = NumberRange.new(1, 3), Vector2.new(180, 180)
	aura.Transparency = NumberSequence.new(0.3, 1)
	aura.Parent = m.HumanoidRootPart
	local light = Instance.new("PointLight")
	light.Color, light.Range, light.Brightness = r[2], 8 + info.rarity, 1.5
	light.Parent = m.HumanoidRootPart

	-- корона с 8-й редкости, нимб с 15-й
	local function attach(p)
		p.Anchored, p.CanCollide, p.Massless = false, false, true
		local wc = Instance.new("WeldConstraint")
		wc.Part0, wc.Part1, wc.Parent = m.Head, p, p
		p.Parent = m
	end
	if info.rarity >= 8 then
		local crown = Instance.new("Part")
		crown.Shape, crown.Size, crown.Color, crown.Material = Enum.PartType.Cylinder, Vector3.new(0.5, 1.3, 1.3), Color3.fromRGB(255, 200, 40), Enum.Material.Metal
		crown.CFrame = m.Head.CFrame * CFrame.new(0, 0.8, 0) * CFrame.Angles(0, 0, math.pi / 2)
		attach(crown)
	end
	if info.rarity >= 15 then
		local halo = Instance.new("Part")
		halo.Shape, halo.Size, halo.Color, halo.Material = Enum.PartType.Cylinder, Vector3.new(0.15, 2, 2), r[2], Enum.Material.Neon
		halo.CFrame = m.Head.CFrame * CFrame.new(0, 1.6, 0) * CFrame.Angles(0, 0, math.pi / 2)
		attach(halo)
	end

	local bb = Instance.new("BillboardGui")
	bb.Size, bb.StudsOffset, bb.AlwaysOnTop, bb.MaxDistance = UDim2.fromOffset(180, 60), Vector3.new(0, 3.5, 0), true, 80
	for i, t in { { info.name, Color3.new(1, 1, 1) }, { r[1] .. " • 💵" .. C.Short(info.income) .. "/с", r[2] } } do
		local l = Instance.new("TextLabel")
		l.Size, l.Position, l.BackgroundTransparency = UDim2.fromScale(1, 0.5), UDim2.fromScale(0, (i - 1) * 0.5), 1
		l.FontFace, l.TextScaled, l.Text, l.TextColor3 = C.UI.Font, true, t[1], t[2]
		Instance.new("UIStroke", l).Thickness = 2
		l.Parent = bb
	end
	bb.Parent = m.Head
	return m
end

local function refreshBase(plr)
	local s = sessions[plr]
	if not s then return end
	local base = Map.Bases[s.slot]
	base.chars:ClearAllChildren()
	local i = 0
	for _, it in s.d.inv do
		if it.eq and i < C.MaxEquipped then
			i += 1
			makeNPC(it.id, base.slots[i], s.passes.GoldStick).Parent = base.chars
		end
	end
end

local function equippedCount(d)
	local n = 0
	for _, it in d.inv do if it.eq then n += 1 end end
	return n
end

-- Действия игрока
local actions = {}

function actions.Throw(plr, s, power)
	if type(power) ~= "number" or os.clock() < s.nextThrow then return end
	if #s.d.inv >= C.MaxInventory then return false, "Инвентарь полон!" end
	local dist = C.Distance(math.clamp(power, 0, 1), s.d)
	s.nextThrow = os.clock() + C.ThrowTime(dist) + C.ThrowCooldown
	local zone = math.clamp(math.ceil(dist / (C.Table.Length / N)), 1, N)
	local rarity = math.min(zone + luckShift + ((s.passes.Luck2x and rng:NextNumber() < 0.5) and 1 or 0), N)
	local pool = {}
	for id, ch in C.Characters do if ch.rarity == rarity then table.insert(pool, id) end end
	local id = pool[rng:NextInteger(1, #pool)]
	table.insert(s.d.inv, { id = id, eq = equippedCount(s.d) < C.MaxEquipped })
	Fx:FireAllClients("Throw", s.slot, dist, id)
	task.delay(C.ThrowTime(dist), refreshBase, plr)
	return true
end

function actions.Lift(plr, s)
	if os.clock() - s.lastLift < 0.35 then return end
	s.lastLift = os.clock()
	s.d.strength += s.d.dumbLevel
	return true
end

local function pay(s, cost)
	if s.d.cash < cost then return false end
	s.d.cash -= cost
	return true
end

function actions.UpDumb(_, s)
	if not pay(s, C.LiftCost(s.d.dumbLevel)) then return false, "Не хватает денег!" end
	s.d.dumbLevel += 1
	return true
end

function actions.UpCue(_, s)
	if not pay(s, C.CueUpCost(s.d.cueLevel)) then return false, "Не хватает денег!" end
	s.d.cueLevel += 1
	return true
end

function actions.Cue(_, s, i)
	local cue = C.Cues[i]
	if not cue then return end
	if not s.d.cues[tostring(i)] then
		if not pay(s, cue[3]) then return false, "Не хватает денег!" end
		s.d.cues[tostring(i)] = true
	end
	s.d.cue = i
	return true
end

function actions.Equip(plr, s, i)
	local it = s.d.inv[i]
	if not it then return end
	if not it.eq and equippedCount(s.d) >= C.MaxEquipped then return false, "Все места на базе заняты!" end
	it.eq = not it.eq
	refreshBase(plr)
	return true
end

function actions.Sell(plr, s, i)
	local it = s.d.inv[i]
	if not it then return end
	s.d.cash += C.Characters[it.id].income * 30
	table.remove(s.d.inv, i)
	if it.eq then refreshBase(plr) end
	return true
end

function actions.Daily(_, s)
	local day = os.time() // 86400
	local dd = s.d.daily
	if dd.day == day then return false, "Приходи завтра!" end
	dd.streak = (dd.day == day - 1) and dd.streak % #C.Daily + 1 or 1
	dd.day = day
	s.d.cash += C.Daily[dd.streak]
	return true, "+" .. C.Short(C.Daily[dd.streak]) .. " 💵"
end

function actions.Playtime(_, s, i)
	local p = C.Playtime[i]
	if not p or s.claimed[i] or os.time() - s.join < p[1] * 60 then return false, "Ещё рано!" end
	s.claimed[i] = true
	s.d.cash += p[2]
	return true, "+" .. C.Short(p[2]) .. " 💵"
end

function actions.Pass(plr, _, key)
	local gp = C.GamePasses[key]
	if gp and gp.id > 0 then MarketplaceService:PromptGamePassPurchase(plr, gp.id) end
end

function actions.Product(plr, _, i)
	local p = C.Products[i]
	if p and p.id > 0 then MarketplaceService:PromptProductPurchase(plr, p.id) end
end

Request.OnServerInvoke = function(plr, action, arg)
	local s, fn = sessions[plr], actions[action]
	if not (s and fn) then return false end
	local ok, msg = fn(plr, s, arg)
	sync(plr)
	return ok, msg
end

-- Игроки
Players.PlayerAdded:Connect(function(plr)
	local slot
	for i = 1, #Map.Bases do
		if not taken[i] then slot = i break end
	end
	if not slot then plr:Kick("Сервер заполнен") return end
	taken[slot] = plr

	local ok, saved = pcall(store.GetAsync, store, plr.UserId)
	local d = default()
	if ok and saved then for k, v in saved do d[k] = v end end
	local passes = {}
	for key, gp in C.GamePasses do
		if gp.id > 0 then
			local ok2, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, plr.UserId, gp.id)
			passes[key] = ok2 and owns
		end
	end
	if not plr.Parent then taken[slot] = nil return end
	sessions[plr] = { d = d, slot = slot, passes = passes, join = os.time(), claimed = {}, nextThrow = 0, lastLift = 0, loaded = ok }

	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	Instance.new("NumberValue", ls).Name = "Cash"
	ls.Parent = plr
	Map.Bases[slot].sign.Text = "База " .. plr.DisplayName

	local function onChar(char)
		task.wait()
		char:PivotTo(Map.Bases[slot].spawn * CFrame.new(0, 3, 0))
	end
	plr.CharacterAdded:Connect(onChar)
	if plr.Character then onChar(plr.Character) end
	refreshBase(plr)
	sync(plr)
end)

local function save(plr)
	local s = sessions[plr]
	if s and s.loaded then
		s.d.passes = nil
		pcall(store.SetAsync, store, plr.UserId, s.d)
	end
end

Players.PlayerRemoving:Connect(function(plr)
	save(plr)
	local s = sessions[plr]
	if s then
		local base = Map.Bases[s.slot]
		base.chars:ClearAllChildren()
		base.sign.Text = "Свободная база"
		taken[s.slot] = nil
	end
	sessions[plr] = nil
end)

game:BindToClose(function()
	for plr in sessions do save(plr) end
end)

for _, base in Map.Bases do
	base.dumbPrompt.Triggered:Connect(function(plr) Fx:FireClient(plr, "Lift") end)
	base.shopPrompt.Triggered:Connect(function(plr) Fx:FireClient(plr, "Open", "Cues") end)
end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(plr, id, bought)
	local s = sessions[plr]
	if not (s and bought) then return end
	for key, gp in C.GamePasses do if gp.id == id then s.passes[key] = true end end
	refreshBase(plr)
	sync(plr)
end)

MarketplaceService.ProcessReceipt = function(info)
	local plr = Players:GetPlayerByUserId(info.PlayerId)
	local s = plr and sessions[plr]
	if not s then return Enum.ProductPurchaseDecision.NotProcessedYet end
	for _, p in C.Products do
		if p.id == info.ProductId then s.d.cash += p.cash end
	end
	save(plr)
	sync(plr)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- Смена редкостей длинного стола
local function paintZones()
	for i, z in Map.Zones do
		local r = C.Rarities[math.min(i + luckShift, N)]
		z.felt.Color = r[2]:Lerp(Color3.fromRGB(20, 120, 60), 0.35)
		z.text.Text, z.text.TextColor3 = r[1], r[2]
		for _, n in z.neon do n.Color = r[2] end
	end
end
paintZones()

task.spawn(function()
	local t = 0
	while true do
		task.wait(1)
		t += 1
		for plr, s in sessions do
			s.d.cash += income(s)
			plr.leaderstats.Cash.Value = math.floor(s.d.cash)
			Fx:FireClient(plr, "Cash", s.d.cash)
		end
		if t % C.LuckCycle == 0 then
			luckShift = (luckShift + 1) % (C.MaxLuckShift + 1)
			paintZones()
			Fx:FireAllClients("Luck", luckShift)
		end
		if t % 120 == 0 then
			for plr in sessions do task.spawn(save, plr) end
		end
	end
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">Map</string><ProtectedString name="Source"><![CDATA[-- Процедурная карта. Модели (стол, кий, шар, гантеля, ограждение) повторяют
-- геометрию blender/build_models.py и собираются из деталей — загрузка ассетов не нужна.
-- Если в ReplicatedStorage.Models лежат импортированные меши с теми же именами — берутся они.
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local C = require(game.ReplicatedStorage.Shared.Config)

local Models = game.ReplicatedStorage:FindFirstChild("Models")
local rgb = Color3.fromRGB
local M = Enum.Material
local CYL, BALL = Enum.PartType.Cylinder, Enum.PartType.Ball
local Map = { Bases = {}, Zones = {} }

local function part(props, parent)
	local p = Instance.new("Part")
	p.Anchored, p.TopSurface, p.BottomSurface = true, Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	for k, v in props do p[k] = v end
	p.Parent = parent
	return p
end

-- цилиндр вдоль оси Y (как в Blender)
local function ycyl(d, h, cf, color, mat, parent)
	return part({ Shape = CYL, Size = Vector3.new(h, d, d), CFrame = cf * CFrame.Angles(0, 0, math.pi / 2), Color = color, Material = mat }, parent)
end

local function label(parent, face, text, color, ppS)
	local g = Instance.new("SurfaceGui")
	g.Face, g.PixelsPerStud, g.LightInfluence = face, ppS or 40, 0
	local t = Instance.new("TextLabel")
	t.Size, t.BackgroundTransparency, t.TextScaled = UDim2.fromScale(1, 1), 1, true
	t.FontFace, t.Text, t.TextColor3 = C.UI.Font, text, color or Color3.new(1, 1, 1)
	local s = Instance.new("UIStroke")
	s.Color, s.Thickness = C.UI.Stroke, 4
	s.Parent, t.Parent, g.Parent = t, g, parent
	return t
end

local function light(p, color, range, b)
	local l = Instance.new("PointLight")
	l.Color, l.Range, l.Brightness, l.Parent = color, range, b or 1.5, p
end

-- ===== Модели =====
local WOOD, DARK, GOLD = rgb(115, 56, 20), rgb(76, 36, 13), rgb(255, 190, 50)

local Build = {}
function Build.PoolTable(m, cf)
	local L, W = 16, 9
	part({ Size = Vector3.new(W + 1.6, 1.2, L + 1.6), CFrame = cf * CFrame.new(0, 3.2, 0), Color = WOOD, Material = M.Wood }, m)
	part({ Size = Vector3.new(W, 0.2, L), CFrame = cf * CFrame.new(0, 3.9, 0), Color = rgb(13, 128, 51), Material = M.Fabric }, m)
	for _, s in { -1, 1 } do
		part({ Size = Vector3.new(0.8, 0.6, L + 1.6), CFrame = cf * CFrame.new(s * (W / 2 + 0.4), 4.1, 0), Color = DARK, Material = M.Wood }, m)
		part({ Size = Vector3.new(W + 1.6, 0.6, 0.8), CFrame = cf * CFrame.new(0, 4.1, s * (L / 2 + 0.4)), Color = DARK, Material = M.Wood }, m)
		for _, t in { -1, 1 } do -- точёные ножки с золотыми кольцами
			local leg = cf * CFrame.new(s * W / 2.3, 0, t * L / 2.3)
			ycyl(0.9, 2.6, leg * CFrame.new(0, 1.3, 0), DARK, M.Wood, m)
			ycyl(1.4, 0.3, leg * CFrame.new(0, 2.5, 0), GOLD, M.Metal, m)
			ycyl(1.2, 0.3, leg * CFrame.new(0, 0.15, 0), GOLD, M.Metal, m)
		end
		for _, t in { -1, 0, 1 } do -- лузы
			local pc = cf * CFrame.new(s * W / 2, 0, t * L / 2)
			ycyl(1.1, 0.25, pc * CFrame.new(0, 4.02, 0), rgb(5, 5, 5), M.SmoothPlastic, m)
			ycyl(1.4, 0.2, pc * CFrame.new(0, 4.2, 0), GOLD, M.Metal, m).Transparency = 0.2
		end
	end
	for i = -1, 1, 2 do -- ромбы-метки на бортах
		for k = -2, 2 do
			part({ Size = Vector3.new(0.25, 0.05, 0.25), CFrame = cf * CFrame.new(i * (W / 2 + 0.4), 4.42, k * 3) * CFrame.Angles(0, math.rad(45), 0), Color = Color3.new(1, 1, 1), Material = M.Neon }, m)
		end
	end
	local lamp = part({ Size = Vector3.new(4, 0.6, 10), CFrame = cf * CFrame.new(0, 11, 0), Color = rgb(20, 90, 40), Material = M.SmoothPlastic }, m)
	part({ Size = Vector3.new(3.4, 0.2, 9.4), CFrame = cf * CFrame.new(0, 10.65, 0), Color = rgb(255, 245, 200), Material = M.Neon }, m)
	light(lamp, rgb(255, 240, 200), 18, 2)
end

function Build.Cue(m, cf, color)
	color = color or rgb(230, 170, 100)
	ycyl(0.44, 4.5, cf * CFrame.new(0, 2.25, 0), rgb(20, 10, 5), M.Wood, m)
	ycyl(0.47, 0.6, cf * CFrame.new(0, 1.2, 0), rgb(150, 15, 15), M.Fabric, m)
	ycyl(0.34, 4.3, cf * CFrame.new(0, 6.65, 0), color, M.Wood, m)
	ycyl(0.22, 0.25, cf * CFrame.new(0, 8.9, 0), rgb(245, 245, 235), M.SmoothPlastic, m)
	ycyl(0.2, 0.08, cf * CFrame.new(0, 9.06, 0), rgb(25, 80, 230), M.Fabric, m)
	part({ Shape = BALL, Size = Vector3.one * 0.46, CFrame = cf, Color = rgb(20, 10, 5) }, m)
end

function Build.Dumbbell(m, cf)
	local x = cf * CFrame.new(0, 0.9, 0)
	part({ Shape = CYL, Size = Vector3.new(5, 0.5, 0.5), CFrame = x, Color = rgb(205, 205, 215), Material = M.Metal }, m)
	for _, s in { -1, 1 } do
		part({ Shape = CYL, Size = Vector3.new(0.5, 1.8, 1.8), CFrame = x * CFrame.new(s * 2, 0, 0), Color = rgb(242, 51, 51) }, m)
		part({ Shape = CYL, Size = Vector3.new(0.4, 1.4, 1.4), CFrame = x * CFrame.new(s * 1.64, 0, 0), Color = rgb(242, 51, 51) }, m)
		part({ Shape = CYL, Size = Vector3.new(0.3, 0.7, 0.7), CFrame = x * CFrame.new(s * 2.3, 0, 0), Color = rgb(205, 205, 215), Material = M.Metal }, m)
	end
	part({ Size = Vector3.new(6, 0.4, 2.4), CFrame = cf * CFrame.new(0, -0.3, 0), Color = rgb(40, 40, 50), Material = M.Rubber }, m)
end

function Build.Fence(m, cf)
	local len, n = 30, 5
	for i = 0, n do
		local x = -len / 2 + i * len / n
		part({ Size = Vector3.new(0.8, 4, 0.8), CFrame = cf * CFrame.new(x, 2, 0), Color = rgb(255, 248, 235) }, m)
		part({ Shape = BALL, Size = Vector3.one * 1.1, CFrame = cf * CFrame.new(x, 4.2, 0), Color = rgb(255, 248, 235) }, m)
	end
	for _, y in { 1.5, 3.2 } do
		part({ Size = Vector3.new(len, 0.5, 0.4), CFrame = cf * CFrame.new(0, y, 0), Color = rgb(255, 205, 75) }, m)
	end
end

local function model(name, cf, parent, ...)
	local src = Models and Models:FindFirstChild(name)
	local m
	if src then
		m = src:Clone()
		m:PivotTo(cf)
	else
		m = Instance.new("Model")
		m.Name = name
		Build[name](m, cf, ...)
	end
	m.Parent = parent
	return m
end
Map.Model = model

-- ===== Карта =====
function Map.Build()
	local world = Instance.new("Folder")
	world.Name = "World"
	world.Parent = workspace
	local T = C.Table
	local N = #C.Rarities
	local zoneLen = T.Length / N
	local endZ = T.StartZ + T.Length

	-- Освещение
	Lighting.ClockTime, Lighting.Brightness, Lighting.EnvironmentDiffuseScale = 16.5, 2.5, 0.6
	local sky = Instance.new("Sky")
	sky.SunAngularSize, sky.Parent = 14, Lighting
	local atm = Instance.new("Atmosphere")
	atm.Density, atm.Color, atm.Decay, atm.Haze, atm.Glare = 0.28, rgb(255, 210, 230), rgb(140, 120, 255), 1.4, 0.6
	atm.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity, bloom.Size, bloom.Threshold, bloom.Parent = 0.8, 30, 1.3, Lighting
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Saturation, cc.Contrast, cc.TintColor, cc.Parent = 0.25, 0.08, rgb(255, 248, 240), Lighting
	local rays = Instance.new("SunRaysEffect")
	rays.Intensity, rays.Parent = 0.08, Lighting

	-- Остров из Terrain посреди океана
	local terrain = workspace.Terrain
	terrain.WaterColor, terrain.WaterWaveSize, terrain.WaterReflectance = rgb(40, 190, 230), 0.3, 0.6
	terrain:FillBlock(CFrame.new(0, -12, 500), Vector3.new(2400, 16, 2600), M.Water)
	terrain:FillBlock(CFrame.new(0, -4, 490), Vector3.new(720, 8, 1160), M.Grass)
	terrain:FillBlock(CFrame.new(0, -6, 490), Vector3.new(780, 6, 1220), M.Sand)
	local rng = Random.new(7)
	for _ = 1, 70 do -- горы по краю острова
		local a = rng:NextNumber(0, math.pi * 2)
		local pos = Vector3.new(math.cos(a) * 400, 0, 490 + math.sin(a) * 620)
		terrain:FillBall(pos, rng:NextNumber(25, 60), rng:NextInteger(1, 3) == 1 and M.Snow or M.Rock)
	end

	part({ Name = "Plaza", Size = Vector3.new(470, 0.4, 44), CFrame = CFrame.new(0, 0.2, 52), Color = rgb(250, 225, 180), Material = M.Pebble }, world)
	for x = -230, 230, 10 do -- шахматная дорожка
		part({ Size = Vector3.new(5, 0.42, 5), CFrame = CFrame.new(x, 0.21, 52), Color = rgb(255, 255, 255), Material = M.Marble }, world)
	end

	-- Длинный стол
	local long = Instance.new("Model")
	long.Name = "LongTable"
	long.Parent = world
	local midZ = T.StartZ + T.Length / 2
	part({ Size = Vector3.new(T.Width + 8, 3, T.Length + 8), CFrame = CFrame.new(0, 1.5, midZ), Color = WOOD, Material = M.Wood }, long)
	for _, s in { -1, 1 } do
		part({ Size = Vector3.new(2.5, 2.2, T.Length + 8), CFrame = CFrame.new(s * (T.Width / 2 + 2.75), 4.1, midZ), Color = DARK, Material = M.Wood }, long)
		part({ Size = Vector3.new(0.6, 0.4, T.Length + 8), CFrame = CFrame.new(s * (T.Width / 2 + 2.75), 5.3, midZ), Color = GOLD, Material = M.Neon }, long)
	end
	for z = T.StartZ, endZ, 60 do -- ножки
		for _, s in { -1, 1 } do ycyl(3, 1, CFrame.new(s * (T.Width / 2 + 1), 0.5, z), GOLD, M.Metal, long) end
	end
	for l = 1, T.Lanes - 1 do
		part({ Size = Vector3.new(0.3, 0.32, T.Length), CFrame = CFrame.new(-T.Width / 2 + l * T.Width / T.Lanes, 3.17, midZ), Color = Color3.new(1, 1, 1), Transparency = 0.5 }, long)
	end

	-- Зоны: сукно + неоновые ворота с названием редкости
	for i = 1, N do
		local z0 = T.StartZ + (i - 1) * zoneLen
		local felt = part({ Name = "Zone" .. i, Size = Vector3.new(T.Width, 0.3, zoneLen - 0.4), CFrame = CFrame.new(0, 3.15, z0 + zoneLen / 2), Material = M.Fabric }, long)
		local neon = {}
		for _, s in { -1, 1 } do
			table.insert(neon, part({ Size = Vector3.new(1.6, 16, 1.6), CFrame = CFrame.new(s * (T.Width / 2 + 5), 8, z0), Material = M.Neon }, long))
			table.insert(neon, part({ Shape = BALL, Size = Vector3.one * 3.5, CFrame = CFrame.new(s * (T.Width / 2 + 5), 17, z0), Material = M.Neon }, long))
		end
		local beam = part({ Size = Vector3.new(T.Width + 12, 4, 1), CFrame = CFrame.new(0, 17, z0), Color = rgb(40, 25, 60), Material = M.SmoothPlastic }, long)
		table.insert(neon, part({ Size = Vector3.new(T.Width + 12, 0.5, 1.2), CFrame = CFrame.new(0, 15, z0), Material = M.Neon }, long))
		light(beam, Color3.new(1, 1, 1), 30, 1)
		for _, sx in { -1, 1 } do -- лузы зоны по обоим бортам (координаты совпадают с Balls.client)
			local pc = CFrame.new(sx * T.Width / 2, 3.32, z0 + zoneLen / 2)
			ycyl(4.4, 0.2, pc, rgb(5, 5, 5), M.SmoothPlastic, long)
			table.insert(neon, ycyl(5.4, 0.15, pc * CFrame.new(0, -0.05, 0), Color3.new(1, 1, 1), M.Neon, long))
		end
		Map.Zones[i] = { felt = felt, neon = neon, text = label(beam, Enum.NormalId.Front, "", nil, 20) }
		label(beam, Enum.NormalId.Back, "Зона " .. i, nil, 20)
	end

	-- Радужная арка на старте
	local rainbow = { rgb(255, 60, 60), rgb(255, 150, 30), rgb(255, 230, 40), rgb(80, 220, 80), rgb(50, 160, 255), rgb(90, 80, 230), rgb(190, 80, 255) }
	for b, col in rainbow do
		local R = 40 - b * 1.6
		for k = 0, 24 do
			local a = math.pi * k / 24
			part({ Size = Vector3.new(1.6, 1.6, 5.4), CFrame = CFrame.new(math.cos(a) * R, math.sin(a) * R, T.StartZ - 8) * CFrame.Angles(0, 0, a) * CFrame.Angles(math.pi / 2, 0, 0), Color = col, Material = M.Neon, CanCollide = false }, world)
		end
	end
	local sign = part({ Size = Vector3.new(50, 8, 1), CFrame = CFrame.new(0, 26, T.StartZ - 8), Color = rgb(255, 110, 170) }, world)
	label(sign, Enum.NormalId.Front, "🎱 БИЛЬЯРДНЫЕ ОХОТНИКИ 🎱")

	-- Гигантский шар «8» в конце стола
	local eight = part({ Shape = BALL, Size = Vector3.one * 40, CFrame = CFrame.new(0, 32, endZ + 40), Color = rgb(15, 15, 20), Material = M.Glass, Reflectance = 0.15 }, world)
	local circle = part({ Shape = CYL, Size = Vector3.new(1, 18, 18), CFrame = eight.CFrame * CFrame.new(0, 0, -19.7) * CFrame.Angles(0, math.pi / 2, 0), Color = Color3.new(1, 1, 1), Material = M.SmoothPlastic }, world)
	local w = Instance.new("WeldConstraint")
	w.Part0, w.Part1, w.Parent = eight, circle, eight
	circle.Anchored = false
	label(circle, Enum.NormalId.Right, "8", Color3.new(0, 0, 0), 10)
	ycyl(30, 10, CFrame.new(0, 5, endZ + 40), GOLD, M.Metal, world)
	for k = 1, 3 do
		local ring = part({ Shape = CYL, Size = Vector3.new(1, 50 + k * 8, 50 + k * 8), CFrame = eight.CFrame * CFrame.Angles(k, k * 0.7, 0), Color = rainbow[k * 2], Material = M.ForceField, CanCollide = false }, world)
		TweenService:Create(ring, TweenInfo.new(6 + k * 2, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1), { CFrame = ring.CFrame * CFrame.Angles(0, math.pi, 0) }):Play()
	end
	TweenService:Create(eight, TweenInfo.new(5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { CFrame = eight.CFrame * CFrame.new(0, 6, 0) * CFrame.Angles(0, math.rad(30), 0) }):Play()
	light(eight, rgb(200, 120, 255), 60, 3)

	-- Фонтан на площади
	local fc = CFrame.new(0, 0, 30)
	ycyl(16, 2, fc * CFrame.new(0, 1, 0), rgb(240, 240, 250), M.Marble, world)
	ycyl(14, 0.3, fc * CFrame.new(0, 2.05, 0), rgb(80, 200, 255), M.Glass, world).Transparency = 0.3
	ycyl(4, 8, fc * CFrame.new(0, 5, 0), rgb(240, 240, 250), M.Marble, world)
	local top = part({ Shape = BALL, Size = Vector3.one * 5, CFrame = fc * CFrame.new(0, 10, 0), Color = rgb(255, 230, 40), Material = M.Glass }, world)
	local water = Instance.new("ParticleEmitter")
	water.Color, water.Rate, water.Speed, water.SpreadAngle = ColorSequence.new(rgb(150, 230, 255)), 120, NumberRange.new(18, 22), Vector2.new(25, 25)
	water.Acceleration, water.Lifetime, water.Size = Vector3.new(0, -40, 0), NumberRange.new(1.2), NumberSequence.new(0.6, 0.2)
	water.LightEmission, water.Parent = 0.4, top

	-- Летающие бильярдные шары и облака
	local ballColors = { rgb(255, 220, 40), rgb(40, 90, 255), rgb(255, 50, 50), rgb(140, 40, 200), rgb(255, 130, 20), rgb(30, 160, 60), rgb(130, 30, 30) }
	for k = 1, 24 do
		local s = k % 2 == 0 and 1 or -1
		local p = part({ Shape = BALL, Size = Vector3.one * rng:NextNumber(8, 16), CFrame = CFrame.new(s * rng:NextNumber(80, 260), rng:NextNumber(40, 90), rng:NextNumber(120, endZ)), Color = ballColors[k % #ballColors + 1], Material = M.Glass, Reflectance = 0.1, CanCollide = false }, world)
		TweenService:Create(p, TweenInfo.new(rng:NextNumber(3, 6), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { CFrame = p.CFrame + Vector3.new(0, 8, 0) }):Play()
	end
	for _ = 1, 30 do
		local c = Vector3.new(rng:NextNumber(-600, 600), rng:NextNumber(140, 200), rng:NextNumber(-300, 1300))
		for _ = 1, 4 do
			part({ Shape = BALL, Size = Vector3.one * rng:NextNumber(20, 40), CFrame = CFrame.new(c + Vector3.new(rng:NextNumber(-25, 25), rng:NextNumber(-5, 5), rng:NextNumber(-15, 15))), Color = Color3.new(1, 1, 1), Material = M.SmoothPlastic, CanCollide = false, CastShadow = false }, world)
		end
	end

	-- Деревья-леденцы и фонари вдоль стола
	for _ = 1, 90 do
		local s = rng:NextInteger(0, 1) == 0 and -1 or 1
		local pos = Vector3.new(s * rng:NextNumber(60, 320), 0, rng:NextNumber(90, endZ + 60))
		local h = rng:NextNumber(8, 16)
		part({ Size = Vector3.new(1.6, h, 1.6), CFrame = CFrame.new(pos + Vector3.new(0, h / 2, 0)), Color = rgb(130, 80, 40), Material = M.Wood }, world)
		part({ Shape = BALL, Size = Vector3.one * rng:NextNumber(9, 14), CFrame = CFrame.new(pos + Vector3.new(0, h + 3, 0)), Color = Color3.fromHSV(rng:NextNumber(), 0.45, 1), Material = M.SmoothPlastic }, world)
	end
	for z = T.StartZ + 20, endZ, 50 do
		for _, s in { -1, 1 } do
			ycyl(1, 14, CFrame.new(s * 40, 7, z), rgb(60, 60, 70), M.Metal, world)
			light(part({ Shape = BALL, Size = Vector3.one * 2.5, CFrame = CFrame.new(s * 40, 15, z), Color = rgb(255, 240, 180), Material = M.Neon }, world), rgb(255, 230, 170), 30)
		end
	end

	-- Ограждение по периметру: каменная стена, неоновый кант, светящийся барьер и невидимая стена
	local X0, Z0, Z1 = 330, -75, endZ + 75
	local sides = {
		{ CFrame.new(-X0, 0, (Z0 + Z1) / 2), Z1 - Z0 }, { CFrame.new(X0, 0, (Z0 + Z1) / 2), Z1 - Z0 },
		{ CFrame.new(0, 0, Z0) * CFrame.Angles(0, math.pi / 2, 0), 2 * X0 }, { CFrame.new(0, 0, Z1) * CFrame.Angles(0, math.pi / 2, 0), 2 * X0 },
	}
	for _, sd in sides do
		local cf, len = sd[1], sd[2]
		part({ Size = Vector3.new(4, 7, len), CFrame = cf * CFrame.new(0, 3.5, 0), Color = rgb(235, 225, 210), Material = M.Cobblestone }, world)
		part({ Size = Vector3.new(4.6, 0.8, len), CFrame = cf * CFrame.new(0, 7.2, 0), Color = rgb(255, 120, 200), Material = M.Neon }, world)
		part({ Size = Vector3.new(0.4, 40, len), CFrame = cf * CFrame.new(0, 27, 0), Color = rgb(150, 200, 255), Material = M.ForceField, Transparency = 0.3, CanCollide = false, CastShadow = false }, world)
		part({ Size = Vector3.new(2, 400, len), CFrame = cf * CFrame.new(0, 200, 0), Transparency = 1 }, world)
		for k = 0, math.floor(len / 40) do
			local pc = cf * CFrame.new(0, 0, -len / 2 + k * len / math.floor(len / 40))
			part({ Size = Vector3.new(6, 11, 6), CFrame = pc * CFrame.new(0, 5.5, 0), Color = rgb(250, 240, 225), Material = M.Cobblestone }, world)
			light(part({ Shape = BALL, Size = Vector3.one * 4, CFrame = pc * CFrame.new(0, 13, 0), Color = ballColors[k % #ballColors + 1], Material = M.Neon }, world), ballColors[k % #ballColors + 1], 25)
		end
	end

	-- 4 базы
	local baseColors = { rgb(255, 120, 120), rgb(120, 180, 255), rgb(120, 230, 140), rgb(255, 200, 90) }
	for i = 1, 4 do
		local x = (i - 2.5) * 110
		local origin = CFrame.new(x, 0, -10)
		local col = baseColors[i]
		local base = Instance.new("Model")
		base.Name = "Base" .. i
		base.Parent = world
		part({ Name = "Floor", Size = Vector3.new(90, 1, 90), CFrame = origin * CFrame.new(0, 0.5, 0), Color = rgb(255, 235, 200), Material = M.WoodPlanks }, base)
		part({ Size = Vector3.new(92, 0.8, 92), CFrame = origin * CFrame.new(0, 0.3, 0), Color = col }, base)
		part({ Size = Vector3.new(30, 1.05, 30), CFrame = origin * CFrame.new(0, 0.5, 0), Color = rgb(170, 40, 60), Material = M.Fabric }, base)

		model("PoolTable", origin, base)
		for _, f in { { 0, -45, 0, { -30, 0, 30 } }, { 0, 45, math.pi, { -30, 30 } }, { -45, 0, math.pi / 2, { -30, 0, 30 } }, { 45, 0, -math.pi / 2, { -30, 0, 30 } } } do
			local fcf = origin * CFrame.new(f[1], 1, f[2]) * CFrame.Angles(0, f[3], 0)
			for _, o in f[4] do model("Fence", fcf * CFrame.new(o, 0, 0), base) end
		end
		for _, s in { -1, 1 } do -- столбы входа
			ycyl(2.4, 12, origin * CFrame.new(s * 15, 6, 45), col, M.SmoothPlastic, base)
			light(part({ Shape = BALL, Size = Vector3.one * 3, CFrame = origin * CFrame.new(s * 15, 13, 45), Color = col, Material = M.Neon }, base), col, 20)
		end

		model("Dumbbell", origin * CFrame.new(-30, 1.3, 25), base)
		local dPrompt = Instance.new("ProximityPrompt")
		dPrompt.ActionText, dPrompt.ObjectText, dPrompt.HoldDuration = "Качаться", "Гантеля", 0
		dPrompt.Parent = part({ Name = "DumbbellHit", Size = Vector3.new(6, 3, 3), CFrame = origin * CFrame.new(-30, 2, 25), Transparency = 1, CanCollide = false }, base)

		local shop = part({ Name = "CueShop", Size = Vector3.new(10, 4, 4), CFrame = origin * CFrame.new(30, 3, 25), Color = rgb(120, 200, 255) }, base)
		for k = 0, 5 do -- полосатый навес
			part({ Size = Vector3.new(2, 0.6, 6), CFrame = origin * CFrame.new(25 + k * 2, 10, 25), Color = k % 2 == 0 and rgb(255, 90, 90) or Color3.new(1, 1, 1) }, base)
		end
		for _, o in { -5, 5 } do part({ Size = Vector3.new(0.6, 6, 0.6), CFrame = origin * CFrame.new(30 + o, 7, 25), Color = Color3.new(1, 1, 1) }, base) end
		label(shop, Enum.NormalId.Back, "🎱 КИИ")
		for k = 1, 3 do model("Cue", origin * CFrame.new(27 + k * 1.5, 5, 23.6) * CFrame.Angles(0, 0, math.rad(8 - k * 4)), base, C.Cues[k * 2][4]) end
		local sPrompt = Instance.new("ProximityPrompt")
		sPrompt.ActionText, sPrompt.ObjectText, sPrompt.HoldDuration = "Открыть", "Магазин киёв", 0
		sPrompt.Parent = shop

		local signPart = part({ Size = Vector3.new(24, 5, 1), CFrame = origin * CFrame.new(0, 16, 45), Color = col }, base)
		part({ Size = Vector3.new(32, 1, 1), CFrame = origin * CFrame.new(0, 12, 45), Color = col }, base)

		local slots = {}
		for s = 1, C.MaxEquipped do
			local a = math.rad(-150 + (s - 1) * (300 / (C.MaxEquipped - 1)))
			local pos = origin.Position + Vector3.new(math.sin(a) * 18, 1, -math.cos(a) * 18)
			slots[s] = CFrame.lookAt(pos, Vector3.new(origin.X, 1, origin.Z))
			ycyl(5, 0.6, CFrame.new(pos + Vector3.new(0, 0.3, 0)), Color3.new(1, 1, 1), M.Marble, base)
			ycyl(5.4, 0.2, CFrame.new(pos + Vector3.new(0, 0.1, 0)), col, M.Neon, base)
		end

		Map.Bases[i] = {
			model = base, origin = origin, slots = slots, spawn = origin * CFrame.new(0, 1.1, 32),
			sign = label(signPart, Enum.NormalId.Back, "Свободная база"), dumbPrompt = dPrompt, shopPrompt = sPrompt,
			chars = Instance.new("Folder", base),
		}
	end

	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored, spawn.Transparency, spawn.CanCollide, spawn.Size, spawn.Neutral = true, 1, false, Vector3.new(6, 1, 6), true
	spawn.CFrame, spawn.Parent = CFrame.new(0, 0.6, 52), world
	return Map
end

return Map
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX11"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX10"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX7"><Properties><string name="Name">Client</string></Properties><Item class="LocalScript" referent="RBX5"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")
local RS = game:GetService("ReplicatedStorage")
local C = require(RS.Shared.Config)
local Remotes = RS:WaitForChild("Remotes")
local Request, Fx = Remotes.Request, Remotes.Fx
local plr = Players.LocalPlayer
local U = C.UI

local state
local panels = {}
local renderers = {}

-- Звук
local function sound(id, group)
	local s = Instance.new("Sound")
	s.SoundId, s.SoundGroup, s.Parent = id, group, SoundService
	return s
end
local groups = {}
for _, n in { "Music", "SFX" } do
	groups[n] = Instance.new("SoundGroup")
	groups[n].Name, groups[n].Volume, groups[n].Parent = n, 0.5, SoundService
end
local music = sound(C.Sounds.Music, groups.Music)
music.Looped = true
music:Play()
local sfx = {}
for k, id in C.Sounds do
	if k ~= "Music" then sfx[k] = sound(id, groups.SFX) end
end
_G.PlaySfx = function(k) if sfx[k] then sfx[k]:Play() end end

-- UI-хелперы
local function new(class, props, children)
	local o = Instance.new(class)
	for k, v in props do o[k] = v end
	for _, c in children or {} do c.Parent = o end
	return o
end
local function corner(r) return new("UICorner", { CornerRadius = UDim.new(r or 0.25, 0) }) end
local function stroke(t) return new("UIStroke", { Color = U.Stroke, Thickness = t or 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }) end
local function grad(c) return new("UIGradient", { Rotation = 90, Color = ColorSequence.new(c:Lerp(Color3.new(1, 1, 1), 0.35), c) }) end

local function text(props)
	props.BackgroundTransparency = 1
	props.FontFace, props.TextScaled = U.Font, true
	props.TextColor3 = props.TextColor3 or Color3.new(1, 1, 1)
	return new("TextLabel", props, { new("UIStroke", { Color = U.Stroke, Thickness = 2.5 }) })
end

local function button(props, color, onClick)
	local b = new("TextButton", {
		Size = props.Size, Position = props.Position, AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = Color3.new(1, 1, 1), AutoButtonColor = false, Text = "", LayoutOrder = props.LayoutOrder or 0,
	}, { corner(), stroke(3), grad(color), new("UIScale", {}),
		text({ Size = UDim2.fromScale(0.9, 0.8), Position = UDim2.fromScale(0.05, 0.1), Text = props.Text, Name = "Label" }) })
	local scale = b.UIScale
	b.MouseEnter:Connect(function() TweenService:Create(scale, TweenInfo.new(0.15, Enum.EasingStyle.Back), { Scale = 1.08 }):Play() end)
	b.MouseLeave:Connect(function() TweenService:Create(scale, TweenInfo.new(0.15), { Scale = 1 }):Play() end)
	b.Activated:Connect(function()
		_G.PlaySfx("Click")
		scale.Scale = 0.9
		TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		if onClick then onClick() end
	end)
	return b
end

local gui = new("ScreenGui", { Name = "Main", ResetOnSpawn = false, IgnoreGuiInset = true, Parent = plr:WaitForChild("PlayerGui") })

local toastLabel = text({ Size = UDim2.fromScale(0.5, 0.06), Position = UDim2.fromScale(0.25, 0.2), Text = "", TextTransparency = 1, Parent = gui })
toastLabel.UIStroke.Transparency = 1
local function toast(msg, color)
	toastLabel.Text, toastLabel.TextColor3 = msg, color or U.Accent
	toastLabel.TextTransparency, toastLabel.UIStroke.Transparency = 0, 0
	toastLabel.Position = UDim2.fromScale(0.25, 0.22)
	TweenService:Create(toastLabel, TweenInfo.new(1.6), { Position = UDim2.fromScale(0.25, 0.16), TextTransparency = 1 }):Play()
	TweenService:Create(toastLabel.UIStroke, TweenInfo.new(1.6), { Transparency = 1 }):Play()
end
_G.Toast = toast

local function call(action, arg)
	local ok, msg = Request:InvokeServer(action, arg)
	if msg then toast(msg, ok and U.Accent or Color3.fromRGB(255, 90, 90)) end
	if ok and msg then _G.PlaySfx("Reward") end
	return ok
end

-- Деньги
local cashLabel = text({ Size = UDim2.fromScale(0.3, 0.07), Position = UDim2.fromScale(0.35, 0.02), Text = "💵 0", TextColor3 = Color3.fromRGB(140, 255, 120), Parent = gui })
local statLabel = text({ Size = UDim2.fromScale(0.4, 0.035), Position = UDim2.fromScale(0.3, 0.09), Text = "", Parent = gui })

-- Панели
local function panel(name, title)
	local f = new("Frame", {
		Name = name, Size = UDim2.fromScale(0.5, 0.62), Position = UDim2.fromScale(0.5, 0.52), AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = U.Panel, Visible = false, Parent = gui,
	}, { corner(0.06), stroke(5), new("UIAspectRatioConstraint", { AspectRatio = 1.5 }),
		text({ Size = UDim2.fromScale(0.8, 0.12), Position = UDim2.fromScale(0.1, -0.05), Text = title, TextColor3 = U.Accent }) })
	button({ Size = UDim2.fromScale(0.08, 0.12), Position = UDim2.fromScale(0.95, -0.04), Text = "✖" }, Color3.fromRGB(255, 80, 80), function() f.Visible = false end).Parent = f
	local list = new("ScrollingFrame", {
		Size = UDim2.fromScale(0.92, 0.8), Position = UDim2.fromScale(0.04, 0.13), BackgroundTransparency = 1,
		ScrollBarThickness = 8, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = f,
	}, {
		new("UIGridLayout", { CellSize = UDim2.new(0.31, 0, 0, 110), CellPadding = UDim2.new(0.02, 0, 0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
		new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingLeft = UDim.new(0, 6) }),
	})
	panels[name] = { frame = f, list = list }
	return list
end

local function open(name)
	if not state then return end
	for n, p in panels do p.frame.Visible = n == name and not p.frame.Visible end
	local p = panels[name]
	if p.frame.Visible then
		renderers[name](p.list)
		local sc = p.frame:FindFirstChildOfClass("UIScale") or new("UIScale", { Parent = p.frame })
		sc.Scale = 0.6
		TweenService:Create(sc, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end
end

local function clear(list)
	for _, c in list:GetChildren() do if c:IsA("GuiObject") then c:Destroy() end end
end

local function card(list, order, color, title, sub, btnText, onClick)
	local f = new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), LayoutOrder = order, Parent = list }, {
		corner(0.15), stroke(3), grad(color),
		text({ Size = UDim2.fromScale(0.92, 0.3), Position = UDim2.fromScale(0.04, 0.04), Text = title }),
		text({ Size = UDim2.fromScale(0.92, 0.22), Position = UDim2.fromScale(0.04, 0.34), Text = sub }),
	})
	if btnText then
		button({ Size = UDim2.fromScale(0.8, 0.3), Position = UDim2.fromScale(0.1, 0.62), Text = btnText }, U.Accent, onClick).Parent = f
	end
	return f
end

-- Настройки
panel("Settings", "⚙️ Настройки")
function renderers.Settings(list)
	clear(list)
	for i, n in { "Music", "SFX" } do
		local g = groups[n]
		local label = (n == "Music" and "🎵 Музыка" or "🔊 Эффекты")
		local f = card(list, i, Color3.fromRGB(120, 140, 255), label, "Громкость: " .. math.round(g.Volume * 100) .. "%")
		for j, d in { { "➖", -0.1 }, { "➕", 0.1 }, { g.Volume > 0 and "🔇" or "🔈", 0 } } do
			button({ Size = UDim2.fromScale(0.27, 0.3), Position = UDim2.fromScale(0.04 + (j - 1) * 0.32, 0.62), Text = d[1] }, U.Accent, function()
				g.Volume = d[2] == 0 and (g.Volume > 0 and 0 or 0.5) or math.clamp(g.Volume + d[2], 0, 1)
				renderers.Settings(list)
			end).Parent = f
		end
	end
end

-- Инвентарь
panel("Inventory", "🎒 Инвентарь")
function renderers.Inventory(list)
	clear(list)
	for i, it in state.d.inv do
		local ch = C.Characters[it.id]
		local r = C.Rarities[ch.rarity]
		local f = card(list, -ch.income * 1000 + i, r[2], ch.name, r[1] .. " • 💵" .. C.Short(ch.income) .. "/с")
		button({ Size = UDim2.fromScale(0.55, 0.3), Position = UDim2.fromScale(0.04, 0.62), Text = it.eq and "Убрать" or "На базу" }, it.eq and Color3.fromRGB(255, 120, 120) or Color3.fromRGB(90, 210, 120), function()
			if call("Equip", i) then renderers.Inventory(list) end
		end).Parent = f
		button({ Size = UDim2.fromScale(0.35, 0.3), Position = UDim2.fromScale(0.61, 0.62), Text = "Продать" }, U.Accent, function()
			if call("Sell", i) then renderers.Inventory(list) end
		end).Parent = f
	end
end

-- Бонусы
panel("Daily", "🎁 Бонусы")
function renderers.Daily(list)
	clear(list)
	local day = os.time() // 86400
	local dd = state.d.daily
	local next = (dd.day == day - 1) and dd.streak % #C.Daily + 1 or (dd.day == day and dd.streak or 1)
	card(list, 0, Color3.fromRGB(255, 120, 170), "День " .. next .. "/" .. #C.Daily, "💵 " .. C.Short(C.Daily[next]),
		dd.day == day and "✅ Получено" or "Забрать!", function()
			if call("Daily") then renderers.Daily(list) end
		end)
	for i, p in C.Playtime do
		local left = p[1] * 60 - (os.time() - state.join)
		card(list, i, Color3.fromRGB(255, 170, 80), "⏱️ " .. p[1] .. " мин", "💵 " .. C.Short(p[2]),
			state.claimed[i] and "✅" or left > 0 and string.format("%d:%02d", left // 60, left % 60) or "Забрать!", function()
				if call("Playtime", i) then renderers.Daily(list) end
			end)
	end
end

-- Донат-магазин
panel("Shop", "💎 Магазин")
function renderers.Shop(list)
	clear(list)
	local i = 0
	for key, gp in C.GamePasses do
		i += 1
		card(list, i, Color3.fromRGB(255, 175, 40), gp.icon .. " " .. gp.name, "Гейм-пасс", state.d.passes[key] and "✅ Куплено" or "Купить R$", function()
			call("Pass", key)
		end)
	end
	for j, p in C.Products do
		card(list, 10 + j, Color3.fromRGB(90, 210, 120), p.icon .. " " .. C.Short(p.cash), "Пачка денег", "Купить R$", function() call("Product", j) end)
	end
end

-- Магазин киёв + прокачка (открывается у ларька на базе)
panel("Cues", "🎱 Кии и прокачка")
function renderers.Cues(list)
	clear(list)
	local d = state.d
	card(list, 0, Color3.fromRGB(255, 90, 90), "💪 Гантеля ур." .. d.dumbLevel, "+" .. d.dumbLevel .. " силы за подход", "💵 " .. C.Short(C.LiftCost(d.dumbLevel)), function()
		if call("UpDumb") then renderers.Cues(list) end
	end)
	card(list, 1, Color3.fromRGB(120, 140, 255), "🎱 Кий ур." .. d.cueLevel, "+10% к дальности", "💵 " .. C.Short(C.CueUpCost(d.cueLevel)), function()
		if call("UpCue") then renderers.Cues(list) end
	end)
	for i, cue in C.Cues do
		local owned = d.cues[tostring(i)]
		card(list, 1 + i, cue[4], cue[1], "x" .. cue[2] .. " дальность", d.cue == i and "✅ Выбран" or owned and "Выбрать" or "💵 " .. C.Short(cue[3]), function()
			if call("Cue", i) then renderers.Cues(list) end
		end)
	end
end

-- Кнопки меню слева
local menu = new("Frame", { Size = UDim2.fromScale(0.09, 0.5), Position = UDim2.fromScale(0.01, 0.25), BackgroundTransparency = 1, Parent = gui }, {
	new("UIListLayout", { Padding = UDim.new(0.03, 0), SortOrder = Enum.SortOrder.LayoutOrder }),
})
local order = { "Settings", "Inventory", "Daily", "Shop" }
for i, key in order do
	local b = U.Buttons[key]
	local btn = button({ Size = UDim2.fromScale(1, 0.22), Text = "", LayoutOrder = i }, b[3], function() open(key) end)
	btn.Label:Destroy()
	text({ Size = UDim2.fromScale(1, 0.6), Text = b[1], Parent = btn })
	text({ Size = UDim2.fromScale(1, 0.32), Position = UDim2.fromScale(0, 0.64), Text = b[2], Parent = btn })
	new("UIAspectRatioConstraint", { AspectRatio = 1, Parent = btn })
	btn.Parent = menu
end

-- Кнопка броска с полосой силы
local power, charging, t0 = 0, false, 0
local bar = new("Frame", { Size = UDim2.fromScale(0.3, 0.035), Position = UDim2.fromScale(0.35, 0.8), BackgroundColor3 = Color3.fromRGB(40, 30, 60), Parent = gui },
	{ corner(1), stroke(3) })
local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), Parent = bar }, {
	corner(1), new("UIGradient", { Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(90, 220, 90)), ColorSequenceKeypoint.new(0.6, Color3.fromRGB(255, 220, 40)), ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 60, 60)) }) }),
})
local throwBtn = button({ Size = UDim2.fromScale(0.16, 0.09), Position = UDim2.fromScale(0.42, 0.86), Text = "🎱 УДАР!" }, Color3.fromRGB(255, 90, 90))
throwBtn.Parent = gui
throwBtn.MouseButton1Down:Connect(function()
	if not _G.ThrowBusy then charging, power, t0 = true, 0, 0 end
end)
game:GetService("UserInputService").InputEnded:Connect(function(input)
	if not charging or (input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch) then return end
	charging = false
	local ok, msg = Request:InvokeServer("Throw", power)
	if msg then toast(msg, Color3.fromRGB(255, 90, 90)) end
	if ok then _G.PlaySfx("Hit") end
end)

game:GetService("RunService").RenderStepped:Connect(function(dt)
	if charging then t0 += dt end
	power = charging and (1 - math.abs(((t0 * 0.8) % 2) - 1)) or power
	fill.Size = UDim2.fromScale(charging and power or 0, 1)
end)

-- События сервера
Fx.OnClientEvent:Connect(function(kind, a)
	if kind == "State" then
		state = a
		cashLabel.Text = "💵 " .. C.Short(a.d.cash)
		statLabel.Text = string.format("💪 %s   📈 %s/с   🍀 +%d", C.Short(a.d.strength), C.Short(a.income), a.luck)
		for n, p in panels do if p.frame.Visible then renderers[n](p.list) end end
	elseif kind == "Cash" then
		cashLabel.Text = "💵 " .. C.Short(a)
	elseif kind == "Luck" then
		toast("🍀 Стол меняется! Удача +" .. a, Color3.fromRGB(120, 255, 140))
	elseif kind == "Open" then
		if not panels[a].frame.Visible then open(a) end
	elseif kind == "Lift" then
		if Request:InvokeServer("Lift") then
			_G.PlaySfx("Click")
			toast("+" .. state.d.dumbLevel .. " 💪", Color3.fromRGB(255, 120, 120))
		end
	end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX6"><Properties><string name="Name">Balls</string><ProtectedString name="Source"><![CDATA[-- Бросок: кий бьёт биток -> биток разбивает пирамиду -> шары разлетаются с отскоками
-- от бортов и падают в лузы -> биток доезжает до своей зоны и падает в её лузу.
-- Для своего броска — кинематографичная камера: зум, аутзум, тряска, затемнение, вспышки, перелив цветов.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local RS = game:GetService("ReplicatedStorage")
local C = require(RS.Shared.Config)
local Fx = RS:WaitForChild("Remotes").Fx
local Models = RS:FindFirstChild("Models")
local plr = Players.LocalPlayer
local cam = workspace.CurrentCamera
local T, N = C.Table, #C.Rarities
local zoneLen = T.Length / N
local FELT_Y = 3.3
local R = 1.1 -- радиус шара
local rng = Random.new()
local mySlot

local function sfx(k) if _G.PlaySfx then _G.PlaySfx(k) end end
local function tween(o, t, props, style, dir)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end
local function laneX(slot) return -T.Width / 2 + (slot - 0.5) * T.Width / T.Lanes end

local function ball(color, size)
	local src = Models and Models:FindFirstChild("Ball")
	local b = src and src:Clone() or Instance.new("Part")
	if not src then b.Shape = Enum.PartType.Ball end
	b.Size, b.Color, b.Material = Vector3.one * size, color, Enum.Material.SmoothPlastic
	b.Anchored, b.CanCollide, b.CastShadow = true, false, true
	b.Parent = workspace
	return b
end

local function burst(b, color, n)
	local p = Instance.new("ParticleEmitter")
	p.Color, p.LightEmission, p.Speed = ColorSequence.new(color), 1, NumberRange.new(8, 20)
	p.Lifetime, p.SpreadAngle, p.Rate = NumberRange.new(0.4, 0.9), Vector2.new(180, 180), 0
	p.Size, p.Parent = NumberSequence.new(0.7, 0), b
	p:Emit(n)
end

local function drop(b, at)
	sfx("Pocket")
	burst(b, b.Color, 25)
	tween(b, 0.45, { Size = Vector3.one * 0.1, CFrame = CFrame.new(at - Vector3.new(0, 1.6, 0)) }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	task.delay(1, b.Destroy, b)
end

-- ===== Лузы длинного стола (как в Map.luau) =====
local pockets = {}
for i = 1, N do
	for _, sx in { -1, 1 } do
		table.insert(pockets, Vector3.new(sx * T.Width / 2, FELT_Y + R, T.StartZ + (i - 0.5) * zoneLen))
	end
end
local function nearestPocket(pos)
	local best, bd
	for _, p in pockets do
		local d = (p - pos).Magnitude
		if not bd or d < bd then best, bd = p, d end
	end
	return best, bd
end

-- ===== Пирамиды на каждой дорожке =====
local RACK_Z = T.StartZ + 16
local rackColors = { Color3.fromRGB(255, 220, 40), Color3.fromRGB(40, 90, 255), Color3.fromRGB(255, 50, 50), Color3.fromRGB(140, 40, 200), Color3.fromRGB(255, 130, 20), Color3.fromRGB(30, 160, 60), Color3.fromRGB(130, 30, 30), Color3.fromRGB(20, 20, 20), Color3.fromRGB(255, 120, 200), Color3.fromRGB(0, 200, 200) }
local racks = {}

local function buildRack(slot)
	local list = {}
	local x0 = laneX(slot)
	local k = 0
	for row = 0, 3 do
		for j = 0, row do
			k += 1
			local pos = Vector3.new(x0 + (j - row / 2) * R * 2.05, FELT_Y + R, RACK_Z + row * R * 1.8)
			local b = ball(rackColors[k], R * 2)
			b.CFrame, b.Size = CFrame.new(pos), Vector3.one * 0.1
			tween(b, 0.4, { Size = Vector3.one * R * 2 }, Enum.EasingStyle.Back)
			table.insert(list, b)
		end
	end
	racks[slot] = list
end
for s = 1, T.Lanes do buildRack(s) end

-- Физика разлёта: трение, отскоки от бортов и друг от друга, «магнит» луз на малой скорости
local function breakRack(slot, power)
	local list = racks[slot]
	racks[slot] = nil
	local bodies = {}
	for _, b in list do
		local p = b.Position
		local away = Vector3.new(p.X - laneX(slot), 0, p.Z - RACK_Z + 3).Unit
		local dir = (away + Vector3.new(rng:NextNumber(-0.5, 0.5), 0, 0.4)).Unit
		table.insert(bodies, { b = b, p = p, v = dir * rng:NextNumber(30, 55) * (0.6 + power * 0.6), rot = CFrame.new() })
	end
	local alive = #bodies
	local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		for i, o in bodies do
			if o.done then continue end
			local speed = o.v.Magnitude
			local target, d = nearestPocket(o.p)
			if d < 2.3 then
				o.done, alive = true, alive - 1
				o.b.CFrame = CFrame.new(target)
				drop(o.b, target)
				continue
			end
			o.v *= math.max(0, 1 - 0.55 * dt)
			if speed < 14 then -- шар «ищет» лузу, чтобы все шары оказались забиты
				o.v += (target - o.p).Unit * 40 * dt
				o.v = o.v.Unit * math.max(o.v.Magnitude, 8)
			end
			o.p += o.v * dt
			local lim = T.Width / 2 - R
			if math.abs(o.p.X) > lim then -- отскок от борта
				o.p = Vector3.new(math.sign(o.p.X) * lim, o.p.Y, o.p.Z)
				o.v = Vector3.new(-o.v.X * 0.8, 0, o.v.Z)
				sfx("Hit")
			end
			if o.p.Z < T.StartZ + R then
				o.p = Vector3.new(o.p.X, o.p.Y, T.StartZ + R)
				o.v = Vector3.new(o.v.X, 0, -o.v.Z * 0.8)
			end
			for j = i + 1, #bodies do -- упругое столкновение шаров
				local q = bodies[j]
				if not q.done then
					local delta = q.p - o.p
					local dist = delta.Magnitude
					if dist < R * 2 and dist > 0 then
						local n = delta / dist
						local rel = (o.v - q.v):Dot(n)
						if rel > 0 then
							o.v -= n * rel
							q.v += n * rel
						end
						o.p -= n * (R * 2 - dist) / 2
						q.p += n * (R * 2 - dist) / 2
					end
				end
			end
			local axis = o.v.Magnitude > 0.01 and Vector3.yAxis:Cross(o.v.Unit) or Vector3.xAxis
			o.rot = CFrame.fromAxisAngle(axis, o.v.Magnitude * dt / R) * o.rot
			o.b.CFrame = CFrame.new(o.p) * o.rot
		end
		if alive == 0 then
			conn:Disconnect()
			task.delay(1.5, buildRack, slot)
		end
	end)
end

-- ===== Эффекты экрана =====
local fxGui = Instance.new("ScreenGui")
fxGui.Name, fxGui.IgnoreGuiInset, fxGui.ResetOnSpawn, fxGui.DisplayOrder = "CinemaFx", true, false, 10
fxGui.Parent = plr:WaitForChild("PlayerGui")

local function frame(props)
	local f = Instance.new("Frame")
	f.BorderSizePixel, f.Size = 0, UDim2.fromScale(1, 1)
	for k, v in props do f[k] = v end
	f.Parent = props.Parent or fxGui
	return f
end
local flash = frame({ BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1 })
local dim = frame({ BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1 })
local bars = {} -- кинематографичные полосы
for i, y in { 0, 1 } do
	bars[i] = frame({ BackgroundColor3 = Color3.new(0, 0, 0), Size = UDim2.fromScale(1, 0), AnchorPoint = Vector2.new(0, y), Position = UDim2.fromScale(0, y) })
end
local cc = Instance.new("ColorCorrectionEffect")
cc.Parent = Lighting
local blur = Instance.new("BlurEffect")
blur.Size, blur.Parent = 0, Lighting

local function doFlash(color, strength)
	flash.BackgroundColor3, flash.BackgroundTransparency = color, 1 - (strength or 0.8)
	tween(flash, 0.5, { BackgroundTransparency = 1 })
end
local function letterbox(on)
	for _, b in bars do tween(b, 0.4, { Size = UDim2.fromScale(1, on and 0.11 or 0) }) end
end

-- тряска: shake = амплитуда в стадах, затухает
local shake = 0
local function hardShake(a) shake = math.max(shake, a) end

-- окно с выпавшим персонажем: лучи, радужный градиент, пульсация
local function reveal(ch)
	local r = C.Rarities[ch.rarity]
	local root = frame({ BackgroundTransparency = 1 })
	local rays = frame({ Parent = root, BackgroundTransparency = 1, Size = UDim2.fromOffset(900, 900), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45) })
	for k = 1, 12 do -- луч внутри повёрнутого полноразмерного «шарнира» вращается вокруг центра
		local pivot = frame({ Parent = rays, BackgroundTransparency = 1, Rotation = k * 30 })
		frame({ Parent = pivot, BackgroundColor3 = r[2], BackgroundTransparency = 0.55, Size = UDim2.new(0, 40, 0.5, 0), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 0.5) })
	end
	local function label(text, y, h, color)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency, l.TextScaled, l.FontFace = 1, true, C.UI.Font
		l.Size, l.AnchorPoint, l.Position = UDim2.fromScale(0.8, h), Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, y)
		l.Text, l.TextColor3, l.Parent = text, color, root
		local st = Instance.new("UIStroke")
		st.Thickness, st.Color, st.Parent = 5, C.UI.Stroke, l
		local sc = Instance.new("UIScale")
		sc.Scale, sc.Parent = 0, l
		return l, sc
	end
	local title, s1 = label(string.upper(r[1]) .. "!", 0.34, 0.14, Color3.new(1, 1, 1))
	local name, s2 = label(ch.name, 0.48, 0.09, r[2])
	local _, s3 = label("💵 " .. C.Short(ch.income) .. "/с", 0.58, 0.06, Color3.fromRGB(140, 255, 120))
	local grad = Instance.new("UIGradient")
	grad.Color = ch.rarity >= 10 and ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 60)), ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 230, 40)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(60, 255, 120)), ColorSequenceKeypoint.new(0.75, Color3.fromRGB(60, 160, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 60, 220)),
	}) or ColorSequence.new(Color3.new(1, 1, 1), r[2])
	grad.Parent = title
	for k, sc in { s1, s2, s3 } do
		task.delay((k - 1) * 0.15, function() tween(sc, 0.5, { Scale = 1 }, Enum.EasingStyle.Back) end)
	end
	local t0 = os.clock()
	local conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		rays.Rotation = t * 40
		grad.Offset = Vector2.new(math.sin(t * 3) * 0.5, 0)
		grad.Rotation = t * 90
		s1.Scale = s1.Scale > 0.95 and 1 + math.sin(t * 8) * 0.05 or s1.Scale
		name.TextColor3 = ch.rarity >= 10 and Color3.fromHSV((t * 0.6) % 1, 0.7, 1) or r[2]
		if ch.rarity >= 10 then cc.TintColor = Color3.fromHSV((t * 0.5) % 1, 0.25, 1) end -- перелив мира
	end)
	task.delay(2.8, function()
		for _, sc in { s1, s2, s3 } do tween(sc, 0.3, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In) end
		tween(rays, 0.3, { Size = UDim2.fromOffset(0, 0) })
		task.wait(0.35)
		conn:Disconnect()
		root:Destroy()
		tween(cc, 0.6, { TintColor = Color3.new(1, 1, 1), Saturation = 0, Brightness = 0, Contrast = 0 })
	end)
end

-- ===== Камера =====
local camTarget, camOffset, camLook -- куда смотрит кинокамера
local cinema = false
RunService:BindToRenderStep("CinemaCam", Enum.RenderPriority.Camera.Value + 1, function(dt)
	if not cinema or not camTarget then return end
	local pos = camTarget.Position
	local goal = CFrame.lookAt(pos + camOffset, pos + (camLook or Vector3.zero))
	cam.CFrame = cam.CFrame:Lerp(goal, math.min(1, dt * 8))
	if shake > 0.01 then
		cam.CFrame *= CFrame.new(rng:NextNumber(-1, 1) * shake, rng:NextNumber(-1, 1) * shake, 0) * CFrame.Angles(0, 0, rng:NextNumber(-1, 1) * shake * 0.03)
		shake *= math.max(0, 1 - dt * 6)
	end
end)

local function setCinema(on)
	cinema = on
	_G.ThrowBusy = on
	local main = plr.PlayerGui:FindFirstChild("Main")
	if main then main.Enabled = not on end
	letterbox(on)
	if on then
		cam.CameraType = Enum.CameraType.Scriptable
	else
		cam.CameraType = Enum.CameraType.Custom
		tween(cam, 0.6, { FieldOfView = 70 })
		tween(dim, 0.4, { BackgroundTransparency = 1 })
		tween(blur, 0.4, { Size = 0 })
	end
end

-- ===== Бросок =====
local function cueModel(color)
	local m = Instance.new("Model")
	for _, d in { { 0.4, 7, Color3.fromRGB(25, 12, 5), -2.5 }, { 0.3, 7, color, 4.5 }, { 0.22, 0.3, Color3.fromRGB(25, 80, 230), 8.15 } } do
		local p = Instance.new("Part")
		p.Shape, p.Anchored, p.CanCollide = Enum.PartType.Cylinder, true, false
		p.Size, p.Color, p.Material = Vector3.new(d[2], d[1], d[1]), d[3], Enum.Material.SmoothPlastic
		p:SetAttribute("off", d[4])
		p.Parent = m
	end
	m.Parent = workspace
	return m
end
local function placeCue(m, tip) -- кий лежит вдоль +Z, кончик в точке tip
	for _, p in m:GetChildren() do
		p.CFrame = CFrame.new(tip - Vector3.new(0, -0.6, 8.3 - p:GetAttribute("off"))) * CFrame.Angles(0, math.pi / 2, 0)
	end
end

Fx.OnClientEvent:Connect(function(kind, a, dist, id)
	if kind == "State" then mySlot = a.slot return end
	if kind ~= "Throw" then return end
	local slot, ch = a, C.Characters[id]
	local rcol = C.Rarities[ch.rarity][2]
	local mine = slot == mySlot
	local x = laneX(slot)
	local start = Vector3.new(x, FELT_Y + R, T.StartZ + 3)
	local b = ball(Color3.new(1, 1, 1), R * 2)
	b.CFrame = CFrame.new(start)
	local a0, a1 = Instance.new("Attachment", b), Instance.new("Attachment", b)
	a0.Position, a1.Position = Vector3.new(0, 0.7, 0), Vector3.new(0, -0.7, 0)
	local trail = Instance.new("Trail")
	trail.Attachment0, trail.Attachment1, trail.Color, trail.LightEmission = a0, a1, ColorSequence.new(Color3.new(1, 1, 1), rcol), 1
	trail.Lifetime, trail.Transparency, trail.Parent = 0.5, NumberSequence.new(0.1, 1), b

	-- 1. Замах кием: зум-ин и затемнение
	local cue = cueModel(C.Cues[2][4])
	if mine then
		setCinema(true)
		camTarget, camOffset, camLook = b, Vector3.new(6, 4, -10), Vector3.new(0, 0, 6)
		cam.FieldOfView = 70
		tween(cam, C.Anim.Windup, { FieldOfView = 38 }, Enum.EasingStyle.Sine)
		tween(dim, C.Anim.Windup, { BackgroundTransparency = 0.6 })
		tween(cc, C.Anim.Windup, { Saturation = -0.4, Contrast = 0.2 })
	end
	local t0 = os.clock()
	while os.clock() - t0 < C.Anim.Windup do
		local t = (os.clock() - t0) / C.Anim.Windup
		local back = t < 0.8 and math.sin(t / 0.8 * math.pi / 2) * 4 or 4 * (1 - (t - 0.8) / 0.2) -- оттяжка и резкий удар
		placeCue(cue, start - Vector3.new(0, 0, R + back))
		RunService.RenderStepped:Wait()
	end
	sfx("Hit")
	burst(b, Color3.new(1, 1, 1), 30)
	task.delay(0.3, cue.Destroy, cue)

	-- 2. Удар: вспышка, жёсткая тряска, аутзум-рывок
	if mine then
		doFlash(Color3.new(1, 1, 1), 0.9)
		hardShake(2.5)
		cam.FieldOfView = 105
		tween(cam, 0.8, { FieldOfView = 75 }, Enum.EasingStyle.Quart)
		tween(dim, 0.3, { BackgroundTransparency = 1 })
		tween(cc, 0.3, { Saturation = 0.3, Contrast = 0.1 })
		camOffset, camLook = Vector3.new(0, 9, -22), Vector3.new(0, 0, 20)
	end

	-- 3. Качение до своей зоны (+ разбивка пирамиды по пути)
	local roll = C.RollTime(dist)
	local zone = math.clamp(math.ceil(dist / zoneLen), 1, N)
	local endZ = math.min(T.StartZ + 3 + dist, T.StartZ + T.Length - R)
	local broke = false
	local rot, lastZ = CFrame.new(), start.Z
	t0 = os.clock()
	repeat
		local t = math.min((os.clock() - t0) / roll, 1)
		local z = start.Z + (endZ - start.Z) * (1 - (1 - t) ^ 3)
		rot = CFrame.Angles((z - lastZ) / R, 0, 0) * rot
		lastZ = z
		b.CFrame = CFrame.new(x, start.Y, z) * rot
		if not broke and z >= RACK_Z - R * 2 and racks[slot] then
			broke = true
			breakRack(slot, math.clamp(dist / T.Length, 0.3, 1))
			if mine then hardShake(1.6) doFlash(rcol, 0.4) end
		end
		RunService.RenderStepped:Wait()
	until t >= 1

	-- 4. Скат в лузу зоны: зум-ин, затемнение, замедление
	local side = x < 0 and -1 or 1
	local pocket = Vector3.new(side * T.Width / 2, start.Y, T.StartZ + (zone - 0.5) * zoneLen)
	if mine then
		camOffset, camLook = Vector3.new(-side * 10, 7, -12), Vector3.zero
		tween(cam, C.Anim.Slide, { FieldOfView = 32 }, Enum.EasingStyle.Sine)
		tween(dim, C.Anim.Slide, { BackgroundTransparency = 0.45 })
		tween(blur, C.Anim.Slide, { Size = 6 })
	end
	local from = b.Position
	t0 = os.clock()
	repeat
		local t = math.min((os.clock() - t0) / C.Anim.Slide, 1)
		local e = t * t * (3 - 2 * t)
		b.CFrame = CFrame.new(from:Lerp(pocket, e)) * rot
		RunService.RenderStepped:Wait()
	until t >= 1
	b.Color = rcol
	drop(b, pocket)

	-- 5. Финал: вспышка цвета редкости, тряска, аутзум, окно персонажа
	if mine then
		doFlash(rcol, 1)
		hardShake(1 + ch.rarity * 0.12)
		cam.FieldOfView = 90
		tween(cam, 1.2, { FieldOfView = 60 }, Enum.EasingStyle.Back)
		tween(dim, 0.3, { BackgroundTransparency = 0.25 })
		tween(blur, 0.3, { Size = 14 })
		tween(cc, 0.3, { TintColor = rcol:Lerp(Color3.new(1, 1, 1), 0.6), Brightness = 0.1, Saturation = 0.5 })
		sfx("Reward")
		reveal(ch)
		task.wait(3.2)
		setCinema(false)
	else
		_G.Toast(ch.name .. " • " .. C.Rarities[ch.rarity][1], rcol)
	end
end)

-- ===== Декоративные шары на столах баз =====
local basePockets = {}
for _, px in { -4.5, 4.5 } do for _, pz in { -8, 0, 8 } do table.insert(basePockets, Vector3.new(px, 0, pz)) end end
local world = workspace:WaitForChild("World")
while true do
	task.wait(rng:NextNumber(1, 2.5))
	local base = world:FindFirstChild("Base" .. rng:NextInteger(1, 4))
	local floor = base and base:FindFirstChild("Floor")
	if floor then
		local o = floor.Position + Vector3.new(0, 3.95, 0)
		local from = o + Vector3.new(rng:NextNumber(-3, 3), 0, rng:NextNumber(-6, 6))
		local goal = o + basePockets[rng:NextInteger(1, #basePockets)]
		local b = ball(rackColors[rng:NextInteger(1, #rackColors)], 0.8)
		b.CFrame = CFrame.new(from)
		local spin = CFrame.fromAxisAngle((goal - from).Unit:Cross(Vector3.yAxis), -(goal - from).Magnitude / 0.4)
		tween(b, 1.2, { CFrame = CFrame.new(goal) * spin.Rotation }).Completed:Once(function() drop(b, goal) end)
	end
end
]]></ProtectedString></Properties></Item></Item></Item></Item></roblox>