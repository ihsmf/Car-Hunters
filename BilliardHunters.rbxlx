>0.00000</R02><R10>0.00000</R10><R11>1.00000</R11><R12>0.00000</R12><R20>0.00000</R20><R21>0.00000</R21><R22>1.00000</R22></CoordinateFrame><Vector3 name="size"><X>4.0000</X><Y>4.0000</Y><Z>4.0000</Z></Vector3><Color3uint8 name="Color3uint8">4282822470</Color3uint8><token name="Material">1280</token><token name="shape">0</token><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><bool name="CastShadow">true</bool><float name="Transparency">0</float><float name="Reflectance">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties></Item><Item class="Part" referent="RBX6424"><Properties><string name="Name">SpawnPoint</string><CoordinateFrame name="CFrame"><X>157.50000</X><Y>2.90000</Y><Z>24.00000</Z><R00>1.00000</R00><R01>0.00000</R01><R02>0.00000</R02><R10>0.00000</R10><R11>1.00000</R11><R12>0.00000</R12><R20>0.00000</R20><R21>0.00000</R21><R22>1.00000</R22></CoordinateFrame><Vector3 name="size"><X>4.0000</X><Y>1.0000</Y><Z>4.0000</Z></Vector3><Color3uint8 name="Color3uint8">4294967295</Color3uint8><token name="Material">272</token><token name="shape">1</token><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CastShadow">true</bool><float name="Transparency">1</float><float name="Reflectance">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties></Item><Item class="Folder" referent="RBX6425"><Properties><string name="Name">Chars</string></Properties></Item></Item><Item class="SpawnLocation" referent="RBX6426"><Properties><string name="Name">Spawn</string><CoordinateFrame name="CFrame"><X>0.00000</X><Y>0.60000</Y><Z>62.00000</Z><R00>1.00000</R00><R01>0.00000</R01><R02>0.00000</R02><R10>0.00000</R10><R11>1.00000</R11><R12>0.00000</R12><R20>0.00000</R20><R21>0.00000</R21><R22>1.00000</R22></CoordinateFrame><Vector3 name="size"><X>6.0000</X><Y>1.0000</Y><Z>6.0000</Z></Vector3><Color3uint8 name="Color3uint8">4294967295</Color3uint8><token name="Material">272</token><token name="shape">1</token><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CastShadow">true</bool><float name="Transparency">1</float><float name="Reflectance">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><bool name="Neutral">true</bool><bool name="AllowTeamChangeOnTouch">false</bool></Properties></Item></Item></Item><Item class="ReplicatedStorage" referent="RBX6427"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX6428"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX6429"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Game constants + UI tokens (mirrors the Figma file "Billiard Hunters — UI")
local C = {}
local rgb = Color3.fromRGB

C.UI = {
	Font = Font.new("rbxasset://fonts/families/FredokaOne.json", Enum.FontWeight.Bold),
	Ink = rgb(40, 20, 60),
	Panel = rgb(255, 244, 222),
	Title = rgb(255, 190, 40),
	Money = rgb(140, 255, 120),
	Bad = rgb(255, 90, 90),
	-- key = { icon, label, gradient top, gradient bottom }
	Menu = {
		{ "Settings", "⚙️", "Settings", rgb(169, 183, 255), rgb(111, 130, 255) },
		{ "Inventory", "🎒", "Inventory", rgb(142, 227, 166), rgb(63, 191, 106) },
		{ "Bonus", "🎁", "Bonus", rgb(255, 158, 200), rgb(255, 92, 158) },
		{ "Shop", "💎", "Shop", rgb(255, 216, 107), rgb(255, 174, 31) },
	},
	Cues = { rgb(143, 223, 255), rgb(56, 174, 234) },
	Action = { rgb(255, 216, 107), rgb(255, 174, 31) },
	Red = { rgb(255, 138, 138), rgb(255, 71, 71) },
}

C.Sounds = { -- Roblox library audio; swap for your own IDs if any are unavailable
	Music = "rbxassetid://1837849285",
	Hit = "rbxassetid://9119720940",
	Pocket = "rbxassetid://9118823101",
	Click = "rbxassetid://6895079853",
	Reward = "rbxassetid://9125402735",
}

-- 25 rarities: name, colour, character theme. Income grows x2.2 per tier.
local R = {
	{ "Common", rgb(200, 200, 200), "Rookie" }, { "Uncommon", rgb(90, 220, 90), "Hustler" },
	{ "Rare", rgb(70, 150, 255), "Sniper" }, { "Epic", rgb(170, 80, 255), "Count" },
	{ "Legendary", rgb(255, 170, 0), "King" }, { "Mythic", rgb(255, 60, 90), "Dragon" },
	{ "Ancient", rgb(200, 150, 90), "Pharaoh" }, { "Frozen", rgb(160, 230, 255), "Yeti" },
	{ "Blazing", rgb(255, 110, 30), "Phoenix" }, { "Toxic", rgb(150, 255, 40), "Mutant" },
	{ "Cyber", rgb(0, 255, 200), "Robot" }, { "Pirate", rgb(150, 100, 50), "Captain" },
	{ "Samurai", rgb(230, 40, 60), "Ronin" }, { "Ghost", rgb(210, 225, 255), "Phantom" },
	{ "Divine", rgb(255, 240, 120), "Angel" }, { "Demonic", rgb(160, 0, 40), "Demon" },
	{ "Celestial", rgb(120, 255, 255), "Seraph" }, { "Stellar", rgb(255, 255, 190), "Stargazer" },
	{ "Cosmic", rgb(120, 70, 240), "Astronaut" }, { "Galactic", rgb(80, 30, 170), "Emperor" },
	{ "Rainbow", rgb(255, 120, 255), "Unicorn" }, { "Quantum", rgb(40, 200, 255), "Scientist" },
	{ "Secret", rgb(40, 40, 40), "Anonymous" }, { "Glitch", rgb(255, 0, 255), "Error" },
	{ "Absolute", rgb(255, 0, 140), "Billiard God" },
}
local titles = { "Young", "Swift", "Master", "Grand" }

C.Rarities, C.Characters = {}, {} -- C.Rarities[i] = { name, colour, base income }
for r, v in R do
	local inc = math.floor(2.2 ^ (r - 1))
	C.Rarities[r] = { v[1], v[2], inc }
	for i, t in titles do
		table.insert(C.Characters, {
			name = t .. " " .. v[3],
			rarity = r,
			income = math.floor(inc * (1 + (i - 1) * 0.3)),
			shirt = v[2]:Lerp(rgb(255, 255, 255), (i - 1) * 0.18),
		})
	end
end

C.Table = { Length = 2000, Width = 36, StartZ = 80, Lanes = 4 } -- tools/place.py reads these values
C.LuckCycle = 45 -- every N seconds the long table shifts every zone one rarity up
C.MaxLuckShift = 4
C.ThrowCooldown = 1
C.MaxEquipped = 8
C.MaxInventory = 100
C.Anim = { Windup = 0.9, Slide = 0.7 }
function C.RollTime(dist) return 1.4 + dist / 260 end
function C.ThrowTime(dist) return C.Anim.Windup + C.RollTime(dist) + C.Anim.Slide end -- until the ball is pocketed

C.Cues = { -- name, distance multiplier, price, colour
	{ "Wooden", 1, 0, rgb(236, 196, 132) },
	{ "Maple", 1.3, 500, rgb(250, 220, 160) },
	{ "Carbon", 1.7, 5000, rgb(60, 60, 70) },
	{ "Golden", 2.3, 50000, rgb(255, 200, 40) },
	{ "Diamond", 3, 500000, rgb(140, 240, 255) },
	{ "Neon", 4, 5e6, rgb(255, 60, 220) },
	{ "Lava", 5.5, 5e7, rgb(255, 80, 0) },
	{ "Starlight", 7.5, 5e8, rgb(255, 255, 180) },
	{ "Galaxy", 10, 5e9, rgb(90, 40, 200) },
	{ "Absolute", 14, 5e10, rgb(255, 0, 140) },
}
C.DragonCue = { "Dragon", 6, 0, rgb(80, 220, 120) }

function C.LiftCost(lvl) return math.floor(50 * 1.6 ^ (lvl - 1)) end
function C.CueUpCost(lvl) return math.floor(100 * 1.8 ^ (lvl - 1)) end
function C.CueMult(d)
	local base = C.Cues[d.cue][2]
	if d.passes.DragonCue then base = math.max(base, C.DragonCue[2]) end
	return base * (1 + (d.cueLevel - 1) * 0.1)
end
function C.Distance(power, d)
	return math.min(C.Table.Length, power * (40 + d.strength * 0.6) * C.CueMult(d))
end

-- Replace 0 with real IDs from the Creator Dashboard (Monetization → Passes / Developer Products)
C.GamePasses = {
	{ key = "Cash2x", id = 0, icon = "💰", name = "x2 Cash", desc = "Double income" },
	{ key = "Luck2x", id = 0, icon = "🍀", name = "x2 Luck", desc = "50% chance +1 rarity" },
	{ key = "DragonCue", id = 0, icon = "🐉", name = "Dragon Cue", desc = "x6 shot distance" },
	{ key = "GoldStick", id = 0, icon = "🪄", name = "Golden Stick", desc = "+50% income, gold sticks" },
}
C.Products = {
	{ id = 0, cash = 5000, icon = "💵" },
	{ id = 0, cash = 50000, icon = "💰" },
	{ id = 0, cash = 500000, icon = "🏦" },
}

C.Daily = { 100, 250, 500, 1000, 2500, 5000, 15000 }
C.Playtime = { { 5, 300 }, { 15, 1000 }, { 30, 3000 }, { 60, 10000 } } -- minutes, reward

function C.Short(n)
	for _, s in { { 1e15, "Qa" }, { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } } do
		if n >= s[1] then return string.format("%.1f%s", n / s[1], s[2]) end
	end
	return tostring(math.floor(n))
end

return C
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6430"><Properties><string name="Name">Meshes</string><ProtectedString name="Source"><![CDATA[-- AUTO-GENERATED by blender/build_models.py — do not edit by hand.
