]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="ServerScriptService" referent="RBX1935"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX1936"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX1937"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Server: data, bases, shots, income, upgrades, bonuses, purchases
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local RS = game:GetService("ReplicatedStorage")
local C = require(RS.Shared.Config)
local Map = require(script.Parent.Map).Build()

-- In Studio without publishing / API Services the DataStore throws: keep playing, just don't save
local okStore, store = pcall(DataStoreService.GetDataStore, DataStoreService, "BilliardHuntersV2")
if not okStore then
	warn("DataStore unavailable, progress will not be saved:", store)
	store = { GetAsync = function() return nil end, UpdateAsync = function() end }
end

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local Request = Instance.new("RemoteFunction")
Request.Name, Request.Parent = "Request", remotes
local Fx = Instance.new("RemoteEvent")
Fx.Name, Fx.Parent = "Fx", remotes
remotes.Parent = RS

local sessions = {} -- player -> session
local taken = {} -- base slot -> player
local throwCounter = 0
local rng = Random.new()
local N = #C.Rarities
local CollectionService = game:GetService("CollectionService")
local passByKey = {}
for _, gp in C.GamePasses do passByKey[gp.key] = gp end

local DATA_VERSION = 5
local function default()
	return {
		version = DATA_VERSION, cash = 0, strength = 0, dumbLevel = 1, cue = 1,
		inv = {}, found = {}, best = 0, daily = { day = 0, streak = 0 }, receipts = {}, tutorial = 1,
		settings = { music = 0.5, sfx = 0.7, shake = true, short = false },
	}
end

-- Accept only known fields with sane values (old saves, edited saves, removed items)
local function sanitize(saved)
	local d = default()
	if type(saved) ~= "table" then return d end
	local function num(v, lo, hi, def)
		v = tonumber(v)
		if not v or v ~= v then return def end
		return math.clamp(v, lo, hi)
	end
	d.cash = num(saved.cash, 0, 1e300, 0)
	d.strength = num(saved.strength, 0, 1e300, 0)
	d.dumbLevel = math.floor(num(saved.dumbLevel, 1, 200, 1))
	d.cue = math.floor(num(saved.cue, 1, #C.Cues, 1))
	d.best = math.floor(num(saved.best, 0, N, 0))
	-- v5: prize balls (one per rarity). Older saves stored characters: 6 per rarity (v4) or 4 (v3 and older).
	local version = tonumber(saved.version) or 0
	local perRarity = version >= 5 and 1 or version == 4 and 6 or 4
	local function ballOf(id)
		id = tonumber(id)
		if not id or id < 1 then return nil end
		local b = math.ceil(id / perRarity)
		return C.Balls[b] and b or nil
	end
	if type(saved.found) == "table" then
		for k in saved.found do
			local id, v = type(k) == "string" and k:match("^(%d+)_(%d)$")
			local b = ballOf(id)
			if b and C.Variants[tonumber(v)] then d.found[b .. "_" .. v] = true end
		end
	end
	d.tutorial = math.floor(num(saved.tutorial, 1, 4, 4)) -- existing players skip the tutorial
	if type(saved.daily) == "table" then
		d.daily = { day = math.floor(num(saved.daily.day, 0, 1e7, 0)), streak = math.floor(num(saved.daily.streak, 0, #C.Daily, 0)) }
	end
	if type(saved.receipts) == "table" then
		for _, r in saved.receipts do
			if type(r) == "string" and #d.receipts < 50 then table.insert(d.receipts, r) end
		end
	end
	if type(saved.settings) == "table" then
		local st = saved.settings
		d.settings = { music = num(st.music, 0, 1, 0.5), sfx = num(st.sfx, 0, 1, 0.7), shake = st.shake ~= false, short = st.short == true }
	end
	local equipped = 0
	if type(saved.inv) == "table" then
		for _, it in saved.inv do
			local b = type(it) == "table" and ballOf(it.id)
			if b and #d.inv < C.MaxInventory then
				local eq = it.eq == true and equipped < C.MaxEquipped
				if eq then equipped += 1 end
				local v = math.floor(num(it.v, 1, #C.Variants, 1))
				table.insert(d.inv, { id = b, v = v, eq = eq })
				d.found[b .. "_" .. v] = true
			end
		end
	end
	return d
end


local function income(s)
	local sum = 0
	for _, it in s.d.inv do
		if it.eq then sum += C.ItemIncome(it) end
	end
	return sum * (s.passes.Cash2x and 2 or 1) * (s.passes.GoldStick and 1.5 or 1)
end

local function sync(plr)
	local s = sessions[plr]
	if not s then return end
	Fx:FireClient(plr, "State", { d = s.d, passes = s.passes, slot = s.slot, income = income(s), luck = C.StartLuck(s.d, s.passes), training = s.training, join = s.join, claimed = s.claimed })
	plr.leaderstats.Cash.Value = math.floor(s.d.cash)
end

-- ===== Prize balls on the base table =====
local function weldTo(base, p)
	p.Anchored, p.CanCollide, p.Massless = false, false, true
	local w = Instance.new("WeldConstraint")
	w.Part0, w.Part1, w.Parent = base, p, p
end

-- a cue part the client turns into the Blender cue: tier colours + tier effects (Shared/CueFx)
local function cuePart(cue, tier, cf)
	local p = Instance.new("Part")
	p.Name, p.Size, p.Color, p.Material = "Cue", Vector3.new(0.3, 9.2, 0.3), cue.shaft, Enum.Material.Wood
	p.CanCollide, p.CanQuery, p.CanTouch, p.CFrame = false, false, false, cf
	local tag = Instance.new("StringValue")
	tag.Name, tag.Value, tag.Parent = "Mesh", "Cue", p
	for slot, field in C.CueParts do
		local v = Instance.new("Color3Value")
		v.Name, v.Value, v.Parent = slot, cue[field], p
	end
	p:SetAttribute("Tier", tier)
	p:SetAttribute("Dragon", cue == C.DragonCue)
	return p
end

local function emitter(parent, color, rate, size, speed)
	local e = Instance.new("ParticleEmitter")
	e.Color, e.LightEmission, e.Rate, e.Lifetime = ColorSequence.new(color, Color3.new(1, 1, 1)), 0.8, rate, NumberRange.new(0.8, 1.4)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	e.Speed, e.SpreadAngle, e.Transparency = NumberRange.new(speed * 0.5, speed), Vector2.new(180, 180), NumberSequence.new(0.2, 1)
	e.Parent = parent
	return e
end

-- glowing ring (Blender torus) lying flat or tilted around the ball
local function ring(m, cf, size, color, spin)
	local p = Instance.new("Part")
	p.Name, p.Size, p.Color, p.Material = "Ring", Vector3.new(size, 0.2, size), color, Enum.Material.Neon
	p.Transparency, p.CFrame, p.Anchored, p.CanCollide, p.CanQuery, p.CastShadow = 1, cf, true, false, false, false
	local tag = Instance.new("StringValue")
	tag.Name, tag.Value, tag.Parent = "Mesh", "Ring", p
	local col = Instance.new("Color3Value")
	col.Name, col.Value, col.Parent = "Ring", color, p
	local sc = Instance.new("NumberValue")
	sc.Name, sc.Value, sc.Parent = "Scale", size / 4, p
	if spin then
		p:SetAttribute("Spin", spin)
		CollectionService:AddTag(p, "Spin")
	end
	p.Parent = m
	return p
end

-- rarity bands: 1-10 one ring on the felt, 11-25 two rings, 26-40 + two orbiting rings, 41-50 + halo and light pillar
local function rarityFx(m, cf, rarity, color, size)
	local felt = cf * CFrame.new(0, -size / 2 - 0.25, 0)
	ring(m, felt, size * 1.5, color, 0.6)
	if rarity > 10 then ring(m, felt, size * 1.9, Color3.new(1, 1, 1):Lerp(color, 0.5), -0.4) end
	if rarity > 25 then
		for k = 1, 2 do
			ring(m, cf * CFrame.Angles(math.rad(k == 1 and 65 or -65), 0, 0), size * 1.45, color, k == 1 and 1.4 or -1.4)
		end
	end
	if rarity > 40 then
		ring(m, cf * CFrame.new(0, size * 0.85, 0), size * 0.7, Color3.fromRGB(255, 235, 140), 0.8)
		local pillar = Instance.new("Part")
		pillar.Shape, pillar.Size, pillar.Color, pillar.Material = Enum.PartType.Cylinder, Vector3.new(24, size * 1.2, size * 1.2), color, Enum.Material.ForceField
		pillar.CFrame = cf * CFrame.new(0, 12, 0) * CFrame.Angles(0, 0, math.pi / 2)
		pillar.Transparency, pillar.Anchored, pillar.CanCollide, pillar.CanQuery, pillar.CastShadow = 0.4, true, false, false, false
		pillar.Parent = m
	end
end

-- A prize ball hovering over its spot on the base table. The client swaps the part for the Blender ball mesh,
-- makes it bob and spin, and applies the variant material (Gold / Diamond / Galaxy / Rainbow).
local function makeBall(it, spot)
	local ball = C.Balls[it.id]
	local r = C.Rarities[ball.rarity]
	local V = C.Variants[it.v or 1]
	local size = C.BallSize * V.scale
	local m = Instance.new("Model")
	m.Name = ball.name
	local cf = spot * CFrame.new(0, size / 2 + 0.25, 0)
	local p = Instance.new("Part")
	p.Name, p.Shape, p.Size, p.Color, p.Material = "Ball", Enum.PartType.Ball, Vector3.one * size, V.color or ball.body, Enum.Material.SmoothPlastic
	p.CFrame, p.Anchored, p.CanCollide, p.CanQuery = cf, true, false, false
	local tag = Instance.new("StringValue")
	tag.Name, tag.Value, tag.Parent = "Mesh", "PrizeBall", p
	for k, c in C.BallOverrides(it) do
		local v = Instance.new("Color3Value")
		v.Name, v.Value, v.Parent = k, c, p
	end
	local sc = Instance.new("NumberValue")
	sc.Name, sc.Value, sc.Parent = "Scale", size, p
	p:SetAttribute("Variant", V.name)
	p:SetAttribute("Number", ball.rarity)
	CollectionService:AddTag(p, "Hover")
	p.Parent = m
	m.PrimaryPart = p
	if V.color then emitter(p, V.color, 10, 0.25, 1.5) end
	emitter(p, r[2], 4 + ball.rarity * 0.3, 0.15 + ball.rarity * 0.006, 1)
	local glow = Instance.new("PointLight")
	glow.Color, glow.Range, glow.Brightness, glow.Parent = r[2], 5 + ball.rarity * 0.1, 0.8, p
	rarityFx(m, cf, ball.rarity, r[2], size)

	local bb = Instance.new("BillboardGui")
	bb.Size, bb.StudsOffset, bb.AlwaysOnTop, bb.MaxDistance = UDim2.fromOffset(200, 56), Vector3.new(0, size / 2 + 1.4, 0), false, 32
	for i, t in { { C.ItemName(it), V.color or Color3.new(1, 1, 1) }, { r[1] .. "  $" .. C.Short(C.ItemIncome(it)) .. "/s", r[2] } } do
		local l = Instance.new("TextLabel")
		l.Size, l.Position, l.BackgroundTransparency = UDim2.fromScale(1, 0.5), UDim2.fromScale(0, (i - 1) * 0.5), 1
		l.FontFace, l.TextScaled, l.Text, l.TextColor3 = C.UI.Font, true, t[1], t[2]
		local st = Instance.new("UIStroke")
		st.Thickness, st.Color, st.Parent = 2.5, C.UI.Ink, l
		l.Parent = bb
	end
	bb.Parent = p
	m:SetAttribute("BallId", it.id)
	m:SetAttribute("Variant", it.v or 1)
	return m
end

-- Rebuild the base: keep existing NPCs that are still equipped, add new ones
local function refreshBase(plr)
	local s = sessions[plr]
	if not s then return end
	local base = Map.Bases[s.slot]
	local items = {}
	for _, it in s.d.inv do
		if it.eq and #items < C.MaxEquipped then table.insert(items, it) end
	end
	local bySlot = {}
	for _, npc in base.chars:GetChildren() do
		bySlot[npc:GetAttribute("Slot") or 0] = npc
	end
	for _, npc in bySlot do
		local slot = npc:GetAttribute("Slot")
		local it = slot and items[slot]
		if not it or it.id ~= npc:GetAttribute("BallId") or (it.v or 1) ~= npc:GetAttribute("Variant") then
			npc:Destroy()
			bySlot[slot or 0] = nil
		end
	end
	for i, it in items do
		if not bySlot[i] then
			local npc = makeBall(it, base.slots[i])
			npc:SetAttribute("Slot", i)
			if it.tid then
				npc:SetAttribute("ThrowId", it.tid) -- the client plays the landing animation on this ball
				it.tid = nil
			end
			npc.Parent = base.chars
		end
	end
end

local function equippedCount(d)
	local n = 0
	for _, it in d.inv do
		if it.eq then n += 1 end
	end
	return n
end

local function pay(s, cost)
	if s.d.cash < cost then return false end
	s.d.cash -= cost
	return true
end

-- ===== The cue in the player's hand (no display at the shop, the shop menu shows all cues) =====
local function currentCue(s)
	local cue = C.Cues[s.d.cue]
	if s.passes.DragonCue and C.DragonCue[2] > cue[2] then return C.DragonCue, C.DragonCue.tier end
	return cue, s.d.cue
end

local function giveCue(plr, upgraded)
	local s, char = sessions[plr], plr.Character
	local hand = char and char:FindFirstChild("RightHand")
	if not (s and hand) then return end
	local old = char:FindFirstChild("Cue")
	if old then
		if upgraded then Fx:FireClient(plr, "CueSwap", old.Position) end -- the old cue vanishes in a puff
		old:Destroy()
	end
	local cue, tier = currentCue(s)
	local p = cuePart(cue, tier, hand.CFrame * CFrame.Angles(math.rad(-12), 0, 0) * CFrame.new(0, 2.2, 0))
	p.Massless = true
	weldTo(hand, p)
	p.Parent = char
end

-- dumbbell plates/size follow the level (client rebuilds the mesh when the values change)
local function dressDumbbell(s)
	local db = Map.Bases[s.slot].dumbbell
	local color, scale = C.DumbbellLook(s.d.dumbLevel)
	local plate, sc = db:FindFirstChild("Plate"), db:FindFirstChild("Scale")
	if plate then plate.Value = color end
	if sc then sc.Value = scale end
end

-- ===== Player actions (Request:InvokeServer(action, arg)) =====
local actions = {}
local COOLDOWN = { Settings = 0.2, Sync = 0.5, TrainStart = 0.5, TrainStop = 0.2, Equip = 0.15, Sell = 0.15, EquipBest = 0.5, SellRarity = 0.5, Cue = 0.3, UpDumb = 0.3, Daily = 1, Playtime = 0.5, Pass = 1, Product = 1, Tutorial = 0.2 }

function actions.Sync() return true end

function actions.Settings(_, s, st)
	if type(st) ~= "table" then return false end
	local function vol(v, def) return type(v) == "number" and v == v and math.clamp(v, 0, 1) or def end
	s.d.settings = { music = vol(st.music, 0.5), sfx = vol(st.sfx, 0.7), shake = st.shake ~= false, short = st.short == true }
	return true
end

function actions.Tutorial(_, s, step)
	if type(step) == "number" and step == s.d.tutorial + 1 and step <= 4 then s.d.tutorial = step end
	return true
end

function actions.Throw(plr, s, power)
	if type(power) ~= "number" or power ~= power or os.clock() < s.nextThrow then return false end
	if #s.d.inv >= C.MaxInventory then return false, "Inventory is full. Sell someone first" end
	local dist = C.Distance(math.clamp(power, 0, 1), s.d, s.passes)
	local zone = C.ZoneOf(dist)
	-- luck grows along the path: the client shows the same track live while the ball rolls
	local luck0 = C.StartLuck(s.d, s.passes)
	local track, lucky = C.LuckTrack(luck0, zone, function() return rng:NextNumber() end)
	local L = track[zone]
	local rarity = math.min(zone + C.LuckBonus(L, rng:NextNumber(), rng:NextNumber(), rng:NextNumber()), N)
	local full = rarity >= C.FullCinematicRarity and rarity >= s.d.best - 2 -- the big show only for top pulls
	s.d.best = math.max(s.d.best, rarity)
	s.nextThrow = os.clock() + C.ThrowTime(dist, full) + C.ThrowCooldown
	local it = { id = rarity, v = C.RollVariant(rng:NextNumber()) }
	throwCounter += 1
	it.eq = equippedCount(s.d) < C.MaxEquipped
	it.tid = it.eq and throwCounter or nil
	table.insert(s.d.inv, it)
	s.d.found[it.id .. "_" .. it.v] = true
	local luckyList = {}
	for k in lucky do table.insert(luckyList, k) end
	Fx:FireAllClients("Throw", {
		slot = s.slot, uid = plr.UserId, dist = dist, id = it.id, v = it.v, track = track, lucky = luckyList,
		tid = it.tid or 0, full = full, gold = s.passes.GoldenBall == true, luck0 = luck0,
		cue = select(2, currentCue(s)), dragon = currentCue(s) == C.DragonCue,
	})
	task.delay(C.ThrowTime(dist, full), refreshBase, plr)
	if s.d.tutorial == 1 then s.d.tutorial = 2 end
	return true
end

-- Training: Start/Stop, the server adds strength every rep while the player stays at the gym
local function near(plr, s)
	local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
	return root and (root.Position - Map.Bases[s.slot].gym.Position).Magnitude <= C.GymRange
end

local function stopTraining(plr, s)
	if not s.training then return end
	s.training = false
	Map.Bases[s.slot].trainPrompt.ActionText = "Start training"
	Fx:FireClient(plr, "Train", false)
end

function actions.TrainStart(plr, s)
	if s.training then return true end
	if not near(plr, s) then return false, "Go to the dumbbell at your base" end
	s.training = true
	s.trainId = (s.trainId or 0) + 1
	local id, reps = s.trainId, 0 -- a quick Stop + Start never runs two rep loops
	Map.Bases[s.slot].trainPrompt.ActionText = "Stop training"
	Fx:FireClient(plr, "Train", true, Map.Bases[s.slot].gym.CFrame, Map.Bases[s.slot].dumbbell)
	task.spawn(function()
		while s.training and s.trainId == id and sessions[plr] == s do
			task.wait(C.TrainRep)
			if not (s.training and s.trainId == id and sessions[plr] == s) then break end
			if not near(plr, s) then
				stopTraining(plr, s)
				break
			end
			local gain = C.RepStrength(s.d.dumbLevel)
			s.d.strength += gain
			if s.d.tutorial == 2 and s.d.strength >= 20 then
				s.d.tutorial = 3
				sync(plr)
			end
			reps += 1
			Fx:FireClient(plr, "Rep", s.d.strength, gain, reps)
		end
	end)
	return true
end

function actions.TrainStop(plr, s)
	stopTraining(plr, s)
	return true
end

function actions.UpDumb(_, s)
	if not pay(s, C.LiftCost(s.d.dumbLevel)) then return false, "Not enough cash" end
	s.d.dumbLevel += 1
	dressDumbbell(s)
	return true, "Dumbbell level " .. s.d.dumbLevel
end

-- Cues are an upgrade path: you can only buy the next tier, and the new cue replaces the old one
function actions.Cue(plr, s)
	local nextTier = s.d.cue + 1
	local cue = C.Cues[nextTier]
	if not cue then return false, "You own the best cue" end
	if not pay(s, cue[3]) then return false, "Not enough cash" end
	s.d.cue = nextTier
	if s.d.tutorial == 3 then s.d.tutorial = 4 end
	giveCue(plr, true)
	return true, cue[1] .. " cue equipped"
end

function actions.Equip(plr, s, i)
	local it = type(i) == "number" and s.d.inv[i]
	if not it then return false end
	if not it.eq and equippedCount(s.d) >= C.MaxEquipped then return false, "All " .. C.MaxEquipped .. " spots are taken" end
	it.eq = not it.eq
	refreshBase(plr)
	return true
end

function actions.Sell(plr, s, i)
	local it = type(i) == "number" and s.d.inv[i]
	if not it then return false end
	local price = C.ItemIncome(it) * 30
	s.d.cash += price
	table.remove(s.d.inv, i)
	if it.eq then refreshBase(plr) end
	return true, "Sold for $" .. C.Short(price)
end

-- fill the base with the highest-income characters
function actions.EquipBest(plr, s)
	local order = {}
	for i, it in s.d.inv do
		it.eq = false
		table.insert(order, i)
	end
	table.sort(order, function(a, b) return C.ItemIncome(s.d.inv[a]) > C.ItemIncome(s.d.inv[b]) end)
	for k = 1, math.min(C.MaxEquipped, #order) do s.d.inv[order[k]].eq = true end
	refreshBase(plr)
	return true, "Best team placed"
end

-- sell every unequipped character of one rarity (Gold and rarer variants are kept)
function actions.SellRarity(_, s, rarity)
	if type(rarity) ~= "number" or not C.Rarities[rarity] then return false end
	local total, kept, n = 0, {}, 0
	for _, it in s.d.inv do
		if not it.eq and (it.v or 1) < 4 and it.id == rarity then
			total += C.ItemIncome(it) * 30
			n += 1
		else
			table.insert(kept, it)
		end
	end
	if n == 0 then return false, "Nothing to sell" end
	s.d.inv = kept
	s.d.cash += total
	return true, "Sold " .. n .. " for $" .. C.Short(total)
end

function actions.Daily(_, s)
	local day = os.time() // 86400
	local dd = s.d.daily
	if dd.day == day then return false, "Come back tomorrow" end
	dd.streak = (dd.day == day - 1) and dd.streak % #C.Daily + 1 or 1
	dd.day = day
	s.d.cash += C.Daily[dd.streak]
	return true, "+$" .. C.Short(C.Daily[dd.streak])
end

function actions.Playtime(_, s, i)
	local p = type(i) == "number" and C.Playtime[i]
	if not p or s.claimed[i] then return false end
	if os.time() - s.join < p[1] * 60 then return false, "Not yet" end
	s.claimed[i] = true
	s.d.cash += p[2]
	return true, "+$" .. C.Short(p[2])
end

function actions.Pass(plr, _, key)
	local gp = passByKey[key]
	if not gp then return false end
	if gp.id <= 0 then return false, "Set the Game Pass ID in Config" end
	MarketplaceService:PromptGamePassPurchase(plr, gp.id)
	return true
end

function actions.Product(plr, _, i)
	local p = type(i) == "number" and C.Products[i]
	if not p then return false end
	if p.id <= 0 then return false, "Set the Product ID in Config" end
	MarketplaceService:PromptProductPurchase(plr, p.id)
	return true
end

Request.OnServerInvoke = function(plr, action, arg)
	local s, fn = sessions[plr], actions[action]
	if not (s and fn) then return false end
	local now = os.clock()
	if now - (s.last[action] or 0) < (COOLDOWN[action] or 0) then return false end
	s.last[action] = now
	local ok, msg = fn(plr, s, arg)
	sync(plr)
	return ok, msg
end

-- ===== Players =====
local function onCharacter(plr, slot, char)
	task.wait()
	char:PivotTo(Map.Bases[slot].spawn * CFrame.new(0, 3, 0))
	local s = sessions[plr]
	if s then stopTraining(plr, s) end
	char:WaitForChild("RightHand", 10)
	giveCue(plr, false)
end

local function onPlayer(plr)
	local slot
	for i = 1, #Map.Bases do
		if not taken[i] then
			slot = i
			break
		end
	end
	if not slot then
		plr:Kick("Server is full")
		return
	end
	taken[slot] = plr

	local ok, saved
	for attempt = 1, 3 do
		ok, saved = pcall(store.GetAsync, store, plr.UserId)
		if ok then break end
		task.wait(attempt)
	end
	local d = sanitize(saved)
	local passes = {}
	for _, gp in C.GamePasses do
		if gp.id > 0 then
			local ok2, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, plr.UserId, gp.id)
			passes[gp.key] = ok2 and owns
		end
	end
	if not plr.Parent then
		taken[slot] = nil
		return
	end
	sessions[plr] = { d = d, slot = slot, passes = passes, join = os.time(), claimed = {}, nextThrow = 0, last = {}, loaded = ok }

	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local cash = Instance.new("NumberValue")
	cash.Name, cash.Parent = "Cash", ls
	ls.Parent = plr
	Map.SetOwner(slot, plr)

	plr.CharacterAdded:Connect(function(char) onCharacter(plr, slot, char) end)
	if plr.Character then task.spawn(onCharacter, plr, slot, plr.Character) end
	refreshBase(plr)
	dressDumbbell(sessions[plr])
	sync(plr)
end
Players.PlayerAdded:Connect(onPlayer)
for _, p in Players:GetPlayers() do task.spawn(onPlayer, p) end

local function save(plr, s)
	s = s or sessions[plr]
	if not (s and s.loaded) then return end -- never overwrite a save we failed to load
	local copy = table.clone(s.d)
	copy.version = DATA_VERSION
	for attempt = 1, 3 do
		local ok = pcall(store.UpdateAsync, store, plr.UserId, function() return copy end)
		if ok then return end
		task.wait(attempt)
	end
	warn("[Save] failed for", plr.Name)
end

Players.PlayerRemoving:Connect(function(plr)
	local s = sessions[plr]
	task.spawn(save, plr, s)
	if s then
		Map.Bases[s.slot].chars:ClearAllChildren()
		s.training = false
		Map.SetOwner(s.slot, nil)
		taken[s.slot] = nil
	end
	sessions[plr] = nil
end)

game:BindToClose(function()
	local left = 0
	for plr, s in sessions do
		left += 1
		task.spawn(function()
			save(plr, s)
			left -= 1
		end)
	end
	local t0 = os.clock()
	while left > 0 and os.clock() - t0 < 25 do task.wait(0.2) end
end)

-- gym and cue shop stand in front of each base and only serve the base owner
for idx, base in Map.Bases do
	local function owner(plr)
		local s = sessions[plr]
		if s and s.slot == idx then return s end
		if s then Fx:FireClient(plr, "Toast", "Use the gym and shop at your own base") end
	end
	base.trainPrompt.Triggered:Connect(function(plr)
		local s = owner(plr)
		if s then
			if s.training then stopTraining(plr, s) else actions.TrainStart(plr, s) end
			sync(plr)
		end
	end)
	base.shopPrompt.Triggered:Connect(function(plr)
		if owner(plr) then Fx:FireClient(plr, "Open", "Cues") end
	end)
	-- stepping into the glowing ring in front of the dumbbell opens the gym upgrade menu
	local inside = {}
	base.ring.Touched:Connect(function(hit)
		local plr = Players:GetPlayerFromCharacter(hit.Parent)
		if not plr or inside[plr] then return end
		inside[plr] = true
		if owner(plr) then Fx:FireClient(plr, "Open", "Gym") end
		task.delay(3, function() inside[plr] = nil end)
	end)
end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(plr, id, bought)
	local s = sessions[plr]
	if not (s and bought) then return end
	local key
	for _, gp in C.GamePasses do
		if gp.id == id then
			s.passes[gp.key] = true
			key = gp.key
		end
	end
	if key == "DragonCue" then
		giveCue(plr, true)
	end
	sync(plr)
end)

MarketplaceService.ProcessReceipt = function(info)
	local plr = Players:GetPlayerByUserId(info.PlayerId)
	local s = plr and sessions[plr]
	if not s then return Enum.ProductPurchaseDecision.NotProcessedYet end
	if not table.find(s.d.receipts, info.PurchaseId) then
		for _, p in C.Products do
			if p.id == info.ProductId then s.d.cash += p.cash end
		end
		table.insert(s.d.receipts, info.PurchaseId)
		if #s.d.receipts > 50 then table.remove(s.d.receipts, 1) end
		save(plr)
		sync(plr)
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- ===== Income every second, autosave every 2 minutes =====
task.spawn(function()
	local t = 0
	while true do
		task.wait(1)
		t += 1
		for plr, s in sessions do
			s.d.cash += income(s)
			plr.leaderstats.Cash.Value = math.floor(s.d.cash)
			Fx:FireClient(plr, "Cash", s.d.cash)
		end
		if t % 120 == 0 then
			for plr in sessions do task.spawn(save, plr) end
		end
	end
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX1938"><Properties><string name="Name">Map</string><ProtectedString name="Source"><![CDATA[-- The map lives in Workspace.World (generated by tools/place.py). This module finds the objects the server needs.
local Players = game:GetService("Players")
local C = require(game.ReplicatedStorage.Shared.Config)

local Map = { Bases = {} }

-- round owner photo + name floating above the base
local function ownerBoard(anchor)
	local bb = Instance.new("BillboardGui") -- sized in studs: shrinks with distance like a real sign
	bb.Name, bb.Size, bb.AlwaysOnTop, bb.MaxDistance, bb.LightInfluence = "Owner", UDim2.fromScale(9, 11.6), false, 260, 0
	local photo = Instance.new("ImageLabel")
	photo.Name, photo.Size, photo.BackgroundColor3 = "Photo", UDim2.fromScale(1, 9 / 11.6), C.UI.Panel
	Instance.new("UICorner", photo).CornerRadius = UDim.new(1, 0)
	local st = Instance.new("UIStroke")
	st.Thickness, st.Color, st.Parent = 5, Color3.new(1, 1, 1), photo
	photo.Parent = bb
	local name = Instance.new("TextLabel")
	name.Name, name.Size, name.Position, name.BackgroundTransparency = "Label", UDim2.fromScale(1.4, 2.2 / 11.6), UDim2.fromScale(-0.2, 9.3 / 11.6), 1
	name.FontFace, name.TextScaled, name.TextColor3 = C.UI.Font, true, Color3.new(1, 1, 1)
	local ns = Instance.new("UIStroke")
	ns.Thickness, ns.Color, ns.Parent = 3, C.UI.Ink, name
	name.Parent, bb.Parent = bb, anchor
	return bb
end

function Map.Build()
	local world = workspace:WaitForChild("World")
	for i = 1, 4 do
		local base = world["Base" .. i]
		local slots = {}
		for s = 1, C.MaxEquipped do
			slots[s] = base.Slots["Slot" .. s].CFrame -- spots on the felt of the base table
		end
		local gym = base.Gym
		local board = ownerBoard(base.AvatarAnchor)
		Map.Bases[i] = {
			slots = slots,
			spawn = base.SpawnPoint.CFrame,
			gym = gym.TrainSpot,
			trainPrompt = gym.TrainSpot.Prompt,
			ring = gym.UpgradeRing,
			dumbbell = gym.Dumbbell,
			shopPrompt = base.CueShop.Prompt,
			chars = base.Chars,
			board = board,
		}
		for _, p in { gym.TrainSpot.Prompt, base.CueShop.Prompt } do p.RequiresLineOfSight = false end
		Map.SetOwner(i, nil)
	end
	task.spawn(Map.Mountains)
	local clouds = Instance.new("Clouds")
	clouds.Cover, clouds.Density, clouds.Parent = 0.5, 0.5, workspace.Terrain
	return Map
end

-- Blocky "square mountains" of Terrain all around the hall and along both sides of the long table:
-- stacked boxes that shrink as they rise, grass at the bottom, rock in the middle, snow on the tallest tops.
function Map.Mountains()
	local terrain, A, T = workspace.Terrain, C.Arena, C.Table
	local rng = Random.new(7)
	local far = T.StartZ + T.Length + 800
	local function mountain(x, z, w, d, h)
		local step = 8
		local tiers = math.max(2, math.floor(h / step))
		for k = 0, tiers - 1 do
			local f = 1 - k / (tiers + 1)
			local y = k * step
			local mat = (h > 70 and k >= tiers - 2) and Enum.Material.Snow or k <= 1 and Enum.Material.Grass or Enum.Material.Rock
			local ox, oz = rng:NextNumber(-3, 3) * k * 0.3, rng:NextNumber(-3, 3) * k * 0.3 -- slightly uneven steps
			terrain:FillBlock(CFrame.new(x + ox, y + step / 2 - 2, z + oz), Vector3.new(w * f, step, d * f), mat)
		end
	end
	local function row(x0, x1, z0, z1, along) -- a ridge of mountains filling a strip
		local pos = along == "z" and z0 or x0
		local stop = along == "z" and z1 or x1
		while pos < stop do
			local size = rng:NextNumber(36, 64)
			local h = rng:NextNumber(36, 96)
			if along == "z" then
				mountain(rng:NextNumber(x0, x1), pos + size / 2, rng:NextNumber(40, 70), size, h)
			else
				mountain(pos + size / 2, rng:NextNumber(z0, z1), size, rng:NextNumber(40, 70), h)
			end
			pos += size * 0.7
			task.wait()
		end
	end
	-- ridge centres sit at least 36 studs (half the largest mountain) outside the play area
	local hx, cx, m = A.HallHalfWidth, A.CorridorHalfWidth, 36
	row(-hx - 80, hx + 80, A.HallBack - m - 30, A.HallBack - m, "x") -- behind the bases
	for _, sx in { -1, 1 } do
		local function xs(a, b) return sx > 0 and a or -b, sx > 0 and b or -a end
		local x0, x1 = xs(hx + m, hx + m + 30)
		row(x0, x1, A.HallBack - m, T.StartZ, "z") -- hall sides
		x0, x1 = xs(cx + m, hx + m)
		row(x0, x1, T.StartZ + m, T.StartZ + m + 20, "x") -- hall front, beside the table
		x0, x1 = xs(cx + m, cx + m + 30)
		row(x0, x1, T.StartZ + m, far, "z") -- along the long table
	end
end

function Map.SetOwner(i, plr)
	local board = Map.Bases[i].board
	board.Label.Text = plr and plr.DisplayName or "Free base"
	board.Photo.Image = ""
	board.Photo.Visible = plr ~= nil
	if plr then
		task.spawn(function()
			local ok, img = pcall(Players.GetUserThumbnailAsync, Players, plr.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
			if ok and plr.Parent then board.Photo.Image = img end
		end)
	end
end

return Map
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX1939"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX1940"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX1941"><Properties><string name="Name">Client</string></Properties><Item class="LocalScript" referent="RBX1942"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[-- HUD + panels, laid out from the Figma file "Billiard Hunters — UI" (frames "… v3", 1920x1080, scaled to screen).
-- Dark panels and cards with light text; the coloured cartoon buttons stay as they are.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")
local C = require(RS.Shared.Config)
local MeshBuilder = require(RS.Shared.MeshBuilder)
local U = C.UI
local plr = Players.LocalPlayer
local WHITE, INK = Color3.new(1, 1, 1), U.Ink
local rgb = Color3.fromRGB
local GREEN, ORANGE, PURPLE = { rgb(157, 245, 154), rgb(62, 193, 90) }, { rgb(255, 196, 138), rgb(255, 138, 61) }, { rgb(230, 166, 255), rgb(164, 92, 255) }
local GREY = { rgb(205, 198, 214), rgb(170, 162, 182) }
local CREAM = { rgb(255, 251, 242), rgb(255, 236, 206) } -- panel body
local MUTED, MONEY = rgb(118, 100, 138), rgb(40, 160, 70)

-- ===== Sound =====
local groups, sounds = {}, {}
for _, n in { "Music", "SFX" } do
	local g = Instance.new("SoundGroup")
	g.Name, g.Volume, g.Parent = n, 0.5, SoundService
	groups[n] = g
end
for k, id in C.Sounds do
	local s = Instance.new("Sound")
	s.SoundId, s.SoundGroup, s.Parent = id, k == "Music" and groups.Music or groups.SFX, SoundService
	sounds[k] = s
end
sounds.Music.Looped = true
sounds.Music:Play()
_G.PlaySfx = function(k)
	if sounds[k] and k ~= "Music" then sounds[k]:Play() end
end

-- ===== Building blocks =====
local function new(class, props, children)
	local o = Instance.new(class)
	for k, v in props do
		if k ~= "Parent" then o[k] = v end
	end
	for _, c in children or {} do c.Parent = o end
	if props.Parent then o.Parent = props.Parent end
	return o
end
local function corner(px) return new("UICorner", { CornerRadius = UDim.new(0, px) }) end
local function stroke(t, color) return new("UIStroke", { Color = color or INK, Thickness = t, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }) end
local function grad(a, b) return new("UIGradient", { Rotation = 90, Color = ColorSequence.new(a, b) }) end
local function tween(o, t, props, style) TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad), props):Play() end

local function text(str, size, color, props)
	props = props or {}
	props.BackgroundTransparency, props.FontFace, props.Text = 1, U.Font, str
	props.TextSize, props.TextColor3 = size, color or WHITE
	props.Size = props.Size or UDim2.new(1, 0, 0, size * 1.25)
	local outline = props.NoStroke
	props.NoStroke = nil
	local l = new("TextLabel", props)
	if not outline then new("UIStroke", { Color = INK, Thickness = math.max(2, size / 11), Parent = l }) end
	return l
end

-- cartoon box: gradient body, outline, hard shadow 6 px below
local function box(props, top, bottom, radius, strokeW, strokeColor)
	local holder = new("Frame", { Size = props.Size, Position = props.Position or UDim2.new(), AnchorPoint = props.AnchorPoint or Vector2.zero, BackgroundTransparency = 1, LayoutOrder = props.LayoutOrder or 0, Name = props.Name or "Box", ZIndex = props.ZIndex or 1, Parent = props.Parent })
	new("Frame", { Name = "Shadow", Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(0, strokeW == 0 and 0 or 6), BackgroundColor3 = INK, BackgroundTransparency = strokeW == 0 and 1 or 0, Parent = holder }, { corner(radius) })
	local body = new("Frame", { Name = "Body", Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, Parent = holder }, { corner(radius), grad(top, bottom) })
	if strokeW ~= 0 then stroke(strokeW or 4, strokeColor).Parent = body end
	return holder, body
end
-- white cartoon card inside a panel: ink outline, soft cream gradient
local function card(props, radius, color)
	local f = new("Frame", { Size = props.Size, Position = props.Position or UDim2.new(), LayoutOrder = props.LayoutOrder or 0, BackgroundColor3 = WHITE, Name = props.Name or "Card", Parent = props.Parent }, {
		corner(radius or 20), stroke(3), grad(color or WHITE, (color or WHITE):Lerp(CREAM[2], 0.5)),
	})
	return f
end

-- button with hover/press bounce; returns holder, body, label, setEnabled(on, colors?)
local function button(props, colors, label, size, onClick)
	local holder, body = box(props, colors[1], colors[2], props.Radius or 18, 3)
	local hit = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 5, Parent = holder })
	local scale = new("UIScale", { Parent = holder })
	local big = math.floor((size or 24) * 1.35) -- large, readable button text; shrinks only if the label is long
	local lbl = text(label or "", big, nil, { Size = UDim2.new(1, -16, 1, -8), Position = UDim2.fromOffset(8, 4), Parent = body, TextScaled = true })
	new("UITextSizeConstraint", { MaxTextSize = big, Parent = lbl })
	local enabled = true
	hit.MouseEnter:Connect(function() if enabled then tween(scale, 0.15, { Scale = 1.06 }, Enum.EasingStyle.Back) end end)
	hit.MouseLeave:Connect(function() tween(scale, 0.15, { Scale = 1 }) end)
	hit.Activated:Connect(function()
		if not enabled then return end
		_G.PlaySfx("Click")
		scale.Scale = 0.88
		tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		if onClick then onClick() end
	end)
	local function setEnabled(on, cols)
		enabled = on
		local c = on and (cols or colors) or GREY
		body.UIGradient.Color = ColorSequence.new(c[1], c[2])
	end
	return holder, body, lbl, setEnabled, hit
end

-- progress bar: returns frame, set(fraction, colour?)
local function bar(parent, pos, size, color)
	local f = new("Frame", { Position = pos, Size = size, BackgroundColor3 = rgb(230, 220, 205), Parent = parent }, { corner(math.floor(size.Y.Offset / 2)), stroke(2) })
	local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = color or GREEN[2], Parent = f }, { corner(math.floor(size.Y.Offset / 2)) })
	return f, function(v, c)
		fill.Size = UDim2.fromScale(math.clamp(v, 0, 1), 1)
		if c then fill.BackgroundColor3 = c end
	end
end

-- 3D preview of a Blender model inside a ViewportFrame (cached MeshParts are re-parented, never rebuilt)
local previewCache = {}
local function viewport(parent, props, mesh, overrides, key, camCF)
	local vp = new("ViewportFrame", { Size = props.Size, Position = props.Position or UDim2.new(), BackgroundTransparency = 1, Ambient = rgb(200, 195, 215), LightColor = WHITE, LightDirection = Vector3.new(-1, -1, -0.6), Parent = parent })
	local part = previewCache[key]
	if not part then
		part = MeshBuilder.Create(mesh, CFrame.new(), overrides)
		if not part then -- no EditableMesh: a simple stand-in shape
			local size = mesh == "Cue" and Vector3.new(0.3, 9.2, 0.3) or mesh == "PrizeBall" and Vector3.one or Vector3.new(5.2, 2.3, 2.3)
			part = new("Part", { Size = size, Shape = mesh == "PrizeBall" and Enum.PartType.Ball or Enum.PartType.Block, Color = overrides and (overrides.Shaft or overrides.Plate or overrides.Body) or WHITE, Anchored = true })
		end
		previewCache[key] = part
	end
	part.Parent = vp
	local cam = new("Camera", { FieldOfView = 30, CFrame = camCF, Parent = vp })
	vp.CurrentCamera = cam
	return vp
end
local function releasePreviews()
	for _, p in previewCache do p.Parent = nil end
end

-- ===== Root (design space 1920x1080) =====
local gui = new("ScreenGui", { Name = "Main", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = plr:WaitForChild("PlayerGui") })
gui.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets -- stay clear of notches and the Roblox top bar
local root = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = gui })
local hud = new("Frame", { Name = "HUD", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = root })
-- Every HUD block is laid out in 1920x1080 design pixels inside its own frame, anchored to a screen edge and scaled
-- by the same factor: on any aspect ratio the menu hugs the left edge, SHOOT the bottom, the stats the top.
local scales = {}
local function group(name, size, anchor, pos, parent)
	local f = new("Frame", { Name = name, Size = UDim2.fromOffset(size.X, size.Y), AnchorPoint = anchor, Position = pos, BackgroundTransparency = 1, Parent = parent or hud })
	table.insert(scales, new("UIScale", { Parent = f }))
	return f
end
local topBar = group("Top", Vector2.new(920, 110), Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 8))
local leftBar = group("Left", Vector2.new(150, 600), Vector2.new(0, 0.5), UDim2.new(0, 12, 0.5, 0))
local shotBar = group("Shot", Vector2.new(640, 280), Vector2.new(0.5, 1), UDim2.new(0.5, 0, 1, -6))
local cornerBar = group("Corner", Vector2.new(460, 230), Vector2.new(1, 1), UDim2.new(1, -12, 1, -12))
local center = group("Panels", Vector2.new(980, 690), Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.52), root)
local function rescale()
	local v = workspace.CurrentCamera.ViewportSize
	local k = math.clamp(math.min(v.X / 1920, v.Y / 1080), 0.4, 1.4) -- phones get slightly bigger buttons than pure fit
	for _, sc in scales do sc.Scale = k end
end
workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
rescale()

local Remotes = RS:WaitForChild("Remotes")
local Request, Fx = Remotes:WaitForChild("Request"), Remotes:WaitForChild("Fx")
local state

-- ===== Toast stack (under the top bar, never over it) =====
local toastStack = new("Frame", { Size = UDim2.fromOffset(700, 200), Position = UDim2.fromOffset(460, 120), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1, ZIndex = 30, Parent = topBar }, {
	new("UIListLayout", { Padding = UDim.new(0, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
})
local toastN = 0
local function toast(msg, color)
	toastN += 1
	local items = {}
	for _, c in toastStack:GetChildren() do
		if c:IsA("Frame") then table.insert(items, c) end
	end
	if #items >= 3 then items[1]:Destroy() end
	local holder, body = box({ Size = UDim2.fromOffset(580, 60), LayoutOrder = toastN, Parent = toastStack }, CREAM[1], CREAM[2], 30, 4)
	text(msg, 30, color or U.Title, { Size = UDim2.new(1, -20, 1, 0), Position = UDim2.fromOffset(10, 0), Parent = body, TextScaled = false })
	local sc = new("UIScale", { Scale = 0.5, Parent = holder })
	tween(sc, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(2.6, function()
		tween(sc, 0.25, { Scale = 0 })
		task.wait(0.27)
		holder:Destroy()
	end)
end
_G.Toast = toast

local function call(action, arg)
	local ok, msg = Request:InvokeServer(action, arg)
	if msg then
		toast(msg, ok and U.Title or U.Bad)
		_G.PlaySfx(ok and "Reward" or "Click")
	end
	return ok
end

-- ===== HUD =====
-- top bar: cash (+income) | strength | luck at the start of a shot
local function pill(x, w, colors, label)
	local holder, body = box({ Size = UDim2.fromOffset(w, 90), Position = UDim2.fromOffset(x - 500, 4), Parent = topBar }, colors[1], colors[2], 45, 4)
	text(label, 18, WHITE, { Size = UDim2.fromOffset(w, 22), Position = UDim2.fromOffset(0, 8), Parent = body, NoStroke = true, TextTransparency = 0.15 })
	return holder, body
end
local _, cashBody = pill(500, 400, GREEN, "CASH")
local cashLabel = text("$0", 40, nil, { Size = UDim2.fromOffset(230, 50), Position = UDim2.fromOffset(22, 28), Parent = cashBody, TextXAlignment = Enum.TextXAlignment.Left })
local incomeLabel = text("+$0/s", 24, nil, { Size = UDim2.fromOffset(140, 50), Position = UDim2.fromOffset(240, 28), Parent = cashBody, TextXAlignment = Enum.TextXAlignment.Right })
local strHolder, strBody = pill(920, 220, ORANGE, "STRENGTH")
local strLabel = text("0", 40, nil, { Size = UDim2.new(1, 0, 0, 50), Position = UDim2.fromOffset(0, 28), Parent = strBody })
local strScale = new("UIScale", { Parent = strHolder })
local _, luckBody = pill(1160, 260, PURPLE, "START LUCK")
local luckLabel = text("1.00X", 40, nil, { Size = UDim2.new(1, 0, 0, 50), Position = UDim2.fromOffset(0, 28), Parent = luckBody })

-- left menu with badges
local menu = new("Frame", { Size = UDim2.fromOffset(150, 600), BackgroundTransparency = 1, Parent = leftBar }, {
	new("UIListLayout", { Padding = UDim.new(0, 20), SortOrder = Enum.SortOrder.LayoutOrder }),
})
local badges = {}
local open -- forward

-- shot area: live preview, power bar, SHOOT
local previewHolder, previewBody = box({ Size = UDim2.fromOffset(460, 56), Position = UDim2.fromOffset(320, 0), AnchorPoint = Vector2.new(0.5, 0), Parent = shotBar }, rgb(255, 227, 138), rgb(255, 184, 48), 28, 3)
local previewLabel = text("TABLE 1", 32, nil, { Size = UDim2.fromScale(1, 1), Parent = previewBody })
local powerFrame = new("Frame", { Size = UDim2.fromOffset(640, 44), Position = UDim2.fromOffset(0, 66), BackgroundColor3 = INK, Parent = shotBar }, { corner(22), stroke(4) })
local powerFill = new("Frame", { Size = UDim2.new(0, 0, 1, -12), Position = UDim2.fromOffset(6, 6), BackgroundColor3 = WHITE, Parent = powerFrame }, {
	corner(16), new("UIGradient", { Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, rgb(90, 220, 90)), ColorSequenceKeypoint.new(0.6, rgb(255, 220, 40)), ColorSequenceKeypoint.new(1, rgb(255, 60, 60)) }) }),
})
local _, _, shootLabel, setShootEnabled, shootHit = button({ Size = UDim2.fromOffset(380, 116), Position = UDim2.fromOffset(130, 122), Parent = shotBar, Radius = 44 }, U.Red, "SHOOT", 56)
local hint = text("Hold to charge, release to shoot", 24, nil, { Size = UDim2.fromOffset(640, 30), Position = UDim2.fromOffset(0, 248), Parent = shotBar })

-- training context button (shown at the gym and while training)
local trainHolder, _, trainLabel = button({ Size = UDim2.fromOffset(320, 96), Position = UDim2.fromOffset(140, 134), Parent = cornerBar, Radius = 32 }, GREEN, "START TRAINING", 30, function()
	if state then call(state.training and "TrainStop" or "TrainStart") end
end)
trainHolder.Visible = false

-- onboarding bubble
local tipHolder, tipBody = box({ Size = UDim2.fromOffset(460, 110), Position = UDim2.fromOffset(0, 0), Parent = cornerBar }, CREAM[1], CREAM[2], 26, 4)
local tipText = text("", 26, INK, { Size = UDim2.new(1, -40, 0, 56), Position = UDim2.fromOffset(20, 10), Parent = tipBody, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, NoStroke = true })
local tipStep = text("", 22, PURPLE[2], { Size = UDim2.new(1, -40, 0, 24), Position = UDim2.fromOffset(20, 66), Parent = tipBody, TextXAlignment = Enum.TextXAlignment.Left, NoStroke = true })
tipHolder.Visible = false

-- ===== Panels =====
local panels, renderers = {}, {}
local function panel(key, title, colors)
	local holder, body = box({ Size = UDim2.fromOffset(980, 680), Position = UDim2.fromOffset(490, 345), AnchorPoint = Vector2.new(0.5, 0.5), Parent = center, Name = key, ZIndex = 10 }, CREAM[1], CREAM[2], 40, 6)
	holder.Visible = false
	-- title ribbon in the colour of the menu button, a light stripe of polka dots for a playful touch
	local _, ribbon = box({ Size = UDim2.new(1, 24, 0, 92), Position = UDim2.fromOffset(-12, -28), Parent = body }, colors[1], colors[2], 30, 5)
	for k = 0, 9 do
		new("Frame", { Size = UDim2.fromOffset(14, 14), Position = UDim2.new(0, 330 + k * 46, 0, k % 2 == 0 and 16 or 58), BackgroundColor3 = WHITE, BackgroundTransparency = 0.7, Parent = ribbon }, { corner(7) })
	end
	text(title, 56, WHITE, { Size = UDim2.new(1, -160, 1, 0), Position = UDim2.fromOffset(34, 0), Parent = ribbon, TextXAlignment = Enum.TextXAlignment.Left })
	local sub = text("", 26, MUTED, { Size = UDim2.new(1, -80, 0, 30), Position = UDim2.fromOffset(40, 80), Parent = body, TextXAlignment = Enum.TextXAlignment.Left, NoStroke = true })
	button({ Size = UDim2.fromOffset(74, 68), Position = UDim2.fromOffset(900, -16), Parent = body, Radius = 24 }, U.Red, "X", 34, function() holder.Visible = false end)
	local content = new("Frame", { Size = UDim2.fromOffset(900, 530), Position = UDim2.fromOffset(40, 130), BackgroundTransparency = 1, Parent = body })
	panels[key] = { holder = holder, content = content, sub = sub }
end
local function clear(f)
	releasePreviews()
	for _, c in f:GetChildren() do c:Destroy() end
end
local function scroller(parent, pos, size, cell, pad)
	return new("ScrollingFrame", {
		Position = pos, Size = size, BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 8, ScrollBarImageColor3 = INK,
		AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = parent,
	}, {
		new("UIGridLayout", { CellSize = cell, CellPadding = UDim2.fromOffset(pad, pad), SortOrder = Enum.SortOrder.LayoutOrder }),
		new("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingLeft = UDim.new(0, 2), PaddingRight = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12) }),
	})
end

function open(key, force)
	if not state then return end
	local p = panels[key]
	local show = force or not p.holder.Visible
	for _, q in panels do q.holder.Visible = false end
	if not show then return end
	p.holder.Visible = true
	renderers[key]()
	local sc = p.holder:FindFirstChild("Pop") or new("UIScale", { Name = "Pop", Parent = p.holder })
	sc.Scale = 0.6
	tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
end
local function rerender() -- Settings is not rebuilt from server updates (it would interrupt a slider drag)
	for k, p in panels do
		if p.holder.Visible and k ~= "Settings" then renderers[k]() end
	end
end

-- --- Inventory ---
local BALL_CAM = CFrame.lookAt(Vector3.new(0, 0.6, 3.4), Vector3.zero)
panel("Inventory", "Inventory", { U.Menu[2][4], U.Menu[2][5] })
local sortMode = "best"
local TOTAL = #C.Balls * #C.Variants
local function sellDialog()
	local p = panels.Inventory
	local counts = {}
	for _, it in state.d.inv do
		if not it.eq and (it.v or 1) < 4 then
			local r = it.id
			counts[r] = counts[r] or { n = 0, cash = 0 }
			counts[r].n += 1
			counts[r].cash += C.ItemIncome(it) * 30
		end
	end
	local holder, body = box({ Size = UDim2.fromOffset(580, 500), Position = UDim2.fromOffset(450, 260), AnchorPoint = Vector2.new(0.5, 0.5), Parent = p.content, ZIndex = 20 }, CREAM[1], CREAM[2], 30, 5)
	text("Sell unequipped", 36, INK, { Size = UDim2.new(1, -100, 0, 50), Position = UDim2.fromOffset(24, 12), Parent = body, TextXAlignment = Enum.TextXAlignment.Left })
	text("Gold, Diamond, Galaxy and Rainbow are kept", 20, MUTED, { Size = UDim2.new(1, -100, 0, 24), Position = UDim2.fromOffset(26, 60), Parent = body, TextXAlignment = Enum.TextXAlignment.Left, NoStroke = true })
	button({ Size = UDim2.fromOffset(56, 50), Position = UDim2.fromOffset(504, 16), Parent = body, Radius = 18 }, U.Red, "X", 26, function() holder:Destroy() end)
	local list = new("ScrollingFrame", { Size = UDim2.fromOffset(540, 390), Position = UDim2.fromOffset(20, 96), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 8, ScrollBarImageColor3 = INK, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = body }, {
		new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
		new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingRight = UDim.new(0, 10) }),
	})
	local any = false
	for r = 1, #C.Rarities do
		local c = counts[r]
		if c then
			any = true
			local rar = C.Rarities[r]
			local row = card({ Size = UDim2.new(1, 0, 0, 60), LayoutOrder = r, Parent = list }, 16)
			new("Frame", { Size = UDim2.fromOffset(10, 40), Position = UDim2.fromOffset(12, 10), BackgroundColor3 = rar[2], Parent = row }, { corner(5) })
			text(rar[1] .. "  x" .. c.n, 26, INK, { Size = UDim2.fromOffset(260, 60), Position = UDim2.fromOffset(34, 0), Parent = row, TextXAlignment = Enum.TextXAlignment.Left, NoStroke = true })
			button({ Size = UDim2.fromOffset(200, 46), Position = UDim2.fromOffset(310, 7), Parent = row, Radius = 16 }, U.Action, "Sell $" .. C.Short(c.cash), 22, function()
				if call("SellRarity", r) then
					holder:Destroy()
					renderers.Inventory()
				end
			end)
		end
	end
	if not any then text("Nothing to sell: every ball is on your table.", 24, MUTED, { Size = UDim2.new(1, 0, 0, 80), Parent = list, TextWrapped = true, NoStroke = true }) end
end
renderers.Inventory = function()
	local p = panels.Inventory
	clear(p.content)
	local d = state.d
	local on, found = 0, 0
	for _, it in d.inv do
		if it.eq then on += 1 end
	end
	for _ in d.found or {} do found += 1 end
	p.sub.Text = string.format("%d / %d balls   %d / %d on the table   %d / %d found", #d.inv, C.MaxInventory, on, C.MaxEquipped, found, TOTAL)
	local _, setCap = bar(p.content, UDim2.fromOffset(0, 4), UDim2.fromOffset(470, 14))
	setCap(#d.inv / C.MaxInventory, #d.inv >= C.MaxInventory * 0.9 and U.Bad or GREEN[2])
	button({ Size = UDim2.fromOffset(160, 46), Position = UDim2.fromOffset(500, -12), Parent = p.content }, GREEN, "Equip best", 22, function()
		if call("EquipBest") then renderers.Inventory() end
	end)
	button({ Size = UDim2.fromOffset(110, 46), Position = UDim2.fromOffset(672, -12), Parent = p.content }, U.Action, "Sell", 22, sellDialog)
	button({ Size = UDim2.fromOffset(106, 46), Position = UDim2.fromOffset(794, -12), Parent = p.content }, U.Cues, sortMode == "best" and "Best" or "New", 22, function()
		sortMode = sortMode == "best" and "new" or "best"
		renderers.Inventory()
	end)
	local list = scroller(p.content, UDim2.fromOffset(0, 46), UDim2.fromOffset(900, 484), UDim2.fromOffset(285, 250), 16)
	if #d.inv == 0 then
		text("No balls yet.\nHold SHOOT to win your first ball.", 30, MUTED, { Size = UDim2.fromOffset(880, 160), Parent = list, TextWrapped = true, NoStroke = true })
		list.UIGridLayout.CellSize = UDim2.fromOffset(880, 160)
		return
	end
	local rank = {}
	for i in d.inv do table.insert(rank, i) end
	table.sort(rank, function(x, y)
		if sortMode == "new" then return x > y end
		return C.ItemIncome(d.inv[x]) > C.ItemIncome(d.inv[y])
	end)
	for order, i in rank do
		local it = d.inv[i]
		local ch = C.Balls[it.id]
		local rar = C.Rarities[ch.rarity]
		local V = C.Variants[it.v or 1]
		local inc = C.ItemIncome(it)
		local c = card({ Size = UDim2.fromOffset(285, 250), LayoutOrder = order, Parent = list }, 22)
		local ribbon = new("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = rar[2], Parent = c }, { corner(20) })
		new("Frame", { Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 20), BackgroundColor3 = rar[2], BorderSizePixel = 0, Parent = ribbon })
		text(string.upper(rar[1]), 24, nil, { Size = UDim2.fromScale(1, 1), Parent = ribbon })
		viewport(c, { Size = UDim2.fromOffset(96, 96), Position = UDim2.fromOffset(10, 46) }, "PrizeBall", C.BallOverrides(it), "ball" .. it.id .. "_" .. (it.v or 1), BALL_CAM)
		if V.mult > 1 then -- variant badge
			local vb = new("Frame", { Size = UDim2.fromOffset(150, 30), Position = UDim2.fromOffset(118, 50), BackgroundColor3 = V.color or ORANGE[2], Parent = c }, { corner(15), stroke(2) })
			text(string.upper(V.name) .. " x" .. V.mult, 20, nil, { Size = UDim2.fromScale(1, 1), Parent = vb })
		end
		text(ch.name, 28, INK, { Size = UDim2.fromOffset(160, 30), Position = UDim2.fromOffset(114, 84), Parent = c, TextScaled = true, NoStroke = true, TextXAlignment = Enum.TextXAlignment.Left })
		text("$" .. C.Short(inc) .. "/s", 26, MONEY, { Size = UDim2.fromOffset(160, 30), Position = UDim2.fromOffset(114, 114), Parent = c, NoStroke = true, TextXAlignment = Enum.TextXAlignment.Left })
		button({ Size = UDim2.fromOffset(150, 52), Position = UDim2.fromOffset(14, 180), Parent = c, Radius = 18 }, it.eq and U.Red or GREEN, it.eq and "Remove" or "Place", 22, function()
			if call("Equip", i) then renderers.Inventory() end
		end)
		button({ Size = UDim2.fromOffset(98, 52), Position = UDim2.fromOffset(174, 180), Parent = c, Radius = 18 }, U.Action, "Sell", 22, function()
			if call("Sell", i) then renderers.Inventory() end
		end)
		if it.eq then text("ON TABLE", 18, MONEY, { Size = UDim2.fromOffset(160, 24), Position = UDim2.fromOffset(114, 146), Parent = c, NoStroke = true, TextXAlignment = Enum.TextXAlignment.Left }) end
	end
end

-- --- Bonuses ---
panel("Bonus", "Bonuses", { U.Menu[3][4], U.Menu[3][5] })
local bonusTick
renderers.Bonus = function()
	local p = panels.Bonus
	clear(p.content)
	p.sub.Text = "Log in every day for a bigger streak, stay to earn playtime gifts"
	local day = os.time() // 86400
	local dd = state.d.daily
	local claimedToday = dd.day == day
	local streak = (dd.day == day or dd.day == day - 1) and dd.streak or 0
	local today = claimedToday and streak or streak % #C.Daily + 1
	for k = 1, #C.Daily do
		local done = k < today or (claimedToday and k == today)
		local isToday = k == today and not claimedToday
		local tile = card({ Size = UDim2.fromOffset(118, 150), Position = UDim2.fromOffset((k - 1) * 130, 0), Parent = p.content }, 20, isToday and rgb(255, 236, 170) or done and rgb(220, 248, 214) or WHITE)
		if isToday then tile.UIStroke.Thickness = 5 end
		text("Day " .. k, 24, done and MUTED or INK, { Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 14), Parent = tile, NoStroke = true })
		text("$" .. C.Short(C.Daily[k]), 32, done and MUTED or MONEY, { Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 56), Parent = tile, NoStroke = true })
		text(done and "Claimed" or isToday and "Today" or "", 22, done and MONEY or ORANGE[2], { Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 106), Parent = tile, NoStroke = true })
	end
	local _, _, _, setDailyBtn = button({ Size = UDim2.fromOffset(320, 64), Position = UDim2.fromOffset(290, 172), Parent = p.content, Radius = 24 }, { rgb(255, 158, 200), rgb(255, 92, 158) },
		claimedToday and "Come back tomorrow" or "Claim day " .. today, 28, function()
			if not claimedToday and call("Daily") then renderers.Bonus() end
		end)
	setDailyBtn(not claimedToday)
	local rows = {}
	for i, pt in C.Playtime do
		local y = 266 + (i - 1) * 64
		local row = card({ Size = UDim2.fromOffset(900, 54), Position = UDim2.fromOffset(0, y), Parent = p.content }, 16)
		text(pt[1] .. " min", 24, INK, { Size = UDim2.fromOffset(160, 54), Position = UDim2.fromOffset(20, 0), Parent = row, TextXAlignment = Enum.TextXAlignment.Left, NoStroke = true })
		local _, setBar = bar(row, UDim2.fromOffset(180, 19), UDim2.fromOffset(460, 16))
		text("$" .. C.Short(pt[2]), 24, MONEY, { Size = UDim2.fromOffset(110, 54), Position = UDim2.fromOffset(652, 0), Parent = row, NoStroke = true })
		local _, _, lbl, setBtn = button({ Size = UDim2.fromOffset(120, 42), Position = UDim2.fromOffset(770, 6), Parent = row, Radius = 16 }, GREEN, "Claim", 22, function()
			if call("Playtime", i) then renderers.Bonus() end
		end)
		rows[i] = { setBar = setBar, lbl = lbl, setBtn = setBtn }
	end
	bonusTick = function()
		for i, pt in C.Playtime do
			local left = pt[1] * 60 - (os.time() - state.join)
			local r = rows[i]
			r.setBar(1 - math.max(left, 0) / (pt[1] * 60), left <= 0 and GREEN[2] or ORANGE[2])
			if state.claimed[i] then
				r.lbl.Text = "Done"
				r.setBtn(false)
			elseif left > 0 then
				r.lbl.Text = string.format("%d:%02d", left // 60, left % 60)
				r.setBtn(false)
			else
				r.lbl.Text = "Claim"
				r.setBtn(true)
			end
		end
	end
	bonusTick()
end

-- --- Donate shop ---
panel("Shop", "Shop", { U.Menu[4][4], U.Menu[4][5] })
renderers.Shop = function()
	local p = panels.Shop
	clear(p.content)
	p.sub.Text = "Game Passes and cash packs"
	local list = new("ScrollingFrame", { Size = UDim2.fromOffset(900, 530), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 8, ScrollBarImageColor3 = INK, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = p.content })
	local y = 0
	for i, gp in C.GamePasses do
		local owned = state.passes[gp.key]
		local x = ((i - 1) % 2) * 450
		y = ((i - 1) // 2) * 150
		local c = card({ Size = UDim2.fromOffset(436, 136), Position = UDim2.fromOffset(x, y), Parent = list }, 22)
		local disc = new("Frame", { Size = UDim2.fromOffset(96, 96), Position = UDim2.fromOffset(18, 20), BackgroundColor3 = WHITE, Parent = c }, { corner(48), grad(rgb(255, 227, 138), rgb(255, 174, 31)), stroke(3) })
		text(gp.badge, 32, nil, { Size = UDim2.fromScale(1, 1), Parent = disc })
		text(gp.name, 30, INK, { Size = UDim2.fromOffset(300, 40), Position = UDim2.fromOffset(130, 12), Parent = c, TextXAlignment = Enum.TextXAlignment.Left, NoStroke = true })
		text(gp.desc, 19, MUTED, { Size = UDim2.fromOffset(290, 40), Position = UDim2.fromOffset(130, 48), Parent = c, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, NoStroke = true })
		local _, _, _, setBtn = button({ Size = UDim2.fromOffset(160, 40), Position = UDim2.fromOffset(130, 88), Parent = c, Radius = 14 }, U.Red, owned and "Owned" or "Buy", 22, function()
			if not owned then call("Pass", gp.key) end
		end)
		setBtn(not owned)
	end
	y += 160
	text("Cash packs", 30, INK, { Size = UDim2.fromOffset(400, 40), Position = UDim2.fromOffset(0, y), Parent = list, TextXAlignment = Enum.TextXAlignment.Left, NoStroke = true })
	for i, pr in C.Products do
		local c = card({ Size = UDim2.fromOffset(286, 130), Position = UDim2.fromOffset((i - 1) * 302, y + 48), Parent = list }, 22)
		text("$" .. C.Short(pr.cash), 40, MONEY, { Size = UDim2.new(1, 0, 0, 60), Position = UDim2.fromOffset(0, 8), Parent = c })
		button({ Size = UDim2.fromOffset(170, 42), Position = UDim2.fromOffset(58, 74), Parent = c, Radius = 14 }, U.Red, "Buy", 22, function() call("Product", i) end)
	end
end

-- --- Cue shop (opened at the kiosk): every cue in one horizontal list ---
panel("Cues", "Cue Shop", U.Cues)
local function cueOverrides(def)
	local o = {}
	for slot, field in C.CueParts do o[slot] = def[field] end
	return o
end
local CUE_CAM = CFrame.lookAt(Vector3.new(11, 0, 13), Vector3.new(0, 0, 0)) * CFrame.Angles(0, 0, math.rad(-38))
renderers.Cues = function()
	local p = panels.Cues
	clear(p.content)
	local d = state.d
	local nextTier = d.cue + 1
	p.sub.Text = string.format("Shot power x%s   Every upgrade makes your shots go further", C.CueMult(d, state.passes))
	local list = new("ScrollingFrame", {
		Size = UDim2.fromOffset(900, 440), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 8, ScrollBarImageColor3 = INK,
		ScrollingDirection = Enum.ScrollingDirection.X, AutomaticCanvasSize = Enum.AutomaticSize.X, CanvasSize = UDim2.new(), Parent = p.content,
	}, {
		new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 14), SortOrder = Enum.SortOrder.LayoutOrder }),
		new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingLeft = UDim.new(0, 2), PaddingRight = UDim.new(0, 2), PaddingBottom = UDim.new(0, 14) }),
	})
	for k, cue in C.Cues do
		local owned, isNow, isNext = k < d.cue, k == d.cue, k == nextTier
		local c = card({ Size = UDim2.fromOffset(210, 410), LayoutOrder = k, Parent = list }, 22, isNow and rgb(214, 250, 210) or isNext and rgb(255, 240, 190) or WHITE)
		if isNow or isNext then c.UIStroke.Thickness = 5 end
		text("TIER " .. k, 18, MUTED, { Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 12), Parent = c, NoStroke = true })
		text(cue[1], 30, INK, { Size = UDim2.new(1, -16, 0, 36), Position = UDim2.fromOffset(8, 34), Parent = c, TextScaled = true, NoStroke = true })
		local vp = viewport(c, { Size = UDim2.fromOffset(190, 180), Position = UDim2.fromOffset(10, 74) }, "Cue", cueOverrides(cue), "cue" .. k, CUE_CAM)
		if k > nextTier then vp.ImageTransparency, vp.ImageColor3 = 0.2, rgb(150, 140, 160) end
		text("x" .. cue[2], 40, ORANGE[2], { Size = UDim2.new(1, 0, 0, 46), Position = UDim2.fromOffset(0, 258), Parent = c })
		text("shot power", 20, MUTED, { Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 304), Parent = c, NoStroke = true })
		if isNow then
			text("EQUIPPED", 26, MONEY, { Size = UDim2.new(1, 0, 0, 50), Position = UDim2.fromOffset(0, 340), Parent = c, NoStroke = true })
		elseif owned then
			text("OWNED", 22, MUTED, { Size = UDim2.new(1, 0, 0, 50), Position = UDim2.fromOffset(0, 340), Parent = c, NoStroke = true })
		elseif isNext then
			local can = d.cash >= cue[3]
			local _, _, _, setBtn = button({ Size = UDim2.fromOffset(178, 50), Position = UDim2.fromOffset(16, 342), Parent = c, Radius = 18 }, GREEN, "$" .. C.Short(cue[3]), 26, function()
				if can and call("Cue") then renderers.Cues() end
			end)
			setBtn(can)
		else
			text("$" .. C.Short(cue[3]), 24, MUTED, { Size = UDim2.new(1, 0, 0, 50), Position = UDim2.fromOffset(0, 340), Parent = c, NoStroke = true })
		end
	end
	task.defer(function() -- show the current cue and the next one
		list.CanvasPosition = Vector2.new(math.max(0, (d.cue - 2) * 224), 0)
	end)
	local nxt = C.Cues[nextTier]
	local msg = nxt and (d.cash >= nxt[3] and ("Next: " .. nxt[1] .. "  x" .. nxt[2] .. " power") or ("Need $" .. C.Short(nxt[3] - d.cash) .. " more for the " .. nxt[1] .. " cue")) or "You own the best cue"
	text(msg, 28, INK, { Size = UDim2.fromOffset(900, 40), Position = UDim2.fromOffset(0, 470), Parent = p.content, NoStroke = true })
end

-- --- Gym (opened by stepping into the ring in front of the dumbbell) ---
panel("Gym", "Gym", GREEN)
local PLATE_NAMES = { "Iron", "Steel", "Red", "Blue", "Gold", "Diamond", "Galaxy" }
local BELL_CAM = CFrame.lookAt(Vector3.new(6, 4, 10), Vector3.new(0, 0, 0))
renderers.Gym = function()
	local p = panels.Gym
	clear(p.content)
	local d = state.d
	p.sub.Text = state.training and string.format("Training: %d reps, +%s strength per second", state.reps or 0, C.Short(C.RepStrength(d.dumbLevel) / C.TrainRep))
		or "Strength makes every shot longer. Train at your dumbbell."
	local info = card({ Size = UDim2.fromOffset(900, 230), Position = UDim2.fromOffset(0, 0), Parent = p.content }, 26)
	local color, _, band = C.DumbbellLook(d.dumbLevel)
	viewport(info, { Size = UDim2.fromOffset(300, 210), Position = UDim2.fromOffset(10, 10) }, "Dumbbell", { Plate = color }, "bell" .. band, BELL_CAM)
	text("Dumbbell  Lv." .. d.dumbLevel, 40, INK, { Size = UDim2.fromOffset(560, 54), Position = UDim2.fromOffset(320, 24), Parent = info, TextXAlignment = Enum.TextXAlignment.Left, NoStroke = true })
	text(PLATE_NAMES[band] .. " plates   new look every 5 levels", 22, MUTED, { Size = UDim2.fromOffset(560, 30), Position = UDim2.fromOffset(322, 80), Parent = info, TextXAlignment = Enum.TextXAlignment.Left, NoStroke = true })
	text("Strength " .. C.Short(d.strength), 32, ORANGE[2], { Size = UDim2.fromOffset(560, 40), Position = UDim2.fromOffset(322, 124), Parent = info, TextXAlignment = Enum.TextXAlignment.Left, NoStroke = true })
	text(string.format("+%s per rep, one rep every %.1f s", C.Short(C.RepStrength(d.dumbLevel)), C.TrainRep), 24, INK, { Size = UDim2.fromOffset(560, 32), Position = UDim2.fromOffset(322, 168), Parent = info, TextXAlignment = Enum.TextXAlignment.Left, NoStroke = true })
	local cost = C.LiftCost(d.dumbLevel)
	local can = d.cash >= cost
	local _, _, _, setBtn = button({ Size = UDim2.fromOffset(430, 84), Position = UDim2.fromOffset(0, 266), Parent = p.content, Radius = 28 }, ORANGE,
		can and ("UPGRADE  $" .. C.Short(cost)) or ("Need $" .. C.Short(cost - d.cash)), 30, function()
			if can and call("UpDumb") then renderers.Gym() end
		end)
	setBtn(can)
	button({ Size = UDim2.fromOffset(430, 84), Position = UDim2.fromOffset(470, 266), Parent = p.content, Radius = 28 }, state.training and U.Red or GREEN,
		state.training and "STOP TRAINING" or "START TRAINING", 30, function()
			local starting = not state.training
			if call(starting and "TrainStart" or "TrainStop") and starting then
				p.holder.Visible = false -- close the menu to watch the reps
			end
		end)
	text(string.format("Next level: +%s per rep", C.Short(C.RepStrength(d.dumbLevel + 1))), 24, MUTED, { Size = UDim2.fromOffset(430, 36), Position = UDim2.fromOffset(0, 370), Parent = p.content, NoStroke = true })
	text("Stand on the TRAIN spot", 24, MUTED, { Size = UDim2.fromOffset(430, 36), Position = UDim2.fromOffset(470, 370), Parent = p.content, NoStroke = true })
end

-- --- Settings (saved to the account) ---
panel("Settings", "Settings", { U.Menu[1][4], U.Menu[1][5] })
local settings = { music = 0.5, sfx = 0.7, shake = true, short = false }
local saveQueued = false
local function applySettings()
	groups.Music.Volume, groups.SFX.Volume = settings.music, settings.sfx
	_G.ShakeScale = settings.shake and 1 or 0
	_G.ShortOnly = settings.short
end
local function saveSettings()
	applySettings()
	if saveQueued then return end
	saveQueued = true
	task.delay(0.6, function()
		saveQueued = false
		Request:InvokeServer("Settings", settings)
	end)
end
local sliderConns = {}
renderers.Settings = function()
	local p = panels.Settings
	clear(p.content)
	for _, c in sliderConns do c:Disconnect() end
	table.clear(sliderConns)
	p.sub.Text = "Saved to your account"
	local rowsDef = { { "Music", "music", "slider" }, { "Sound effects", "sfx", "slider" }, { "Camera shake", "shake", "toggle" }, { "Short cinematics only", "short", "toggle" } }
	for i, def in rowsDef do
		local row = card({ Size = UDim2.fromOffset(900, 90), Position = UDim2.fromOffset(0, 10 + (i - 1) * 110), Parent = p.content }, 22)
		text(def[1], 32, INK, { Size = UDim2.fromOffset(420, 90), Position = UDim2.fromOffset(30, 0), Parent = row, TextXAlignment = Enum.TextXAlignment.Left, NoStroke = true })
		local key = def[2]
		if def[3] == "slider" then
			local track = new("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.fromOffset(380, 16), Position = UDim2.fromOffset(470, 37), BackgroundColor3 = GREY[1], Parent = row }, { corner(8), stroke(2) })
			local fill = new("Frame", { Size = UDim2.fromScale(settings[key], 1), BackgroundColor3 = rgb(111, 130, 255), Parent = track }, { corner(8) })
			local knob = new("Frame", { Size = UDim2.fromOffset(36, 40), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(settings[key], 0, 0.5, 0), BackgroundColor3 = WHITE, ZIndex = 3, Parent = track }, { corner(18), stroke(4) })
			local dragging = false
			local function setFromX(x)
				local v = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
				settings[key] = math.floor(v * 20 + 0.5) / 20
				fill.Size = UDim2.fromScale(settings[key], 1)
				knob.Position = UDim2.new(settings[key], 0, 0.5, 0)
				saveSettings()
			end
			track.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = true
					setFromX(input.Position.X)
				end
			end)
			table.insert(sliderConns, UserInputService.InputChanged:Connect(function(input)
				if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then setFromX(input.Position.X) end
			end))
			table.insert(sliderConns, UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
			end))
		else
			local on = settings[key]
			local sw = new("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.fromOffset(110, 50), Position = UDim2.fromOffset(760, 20), BackgroundColor3 = on and GREEN[2] or GREY[1], Parent = row }, { corner(25), stroke(3) })
			new("Frame", { Size = UDim2.fromOffset(42, 42), Position = UDim2.fromOffset(on and 64 or 4, 4), BackgroundColor3 = WHITE, Parent = sw }, { corner(21) })
			sw.Activated:Connect(function()
				settings[key] = not settings[key]
				_G.PlaySfx("Click")
				saveSettings()
				renderers.Settings()
			end)
		end
	end
end

-- menu buttons (Figma component "MenuButton": icon + label) with badges
for i, m in U.Menu do
	local holder, body = button({ Size = UDim2.fromOffset(120, 120), LayoutOrder = i, Parent = menu, Radius = 30 }, { m[4], m[5] }, "", 1, function() open(m[1]) end)
	text(m[2], 54, nil, { Size = UDim2.new(1, 0, 0, 66), Position = UDim2.fromOffset(0, 8), Parent = body, NoStroke = true })
	text(m[3], 21, nil, { Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 82), Parent = body })
	holder.Name = m[1]
	local bHolder, bBody = box({ Size = UDim2.fromOffset(40, 40), Position = UDim2.fromOffset(96, -12), Parent = holder, ZIndex = 6 }, rgb(255, 59, 59), rgb(255, 59, 59), 20, 4)
	badges[m[1]] = { holder = bHolder, label = text("!", 24, nil, { Size = UDim2.fromScale(1, 1), Parent = bBody }) }
	bHolder.Visible = false
end
local function setBadge(key, value)
	local b = badges[key]
	b.holder.Visible = value ~= nil
	if value then b.label.Text = tostring(value) end
end
local function updateBadges()
	if not state then return end
	local d = state.d
	local day = os.time() // 86400
	local ready = d.daily.day ~= day and 1 or 0
	for i, pt in C.Playtime do
		if not state.claimed[i] and os.time() - state.join >= pt[1] * 60 then ready += 1 end
	end
	setBadge("Bonus", ready > 0 and ready or nil)
	local on, free = 0, 0
	for _, it in d.inv do
		if it.eq then on += 1 else free += 1 end
	end
	setBadge("Inventory", (#d.inv >= C.MaxInventory * 0.9 or (on < C.MaxEquipped and free > 0)) and "!" or nil)
end

-- ===== Onboarding: 3 steps, with an arrow above the gym / kiosk =====
local TIPS = {
	{ "Hold SHOOT, release when the bar is high", "Step 1 of 3" },
	{ "Go to the gym in front of your base and start training", "Step 2 of 3" },
	{ "Open the cue shop in front of your base and upgrade your cue", "Step 3 of 3" },
}
local arrow, arrowStep
local function baseObj(...)
	local o = workspace.World:FindFirstChild("Base" .. state.slot)
	for _, n in { ... } do o = o and o:FindFirstChild(n) end
	return o
end
local function updateTutorial()
	local step = state and state.d.tutorial or 4
	tipHolder.Visible = step <= 3 and hud.Visible
	if step == arrowStep then return end
	arrowStep = step
	if arrow then
		arrow:Destroy()
		arrow = nil
	end
	if step > 3 then return end
	tipText.Text, tipStep.Text = TIPS[step][1], TIPS[step][2]
	if step >= 2 then
		local target = step == 2 and baseObj("Gym", "TrainSpot") or baseObj("CueShop")
		if target then
			arrow = new("BillboardGui", { Size = UDim2.fromOffset(90, 90), StudsOffset = Vector3.new(0, 9, 0), AlwaysOnTop = true, Adornee = target, Parent = gui })
			local a = text("▼", 80, U.Title, { Size = UDim2.fromScale(1, 1), Parent = arrow })
			TweenService:Create(a, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Position = UDim2.fromOffset(0, 16) }):Play()
		end
	end
end

-- ===== Kiosk hint when the next cue is affordable =====
local kioskTag
local function updateKioskTag()
	if not state then return end
	local nxt = C.Cues[state.d.cue + 1]
	local can = nxt and state.d.cash >= nxt[3]
	if can and not kioskTag then
		local shop = baseObj("CueShop")
		if shop then
			kioskTag = new("BillboardGui", { Size = UDim2.fromOffset(230, 46), StudsOffset = Vector3.new(0, 13.5, 0), MaxDistance = 90, Adornee = shop, Parent = gui })
			local _, b = box({ Size = UDim2.fromScale(1, 1), Parent = kioskTag }, GREEN[1], GREEN[2], 23, 3)
			text("UPGRADE READY", 24, nil, { Size = UDim2.fromScale(1, 1), Parent = b })
		end
	elseif not can and kioskTag then
		kioskTag:Destroy()
		kioskTag = nil
	end
end

-- ===== Training context button: near your gym or while training =====
local function updateTrainButton()
	if not state then return end
	local spot = baseObj("Gym", "TrainSpot")
	local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
	local near = spot and hrp and (hrp.Position - spot.Position).Magnitude <= C.GymRange + 4
	trainHolder.Visible = (state.training or near) and hud.Visible or false
	trainLabel.Text = state.training and ("STOP   " .. (state.reps or 0) .. " REPS") or "START TRAINING"
end

-- ===== Shooting: charge, live preview of where the ball will land =====
local power, charging, t0 = 0, false, 0
local function shotReady() return state and not _G.ThrowBusy and os.clock() >= (_G.ShotReadyAt or 0) end
local function preview(p)
	if not state then return end
	local zone = C.ZoneOf(C.Distance(p, state.d, state.passes))
	local rar = C.Rarities[zone]
	previewLabel.Text = string.format("TABLE %d   %s", zone, string.upper(rar[1]))
	previewBody.UIGradient.Color = ColorSequence.new(rar[2]:Lerp(WHITE, 0.35), rar[2])
end
shootHit.MouseButton1Down:Connect(function()
	if shotReady() then charging, power, t0 = true, 0, 0 end
end)
UserInputService.InputEnded:Connect(function(input)
	if not charging then return end
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
	charging = false
	local ok, msg = Request:InvokeServer("Throw", power)
	if msg then toast(msg, U.Bad) end
	if not ok then powerFill.Size = UDim2.new(0, 0, 1, -12) end
end)
local trainCheck = 0
RunService.RenderStepped:Connect(function(dt)
	if charging then
		t0 += dt
		power = 1 - math.abs(((t0 * 0.8) % 2) - 1)
		powerFill.Size = UDim2.new(power, -12, 1, -12)
		preview(power)
	end
	local ready = shotReady()
	setShootEnabled(ready, U.Red)
	if not charging then
		shootLabel.Text = ready and "SHOOT" or "..."
		if ready then preview(1) end
	end
	hint.Text = ready and "Hold to charge, release to shoot" or "Wait for the ball"
	trainCheck += dt
	if trainCheck > 0.25 then
		trainCheck = 0
		updateTrainButton()
	end
end)

-- ===== Server events =====
local shownCash, targetCash = 0, 0
local function renderStats()
	if not state then return end
	incomeLabel.Text = "+$" .. C.Short(state.income) .. "/s"
	strLabel.Text = C.Short(state.d.strength)
	luckLabel.Text = string.format("%.2fX", state.luck)
end
RunService.Heartbeat:Connect(function(dt) -- smooth cash count-up
	shownCash += (targetCash - shownCash) * math.min(1, dt * 8)
	if math.abs(targetCash - shownCash) < 1 then shownCash = targetCash end
	cashLabel.Text = "$" .. C.Short(shownCash)
end)

local firstState = true
Fx.OnClientEvent:Connect(function(kind, a, b, c)
	if kind == "State" then
		state = a
		_G.MySlot, _G.MyCue = a.slot, a.d.cue
		targetCash = a.d.cash
		if firstState then
			firstState = false
			shownCash = a.d.cash
			for k, v in a.d.settings or {} do settings[k] = v end
			applySettings()
		end
		renderStats()
		updateBadges()
		updateTutorial()
		updateKioskTag()
		updateTrainButton()
		rerender()
	elseif kind == "Cash" then
		targetCash = a
		if state then state.d.cash = a end
		renderStats()
		updateBadges()
		updateKioskTag()
		if panels.Bonus.holder.Visible and bonusTick then bonusTick() end
	elseif kind == "Train" then
		if state then state.training, state.reps = a == true, 0 end
		updateTrainButton()
		if panels.Gym.holder.Visible then renderers.Gym() end
	elseif kind == "Rep" then
		if state then state.d.strength, state.reps = a, c end
		renderStats()
		strScale.Scale = 1.12
		tween(strScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		if panels.Gym.holder.Visible then renderers.Gym() end
	elseif kind == "Open" then
		if panels[a] then open(a, true) end
	elseif kind == "Toast" then
		toast(a, b and U.Title or U.Bad)
		if b then _G.PlaySfx("Reward") end
	elseif kind == "CueSwap" then -- the old cue disappears in a puff
		local puff = new("Part", { Anchored = true, CanCollide = false, Transparency = 1, Size = Vector3.one, Position = a, Parent = workspace })
		local e = new("ParticleEmitter", {
			Color = ColorSequence.new(U.Title, WHITE), Speed = NumberRange.new(6, 12), Lifetime = NumberRange.new(0.4, 0.8),
			SpreadAngle = Vector2.new(180, 180), Size = NumberSequence.new(0.8, 0), LightEmission = 1, Rate = 0, Parent = puff,
		})
		e:Emit(40)
		task.delay(2, puff.Destroy, puff)
		_G.PlaySfx("Reward")
	end
end)

_G.SetHudVisible = function(on)
	hud.Visible = on
	if not on then
		for _, p in panels do p.holder.Visible = false end
	end
	updateTutorial()
end

Request:InvokeServer("Sync")
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX1943"><Properties><string name="Name">Throw</string><ProtectedString name="Source"><![CDATA[-- The shot, start to finish:
--   1. stance: a copy of the shooter bends over the head of their lane, bridge hand on the felt, their own cue
--      (tier colours + effects) in hand; practice strokes, slow backswing, strike — the cue slides through the bridge
--   2. flight: the camera chases the ball over the long table; luck grows table by table ("LUCK 11.56X", the same
--      track the server rolled); the rack breaks quietly in the background and its balls run into the pockets
--   3. reveal: the camera cuts to the player's base, a light beam hits the podium, the new character bursts in
-- Other players' shots are shown without the camera work.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local RS = game:GetService("ReplicatedStorage")
local C = require(RS.Shared.Config)
local MeshBuilder = require(RS.Shared.MeshBuilder)
local CueFx = require(RS.Shared.CueFx)
local Rig = require(RS.Shared.Rig)
local Fx = RS:WaitForChild("Remotes"):WaitForChild("Fx")
local plr = Players.LocalPlayer
local cam = workspace.CurrentCamera
local T, N = C.Table, #C.Rarities
local zoneLen = T.Length / N
local FELT_Y = 3.3
local R = 1.1 -- main ball radius
local RR = 0.75 -- rack ball radius
local BALL_Z = T.StartZ + 13 -- where the ball is struck: room behind it for the shooter and the cue
local RACK_Z = T.StartZ + 30
local GOLD = Color3.fromRGB(255, 200, 50)
local rng = Random.new()
local WHITE = Color3.new(1, 1, 1)

plr.CameraMaxZoomDistance = 40 -- players can't zoom out far enough to see past the scenery

local function sfx(k) if _G.PlaySfx then _G.PlaySfx(k) end end
local function tween(o, t, props, style, dir)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end
local function laneX(slot) return -T.Width / 2 + (slot - 0.5) * T.Width / T.Lanes end
local function zoneAt(z) return math.clamp(math.floor((z - T.StartZ) / zoneLen) + 1, 1, N) end

-- Billiard ball: Blender mesh (coloured body + white number spots), plain sphere as a fallback
local function ball(color, size, cf)
	local b = MeshBuilder.Create("Ball", cf or CFrame.new(), { Body = color }, size)
	if not b then
		b = Instance.new("Part")
		b.Shape, b.Size, b.Color, b.Material = Enum.PartType.Ball, Vector3.one * size, color, Enum.Material.SmoothPlastic
		b.Anchored, b.CanCollide = true, false
		if cf then b.CFrame = cf end
	end
	b:SetAttribute("Tint", color)
	b.CastShadow = true
	b.Parent = workspace
	return b
end

local function anchorPart(cf)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.Transparency, p.Size, p.CFrame = true, false, false, 1, Vector3.one * 0.2, cf
	p.Parent = workspace
	return p
end

local function emitter(parent, props)
	local e = Instance.new("ParticleEmitter")
	e.LightEmission, e.Rate = 1, 0
	for k, v in props do e[k] = v end
	e.Parent = parent
	return e
end

local function burst(at, color, n, speed)
	local p = typeof(at) == "Instance" and at or anchorPart(CFrame.new(at))
	local e = emitter(p, {
		Color = ColorSequence.new(color, WHITE), Speed = NumberRange.new((speed or 14) * 0.5, speed or 14),
		Lifetime = NumberRange.new(0.4, 0.9), SpreadAngle = Vector2.new(180, 180), Size = NumberSequence.new(0.7, 0),
		Drag = 3,
	})
	e:Emit(n)
	if p ~= at then task.delay(2, p.Destroy, p) end
end

-- flat expanding ring on the ground / table
local function shockwave(pos, color, size, t)
	local ring = Instance.new("Part")
	ring.Shape, ring.Anchored, ring.CanCollide, ring.CanQuery, ring.CastShadow = Enum.PartType.Cylinder, true, false, false, false
	ring.Material, ring.Color, ring.Transparency = Enum.Material.ForceField, color, 0
	ring.Size = Vector3.new(0.3, 1, 1)
	ring.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2)
	ring.Parent = workspace
	tween(ring, t or 0.6, { Size = Vector3.new(0.3, size, size), Transparency = 1 }, Enum.EasingStyle.Quart)
	task.delay((t or 0.6) + 0.1, ring.Destroy, ring)
end

local function drop(b, at, quiet)
	if not quiet then sfx("Pocket") end
	burst(b, b:GetAttribute("Tint") or WHITE, quiet and 8 or 25)
	tween(b, 0.45, { Size = Vector3.one * 0.1, CFrame = CFrame.new(at - Vector3.new(0, 1.6, 0)) }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	task.delay(1, b.Destroy, b)
end

-- ===== Long-table pockets (same positions as the Blender table segment) =====
local pockets = {}
for i = 1, N do
	for _, sx in { -1, 1 } do
		table.insert(pockets, Vector3.new(sx * T.Width / 2, FELT_Y + RR, T.StartZ + (i - 0.5) * zoneLen))
	end
end
local function nearestPocket(pos)
	local best, bd
	for _, p in pockets do
		local d = (p - pos).Magnitude
		if not bd or d < bd then best, bd = p, d end
	end
	return best, bd
end

-- ===== A full 15-ball rack on every lane: solids, stripes, the black 8 in the middle =====
local SOLIDS = { Color3.fromRGB(250, 200, 30), Color3.fromRGB(30, 80, 200), Color3.fromRGB(220, 40, 40), Color3.fromRGB(110, 40, 170), Color3.fromRGB(255, 120, 20), Color3.fromRGB(20, 140, 70), Color3.fromRGB(130, 30, 30), Color3.fromRGB(18, 18, 20) }
local ORDER = { 1, 9, 2, 10, 8, 3, 11, 4, 12, 5, 13, 6, 14, 7, 15 }
local racks = {}

local function buildRack(slot)
	local list = {}
	local x0 = laneX(slot)
	local k = 0
	for row = 0, 4 do
		for j = 0, row do
			k += 1
			local n = ORDER[k]
			local b = ball(SOLIDS[(n - 1) % 8 + 1], RR * 2, CFrame.new(x0 + (j - row / 2) * RR * 2.04, FELT_Y + RR, RACK_Z + row * RR * 1.77) * CFrame.Angles(k, k * 2, 0))
			b.Size = Vector3.one * 0.1
			tween(b, 0.4, { Size = Vector3.one * RR * 2 }, Enum.EasingStyle.Back)
			table.insert(list, b)
		end
	end
	racks[slot] = list
end
for s = 1, T.Lanes do task.spawn(buildRack, s) end

-- Scatter physics: friction, rail and ball-ball bounces, pockets "pull" slow balls so every ball gets potted.
-- Runs in the background: no camera work, no sound except the soft clack of the break.
local function breakRack(slot, power)
	local list = racks[slot]
	racks[slot] = nil
	local bodies = {}
	for _, b in list do
		local p = b.Position
		local away = Vector3.new(p.X - laneX(slot), 0, p.Z - RACK_Z + 3).Unit
		local dir = (away + Vector3.new(rng:NextNumber(-0.5, 0.5), 0, 0.4)).Unit
		table.insert(bodies, { b = b, p = p, v = dir * rng:NextNumber(26, 46) * (0.6 + power * 0.6), rot = b.CFrame.Rotation })
	end
	local alive = #bodies
	local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		for i, o in bodies do
			if o.done then continue end
			local speed = o.v.Magnitude
			local target, d = nearestPocket(o.p)
			if d < 2.3 then
				o.done, alive = true, alive - 1
				o.b.CFrame = CFrame.new(target)
				drop(o.b, target, true)
				continue
			end
			o.v *= math.max(0, 1 - 0.55 * dt)
			if speed < 14 then
				o.v += (target - o.p).Unit * 40 * dt
				o.v = o.v.Unit * math.max(o.v.Magnitude, 8)
			end
			o.p += o.v * dt
			local lim = T.Width / 2 - RR
			if math.abs(o.p.X) > lim then -- rail bounce
				o.p = Vector3.new(math.sign(o.p.X) * lim, o.p.Y, o.p.Z)
				o.v = Vector3.new(-o.v.X * 0.8, 0, o.v.Z)
			end
			if o.p.Z < T.StartZ + RR then
				o.p = Vector3.new(o.p.X, o.p.Y, T.StartZ + RR)
				o.v = Vector3.new(o.v.X, 0, -o.v.Z * 0.8)
			end
			for j = i + 1, #bodies do -- elastic ball-ball collision
				local q = bodies[j]
				if not q.done then
					local delta = q.p - o.p
					local dist = delta.Magnitude
					if dist < RR * 2 and dist > 0 then
						local n = delta / dist
						local rel = (o.v - q.v):Dot(n)
						if rel > 0 then
							o.v -= n * rel
							q.v += n * rel
						end
						o.p -= n * (RR * 2 - dist) / 2
						q.p += n * (RR * 2 - dist) / 2
					end
				end
			end
			local axis = o.v.Magnitude > 0.01 and Vector3.yAxis:Cross(o.v.Unit) or Vector3.xAxis
			o.rot = CFrame.fromAxisAngle(axis, o.v.Magnitude * dt / RR) * o.rot
			o.b.CFrame = CFrame.new(o.p) * o.rot
		end
		if alive == 0 then
			conn:Disconnect()
			task.delay(1.5, buildRack, slot)
		end
	end)
end

-- ===== Screen effects =====
local fxGui = Instance.new("ScreenGui")
fxGui.Name, fxGui.IgnoreGuiInset, fxGui.ResetOnSpawn, fxGui.DisplayOrder = "CinemaFx", true, false, 10
fxGui.Parent = plr:WaitForChild("PlayerGui")

local function frame(props)
	local f = Instance.new("Frame")
	f.BorderSizePixel, f.Size = 0, UDim2.fromScale(1, 1)
	for k, v in props do
		if k ~= "Parent" then f[k] = v end
	end
	f.Parent = props.Parent or fxGui
	return f
end
local function label(parent, text, size, color, pos)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency, l.TextScaled, l.FontFace = 1, true, C.UI.Font
	l.Size, l.AnchorPoint, l.Position = size, Vector2.new(0.5, 0.5), pos
	l.Text, l.TextColor3, l.Parent = text, color, parent
	local st = Instance.new("UIStroke")
	st.Thickness, st.Color, st.Parent = 5, C.UI.Ink, l
	local sc = Instance.new("UIScale")
	sc.Scale, sc.Parent = 1, l
	return l, sc
end
local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 60)), ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 230, 40)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(60, 255, 120)), ColorSequenceKeypoint.new(0.75, Color3.fromRGB(60, 160, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 60, 220)),
})

local flash = frame({ BackgroundColor3 = WHITE, BackgroundTransparency = 1, ZIndex = 5 })
local dim = frame({ BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1 })
local bars = {}
for i, y in { 0, 1 } do
	bars[i] = frame({ BackgroundColor3 = Color3.new(0, 0, 0), Size = UDim2.fromScale(1, 0), AnchorPoint = Vector2.new(0, y), Position = UDim2.fromScale(0, y), ZIndex = 4 })
end
local luckLabel, luckScale = label(fxGui, "", UDim2.fromScale(0.42, 0.075), C.UI.Title, UDim2.fromScale(0.5, 0.06))
luckLabel.Visible, luckLabel.ZIndex = false, 6
local luckGrad = Instance.new("UIGradient")
luckGrad.Color, luckGrad.Enabled, luckGrad.Parent = RAINBOW, false, luckLabel
local banner, bannerScale = label(fxGui, "", UDim2.fromScale(0.6, 0.07), WHITE, UDim2.fromScale(0.5, 0.2))
banner.Visible, banner.ZIndex = false, 6

local cc = Instance.new("ColorCorrectionEffect")
cc.Parent = Lighting
local blur = Instance.new("BlurEffect")
blur.Size, blur.Parent = 0, Lighting

local function doFlash(color, strength, t)
	flash.BackgroundColor3, flash.BackgroundTransparency = color, 1 - (strength or 0.8)
	tween(flash, t or 0.5, { BackgroundTransparency = 1 })
end
local function letterbox(on)
	for _, b in bars do tween(b, 0.4, { Size = UDim2.fromScale(1, on and 0.1 or 0) }) end
end
local function pop(sc, from)
	sc.Scale = from or 1.8
	tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
end
local function showBanner(text, color)
	banner.Text, banner.TextColor3, banner.Visible = text, color, true
	banner.TextTransparency, banner.UIStroke.Transparency = 0, 0
	pop(bannerScale, 0.3)
	task.delay(1.2, function()
		if banner.Text == text then
			tween(banner, 0.4, { TextTransparency = 1 })
			tween(banner.UIStroke, 0.4, { Transparency = 1 })
		end
	end)
end

-- Skip button (bottom-right, only during your own cinematic)
local skip = false
local skipBtn = Instance.new("TextButton")
skipBtn.Size, skipBtn.AnchorPoint, skipBtn.Position = UDim2.fromOffset(170, 60), Vector2.new(1, 1), UDim2.new(1, -30, 1, -30)
skipBtn.BackgroundColor3, skipBtn.Text, skipBtn.FontFace, skipBtn.TextSize = WHITE, "SKIP", C.UI.Font, 30
skipBtn.TextColor3, skipBtn.Visible, skipBtn.ZIndex, skipBtn.AutoButtonColor = C.UI.Ink, false, 8, true
Instance.new("UICorner", skipBtn).CornerRadius = UDim.new(0, 24)
local skipStroke = Instance.new("UIStroke")
skipStroke.Thickness, skipStroke.Color, skipStroke.ApplyStrokeMode, skipStroke.Parent = 4, C.UI.Ink, Enum.ApplyStrokeMode.Border, skipBtn
skipBtn.Parent = fxGui
skipBtn.Activated:Connect(function() skip = true end)
local function waitOrSkip(sec)
	local t0 = os.clock()
	while os.clock() - t0 < sec and not skip do RunService.RenderStepped:Wait() end
end

-- ===== Camera =====
local shake = 0
local function hardShake(a) shake = math.max(shake, a * (_G.ShakeScale or 1)) end -- Settings: camera shake on/off
local camFn -- function(dt) -> CFrame, or nil when the default camera is in control
local cinema = false
RunService:BindToRenderStep("CinemaCam", Enum.RenderPriority.Camera.Value + 1, function(dt)
	if not cinema or not camFn then return end
	local goal, snap = camFn(dt)
	cam.CFrame = snap and goal or cam.CFrame:Lerp(goal, math.min(1, dt * 9))
	if shake > 0.01 then
		cam.CFrame *= CFrame.new(rng:NextNumber(-1, 1) * shake, rng:NextNumber(-1, 1) * shake, 0) * CFrame.Angles(0, 0, rng:NextNumber(-1, 1) * shake * 0.04)
		shake *= math.max(0, 1 - dt * 5)
	end
end)

local function setCinema(on)
	cinema = on
	_G.ThrowBusy = on
	if _G.SetHudVisible then _G.SetHudVisible(not on) end
	letterbox(on)
	luckLabel.Visible = on
	skipBtn.Visible = on
	if on then
		skip = false
		cam.CameraType = Enum.CameraType.Scriptable
	else
		camFn = nil
		cam.CameraType = Enum.CameraType.Custom
		tween(cam, 0.6, { FieldOfView = 70 })
		tween(dim, 0.4, { BackgroundTransparency = 1 })
		tween(blur, 0.4, { Size = 0 })
		tween(cc, 0.6, { TintColor = WHITE, Saturation = 0, Brightness = 0, Contrast = 0 })
	end
end

-- prize ball mesh of an item (variant colours + material), plain sphere as a fallback
local function prizeBall(it, size, cf)
	local V = C.Variants[it.v or 1]
	local p = MeshBuilder.Create("PrizeBall", cf or CFrame.new(), C.BallOverrides(it), size)
	if not p then
		p = Instance.new("Part")
		p.Shape, p.Size, p.Color = Enum.PartType.Ball, Vector3.one * size, C.BallOverrides(it).Body
		p.Anchored, p.CanCollide, p.CanQuery = true, false, false
		if cf then p.CFrame = cf end
	end
	if V.material then p.Material = Enum.Material[V.material] end
	if V.name == "Gold" or V.name == "Diamond" then p.Reflectance = 0.3 end
	return p
end

-- ===== Reveal card: spinning rays, the ball turning in 3D, flowing rainbow title, pulse =====
local function revealCard(it, bonus)
	local ch = C.Balls[it.id]
	local V = C.Variants[it.v or 1]
	local r = C.Rarities[ch.rarity]
	local root = frame({ BackgroundTransparency = 1, ZIndex = 3 })
	local rays = frame({ Parent = root, BackgroundTransparency = 1, Size = UDim2.fromOffset(1000, 1000), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42) })
	for k = 1, 16 do
		local pivot = frame({ Parent = rays, BackgroundTransparency = 1, Rotation = k * 22.5 })
		frame({ Parent = pivot, BackgroundColor3 = k % 2 == 0 and r[2] or WHITE, BackgroundTransparency = 0.7, Size = UDim2.new(0, 44, 0.5, 0), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 0.5) })
	end
	local vpHolder = frame({ Parent = root, BackgroundTransparency = 1, Size = UDim2.fromOffset(340, 340), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.36) })
	local vp = Instance.new("ViewportFrame")
	vp.Size, vp.BackgroundTransparency, vp.Ambient, vp.LightDirection = UDim2.fromScale(1, 1), 1, Color3.fromRGB(200, 195, 220), Vector3.new(-1, -1, -1)
	vp.Parent = vpHolder
	local vpScale = Instance.new("UIScale")
	vpScale.Scale, vpScale.Parent = 0, vpHolder
	local shown = prizeBall(it, 4)
	shown.Parent = vp
	local vcam = Instance.new("Camera")
	vcam.FieldOfView, vcam.CFrame, vcam.Parent = 30, CFrame.lookAt(Vector3.new(0, 1.5, 8.5), Vector3.zero), vp
	vp.CurrentCamera = vcam
	tween(vpScale, 0.6, { Scale = 1 }, Enum.EasingStyle.Back)
	local title, s1 = label(root, string.upper(r[1]) .. "!", UDim2.fromScale(0.8, 0.13), WHITE, UDim2.fromScale(0.5, 0.66))
	local name, s2 = label(root, C.ItemName(it), UDim2.fromScale(0.7, 0.08), V.color or r[2], UDim2.fromScale(0.5, 0.77))
	local _, s3 = label(root, "$" .. C.Short(C.ItemIncome(it)) .. "/s", UDim2.fromScale(0.4, 0.055), C.UI.Money, UDim2.fromScale(0.5, 0.84))
	local tagText = V.name ~= "Normal" and (string.upper(V.name) .. "  x" .. V.mult) or bonus > 0 and ("LUCK BONUS +" .. bonus) or "NEW"
	local newTag, s4 = label(root, tagText, UDim2.fromScale(0.3, 0.05), V.color or C.UI.Title, UDim2.fromScale(0.5, 0.58))
	newTag.Rotation = -4
	local grad = Instance.new("UIGradient")
	grad.Color = ch.rarity >= 10 and RAINBOW or ColorSequence.new(WHITE, r[2])
	grad.Parent = title
	for k, sc in { s4, s1, s2, s3 } do
		sc.Scale = 0
		task.delay((k - 1) * 0.12, function() tween(sc, 0.5, { Scale = 1 }, Enum.EasingStyle.Back) end)
	end
	local t0 = os.clock()
	local conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		rays.Rotation = t * 35
		shown.CFrame = CFrame.Angles(0.35, t * 1.6, 0) * CFrame.new(0, math.sin(t * 3) * 0.15, 0)
		grad.Offset = Vector2.new(math.sin(t * 2.5) * 0.6, 0)
		grad.Rotation = t * 60
		if t > 0.6 then s1.Scale = 1 + math.sin(t * 7) * 0.05 end
		if ch.rarity >= 10 then
			name.TextColor3 = Color3.fromHSV((t * 0.5) % 1, 0.65, 1)
			cc.TintColor = Color3.fromHSV((t * 0.4) % 1, 0.22, 1) -- the world itself cycles through colours
		end
	end)
	return function()
		for _, sc in { s1, s2, s3, s4, vpScale } do tween(sc, 0.3, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In) end
		tween(rays, 0.3, { Size = UDim2.fromOffset(0, 0) })
		task.wait(0.35)
		conn:Disconnect()
		root:Destroy()
	end
end

-- ===== 1. The shooter: a posed copy of the player's avatar with their cue =====
local SHOOT_SCALE = 1.35 -- the long table is built big; the shooter is scaled to match
local CUE_K = 0.85 * SHOOT_SCALE -- cue length 9.2 * CUE_K
local PITCH = math.rad(7) -- the butt is raised a little, like a real stroke
local DIR = Vector3.new(0, -math.sin(PITCH), math.cos(PITCH)) -- butt -> tip

local function makeCue(def, tier)
	local overrides = {}
	for slot, field in C.CueParts do overrides[slot] = def[field] end
	local cue = MeshBuilder.Create("Cue", CFrame.new(), overrides, CUE_K)
	if not cue then
		cue = Instance.new("Part")
		cue.Size, cue.Color, cue.Material = Vector3.new(0.3, 9.2, 0.3) * CUE_K, def.shaft, Enum.Material.Wood
		cue.Anchored, cue.CanCollide, cue.CanQuery = true, false, false
	end
	CueFx.Apply(cue, tier, def, CUE_K)
	cue.Parent = workspace
	return cue
end

local function cueCF(grip, back) -- the grip sits 30 % up from the butt
	local Lc = 9.2 * CUE_K
	local g = grip - DIR * back
	return CFrame.fromMatrix(g + DIR * (Lc * 0.2), Vector3.xAxis, DIR), g
end

-- copy of the shooter's character, posed by IK each frame; nil when the avatar isn't available
local function makeShooter(uid)
	local who = Players:GetPlayerByUserId(uid)
	local char = who and who.Character
	if not (char and char:FindFirstChild("HumanoidRootPart")) then return nil end
	char.Archivable = true
	local ok, m = pcall(char.Clone, char)
	if not (ok and m) then return nil end
	for _, d in m:GetDescendants() do
		if d:IsA("BaseScript") or d:IsA("ForceField") or d:IsA("Sound") or (d:IsA("BasePart") and d.Name == "Cue") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.CanCollide, d.CanQuery, d.CanTouch, d.Anchored = false, false, false, false
		end
	end
	local hum = m:FindFirstChildOfClass("Humanoid")
	if not hum then return nil end
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.EvaluateStateMachine = false
	m.HumanoidRootPart.Anchored = true
	pcall(m.ScaleTo, m, SHOOT_SCALE)
	local J = Rig.Joints(m)
	if not J then
		m:Destroy()
		return nil
	end
	m.Name = "Shooter"
	m.Parent = workspace
	return { m = m, J = J, hum = hum }
end

-- Find a natural stance: feet on the felt, right shoulder over the grip, torso bent just enough for the
-- bridge hand to reach the felt in front. Returns the pose function (back -> Transforms) or nil.
local function stance(sh, ballPos)
	local m, J = sh.m, sh.J
	local hrpPart = m.HumanoidRootPart
	local addr = ballPos - DIR * (R + 0.35) -- cue tip at address
	local Lc = 9.2 * CUE_K
	local grip0 = addr - DIR * (Lc * 0.7)
	local bridge = addr - DIR * (2.1 * CUE_K) - Vector3.new(0, 0.18 * SHOOT_SCALE, 0)
	local foot = m:FindFirstChild("RightFoot")
	local footY = FELT_Y + (foot and foot.Size.Y / 2 or 0.2)
	local rightFoot = Vector3.new(ballPos.X - 0.5 * SHOOT_SCALE, footY, grip0.Z - 1.1 * SHOOT_SCALE)
	local leftFoot = Vector3.new(ballPos.X + 1.9 * SHOOT_SCALE, footY, grip0.Z + 1.5 * SHOOT_SCALE)
	local legReach = Rig.Reach(J.RightHip, J.RightKnee, J.RightAnkle)
	local armReach = Rig.Reach(J.LeftShoulder, J.LeftElbow, J.LeftWrist)
	local face = Vector3.new(-0.32, 0, 1).Unit -- turned a little to the right: left shoulder forward
	local stand = sh.hum.HipHeight + hrpPart.Size.Y / 2
	local best
	for bend = 0.7, 1.5, 0.05 do
		local root, waist = CFrame.Angles(-bend * 0.35, 0, 0), CFrame.Angles(-bend * 0.65, 0, 0)
		local pos = Vector3.new(ballPos.X + 1, FELT_Y + stand, grip0.Z)
		local hrp
		for _ = 1, 4 do
			hrp = CFrame.lookAt(pos, pos + face)
			local lt, ut = Rig.Torso(J, hrp, root, waist)
			local sR = Rig.JointPos(ut, J.RightShoulder)
			pos += Vector3.new(ballPos.X + 0.15 - sR.X, 0, grip0.Z + 0.5 * SHOOT_SCALE - sR.Z)
			local hipL, hipR = Rig.JointPos(lt, J.LeftHip), Rig.JointPos(lt, J.RightHip)
			local far = math.max((hipL - leftFoot).Magnitude, (hipR - rightFoot).Magnitude)
			pos -= Vector3.new(0, far - legReach * 0.96, 0) -- feet planted, knees slightly bent
		end
		hrp = CFrame.lookAt(pos, pos + face)
		local _, ut = Rig.Torso(J, hrp, root, waist)
		best = { hrp = hrp, root = root, waist = waist, neck = CFrame.Angles(bend * 0.75, 0, 0) }
		if (Rig.JointPos(ut, J.LeftShoulder) - bridge).Magnitude <= armReach * 0.97 then break end
	end
	hrpPart.CFrame = best.hrp
	return function(back)
		local _, g = cueCF(grip0, back)
		return Rig.Solve(J, best.hrp, {
			root = best.root, waist = best.waist, neck = best.neck,
			rightHand = g, leftHand = bridge, rightFoot = rightFoot, leftFoot = leftFoot,
			rightPole = Vector3.new(-0.4, 0.2, -1).Unit, leftPole = Vector3.new(1, 0.6, 0).Unit,
		})
	end, grip0
end

-- The stroke: practice strokes, slow backswing, pause, strike through the ball. Returns once the tip hits.
local function windup(b, start, mine, power, payload, full)
	local def = CueFx.Def(payload.cue or 1, payload.dragon)
	local cue = makeCue(def, payload.cue or 1)
	local sh = makeShooter(payload.uid)
	local pose, grip0
	if sh then pose, grip0 = stance(sh, start) end
	if not pose then
		grip0 = start - DIR * (R + 0.35 + 9.2 * CUE_K * 0.7)
	end
	local poseConn
	local back = 0
	if pose then
		poseConn = RunService.Stepped:Connect(function() Rig.Apply(sh.J, pose(back)) end)
	end
	local W = C.AnimOf(full).Windup
	local maxBack = (1.1 + 0.9 * power) * SHOOT_SCALE
	local side = start.X < 0 and 1 or -1 -- camera on the table-centre side of the lane
	local t0 = os.clock()
	if mine then
		local mid = start - DIR * 5
		camFn = function()
			local t = math.clamp((os.clock() - t0) / W, 0, 1)
			local e = t * t * (3 - 2 * t)
			local wide = mid + Vector3.new(side * 12, 5.5, 1)
			local behind = grip0 - DIR * 5 + Vector3.new(side * 1.2, 3.4, 0)
			return CFrame.lookAt(wide:Lerp(behind, e), (mid + Vector3.new(0, 1, 0)):Lerp(start + Vector3.new(0, 0.6, 6), e))
		end
		cam.FieldOfView = 55
		tween(cam, W, { FieldOfView = 45 }, Enum.EasingStyle.Sine)
		tween(dim, W, { BackgroundTransparency = 0.7 })
		tween(cc, W, { Saturation = -0.15, Contrast = 0.15 })
	end
	local practice = full and 0.45 or 0.1 -- share of the wind-up spent on practice strokes
	while true do
		local u = (os.clock() - t0) / W
		if u >= 1 or skip then break end
		if u < practice then -- two small practice strokes
			back = 0.45 * SHOOT_SCALE * (1 - math.cos(u / practice * 4 * math.pi)) / 2
		elseif u < 0.86 then -- slow final backswing
			local e = (u - practice) / (0.86 - practice)
			back = maxBack * math.sin(e * math.pi / 2)
			if mine then hardShake(0.03 * e) end
		elseif u < 0.92 then -- pause at the top
			back = maxBack
		else -- strike through the ball
			local e = (u - 0.92) / 0.08
			back = maxBack + (-(R + 0.35) * 0.9 - maxBack) * e ^ 2
		end
		cue.CFrame = cueCF(grip0, back)
		RunService.RenderStepped:Wait()
	end
	back = -(R + 0.35) * 0.9 -- follow-through: the tip ends just past where the ball was
	cue.CFrame = cueCF(grip0, back)
	-- impact
	sfx("Hit")
	burst(start - DIR * R, Color3.fromRGB(120, 180, 255), 14, 6) -- chalk puff
	burst(start, def.inlay:Lerp(WHITE, 0.4), 30, 18)
	shockwave(start - Vector3.new(0, R - 0.1, 0), WHITE, 16, 0.45)
	if mine then
		doFlash(WHITE, 0.7, 0.3)
		hardShake(2.2)
		tween(dim, 0.3, { BackgroundTransparency = 1 })
		tween(cc, 0.3, { Saturation = 0.2, Contrast = 0.08 })
		cam.FieldOfView = 90
		tween(cam, 0.8, { FieldOfView = 78 }, Enum.EasingStyle.Quart)
	end
	task.delay(1.4, function() -- the shooter straightens up and fades away
		if poseConn then poseConn:Disconnect() end
		for _, d in (sh and sh.m or cue):GetDescendants() do
			if d:IsA("BasePart") then tween(d, 0.4, { Transparency = 1 }) end
		end
		tween(cue, 0.4, { Transparency = 1 })
		task.wait(0.45)
		cue:Destroy()
		if sh then sh.m:Destroy() end
	end)
end

-- ===== 3. The new ball lands on your base table =====
local function findBall(slot, tid)
	local base = workspace.World:FindFirstChild("Base" .. slot)
	local chars = base and base:FindFirstChild("Chars")
	if not chars or tid == 0 then return nil end
	local t0 = os.clock()
	repeat
		for _, m in chars:GetChildren() do
			if m:GetAttribute("ThrowId") == tid and m.PrimaryPart then return m end
		end
		task.wait(0.05)
	until os.clock() - t0 > 5
	return nil
end

local function setHidden(model, hidden)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and (d.Name == "MeshVisual" or not d:FindFirstChild("MeshVisual")) then d.LocalTransparencyModifier = hidden and 1 or 0 end
		if d:IsA("BillboardGui") then d.Enabled = not hidden end
	end
end

-- Camera on the base table; a light beam hits the ball's spot, the ball drops in, bounces, bursts, the card follows.
local function revealOnBase(slot, tid, it, bonus, quick)
	local ch = C.Balls[it.id]
	local r = C.Rarities[ch.rarity]
	local real = findBall(slot, tid)
	if not real then -- not placed on the base (all spots taken): just the card
		tween(dim, 0.3, { BackgroundTransparency = 0.35 })
		local close = revealCard(it, bonus)
		waitOrSkip(3)
		close()
		return
	end
	local goal = real.PrimaryPart.CFrame.Position
	local size = real.PrimaryPart.Size.X
	local hideReal = RunService.RenderStepped:Connect(function() setHidden(real, true) end)
	local front = Vector3.new(0, 0, 1)
	local camStart = os.clock()
	camFn = function()
		local t = math.min((os.clock() - camStart) / 2.4, 1)
		local e = 1 - (1 - t) ^ 3
		return CFrame.lookAt(goal + front * (12 - 5 * e) + Vector3.new(4 - 3 * e, 6 - 2.5 * e, 0), goal + Vector3.new(0, 0.6, 0)), t < 0.02
	end
	cam.FieldOfView = 50
	tween(dim, 0.4, { BackgroundTransparency = 0.6 })
	tween(cc, 0.4, { Brightness = -0.05, Saturation = -0.1, TintColor = WHITE })
	-- light beam from the sky onto the spot
	local beam = Instance.new("Part")
	beam.Shape, beam.Anchored, beam.CanCollide, beam.CanQuery, beam.CastShadow = Enum.PartType.Cylinder, true, false, false, false
	beam.Material, beam.Color, beam.Transparency = Enum.Material.SmoothPlastic, r[2]:Lerp(WHITE, 0.6), 0.55
	beam.Size = Vector3.new(60, 0.2, 0.2)
	beam.CFrame = CFrame.new(goal + Vector3.new(0, 30, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	beam.Parent = workspace
	tween(beam, 0.35, { Size = Vector3.new(60, size * 1.8, size * 1.8) }, Enum.EasingStyle.Back)
	local beamLight = Instance.new("PointLight")
	beamLight.Color, beamLight.Range, beamLight.Brightness, beamLight.Parent = r[2], 16, 4, beam
	sfx("Hit")
	waitOrSkip(quick and 0.2 or 0.5)
	-- the ball falls in spinning, with a trail, and bounces on the felt
	local b = prizeBall(it, size, CFrame.new(goal + Vector3.new(0, 22, 0)))
	b.Parent = workspace
	local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
	a0.Position, a1.Position, a0.Parent, a1.Parent = Vector3.new(size * 0.4, 0, 0), Vector3.new(-size * 0.4, 0, 0), b, b
	local trail = Instance.new("Trail")
	trail.Attachment0, trail.Attachment1, trail.Color, trail.LightEmission = a0, a1, ColorSequence.new(WHITE, r[2]), 1
	trail.Lifetime, trail.Transparency, trail.Parent = 0.35, NumberSequence.new(0.2, 1), b
	local t0, fall = os.clock(), quick and 0.7 or 0.9
	repeat
		local t = skip and 1 or math.min((os.clock() - t0) / fall, 1)
		local y = 22 * (1 - TweenService:GetValue(t, Enum.EasingStyle.Bounce, Enum.EasingDirection.Out))
		b.CFrame = CFrame.new(goal + Vector3.new(0, y, 0)) * CFrame.Angles(t * 9, t * 5, 0)
		if t > 0.36 and not b:GetAttribute("Landed") then -- first touch of the felt
			b:SetAttribute("Landed", true)
			sfx("Reward")
			hardShake(1.2 + ch.rarity * 0.05)
			doFlash(r[2]:Lerp(WHITE, 0.3), 0.9, 0.6)
			shockwave(goal - Vector3.new(0, size / 2, 0), r[2], 18, 0.7)
			shockwave(goal - Vector3.new(0, size / 2 - 0.1, 0), WHITE, 10, 0.45)
			burst(goal, r[2], 80, 22)
			local core = anchorPart(CFrame.new(goal))
			emitter(core, {
				Speed = NumberRange.new(16, 26), SpreadAngle = Vector2.new(50, 50), Lifetime = NumberRange.new(1.6, 2.4),
				Acceleration = Vector3.new(0, -25, 0), Drag = 1.2, Rotation = NumberRange.new(0, 360), RotSpeed = NumberRange.new(-300, 300),
				Size = NumberSequence.new(0.25), LightEmission = 0.2, EmissionDirection = Enum.NormalId.Top,
				Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)), ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 220, 60)), ColorSequenceKeypoint.new(0.66, Color3.fromRGB(80, 200, 255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 255, 120)) }),
			}):Emit(110)
			task.delay(3, core.Destroy, core)
			tween(beam, 0.6, { Size = Vector3.new(60, 0.1, 0.1), Transparency = 1 })
			tween(dim, 0.3, { BackgroundTransparency = 0.85 })
			tween(cc, 0.3, { Brightness = 0.05, Saturation = 0.3, TintColor = r[2]:Lerp(WHITE, 0.75) })
		end
		RunService.RenderStepped:Wait()
	until t >= 1
	-- the real ball takes over; the card shows what you got
	b:Destroy()
	beam:Destroy()
	hideReal:Disconnect()
	setHidden(real, false)
	tween(cam, 2.6, { FieldOfView = 40 }, Enum.EasingStyle.Sine)
	local close = revealCard(it, bonus)
	waitOrSkip(quick and 1.8 or 3)
	close()
end

-- ===== The shot =====
local luckShown = 0
local function showLuck(v, lucky)
	local from = luckShown
	luckShown = v
	local t0 = os.clock()
	task.spawn(function() -- the number counts up
		while os.clock() - t0 < 0.3 and luckShown == v do
			local e = (os.clock() - t0) / 0.3
			luckLabel.Text = string.format("LUCK %.2fX", from + (v - from) * e)
			RunService.RenderStepped:Wait()
		end
		if luckShown == v then luckLabel.Text = string.format("LUCK %.2fX", v) end
	end)
	luckGrad.Enabled = v >= 5
	luckLabel.TextColor3 = v >= 5 and WHITE or C.UI.Title
	pop(luckScale, lucky and 1.8 or 1.25)
end

Fx.OnClientEvent:Connect(function(kind, p)
	if kind ~= "Throw" then return end
	local slot, dist, tid = p.slot, p.dist, p.tid
	local it = { id = p.id, v = p.v }
	local ch = C.Balls[it.id]
	local rcol = C.Rarities[ch.rarity][2]
	local mine = slot == _G.MySlot
	local full = p.full and not _G.ShortOnly -- the big show only for top pulls, unless the player chose short cinematics
	local A = C.AnimOf(full)
	if mine then _G.ShotReadyAt = os.clock() + C.ThrowTime(dist, p.full) + C.ThrowCooldown end
	local x = laneX(slot)
	local start = Vector3.new(x, FELT_Y + R, BALL_Z)
	local b = ball(p.gold and GOLD or WHITE, R * 2, CFrame.new(start))
	local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
	a0.Position, a1.Position, a0.Parent, a1.Parent = Vector3.new(0, 0.7, 0), Vector3.new(0, -0.7, 0), b, b
	local trail = Instance.new("Trail")
	trail.Attachment0, trail.Attachment1, trail.LightEmission = a0, a1, 1
	trail.Lifetime, trail.Transparency, trail.Parent = 0.6, NumberSequence.new(0.1, 1), b
	local aura = emitter(b, {
		Speed = NumberRange.new(1, 3), SpreadAngle = Vector2.new(180, 180), Lifetime = NumberRange.new(0.3, 0.6),
		Size = NumberSequence.new(0.9, 0), Transparency = NumberSequence.new(0.2, 1),
	})
	if p.gold then -- Golden Ball pass: gold sparkles
		emitter(b, {
			Color = ColorSequence.new(GOLD, WHITE), Rate = 25, Speed = NumberRange.new(0.5, 1.5), SpreadAngle = Vector2.new(180, 180),
			Lifetime = NumberRange.new(0.4, 0.8), Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.35), NumberSequenceKeypoint.new(1, 0) }),
		})
	end
	local function themeAt(z)
		local tbl = C.Tables[zoneAt(z)]
		trail.Color = ColorSequence.new(p.gold and GOLD or WHITE, tbl[2])
		aura.Color = ColorSequence.new(tbl[2], WHITE)
		return tbl
	end
	themeAt(start.Z)
	local luckyAt = {}
	for _, k in p.lucky do luckyAt[k] = true end

	if mine then
		setCinema(true)
		luckShown = p.luck0
		luckLabel.Text = string.format("LUCK %.2fX", p.luck0)
		showLuck(p.luck0)
	end
	local power = math.clamp(dist / T.Length, 0, 1)
	windup(b, start, mine, math.clamp(dist / 600, 0.3, 1), p, full)
	aura.Rate = 40

	-- 2. Flight over the tables
	local roll = C.RollTime(dist, full)
	local zone = math.clamp(math.ceil(dist / zoneLen), 1, N)
	local endZ = math.clamp(T.StartZ + dist, start.Z + 4, T.StartZ + T.Length - R) -- same zone as the server picked
	local broke, lastZone = false, 1
	local rot, lastZ = CFrame.new(), start.Z
	if mine then
		camFn = function()
			local bp = b.Position
			return CFrame.lookAt(bp + Vector3.new(0, 5.5, -13), bp + Vector3.new(0, 1, 12))
		end
	end
	local t0 = os.clock()
	repeat
		local t = skip and 1 or math.min((os.clock() - t0) / roll, 1)
		local z = start.Z + (endZ - start.Z) * (1 - (1 - t) ^ 3)
		rot = CFrame.Angles((z - lastZ) / R, 0, 0) * rot
		lastZ = z
		b.CFrame = CFrame.new(x, start.Y, z) * rot
		if not broke and z >= RACK_Z - RR * 2 and racks[slot] then
			broke = true
			breakRack(slot, math.max(power, 0.3))
		end
		local zn = zoneAt(z)
		if zn ~= lastZone then -- entering a new table: the luck of the table just crossed is added
			local crossed = zn - 1
			lastZone = zn
			local tbl = themeAt(z)
			aura.Rate = 40 + zn
			if mine and p.track[crossed] then
				showLuck(p.track[crossed], luckyAt[crossed])
				if luckyAt[crossed] then
					showBanner("LUCKY TABLE", C.UI.Title)
					doFlash(C.UI.Title, 0.35, 0.35)
					sfx("Reward")
				end
			end
			if mine and (full or zn == zone) then -- the short version only announces the final table
				hardShake(0.5 + zn * 0.03)
				doFlash(tbl[2], 0.35, 0.35)
				cam.FieldOfView = 90
				tween(cam, 0.5, { FieldOfView = 80 }, Enum.EasingStyle.Quart)
				tween(cc, 0.3, { TintColor = tbl[2]:Lerp(WHITE, 0.75) })
				if not luckyAt[crossed] then showBanner("TABLE " .. zn .. "  " .. string.upper(tbl[1]), tbl[2]) end
				sfx("Click")
			end
		end
		RunService.RenderStepped:Wait()
	until t >= 1
	if mine and p.track[zone] then showLuck(p.track[zone], luckyAt[zone]) end

	-- slide into the zone pocket: zoom in, dim, blur, then fade to black
	local side = x < 0 and -1 or 1
	local pocket = Vector3.new(side * T.Width / 2, start.Y, T.StartZ + (zone - 0.5) * zoneLen)
	if mine then
		camFn = function()
			return CFrame.lookAt(pocket + Vector3.new(-side * 8, 7, -9), pocket)
		end
		tween(cam, A.Slide, { FieldOfView = 34 }, Enum.EasingStyle.Sine)
		tween(dim, A.Slide, { BackgroundTransparency = full and 0.45 or 0.75 })
		tween(blur, A.Slide, { Size = full and 6 or 2 })
	end
	local from = b.Position
	t0 = os.clock()
	repeat
		local t = skip and 1 or math.min((os.clock() - t0) / A.Slide, 1)
		b.CFrame = CFrame.new(from:Lerp(pocket, t * t * (3 - 2 * t))) * rot
		RunService.RenderStepped:Wait()
	until t >= 1
	b:SetAttribute("Tint", rcol)
	drop(b, pocket)
	shockwave(pocket - Vector3.new(0, 0.9, 0), rcol, 12, 0.5)

	if not mine then
		_G.Toast(C.ItemName(it) .. "  " .. C.Rarities[ch.rarity][1], rcol)
		return
	end
	hardShake(1)
	doFlash(rcol, 0.6, 0.3)
	tween(blur, 0.3, { Size = 0 })
	local bonus = math.max(0, ch.rarity - zone)
	if not skip then -- every pull lands on your table; the short version is just quicker
		tween(dim, full and 0.35 or 0.2, { BackgroundTransparency = 0 }).Completed:Wait()
		revealOnBase(slot, tid, it, bonus, not full)
	else -- skipped: just the card, the ball appears on the base by itself
		tween(dim, 0.25, { BackgroundTransparency = 0.55 })
		local close = revealCard(it, bonus)
		skip = false
		waitOrSkip(full and 2.2 or 1.6)
		close()
	end
	setCinema(false)
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX1944"><Properties><string name="Name">Visuals</string><ProtectedString name="Source"><![CDATA[-- Swaps every part tagged with a "Mesh" StringValue for the matching Blender mesh (Shared/Meshes).
-- "MeshPivot" parts stand for a whole part-built model: the model is hidden locally and the mesh is
-- welded to the pivot. Any other tagged part (cues, rings, the gym dumbbell) is replaced 1:1.
-- Colour/scale values under a tagged part rebuild its mesh when they change (dumbbell level, cue tier).
-- Also: cue tier effects (Shared/CueFx), spinning aura rings, rainbow characters.
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")
local C = require(RS.Shared.Config)
local MeshBuilder = require(RS.Shared.MeshBuilder)
local CueFx = require(RS.Shared.CueFx)

local function hide(p)
	p.LocalTransparencyModifier = 1
end

local function apply(tag)
	task.wait() -- let sibling override values replicate
	local p = tag.Parent
	if not (p and p:IsA("BasePart")) then return end
	local old = p:FindFirstChild("MeshVisual")
	if old then old:Destroy() end
	local overrides
	for _, v in p:GetChildren() do
		if v:IsA("Color3Value") then
			overrides = overrides or {}
			overrides[v.Name] = v.Value
		end
	end
	local scaleValue = p:FindFirstChild("Scale")
	local scale = scaleValue and scaleValue.Value
	if tag.Value == "Cue" then
		local tier = p:GetAttribute("Tier") or 1
		CueFx.Apply(p, tier, CueFx.Def(tier, p:GetAttribute("Dragon")), scale or 1)
	end
	local mp = MeshBuilder.Create(tag.Value, p.CFrame, overrides, scale)
	if not mp or not p.Parent then
		if mp then mp:Destroy() end
		return
	end
	mp.Name, mp.Anchored, mp.Massless = "MeshVisual", false, true
	if tag.Value == "Ring" then mp.Transparency = 0.15 end
	local variant = p:GetAttribute("Variant") -- prize balls: Gold / Diamond / Galaxy / Rainbow material
	for _, V in C.Variants do
		if V.name == variant and V.material then
			mp.Material = Enum.Material[V.material]
			mp.Reflectance = (V.name == "Gold" or V.name == "Diamond") and 0.3 or 0
		end
	end
	if variant == "Rainbow" then
		local h = Instance.new("Highlight")
		h.Name, h.FillTransparency, h.OutlineTransparency, h.Parent = "RainbowGlow", 0.35, 0.6, mp
		CollectionService:AddTag(h, "Rainbow")
	end
	local weld = Instance.new("WeldConstraint")
	weld.Part0, weld.Part1, weld.Parent = p, mp, mp
	mp.Parent = p
	if p.Name == "MeshPivot" then
		for _, d in p.Parent:GetDescendants() do
			if d:IsA("BasePart") and d ~= p and not d:IsDescendantOf(p) then hide(d) end
		end
	else
		hide(p)
	end
end

local function check(inst)
	if not (inst.Name == "Mesh" and inst:IsA("StringValue")) then return end
	task.spawn(apply, inst)
	local pending = false
	for _, v in inst.Parent:GetChildren() do
		if v:IsA("Color3Value") or (v:IsA("NumberValue") and v.Name == "Scale") then
			v.Changed:Connect(function()
				if pending then return end
				pending = true
				task.defer(function()
					pending = false
					if inst.Parent then apply(inst) end
				end)
			end)
		end
	end
end

workspace:WaitForChild("World")
for _, d in workspace:GetDescendants() do check(d) end
workspace.DescendantAdded:Connect(check) -- also catches NPC cues and the cue in each player's hand

-- aura rings turn slowly around their own axis; rainbow characters cycle their colour
local spinning, hovering = {}, {}
local function addSpin(p) spinning[p] = p.CFrame end
local function addHover(p) hovering[p] = p.CFrame end
for _, p in CollectionService:GetTagged("Hover") do addHover(p) end
CollectionService:GetInstanceAddedSignal("Hover"):Connect(addHover)
CollectionService:GetInstanceRemovedSignal("Hover"):Connect(function(p) hovering[p] = nil end)

-- the green upgrade circle in each gym: slow spin + a breathing glow disc
local function pulse(ring)
	addSpin(ring)
	ring:SetAttribute("Spin", 0.8)
	local disc = Instance.new("Part")
	disc.Name, disc.Shape, disc.Material, disc.Color = "Glow", Enum.PartType.Cylinder, Enum.Material.ForceField, Color3.fromRGB(70, 255, 110)
	disc.Size, disc.Anchored, disc.CanCollide, disc.CanQuery, disc.CanTouch, disc.CastShadow = Vector3.new(0.1, 3.2, 3.2), true, false, false, false, false
	disc.CFrame = ring.CFrame * CFrame.new(0, -0.1, 0) * CFrame.Angles(0, 0, math.pi / 2)
	disc.Parent = ring
	TweenService:Create(disc, TweenInfo.new(1.1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Size = Vector3.new(0.1, 4.4, 4.4), Transparency = 0.5 }):Play()
end
for _, d in workspace:WaitForChild("World"):GetDescendants() do
	if d.Name == "Pulse" and d:IsA("StringValue") then pulse(d.Parent) end
end
for _, p in CollectionService:GetTagged("Spin") do addSpin(p) end
CollectionService:GetInstanceAddedSignal("Spin"):Connect(addSpin)
CollectionService:GetInstanceRemovedSignal("Spin"):Connect(function(p) spinning[p] = nil end)

local hueT = 0
RunService.RenderStepped:Connect(function(dt)
	local t = os.clock()
	for p, base in spinning do
		if p.Parent then
			p.CFrame = base * CFrame.Angles(0, t * (p:GetAttribute("Spin") or 1), 0)
		else
			spinning[p] = nil
		end
	end
	for p, base in hovering do -- prize balls bob over their spot and turn slowly
		if p.Parent then
			p.CFrame = base * CFrame.new(0, math.sin(t * 2 + base.X) * 0.15, 0) * CFrame.Angles(0, t * 0.9, 0.3)
		else
			hovering[p] = nil
		end
	end
	hueT += dt
	if hueT < 0.05 then return end
	hueT = 0
	for _, h in CollectionService:GetTagged("Rainbow") do
		h.FillColor = Color3.fromHSV((t * 0.3) % 1, 0.7, 1)
		h.OutlineColor = Color3.fromHSV((t * 0.3 + 0.5) % 1, 0.7, 1)
	end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX1945"><Properties><string name="Name">Training</string><ProtectedString name="Source"><![CDATA[-- Gym training (Start / Stop from the gym menu, the HUD button or the prompt at the dumbbell).
-- The character faces the gym, takes two hand-size copies of the gym dumbbell (same plates as its level) and does
-- alternating bicep curls in time with the server's reps; a "+N" pops over the head on every rep.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local RS = game:GetService("ReplicatedStorage")
local C = require(RS.Shared.Config)
local MeshBuilder = require(RS.Shared.MeshBuilder)
local Rig = require(RS.Shared.Rig)
local Fx = RS:WaitForChild("Remotes"):WaitForChild("Fx")
local plr = Players.LocalPlayer

local state

local function setFloorBell(bell, visible)
	local mv = bell and bell:FindFirstChild("MeshVisual")
	if mv then mv.LocalTransparencyModifier = visible and 0 or 1 end
end

local function handBell(source, hand)
	local plate = source:FindFirstChild("Plate")
	local sc = source:FindFirstChild("Scale")
	local k = 0.22 * (sc and sc.Value or 1)
	local b = MeshBuilder.Create("Dumbbell", hand.CFrame, { Plate = plate and plate.Value or Color3.fromRGB(70, 70, 78) }, k)
	if not b then
		b = Instance.new("Part")
		b.Size, b.Shape, b.Color, b.Material = Vector3.new(5.2, 2.3, 2.3) * k, Enum.PartType.Cylinder, plate and plate.Value or Color3.new(0.3, 0.3, 0.3), Enum.Material.Metal
	end
	b.Anchored, b.CanCollide, b.CanQuery, b.CanTouch, b.Massless = false, false, false, false, true
	b.CFrame = hand.CFrame * CFrame.new(0, -hand.Size.Y * 0.35, 0) -- handle across the palm
	local w = Instance.new("WeldConstraint")
	w.Part0, w.Part1, w.Parent = hand, b, b
	b.Parent = hand.Parent
	return b
end

local function stop()
	if not state then return end
	local s = state
	state = nil
	s.conn:Disconnect()
	for _, b in s.bells do b:Destroy() end
	if s.sweat then s.sweat:Destroy() end
	if s.hum.Parent then
		s.hum.WalkSpeed, s.hum.JumpPower, s.hum.JumpHeight = s.speed, s.jump, s.jumpH
		s.hum.AutoRotate = true
	end
	setFloorBell(s.floor, true)
end

local function start(spotCF, floorBell)
	stop()
	local char = plr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local J = char and Rig.Joints(char)
	if not (hum and hrp and J) then return end
	local s = { hum = hum, speed = hum.WalkSpeed, jump = hum.JumpPower, jumpH = hum.JumpHeight, floor = floorBell, bells = {} }
	hum.WalkSpeed, hum.JumpPower, hum.JumpHeight, hum.AutoRotate = 0, 0, 0, false
	local face = floorBell and Vector3.new(floorBell.Position.X, hrp.Position.Y, floorBell.Position.Z) or hrp.Position + hrp.CFrame.LookVector
	local at = Vector3.new(spotCF.Position.X, hrp.Position.Y, spotCF.Position.Z)
	hrp.CFrame = CFrame.lookAt(at, Vector3.new(face.X, at.Y, face.Z) + (face - at).Unit * 0.01)
	setFloorBell(floorBell, false)
	if floorBell then
		s.bells = { handBell(floorBell, char.RightHand), handBell(floorBell, char.LeftHand) }
	end
	local t0 = os.clock()
	s.conn = RunService.Stepped:Connect(function()
		local t = os.clock() - t0
		local n = t / C.TrainRep
		local curl = math.sin((n % 1) * math.pi) ^ 1.4 -- up, squeeze, down
		local right = math.floor(n) % 2 == 0
		for _, side in { "Right", "Left" } do
			local c = (side == "Right") == right and curl or 0
			local out = side == "Right" and 0.1 or -0.1
			J[side .. "Shoulder"].Transform = CFrame.Angles(0.12 + 0.2 * c, 0, out)
			J[side .. "Elbow"].Transform = CFrame.Angles(0.1 + 2.25 * c, 0, 0)
			J[side .. "Wrist"].Transform = CFrame.Angles(-0.25 * c, 0, 0)
		end
		J.Waist.Transform = CFrame.Angles(-0.04 - 0.05 * curl, 0, (right and 0.03 or -0.03) * curl) -- breathing sway
		J.Neck.Transform = CFrame.Angles(0.05 * curl, 0, 0)
	end)
	task.delay(4, function() -- sweat after a few reps
		if state ~= s or not char:FindFirstChild("Head") then return end
		local e = Instance.new("ParticleEmitter")
		e.Color, e.Rate, e.Lifetime = ColorSequence.new(Color3.fromRGB(170, 220, 255)), 3, NumberRange.new(0.5, 0.8)
		e.Size, e.Speed, e.Acceleration = NumberSequence.new(0.12, 0.05), NumberRange.new(1.5, 2.5), Vector3.new(0, -14, 0)
		e.SpreadAngle, e.Transparency = Vector2.new(60, 60), NumberSequence.new(0.2, 0.6)
		e.Parent = char.Head
		s.sweat = e
	end)
	state = s
	hum.Died:Once(stop)
end

-- "+N" floating over the head on every rep
local function popRep(gain)
	local head = plr.Character and plr.Character:FindFirstChild("Head")
	if not head then return end
	local bb = Instance.new("BillboardGui")
	bb.Size, bb.StudsOffset, bb.AlwaysOnTop, bb.Adornee = UDim2.fromOffset(160, 50), Vector3.new(0, 2.5, 0), true, head
	local l = Instance.new("TextLabel")
	l.Size, l.BackgroundTransparency, l.TextScaled, l.FontFace = UDim2.fromScale(1, 1), 1, true, C.UI.Font
	l.Text, l.TextColor3 = "+" .. C.Short(gain) .. " STR", C.UI.Title
	local st = Instance.new("UIStroke")
	st.Thickness, st.Color, st.Parent = 3, C.UI.Ink, l
	l.Parent, bb.Parent = bb, plr.PlayerGui
	local tw = TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(bb, tw, { StudsOffset = Vector3.new(0, 4.5, 0) }):Play()
	TweenService:Create(l, tw, { TextTransparency = 1 }):Play()
	TweenService:Create(st, tw, { Transparency = 1 }):Play()
	task.delay(1, bb.Destroy, bb)
end

Fx.OnClientEvent:Connect(function(kind, a, b, c)
	if kind == "Train" then
		if a then start(b, c) else stop() end
	elseif kind == "Rep" then
		popRep(b)
	end
end)
plr.CharacterRemoving:Connect(stop)
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="Lighting" referent="RBX1946"><Properties><string name="Name">Lighting</string><float name="ClockTime">13.2</float><float name="Brightness">2.6</float><float name="EnvironmentDiffuseScale">1</float><float name="EnvironmentSpecularScale">0.6</float><Color3 name="OutdoorAmbient"><R>0.7451</R><G>0.7255</G><B>0.7843</B></Color3><Color3 name="Ambient"><R>0.5098</R><G>0.4902</G><B>0.5490</B></Color3></Properties><Item class="Sky" referent="RBX1947"><Properties><string name="Name">Sky</string></Properties></Item><Item class="Atmosphere" referent="RBX1948"><Properties><string name="Name">Atmosphere</string><float name="Density">0.34</float><float name="Haze">1.2</float><Color3 name="Color"><R>0.9216</R><G>0.9412</G><B>1.0000</B></Color3><Color3 name="Decay"><R>0.7843</R><G>0.8431</G><B>1.0000</B></Color3></Properties></Item><Item class="BloomEffect" referent="RBX1949"><Properties><string name="Name">Bloom</string><float name="Intensity">0.25</float><float name="Size">20</float><float name="Threshold">2.2</float></Properties></Item><Item class="ColorCorrectionEffect" referent="RBX1950"><Properties><string name="Name">Grade</string><float name="Brightness">0</float><float name="Saturation">0.12</float><float name="Contrast">0.05</float></Properties></Item><Item class="SunRaysEffect" referent="RBX1951"><Properties><string name="Name">SunRays</string><float name="Intensity">0.06</float></Properties></Item></Item></roblox>