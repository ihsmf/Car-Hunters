]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5824"><Properties><string name="Name">MeshBuilder</string><ProtectedString name="Source"><![CDATA[-- Turns Blender mesh data (Shared/Meshes) into MeshParts via EditableMesh — no asset upload needed.
-- Client-side only (EditableMesh content does not replicate). Falls back gracefully when unavailable.
local AssetService = game:GetService("AssetService")
local Meshes = require(script.Parent.Meshes)

local MeshBuilder = {}
local cache = {}
local supported = true

-- overrides: { [paletteName]: Color3 } recolours a material (e.g. ball body, fence caps, cue shaft)
local function editable(name, overrides)
	local key = name
	if overrides then
		for k, c in overrides do key ..= "|" .. k .. c:ToHex() end
	end
	if cache[key] then return cache[key] end
	local data = Meshes[name]
	local em = AssetService:CreateEditableMesh()
	local colorIds = {}
	for i, entry in data.palette do
		colorIds[i] = em:AddColor((overrides and overrides[entry[1]]) or entry[2], 1)
	end
	local v = data.verts
	local front, back = {}, {}
	for i = 1, #v, 3 do
		local p = Vector3.new(v[i], v[i + 1], v[i + 2])
		local n = (i + 2) // 3
		front[n] = em:AddVertex(p)
		back[n] = em:AddVertex(p) -- separate copy for the back side, so the mesh renders with either winding
	end
	local normalsF, normalsB = {}, {}
	for n = 1, #front do
		normalsF[n] = em:AddNormal()
		normalsB[n] = em:AddNormal()
	end
	local t = data.tris
	for f = 1, #data.colors do
		local a, b, c = t[f * 3 - 2], t[f * 3 - 1], t[f * 3]
		local col = colorIds[data.colors[f]]
		local f1 = em:AddTriangle(front[a], front[b], front[c])
		em:SetFaceNormals(f1, { normalsF[a], normalsF[b], normalsF[c] })
		em:SetFaceColors(f1, { col, col, col })
		local f2 = em:AddTriangle(back[a], back[c], back[b])
		em:SetFaceNormals(f2, { normalsB[a], normalsB[c], normalsB[b] })
		em:SetFaceColors(f2, { col, col, col })
	end
	cache[key] = em
	return em
end

-- Returns a MeshPart whose model origin is `cf` (or nil if EditableMesh is unavailable).
function MeshBuilder.Create(name, cf, overrides, scale)
	if not supported or not Meshes[name] then return nil end
	local ok, part = pcall(function()
		local mp = AssetService:CreateMeshPartAsync(Content.fromObject(editable(name, overrides)))
		local s = scale or 1
		mp.Size = Meshes[name].size * s
		mp.CFrame = cf * CFrame.new(Meshes[name].center * s)
		mp.Anchored, mp.CanCollide, mp.CanQuery, mp.CanTouch = true, false, false, false
		mp.Color = Color3.new(1, 1, 1)
		mp.Material = Enum.Material.SmoothPlastic
		mp.Name = name
		return mp
	end)
	if not ok then
		supported = false
		warn("[MeshBuilder] EditableMesh unavailable, using part models:", part)
		return nil
	end
	return part
end

return MeshBuilder
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX5825"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX5826"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX5827"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Server: data, bases, shots, income, upgrades, bonuses, purchases
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local RS = game:GetService("ReplicatedStorage")
local C = require(RS.Shared.Config)
local Map = require(script.Parent.Map).Build()

-- In Studio without publishing / API Services the DataStore throws: keep playing, just don't save
local okStore, store = pcall(DataStoreService.GetDataStore, DataStoreService, "BilliardHuntersV2")
if not okStore then
	warn("DataStore unavailable, progress will not be saved:", store)
	store = { GetAsync = function() return nil end, SetAsync = function() end }
end

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local Request = Instance.new("RemoteFunction")
Request.Name, Request.Parent = "Request", remotes
local Fx = Instance.new("RemoteEvent")
Fx.Name, Fx.Parent = "Fx", remotes
remotes.Parent = RS

local sessions = {} -- player -> session
local taken = {} -- base slot -> player
local luckShift = 0
local rng = Random.new()
local N = #C.Rarities
local passByKey = {}
for _, gp in C.GamePasses do passByKey[gp.key] = gp end

local ANIM = { Idle = "rbxassetid://507766666", Cheer = "rbxassetid://507770677", Wave = "rbxassetid://507770239" }

local function default()
	return {
		cash = 0, strength = 0, dumbLevel = 1, cue = 1, cues = { ["1"] = true }, cueLevel = 1,
		inv = {}, daily = { day = 0, streak = 0 }, receipts = {},
	}
end

local function income(s)
	local sum = 0
	for _, it in s.d.inv do
		if it.eq then sum += C.Characters[it.id].income end
	end
	return sum * (s.passes.Cash2x and 2 or 1) * (s.passes.GoldStick and 1.5 or 1)
end

local function sync(plr)
	local s = sessions[plr]
	if not s then return end
	s.d.passes = s.passes
	Fx:FireClient(plr, "State", { d = s.d, slot = s.slot, income = income(s), luck = luckShift, join = s.join, claimed = s.claimed })
	plr.leaderstats.Cash.Value = math.floor(s.d.cash)
end

-- ===== Characters: R15 rig + cue in hand + aura + crown/halo =====
local function weldTo(base, p)
	p.Anchored, p.CanCollide, p.Massless = false, false, true
	local w = Instance.new("WeldConstraint")
	w.Part0, w.Part1, w.Parent = base, p, p
end

local function play(hum, id, looped)
	local a = Instance.new("Animation")
	a.AnimationId = id
	local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator")
	animator.Parent = hum
	local ok, track = pcall(function() return animator:LoadAnimation(a) end)
	if ok and track then
		track.Looped = looped
		track:Play()
	end
	return ok and track
end

local function makeNPC(id, cf, gold, fresh)
	local info = C.Characters[id]
	local r = C.Rarities[info.rarity]
	local desc = Instance.new("HumanoidDescription")
	desc.TorsoColor, desc.LeftArmColor, desc.RightArmColor = info.shirt, info.shirt, info.shirt
	desc.HeadColor = Color3.fromRGB(255, 210, 170)
	desc.LeftLegColor, desc.RightLegColor = r[2]:Lerp(Color3.new(0, 0, 0), 0.45), r[2]:Lerp(Color3.new(0, 0, 0), 0.45)
	local k = 1 + info.rarity * 0.012
	desc.HeightScale, desc.WidthScale, desc.DepthScale, desc.HeadScale = k, k, k, k
	local m = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	m.Name = info.name
	local hum = m.Humanoid
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	m.HumanoidRootPart.Anchored = true
	m:PivotTo(cf * CFrame.new(0, hum.HipHeight + m.HumanoidRootPart.Size.Y / 2, 0))

	-- cue held like a staff (client swaps it for the Blender cue mesh)
	local stick = Instance.new("Part")
	stick.Name, stick.Size = "Stick", Vector3.new(0.3, 9.2, 0.3)
	stick.Color = gold and Color3.fromRGB(255, 200, 40) or Color3.fromRGB(236, 196, 132)
	stick.Material = gold and Enum.Material.Neon or Enum.Material.Wood
	local hand = m.RightHand
	stick.CFrame = hand.CFrame * CFrame.Angles(math.rad(-12), 0, 0) * CFrame.new(0, 2.2, 0)
	local tag = Instance.new("StringValue")
	tag.Name, tag.Value, tag.Parent = "Mesh", "Cue", stick
	local shaft = Instance.new("Color3Value")
	shaft.Name, shaft.Value, shaft.Parent = "Shaft", stick.Color, stick
	weldTo(hand, stick)
	stick.Parent = m

	local aura = Instance.new("ParticleEmitter")
	aura.Color = ColorSequence.new(r[2], Color3.new(1, 1, 1))
	aura.LightEmission, aura.Rate, aura.Lifetime = 0.8, 10 + info.rarity * 3, NumberRange.new(1, 1.6)
	aura.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4 + info.rarity * 0.1), NumberSequenceKeypoint.new(1, 0) })
	aura.Speed, aura.SpreadAngle = NumberRange.new(1, 3), Vector2.new(180, 180)
	aura.Transparency = NumberSequence.new(0.3, 1)
	aura.Parent = m.HumanoidRootPart
	local glow = Instance.new("PointLight")
	glow.Color, glow.Range, glow.Brightness, glow.Parent = r[2], 8 + info.rarity, 1.5, m.HumanoidRootPart
	local ring = Instance.new("Part") -- aura disc under the feet
	ring.Shape, ring.Size, ring.Color, ring.Material = Enum.PartType.Cylinder, Vector3.new(0.1, 5, 5), r[2], Enum.Material.Neon
	ring.Transparency, ring.CFrame = 0.35, cf * CFrame.new(0, 0.05, 0) * CFrame.Angles(0, 0, math.pi / 2)
	ring.Anchored, ring.CanCollide, ring.Parent = true, false, m

	if info.rarity >= 8 then -- crown
		local crown = Instance.new("Part")
		crown.Shape, crown.Size, crown.Color, crown.Material = Enum.PartType.Cylinder, Vector3.new(0.5, 1.3, 1.3), Color3.fromRGB(255, 200, 40), Enum.Material.Metal
		crown.CFrame = m.Head.CFrame * CFrame.new(0, 0.8, 0) * CFrame.Angles(0, 0, math.pi / 2)
		weldTo(m.Head, crown)
		crown.Parent = m
	end
	if info.rarity >= 15 then -- halo
		local halo = Instance.new("Part")
		halo.Shape, halo.Size, halo.Color, halo.Material = Enum.PartType.Cylinder, Vector3.new(0.15, 2, 2), r[2], Enum.Material.Neon
		halo.CFrame = m.Head.CFrame * CFrame.new(0, 1.6, 0) * CFrame.Angles(0, 0, math.pi / 2)
		weldTo(m.Head, halo)
		halo.Parent = m
	end

	local bb = Instance.new("BillboardGui")
	bb.Size, bb.StudsOffset, bb.AlwaysOnTop, bb.MaxDistance = UDim2.fromOffset(200, 64), Vector3.new(0, 3.5, 0), true, 90
	for i, t in { { info.name, Color3.new(1, 1, 1) }, { r[1] .. " • $" .. C.Short(info.income) .. "/s", r[2] } } do
		local l = Instance.new("TextLabel")
		l.Size, l.Position, l.BackgroundTransparency = UDim2.fromScale(1, 0.5), UDim2.fromScale(0, (i - 1) * 0.5), 1
		l.FontFace, l.TextScaled, l.Text, l.TextColor3 = C.UI.Font, true, t[1], t[2]
		local st = Instance.new("UIStroke")
		st.Thickness, st.Color, st.Parent = 2.5, C.UI.Ink, l
		l.Parent = bb
	end
	bb.Parent = m.Head
	m:SetAttribute("CharId", id)

	task.defer(function() -- animations need the rig parented
		if fresh then
			local t = play(hum, ANIM.Cheer, false)
			if t then t.Stopped:Wait() end
		end
		if m.Parent then play(hum, ANIM.Idle, true) end
	end)
	return m
end

-- Rebuild the base: keep existing NPCs that are still equipped, add new ones
local function refreshBase(plr)
	local s = sessions[plr]
	if not s then return end
	local base = Map.Bases[s.slot]
	local want = {}
	for _, it in s.d.inv do
		if it.eq and #want < C.MaxEquipped then table.insert(want, it.id) end
	end
	local bySlot = {}
	for _, npc in base.chars:GetChildren() do
		bySlot[npc:GetAttribute("Slot") or 0] = npc
	end
	for _, npc in bySlot do
		local slot = npc:GetAttribute("Slot")
		if not slot or want[slot] ~= npc:GetAttribute("CharId") then
			npc:Destroy()
			bySlot[slot or 0] = nil
		end
	end
	for i, id in want do
		if not bySlot[i] then
			local npc = makeNPC(id, base.slots[i], s.passes.GoldStick, true)
			npc:SetAttribute("Slot", i)
			npc.Parent = base.chars
		end
	end
end

local function equippedCount(d)
	local n = 0
	for _, it in d.inv do
		if it.eq then n += 1 end
	end
	return n
end

local function pay(s, cost)
	if s.d.cash < cost then return false end
	s.d.cash -= cost
	return true
end

-- ===== Player actions (Request:InvokeServer(action, arg)) =====
local actions = {}

function actions.Sync() return true end

function actions.Throw(plr, s, power)
	if type(power) ~= "number" or power ~= power or os.clock() < s.nextThrow then return false end
	if #s.d.inv >= C.MaxInventory then return false, "Inventory is full! Sell someone first" end
	local dist = C.Distance(math.clamp(power, 0, 1), s.d)
	s.nextThrow = os.clock() + C.ThrowTime(dist) + C.ThrowCooldown
	local zone = math.clamp(math.ceil(dist / (C.Table.Length / N)), 1, N)
	local bonus = (s.passes.Luck2x and rng:NextNumber() < 0.5) and 1 or 0
	local rarity = math.min(zone + luckShift + bonus, N)
	local pool = {}
	for id, ch in C.Characters do
		if ch.rarity == rarity then table.insert(pool, id) end
	end
	local id = pool[rng:NextInteger(1, #pool)]
	table.insert(s.d.inv, { id = id, eq = equippedCount(s.d) < C.MaxEquipped })
	Fx:FireAllClients("Throw", s.slot, dist, id)
	task.delay(C.ThrowTime(dist), refreshBase, plr)
	return true
end

function actions.Lift(_, s)
	if os.clock() - s.lastLift < 0.35 then return false end
	s.lastLift = os.clock()
	s.d.strength += s.d.dumbLevel
	return true
end

function actions.UpDumb(_, s)
	if not pay(s, C.LiftCost(s.d.dumbLevel)) then return false, "Not enough cash!" end
	s.d.dumbLevel += 1
	return true, "Dumbbell upgraded!"
end

function actions.UpCue(_, s)
	if not pay(s, C.CueUpCost(s.d.cueLevel)) then return false, "Not enough cash!" end
	s.d.cueLevel += 1
	return true, "Cue upgraded!"
end

function actions.Cue(_, s, i)
	local cue = type(i) == "number" and C.Cues[i]
	if not cue then return false end
	if not s.d.cues[tostring(i)] then
		if not pay(s, cue[3]) then return false, "Not enough cash!" end
		s.d.cues[tostring(i)] = true
	end
	s.d.cue = i
	return true, cue[1] .. " cue equipped!"
end

function actions.Equip(plr, s, i)
	local it = type(i) == "number" and s.d.inv[i]
	if not it then return false end
	if not it.eq and equippedCount(s.d) >= C.MaxEquipped then return false, "All " .. C.MaxEquipped .. " spots are taken!" end
	it.eq = not it.eq
	refreshBase(plr)
	return true
end

function actions.Sell(plr, s, i)
	local it = type(i) == "number" and s.d.inv[i]
	if not it then return false end
	local price = C.Characters[it.id].income * 30
	s.d.cash += price
	table.remove(s.d.inv, i)
	if it.eq then refreshBase(plr) end
	return true, "Sold for $" .. C.Short(price)
end

function actions.Daily(_, s)
	local day = os.time() // 86400
	local dd = s.d.daily
	if dd.day == day then return false, "Come back tomorrow!" end
	dd.streak = (dd.day == day - 1) and dd.streak % #C.Daily + 1 or 1
	dd.day = day
	s.d.cash += C.Daily[dd.streak]
	return true, "+$" .. C.Short(C.Daily[dd.streak])
end

function actions.Playtime(_, s, i)
	local p = type(i) == "number" and C.Playtime[i]
	if not p or s.claimed[i] then return false end
	if os.time() - s.join < p[1] * 60 then return false, "Not yet!" end
	s.claimed[i] = true
	s.d.cash += p[2]
	return true, "+$" .. C.Short(p[2])
end

function actions.Pass(plr, _, key)
	local gp = passByKey[key]
	if not gp then return false end
	if gp.id <= 0 then return false, "Set the Game Pass ID in Config" end
	MarketplaceService:PromptGamePassPurchase(plr, gp.id)
	return true
end

function actions.Product(plr, _, i)
	local p = type(i) == "number" and C.Products[i]
	if not p then return false end
	if p.id <= 0 then return false, "Set the Product ID in Config" end
	MarketplaceService:PromptProductPurchase(plr, p.id)
	return true
end

Request.OnServerInvoke = function(plr, action, arg)
	local s, fn = sessions[plr], actions[action]
	if not (s and fn) then return false end
	local ok, msg = fn(plr, s, arg)
	sync(plr)
	return ok, msg
end

-- ===== Players =====
local function onCharacter(slot, char)
	task.wait()
	char:PivotTo(Map.Bases[slot].spawn * CFrame.new(0, 3, 0))
end

local function onPlayer(plr)
	local slot
	for i = 1, #Map.Bases do
		if not taken[i] then
			slot = i
			break
		end
	end
	if not slot then
		plr:Kick("Server is full")
		return
	end
	taken[slot] = plr

	local ok, saved = pcall(store.GetAsync, store, plr.UserId)
	local d = default()
	if ok and type(saved) == "table" then
		for k, v in saved do d[k] = v end
	end
	local passes = {}
	for _, gp in C.GamePasses do
		if gp.id > 0 then
			local ok2, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, plr.UserId, gp.id)
			passes[gp.key] = ok2 and owns
		end
	end
	if not plr.Parent then
		taken[slot] = nil
		return
	end
	sessions[plr] = { d = d, slot = slot, passes = passes, join = os.time(), claimed = {}, nextThrow = 0, lastLift = 0, loaded = ok }

	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local cash = Instance.new("NumberValue")
	cash.Name, cash.Parent = "Cash", ls
	ls.Parent = plr
	Map.Bases[slot].sign.Text = plr.DisplayName .. "'s Base"

	plr.CharacterAdded:Connect(function(char) onCharacter(slot, char) end)
	if plr.Character then task.spawn(onCharacter, slot, plr.Character) end
	refreshBase(plr)
	sync(plr)
end
Players.PlayerAdded:Connect(onPlayer)
for _, p in Players:GetPlayers() do task.spawn(onPlayer, p) end

local function save(plr)
	local s = sessions[plr]
	if not (s and s.loaded) then return end
	local copy = table.clone(s.d)
	copy.passes = nil
	pcall(store.SetAsync, store, plr.UserId, copy)
end

Players.PlayerRemoving:Connect(function(plr)
	save(plr)
	local s = sessions[plr]
	if s then
		Map.Bases[s.slot].chars:ClearAllChildren()
		Map.Bases[s.slot].sign.Text = "Free Base"
		taken[s.slot] = nil
	end
	sessions[plr] = nil
end)

game:BindToClose(function()
	for plr in sessions do save(plr) end
end)

for _, base in Map.Bases do
	base.dumbPrompt.Triggered:Connect(function(plr) Fx:FireClient(plr, "Lift") end)
	base.shopPrompt.Triggered:Connect(function(plr) Fx:FireClient(plr, "Open", "Cues") end)
end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(plr, id, bought)
	local s = sessions[plr]
	if not (s and bought) then return end
	for _, gp in C.GamePasses do
		if gp.id == id then s.passes[gp.key] = true end
	end
	Map.Bases[s.slot].chars:ClearAllChildren() -- rebuild sticks for Golden Stick
	refreshBase(plr)
	sync(plr)
end)

MarketplaceService.ProcessReceipt = function(info)
	local plr = Players:GetPlayerByUserId(info.PlayerId)
	local s = plr and sessions[plr]
	if not s then return Enum.ProductPurchaseDecision.NotProcessedYet end
	if not table.find(s.d.receipts, info.PurchaseId) then
		for _, p in C.Products do
			if p.id == info.ProductId then s.d.cash += p.cash end
		end
		table.insert(s.d.receipts, info.PurchaseId)
		if #s.d.receipts > 50 then table.remove(s.d.receipts, 1) end
		save(plr)
		sync(plr)
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- ===== The long table keeps shifting its zones to higher rarities =====
local function paintZones()
	for i, z in Map.Zones do
		local r = C.Rarities[math.min(i + luckShift, N)]
		z.felt.Color = r[2]:Lerp(Color3.fromRGB(20, 120, 60), 0.35)
		z.text.Text, z.text.TextColor3 = r[1], r[2]
		for _, n in z.neon do n.Color = r[2] end
	end
end
paintZones()

task.spawn(function()
	local t = 0
	while true do
		task.wait(1)
		t += 1
		for plr, s in sessions do
			s.d.cash += income(s)
			plr.leaderstats.Cash.Value = math.floor(s.d.cash)
			Fx:FireClient(plr, "Cash", s.d.cash, C.LuckCycle - t % C.LuckCycle)
		end
		if t % C.LuckCycle == 0 then
			luckShift = (luckShift + 1) % (C.MaxLuckShift + 1)
			paintZones()
			Fx:FireAllClients("Luck", luckShift)
		end
		if t % 120 == 0 then
			for plr in sessions do task.spawn(save, plr) end
		end
	end
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5828"><Properties><string name="Name">Map</string><ProtectedString name="Source"><![CDATA[-- The map lives in Workspace.World (generated by tools/place.py). This module finds its objects and animates them.
local TweenService = game:GetService("TweenService")
local C = require(game.ReplicatedStorage.Shared.Config)

local Map = { Bases = {}, Zones = {} }

local function loop(p, t, goal, reverse)
	TweenService:Create(p, TweenInfo.new(t, reverse and Enum.EasingStyle.Sine or Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, reverse), goal):Play()
end

function Map.Build()
	local world = workspace:WaitForChild("World")
	local long = world.LongTable

	for i = 1, #C.Rarities do
		Map.Zones[i] = {
			felt = long["Zone" .. i],
			neon = long["Neon" .. i]:GetChildren(),
			text = long["Beam" .. i].Rarity.Text,
		}
	end

	for i = 1, 4 do
		local base = world["Base" .. i]
		local floor = base.Floor
		local slots = {}
		for s = 1, C.MaxEquipped do
			local p = base.Slots["Slot" .. s].Position + Vector3.new(0, 0.3, 0)
			slots[s] = CFrame.lookAt(p, Vector3.new(floor.Position.X, p.Y, floor.Position.Z))
		end
		Map.Bases[i] = {
			slots = slots,
			spawn = floor.CFrame * CFrame.new(0, 1, 32),
			sign = base.Sign.Label.Text,
			dumbPrompt = base.DumbbellHit.Prompt,
			shopPrompt = base.CueShop.Prompt,
			chars = base.Chars,
		}
	end

	-- Animations: the giant 8-ball, its rings, floating balls, fountain, clouds
	local eight = world.EightBall
	local weld = Instance.new("WeldConstraint")
	weld.Part0, weld.Part1, weld.Parent = eight.Ball, eight.Circle, eight.Ball
	eight.Circle.Anchored = false
	loop(eight.Ball, 5, { CFrame = eight.Ball.CFrame * CFrame.new(0, 6, 0) * CFrame.Angles(0, math.rad(30), 0) }, true)
	for k = 1, 3 do
		local ring = eight["Ring" .. k]
		loop(ring, 6 + k * 2, { CFrame = ring.CFrame * CFrame.Angles(math.pi, 0, 0) })
	end
	for _, b in world.FloatBalls:GetChildren() do
		loop(b, math.random(30, 60) / 10, { CFrame = b.CFrame * CFrame.new(0, 8, 0) * CFrame.Angles(0, math.pi, 0) }, true)
	end
	local water = Instance.new("ParticleEmitter")
	water.Color, water.Rate, water.Speed, water.SpreadAngle = ColorSequence.new(Color3.fromRGB(150, 230, 255)), 120, NumberRange.new(18, 22), Vector2.new(25, 25)
	water.Acceleration, water.Lifetime, water.Size = Vector3.new(0, -40, 0), NumberRange.new(1.2), NumberSequence.new(0.6, 0.2)
	water.LightEmission, water.Parent = 0.4, world.Fountain.Top
	local clouds = Instance.new("Clouds")
	clouds.Cover, clouds.Density, clouds.Parent = 0.55, 0.6, workspace.Terrain
	return Map
end

return Map
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX5829"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX5830"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX5831"><Properties><string name="Name">Client</string></Properties><Item class="LocalScript" referent="RBX5832"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[-- HUD + panels. Layout follows the Figma file "Billiard Hunters — UI" (1920x1080 frame, scaled to screen).
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")
local C = require(RS.Shared.Config)
local U = C.UI
local plr = Players.LocalPlayer

-- ===== Sound =====
local groups = {}
for _, n in { "Music", "SFX" } do
	local g = Instance.new("SoundGroup")
	g.Name, g.Volume, g.Parent = n, 0.5, SoundService
	groups[n] = g
end
local sounds = {}
for k, id in C.Sounds do
	local s = Instance.new("Sound")
	s.SoundId, s.SoundGroup, s.Parent = id, k == "Music" and groups.Music or groups.SFX, SoundService
	sounds[k] = s
end
sounds.Music.Looped = true
sounds.Music:Play()
_G.PlaySfx = function(k)
	if sounds[k] and k ~= "Music" then sounds[k]:Play() end
end

-- ===== Building blocks =====
local function new(class, props, children)
	local o = Instance.new(class)
	for k, v in props do
		if k ~= "Parent" then o[k] = v end
	end
	for _, c in children or {} do c.Parent = o end
	if props.Parent then o.Parent = props.Parent end
	return o
end
local function corner(px) return new("UICorner", { CornerRadius = UDim.new(0, px) }) end
local function stroke(t) return new("UIStroke", { Color = U.Ink, Thickness = t, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }) end
local function grad(a, b) return new("UIGradient", { Rotation = 90, Color = ColorSequence.new(a, b) }) end

local function text(str, size, color, props)
	props = props or {}
	props.BackgroundTransparency, props.FontFace, props.Text = 1, U.Font, str
	props.TextSize, props.TextColor3 = size, color or Color3.new(1, 1, 1)
	props.Size = props.Size or UDim2.new(1, 0, 0, size * 1.2)
	return new("TextLabel", props, { new("UIStroke", { Color = U.Ink, Thickness = math.max(2, size / 11) }) })
end

-- Cartoon box with a hard ink drop-shadow (Figma: drop shadow 0/6, radius 0)
local function box(props, top, bottom, radius, strokeW)
	local holder = new("Frame", { Size = props.Size, Position = props.Position or UDim2.new(), AnchorPoint = props.AnchorPoint or Vector2.zero, BackgroundTransparency = 1, LayoutOrder = props.LayoutOrder or 0, Name = props.Name or "Box", Parent = props.Parent })
	new("Frame", { Name = "Shadow", Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(0, 6), BackgroundColor3 = U.Ink, Parent = holder }, { corner(radius) })
	local body = new("Frame", { Name = "Body", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), Parent = holder }, { corner(radius), stroke(strokeW or 4), grad(top, bottom) })
	return holder, body
end

local function button(props, colors, label, size, onClick)
	local holder, body = box(props, colors[1], colors[2], props.Radius or 16, 3)
	local hit = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 5, Parent = holder })
	local scale = new("UIScale", { Parent = holder })
	if label then text(label, size or 22, nil, { Size = UDim2.fromScale(1, 1), Parent = body, TextScaled = false }) end
	hit.MouseEnter:Connect(function() TweenService:Create(scale, TweenInfo.new(0.15, Enum.EasingStyle.Back), { Scale = 1.07 }):Play() end)
	hit.MouseLeave:Connect(function() TweenService:Create(scale, TweenInfo.new(0.15), { Scale = 1 }):Play() end)
	hit.Activated:Connect(function()
		_G.PlaySfx("Click")
		scale.Scale = 0.88
		TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		if onClick then onClick() end
	end)
	return holder, body, hit
end

-- ===== Root (design space 1920x1080) =====
local gui = new("ScreenGui", { Name = "Main", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = plr:WaitForChild("PlayerGui") })
local root = new("Frame", { Size = UDim2.fromOffset(1920, 1080), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Parent = gui })
local rootScale = new("UIScale", { Parent = root })
local function rescale()
	local v = workspace.CurrentCamera.ViewportSize
	rootScale.Scale = math.max(0.42, math.min(v.X / 1920, v.Y / 1080))
end
workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
rescale()

-- ===== Remotes (the UI is visible even while the server is starting) =====
local Remotes = RS:WaitForChild("Remotes")
local Request, Fx = Remotes:WaitForChild("Request"), Remotes:WaitForChild("Fx")
local state

-- Toast
local toastLabel = text("", 54, U.Title, { Size = UDim2.fromOffset(1400, 70), Position = UDim2.fromOffset(260, 210), Parent = root, ZIndex = 20 })
toastLabel.TextTransparency, toastLabel.UIStroke.Transparency = 1, 1
local function toast(msg, color)
	toastLabel.Text, toastLabel.TextColor3 = msg, color or U.Title
	toastLabel.TextTransparency, toastLabel.UIStroke.Transparency = 0, 0
	toastLabel.Position = UDim2.fromOffset(260, 230)
	local info = TweenInfo.new(2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	TweenService:Create(toastLabel, info, { Position = UDim2.fromOffset(260, 180), TextTransparency = 1 }):Play()
	TweenService:Create(toastLabel.UIStroke, info, { Transparency = 1 }):Play()
end
_G.Toast = toast

local function call(action, arg)
	local ok, msg = Request:InvokeServer(action, arg)
	if msg then
		toast(msg, ok and U.Title or U.Bad)
		if ok then _G.PlaySfx("Reward") end
	end
	return ok
end

-- ===== HUD =====
local hud = new("Frame", { Name = "HUD", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = root })
local cashPill = new("Frame", { Size = UDim2.fromOffset(260, 78), Position = UDim2.fromOffset(960, 24), AnchorPoint = Vector2.new(0.5, 0), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = U.Ink, Parent = hud }, {
	corner(40), new("UIPadding", { PaddingLeft = UDim.new(0, 36), PaddingRight = UDim.new(0, 36) }),
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 14) }),
})
text("💵", 48, nil, { Size = UDim2.fromOffset(56, 60), Parent = cashPill })
local cashLabel = text("0", 56, U.Money, { Size = UDim2.fromOffset(0, 70), AutomaticSize = Enum.AutomaticSize.X, Parent = cashPill })
local statLabel = text("", 28, nil, { Size = UDim2.fromOffset(1000, 36), Position = UDim2.fromOffset(460, 122), Parent = hud })

local menu = new("Frame", { Size = UDim2.fromOffset(120, 560), Position = UDim2.fromOffset(28, 300), BackgroundTransparency = 1, Parent = hud }, {
	new("UIListLayout", { Padding = UDim.new(0, 18), SortOrder = Enum.SortOrder.LayoutOrder }),
})

-- Power bar + SHOOT button
local hint = text("Hold SHOOT to charge • release to shoot", 22, nil, { Size = UDim2.fromOffset(600, 28), Position = UDim2.fromOffset(660, 806), Parent = hud })
local bar = new("Frame", { Size = UDim2.fromOffset(560, 36), Position = UDim2.fromOffset(680, 850), BackgroundColor3 = U.Ink, Parent = hud }, {
	corner(18), new("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 4 }),
})
local fill = new("Frame", { Size = UDim2.new(0, 0, 1, -8), Position = UDim2.fromOffset(4, 4), BackgroundColor3 = Color3.new(1, 1, 1), Parent = bar }, {
	corner(14), new("UIGradient", { Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(90, 220, 90)), ColorSequenceKeypoint.new(0.6, Color3.fromRGB(255, 220, 40)), ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 60, 60)) }) }),
})
local _, _, shootHit = button({ Size = UDim2.fromOffset(330, 92), Position = UDim2.fromOffset(960, 906), AnchorPoint = Vector2.new(0.5, 0), Parent = hud, Radius = 34 }, U.Red, "🎱 SHOOT!", 52)

-- ===== Panels =====
local panels, renderers = {}, {}
local function panel(key, title)
	local holder, body = box({ Size = UDim2.fromOffset(890, 640), Position = UDim2.fromOffset(960, 560), AnchorPoint = Vector2.new(0.5, 0.5), Parent = root, Name = key }, U.Panel, U.Panel, 40, 6)
	holder.Visible, holder.ZIndex = false, 10
	text(title, 52, U.Title, { Size = UDim2.new(1, -140, 0, 70), Position = UDim2.fromOffset(40, 20), Parent = body, TextXAlignment = Enum.TextXAlignment.Left })
	local sub = text("", 24, U.Ink, { Size = UDim2.new(1, -140, 0, 30), Position = UDim2.fromOffset(42, 86), Parent = body, TextXAlignment = Enum.TextXAlignment.Left })
	sub.UIStroke.Thickness = 0
	button({ Size = UDim2.fromOffset(64, 56), Position = UDim2.new(1, -96, 0, 26), Parent = body, Radius = 18 }, U.Red, "✖", 30, function() holder.Visible = false end)
	local list = new("ScrollingFrame", {
		Size = UDim2.new(1, -60, 1, -150), Position = UDim2.fromOffset(42, 128), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 10, ScrollBarImageColor3 = U.Ink, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = body,
	}, {
		new("UIGridLayout", { CellSize = UDim2.fromOffset(250, 176), CellPadding = UDim2.fromOffset(18, 18), SortOrder = Enum.SortOrder.LayoutOrder }),
		new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 2) }),
	})
	panels[key] = { holder = holder, list = list, sub = sub }
end

local function clear(list)
	for _, c in list:GetChildren() do
		if c:IsA("GuiObject") then c:Destroy() end
	end
end

-- Card (Figma component "Card"): title, subtitle, up to 3 action buttons
local function card(list, order, top, bottom, title, sub, actions)
	local holder, body = box({ Size = UDim2.fromOffset(250, 170), LayoutOrder = order, Parent = list }, top, bottom, 22, 4)
	text(title, 26, nil, { Size = UDim2.new(1, -16, 0, 34), Position = UDim2.fromOffset(8, 12), Parent = body, TextScaled = true })
	text(sub, 18, nil, { Size = UDim2.new(1, -16, 0, 24), Position = UDim2.fromOffset(8, 50), Parent = body, TextScaled = true })
	local n = #(actions or {})
	for i, a in actions or {} do
		local w = (226 - (n - 1) * 8) / n
		button({ Size = UDim2.fromOffset(w, 50), Position = UDim2.fromOffset(12 + (i - 1) * (w + 8), 96), Parent = body }, a[3] or U.Action, a[1], n > 2 and 26 or 22, a[2])
	end
	return holder
end

local function open(key)
	if not state then return end
	for k, p in panels do
		p.holder.Visible = (k == key) and not p.holder.Visible
	end
	local p = panels[key]
	if p.holder.Visible then
		renderers[key]()
		local sc = p.holder:FindFirstChild("Pop") or new("UIScale", { Name = "Pop", Parent = p.holder })
		sc.Scale = 0.6
		TweenService:Create(sc, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end
end

-- Settings
panel("Settings", "⚙️ Settings")
renderers.Settings = function()
	local p = panels.Settings
	clear(p.list)
	p.sub.Text = "Music and sound effects"
	for i, key in { "Music", "SFX" } do
		local g = groups[key]
		local function set(v)
			g.Volume = math.clamp(v, 0, 1)
			renderers.Settings()
		end
		card(p.list, i, Color3.fromRGB(169, 183, 255), Color3.fromRGB(111, 130, 255), key == "Music" and "🎵 Music" or "🔊 Sound FX", "Volume " .. math.round(g.Volume * 100) .. "%", {
			{ "−", function() set(g.Volume - 0.1) end },
			{ "+", function() set(g.Volume + 0.1) end },
			{ g.Volume > 0 and "🔇" or "🔈", function() set(g.Volume > 0 and 0 or 0.5) end },
		})
	end
end

-- Inventory
panel("Inventory", "🎒 Inventory")
renderers.Inventory = function()
	local p = panels.Inventory
	clear(p.list)
	local on = 0
	for _, it in state.d.inv do
		if it.eq then on += 1 end
	end
	p.sub.Text = string.format("%d / %d characters  •  on base %d / %d", #state.d.inv, C.MaxInventory, on, C.MaxEquipped)
	for i, it in state.d.inv do
		local ch = C.Characters[it.id]
		local r = C.Rarities[ch.rarity]
		card(p.list, -ch.rarity * 1000 + i, r[2]:Lerp(Color3.new(1, 1, 1), 0.35), r[2], ch.name, r[1] .. " • $" .. C.Short(ch.income) .. "/s", {
			{ it.eq and "Unequip" or "Equip", function()
				if call("Equip", i) then renderers.Inventory() end
			end, it.eq and U.Red or U.Action },
			{ "Sell", function()
				if call("Sell", i) then renderers.Inventory() end
			end },
		})
	end
	if #state.d.inv == 0 then card(p.list, 0, U.Cues[1], U.Cues[2], "Empty!", "Shoot the ball to hunt pros") end
end

-- Bonus (daily streak + playtime)
panel("Bonus", "🎁 Bonuses")
renderers.Bonus = function()
	local p = panels.Bonus
	clear(p.list)
	local day = os.time() // 86400
	local dd = state.d.daily
	local claimed = dd.day == day
	local nextDay = claimed and dd.streak or ((dd.day == day - 1) and dd.streak % #C.Daily + 1 or 1)
	p.sub.Text = "Log in every day for a bigger streak • stay to earn playtime gifts"
	card(p.list, 0, Color3.fromRGB(255, 158, 200), Color3.fromRGB(255, 92, 158), "📅 Day " .. nextDay .. " / " .. #C.Daily, "$" .. C.Short(C.Daily[nextDay]), {
		{ claimed and "✅ Claimed" or "Claim!", function()
			if not claimed and call("Daily") then renderers.Bonus() end
		end },
	})
	for i, pt in C.Playtime do
		local left = pt[1] * 60 - (os.time() - state.join)
		local label = state.claimed[i] and "✅" or left > 0 and string.format("%d:%02d", left // 60, left % 60) or "Claim!"
		card(p.list, i, Color3.fromRGB(255, 200, 120), Color3.fromRGB(255, 150, 60), "⏱️ " .. pt[1] .. " min", "$" .. C.Short(pt[2]), {
			{ label, function()
				if call("Playtime", i) then renderers.Bonus() end
			end },
		})
	end
end

-- Donate shop
panel("Shop", "💎 Shop")
renderers.Shop = function()
	local p = panels.Shop
	clear(p.list)
	p.sub.Text = "Game Passes and cash packs"
	for i, gp in C.GamePasses do
		local owned = state.d.passes[gp.key]
		card(p.list, i, U.Menu[4][4], U.Menu[4][5], gp.icon .. " " .. gp.name, gp.desc, {
			{ owned and "✅ Owned" or "Buy R$", function()
				if not owned then call("Pass", gp.key) end
			end, U.Red },
		})
	end
	for i, pr in C.Products do
		card(p.list, 10 + i, Color3.fromRGB(142, 227, 166), Color3.fromRGB(63, 191, 106), pr.icon .. " $" .. C.Short(pr.cash), "Cash pack", {
			{ "Buy R$", function() call("Product", i) end, U.Red },
		})
	end
end

-- Cue shop + upgrades (opened at the stall on the base)
panel("Cues", "🎱 Cues & Upgrades")
renderers.Cues = function()
	local p = panels.Cues
	clear(p.list)
	local d = state.d
	p.sub.Text = string.format("Strength %s  •  shot power x%.2f", C.Short(d.strength), C.CueMult(d))
	card(p.list, 0, Color3.fromRGB(255, 138, 138), Color3.fromRGB(255, 71, 71), "💪 Dumbbell Lv." .. d.dumbLevel, "+" .. d.dumbLevel .. " strength / lift", {
		{ "$" .. C.Short(C.LiftCost(d.dumbLevel)), function()
			if call("UpDumb") then renderers.Cues() end
		end },
	})
	card(p.list, 1, U.Cues[1], U.Cues[2], "🎱 Cue Lv." .. d.cueLevel, "+10% distance / level", {
		{ "$" .. C.Short(C.CueUpCost(d.cueLevel)), function()
			if call("UpCue") then renderers.Cues() end
		end },
	})
	for i, cue in C.Cues do
		local owned = d.cues[tostring(i)]
		local label = d.cue == i and "✅ Equipped" or owned and "Equip" or "$" .. C.Short(cue[3])
		card(p.list, 1 + i, cue[4]:Lerp(Color3.new(1, 1, 1), 0.3), cue[4], cue[1], "x" .. cue[2] .. " distance", {
			{ label, function()
				if d.cue ~= i and call("Cue", i) then renderers.Cues() end
			end },
		})
	end
end

-- Menu buttons (Figma component "MenuButton": icon + label)
for i, m in U.Menu do
	local holder, body = button({ Size = UDim2.fromOffset(120, 120), LayoutOrder = i, Parent = menu, Radius = 28 }, { m[4], m[5] }, nil, nil, function() open(m[1]) end)
	text(m[2], 54, nil, { Size = UDim2.new(1, 0, 0, 66), Position = UDim2.fromOffset(0, 8), Parent = body })
	text(m[3], 22, nil, { Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 80), Parent = body })
	holder.Name = m[1]
end

-- ===== Shooting =====
local power, charging, t0 = 0, false, 0
shootHit.MouseButton1Down:Connect(function()
	if not _G.ThrowBusy and state then charging, power, t0 = true, 0, 0 end
end)
UserInputService.InputEnded:Connect(function(input)
	if not charging then return end
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
	charging = false
	local ok, msg = Request:InvokeServer("Throw", power)
	if msg then toast(msg, U.Bad) end
	if not ok then fill.Size = UDim2.new(0, 0, 1, -8) end
end)
RunService.RenderStepped:Connect(function(dt)
	if not charging then return end
	t0 += dt
	power = 1 - math.abs(((t0 * 0.8) % 2) - 1)
	fill.Size = UDim2.new(power, -8, 1, -8)
end)

-- ===== Server events =====
local luckIn = C.LuckCycle
local function renderStats()
	if not state then return end
	statLabel.Text = string.format("💪 %s     📈 $%s/s     🍀 Luck +%d (next in %ds)", C.Short(state.d.strength), C.Short(state.income), state.luck, luckIn)
end
Fx.OnClientEvent:Connect(function(kind, a, b)
	if kind == "State" then
		state = a
		_G.MySlot = a.slot
		_G.MyCue = a.d.cue
		cashLabel.Text = C.Short(a.d.cash)
		renderStats()
		for k, p in panels do
			if p.holder.Visible then renderers[k]() end
		end
	elseif kind == "Cash" then
		cashLabel.Text, luckIn = C.Short(a), b
		renderStats()
		if panels.Bonus.holder.Visible then renderers.Bonus() end
	elseif kind == "Luck" then
		if state then state.luck = a end
		toast(a == 0 and "🔄 The table reset its zones" or "🍀 The table shifted! Luck +" .. a, Color3.fromRGB(120, 255, 140))
	elseif kind == "Open" then
		if not panels[a].holder.Visible then open(a) end
	elseif kind == "Lift" then
		if Request:InvokeServer("Lift") and state then
			_G.PlaySfx("Click")
			toast("+" .. state.d.dumbLevel .. " 💪", Color3.fromRGB(255, 120, 120))
		end
	end
end)

_G.SetHudVisible = function(on)
	hud.Visible = on
	if not on then
		for _, p in panels do p.holder.Visible = false end
	end
end

Request:InvokeServer("Sync")
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX5833"><Properties><string name="Name">Throw</string><ProtectedString name="Source"><![CDATA[-- Shot: the cue strikes the cue ball -> it breaks the rack -> the rack balls scatter, bounce off the
-- rails and each other and drop into pockets -> the cue ball stops in its zone and drops into that zone's pocket.
-- Your own shot gets a cinematic camera: zoom in/out, hard shake, dimming, flashes, colour cycling.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local RS = game:GetService("ReplicatedStorage")
local C = require(RS.Shared.Config)
local Fx = RS:WaitForChild("Remotes").Fx
local MeshBuilder = require(RS.Shared.MeshBuilder)
local plr = Players.LocalPlayer
local cam = workspace.CurrentCamera
local T, N = C.Table, #C.Rarities
local zoneLen = T.Length / N
local FELT_Y = 3.3
local R = 1.1 -- ball radius
local rng = Random.new()

local function sfx(k) if _G.PlaySfx then _G.PlaySfx(k) end end
local function tween(o, t, props, style, dir)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end
local function laneX(slot) return -T.Width / 2 + (slot - 0.5) * T.Width / T.Lanes end

-- Billiard ball: Blender mesh (coloured body + white number spots), plain sphere as a fallback
local function ball(color, size, cf)
	local b = MeshBuilder.Create("Ball", cf or CFrame.new(), { Body = color }, size)
	if not b then
		b = Instance.new("Part")
		b.Shape, b.Size, b.Color, b.Material = Enum.PartType.Ball, Vector3.one * size, color, Enum.Material.SmoothPlastic
		b.Anchored, b.CanCollide = true, false
		if cf then b.CFrame = cf end
	end
	b:SetAttribute("Tint", color)
	b.CastShadow = true
	b.Parent = workspace
	return b
end

local function burst(b, color, n)
	local p = Instance.new("ParticleEmitter")
	p.Color, p.LightEmission, p.Speed = ColorSequence.new(color), 1, NumberRange.new(8, 20)
	p.Lifetime, p.SpreadAngle, p.Rate = NumberRange.new(0.4, 0.9), Vector2.new(180, 180), 0
	p.Size, p.Parent = NumberSequence.new(0.7, 0), b
	p:Emit(n)
end

local function drop(b, at)
	sfx("Pocket")
	burst(b, b:GetAttribute("Tint") or b.Color, 25)
	tween(b, 0.45, { Size = Vector3.one * 0.1, CFrame = CFrame.new(at - Vector3.new(0, 1.6, 0)) }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	task.delay(1, b.Destroy, b)
end

-- ===== Long-table pockets (same positions as tools/place.py) =====
local pockets = {}
for i = 1, N do
	for _, sx in { -1, 1 } do
		table.insert(pockets, Vector3.new(sx * T.Width / 2, FELT_Y + R, T.StartZ + (i - 0.5) * zoneLen))
	end
end
local function nearestPocket(pos)
	local best, bd
	for _, p in pockets do
		local d = (p - pos).Magnitude
		if not bd or d < bd then best, bd = p, d end
	end
	return best, bd
end

-- ===== A rack on every lane =====
local RACK_Z = T.StartZ + 16
local rackColors = { Color3.fromRGB(255, 220, 40), Color3.fromRGB(40, 90, 255), Color3.fromRGB(255, 50, 50), Color3.fromRGB(140, 40, 200), Color3.fromRGB(255, 130, 20), Color3.fromRGB(30, 160, 60), Color3.fromRGB(130, 30, 30), Color3.fromRGB(20, 20, 20), Color3.fromRGB(255, 120, 200), Color3.fromRGB(0, 200, 200) }
local racks = {}

local function buildRack(slot)
	local list = {}
	local x0 = laneX(slot)
	local k = 0
	for row = 0, 3 do
		for j = 0, row do
			k += 1
			local pos = Vector3.new(x0 + (j - row / 2) * R * 2.05, FELT_Y + R, RACK_Z + row * R * 1.8)
			local b = ball(rackColors[k], R * 2, CFrame.new(pos))
			b.Size = Vector3.one * 0.1
			tween(b, 0.4, { Size = Vector3.one * R * 2 }, Enum.EasingStyle.Back)
			table.insert(list, b)
		end
	end
	racks[slot] = list
end
for s = 1, T.Lanes do buildRack(s) end

-- Scatter physics: friction, rail and ball-ball bounces, pockets "pull" slow balls so every ball gets potted
local function breakRack(slot, power)
	local list = racks[slot]
	racks[slot] = nil
	local bodies = {}
	for _, b in list do
		local p = b.Position
		local away = Vector3.new(p.X - laneX(slot), 0, p.Z - RACK_Z + 3).Unit
		local dir = (away + Vector3.new(rng:NextNumber(-0.5, 0.5), 0, 0.4)).Unit
		table.insert(bodies, { b = b, p = p, v = dir * rng:NextNumber(30, 55) * (0.6 + power * 0.6), rot = CFrame.new() })
	end
	local alive = #bodies
	local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		for i, o in bodies do
			if o.done then continue end
			local speed = o.v.Magnitude
			local target, d = nearestPocket(o.p)
			if d < 2.3 then
				o.done, alive = true, alive - 1
				o.b.CFrame = CFrame.new(target)
				drop(o.b, target)
				continue
			end
			o.v *= math.max(0, 1 - 0.55 * dt)
			if speed < 14 then
				o.v += (target - o.p).Unit * 40 * dt
				o.v = o.v.Unit * math.max(o.v.Magnitude, 8)
			end
			o.p += o.v * dt
			local lim = T.Width / 2 - R
			if math.abs(o.p.X) > lim then -- rail bounce
				o.p = Vector3.new(math.sign(o.p.X) * lim, o.p.Y, o.p.Z)
				o.v = Vector3.new(-o.v.X * 0.8, 0, o.v.Z)
				sfx("Hit")
			end
			if o.p.Z < T.StartZ + R then
				o.p = Vector3.new(o.p.X, o.p.Y, T.StartZ + R)
				o.v = Vector3.new(o.v.X, 0, -o.v.Z * 0.8)
			end
			for j = i + 1, #bodies do -- elastic ball-ball collision
				local q = bodies[j]
				if not q.done then
					local delta = q.p - o.p
					local dist = delta.Magnitude
					if dist < R * 2 and dist > 0 then
						local n = delta / dist
						local rel = (o.v - q.v):Dot(n)
						if rel > 0 then
							o.v -= n * rel
							q.v += n * rel
						end
						o.p -= n * (R * 2 - dist) / 2
						q.p += n * (R * 2 - dist) / 2
					end
				end
			end
			local axis = o.v.Magnitude > 0.01 and Vector3.yAxis:Cross(o.v.Unit) or Vector3.xAxis
			o.rot = CFrame.fromAxisAngle(axis, o.v.Magnitude * dt / R) * o.rot
			o.b.CFrame = CFrame.new(o.p) * o.rot
		end
		if alive == 0 then
			conn:Disconnect()
			task.delay(1.5, buildRack, slot)
		end
	end)
end

-- ===== Screen effects =====
local fxGui = Instance.new("ScreenGui")
fxGui.Name, fxGui.IgnoreGuiInset, fxGui.ResetOnSpawn, fxGui.DisplayOrder = "CinemaFx", true, false, 10
fxGui.Parent = plr:WaitForChild("PlayerGui")

local function frame(props)
	local f = Instance.new("Frame")
	f.BorderSizePixel, f.Size = 0, UDim2.fromScale(1, 1)
	for k, v in props do f[k] = v end
	f.Parent = props.Parent or fxGui
	return f
end
local flash = frame({ BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1 })
local dim = frame({ BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1 })
local bars = {} -- letterbox bars
for i, y in { 0, 1 } do
	bars[i] = frame({ BackgroundColor3 = Color3.new(0, 0, 0), Size = UDim2.fromScale(1, 0), AnchorPoint = Vector2.new(0, y), Position = UDim2.fromScale(0, y) })
end
local cc = Instance.new("ColorCorrectionEffect")
cc.Parent = Lighting
local blur = Instance.new("BlurEffect")
blur.Size, blur.Parent = 0, Lighting

local function doFlash(color, strength)
	flash.BackgroundColor3, flash.BackgroundTransparency = color, 1 - (strength or 0.8)
	tween(flash, 0.5, { BackgroundTransparency = 1 })
end
local function letterbox(on)
	for _, b in bars do tween(b, 0.4, { Size = UDim2.fromScale(1, on and 0.11 or 0) }) end
end

-- shake = amplitude in studs, decays every frame
local shake = 0
local function hardShake(a) shake = math.max(shake, a) end

-- reveal card: spinning rays, rainbow gradient, pulse
local function reveal(ch)
	local r = C.Rarities[ch.rarity]
	local root = frame({ BackgroundTransparency = 1 })
	local rays = frame({ Parent = root, BackgroundTransparency = 1, Size = UDim2.fromOffset(900, 900), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45) })
	for k = 1, 12 do -- each ray sits in a full-size rotated pivot so it spins around the centre
		local pivot = frame({ Parent = rays, BackgroundTransparency = 1, Rotation = k * 30 })
		frame({ Parent = pivot, BackgroundColor3 = r[2], BackgroundTransparency = 0.55, Size = UDim2.new(0, 40, 0.5, 0), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 0.5) })
	end
	local function label(text, y, h, color)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency, l.TextScaled, l.FontFace = 1, true, C.UI.Font
		l.Size, l.AnchorPoint, l.Position = UDim2.fromScale(0.8, h), Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, y)
		l.Text, l.TextColor3, l.Parent = text, color, root
		local st = Instance.new("UIStroke")
		st.Thickness, st.Color, st.Parent = 5, C.UI.Ink, l
		local sc = Instance.new("UIScale")
		sc.Scale, sc.Parent = 0, l
		return l, sc
	end
	local title, s1 = label(string.upper(r[1]) .. "!", 0.34, 0.14, Color3.new(1, 1, 1))
	local name, s2 = label(ch.name, 0.48, 0.09, r[2])
	local _, s3 = label("💵 $" .. C.Short(ch.income) .. "/s", 0.58, 0.06, C.UI.Money)
	local grad = Instance.new("UIGradient")
	grad.Color = ch.rarity >= 10 and ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 60)), ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 230, 40)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(60, 255, 120)), ColorSequenceKeypoint.new(0.75, Color3.fromRGB(60, 160, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 60, 220)),
	}) or ColorSequence.new(Color3.new(1, 1, 1), r[2])
	grad.Parent = title
	for k, sc in { s1, s2, s3 } do
		task.delay((k - 1) * 0.15, function() tween(sc, 0.5, { Scale = 1 }, Enum.EasingStyle.Back) end)
	end
	local t0 = os.clock()
	local conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		rays.Rotation = t * 40
		grad.Offset = Vector2.new(math.sin(t * 3) * 0.5, 0)
		grad.Rotation = t * 90
		s1.Scale = s1.Scale > 0.95 and 1 + math.sin(t * 8) * 0.05 or s1.Scale
		name.TextColor3 = ch.rarity >= 10 and Color3.fromHSV((t * 0.6) % 1, 0.7, 1) or r[2]
		if ch.rarity >= 10 then cc.TintColor = Color3.fromHSV((t * 0.5) % 1, 0.25, 1) end -- world colour cycling
	end)
	task.delay(2.8, function()
		for _, sc in { s1, s2, s3 } do tween(sc, 0.3, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In) end
		tween(rays, 0.3, { Size = UDim2.fromOffset(0, 0) })
		task.wait(0.35)
		conn:Disconnect()
		root:Destroy()
		tween(cc, 0.6, { TintColor = Color3.new(1, 1, 1), Saturation = 0, Brightness = 0, Contrast = 0 })
	end)
end

-- ===== Camera =====
local camTarget, camOffset, camLook
local cinema = false
RunService:BindToRenderStep("CinemaCam", Enum.RenderPriority.Camera.Value + 1, function(dt)
	if not cinema or not camTarget then return end
	local pos = camTarget.Position
	local goal = CFrame.lookAt(pos + camOffset, pos + (camLook or Vector3.zero))
	cam.CFrame = cam.CFrame:Lerp(goal, math.min(1, dt * 8))
	if shake > 0.01 then
		cam.CFrame *= CFrame.new(rng:NextNumber(-1, 1) * shake, rng:NextNumber(-1, 1) * shake, 0) * CFrame.Angles(0, 0, rng:NextNumber(-1, 1) * shake * 0.03)
		shake *= math.max(0, 1 - dt * 6)
	end
end)

local function setCinema(on)
	cinema = on
	_G.ThrowBusy = on
	if _G.SetHudVisible then _G.SetHudVisible(not on) end
	letterbox(on)
	if on then
		cam.CameraType = Enum.CameraType.Scriptable
	else
		cam.CameraType = Enum.CameraType.Custom
		tween(cam, 0.6, { FieldOfView = 70 })
		tween(dim, 0.4, { BackgroundTransparency = 1 })
		tween(blur, 0.4, { Size = 0 })
	end
end

-- ===== The shot =====
local function cueModel(color) -- Blender cue mesh, or a 3-part fallback
	local mesh = MeshBuilder.Create("Cue", CFrame.new(), { Shaft = color })
	if mesh then
		mesh.Parent = workspace
		return mesh
	end
	local m = Instance.new("Model")
	for _, d in { { 0.4, 7, Color3.fromRGB(25, 12, 5), -2.5 }, { 0.3, 7, color, 4.5 }, { 0.22, 0.3, Color3.fromRGB(25, 80, 230), 8.15 } } do
		local p = Instance.new("Part")
		p.Shape, p.Anchored, p.CanCollide = Enum.PartType.Cylinder, true, false
		p.Size, p.Color, p.Material = Vector3.new(d[2], d[1], d[1]), d[3], Enum.Material.SmoothPlastic
		p:SetAttribute("off", d[4])
		p.Parent = m
	end
	m.Parent = workspace
	return m
end
local function placeCue(m, tip) -- cue lies along +Z with its tip at `tip`
	if m:IsA("MeshPart") then
		m.CFrame = CFrame.new(tip + Vector3.new(0, 0.6, -4.6)) * CFrame.Angles(math.pi / 2, 0, 0)
		return
	end
	for _, p in m:GetChildren() do
		p.CFrame = CFrame.new(tip - Vector3.new(0, -0.6, 8.3 - p:GetAttribute("off"))) * CFrame.Angles(0, math.pi / 2, 0)
	end
end

Fx.OnClientEvent:Connect(function(kind, a, dist, id)
	if kind ~= "Throw" then return end
	local slot, ch = a, C.Characters[id]
	local rcol = C.Rarities[ch.rarity][2]
	local mine = slot == _G.MySlot
	local x = laneX(slot)
	local start = Vector3.new(x, FELT_Y + R, T.StartZ + 3)
	local b = ball(Color3.new(1, 1, 1), R * 2, CFrame.new(start))
	local a0, a1 = Instance.new("Attachment", b), Instance.new("Attachment", b)
	a0.Position, a1.Position = Vector3.new(0, 0.7, 0), Vector3.new(0, -0.7, 0)
	local trail = Instance.new("Trail")
	trail.Attachment0, trail.Attachment1, trail.Color, trail.LightEmission = a0, a1, ColorSequence.new(Color3.new(1, 1, 1), rcol), 1
	trail.Lifetime, trail.Transparency, trail.Parent = 0.5, NumberSequence.new(0.1, 1), b

	-- 1. Wind-up: zoom in + dim
	local cue = cueModel(C.Cues[mine and _G.MyCue or 1][4])
	if mine then
		setCinema(true)
		camTarget, camOffset, camLook = b, Vector3.new(6, 4, -10), Vector3.new(0, 0, 6)
		cam.FieldOfView = 70
		tween(cam, C.Anim.Windup, { FieldOfView = 38 }, Enum.EasingStyle.Sine)
		tween(dim, C.Anim.Windup, { BackgroundTransparency = 0.6 })
		tween(cc, C.Anim.Windup, { Saturation = -0.4, Contrast = 0.2 })
	end
	local t0 = os.clock()
	while os.clock() - t0 < C.Anim.Windup do
		local t = (os.clock() - t0) / C.Anim.Windup
		local back = t < 0.8 and math.sin(t / 0.8 * math.pi / 2) * 4 or 4 * (1 - (t - 0.8) / 0.2) -- pull back, then strike
		placeCue(cue, start - Vector3.new(0, 0, R + back))
		RunService.RenderStepped:Wait()
	end
	sfx("Hit")
	burst(b, Color3.new(1, 1, 1), 30)
	task.delay(0.3, cue.Destroy, cue)

	-- 2. Strike: flash, hard shake, zoom-out punch
	if mine then
		doFlash(Color3.new(1, 1, 1), 0.9)
		hardShake(2.5)
		cam.FieldOfView = 105
		tween(cam, 0.8, { FieldOfView = 75 }, Enum.EasingStyle.Quart)
		tween(dim, 0.3, { BackgroundTransparency = 1 })
		tween(cc, 0.3, { Saturation = 0.3, Contrast = 0.1 })
		camOffset, camLook = Vector3.new(0, 9, -22), Vector3.new(0, 0, 20)
	end

	-- 3. Roll to the zone (breaking the rack on the way)
	local roll = C.RollTime(dist)
	local zone = math.clamp(math.ceil(dist / zoneLen), 1, N)
	local endZ = math.min(T.StartZ + 3 + dist, T.StartZ + T.Length - R)
	local broke = false
	local rot, lastZ = CFrame.new(), start.Z
	t0 = os.clock()
	repeat
		local t = math.min((os.clock() - t0) / roll, 1)
		local z = start.Z + (endZ - start.Z) * (1 - (1 - t) ^ 3)
		rot = CFrame.Angles((z - lastZ) / R, 0, 0) * rot
		lastZ = z
		b.CFrame = CFrame.new(x, start.Y, z) * rot
		if not broke and z >= RACK_Z - R * 2 and racks[slot] then
			broke = true
			breakRack(slot, math.clamp(dist / T.Length, 0.3, 1))
			if mine then hardShake(1.6) doFlash(rcol, 0.4) end
		end
		RunService.RenderStepped:Wait()
	until t >= 1

	-- 4. Slide into the zone pocket: zoom in, dim, blur
	local side = x < 0 and -1 or 1
	local pocket = Vector3.new(side * T.Width / 2, start.Y, T.StartZ + (zone - 0.5) * zoneLen)
	if mine then
		camOffset, camLook = Vector3.new(-side * 10, 7, -12), Vector3.zero
		tween(cam, C.Anim.Slide, { FieldOfView = 32 }, Enum.EasingStyle.Sine)
		tween(dim, C.Anim.Slide, { BackgroundTransparency = 0.45 })
		tween(blur, C.Anim.Slide, { Size = 6 })
	end
	local from = b.Position
	t0 = os.clock()
	repeat
		local t = math.min((os.clock() - t0) / C.Anim.Slide, 1)
		local e = t * t * (3 - 2 * t)
		b.CFrame = CFrame.new(from:Lerp(pocket, e)) * rot
		RunService.RenderStepped:Wait()
	until t >= 1
	b:SetAttribute("Tint", rcol)
	drop(b, pocket)

	-- 5. Finale: rarity flash, shake, zoom-out, reveal card
	if mine then
		doFlash(rcol, 1)
		hardShake(1 + ch.rarity * 0.12)
		cam.FieldOfView = 90
		tween(cam, 1.2, { FieldOfView = 60 }, Enum.EasingStyle.Back)
		tween(dim, 0.3, { BackgroundTransparency = 0.25 })
		tween(blur, 0.3, { Size = 14 })
		tween(cc, 0.3, { TintColor = rcol:Lerp(Color3.new(1, 1, 1), 0.6), Brightness = 0.1, Saturation = 0.5 })
		sfx("Reward")
		reveal(ch)
		task.wait(3.2)
		setCinema(false)
	else
		_G.Toast(ch.name .. " • " .. C.Rarities[ch.rarity][1], rcol)
	end
end)

-- ===== Decorative balls rolling into pockets on the base tables =====
local basePockets = {}
for _, px in { -4.6, 4.6 } do
	for _, pz in { -8.1, 0, 8.1 } do table.insert(basePockets, Vector3.new(px, 0, pz)) end
end
local world = workspace:WaitForChild("World")
while true do
	task.wait(rng:NextNumber(1, 2.5))
	local base = world:FindFirstChild("Base" .. rng:NextInteger(1, 4))
	local floor = base and base:FindFirstChild("Floor")
	if floor then
		local o = floor.Position + Vector3.new(0, 3.95, 0)
		local from = o + Vector3.new(rng:NextNumber(-3, 3), 0, rng:NextNumber(-6, 6))
		local goal = o + basePockets[rng:NextInteger(1, #basePockets)]
		local b = ball(rackColors[rng:NextInteger(1, #rackColors)], 0.8, CFrame.new(from))
		local spin = CFrame.fromAxisAngle((goal - from).Unit:Cross(Vector3.yAxis), -(goal - from).Magnitude / 0.4)
		tween(b, 1.2, { CFrame = CFrame.new(goal) * spin.Rotation }).Completed:Once(function() drop(b, goal) end)
	end
end
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX5834"><Properties><string name="Name">Visuals</string><ProtectedString name="Source"><![CDATA[-- Swaps every part tagged with a "Mesh" StringValue for the matching Blender mesh (Shared/Meshes).
-- "MeshPivot" parts stand for a whole part-built model: the model is hidden locally and the mesh is
-- welded to the pivot. Any other tagged part (NPC cue sticks, decorative balls) is replaced 1:1.
-- If EditableMesh is unavailable the part-built models simply stay visible.
local RS = game:GetService("ReplicatedStorage")
local MeshBuilder = require(RS.Shared.MeshBuilder)

local function hide(p)
	p.LocalTransparencyModifier = 1
end

local function apply(tag)
	task.wait() -- let sibling override values replicate
	local p = tag.Parent
	if not (p and p:IsA("BasePart")) or p:FindFirstChild("MeshVisual") then return end
	local overrides
	for _, v in p:GetChildren() do
		if v:IsA("Color3Value") then
			overrides = overrides or {}
			overrides[v.Name] = v.Value
		end
	end
	local scaleValue = p:FindFirstChild("Scale")
	local mp = MeshBuilder.Create(tag.Value, p.CFrame, overrides, scaleValue and scaleValue.Value)
	if not mp or not p.Parent then
		if mp then mp:Destroy() end
		return
	end
	mp.Name, mp.Anchored, mp.Massless = "MeshVisual", false, true
	local weld = Instance.new("WeldConstraint")
	weld.Part0, weld.Part1, weld.Parent = p, mp, mp
	mp.Parent = p
	if p.Name == "MeshPivot" then
		for _, d in p.Parent:GetDescendants() do
			if d:IsA("BasePart") and d ~= p and not d:IsDescendantOf(p) then hide(d) end
		end
	else
		hide(p)
	end
end

local function check(inst)
	if inst.Name == "Mesh" and inst:IsA("StringValue") then task.spawn(apply, inst) end
end

local world = workspace:WaitForChild("World")
for _, d in world:GetDescendants() do check(d) end
world.DescendantAdded:Connect(check)
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="Lighting" referent="RBX5835"><Properties><string name="Name">Lighting</string><float name="ClockTime">14.6</float><float name="Brightness">3</float><float name="EnvironmentDiffuseScale">1</float><float name="EnvironmentSpecularScale">1</float><Color3 name="OutdoorAmbient"><R>0.5882</R><G>0.5490</G><B>0.6667</B></Color3><Color3 name="Ambient"><R>0.3529</R><G>0.3137</G><B>0.4314</B></Color3></Properties><Item class="Sky" referent="RBX5836"><Properties><string name="Name">Sky</string></Properties></Item><Item class="Atmosphere" referent="RBX5837"><Properties><string name="Name">Atmosphere</string><float name="Density">0.22</float><float name="Haze">0.6</float><Color3 name="Color"><R>0.7843</R><G>0.8824</G><B>1.0000</B></Color3><Color3 name="Decay"><R>0.4706</R><G>0.5882</G><B>0.8235</B></Color3></Properties></Item><Item class="BloomEffect" referent="RBX5838"><Properties><string name="Name">Bloom</string><float name="Intensity">0.7</float><float name="Size">28</float><float name="Threshold">1.4</float></Properties></Item><Item class="ColorCorrectionEffect" referent="RBX5839"><Properties><string name="Name">Grade</string><float name="Saturation">0.22</float><float name="Contrast">0.06</float></Properties></Item><Item class="SunRaysEffect" referent="RBX5840"><Properties><string name="Name">SunRays</string><float name="Intensity">0.06</float></Properties></Item></Item></roblox>